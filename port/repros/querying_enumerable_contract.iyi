module querying_enumerable_contract

import std/enumerable::{Enumerable}

pub class ReadFailure
end

impl Error for ReadFailure
  def message : String
    "query failed"
  end
end

pub class Query
  def each(&block : Int32 -> Nil) : Nil | ReadFailure
    ReadFailure.new
  end
end

impl Enumerable for Query
  type Elem = Int32
end

assert Query.new.is_a?(Enumerable)
