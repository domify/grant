module port/feedback/migrate_db_probe

import db/db/core::{Connection}
import db/db/value::{DBValue}
import db/db/errors::{DBError}
import sqlite/sqlite/core::{SQLite3Connection}

connection = SQLite3Connection.open(Connection::Options.new,
  SQLite3Connection::Options.new(foreign_keys: "on")).or_panic

# Grant rejects this request before executing any prefix.
statement = connection.build_prepared_statement("CREATE TABLE prefix_executed (id INTEGER); SELECT 2").or_panic
result = statement.exec(args: [] of DBValue)
puts "multiple statements rejected: #{result.is_a?(DBError)}"
statement.close.or_panic

# Grant rejects too few parameters rather than implicitly binding NULL.
statement = connection.build_prepared_statement("SELECT ?").or_panic
result = statement.query(args: [] of DBValue).or_panic
assert result.move_next.or_panic
puts "missing parameter became NULL: #{result.read.or_panic.nil?}"
result.close.or_panic
result = statement.query(args: [7_i64] of DBValue).or_panic
assert result.move_next.or_panic
assert result.read.or_panic == 7_i64
result.close.or_panic
result = statement.query(args: [] of DBValue).or_panic
assert result.move_next.or_panic
puts "missing parameter reused previous value: #{result.read.or_panic == 7_i64}"
result.close.or_panic
statement.close.or_panic
connection.close.or_panic
