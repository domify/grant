import grant/base::{Base}
import grant/error_taxonomy::{StatementInvalid, InvalidForeignKey}
import grant/transaction::{TransactionState}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: raises a StatementInvalid from a failing statement inside a savepoint and keeps the outer work
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Kept").or_panic
  error = Parent.transaction(requires_new: true) do
    Parent.connection.execute("INSERT INTO no_such_table_for_translation_spec (x) VALUES (1)")
  end
  assert error.is_a?(StatementInvalid)
  Parent.create_strict(name: "After").or_panic
end.or_panic
assert Parent.all.or_panic.map { |parent| parent.name.to_s }.sorted == ["After", "Kept"]

# it: translates a constraint failure raised by COMMIT itself
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_children").or_panic
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_owners").or_panic
Parent.connection.execute("CREATE TABLE deferred_translation_owners (id INTEGER PRIMARY KEY)").or_panic
Parent.connection.execute("CREATE TABLE deferred_translation_children (owner_id INTEGER REFERENCES deferred_translation_owners (id) DEFERRABLE INITIALLY DEFERRED)").or_panic
error = Parent.transaction do
  Parent.connection.execute("INSERT INTO deferred_translation_children (owner_id) VALUES (42)")
end
assert error.is_a?(InvalidForeignKey)
assert error.as(InvalidForeignKey).sql == "COMMIT"
assert TransactionState.current_state?.nil?
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_children").or_panic
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_owners").or_panic
Parent.adapter.close.or_panic
