module test/grant_attributes_store_accessor_test
import grant
import grant/base::{Base}
import std/json::{JSON, Any, PullParser, Builder, ToJSON}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class StoreSpecSettings
  @@parse_count : Int32 = 0
  def self.parse_count : Int32
    @@parse_count
  end
  def self.parse_count=(value : Int32) : Int32
    @@parse_count = value
  end
  property theme : String = "light"
  property notifications : Bool = true
  property volume : Int32 = 5
  property locale : String? = nil
  def initialize
  end
  # Native counterpart of the JSON::Serializable parser constructor hook.
  def initialize(pull : PullParser)
    @@parse_count += 1
    fields = JSON.read_value(pull, Any).as_h
    @theme = fields["theme"].as_s if fields.has_key?("theme")
    @notifications = fields["notifications"].as_bool if fields.has_key?("notifications")
    @volume = fields["volume"].as_i if fields.has_key?("volume")
    if fields.has_key?("locale")
      @locale = fields["locale"].raw.nil? ? nil : fields["locale"].as_s
    end
  end
  def self.from_json(text : String) : StoreSpecSettings
    JSON.from_json(text, self)
  end
  def to_json : String
    JSON.build { |json| self.to_json(json) }
  end
end

impl ToJSON for StoreSpecSettings
  def to_json(json : Builder) : Nil
    json.object do
      json.field("theme", theme)
      json.field("notifications", notifications)
      json.field("volume", volume)
      json.field("locale", locale)
    end
  end
end

pub class StoreSpecUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table store_spec_users
  column id : Int64, primary: true
  column name : String?
  serialized_column :settings, StoreSpecSettings
  store_accessor :settings, theme : String = "light", notifications : Bool = true, volume : Int32 = 5, locale : String?
end

pub class StoreSpecPrefixed < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table store_spec_users
  column id : Int64, primary: true
  column name : String?
  serialized_column :settings, StoreSpecSettings
  store_accessor :settings, theme : String = "light", prefix: true
  store_accessor :settings, volume : Int32 = 5, suffix: :level
end

register_spec_connections
id_column = case CURRENT_ADAPTER
            when "pg" then "BIGSERIAL PRIMARY KEY"
            when "mysql" then "BIGINT AUTO_INCREMENT PRIMARY KEY"
            else "INTEGER PRIMARY KEY AUTOINCREMENT"
            end
StoreSpecUser.exec("DROP TABLE IF EXISTS store_spec_users").or_panic
StoreSpecUser.exec("CREATE TABLE store_spec_users (id #{id_column}, name VARCHAR(255), _serialized_settings TEXT)").or_panic

# it: reads defaults without building the object
StoreSpecUser.clear.or_panic
user = StoreSpecUser.new
assert user.theme == "light"
assert user.notifications
assert user.notifications?
assert user.volume == 5
assert user.locale.nil?
assert user.settings.nil?

# it: writes typed keys and persists them
StoreSpecUser.clear.or_panic
user = StoreSpecUser.new(name: "a")
user.theme = "dark"
user.volume = 11
user.locale = "en"
user.save_strict.or_panic
loaded = StoreSpecUser.find_strict(user.id).or_panic
assert loaded.theme == "dark"
assert loaded.volume == 11
assert loaded.locale == "en"
assert loaded.notifications

# it: tracks dirty state per key
StoreSpecUser.clear.or_panic
user = StoreSpecUser.create_strict(name: "d").or_panic
assert !user.theme_changed?
user.theme = "dark"
assert user.theme_changed?
assert user.theme_was == "light"
assert !user.volume_changed?
assert user.settings_changed?
assert user.changed?

user.theme = "light"
assert !user.theme_changed?

user.theme = "dark"
user.save_strict.or_panic
assert !user.theme_changed?
assert user.theme_was == "dark"
assert !user.settings_changed?

# it: keeps the record dirty when only a store key changed
StoreSpecUser.clear.or_panic
user = StoreSpecUser.create_strict(name: "k").or_panic
loaded = StoreSpecUser.find_strict(user.id).or_panic
loaded.volume = 9
assert loaded.changed?
loaded.save_strict.or_panic
assert StoreSpecUser.find_strict(user.id).or_panic.volume == 9

# it: does not deserialize the whole column again for each key
StoreSpecUser.clear.or_panic
user = StoreSpecUser.create_strict(name: "p").or_panic
user.theme = "dark"
user.save_strict.or_panic
loaded = StoreSpecUser.find_strict(user.id).or_panic
StoreSpecSettings.parse_count = 0
10.times do
  loaded.theme
  loaded.volume
  loaded.notifications
end
assert StoreSpecSettings.parse_count == 1
loaded.theme = "blue"
loaded.volume = 3
loaded.theme
assert StoreSpecSettings.parse_count == 1
assert loaded.settings.as(StoreSpecSettings).object_id == loaded.settings.as(StoreSpecSettings).object_id

# it: supports prefix and suffix names
StoreSpecUser.clear.or_panic
user = StoreSpecPrefixed.new
assert user.settings_theme == "light"
user.settings_theme = "dark"
assert user.settings_theme_changed?
user.volume_level = 2
assert user.volume_level == 2
assert user.settings.as(StoreSpecSettings).theme == "dark"

StoreSpecUser.adapter.close.or_panic
