module test/grant_config_url_scheme_test
import grant
import grant/adapter/registry::{Registry, UnknownAdapterError}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/adapter/mysql::{Mysql}
import grant/connection_registry::{ConnectionRegistry}

# it: chooses the adapter from postgres://, mysql:// and sqlite3:
assert Registry.for_url("postgres://u:p@host/db").or_panic.to_s == Pg.to_s
assert Registry.for_url("postgresql://host/db").or_panic.to_s == Pg.to_s
assert Registry.for_url("mysql://host/db").or_panic.to_s == Mysql.to_s
assert Registry.for_url("sqlite3:./app.db").or_panic.to_s == Sqlite.to_s
assert Registry.for_url("sqlite3://./app.db").or_panic.to_s == Sqlite.to_s

# it: exposes the lookup as Grant.adapter_for_scheme
assert ::Grant.adapter_for_scheme("postgres").or_panic.to_s == Pg.to_s
assert ::Grant.adapter_for_scheme("SQLITE3").or_panic.to_s == Sqlite.to_s

# it: raises an actionable error for an unknown scheme without leaking credentials
error = Registry.for_url("oracle://user:hunter2@host/db")
assert error.is_a?(UnknownAdapterError)
assert error.as(UnknownAdapterError).message.includes?("oracle")
assert error.as(UnknownAdapterError).message.includes?("require")
assert !error.as(UnknownAdapterError).message.includes?("hunter2")

# it: raises for a URL without a scheme
error = Registry.for_url("just-a-path.db")
assert error.is_a?(UnknownAdapterError)
assert error.as(UnknownAdapterError).message.includes?("no URL scheme")

# it: supports registering a custom adapter by name
Registry.register(Sqlite, "c03custom")
assert Registry.for_url("c03custom:./x.db").or_panic.to_s == Sqlite.to_s

# it: establishes a connection from a URL alone and uses the inferred adapter
ConnectionRegistry.establish_connection(database: "c03_url_only", url: "sqlite3::memory:",
  role: :writing).or_panic
assert ConnectionRegistry.get_adapter("c03_url_only", :writing).is_a?(Sqlite)
assert ConnectionRegistry.connection_spec("c03_url_only", :writing).as(ConnectionRegistry::ConnectionSpec).adapter_class.to_s == Sqlite.to_s
ConnectionRegistry.remove_connection("c03_url_only", :writing).or_panic

# it: still accepts an explicit adapter with a URL
ConnectionRegistry.establish_connection(database: "c03_url_explicit", adapter: Sqlite,
  url: "sqlite3::memory:", role: :writing).or_panic
assert ConnectionRegistry.connection_exists?("c03_url_explicit", :writing)
ConnectionRegistry.remove_connection("c03_url_explicit", :writing).or_panic

# it: reports a missing scheme from establish_connection
assert ConnectionRegistry.establish_connection(database: "c03_url_bad", url: "nope://x/y").is_a?(UnknownAdapterError)
