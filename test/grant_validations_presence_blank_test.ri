module test/grant_validations_presence_blank_test
import grant/base::{Base}
import grant/validators
import std/set
import std/time::{Time}
import test/spec_helper::{register_spec_connections}
pub class V01PresenceModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v01_presence_models

  column id : Int64, primary: true
  column title : String?

  property flag : Bool? = true
  property meta : Hash(String, String)? = {"k" => "v"}
  property tags : Array(String)? = ["a"]
  property labels : Set(String)? = (Set(String).new << "a")
  property score : Int32? = 1

  validates_presence_of :title, :flag, :meta, :tags, :labels, :score
end

pub class V01PresenceAllowBlank < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v01_presence_allow_blanks

  column id : Int64, primary: true
  column code : String?

  validates_presence_of :code, allow_blank: true
  validates_length_of :code, minimum: 3, allow_blank: true
end

pub class V01PresenceContexts < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v01_presence_contexts

  column id : Int64, primary: true
  column reason : String?

  validates_presence_of :reason, on: [:update, :publish]
end
def valid_presence_model : V01PresenceModel
  model = V01PresenceModel.new
  model.title = "Hello"
  model
end

register_spec_connections

# it: treats nil, false, blank strings and empty collections as blank
begin
  assert ::Grant::Validators.blank?(nil)
  assert ::Grant::Validators.blank?(false)
  assert ::Grant::Validators.blank?("")
  assert ::Grant::Validators.blank?(" \t\n")
  assert ::Grant::Validators.blank?([] of String)
  assert ::Grant::Validators.blank?({} of String => String)
  assert ::Grant::Validators.blank?(Set(String).new)
end

# it: treats true, numbers, text and non-empty collections as present
begin
  assert !::Grant::Validators.blank?(true)
  assert !::Grant::Validators.blank?(0)
  assert !::Grant::Validators.blank?(0.0)
  assert !::Grant::Validators.blank?("x")
  assert !::Grant::Validators.blank?(["x"])
  assert !::Grant::Validators.blank?({"a" => 1})
  assert !::Grant::Validators.blank?(:sym)
  assert !::Grant::Validators.blank?(Time.utc)
end

# it: passes when every value is present
begin
  assert valid_presence_model.valid?.or_panic
end

# it: fails for Bool false
begin
  model = valid_presence_model
  model.flag = false
  assert !model.valid?.or_panic
  assert model.errors.map { |e| e.field.to_s } == ["flag"]
  assert model.errors.first.type == :blank
end

# it: fails for nil Bool
begin
  model = valid_presence_model
  model.flag = nil
  assert !model.valid?.or_panic
end

# it: fails for an empty Hash
begin
  model = valid_presence_model
  model.meta = {} of String => String
  assert !model.valid?.or_panic
  assert model.errors.map { |e| e.field.to_s } == ["meta"]
end

# it: fails for an empty Array and an empty Set
begin
  model = valid_presence_model
  model.tags = [] of String
  model.labels = Set(String).new
  assert !model.valid?.or_panic
  assert model.errors.map { |e| e.field.to_s } == ["tags", "labels"]
end

# it: keeps zero present
begin
  model = valid_presence_model
  model.score = 0
  assert model.valid?.or_panic
end

# it: fails for a whitespace-only string
begin
  model = valid_presence_model
  model.title = "  "
  assert !model.valid?.or_panic
end

# it: skips the check (and other validators) for blank values
begin
  [nil, "", "   "].each do |value|
    model = V01PresenceAllowBlank.new
    model.code = value
    assert model.valid?.or_panic
  end
end

# it: still applies the other validators to non-blank values
begin
  model = V01PresenceAllowBlank.new
  model.code = "ab"
  assert !model.valid?.or_panic
  assert model.errors.first.type == :too_short
  model.code = "abc"
  assert model.valid?.or_panic
end

# it: runs in every listed context
begin
  model = V01PresenceContexts.new
  assert !model.valid?(:publish).or_panic
  assert !model.valid?(context: :update).or_panic
  assert !model.valid?(context: [:create, :publish]).or_panic
end

# it: does not run in an unlisted context
begin
  model = V01PresenceContexts.new
  assert model.valid?(:create).or_panic
  assert model.valid?(:other).or_panic
  assert model.valid?.or_panic # new record => :create
end

# it: passes when the value is present
begin
  model = V01PresenceContexts.new
  model.reason = "because"
  assert model.valid?(:publish).or_panic
end
