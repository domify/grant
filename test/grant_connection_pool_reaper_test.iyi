module test/grant_connection_pool_reaper_test
import test/pool_spec_support::{C02Support}
import grant/adapter/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/health_monitor::{HealthMonitor}
import grant/pool_reaper::{PoolReaper}
import std/time::{Span, Time}

pub def hold_connections(adapter : Base, count : Int32) : Nil
  ready = Channel(Nil).new
  release = Channel(Nil).new
  done = Channel(Nil).new
  group do |tasks|
    count.times do
      tasks.spawn do
        adapter.open do |connection|
          connection.scalar("SELECT 1").or_panic
          ready.send(nil).or_panic
          release.receive.or_panic
        end.or_panic
        done.send(nil).or_panic
      end
    end
    count.times { ready.receive.or_panic }
    count.times { release.send(nil).or_panic }
    count.times { done.receive.or_panic }
  end
  nil
end

pub def wait_until(timeout : Span, &condition : -> Bool) : Nil
  deadline = Time.monotonic + timeout
  until condition.call
    break if Time.monotonic > deadline
    sleep(10).or_panic
  end
  nil
end

HealthMonitor.test_mode = true

# it: leaves connections alone until nothing was checked out for idle_timeout
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, idle_timeout: Span.milliseconds(60_i64))
hold_connections(adapter, 3)
reaper = PoolReaper.new(adapter, Span.seconds(60_i64))

assert reaper.sweep == 0
assert adapter.pool_stat.idle == 3

sleep((Span.milliseconds(90_i64)).total_milliseconds.to_i32).or_panic
assert reaper.sweep == 3
assert adapter.pool_stat.connections == 0
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: keeps min_connections open when it closes idle ones
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, idle_timeout: Span.milliseconds(30_i64), min_connections: 2)
hold_connections(adapter, 4)
sleep((Span.milliseconds(60_i64)).total_milliseconds.to_i32).or_panic

assert PoolReaper.new(adapter, Span.seconds(60_i64)).sweep == 2

assert adapter.pool_stat.connections == 2
assert adapter.pool_stat.idle == 2
assert adapter.open(&.scalar("SELECT 1")).or_panic == 1
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: does not touch connections that are checked out
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, idle_timeout: Span.milliseconds(20_i64))
hold_connections(adapter, 3)

adapter.open do |connection|
  sleep((Span.milliseconds(50_i64)).total_milliseconds.to_i32).or_panic
  PoolReaper.new(adapter, Span.seconds(60_i64)).sweep
  assert connection.scalar("SELECT 1").or_panic == 1
end
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: retires idle connections that outlived max_age
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, max_age: Span.milliseconds(250_i64))
hold_connections(adapter, 3)
reaper = PoolReaper.new(adapter, Span.seconds(60_i64))

assert reaper.sweep == 0
sleep((Span.milliseconds(300_i64)).total_milliseconds.to_i32).or_panic
assert reaper.sweep == 3
assert adapter.pool_stat.connections == 0
assert adapter.open(&.scalar("SELECT 1")).or_panic == 1
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: closes a connection that passed max_age while it was checked out when it is returned
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, max_age: Span.milliseconds(250_i64))

adapter.open do |connection|
  sleep((Span.milliseconds(300_i64)).total_milliseconds.to_i32).or_panic
  assert connection.scalar("SELECT 1").or_panic == 1
end

assert adapter.pool_stat.connections == 0
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: pings idle connections on the keepalive interval
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5, keepalive: Span.milliseconds(20_i64))
hold_connections(adapter, 3)

assert adapter.keepalive_idle_connections == 3
assert adapter.pool_stat.idle == 3
assert adapter.pool_stat.busy == 0
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: does nothing without idle_timeout or keepalive
adapter = C02Support.establish("c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5)
hold_connections(adapter, 3)

assert PoolReaper.new(adapter, Span.seconds(60_i64)).sweep == 0
assert adapter.pool_stat.idle == 3
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

# it: sweeps on its own timer once the registry starts it, and stops when the connection is removed
HealthMonitor.test_mode = false
adapter = C02Support.establish(
  "c02_reaper", pool_size: 5, initial_pool_size: 1, max_idle_pool_size: 5,
  idle_timeout: Span.milliseconds(30_i64), reaping_frequency: Span.milliseconds(20_i64),
  health_check_interval: Span.seconds(3600_i64))
hold_connections(adapter, 3)
assert adapter.pool_stat.connections == 3

wait_until(Span.seconds(2_i64)) { adapter.pool_stat.connections == 0 }
assert adapter.pool_stat.connections == 0

ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic
HealthMonitor.test_mode = true
ConnectionRegistry.remove_connection("c02_reaper", :writing).or_panic

C02Support.cleanup
