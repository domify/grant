module test/grant_schema_alter_table_test

import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect, UnsupportedOperation}
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/driver::{Value}
import grant/errors::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
import std/text

private def m02b_scalar(sql : String) : Value | ErrorBase | Cancelled
  ::Test::SchemaFixture.adapter.open { |db| db.scalar(sql) }
end

# it: adds and removes columns
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_column_statements(:users, :age, :integer, null: false, default: 0, if_not_exists: true).or_panic == ["ALTER TABLE \"users\" ADD COLUMN IF NOT EXISTS \"age\" INTEGER NOT NULL DEFAULT 0"]
assert pg.remove_column_statements(:users, :age, :integer, if_exists: true).or_panic == ["ALTER TABLE \"users\" DROP COLUMN IF EXISTS \"age\""]
assert RecordingStatements.new(Dialect::Mysql).add_column_statements(:users, :age, :integer, comment: "Years").or_panic == ["ALTER TABLE `users` ADD COLUMN `age` INT COMMENT 'Years'"]
assert pg.add_column_statements(:users, :age, :integer, comment: "Years").or_panic.last == "COMMENT ON COLUMN \"users\".\"age\" IS 'Years'"
assert RecordingStatements.new(Dialect::Sqlite).add_column_statements(:users, :age, :integer, null: false).is_a?(UnsupportedOperation)

# it: changes a column type, null and default on PostgreSQL in one ALTER
pg = RecordingStatements.new(Dialect::Pg)
assert pg.change_column_statements(:users, :age, :bigint, null: false, default: 0, using: "age::bigint").or_panic == ["ALTER TABLE \"users\" ALTER COLUMN \"age\" TYPE BIGINT USING age::bigint, ALTER COLUMN \"age\" SET NOT NULL, ALTER COLUMN \"age\" SET DEFAULT 0"]
assert RecordingStatements.new(Dialect::Mysql).change_column_statements(:users, :age, :bigint, null: false).or_panic == ["ALTER TABLE `users` MODIFY COLUMN `age` BIGINT NOT NULL"]

# it: backfills before it forbids NULL
pg = RecordingStatements.new(Dialect::Pg)
assert pg.change_column_null_statements(:users, :email, false, default: "").or_panic == ["UPDATE \"users\" SET \"email\" = '' WHERE \"email\" IS NULL", "ALTER TABLE \"users\" ALTER COLUMN \"email\" SET NOT NULL"]
assert pg.change_column_null_statements(:users, :email, true).or_panic == ["ALTER TABLE \"users\" ALTER COLUMN \"email\" DROP NOT NULL"]

# it: combines bulk changes into one ALTER
build = ->(dialect : Dialect, bulk : Bool) do
  RecordingStatements.new(dialect).change_table_statements(:users, bulk: bulk) do |t|
    t.string(:nickname)
    t.integer(:age)
    t.remove(:legacy)
  end
end
assert build.call(Dialect::Pg, true).or_panic == ["ALTER TABLE \"users\" ADD COLUMN \"nickname\" VARCHAR, ADD COLUMN \"age\" INTEGER, DROP COLUMN \"legacy\""]
assert build.call(Dialect::Pg, false).or_panic.size == 3
assert build.call(Dialect::Mysql, true).or_panic == ["ALTER TABLE `users` ADD COLUMN `nickname` VARCHAR(255), ADD COLUMN `age` INT, DROP COLUMN `legacy`"]

# it: rebuilds a SQLite table once for several changes
lite = RecordingStatements.new(Dialect::Sqlite)
lite.sqlite_tables["users"] = {"CREATE TABLE \"users\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"name\" VARCHAR(255), \"legacy\" TEXT)", [] of String}
sql = lite.change_table_statements(:users, bulk: true) do |t|
  t.remove(:legacy)
  t.change_null(:name, false, default: "anon")
  t.string(:nickname)
end.or_panic
assert sql.count { |text| text.starts_with?("CREATE TABLE") } == 1
assert sql.first == "UPDATE \"users\" SET \"name\" = 'anon' WHERE \"name\" IS NULL"
assert sql.includes?("PRAGMA foreign_keys = OFF")
assert sql.find { |text| text.starts_with?("CREATE TABLE") }.as(String) == "CREATE TABLE \"__grant_rebuild_users\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"name\" VARCHAR(255) NOT NULL,\n  \"nickname\" VARCHAR(255)\n)"

register_spec_connections
restore_default_spec_connections
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
schema = ::Test::SchemaFixture.adapter.schema

private def reset(statements : AdapterStatements) : Nil
  statements.drop_table(:m02b_at, if_exists: true).or_panic
  statements.create_table(:m02b_at) do |t|
    t.string(:email)
    t.integer(:score, default: 1)
    t.string(:legacy)
  end.or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_at (email, score, legacy) VALUES (NULL, 7, 'old')").or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_at (email, score, legacy) VALUES ('a@x', 8, 'old')").or_panic
end

# it: adds a column with a default, if_not_exists, and reads it back
reset(statements)
statements.add_column(:m02b_at, :age, :integer, null: false, default: 3).or_panic
statements.add_column(:m02b_at, :age, :integer, null: false, default: 3, if_not_exists: true).or_panic
info = schema.columns(:m02b_at).or_panic.find { |column| column.name == "age" }.as(ColumnInfo)
assert !info.null?
assert m02b_scalar("SELECT age FROM m02b_at WHERE score = 7").or_panic == 3
assert statements.add_column(:m02b_at, :age, :integer).is_a?(ErrorBase)
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: adds a column with an expression default
reset(statements)
statements.add_column(:m02b_at, :seen_at, :datetime, null: false, default_sql: "CURRENT_TIMESTAMP").or_panic
assert m02b_scalar("SELECT COUNT(seen_at) FROM m02b_at").or_panic == 2
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: removes a column, also when an index uses it
reset(statements)
statements.add_index(:m02b_at, :legacy).or_panic
statements.remove_column(:m02b_at, :legacy, :string).or_panic
assert schema.columns(:m02b_at).or_panic.map { |column| column.name } == ["id", "email", "score"]
assert schema.indexes(:m02b_at).or_panic.empty?
assert m02b_scalar("SELECT COUNT(*) FROM m02b_at").or_panic == 2
statements.remove_column(:m02b_at, :legacy, if_exists: true).or_panic
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: changes a column type and keeps the data
reset(statements)
statements.change_column(:m02b_at, :score, :bigint).or_panic
assert m02b_scalar("SELECT SUM(score) FROM m02b_at").or_panic.to_s.to_f?.as(Float64).to_i64 == 15
assert schema.columns(:m02b_at).or_panic.find { |column| column.name == "score" }.as(ColumnInfo).sql_type.downcase.includes?(CURRENT_ADAPTER == "sqlite" ? "bigint" : "bigint")
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: sets NOT NULL after backfilling NULLs with a default
reset(statements)
assert statements.change_column_null(:m02b_at, :email, false).is_a?(ErrorBase)
statements.change_column_null(:m02b_at, :email, false, default: "nobody").or_panic
assert !schema.columns(:m02b_at).or_panic.find { |column| column.name == "email" }.as(ColumnInfo).null?
assert m02b_scalar("SELECT email FROM m02b_at WHERE score = 7").or_panic == "nobody"
statements.change_column_null(:m02b_at, :email, true).or_panic
assert schema.columns(:m02b_at).or_panic.find { |column| column.name == "email" }.as(ColumnInfo).null?
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: keeps the default and NOT NULL when changing only the type
reset(statements)
statements.change_column_null(:m02b_at, :score, false).or_panic
statements.change_column(:m02b_at, :score, :bigint).or_panic
info = schema.columns(:m02b_at).or_panic.find { |column| column.name == "score" }.as(ColumnInfo)
assert !info.null?
assert info.default.to_s.includes?("1")
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: applies bulk: true as one statement on PostgreSQL and MySQL and one rebuild on SQLite
reset(statements)
statements.change_table(:m02b_at, bulk: true) do |t|
  t.string(:nickname)
  t.remove(:legacy)
  t.change_null(:email, false, default: "anon")
end.or_panic
assert schema.columns(:m02b_at).or_panic.map { |column| column.name } == ["id", "email", "score", "nickname"]
assert m02b_scalar("SELECT COUNT(*) FROM m02b_at WHERE email = 'anon'").or_panic == 1
statements.drop_table(:m02b_at, if_exists: true).or_panic

# it: changes the default in place
reset(statements)
if CURRENT_ADAPTER != "sqlite"
  statements.change_column_default(:m02b_at, :score, to: 42).or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_at (email) VALUES ('d')").or_panic
  assert m02b_scalar("SELECT score FROM m02b_at WHERE email = 'd'").or_panic == 42
end
statements.drop_table(:m02b_at, if_exists: true).or_panic
