module test/grant_query_lazy_all_test

import grant/base::{Base}
import grant/query/builder::{Builder}
import test/spec_helper::{register_spec_connections}
import test/transaction_crud_models::{Parent}
import test/query_relation_sql_capture::{capture_sql, seed_parents}

pub class LazyAllScopedRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table q01_lazy_all_rows
  column id : Int64, primary: true
  column label : String?
  column visible : Bool = true
  column weight : Int32?
  default_scope { where(visible: true) }
  scope :heavy, ->(query : Builder(LazyAllScopedRow)) { query.where("weight > ?", 5) }
  scope :by_label, ->(query : Builder(LazyAllScopedRow)) { query.order(:label) }
end

private def reset_scoped : Nil
  LazyAllScopedRow.unscoped.delete_all.or_panic
  LazyAllScopedRow.create(label: "b", visible: true, weight: 9)
  LazyAllScopedRow.create(label: "a", visible: true, weight: 1)
  LazyAllScopedRow.create(label: "hidden", visible: false, weight: 9)
  nil
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic
LazyAllScopedRow.migrator.drop_and_create.or_panic

# it: returns a relation and runs no SQL until it is read
seed_parents(["a", "b"])
relation : Builder(Parent)? = nil
statements = capture_sql { relation = Parent.all.where(name: "a").order(:id).limit(5) }
assert statements.empty?
assert relation.is_a?(Builder(Parent))

# it: chains where, order, limit and offset after all
seed_parents(["a", "b", "c", "d"])
assert Parent.all.where("name != ?", "a").order(:name).limit(2).offset(1).to_a.or_panic.compact_map(&.name) == ["c", "d"]
assert Parent.all.where(name: ["a", "b"]).count.or_panic == 2
assert Parent.all.where(name: "c").first.or_panic.as(Parent).name == "c"

# it: supports Enumerable and size on the returned relation
seed_parents(["a", "b", "c"])
assert Parent.all.size.or_panic == 3
assert Parent.all.compact_map(&.name).or_panic.sorted == ["a", "b", "c"]
assert Parent.all.to_a.or_panic.size == 3
assert Parent.all.select.or_panic.size == 3
assert Parent.all.reduce(0) { |sum, _| sum + 1 }.or_panic == 3

# it: loads a lazy relation once and reuses it across iterations
seed_parents(["a", "b"])
base = Parent.all
statements = capture_sql do
  base.each { |_| }.or_panic
  base.each { |_| }.or_panic
end
assert statements.size == 1

# it: makes relation.all a lazy copy
seed_parents(["a", "b"])
base = Parent.where("name != ?", "zzz")
assert capture_sql { base.all.order(:name) }.empty?
assert base.all.object_id != base.object_id
assert base.all.order(:name).limit(1).to_a.or_panic.size == 1
assert base.order_fields.empty?

# it: keeps the legacy Model.all(clause, params) overload returning an Array
seed_parents(["a", "b"])
found = Parent.all("WHERE name = ?", ["a"]).or_panic
assert found.is_a?(Array(Parent))
assert found.size == 1
assert found.first.name == "a"
assert Parent.all("WHERE name = ? OR name = ?", ["a", "b"]).or_panic.size == 2
assert Parent.all("ORDER BY name DESC").or_panic.compact_map(&.name) == ["b", "a"]

# it: keeps raw_all returning an Array
seed_parents(["a"])
assert Parent.raw_all("WHERE name = ?", ["a"]).or_panic.is_a?(Array(Parent))

# it: applies the default scope to lazy all
reset_scoped
assert LazyAllScopedRow.all.size.or_panic == 2
assert LazyAllScopedRow.all.where(weight: 9).to_a.or_panic.compact_map(&.label) == ["b"]
assert LazyAllScopedRow.unscoped.all.size.or_panic == 3

# it: chains named scopes without leaking clauses into the base relation
reset_scoped
scoped = LazyAllScopedRow.heavy.all
assert scoped.by_label.to_a.or_panic.compact_map(&.label) == ["b"]
assert scoped.by_label.object_id != scoped.object_id
assert scoped.to_a.or_panic.compact_map(&.label) == ["b"]
assert scoped.order_fields.empty?
assert scoped.where_fields.size == 1

# it: keeps named scopes composable in any order
reset_scoped
assert LazyAllScopedRow.by_label.heavy.to_a.or_panic.compact_map(&.label) == ["b"]
assert LazyAllScopedRow.heavy.where(label: "b").count.or_panic == 1

Parent.adapter.close.or_panic
