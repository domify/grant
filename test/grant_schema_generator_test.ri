module test/grant_schema_generator_test
import grant/schema/generator::{Generator, GeneratorError}
import grant/schema/migration::{Migration}
import grant/schema/migration_context::{MigrationContext}
import grant/schema/schema_statements::{AdapterStatements}
import grant/schema/introspection
import grant/error::{ErrorBase}
import std/time::{Time}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}


# it: parses AddEmailToUsers into add_column plus index
plan = Generator.parse("AddEmailToUsers", ["email:string:index"]).or_panic
assert plan.kind == Generator::Kind::AddColumns
assert plan.table == "users"
assert plan.class_name == "AddEmailToUsers"
assert plan.steps.map(&.method) == ["add_column", "add_index"]
assert plan.steps[0].arguments == [":users", ":email", ":string"]
assert plan.steps[1].arguments == [":users", ":email"]

# it: makes a unique index for the uniq modifier
plan = Generator.parse("AddSlugToPosts", ["slug:string:uniq"]).or_panic
assert plan.steps[1].arguments == [":posts", ":slug", "unique: true"]

# it: adds several columns, with limit and precision options
plan = Generator.parse("AddDetailsToProducts", ["part_number:string{20}", "price:decimal{10,2}", "stock:integer"]).or_panic
assert plan.steps.map(&.arguments) == [
  [":products", ":part_number", ":string", "limit: 20"],
  [":products", ":price", ":decimal", "precision: 10", "scale: 2"],
  [":products", ":stock", ":integer"],
]

# it: parses CreateUsers into create_table with the attributes and timestamps
plan = Generator.parse("CreateUsers", ["email:string:uniq", "age:integer", "team:references"]).or_panic
assert plan.kind == Generator::Kind::CreateTable
assert plan.table == "users"
step = plan.steps.first
assert step.method == "create_table"
assert step.arguments == [":users"]
assert step.block_lines == [
  "t.string :email",
  "t.integer :age",
  "t.references :team, foreign_key: true",
  "t.index :email, unique: true",
  "t.timestamps",
]

# it: parses RemoveEmailFromUsers with the type, so it can be reversed
plan = Generator.parse("RemoveEmailFromUsers", ["email:string"]).or_panic
assert plan.kind == Generator::Kind::RemoveColumns
assert plan.steps.first.method == "remove_column"
assert plan.steps.first.arguments == [":users", ":email", ":string"]

# it: parses CreateJoinTableUsersGroups
plan = Generator.parse("CreateJoinTableUsersGroups").or_panic
assert plan.kind == Generator::Kind::CreateJoinTable
assert plan.steps.first.method == "create_join_table"
assert plan.steps.first.arguments == [":users", ":groups"]

# it: gives references on add a reference step and polymorphic ones no foreign key
plan = Generator.parse("AddAuthorToPosts", ["author:references", "owner:belongs_to{polymorphic}"]).or_panic
assert plan.steps.map(&.method) == ["add_reference", "add_reference"]
assert plan.steps[0].arguments == [":posts", ":author", "foreign_key: true"]
assert plan.steps[1].arguments == [":posts", ":owner", "polymorphic: true"]

# it: accepts snake_case names and an empty change for other names
assert Generator.parse("add_email_to_users", ["email"]).or_panic.class_name == "AddEmailToUsers"
plan = Generator.parse("BackfillUsers").or_panic
assert plan.kind == Generator::Kind::Blank
assert plan.steps.empty?

# it: rejects bad names and attributes
error = Generator.parse("")
assert error.is_a?(GeneratorError)
assert error.as(GeneratorError).message.to_s.includes?("name")
error = Generator.parse("AddXToY", ["x:blob3"])
assert error.is_a?(GeneratorError)
assert error.as(GeneratorError).message.to_s.includes?("unknown type")
error = Generator.parse("AddXToY", ["x:string:fast"])
assert error.is_a?(GeneratorError)
assert error.as(GeneratorError).message.to_s.includes?("unknown modifier")
error = Generator.parse("AddXToY", ["x:string", "x:text"])
assert error.is_a?(GeneratorError)
assert error.as(GeneratorError).message.to_s.includes?("twice")
error = Generator.parse("CreateJoinTableUsers")
assert error.is_a?(GeneratorError)
assert error.as(GeneratorError).message.to_s.includes?("two tables")

# it: renders the migration class for the timestamped version
assert Generator.render("AddEmailToUsers", ["email:string:index"], 20260930120000_i64).or_panic == "class AddEmailToUsers < Grant::Schema::Migration\n  migration_version 20260930120000\n\n  def change\n    add_column :users, :email, :string\n    add_index :users, :email\n  end\nend\n"

# it: formats a Time as a UTC timestamp version and file name
time = Time.utc(2026, 9, 30, 12, 34, 56)
assert Generator.version_number(time) == 20260930123456_i64
assert Generator.file_name("AddEmailToUsers", time).or_panic == "20260930123456_add_email_to_users.cr"


pub class M04AddEmailToUsers < Migration
  migration_version 20260930120001
  def change : Nil | ErrorBase | Cancelled
    add_column(:m04_gen_users, :email, :string)!
    add_index(:m04_gen_users, :email)
  end
end
register_spec_connections
restore_default_spec_connections
# it: renders source identical to the compiled class and runs on the database
rendered = Generator.render("AddEmailToUsers", ["email:string:index"], 20260930120001_i64).or_panic
assert rendered.includes?("add_column :users, :email, :string")
adapter = ::Test::SchemaFixture.adapter
adapter.open { |db| db.exec("DROP TABLE IF EXISTS m04_gen_users") }.or_panic
adapter.open { |db| db.exec("DROP TABLE IF EXISTS schema_migrations") }.or_panic
statements = AdapterStatements.new(adapter)
statements.create_table(:m04_gen_users) { |t| t.string(:name) }.or_panic
context = MigrationContext.for(adapter, M04AddEmailToUsers, verbose: false)
assert context.migrate.or_panic == [20260930120001_i64]
adapter.reset_schema_caches_in_place
assert adapter.schema.column_exists?(:m04_gen_users, :email).or_panic
assert adapter.schema.index_exists?(:m04_gen_users, [:email]).or_panic
context.rollback.or_panic
adapter.reset_schema_caches_in_place
assert !adapter.schema.column_exists?(:m04_gen_users, :email).or_panic
adapter.open { |db| db.exec("DROP TABLE IF EXISTS m04_gen_users") }.or_panic
adapter.open { |db| db.exec("DROP TABLE IF EXISTS schema_migrations") }.or_panic
adapter.reset_schema_caches_in_place
