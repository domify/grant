module test/grant_query_relation_components_test

import test/transaction_crud_models::{Parent}
import test/query_relation_sql_capture::{capture_sql, seed_parents}
import test/spec_helper::{register_spec_connections}
import grant/error::{ArgumentError}
import std/regex::{Regex}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: except drops the named components and returns a copy
base = Parent.where(name: "a").order(:name).limit(5).offset(2)

trimmed = base.except(:order, :limit)

assert trimmed.order_fields.empty?
assert trimmed.limit.nil?
assert trimmed.offset == 2
assert trimmed.where_fields.size == 1
assert base.order_fields.size == 1
assert base.limit == 5


# it: only keeps just the named components
base = Parent.where(name: "a").order(:name).limit(5).offset(2).group_by(:name).distinct

kept = base.only(:where, :order)

assert kept.where_fields.size == 1
assert kept.order_fields.size == 1
assert kept.limit.nil?
assert kept.offset.nil?
assert kept.group_fields.empty?
assert !kept.distinct?
assert base.limit == 5
assert base.group_fields.size == 1


# it: only(:where) yields a pure filter
only_where = Parent.where(name: "a").order(:name).limit(1).only(:where)

assert only_where.to_sql.includes?("WHERE")
assert !only_where.to_sql.includes?("ORDER BY")
assert !only_where.to_sql.includes?("LIMIT")


# it: rejects unknown components
error = Parent.where(name: "a").only(:bogus).select
assert error.is_a?(ArgumentError)
assert error.message.includes?("only: unknown component") if error.is_a?(ArgumentError)
error = Parent.where(name: "a").except(:bogus).select
assert error.is_a?(ArgumentError)
assert error.message.includes?("unknown component") if error.is_a?(ArgumentError)


# it: runs the trimmed relation
seed_parents(["a", "b", "c"])

assert Parent.where("name != ?", "a").order(:name).limit(1).except(:limit).to_a.or_panic.compact_map(&.name) == ["b", "c"]
assert Parent.where("name != ?", "a").order(name: :desc).only(:where).count.or_panic == 2


# it: matches raw_sql
relation = Parent.where(name: "a").order(:name).limit(3)

assert relation.to_sql == relation.raw_sql
assert relation.to_sql.includes?("SELECT")
assert relation.to_sql.includes?("LIMIT 3")


# it: runs no query
assert capture_sql { Parent.where(name: "a").to_sql }.empty?


# it: is stable for the same query and differs between queries
first = Parent.where(name: "a").cache_key.or_panic
assert first == Parent.where(name: "a").cache_key.or_panic
assert first.starts_with?("parents/query-")
assert first != Parent.where(name: "b").cache_key.or_panic
assert first != Parent.where(name: "a").order(:name).cache_key.or_panic


# it: runs no query
assert capture_sql { Parent.where(name: "a").cache_key.or_panic }.empty?


# it: combines the row count with the newest updated_at in one query
seed_parents(["a", "b"])
relation = Parent.where("name != ?", "zzz")

version = ""
statements = capture_sql { version = relation.cache_version.or_panic }

assert statements.size == 1
assert statements.first.upcase.includes?("COUNT(*)")
assert statements.first.upcase.includes?("MAX(")
assert /^2-[0-9]+$/.match?(version)

assert capture_sql { relation.cache_version.or_panic }.empty?


# it: changes when rows change and is memoized until reset
seed_parents(["a"])
relation = Parent.where("name != ?", "zzz")

first = relation.cache_version.or_panic
assert first.starts_with?("1-")
Parent.create_strict(name: "b").or_panic
assert relation.cache_version.or_panic == first
assert relation.reset.cache_version.or_panic.starts_with?("2-")
assert relation.cache_version.or_panic != first


# it: is zero for an empty or none relation
seed_parents(["a"])

assert Parent.where(name: "nope").cache_version.or_panic == "0"
assert Parent.where("name != ?", "zzz").none.cache_version.or_panic == "0"


# it: does not mutate the relation
seed_parents(["a"])
relation = Parent.where("name != ?", "zzz")
sql = relation.to_sql

relation.cache_version.or_panic

assert relation.to_sql == sql
assert relation.order_fields.empty?
