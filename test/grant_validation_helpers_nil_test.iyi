module test/grant_validation_helpers_nil_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class NilTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true

  column first_name_not_nil : String?
  column last_name_not_nil : String?
  column age_not_nil : Int32?
  column born_not_nil : Bool?
  column value_not_nil : Float32?

  column first_name : String?
  column last_name : String?
  column age : Int32?
  column born : Bool?
  column value : Float32?

  validate_not_nil "first_name_not_nil"
  validate_not_nil :last_name_not_nil
  validate_not_nil :age_not_nil
  validate_not_nil "born_not_nil"
  validate_not_nil :value_not_nil

  validate_is_nil "first_name"
  validate_is_nil :last_name
  validate_is_nil :age
  validate_is_nil "born"
  validate_is_nil :value
end

register_spec_connections
NilTest.migrator.drop_and_create.or_panic

# it: should work for is_nil and not_nil for all data types
nil_test = NilTest.new

nil_test.first_name = "John"
nil_test.last_name = "Smith"
nil_test.age = 32
nil_test.born = true
nil_test.value = 123.56.to_f32

nil_test.save

assert nil_test.errors.size == 10
assert nil_test.errors[0].message == "first_name_not_nil must not be nil"
assert nil_test.errors[1].message == "last_name_not_nil must not be nil"
assert nil_test.errors[2].message == "age_not_nil must not be nil"
assert nil_test.errors[3].message == "born_not_nil must not be nil"
assert nil_test.errors[4].message == "value_not_nil must not be nil"
assert nil_test.errors[5].message == "first_name must be nil"
assert nil_test.errors[6].message == "last_name must be nil"
assert nil_test.errors[7].message == "age must be nil"
assert nil_test.errors[8].message == "born must be nil"
assert nil_test.errors[9].message == "value must be nil"
NilTest.adapter.close.or_panic
