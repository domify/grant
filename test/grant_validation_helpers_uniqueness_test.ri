module test/grant_validation_helpers_uniqueness_test

import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class PersonUniqueness < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column name : String?

  validate_uniqueness :name
end

register_spec_connections

# it: should work for uniqueness
PersonUniqueness.migrator.drop_and_create.or_panic
person_uniqueness1 = PersonUniqueness.new
person_uniqueness2 = PersonUniqueness.new
person_uniqueness1.name = "awesomeName"
person_uniqueness2.name = "awesomeName"
person_uniqueness1.save.or_panic
person_uniqueness2.save.or_panic
assert person_uniqueness1.errors.size == 0
assert person_uniqueness2.errors.size == 1
assert person_uniqueness2.errors[0].message == "name should be unique"

# it: should work for uniqueness on the same instance
PersonUniqueness.migrator.drop_and_create.or_panic
person_uniqueness1 = PersonUniqueness.new
person_uniqueness1.name = "awesomeName"
person_uniqueness1.save.or_panic
assert person_uniqueness1.errors.size == 0
person_uniqueness1.name = "awesomeName"
person_uniqueness1.save.or_panic
assert person_uniqueness1.errors.size == 0

PersonUniqueness.adapter.close.or_panic
