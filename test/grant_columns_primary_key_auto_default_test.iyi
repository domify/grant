module test/grant_columns_primary_key_auto_default_test
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class PrimaryKeyAutoDefaultSlug < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table primary_key_auto_default_slugs
  column id : String, primary: true
  column title : String?
end

pub class PrimaryKeyAutoDefaultCounter < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table primary_key_auto_default_counters
  column id : Int64, primary: true
  column title : String?
end

pub class PrimaryKeyAutoExplicitCounter < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table primary_key_auto_explicit_counters
  column id : Int64, primary: true, auto: true
  column title : String?
end

pub class PrimaryKeyAutoExplicitOff < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table primary_key_auto_explicit_offs
  column id : Int64, primary: true, auto: false
  column title : String?
end

register_spec_connections

# it: does not auto-generate a String primary key
PrimaryKeyAutoDefaultSlug.migrator.drop_and_create.or_panic
slug = PrimaryKeyAutoDefaultSlug.new(title: "First")
slug.id = "first-post"
slug.save_strict.or_panic
assert PrimaryKeyAutoDefaultSlug.find_strict("first-post").or_panic.title == "First"

# it: still auto-generates an integer primary key
PrimaryKeyAutoDefaultCounter.migrator.drop_and_create.or_panic
counter = PrimaryKeyAutoDefaultCounter.create_strict(title: "One").or_panic
assert !counter.id.nil?
assert PrimaryKeyAutoDefaultCounter.find_strict(counter.id).or_panic.title == "One"

# it: honors an explicit auto: true
PrimaryKeyAutoExplicitCounter.migrator.drop_and_create.or_panic
counter = PrimaryKeyAutoExplicitCounter.create_strict(title: "One").or_panic
assert !counter.id.nil?
assert PrimaryKeyAutoExplicitCounter.find_strict(counter.id).or_panic.title == "One"

# it: honors an explicit auto: false
PrimaryKeyAutoExplicitOff.migrator.drop_and_create.or_panic
record = PrimaryKeyAutoExplicitOff.new(title: "Chosen")
record.id = 42_i64
record.save_strict.or_panic
assert PrimaryKeyAutoExplicitOff.find_strict(42_i64).or_panic.title == "Chosen"

PrimaryKeyAutoDefaultSlug.adapter.close.or_panic
