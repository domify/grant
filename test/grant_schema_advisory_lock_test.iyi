module test/grant_schema_advisory_lock_test

import grant
import grant/advisory_lock::{AdvisoryLockTimeout, LockFile}
import grant/adapter/pg::{Pg}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}
import std/time::{Span}
import std/digest::{MD5}
import test/spec_helper::{CURRENT_ADAPTER, ADAPTER_URL, register_spec_connections, restore_default_spec_connections}
import test/m03_fixture

private def m03_sqlite_lock_path(key : String) : String
  "#{::Test::M03Fixture.adapter.current_database}.grant-lock-#{MD5.hexdigest(key)[0, 12]}"
end

register_spec_connections
restore_default_spec_connections
adapter = ::Test::M03Fixture.adapter

# it: serializes two fibers that want the same key
events = [] of String
done = Channel(Nil).new
group do |tasks|
  2.times do |index|
    tasks.spawn do
      ::Grant.with_advisory_lock("m03-serial", adapter, Span.seconds(5_i64)) do
        events << "enter#{index}"
        sleep(60).or_panic
        events << "leave#{index}"
      end.or_panic
      done.send(nil).or_panic
    end
  end
  2.times { done.receive.or_panic }
end
assert events.size == 4
assert events[0][5] == events[1][5]
assert events[2][5] == events[3][5]

# it: lets different keys run side by side
inside = Channel(Nil).new
release = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    ::Grant.with_advisory_lock("m03-key-a", adapter) do
      inside.send(nil).or_panic
      release.receive.or_panic
    end.or_panic
  end
  inside.receive.or_panic
  reached = false
  ::Grant.with_advisory_lock("m03-key-b", adapter, Span.seconds(1_i64)) { reached = true }.or_panic
  assert reached
  release.send(nil).or_panic
  sleep(10).or_panic
end

# it: times out while another holder keeps the key, then succeeds once it lets go
inside = Channel(Nil).new
release = Channel(Nil).new
finished = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    ::Grant.with_advisory_lock("m03-timeout", adapter) do
      inside.send(nil).or_panic
      release.receive.or_panic
    end.or_panic
    finished.send(nil).or_panic
  end
  inside.receive.or_panic
  error = ::Grant.with_advisory_lock("m03-timeout", adapter, Span.milliseconds(100_i64)) { nil }
  assert error.is_a?(AdvisoryLockTimeout)
  assert error.as(AdvisoryLockTimeout).key == "m03-timeout"
  release.send(nil).or_panic
  finished.receive.or_panic
  ::Grant.with_advisory_lock("m03-timeout", adapter, Span.seconds(1_i64)) { nil }.or_panic
end

# it: releases the lock when the block raises
error = ::Grant.with_advisory_lock("m03-raise", adapter) { ErrorBase.new("inside the lock") }
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("inside the lock")
::Grant.with_advisory_lock("m03-raise", adapter, Span.milliseconds(200_i64)) { nil }.or_panic

# it: lets the holder take the same key again
value = ::Grant.with_advisory_lock("m03-reenter", adapter, Span.milliseconds(200_i64)) do
  ::Grant.with_advisory_lock("m03-reenter", adapter, Span.milliseconds(200_i64)) { 42 }
end.or_panic
assert value == 42

# it: returns the block's value
assert ::Grant.with_advisory_lock("m03-value", adapter) { "done" }.or_panic == "done"

# it: holds the lock on the connection that runs the block's statements
if CURRENT_ADAPTER == "pg"
  ::Grant.with_advisory_lock("m03-connection", adapter) do
    pid = adapter.open { |db| db.scalar("SELECT pg_backend_pid()").or_panic.as(Int64) }.or_panic
    again = adapter.open { |db| db.scalar("SELECT pg_backend_pid()").or_panic.as(Int64) }.or_panic
    assert again == pid
    held = adapter.open { |db| db.scalar("SELECT COUNT(*) FROM pg_locks WHERE locktype = 'advisory' AND pid = #{pid}").or_panic.as(Int64) }.or_panic
    assert held == 1
  end.or_panic
  left = adapter.open { |db| db.scalar("SELECT COUNT(*) FROM pg_locks WHERE locktype = 'advisory' AND pid <> pg_backend_pid() AND granted").or_panic.as(Int64) }.or_panic
  assert left == 0
end

# it: serializes against a second PostgreSQL connection and releases when that connection dies
if CURRENT_ADAPTER == "pg"
  key = "m03-death"
  foreign = Pg.new("m03_foreign", ADAPTER_URL)
  foreign.with_connection do |conn|
    pid = conn.scalar("SELECT pg_backend_pid()").or_panic.as(Int64)
    conn.scalar("SELECT pg_advisory_lock($1)", [::Grant::AdvisoryLock.key_to_int64(key).as(Value)]).or_panic
    error = ::Grant.with_advisory_lock(key, adapter, Span.milliseconds(150_i64)) { nil }
    assert error.is_a?(AdvisoryLockTimeout)
    adapter.open { |db| db.scalar("SELECT pg_terminate_backend(#{pid})") }.or_panic
  end
  # The terminated session may return a driver error during cleanup.
  foreign.disconnect_strict
  reached = false
  ::Grant.with_advisory_lock(key, adapter, Span.seconds(3_i64)) { reached = true }.or_panic
  assert reached
end

# it: waits on a file lock held by another process
if CURRENT_ADAPTER == "sqlite"
  key = "m03-flock"
  ::Grant.with_advisory_lock(key, adapter, Span.milliseconds(200_i64)) { nil }.or_panic
  outside = LockFile.new(m03_sqlite_lock_path(key))
  assert outside.try_exclusive
  error = ::Grant.with_advisory_lock(key, adapter, Span.milliseconds(150_i64)) { nil }
  assert error.is_a?(AdvisoryLockTimeout)
  outside.close
  reached = false
  ::Grant.with_advisory_lock(key, adapter, Span.seconds(1_i64)) { reached = true }.or_panic
  assert reached
end
assert ::Grant.with_advisory_lock("m03-default") { 7 }.or_panic == 7
adapter.disconnect_strict.or_panic
