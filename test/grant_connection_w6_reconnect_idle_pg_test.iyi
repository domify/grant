module test/grant_connection_w6_reconnect_idle_pg_test
import std/time::{Span}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite, Connection}
import grant/adapter/pg::{Pg}
import grant/adapter/drivers::{open_connection}
import grant/connection_registry::{ConnectionRegistry}
import grant/database::{ConnectionLost}
import grant/errors::{ErrorBase}
import grant/error_taxonomy::{ConnectionFailed}
import test/w6_c04_support::{W6C04}

# SQLite has no server to restart, so its adapter here fails the idle probe the
# way a dead socket does. PostgreSQL gets the real thing: its backends are
# terminated, as a restart or a failover would.
pub class W6ProbeSqlite < Sqlite
  property probes : Int32 = 0
  property dead_probes : Int32 = 0

  protected def verify_idle_connection(connection : Connection) : Nil | ErrorBase
    @probes += 1
    if @dead_probes > 0
      @dead_probes -= 1
      return ConnectionLost.new(connection)
    end
    super
  end
end

pub class W6IdleThing < Base
  connection "w6_idle"
  table w6_idle_things
  column id : Int64, primary: true
  column label : String?
end

private def w6_idle_adapter(verify_idle_after : Span?) : ::Grant::Adapter::Base::Base
  if W6C04.pg?
    ConnectionRegistry.establish_connection(database: "w6_idle", adapter: Pg, url: W6C04.url("w6_idle"),
      role: :primary, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
  else
    ConnectionRegistry.establish_connection(database: "w6_idle", adapter: W6ProbeSqlite, url: W6C04.url("w6_idle"),
      role: :primary, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
  end
  ConnectionRegistry.get_adapter("w6_idle", :primary)
end

# Makes every idle connection of *adapter* dead: terminates the PostgreSQL
# backends, or arms the SQLite probe to fail once.
private def w6_kill_idle_connections(adapter : ::Grant::Adapter::Base::Base) : Nil
  if W6C04.pg?
    killer = open_connection(W6C04.pg_url("postgres")).or_panic
    killer.exec("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '#{W6C04.database_name("w6_idle")}' AND pid <> pg_backend_pid()").or_panic
    killer.close.or_panic
  else
    adapter.as(W6ProbeSqlite).dead_probes = 1
  end
  nil
end

private def w6_probes(adapter : ::Grant::Adapter::Base::Base) : Int32
  W6C04.pg? ? 0 : adapter.as(W6ProbeSqlite).probes
end

W6C04.provision("w6_idle", ["CREATE TABLE w6_idle_things (#{W6C04.id_column}, label TEXT)"])

if W6C04.pg?
  # it: without the probe a dead idle connection still fails one write
  adapter = w6_idle_adapter(nil)
  W6IdleThing.create_strict(label: "warm").or_panic
  w6_kill_idle_connections(adapter)

  unlucky = W6IdleThing.create_strict(label: "unlucky")
  assert unlucky.is_a?(ConnectionFailed)
  W6IdleThing.create_strict(label: "next one works").or_panic
  assert W6IdleThing.where(label: "unlucky").select.or_panic.size == 0
  W6C04.remove("w6_idle", :primary)
end
W6C04.cleanup
