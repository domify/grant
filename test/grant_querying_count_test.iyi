module test/grant_querying_count_test

import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}
import test/transaction_crud_models::{Parent}
import grant/connection::{Connection}
import grant/result::{Result}
import grant/querying
import grant/adapter/driver::{Value}

pub class LargeCountScope
  def count : Int64 | ::Grant::Error::ErrorBase | Cancelled
    value = Connection.new(->(role : Symbol) { ::Grant::Connections::Connections[CURRENT_ADAPTER] }).select_value("SELECT 2147483648")!
    return ::Grant::Errors::DatabaseError.new(0, "count", "The count probe query returned no value") if value.nil?
    Result.integer_count(value)
  end
end

pub class LargeCountProbe
  ::Grant::Querying.class_methods

  def self.current_scope : LargeCountScope
    LargeCountScope.new
  end
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: round-trips a count larger than Int32::MAX
assert LargeCountProbe.count.or_panic == 2_147_483_648_i64

# it: returns Int64 for model, relation, grouped, and relation size counts
Parent.clear
Parent.new(name: "count probe").save
assert Parent.count.or_panic.is_a?(Int64)
relation = Parent.where(name: "count probe")
assert relation.count.or_panic.is_a?(Int64)
assert relation.size.or_panic.is_a?(Int64)
assert Parent.group_by(:name).count.or_panic.is_a?(Hash(Value, Int64))
grouped_size = Parent.group_by(:name).size.or_panic
assert grouped_size.is_a?(Int64)
assert grouped_size == 1_i64

# it: returns 0 if no result
Parent.clear
count = Parent.count.or_panic
assert count == 0

# it: returns a number of the all records for the model
count = Parent.count.or_panic
2.times do |i|
  Parent.new(name: "model_#{i}").save
end
assert Parent.count.or_panic - count == 2
Parent.adapter.close.or_panic

# Supplemental coverage of upstream Result.integer_count conversions.
assert Result.integer_count(nil).or_panic == 0_i64
assert Result.integer_count(2_147_483_648_u64).or_panic == 2_147_483_648_i64
assert Result.integer_count("2147483648").or_panic == 2_147_483_648_i64
assert Result.integer_count("3.5").or_panic == 3_i64
assert Result.integer_count(4.5).or_panic == 4_i64
assert Result.integer_count("not numeric").is_a?(::Grant::Error::ArgumentError)
