module test/adapter_adapter_matrix_doc_test

import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/server_version::{ServerVersion}
import grant/errors::{ErrorBase}
import std/env::{ENV}
import std/text
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
import grant/connections::{Connections}
import grant/events::{SQL}
import grant/notifications

MATRIX_PATH = "docs/adapter_matrix.md"
START_MARKER = "<!-- capabilities:start -->"
END_MARKER = "<!-- capabilities:end -->"

private def yes_no(value : Bool | ErrorBase) : String | ErrorBase
  value! ? "yes" : "no"
end

private def generated_matrix : String
  pg = Pg.new("g01_doc_pg", "postgres://localhost/unused")
  pg.database_version = ServerVersion.new(17)
  sqlite = Sqlite.new("g01_doc_sqlite", "sqlite3:build/tmp/g01_doc.db")
  sqlite.database_version = ServerVersion.new(3, 45)
  gates = {
    "supports_insert_returning?" => "SQLite 3.35",
    "supports_json?" => "SQLite 3.38",
    "supports_virtual_columns?" => "PostgreSQL 12; SQLite 3.31",
    "supports_concurrent_connections?" => "SQLite: file databases only",
    "supports_nulls_not_distinct?" => "PostgreSQL 15",
  }
  rows = [
    {"supports_insert_returning?", pg.supports_insert_returning?, sqlite.supports_insert_returning?},
    {"supports_insert_on_duplicate_skip?", pg.supports_insert_on_duplicate_skip?, sqlite.supports_insert_on_duplicate_skip?},
    {"supports_insert_on_duplicate_update?", pg.supports_insert_on_duplicate_update?, sqlite.supports_insert_on_duplicate_update?},
    {"supports_ddl_transactions?", pg.supports_ddl_transactions?, sqlite.supports_ddl_transactions?},
    {"supports_partial_index?", pg.supports_partial_index?, sqlite.supports_partial_index?},
    {"supports_expression_index?", pg.supports_expression_index?, sqlite.supports_expression_index?},
    {"supports_check_constraints?", pg.supports_check_constraints?, sqlite.supports_check_constraints?},
    {"supports_foreign_keys?", pg.supports_foreign_keys?, sqlite.supports_foreign_keys?},
    {"supports_views?", pg.supports_views?, sqlite.supports_views?},
    {"supports_datetime_with_precision?", pg.supports_datetime_with_precision?, sqlite.supports_datetime_with_precision?},
    {"supports_json?", pg.supports_json?, sqlite.supports_json?},
    {"supports_common_table_expressions?", pg.supports_common_table_expressions?, sqlite.supports_common_table_expressions?},
    {"supports_virtual_columns?", pg.supports_virtual_columns?, sqlite.supports_virtual_columns?},
    {"supports_comments?", pg.supports_comments?, sqlite.supports_comments?},
    {"supports_explain?", pg.supports_explain?, sqlite.supports_explain?},
    {"supports_optimizer_hints?", pg.supports_optimizer_hints?, sqlite.supports_optimizer_hints?},
    {"supports_advisory_locks?", pg.supports_advisory_locks?, sqlite.supports_advisory_locks?},
    {"supports_bulk_alter?", pg.supports_bulk_alter?, sqlite.supports_bulk_alter?},
    {"supports_concurrent_connections?", pg.supports_concurrent_connections?, sqlite.supports_concurrent_connections?},
    {"supports_restart_db_transaction?", pg.supports_restart_db_transaction?, sqlite.supports_restart_db_transaction?},
    {"supports_disable_referential_integrity?", pg.supports_disable_referential_integrity?, sqlite.supports_disable_referential_integrity?},
    {"supports_nulls_not_distinct?", pg.supports_nulls_not_distinct?, sqlite.supports_nulls_not_distinct?},
  ]
  String.build do |io|
    io << "| Predicate | PostgreSQL 17 | SQLite 3.45 | Version gates |\n"
    io << "| --- | --- | --- | --- |\n"
    rows.each do |row|
      name = row[0]
      io << "| `" << name << "` | " << yes_no(row[1]).or_panic << " | " << yes_no(row[2]).or_panic
      io << " | " << (gates[name]? || "") << " |\n"
    end
  end
end

# it: lists exactly what the capability predicates answer
# The native table retains both in-scope adapter columns and their version gates.
document = File.read(MATRIX_PATH)
start_index = document.index(START_MARKER).as(Int32)
end_index = document.index(END_MARKER).as(Int32)
table = generated_matrix
if ENV["GRANT_WRITE_ADAPTER_MATRIX"]?
  updated = document[0, start_index + START_MARKER.bytesize] + "\n" + table + document[end_index, document.bytesize - end_index]
  File.write(MATRIX_PATH, updated)
else
  current_start = start_index + START_MARKER.bytesize
  current = document[current_start, end_index - current_start].strip
  assert current == table.strip
end

# Exercise the version gates on both sides and cache a real adapter's release.
assert ServerVersion.parse("3.45.1-native").or_panic.to_s == "3.45.1"
assert ServerVersion.parse("17").or_panic.to_s == "17.0.0"
assert ServerVersion.parse("unknown").is_a?(ErrorBase)
assert ServerVersion.new(10, 10).at_least?(10, 2)
pg = Pg.new("g01_version_pg", "postgres://localhost/unused")
pg.database_version = ServerVersion.new(11)
assert !pg.supports_virtual_columns?.or_panic
assert !pg.supports_nulls_not_distinct?.or_panic
pg.database_version = ServerVersion.new(12)
assert pg.supports_virtual_columns?.or_panic
pg.database_version = ServerVersion.new(15)
assert pg.supports_nulls_not_distinct?.or_panic
sqlite = Sqlite.new("g01_version_sqlite", "sqlite3::memory:")
sqlite.database_version = ServerVersion.new(3, 30)
assert !sqlite.supports_virtual_columns?.or_panic
sqlite.database_version = ServerVersion.new(3, 31)
assert sqlite.supports_virtual_columns?.or_panic
assert !sqlite.supports_insert_returning?.or_panic
sqlite.database_version = ServerVersion.new(3, 35)
assert sqlite.supports_insert_returning?.or_panic
assert !sqlite.supports_json?.or_panic
sqlite.database_version = ServerVersion.new(3, 38)
assert sqlite.supports_json?.or_panic
assert !sqlite.supports_concurrent_connections?

register_spec_connections
adapter = Connections[CURRENT_ADAPTER]
adapter.checkout.or_panic
statements = [] of String
subscription = ::Grant::Notifications.subscribe(SQL) do |event|
  statements << event.sql
  nil
end
version = adapter.database_version.or_panic
if CURRENT_ADAPTER == "pg"
  assert version.major == 17
  assert statements.size == 1
  assert statements.first == "SHOW server_version_num"
else
  assert version.at_least?(3)
  assert statements.empty?
end
statement_count = statements.size
assert adapter.database_version.or_panic == version
assert statements.size == statement_count
subscription.unsubscribe
adapter.disconnect_strict.or_panic
