module test/grant_query_query_regressions_test
import grant/base::{Base}
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError}
import std/file::{File}
import std/time::{Time}
import std/uuid::{UUID}
import test/spec_helper::{register_spec_connections}
pub class QueryRegressionParent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_parents

  column id : Int64, primary: true
  column name : String?
  timestamps

  has_many :students, class_name: QueryRegressionStudent

  validate :name, "Name cannot be blank" do |parent|
    !parent.name.to_s.strip.empty?
  end
end

pub class QueryRegressionTeacher < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_teachers

  column id : Int64, primary: true
  column name : String?

  has_many :klasses, class_name: QueryRegressionKlass
end

pub class QueryRegressionStudent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_students

  column id : Int64, primary: true
  column name : String?

  has_many :enrollments, class_name: QueryRegressionEnrollment, foreign_key: student_id
  has_many :klasses, class_name: QueryRegressionKlass, through: :enrollments
end

pub class QueryRegressionKlass < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_klasses

  column id : Int64, primary: true
  column name : String?

  belongs_to teacher : QueryRegressionTeacher
  has_many :enrollments, class_name: QueryRegressionEnrollment, foreign_key: klass_id
  has_many :students, class_name: QueryRegressionStudent, through: :enrollments, source: :student
end

pub class QueryRegressionEnrollment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_enrollments

  column id : Int64, primary: true

  belongs_to student : QueryRegressionStudent, foreign_key: student_id : Int64?
  belongs_to klass : QueryRegressionKlass, foreign_key: klass_id : Int64?
end

pub class QueryRegressionCompany < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_companies

  column id : Int32, primary: true
  column name : String?
end

pub class QueryRegressionItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table query_regression_items

  column item_id : String, primary: true, auto: false
  column item_name : String?

  before_create :generate_uuid

  def generate_uuid : String
    @item_id = UUID.v4.to_s
  end
end


private def prepare_records : Nil
  QueryRegressionEnrollment.clear.or_panic
  QueryRegressionKlass.clear.or_panic
  QueryRegressionStudent.clear.or_panic
  QueryRegressionParent.clear.or_panic
  QueryRegressionCompany.clear.or_panic
  QueryRegressionItem.clear.or_panic
  nil
end

register_spec_connections
QueryRegressionParent.migrator.drop_and_create.or_panic
QueryRegressionStudent.migrator.drop_and_create.or_panic
QueryRegressionTeacher.migrator.drop_and_create.or_panic
QueryRegressionKlass.migrator.drop_and_create.or_panic
QueryRegressionEnrollment.migrator.drop_and_create.or_panic
QueryRegressionCompany.migrator.drop_and_create.or_panic
QueryRegressionItem.migrator.drop_and_create.or_panic


# it: Q-1 rejects injected structured field identifiers
prepare_records
QueryRegressionParent.create_strict(name: "visible").or_panic
QueryRegressionParent.create_strict(name: "hidden").or_panic
error = QueryRegressionParent.where(name: "visible").where("id = -1 OR 1=1 OR id", :eq, -999_i64).select
assert error.is_a?(ArgumentError)

# it: Q-2 keeps none empty for pluck and every bulk write form
prepare_records
record = QueryRegressionParent.create_strict(name: "before").or_panic
relation = QueryRegressionParent.none
assert relation.pluck(:name).or_panic.empty?
assert relation.update_all(name: "after").or_panic == 0
assert relation.update_all({"name" => "after"}).or_panic == 0
assert relation.update_all({:name => "after"}).or_panic == 0
assert relation.update_all([{"name", "after"}] of Tuple(String, Value)).or_panic == 0
assert relation.update_all("name = 'after'").or_panic == 0
assert relation.delete_all.or_panic == 0
assert relation.touch_all(time: Time.utc(2020, 1, 1)).or_panic == 0
assert QueryRegressionParent.find_strict(record.id.as(Int64)).or_panic.name == "before"

# it: Q-3 limits ordered bulk updates and deletes to the selected rows
prepare_records
5.times { |index| QueryRegressionParent.create_strict(name: "before-#{index}").or_panic }
affected = QueryRegressionParent.order(id: :asc).limit(2).update_all(name: "updated").or_panic
assert affected == 2
assert QueryRegressionParent.where(name: "updated").count.or_panic == 2
QueryRegressionParent.clear.or_panic
5.times { |index| QueryRegressionParent.create_strict(name: "delete-#{index}").or_panic }
assert QueryRegressionParent.order(id: :desc).limit(2).delete_all.or_panic == 2
assert QueryRegressionParent.count.or_panic == 3

# it: Q-4 preserves nil members and handles empty IN and NOT IN lists
prepare_records
QueryRegressionStudent.create_strict(name: "visible").or_panic
QueryRegressionStudent.create_strict(name: nil).or_panic
assert QueryRegressionStudent.where(name: ["visible", nil]).order(id: :asc).pluck(:name).or_panic == [["visible"], [nil]]
assert QueryRegressionStudent.where(name: [] of String).select.or_panic.empty?
assert QueryRegressionStudent.where.not_in(:name, [] of String).count.or_panic == 2
assert QueryRegressionStudent.where.not_in(:name, ["visible", nil]).pluck(:name).or_panic.empty?

# it: Q-5 translates inequality with nil into IS NOT NULL
prepare_records
QueryRegressionStudent.create_strict(name: "visible").or_panic
null_student = QueryRegressionStudent.create_strict(name: nil).or_panic
assert QueryRegressionStudent.where(:name, :neq, nil).pluck(:name).or_panic == [["visible"]]
found = QueryRegressionStudent.first("WHERE name IS NULL", [] of Value).or_panic
found_id = found.nil? ? nil : found.id
assert found_id == null_student.id.as(Int64)

# it: Q-6 uses exclusive upper bounds in hash and where-chain ranges
prepare_records
records = Array.new(3) { |index| QueryRegressionParent.create_strict(name: "parent-#{index}").or_panic }
range = records.first.id.as(Int64)...records.last.id.as(Int64)
assert QueryRegressionParent.where(id: range).order(id: :asc).pluck(:id).or_panic == [[records[0].id.as(Int64)], [records[1].id.as(Int64)]]
assert QueryRegressionParent.where.between(:id, range).order(id: :asc).pluck(:id).or_panic == [[records[0].id.as(Int64)], [records[1].id.as(Int64)]]
assert QueryRegressionParent.where(name: "parent-1").and_where(id: range).ids.or_panic == [records[1].id.as(Int64)]

# it: Q-7 groups OR range bounds with AND
prepare_records
records = ["inside", "inside", "inside", "inside", "outside"].map do |name|
  QueryRegressionParent.create_strict(name: name).or_panic
end
result = QueryRegressionParent.where(name: "outside")
  .or_where(id: records[1].id.as(Int64)...records[3].id.as(Int64))
  .order(id: :asc)
  .pluck(:id).or_panic
assert result == [[records[1].id.as(Int64)], [records[2].id.as(Int64)], [records[4].id.as(Int64)]]

# it: Q-8 expands raw bind arrays and checks placeholder counts
prepare_records
records = Array.new(3) { |index| QueryRegressionParent.create_strict(name: "parent-#{index}").or_panic }
lower_id = records.first.id.as(Int64)
upper_id = records.last.id.as(Int64)
assert QueryRegressionParent.where("id >= ? AND id <= ?", [lower_id, upper_id]).order(id: :asc).pluck(:id).or_panic == records.map { |record| [record.id.as(Int64)] }
error = QueryRegressionParent.where("id = ?", [lower_id, upper_id]).select
assert error.is_a?(ArgumentError)

# it: Q-9 documents a valid PostgreSQL numbered placeholder and runs that query
prepare_records
documented_querying = File.read("crystal-upstream/docs/querying.md")
documented_scopes = File.read("crystal-upstream/docs/core-features/querying-and-scopes.md")
assert (documented_querying + documented_scopes).includes?("$1")
assert !(documented_querying + documented_scopes).includes?(" = $\"")
QueryRegressionParent.create_strict(name: "bound").or_panic
assert QueryRegressionParent.where("LOWER(name) = $1", "bound").pluck(:name).or_panic == [["bound"]]

# it: Q-10 carries inner binds through IN, EXISTS, and NOT EXISTS subqueries
prepare_records
matching = QueryRegressionParent.create_strict(name: "inner match").or_panic
QueryRegressionParent.create_strict(name: "other").or_panic
assert QueryRegressionParent.where(id: QueryRegressionParent.where(name: "inner match").select(:id)).ids.or_panic == [matching.id.as(Int64)]
all_ids = [matching.id.as(Int64), matching.id.as(Int64) + 1]
assert QueryRegressionParent.order(id: :asc).where.exists(QueryRegressionParent.where(name: "inner match").select(:id)).ids.or_panic == all_ids
assert QueryRegressionParent.order(id: :asc).where.not_exists(QueryRegressionParent.where(name: "missing").select(:id)).ids.or_panic == all_ids

# it: Q-11 counts distinct rows through a subquery and honors projections
prepare_records
QueryRegressionParent.create_strict(name: "same").or_panic
QueryRegressionParent.create_strict(name: "same").or_panic
QueryRegressionParent.create_strict(name: "other").or_panic
assert QueryRegressionParent.distinct.count.or_panic == 3
assert QueryRegressionParent.distinct.select(:name).count.or_panic == 2

# it: Q-12 returns grouped counts keyed by their group values
prepare_records
first_same = QueryRegressionParent.create_strict(name: "same").or_panic
second_same = QueryRegressionParent.create_strict(name: "same").or_panic
other = QueryRegressionParent.create_strict(name: "other").or_panic
counts = QueryRegressionParent.group_by(:name).count.or_panic.as(Hash(Value, Int64))
assert counts.size == 2 && counts["same"] == 2_i64 && counts["other"] == 1_i64
expected_multi_group_counts = {} of Array(Value) => Int64
expected_multi_group_counts[["same".as(Value), first_same.id.as(Int64).as(Value)]] = 1_i64
expected_multi_group_counts[["same".as(Value), second_same.id.as(Int64).as(Value)]] = 1_i64
expected_multi_group_counts[["other".as(Value), other.id.as(Int64).as(Value)]] = 1_i64
counts = QueryRegressionParent.group_by([:name, :id]).count.or_panic.as(Hash(Array(Value), Int64))
assert counts.size == expected_multi_group_counts.size
expected_multi_group_counts.each { |key, value| assert counts[key] == value }

# it: Q-13 respects relation bounds and order while batching
prepare_records
names = ["zulu", "alpha", "bravo", "charlie", "delta"]
records = names.map { |name| QueryRegressionParent.create_strict(name: name).or_panic }
limited_ids = [] of Int64
QueryRegressionParent.order(id: :asc).limit(2).find_each(batch_size: 1) { |record| limited_ids << record.id.as(Int64) }.or_panic
assert limited_ids == records.first(2).map(&.id.as(Int64))
ordered_ids = [] of Int64
QueryRegressionParent.order(name: :asc).find_each(batch_size: 2) { |record| ordered_ids << record.id.as(Int64) }.or_panic
assert ordered_ids == [1, 2, 3, 4, 0].map { |index| records[index].id.as(Int64) }
offset_ids = [] of Int64
QueryRegressionParent.order(id: :asc).offset(1).find_each(batch_size: 2) { |record| offset_ids << record.id.as(Int64) }.or_panic
assert offset_ids == (1...records.size).map { |index| records[index].id.as(Int64) }
first_company = QueryRegressionCompany.create_strict(name: "one").or_panic
second_company = QueryRegressionCompany.create_strict(name: "two").or_panic
company_ids = [] of Int32
QueryRegressionCompany.find_each(batch_size: 1) { |company| company_ids << company.id.as(Int32) }.or_panic
assert company_ids == [first_company.id.as(Int32), second_company.id.as(Int32)]
first_item = QueryRegressionItem.create_strict(item_name: "one").or_panic
second_item = QueryRegressionItem.create_strict(item_name: "two").or_panic
item_ids = [] of String
QueryRegressionItem.find_each(batch_size: 1) { |item| item_ids << item.item_id.as(String) }.or_panic
assert item_ids == [first_item.item_id.as(String), second_item.item_id.as(String)].sorted

# it: Q-14 qualifies plucked fields when joins contain the same column names
prepare_records
parent = QueryRegressionParent.create_strict(name: "parent").or_panic
QueryRegressionStudent.create_strict(name: "student").or_panic
assert QueryRegressionParent.joins("query_regression_students", on: "query_regression_students.id = query_regression_students.id").pluck(:id).or_panic == [[parent.id.as(Int64)]]

# it: Q-15 resolves both edges of a through association join
prepare_records
student = QueryRegressionStudent.create_strict(name: "student").or_panic
teacher = QueryRegressionTeacher.create_strict(name: "teacher").or_panic
klass = QueryRegressionKlass.create_strict(name: "class", teacher_id: teacher.id).or_panic
QueryRegressionEnrollment.create_strict(student_id: student.id, klass_id: klass.id).or_panic
assert QueryRegressionStudent.joins(:klasses).order(id: :asc).pluck(:id).or_panic == [[student.id.as(Int64)]]
