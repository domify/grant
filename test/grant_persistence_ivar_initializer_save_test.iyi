module test/grant_persistence_ivar_initializer_save_test
import std/process::{Process}
import std/env::{ENV}
import std/file::{File}

# it: saves, and keeps class-level settings, as a generated Amber app does
probe = "build/tmp/grant_ivar_initializer_save_probe"
defer File.delete(probe) if File.exists?(probe)
compiler = ENV["IYI"]? || "/home/priit/contribute/iyi/bin/iyi"
build = Process.run(compiler, ["build", "test/ivar_initializer_save_probe.iyi", "-o", probe]).or_panic
assert build.success?, build.stdout + build.stderr
run = Process.run("./#{probe}").or_panic
assert run.success?, run.stdout + run.stderr
assert run.stdout == "saved=true id=1\nfound=Ruby\nreplica_lag_threshold=00:00:02\nsubclass_default_scope=true\n"
