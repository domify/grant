module test/grant_dirty_dirty_control_test
import test/dirty_family_models::{F01Post}
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER}

# Compare every key and both tuple members: native Hash equality does not
# compare tuple-valued union entries reliably (port/bugs/ris-dirty-hash-equality.md).
def same_changes?(actual : Hash(String, Tuple(A, A)), expected : Hash(String, Tuple(B, C))) : Bool forall A, B, C
  return false unless actual.size == expected.size
  expected.each do |name, pair|
    found = actual[name]?
    return false if found.nil? || found[0] != pair[0] || found[1] != pair[1]
  end
  true
end

pub class F01Tagged < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_taggeds
  column id : Int64, primary: true
  column title : String?
  column tags : Array(String)?
end

if CURRENT_ADAPTER == "pg"
  F01Tagged.migrator.drop_and_create.or_panic
end

# it: restores one attribute with restore_<attr>!
post = F01Post.create_strict(title: "a", views: 1).or_panic
post.title = "b"
post.views = 2

post.restore_title_in_place
assert post.title == "a"
assert !post.title_changed?
assert post.views == 2
assert post.views_changed?

post.title = "c"
post.restore_attribute_in_place("title")
assert post.title == "a"
assert post.changed == ["views"]

# it: clears change information without touching values
post = F01Post.create_strict(title: "a").or_panic
post.update_strict(title: "b").or_panic
post.title = "c"
assert !post.saved_changes.empty?

post.clear_changes_information
assert post.title == "c"
assert !post.changed?
assert post.changes_to_save.empty?
assert post.saved_changes.empty?
assert !post.saved_change_to_title?
assert post.title_in_database == "c"

# The new baseline is tracked from here.
post.title = "d"
assert post.title_was == "c"

# it: applies changes like a save does
post = F01Post.create_strict(title: "a").or_panic
post.title = "b"
post.changes_applied

assert !post.changed?
assert post.title == "b"
assert same_changes?(post.saved_changes, {"title" => {"a", "b"}})
assert post.saved_change_to_title?(from: "a", to: "b")
assert !post.new_record?

post.title = "c"
assert post.title_was == "b"

# it: clears the changes of named attributes and keeps their values
post = F01Post.create_strict(title: "a", views: 1).or_panic
post.title = "b"
post.views = 2
post.clear_attribute_changes(["title"])

assert post.changed == ["views"]
assert post.title == "b"

# it: flags an attribute as changed with attribute_will_change!
record = F01Tagged.new(title: "t", tags: ["a"])
assert !record.changed?

record.tags_will_change_in_place
assert record.changed?
assert record.attribute_changed?("tags")
assert record.tags_change == {["a"], ["a"]}

# An in-place edit after the flag is reflected in the change.
record.tags.as(Array(String)) << "b"
assert record.tags_change == {["a"], ["a", "b"]}
assert same_changes?(record.changes_to_save, {"tags" => {["a"], ["a", "b"]}})
assert record.tags_was == ["a"]

# it: restores a flagged attribute and keeps tracking later edits
record = F01Tagged.new(tags: ["a"])
record.attribute_will_change_in_place(:tags)
record.tags.as(Array(String)) << "b"
record.restore_tags_in_place
assert record.tags == ["a"]
assert !record.changed?

# Array columns are always watched, so a later edit is a new change.
record.tags.as(Array(String)) << "c"
assert record.changed?
assert record.tags_was == ["a"]

# it: records a flagged attribute as a saved change
record = F01Tagged.new(title: "t", tags: ["a"])
record.tags_will_change_in_place
record.tags.as(Array(String)) << "b"
record.changes_applied

assert record.saved_change_to_tags == {["a"], ["a", "b"]}
assert !record.changed?
record.tags.as(Array(String)) << "c"
assert record.tags_was == ["a", "b"]

# it: saves a flagged in-place edit
if CURRENT_ADAPTER == "pg"
  record = F01Tagged.create_strict(title: "t", tags: ["a"]).or_panic
  record.tags_will_change_in_place
  record.tags.as(Array(String)) << "b"
  record.save_strict.or_panic

  assert record.saved_change_to_tags == {["a"], ["a", "b"]}
  assert F01Tagged.find_strict(record.id).or_panic.tags == ["a", "b"]
end

F01Post.adapter.close.or_panic
