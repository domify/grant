module test/grant_perf_w6_primary_key_lookup_clauses_test

import grant/base::{Base}
import grant/error::{ArgumentError}
import grant/query/empty_clauses::{EmptyClauses}
import test/spec_helper::{register_spec_connections}

pub class W6LookupPlain < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_plains
  column id : Int64, primary: true
  column label : String
end

register_spec_connections
W6LookupPlain.migrator.drop_and_create.or_panic

# it: stay empty however relations are built and chained
base = W6LookupPlain.all
chained = base.where(label: "a").order(:id).limit(3).offset(1).group_by(:label).having("COUNT(*) > ?", 0)
chained.where(label: "b").distinct.assembler.select.raw_sql

base.where_in_place(label: "c")
base.order_in_place(:label)
W6LookupPlain.where(label: "x").or_where { |query| query.where(label: "y") }
W6LookupPlain.where(label: "x").merge(W6LookupPlain.order(:id))
W6LookupPlain.where(label: "z").unscope(:where).to_a.or_panic
W6LookupPlain.order(:id).reorder(:label).reverse_order.to_a.or_panic
W6LookupPlain.where(label: "q").pick(:label).or_panic

assert EmptyClauses.untouched?

# it: give a relation its own list on the first write
first = W6LookupPlain.where(label: "one")
second = W6LookupPlain.where(label: "two")

assert first.where_fields.size == 1
assert second.where_fields.size == 1
assert first.where_fields.object_id != second.where_fields.object_id
assert W6LookupPlain.all.where_fields.empty?

# Exercise grouped OR execution and copy isolation with real bound reads.
W6LookupPlain.create_strict(label: "x").or_panic
W6LookupPlain.create_strict(label: "y").or_panic
W6LookupPlain.create_strict(label: "z").or_panic
original = W6LookupPlain.where(label: "x")
combined = original.or_where { |query| query.where(label: "y") }
assert combined.order(:label).pluck(:label).or_panic == [["x"], ["y"]]
assert original.pluck(:label).or_panic == [["x"]]
mutated = original.or_where { |query| query.where_in_place(label: "z"); nil }
assert mutated.order(:label).pluck(:label).or_panic == [["x"], ["z"]]
invalid = original.or_where { |query| query.where(unknown_column: "no") }
assert invalid.select.is_a?(::Grant::Error::ArgumentError)
assert EmptyClauses.untouched?
W6LookupPlain.adapter.close.or_panic
