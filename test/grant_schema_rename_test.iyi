module test/grant_schema_rename_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect}
import grant/schema/column_info::{IndexInfo}
import grant/adapter/driver::{Value}
import grant/schema/introspection
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections

# it: renames a table, its PostgreSQL sequence and key index, and default-named indexes
pg = RecordingStatements.new(Dialect::Pg)
pg.known_indexes["users"] = [IndexInfo.new("users", "index_users_on_email", ["email"]), IndexInfo.new("users", "custom", ["x"])]
assert pg.rename_table_statements(:users, :accounts).or_panic == [
  "ALTER TABLE \"users\" RENAME TO \"accounts\"",
  "ALTER SEQUENCE IF EXISTS \"users_id_seq\" RENAME TO \"accounts_id_seq\"",
  "ALTER INDEX IF EXISTS \"users_pkey\" RENAME TO \"accounts_pkey\"",
  "ALTER INDEX \"index_users_on_email\" RENAME TO \"index_accounts_on_email\""]
assert RecordingStatements.new(Dialect::Mysql).rename_table_statements(:users, :accounts).or_panic == ["RENAME TABLE `users` TO `accounts`"]

# it: renames a column and the indexes that carry its default name
pg = RecordingStatements.new(Dialect::Pg)
pg.known_indexes["users"] = [IndexInfo.new("users", "index_users_on_name", ["name"]), IndexInfo.new("users", "custom", ["name"])]
assert pg.rename_column_statements(:users, :name, :full_name).or_panic == [
  "ALTER TABLE \"users\" RENAME COLUMN \"name\" TO \"full_name\"",
  "ALTER INDEX \"index_users_on_name\" RENAME TO \"index_users_on_full_name\""]

private def scalar(sql : String) : Value
  ::Test::SchemaFixture.adapter.open { |db| db.scalar(sql) }.or_panic
end
private def cleanup : Nil
  AdapterStatements.new(::Test::SchemaFixture.adapter).drop_table(:m02b_rn, :m02b_rn_renamed, if_exists: true).or_panic
end
private def setup : AdapterStatements
  cleanup
  statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
  statements.create_table(:m02b_rn) do |t|
    t.string(:name).or_panic
    t.string(:city).or_panic
    t.index(:name).or_panic
    t.index([:name, :city]).or_panic
    t.index(:city, name: "m02b_custom_city")
  end.or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_rn (name, city) VALUES ('n', 'c')").or_panic
  statements
end
schema = ::Test::SchemaFixture.adapter.schema

# it: renames a table and keeps its rows, key and default-named indexes
statements = setup
statements.rename_table(:m02b_rn, :m02b_rn_renamed).or_panic
assert !schema.table_exists?(:m02b_rn).or_panic
assert schema.table_exists?(:m02b_rn_renamed).or_panic
assert scalar("SELECT name FROM m02b_rn_renamed") == "n"
names = schema.indexes(:m02b_rn_renamed).or_panic.map { |index| index.name }.sorted
assert names == ["index_m02b_rn_renamed_on_name", "index_m02b_rn_renamed_on_name_and_city", "m02b_custom_city"]
cleanup

# it: renames the PostgreSQL key sequence and index so inserts still work
statements = setup
statements.rename_table(:m02b_rn, :m02b_rn_renamed).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_rn_renamed (name) VALUES ('second')").or_panic
assert scalar("SELECT id FROM m02b_rn_renamed WHERE name = 'second'") == 2
if CURRENT_ADAPTER == "pg"
  assert scalar("SELECT COUNT(*) FROM pg_class WHERE relname = 'm02b_rn_renamed_id_seq'") == 1
  assert scalar("SELECT COUNT(*) FROM pg_class WHERE relname = 'm02b_rn_renamed_pkey'") == 1
  assert scalar("SELECT COUNT(*) FROM pg_class WHERE relname IN ('m02b_rn_id_seq', 'm02b_rn_pkey')") == 0
end
cleanup

# it: renames a column and the indexes named after it
statements = setup
statements.rename_column(:m02b_rn, :name, :full_name).or_panic
assert schema.columns(:m02b_rn).or_panic.map { |info| info.name } == ["id", "full_name", "city"]
assert scalar("SELECT full_name FROM m02b_rn") == "n"
assert schema.indexes(:m02b_rn).or_panic.map { |index| index.name }.sorted == ["index_m02b_rn_on_full_name", "index_m02b_rn_on_full_name_and_city", "m02b_custom_city"]
assert schema.indexes(:m02b_rn).or_panic.find { |index| index.name == "index_m02b_rn_on_full_name_and_city" }.as(IndexInfo).columns == ["full_name", "city"]
cleanup

# it: renames a column inside change_table
statements = setup
statements.change_table(:m02b_rn) { |t| t.rename(:city, :town) }.or_panic
assert schema.columns(:m02b_rn).or_panic.map { |info| info.name } == ["id", "name", "town"]
cleanup

# it: renames an index
statements = setup
statements.rename_index(:m02b_rn, "m02b_custom_city", "m02b_other").or_panic
assert schema.index_exists?(:m02b_rn, name: "m02b_other").or_panic
assert !schema.index_exists?(:m02b_rn, name: "m02b_custom_city").or_panic
cleanup
