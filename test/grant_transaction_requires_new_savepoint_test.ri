module test/grant_transaction_requires_new_savepoint_test
import std/enumerable
import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/driver::{Connection}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{current_connection?}
import test/transaction_sql_recorder::{record, begins}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

# Separate connections share the SQLite database, as in the upstream pool.
register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: opens a SAVEPOINT on the pinned connection instead of a second transaction
Parent.clear.or_panic
statements = record do
  Parent.transaction do
    Parent.transaction(requires_new: true) do
      Parent.create_strict(name: "Inner").or_panic
    end.or_panic
  end.or_panic
end
assert begins(statements).size == 1
assert statements.includes?("SAVEPOINT sp_1")
assert statements.includes?("RELEASE SAVEPOINT sp_1")
assert statements.count { |sql| sql == "COMMIT" } == 1
assert Parent.count.or_panic == 1

# it: rolls the released savepoint back with the outer transaction
Parent.clear.or_panic
error = Parent.transaction do
  Parent.transaction(requires_new: true) { Parent.create_strict(name: "Inner").or_panic }.or_panic
  Parent.create_strict(name: "Outer").or_panic
  ErrorBase.new("outer failure")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer failure"
assert Parent.count.or_panic == 0

# it: rolls back only the savepoint on Rollback and lets the outer transaction commit
Parent.clear.or_panic
result = Parent.transaction do
  Parent.create_strict(name: "Kept").or_panic
  Parent.transaction(requires_new: true) do
    Parent.create_strict(name: "Discarded").or_panic
    Rollback.new
  end.or_panic
  :done
end.or_panic
assert result == :done
assert Parent.all.select.or_panic.map { |parent| parent.name } == ["Kept"]

# it: names savepoints from a per-transaction counter
statements = record do
  Parent.transaction do
    Parent.transaction(requires_new: true) { nil }.or_panic
    Parent.transaction(requires_new: true) { nil }.or_panic
  end.or_panic
end
assert statements.select { |sql| sql.starts_with?("SAVEPOINT") } == ["SAVEPOINT sp_1", "SAVEPOINT sp_2"]

# it: begins a real transaction when none is open
statements = record do
  Parent.transaction(requires_new: true) { nil }.or_panic
end
assert begins(statements).size == 1
assert statements.none? { |sql| sql.starts_with?("SAVEPOINT") }

# it: keeps the separate-connection mode: the inner transaction commits on its own
Parent.clear.or_panic
error = Parent.transaction do
  outer_connection = current_connection?(Parent.transaction_adapter)
  Parent.transaction(independent: true) do
    inner_connection = current_connection?(Parent.transaction_adapter)
    assert !inner_connection.nil?
    assert !outer_connection.nil?
    assert inner_connection.as(Connection).object_id != outer_connection.as(Connection).object_id
    Parent.create_strict(name: "Inner").or_panic
  end.or_panic
  ErrorBase.new("outer failure")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer failure"
assert Parent.all.select.or_panic.map { |parent| parent.name } == ["Inner"]

# it: issues its own BEGIN
statements = record do
  Parent.transaction do
    Parent.transaction(independent: true) { nil }.or_panic
  end.or_panic
end
assert begins(statements).size == 2
Parent.adapter.close.or_panic
