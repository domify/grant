module test/grant_connection_connects_to_hash_test
import grant/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/connection_handling::{ConnectionHandling, UnestablishedConnectionError}
import grant/adapter/sqlite::{Sqlite}
import std/file
import std/env::{ENV}

pub class C01HashModel < Base
  table c01_hash_models
  column id : Int64, primary: true
  connects_to database: {writing: "c01_hash_primary", reading: "c01_hash_replica"}
end
pub class C01ShardsModel < Base
  table c01_shards_models
  column id : Int64, primary: true
  connects_to(database: "c01_shard_main", shards: {
    default: {writing: "c01_shard_a", reading: "c01_shard_a_replica"},
    shard_two: {writing: "c01_shard_b", reading: "c01_shard_b_replica"},
  })
end
pub class C01LegacyConfigModel < Base
  table c01_legacy_config_models
  column id : Int64, primary: true
  connects_to database: "c01_legacy", config: {writing: "c01_legacy_w", reading: "c01_legacy_r"}
end
pub class C01PlainModel < Base
  table c01_plain_models
  column id : Int64, primary: true
end

# it: takes the role hash as the database argument
expected_roles = {:writing => "c01_hash_primary", :reading => "c01_hash_replica"}
assert C01HashModel.connection_config.to_s == expected_roles.to_s
assert C01HashModel.default_database_name == "c01_hash_primary"
assert C01HashModel.database_name == "c01_hash_primary"

# it: keeps the separate config: argument working
assert C01LegacyConfigModel.default_database_name == "c01_legacy"
assert C01LegacyConfigModel.connection_config[:reading] == "c01_legacy_r"

# it: takes shards as a NamedTuple and reports them
assert C01ShardsModel.shard_keys == [:default, :shard_two]
assert C01ShardsModel.default_shard == :default
assert C01ShardsModel.sharded?
assert C01ShardsModel.shard_config[:shard_two][:reading] == "c01_shard_b_replica"
assert C01PlainModel.shard_keys.empty?
assert C01PlainModel.default_shard == :default
assert !C01PlainModel.sharded?

# it: lists every connection name a model declares
assert C01HashModel.connection_names == [
  {"c01_hash_primary", :writing, nil}, {"c01_hash_replica", :reading, nil},
]
assert C01ShardsModel.connection_names.includes?({"c01_shard_b_replica", :reading, :shard_two})
assert C01PlainModel.connection_names == [{"primary", :writing, nil}]

# it: raises naming each connection that is not established
error = C01HashModel.verify_connections_strict
assert error.is_a?(UnestablishedConnectionError)
assert error.as(UnestablishedConnectionError).message.includes?("c01_hash_primary (role: writing)")
assert error.as(UnestablishedConnectionError).message.includes?("c01_hash_replica (role: reading)")
assert error.as(UnestablishedConnectionError).message.includes?(C01HashModel.to_s)
error = C01ShardsModel.verify_connections_strict
assert error.is_a?(UnestablishedConnectionError)
assert error.as(UnestablishedConnectionError).message.includes?("shard: shard_two")

# it: passes once the connections are established
path = "#{ENV["TMPDIR"]? || "/tmp"}/c01_hash_native.sqlite3"
ConnectionRegistry.establish_connection(database: "c01_hash_primary", adapter: Sqlite,
  url: "sqlite3:#{path}", role: :writing).or_panic
ConnectionRegistry.establish_connection(database: "c01_hash_replica", adapter: Sqlite,
  url: "sqlite3:#{path}", role: :reading).or_panic
C01HashModel.verify_connections_strict.or_panic
ConnectionRegistry.remove_connection("c01_hash_primary", :writing).or_panic
ConnectionRegistry.remove_connection("c01_hash_replica", :reading).or_panic
File.delete(path) if File.exists?(path)

# it: accepts a reading connection served by the same name's writer
path = "#{ENV["TMPDIR"]? || "/tmp"}/c01_legacy_native.sqlite3"
["c01_legacy_w", "c01_legacy_r", "c01_legacy"].each do |name|
  ConnectionRegistry.establish_connection(database: name, adapter: Sqlite, url: "sqlite3:#{path}").or_panic
end
C01LegacyConfigModel.verify_connections_strict.or_panic
["c01_legacy_w", "c01_legacy_r", "c01_legacy"].each do |name|
  ConnectionRegistry.remove_connection(name, :primary).or_panic
end
File.delete(path) if File.exists?(path)

# it: verifies every declaring model through Grant::ConnectionHandling
assert ConnectionHandling.declared_models.includes?(C01ShardsModel.to_s)
error = ConnectionHandling.verify_all_strict
assert error.is_a?(UnestablishedConnectionError)
assert error.as(UnestablishedConnectionError).message.includes?(C01ShardsModel.to_s)
