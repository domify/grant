module test/grant_query_extract_associated_test

import grant/base::{Base}
import grant/query/extract_associated
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}
import test/query_relation_sql_capture::{capture_sql}

pub class ::EaAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ea_authors
  column id : Int64, primary: true
  column name : String
  has_many :articles, class_name: ::EaArticle, foreign_key: :ea_author_id
end

pub class ::EaArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ea_articles
  column id : Int64, primary: true
  column title : String
  column published : Bool = false
  column ea_author_id : Int64?
  belongs_to :ea_author, class_name: ::EaAuthor, foreign_key: :ea_author_id, optional: true
end

private def prepare_records : Nil
  EaArticle.clear.or_panic
  EaAuthor.clear.or_panic
  ada = EaAuthor.create_strict(name: "Ada").or_panic
  grace = EaAuthor.create_strict(name: "Grace").or_panic
  EaAuthor.create_strict(name: "Unpublished").or_panic
  EaArticle.create_strict(title: "A1", published: true, ea_author_id: ada.id).or_panic
  EaArticle.create_strict(title: "A2", published: true, ea_author_id: ada.id).or_panic
  EaArticle.create_strict(title: "G1", published: true, ea_author_id: grace.id).or_panic
  EaArticle.create_strict(title: "Draft", published: false, ea_author_id: grace.id).or_panic
  EaArticle.create_strict(title: "Orphan", published: true).or_panic
  nil
end

register_spec_connections
EaAuthor.migrator.drop_and_create.or_panic
EaArticle.migrator.drop_and_create.or_panic

# it: returns the belongs_to targets, unique by primary key
prepare_records
authors = EaArticle.where(published: true).order(:id).extract_associated(:ea_author).or_panic
assert authors.map { |author| author.as(EaAuthor).name } == ["Ada", "Grace"]

# it: returns has_many members flattened
prepare_records
articles = EaAuthor.order(:id).extract_associated(:articles).or_panic
assert articles.map { |article| article.as(EaArticle).title } == ["A1", "A2", "G1", "Draft"]

# it: respects the relation's conditions
prepare_records
assert EaArticle.where(title: "G1").extract_associated(:ea_author).or_panic.map { |author| author.as(EaAuthor).name } == ["Grace"]
assert EaArticle.where(title: "nothing").extract_associated(:ea_author).or_panic.empty?

# it: preloads instead of querying per record
prepare_records
statements = capture_sql { EaAuthor.order(:id).extract_associated(:articles).or_panic }
assert statements.size == 2

# it: skips records without the association
prepare_records
assert EaArticle.where(title: "Orphan").extract_associated(:ea_author).or_panic.empty?

# it: returns a typed array with as:
prepare_records
authors = EaArticle.where(published: true).order(:id).extract_associated(:ea_author, as: EaAuthor).or_panic
assert typeof(authors).to_s == Array(EaAuthor).to_s
assert authors.map(&.name) == ["Ada", "Grace"]
assert EaAuthor.order(:id).extract_associated(:articles, as: EaArticle).or_panic.map(&.title) == ["A1", "A2", "G1", "Draft"]
error = EaArticle.extract_associated(:ea_author, as: EaArticle)
assert error.is_a?(ArgumentError)
assert error.message.includes?("not EaArticle") if error.is_a?(ArgumentError)

# it: is available on the model class
prepare_records
assert EaArticle.extract_associated(:ea_author).or_panic.size == 2
