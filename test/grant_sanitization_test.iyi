module test/grant_sanitization_test
import grant/sanitization
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}
import grant/base::{Base}
import std/env
import grant/adapter/sqlite::{Sqlite}
import std/time::{Time}
import std/slice::{Bytes}

pub class Chat < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table chats
  column id : Int64, primary: true
  column name : String
end

register_spec_connections
adapter = Chat.adapter

# it: quotes nil as NULL
assert Grant::Sanitization.quote(nil).or_panic == "NULL"
# it: quotes integers without quoting
assert Grant::Sanitization.quote(42).or_panic == "42"
assert Grant::Sanitization.quote(-7_i64).or_panic == "-7"
# it: quotes floats without quoting
assert Grant::Sanitization.quote(3.5).or_panic == "3.5"
# it: quotes strings with surrounding single quotes
assert Grant::Sanitization.quote("hello").or_panic == "'hello'"
# it: escapes embedded single quotes by doubling them
assert Grant::Sanitization.quote("O'Brien").or_panic == "'O''Brien'"
# it: strips embedded NUL bytes from strings
assert Grant::Sanitization.quote("a\0b").or_panic == "'ab'"
# it: quotes booleans portably without an adapter (1/0)
assert Grant::Sanitization.quote(true).or_panic == "1"
assert Grant::Sanitization.quote(false).or_panic == "0"
# it: quotes booleans per the adapter when one is given
expected_true = adapter.quote_boolean(true)
expected_false = adapter.quote_boolean(false)
assert Grant::Sanitization.quote(true, adapter).or_panic == expected_true
assert Grant::Sanitization.quote(false, adapter).or_panic == expected_false
# it: quotes Time as a single-quoted UTC timestamp
t = Time.utc(2024, 1, 2, 3, 4, 5)
assert Grant::Sanitization.quote(t).or_panic == "'2024-01-02 03:04:05'"
# it: quotes bytes as a hex blob literal
bytes = Bytes.new(2) { |i| i == 0 ? 0xde_u8 : 0xad_u8 }
assert Grant::Sanitization.quote(bytes).or_panic == "x'dead'"
# it: raises for an unquotable type
error = Grant::Sanitization.quote([1, 2, 3])
assert error.is_a?(ArgumentError)
if error.is_a?(ArgumentError)
  assert error.message.includes?("cannot quote")
end
# it: double-quotes identifiers without an adapter
assert Grant::Sanitization.quote_identifier("users") == "\"users\""
# it: escapes embedded double quotes without an adapter
assert Grant::Sanitization.quote_identifier("we\"ird") == "\"we\"\"ird\""
# it: delegates to the adapter when one is given
assert Grant::Sanitization.quote_identifier("users", adapter) == adapter.quote("users")
# it: neutralizes an identifier-based injection attempt
quote_character = CURRENT_ADAPTER == "mysql" ? '`' : '"'
malicious = "id#{quote_character}; DROP TABLE users; --"
quoted = Grant::Sanitization.quote_identifier(malicious, adapter)
assert quoted == adapter.quote(malicious)
assert quoted.includes?("#{quote_character}#{quote_character}")
# it: substitutes a single placeholder
assert Grant::Sanitization.sanitize_sql_array(["age > ?", 18]).or_panic == "age > 18"
# it: substitutes multiple placeholders in order
result = Grant::Sanitization.sanitize_sql_array(["name = ? AND age > ?", "Alice", 30]).or_panic
assert result == "name = 'Alice' AND age > 30"
# it: quotes string values, escaping embedded quotes
result = Grant::Sanitization.sanitize_sql_array(["name = ?", "O'Brien"]).or_panic
assert result == "name = 'O''Brien'"
# it: accepts a splat form
assert Grant::Sanitization.sanitize_sql_array("id = ?", 5).or_panic == "id = 5"
# it: returns the SQL unchanged when there are no placeholders
assert Grant::Sanitization.sanitize_sql_array(["1 = 1"]).or_panic == "1 = 1"
# it: does not treat a ? inside a single-quoted literal as a placeholder
result = Grant::Sanitization.sanitize_sql_array(["note = 'is it? maybe' AND id = ?", 7]).or_panic
assert result == "note = 'is it? maybe' AND id = 7"
# it: raises when there are more placeholders than values
error = Grant::Sanitization.sanitize_sql_array(["a = ? AND b = ?", 1])
assert error.is_a?(Grant::Sanitization::WrongNumberOfArguments)
if error.is_a?(Grant::Sanitization::WrongNumberOfArguments)
  assert error.message.includes?("wrong number of bind variables")
end
# it: raises when there are more values than placeholders
assert Grant::Sanitization.sanitize_sql_array(["a = ?", 1, 2]).is_a?(Grant::Sanitization::WrongNumberOfArguments)
# it: raises on an empty array
assert Grant::Sanitization.sanitize_sql_array([] of String).is_a?(ArgumentError)
# it: neutralizes a classic DROP TABLE injection in a string value
payload = "'; DROP TABLE users; --"
result = Grant::Sanitization.sanitize_sql_array(["name = ?", payload]).or_panic
assert result == "name = '''; DROP TABLE users; --'"
assert result != "name = ''; DROP TABLE users; --"
# it: neutralizes injection and is safe to execute against a real database
# Upstream explicitly owns an isolated SQLite database for this example.
db_adapter = Sqlite.new("sanitization_victims", "sqlite3::memory:")
db_adapter.with_connection do |db|
  db.exec("CREATE TABLE victims (id INTEGER PRIMARY KEY, name TEXT)").or_panic
  db.exec("INSERT INTO victims (name) VALUES ('safe-row')").or_panic
  payload = "'; DROP TABLE victims; --"
  fragment = Grant::Sanitization.sanitize_sql_array(["name = ?", payload]).or_panic
  matches = db.query("SELECT name FROM victims WHERE #{fragment}").or_panic
  assert matches.empty?
  assert db.scalar("SELECT COUNT(*) FROM victims").or_panic == 1_i64
  assert db.scalar("SELECT name FROM victims").or_panic == "safe-row"
end.or_panic
db_adapter.close.or_panic
adapter.close.or_panic
