module test/grant_persistence_equality_test
import grant/base
import test/spec_helper
import std/set

pub class EqualityPerson < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table equality_people
  column id : Int64, primary: true
  column name : String?
end

pub class EqualityPet < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table equality_pets
  column id : Int64, primary: true
  column name : String?
end

SpecHelper.register_spec_connections
EqualityPerson.migrator.drop_and_create.or_panic
EqualityPet.migrator.drop_and_create.or_panic

# it: treats two instances loaded from the same row as equal
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(name: "Ada").or_panic
first = EqualityPerson.find_strict(person.id).or_panic
second = EqualityPerson.find_strict(person.id).or_panic
assert first.object_id != second.object_id
assert first == second
assert first == person
assert first.hash == second.hash

# it: treats different rows as unequal
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
ada = EqualityPerson.create_strict(name: "Ada").or_panic
grace = EqualityPerson.create_strict(name: "Grace").or_panic
assert !(ada == grace)
assert ada != grace

# it: keeps new records unequal to each other but equal to themselves
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
first = EqualityPerson.new(name: "Ada")
second = EqualityPerson.new(name: "Ada")
assert !(first == second)
assert first == first
assert first.hash != second.hash

# it: does not equate a new record with a saved one
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
saved = EqualityPerson.create_strict(name: "Ada").or_panic
fresh = EqualityPerson.new(name: "Ada")
assert !(fresh == saved)
assert !(saved == fresh)

# it: does not equate different classes that share a primary key value
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(id: 4242_i64, name: "Ada").or_panic
pet = EqualityPet.create_strict(id: 4242_i64, name: "Ada").or_panic
assert person.id == pet.id
assert !(person == pet)

# it: does not equate a record with a non-record
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(name: "Ada").or_panic
assert !(person == "Ada")
assert !(person == nil)

# it: collapses duplicates in a Set
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(name: "Ada").or_panic
records = Set(EqualityPerson).new
records << EqualityPerson.find_strict(person.id).or_panic
records << EqualityPerson.find_strict(person.id).or_panic
records << EqualityPerson.new(name: "x")
records << EqualityPerson.new(name: "x")
assert records.size == 3

# it: works with uniq, includes? and Hash keys
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(name: "Ada").or_panic
grace = EqualityPerson.create_strict(name: "Grace").or_panic
loaded = [EqualityPerson.find_strict(person.id).or_panic, EqualityPerson.find_strict(person.id).or_panic, EqualityPerson.find_strict(grace.id).or_panic]
assert loaded.uniq.size == 2
assert loaded.includes?(person)
# Native Array has no subtraction; reject the right-hand members.
assert loaded.reject { |record| [person].includes?(record) }.size == 1
counts = {} of EqualityPerson => Int32
loaded.each { |record| counts[record] = (counts[record]? || 0) + 1 }
assert counts[person] == 2
assert counts[grace] == 1

# it: changes hash once a new record is saved, like ActiveRecord
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.new(name: "Ada")
before = person.hash
person.save_strict.or_panic
assert person.hash != before
assert person.hash == EqualityPerson.find_strict(person.id).or_panic.hash

# it: ignores unsaved attribute changes
EqualityPerson.clear.or_panic
EqualityPet.clear.or_panic
person = EqualityPerson.create_strict(name: "Ada").or_panic
edited = EqualityPerson.find_strict(person.id).or_panic
edited.name = "Changed"
assert edited == person

EqualityPerson.migrator.drop.or_panic
EqualityPet.migrator.drop.or_panic
