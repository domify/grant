module test/grant_query_joins_integration_test

import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

register_spec_connections



# it: generates INNER JOIN SQL
sql = Parent.where(name: "test")
  .joins("students", on: "students.parent_id = parents.id")
  .raw_sql
assert sql.includes?("INNER JOIN students ON students.parent_id = parents.id")
assert sql.includes?("WHERE")


# it: generates LEFT JOIN SQL
sql = Parent.where(name: "test")
  .left_joins("students", on: "students.parent_id = parents.id")
  .raw_sql
assert sql.includes?("LEFT JOIN students ON students.parent_id = parents.id")


# it: supports multiple joins in SQL
sql = Parent
  .joins("students", on: "students.parent_id = parents.id")
  .joins("enrollments", on: "enrollments.student_id = students.id")
  .raw_sql
assert sql.includes?("INNER JOIN students ON students.parent_id = parents.id")
assert sql.includes?("INNER JOIN enrollments ON enrollments.student_id = students.id")


# it: works with order, limit, and group_by
sql = Parent
  .joins("students", on: "students.parent_id = parents.id")
  .order(name: :asc)
  .limit(10)
  .group_by(:name)
  .raw_sql
assert sql.includes?("INNER JOIN")
assert sql.includes?("ORDER BY")
assert sql.includes?("LIMIT 10")
assert sql.includes?("GROUP BY #{Parent.quote("parents.name")}")


# it: generates SELECT DISTINCT
sql = Parent.distinct.raw_sql
assert sql.includes?("SELECT DISTINCT")


# it: does not add DISTINCT by default
sql = Parent.where(name: "test").raw_sql
assert !sql.includes?("DISTINCT")


# it: works with where and order
sql = Parent.distinct.where(name: "test").order(name: :asc).raw_sql
assert sql.includes?("SELECT DISTINCT")
assert sql.includes?("WHERE")
assert sql.includes?("ORDER BY")


# it: generates HAVING with group_by
sql = Parent
  .group_by(:name)
  .having("COUNT(*) > ?", 5)
  .raw_sql
assert sql.includes?("GROUP BY name")
assert sql.includes?("HAVING")


# it: generates HAVING without value parameter
sql = Parent
  .group_by(:name)
  .having("COUNT(*) > 0")
  .raw_sql
assert sql.includes?("HAVING COUNT(*) > 0")


# it: chains multiple having clauses with AND
sql = Parent
  .group_by(:name)
  .having("COUNT(*) > ?", 5)
  .having("COUNT(*) < ?", 100)
  .raw_sql
assert sql.includes?("HAVING")
assert sql.includes?("AND")


# it: works with joins and group_by
sql = Parent
  .joins("students", on: "students.parent_id = parents.id")
  .group_by(:name)
  .having("COUNT(*) > ?", 3)
  .raw_sql
assert sql.includes?("INNER JOIN")
assert sql.includes?("GROUP BY #{Parent.quote("parents.name")}")
assert sql.includes?("HAVING")


# it: returns empty results
assert Parent.none.select.or_panic.empty?


# it: any? returns false
assert !Parent.none.any?.or_panic


# it: exists? returns false
assert !Parent.none.exists?.or_panic


# it: chains with other methods safely
assert Parent.none.where(name: "test").order(name: :asc).select.or_panic.empty?


# it: replaces existing order
sql = Parent.order(name: :asc).reorder(name: :desc).raw_sql
assert sql.includes?("ORDER BY name DESC")
assert !sql.includes?("ORDER BY name ASC")


# it: flips order direction
sql = Parent.order(name: :asc).reverse_order.raw_sql
assert sql.includes?("ORDER BY name DESC")


# it: replaces existing conditions
# First build a query with two where clauses, then rewhere replaces all
q = Parent.where(name: "bob").where(name: "charlie")
assert q.where_fields.size == 2

# rewhere clears and replaces
q2 = Parent.where(name: "bob").rewhere(name: "alice")
assert q2.where_fields.size == 1
