module test/grant_connection_w6_statement_invalid_sql_query_reads_test
import grant
import grant/base::{Base}
import test/w6_c04_support::{W6C04}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

pub class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

pub class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

W6C04.provision("w6_sql", ["CREATE TABLE w6_sql_things (#{W6C04.id_column}, label TEXT, amount BIGINT)"])
W6C04.establish("w6_sql", "w6_sql", :primary)
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
W6C04.exec("w6_sql", "INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)")
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of select, first, last and find_by
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").select }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").first }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").last }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").find_by(label: "a") }

# it: redacts bound values unless capturing is enabled, and bounds them when it is
error = w6_failure("missing_col") { W6SqlThing.where("missing_col = ?", "secret-value").select }
assert error.binds == ["[FILTERED]"]
assert !error.to_s.includes?("secret-value")

Grant.settings.capture_statement_bind_values = true
long = "x" * 500
captured = w6_failure("missing_col") { W6SqlThing.where("missing_col = ?", long).select }
assert captured.binds.size == 1
assert captured.binds.first.size <= StatementInvalid::MAX_BIND_LENGTH + 3
Grant.settings.capture_statement_bind_values = false

# it: keeps no more binds than the cap
values = (1..60).map { |n| n.to_i64.as(::Grant::Adapter::Driver::Value) }
error = w6_failure("missing_col") { W6SqlThing.where("missing_col IN (#{values.map { "?" }.join(", ")})", values).select }
assert error.binds.size <= StatementInvalid::MAX_BINDS

# it: is a Grant::ErrorBase carrying the driver's error as its cause
error = w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").select }
assert error.is_a?(::Grant::Error::ErrorBase)
assert !error.message.to_s.empty?

# Native success checks verify lazy reads, ordering, binds and independent copies.
relation = W6SqlThing.where("amount = ?", 1_i64)
assert relation.select.or_panic.first.label == "a"
assert relation.first.or_panic.as(W6SqlThing).label == "a"
assert relation.last.or_panic.as(W6SqlThing).label == "a"
assert relation.find_by(label: "a").or_panic.as(W6SqlThing).amount == 1_i64
assert relation.where("amount = ?", 2_i64).select.or_panic.empty?
assert relation.select.or_panic.size == 1
assert W6SqlThing.where("amount = ?", 2_i64).first.or_panic.nil?

W6C04.remove("w6_sql", :primary)
W6C04.cleanup
