module test/grant_persistence_no_touching_test
import grant/base::{Base}
import grant/sti
import grant/error::{ErrorBase}
import std/time::{Time}
import test/write_sql_capture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class QuietVehicle < Base
  ::Grant::Sti.enable
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table quiet_vehicles
  column id : Int64, primary: true
  column type : String
  column name : String?
  timestamps
end

pub class QuietCar < QuietVehicle
end

pub class QuietNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table quiet_notes
  column id : Int64, primary: true
  column name : String?
  timestamps
end

register_spec_connections
QuietVehicle.exec("DROP TABLE IF EXISTS quiet_vehicles").or_panic
if CURRENT_ADAPTER == "pg"
  QuietVehicle.exec("CREATE TABLE quiet_vehicles (id BIGSERIAL PRIMARY KEY, type TEXT NOT NULL, name TEXT, created_at TIMESTAMP, updated_at TIMESTAMP)").or_panic
else
  QuietVehicle.exec("CREATE TABLE quiet_vehicles (id INTEGER PRIMARY KEY AUTOINCREMENT, type VARCHAR(255) NOT NULL, name VARCHAR(255), created_at TEXT, updated_at TEXT)").or_panic
end
QuietNote.migrator.drop_and_create.or_panic
STALE = Time.utc(2020, 1, 2, 3, 4, 5)

def stored_stamp(note : QuietNote) : Time
  QuietNote.find_strict(note.id).or_panic.updated_at.as(Time)
end

def reset_records : Nil
  QuietNote.clear.or_panic
  QuietVehicle.clear.or_panic
  nil
end

# it: turns touch into a no-op inside the block
reset_records
note = QuietNote.create_strict(name: "n").or_panic
note.touch(time: STALE).or_panic
statements = WriteSqlCapture.statements(QuietNote.adapter) do
  QuietNote.no_touching { assert note.touch.or_panic }
end
assert statements.empty?
assert stored_stamp(note) == STALE

# it: touches again after the block
reset_records
note = QuietNote.create_strict(name: "n").or_panic
note.touch(time: STALE).or_panic
QuietNote.no_touching { note.touch.or_panic }
note.touch.or_panic
assert stored_stamp(note) > STALE

# it: returns the block value and reports the state
reset_records
assert !QuietNote.no_touching?
value = QuietNote.no_touching { assert QuietNote.no_touching?; 42 }
assert value == 42
assert !QuietNote.no_touching?

# it: still stamps updated_at on a normal save
reset_records
note = QuietNote.create_strict(name: "n").or_panic
note.touch(time: STALE).or_panic
QuietNote.no_touching { note.update_strict(name: "changed").or_panic }
assert stored_stamp(note) > STALE

# it: only affects the named model
reset_records
note = QuietNote.create_strict(name: "n").or_panic
vehicle = QuietVehicle.create_strict(name: "v", type: QuietVehicle.to_s).or_panic
vehicle.touch(time: STALE).or_panic
QuietNote.no_touching { vehicle.touch.or_panic }
assert QuietVehicle.find_strict(vehicle.id).or_panic.updated_at.as(Time) > STALE

# it: covers subclasses when set on the parent
reset_records
car = QuietCar.create_strict(name: "c").or_panic
car.touch(time: STALE).or_panic
QuietVehicle.no_touching do
  assert car.no_touching?
  car.touch.or_panic
end
assert QuietVehicle.find_strict(car.id).or_panic.updated_at.as(Time) == STALE

# it: nests and unwinds even when the block raises
reset_records
QuietNote.no_touching do
  QuietNote.no_touching { nil }
  assert QuietNote.no_touching?
end
assert !QuietNote.no_touching?
error = QuietNote.no_touching { ErrorBase.new("boom") }
assert error.is_a?(ErrorBase)
assert error.message == "boom"
assert !QuietNote.no_touching?

# it: is fiber-local
reset_records
note = QuietNote.create_strict(name: "n").or_panic
note.touch(time: STALE).or_panic
group do |tasks|
  other_fiber_sees = Channel(Bool).new
  QuietNote.no_touching do
    tasks.spawn { other_fiber_sees.send(QuietNote.no_touching?).or_panic }
    assert !other_fiber_sees.receive.or_panic
    assert QuietNote.no_touching?
  end

  entered = Channel(Nil).new
  release = Channel(Nil).new
  done = Channel(Nil).new
  tasks.spawn do
    QuietNote.no_touching do
      entered.send(nil).or_panic
      release.receive.or_panic
    end
    done.send(nil).or_panic
  end
  entered.receive.or_panic
  assert !QuietNote.no_touching?
  release.send(nil).or_panic
  done.receive.or_panic
end

# it: turns save and create into successful no-ops inside the block
reset_records
statements = WriteSqlCapture.statements(QuietNote.adapter) do
  QuietNote.suppress do
    record = QuietNote.create_strict(name: "ghost").or_panic
    assert record.new_record?
    assert record.save
    assert QuietNote.suppressed?
  end
end
assert statements.empty?
assert QuietNote.count.or_panic == 0
assert !QuietNote.suppressed?

# it: does not write updates inside the block but does afterwards
reset_records
note = QuietNote.create_strict(name: "n").or_panic
QuietNote.suppress { note.update_strict(name: "hidden").or_panic }
assert QuietNote.find_strict(note.id).or_panic.name == "n"
note.save_strict.or_panic
assert QuietNote.find_strict(note.id).or_panic.name == "hidden"

# it: leaves other models alone
reset_records
QuietNote.suppress { QuietVehicle.create_strict(name: "v", type: QuietVehicle.to_s).or_panic }
assert QuietVehicle.count.or_panic == 1

# it: is fiber-local
reset_records
group do |tasks|
  seen = Channel(Bool).new
  QuietNote.suppress do
    tasks.spawn { seen.send(QuietNote.suppressed?).or_panic }
    assert !seen.receive.or_panic
  end
end

# A returned error must also unwind suppression and release the scheduler slot.
assert QuietNote.suppress { ErrorBase.new("halt") }.message == "halt"
assert !QuietNote.suppressed?
assert ::Grant::Timestamps::BlockScopes.current?.nil?
QuietNote.adapter.close.or_panic
