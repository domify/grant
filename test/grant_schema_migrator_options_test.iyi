module test/grant_schema_migrator_options_test
import grant/base
import test/spec_helper
import std/time::{Time}

pub class M02aOptionRow < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_option_rows
  column id : Int64, primary: true
  column happened : Time?, precision: 3
  column code : String, limit: 20, collation: {{ (env("CURRENT_ADAPTER") || "sqlite") == "pg" ? "C" : "NOCASE" }}, comment: "Public code"
  column note : String, null: true
end

SpecHelper.register_spec_connections

# it: adds IF NOT EXISTS and TEMPORARY
sql = M02aOptionRow.migrator.create_sql(if_not_exists: true, temporary: true)
assert sql.starts_with?("CREATE TEMPORARY TABLE IF NOT EXISTS ")

# it: applies precision, scale, limit, collation, comment and null:
sql = M02aOptionRow.migrator.create_sql(comment: "Rows")
if SpecHelper::CURRENT_ADAPTER == "pg"
  assert sql.includes?("\"happened\" TIMESTAMP(3)")
  assert sql.includes?("\"code\" VARCHAR(20) COLLATE \"C\" NOT NULL")
  statements = M02aOptionRow.migrator.create_statements(comment: "Rows")
  assert statements.size == 3
  assert statements[1] == "COMMENT ON TABLE \"m02a_option_rows\" IS 'Rows'"
  assert statements[2] == "COMMENT ON COLUMN \"m02a_option_rows\".\"code\" IS 'Public code'"
else
  assert sql.includes?("\"happened\" TIMESTAMP")
  assert sql.includes?("\"code\" VARCHAR(20) COLLATE NOCASE NOT NULL")
  assert M02aOptionRow.migrator.create_statements(comment: "Rows").size == 1
end
assert sql.includes?("\"note\" #{SpecHelper::CURRENT_ADAPTER == "pg" ? "TEXT" : "VARCHAR(255)"}\n")

# it: creates idempotently and drops with options
migrator = M02aOptionRow.migrator
migrator.drop.or_panic
migrator.create.or_panic
error = migrator.create
assert error.is_a?(::Grant::Errors::ErrorBase)
migrator.create(if_not_exists: true).or_panic
assert migrator.drop_sql == "DROP TABLE IF EXISTS \"m02a_option_rows\";"
assert migrator.drop_sql(if_exists: false).starts_with?("DROP TABLE \"")
assert migrator.drop_sql(cascade: true).ends_with?(" CASCADE;") == (SpecHelper::CURRENT_ADAPTER == "pg")
migrator.drop.or_panic
migrator.drop.or_panic
M02aOptionRow.migrator.drop.or_panic
