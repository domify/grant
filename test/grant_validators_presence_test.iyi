module test/grant_validators_presence_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class PresenceArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table presence_articles

  column id : Int64, primary: true
  column title : String?
  column body : String?
  column category_id : Int32?

  validates_presence_of :title
  validates_presence_of :body, message: "is required"
  validates_presence_of :category_id
end

pub class ConditionalPresenceArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table conditional_presence_articles

  column id : Int64, primary: true
  column title : String?
  column summary : String?
  column review_notes : String?
  column published : Bool = false
  column draft : Bool = true

  validates_presence_of :title
  validates_presence_of :summary, if: :published?

  def published? : Bool
    !!published
  end

  validates_presence_of :review_notes, unless: :draft?

  def draft? : Bool
    !!draft
  end
end

register_spec_connections

# it: validates string is not blank
article = PresenceArticle.new
article.title = "Hello"
article.body = "World"
article.category_id = 1
assert article.valid?.or_panic

# it: fails when string field is nil
article = PresenceArticle.new
article.title = nil
article.body = "content"
assert !article.valid?.or_panic
assert article.errors.first.field == "title"
assert article.errors.first.message == "can't be blank"

# it: fails when string field is blank
article = PresenceArticle.new
article.title = ""
article.body = "content"
assert !article.valid?.or_panic
assert article.errors.first.field == "title"

# it: fails when string field is whitespace only
article = PresenceArticle.new
article.title = "   "
article.body = "content"
assert !article.valid?.or_panic
assert article.errors.first.field == "title"

# it: validates non-nil for non-string types
article = PresenceArticle.new
article.title = "Hello"
article.body = "World"
article.category_id = nil
assert !article.valid?.or_panic
assert article.errors.map(&.field).includes?("category_id")

# it: passes for non-string non-nil values
article = PresenceArticle.new
article.title = "Hello"
article.body = "World"
article.category_id = 42
assert article.valid?.or_panic

# it: supports custom message
article = PresenceArticle.new
article.title = "Hello"
article.body = nil
assert !article.valid?.or_panic
assert article.errors.first.message == "is required"

# it: supports if: conditional
article = ConditionalPresenceArticle.new
article.title = "Hello"
article.published = false
article.summary = nil
# Summary not required when not published
assert article.valid?.or_panic

article.published = true
article.summary = nil
assert !article.valid?.or_panic
assert article.errors.first.field == "summary"

# it: supports unless: conditional
article = ConditionalPresenceArticle.new
article.title = "Hello"
article.published = false
article.summary = "summary"
article.draft = true
article.review_notes = nil
# review_notes not required when draft
assert article.valid?.or_panic

article.draft = false
article.published = false
article.review_notes = nil
assert !article.valid?.or_panic
assert article.errors.map(&.field).includes?("review_notes")

# it: collects multiple presence errors
article = PresenceArticle.new
article.title = nil
article.body = nil
article.category_id = nil
assert !article.valid?.or_panic
assert article.errors.size == 3

