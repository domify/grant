module test/grant_query_select_order_expressions_test
import grant
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/query/assembler::{Pg, Sqlite}
import grant/query/where_field::{Sort}
import grant/query/select_expressions::{TypeCastError}
import grant/error::{ArgumentError}
import std/regex
import std/enumerable
import test/spec_helper::{register_spec_connections}
  pub class SoTeam < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table so_teams
    column id : Int64, primary: true
    column label : String
    has_many :players, class_name: SoPlayer, foreign_key: :so_team_id
  end

  pub class SoPlayer < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table so_players
    column id : Int64, primary: true
    column name : String?
    column position : String
    column score : Int64
    column so_team_id : Int64?
    belongs_to :so_team, class_name: SoTeam, foreign_key: :so_team_id, optional: true
  end

def names(relation : Builder(SoPlayer)) : Array(String?)
  relation.select.or_panic.map(&.name)
end

register_spec_connections
SoTeam.migrator.drop_and_create.or_panic
SoPlayer.migrator.drop_and_create.or_panic

# it: adds a computed column reachable through extra_attribute
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
row = SoPlayer.where(position: "guard").select(:position, "COUNT(*) AS total").group_records(:position).select.or_panic.first
assert row.position == "guard"
assert row.extra_attribute("total", Int64).or_panic == 2_i64
assert row.extra_attributes.keys == ["total"]
assert row.extra_attribute(:total) == 2_i64
error = row.extra_attribute("total", String)
assert error.is_a?(TypeCastError)
assert error.as(TypeCastError).message.matches?(/"total" is Int64, not String/)
error = row.extra_attribute("missing", Int64)
assert error.is_a?(TypeCastError)
assert error.as(TypeCastError).message.matches?(/"missing" is Nil/)
assert row.extra_attribute("missing", Int64?).or_panic.nil?

# it: reads the columns that follow a computed column
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
row = SoPlayer.order(:id).select(:id, "score * 2 AS doubled", :position).select.or_panic.first
assert !row.id.nil?
assert row.position == "guard"
assert row.extra_attribute("doubled", Int64).or_panic == 10_i64

# it: supports several aliases and a bare expression
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
row = SoPlayer.order(:id).select(:name, "score + 1 AS next_score", "upper(position) AS shout").select.or_panic.first
assert row.extra_attribute("next_score", Int64).or_panic == 6_i64
assert row.extra_attribute("shout", String).or_panic == "GUARD"

# it: gives nil for a column that was not selected
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.select(:name).select.or_panic.first.extra_attribute("nothing").nil?
assert SoPlayer.select(:name).select.or_panic.first.extra_attributes.empty?

# it: keeps the symbol form and the block form
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.select(:id, :name).select.or_panic.size == 4
assert SoPlayer.order(:id).select { |player| player.score.as(Int64) > 6 }.or_panic.map(&.score.as(Int64)) == [9_i64, 7_i64]

# it: replaces the list with reselect
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
relation = SoPlayer.select("score AS s").reselect("position AS p")
assert relation.raw_sql.includes?("position AS p")
assert !relation.raw_sql.includes?("score AS s")

# it: qualifies plain columns when joins are present and leaves expressions alone
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
sql = SoPlayer.joins(:so_team).select(:name, "so_teams.label AS team").raw_sql
assert sql.includes?("SELECT #{SoPlayer.quote("so_players")}.#{SoPlayer.quote("name")}, so_teams.label AS team")
row = SoPlayer.joins(:so_team).where(name: "Alpha").select(:name, "so_teams.label AS team").select.or_panic.first
assert row.extra_attribute("team", String).or_panic == "Reds"

# it: refuses an expression that is not a single clause
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
error = SoPlayer.select("1; DROP TABLE so_players").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/statement separator/)
error = SoPlayer.select("count(*").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/unbalanced/)

# it: orders by a raw expression with its own direction
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert names(SoPlayer.where("name IS NOT NULL").order("lower(name) DESC")) == ["gamma", "beta", "Alpha"]
assert names(SoPlayer.where("name IS NOT NULL").order("lower(name)")) == ["Alpha", "beta", "gamma"]

# it: orders by several comma-separated terms
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
relation = SoPlayer.order("position DESC, score ASC")
assert relation.select.or_panic.map(&.score.as(Int64)) == [2_i64, 7_i64, 5_i64, 9_i64]

# it: does not split on commas inside a function call
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.order("coalesce(name, position) DESC, id").order_fields.size == 2

# it: keeps plain terms structured
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
terms = SoPlayer.order("position DESC").order_fields
assert terms.first[:field] == "position"
assert terms.first[:direction] == Sort::Descending

# it: orders on a joined-table column by qualified name
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.joins(:so_team).order("so_teams.label", :asc).order(score: :desc).select.or_panic.map(&.score.as(Int64)) == [7_i64, 2_i64, 9_i64, 5_i64]
assert SoPlayer.joins(:so_team).order("so_teams.label": :desc, "so_players.score": :asc).select.or_panic.map(&.score.as(Int64)) == [5_i64, 9_i64, 2_i64, 7_i64]

# it: rejects an unknown table qualifier
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
error = SoPlayer.joins(:so_team).order("nope.label", :asc).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/Unknown query table "nope"/)

# it: refuses an expression that is not a single clause
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
error = SoPlayer.order("id; DROP TABLE so_players").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/statement separator/)
error = SoPlayer.order("id /* x */").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/comment marker/)

# it: rejects raw SQL that is not a function of columns, like ActiveRecord
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
error = SoPlayer.order("(SELECT 1) DESC").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not a column or a function of columns/)
error = SoPlayer.order("CASE WHEN score > 5 THEN 0 ELSE 1 END").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not a column or a function of columns/)
error = SoPlayer.order("pg_sleep(1)").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not a column or a function of columns/)
error = SoPlayer.order("lower('x')").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not a column or a function of columns/)
error = SoPlayer.order("score + 1", :desc).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not a column or a function of columns/)

# it: accepts SQL wrapped in Grant.sql
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
relation = SoPlayer.order(Grant.sql("CASE WHEN score > 5 THEN 0 ELSE 1 END, score"))
assert relation.select.or_panic.map(&.score.as(Int64)) == [7_i64, 9_i64, 2_i64, 5_i64]
error = SoPlayer.order(Grant.sql("id; DROP TABLE so_players")).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/statement separator/)

# it: reverses raw and structured terms
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.order("lower(position) DESC, score").reverse_order.raw_sql.includes?("lower(position) ASC, score DESC")
assert SoPlayer.order(:position, :asc, nulls: :last).reverse_order.order_fields.first[:direction] == Sort::DescendingNullsFirst

# it: orders a raw expression after loading through last
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert SoPlayer.where("name IS NOT NULL").order("lower(name)").last.or_panic.as(SoPlayer).name == "gamma"

# it: places NULLs first or last on both directions
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert names(SoPlayer.order(:name, nulls: :first)).first.nil?
assert names(SoPlayer.order(:name, nulls: :last)).last.nil?
assert names(SoPlayer.order(:name, :desc, nulls: :first)).first.nil?
assert names(SoPlayer.order(:name, :desc, nulls: :last)).last.nil?
assert names(SoPlayer.order(:name, :asc, nulls: :last)).compact == ["Alpha", "beta", "gamma"]

# it: accepts NULLS in an order string
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
assert names(SoPlayer.order("name ASC NULLS LAST")).last.nil?
assert names(SoPlayer.order("name desc nulls first")).first.nil?
assert SoPlayer.order("name NULLS FIRST").order_fields.first[:direction] == Sort::AscendingNullsFirst

# it: renders NULLS FIRST/LAST natively on PostgreSQL and SQLite
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
sql = Pg(SoPlayer, Builder(SoPlayer)).new(SoPlayer.order(:name, :desc, nulls: :last)).order.as(String)
assert sql.includes?("DESC NULLS LAST")
assert Sqlite(SoPlayer, Builder(SoPlayer)).new(SoPlayer.order(:name, nulls: :first)).order.as(String).includes?("ASC NULLS FIRST")

# it: batches ascending when the primary key order carries a NULL placement
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
ids = SoPlayer.order(:id).select.or_panic.map(&.id.as(Int64))
seen = [] of Int64
SoPlayer.order(:id, :asc, nulls: :last).in_batches(of: 1, start: ids[1]) { |batch| batch.each { |player| seen << player.id.as(Int64) } }.or_panic
assert seen == ids.skip(1)

# it: validates the placement and direction
SoPlayer.clear.or_panic
SoTeam.clear.or_panic
reds = SoTeam.create_strict(label: "Reds").or_panic
blues = SoTeam.create_strict(label: "Blues").or_panic
SoPlayer.create_strict(name: "beta", position: "guard", score: 5_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: "Alpha", position: "guard", score: 9_i64, so_team_id: reds.id).or_panic
SoPlayer.create_strict(name: nil, position: "wing", score: 7_i64, so_team_id: blues.id).or_panic
SoPlayer.create_strict(name: "gamma", position: "wing", score: 2_i64, so_team_id: blues.id).or_panic
error = SoPlayer.order(:name, nulls: :middle).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/nulls must be :first or :last/)
error = SoPlayer.order(:name, :sideways).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/direction must be :asc or :desc/)
error = SoPlayer.order("lower(name)", :asc, nulls: :last).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/column name/)

SoPlayer.adapter.close.or_panic
