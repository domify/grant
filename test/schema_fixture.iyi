module test/schema_fixture

import grant/schema/introspection
import grant/adapter/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/errors::{ErrorBase}
import test/spec_helper::{CURRENT_ADAPTER}

pub def adapter : Base
  ConnectionRegistry.get_adapter(CURRENT_ADAPTER)
end

pub def exec(sql : String) : Nil | ErrorBase | Cancelled
  adapter.open { |db| db.exec(sql)!; nil }
end

pub TABLES = ["m01_memberships", "m01_posts", "m01_authors"]
pub def create_in_place : Nil
  drop_in_place
    id, active, money = case CURRENT_ADAPTER
                        when "pg"
                          {"BIGSERIAL PRIMARY KEY", "BOOLEAN NOT NULL DEFAULT TRUE", "NUMERIC(10,2)"}
                        when "mysql"
                          {"BIGINT AUTO_INCREMENT PRIMARY KEY", "TINYINT(1) NOT NULL DEFAULT 1", "DECIMAL(10,2)"}
                        else
                          {"INTEGER PRIMARY KEY AUTOINCREMENT", "BOOLEAN NOT NULL DEFAULT 1", "NUMERIC(10,2)"}
                        end
    exec(<<-SQL).or_panic
      CREATE TABLE m01_authors (
        id #{id},
        email VARCHAR(120) NOT NULL,
        bio TEXT,
        active #{active},
        created_at TIMESTAMP
      )
      SQL
    exec(<<-SQL).or_panic
      CREATE TABLE m01_posts (
        id #{id},
        author_id BIGINT NOT NULL,
        title VARCHAR(80) NOT NULL,
        score #{money},
        CONSTRAINT fk_m01_posts_author FOREIGN KEY (author_id) REFERENCES m01_authors (id) ON DELETE CASCADE
      )
      SQL
    exec("CREATE UNIQUE INDEX index_m01_posts_on_author_id_and_title ON m01_posts (author_id, title)").or_panic
    exec("CREATE INDEX index_m01_posts_on_score ON m01_posts (score)").or_panic
    exec("CREATE INDEX index_m01_authors_on_lower_email ON m01_authors ((lower(email)))").or_panic unless CURRENT_ADAPTER == "mysql"
    # MySQL refuses SET NULL on a column of the primary key.
    delete_action = CURRENT_ADAPTER == "mysql" ? "RESTRICT" : "SET NULL"
    exec(<<-SQL).or_panic
      CREATE TABLE m01_memberships (
        author_id BIGINT NOT NULL,
        group_id BIGINT NOT NULL,
        role VARCHAR(20),
        PRIMARY KEY (author_id, group_id),
        FOREIGN KEY (author_id) REFERENCES m01_authors (id) ON UPDATE CASCADE ON DELETE #{delete_action}
      )
      SQL
  adapter.reset_schema_caches_in_place
end

pub def drop_in_place : Nil
  TABLES.each { |table| exec("DROP TABLE IF EXISTS #{table}").or_panic }
  adapter.reset_schema_caches_in_place
end
