module test/grant_attributes_introspection_test
import test/attribute_spec_models::{AttrPost, Level}
import test/spec_helper::{register_spec_connections}
import grant/attributes::{UnknownAttributeError}
import grant/columns
# Native Hash#== fails for identical union-valued hashes; see port/bugs/state_hash_union.md.
def same_attributes?(actual : Hash(String, Grant::Columns::Type),
                     expected : Hash(String, Grant::Columns::Type)) : Bool
  return false unless actual.size == expected.size
  expected.each do |key, value|
    return false unless actual.has_key?(key) && actual[key] == value
  end
  true
end

register_spec_connections
AttrPost.migrator.drop_and_create.or_panic

# it: lists attribute and column names on the class and the record
assert AttrPost.attribute_names == ["id", "title", "views", "published", "level", "author_id",
                                    "created_at", "updated_at"]
assert AttrPost.column_names == AttrPost.attribute_names
assert AttrPost.new.attribute_names == AttrPost.attribute_names

# it: returns every attribute with converters applied
post = AttrPost.new(title: "Hello", views: 3, level: Level::High)
attributes = post.attributes.or_panic
assert attributes.keys == AttrPost.attribute_names
assert attributes["title"] == "Hello"
assert attributes["views"] == 3
assert attributes["level"] == "High"
assert attributes["id"].nil?

# it: answers has_attribute? for columns, aliases and strangers
post = AttrPost.new
assert post.has_attribute?("title")
assert post.has_attribute?(:views)
assert post.has_attribute?("name")
assert !post.has_attribute?("nope")

# it: answers attribute_present? like ActiveRecord
post = AttrPost.new(title: "", views: 0)
assert !post.attribute_present?("title").or_panic
post.title = "   "
assert post.attribute_present?("title").or_panic
assert !post.attribute_present?("published").or_panic
assert post.attribute_present?("views").or_panic
post.title = "x"
assert post.attribute_present?(:title).or_panic
assert post.attribute_present?("nope").is_a?(UnknownAttributeError)

# it: reads and writes by name with [] and []=
post = AttrPost.new(title: "Hello")
assert post["title"].or_panic == "Hello"
assert post[:title].or_panic == "Hello"
assert post["name"].or_panic == "Hello"
post["views"] = 7
assert post.views == 7
assert post.views_changed?
assert post["nope"].is_a?(UnknownAttributeError)
assert (post["nope"] = 1).is_a?(UnknownAttributeError)

# it: slices and collects values in the requested order
post = AttrPost.new(title: "Hello", views: 3)
assert same_attributes?(post.slice("title", :views).or_panic,
                        {"title" => "Hello", "views" => 3} of String => Grant::Columns::Type)
assert post.values_at("views", "title").or_panic == ([3, "Hello"] of Grant::Columns::Type)

# it: reflects a persisted record
post = AttrPost.create_strict(title: "Saved", views: 1).or_panic
loaded = AttrPost.find_strict(post.id).or_panic
assert loaded.attributes.or_panic["title"] == "Saved"
assert same_attributes?(loaded.slice("id").or_panic,
                        {"id" => post.id} of String => Grant::Columns::Type)
AttrPost.adapter.close.or_panic
