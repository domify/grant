module test/grant_schema_references_join_table_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect}
import grant/schema/column_info::{ColumnInfo, ReferentialAction}
import grant/schema/introspection
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections

# it: derives the join table name and columns
sql = RecordingStatements.new(Dialect::Pg).create_join_table_statements(:users, :groups).or_panic
assert sql == ["CREATE TABLE \"groups_users\" (\n  \"user_id\" BIGINT NOT NULL,\n  \"group_id\" BIGINT NOT NULL\n)"]
assert RecordingStatements.new(Dialect::Mysql).create_join_table_statements(:categories, :posts, column_options: {null: true}).or_panic.first == "CREATE TABLE `categories_posts` (\n  `category_id` BIGINT,\n  `post_id` BIGINT\n)"
assert RecordingStatements.new(Dialect::Pg).drop_join_table_statements(:users, :groups) == ["DROP TABLE \"groups_users\""]

# it: adds a join table with an index through the block
sql = RecordingStatements.new(Dialect::Pg).create_join_table_statements(:users, :groups, table_name: :memberships) do |t|
  t.index([:user_id, :group_id], unique: true)
end.or_panic
assert sql.last == "CREATE UNIQUE INDEX \"index_memberships_on_user_id_and_group_id\" ON \"memberships\" (\"user_id\", \"group_id\")"

# it: builds reference columns, index and foreign key for create_table
sql = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02b_posts) do |t|
  t.references(:user, foreign_key: true).or_panic
  t.references(:commentable, polymorphic: true).or_panic
  t.references(:editor, foreign_key: {to_table: :users, on_delete: :nullify})
end.or_panic
assert sql.first.includes?("\"user_id\" BIGINT")
assert sql.first.includes?("\"commentable_type\" VARCHAR")
assert sql.first.includes?("CONSTRAINT \"fk_m02b_posts_user_id\" FOREIGN KEY (\"user_id\") REFERENCES \"users\" (\"id\")")
assert sql.first.includes?("CONSTRAINT \"fk_m02b_posts_editor_id\" FOREIGN KEY (\"editor_id\") REFERENCES \"users\" (\"id\") ON DELETE SET NULL")
assert !sql.first.includes?("REFERENCES \"commentables\"")
assert sql.includes?("CREATE INDEX \"index_m02b_posts_on_commentable_type_and_commentable_id\" ON \"m02b_posts\" (\"commentable_type\", \"commentable_id\")")
assert sql.includes?("CREATE INDEX \"index_m02b_posts_on_user_id\" ON \"m02b_posts\" (\"user_id\")")

# it: adds and removes a reference on an existing table
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_reference_statements(:posts, :user, foreign_key: true).or_panic == [
  "ALTER TABLE \"posts\" ADD COLUMN \"user_id\" BIGINT",
  "CREATE INDEX \"index_posts_on_user_id\" ON \"posts\" (\"user_id\")",
  "ALTER TABLE \"posts\" ADD CONSTRAINT \"fk_posts_user_id\" FOREIGN KEY (\"user_id\") REFERENCES \"users\" (\"id\")"]
assert RecordingStatements.new(Dialect::Sqlite).add_reference_statements(:posts, :user, foreign_key: true, index: false).or_panic == ["ALTER TABLE \"posts\" ADD COLUMN \"user_id\" BIGINT REFERENCES \"users\" (\"id\")"]
assert RecordingStatements.new(Dialect::Mysql).remove_reference_statements(:posts, :user, foreign_key: true).or_panic == ["ALTER TABLE `posts` DROP FOREIGN KEY `fk_posts_user_id`", "ALTER TABLE `posts` DROP COLUMN `user_id`"]

private def cleanup : Nil
  AdapterStatements.new(::Test::SchemaFixture.adapter).drop_table(:m02b_rf_posts, :m02b_rf_editors, :m02b_rf_groups, :m02b_rf_editors_m02b_rf_groups, if_exists: true).or_panic
end
private def setup : AdapterStatements
  cleanup
  statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
  statements.create_table(:m02b_rf_editors) { |t| t.string(:name) }.or_panic
  statements.create_table(:m02b_rf_posts) { |t| t.string(:title) }.or_panic
  statements
end
schema = ::Test::SchemaFixture.adapter.schema

# it: creates and drops a join table
statements = setup
statements.create_join_table(:m02b_rf_editors, :m02b_rf_groups).or_panic
name = "m02b_rf_editors_m02b_rf_groups"
assert schema.columns(name).or_panic.map { |info| info.name } == ["m02b_rf_editor_id", "m02b_rf_group_id"]
assert schema.columns(name).or_panic.none? { |info| info.null? }
statements.drop_join_table(:m02b_rf_editors, :m02b_rf_groups).or_panic
assert !schema.table_exists?(name).or_panic
cleanup

# it: adds a reference with an index and a foreign key
statements = setup
statements.add_reference(:m02b_rf_posts, :m02b_rf_editor, foreign_key: {to_table: :m02b_rf_editors}).or_panic
assert schema.columns(:m02b_rf_posts).or_panic.map { |info| info.name } == ["id", "title", "m02b_rf_editor_id"]
assert schema.index_exists?(:m02b_rf_posts, ["m02b_rf_editor_id"]).or_panic
assert schema.foreign_key_exists?(:m02b_rf_posts, :m02b_rf_editors).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_rf_editors (name) VALUES ('e')")
::Test::SchemaFixture.exec("INSERT INTO m02b_rf_posts (title, m02b_rf_editor_id) VALUES ('t', 1)")
assert ::Test::SchemaFixture.adapter.open { |db| db.exec("INSERT INTO m02b_rf_posts (title, m02b_rf_editor_id) VALUES ('t', 99)") }.is_a?(ErrorBase)
cleanup

# it: adds a polymorphic reference with a composite index and no key
statements = setup
statements.add_reference(:m02b_rf_posts, :owner, polymorphic: true).or_panic
assert schema.columns(:m02b_rf_posts).or_panic.map { |info| info.name } == ["id", "title", "owner_id", "owner_type"]
assert schema.indexes(:m02b_rf_posts).or_panic.map { |index| index.columns } == [["owner_type", "owner_id"]]
assert schema.foreign_keys(:m02b_rf_posts).or_panic.empty?
cleanup

# it: removes a reference with its column, index and foreign key
statements = setup
statements.add_reference(:m02b_rf_posts, :m02b_rf_editor, foreign_key: {to_table: :m02b_rf_editors}).or_panic
statements.remove_reference(:m02b_rf_posts, :m02b_rf_editor, foreign_key: true).or_panic
assert schema.columns(:m02b_rf_posts).or_panic.map { |info| info.name } == ["id", "title"]
assert schema.indexes(:m02b_rf_posts).or_panic.empty?
assert schema.foreign_keys(:m02b_rf_posts).or_panic.empty?
cleanup

# it: creates references in create_table
statements = setup
statements.create_table(:m02b_rf_posts, force: true) do |t|
  t.references(:m02b_rf_editor, foreign_key: {to_table: :m02b_rf_editors, on_delete: :cascade}, null: false).or_panic
  t.references(:commentable, polymorphic: true)
end.or_panic
assert schema.foreign_keys(:m02b_rf_posts).or_panic.first.on_delete == ReferentialAction::Cascade
assert !schema.columns(:m02b_rf_posts).or_panic.find { |info| info.name == "m02b_rf_editor_id" }.as(ColumnInfo).null?
assert schema.indexes(:m02b_rf_posts).or_panic.size == 2
cleanup
