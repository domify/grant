module test/grant_encryption_key_rotation_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/migration_helpers
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/cipher::{DecryptionError}
import std/base64::{Base64}
import std/text
import test/spec_helper::{register_spec_connections}

pub class RotationTestUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table rotation_test_users
  column id : Int64, primary: true
  column name : String
  encrypts :email, deterministic: true
  encrypts :phone, deterministic: true
  encrypts :ssn
  timestamps
end

ORIGINAL_PRIMARY_KEY = Base64.encode("original_primary_key_32_bytes!!!")
ORIGINAL_DETERMINISTIC_KEY = Base64.encode("original_determ_key_32_bytes!!!!")
ORIGINAL_SALT = Base64.encode("original_salt_key_32_bytes!!!!!")
NEW_PRIMARY_KEY = Base64.encode("new_primary_key_32_bytes!!!!!!!!")
NEW_DETERMINISTIC_KEY = Base64.encode("new_determ_key_32_bytes!!!!!!!!!")
NEW_SALT = Base64.encode("new_salt_key_32_bytes!!!!!!!!!!")

private def original_keys : Nil
  Grant::Encryption.configure do |config|
    (config.primary_key = ORIGINAL_PRIMARY_KEY).or_panic
    (config.deterministic_key = ORIGINAL_DETERMINISTIC_KEY).or_panic
    config.key_derivation_salt = ORIGINAL_SALT
  end
  nil
end

private def new_keys : Nil
  Grant::Encryption.configure do |config|
    (config.primary_key = NEW_PRIMARY_KEY).or_panic
    (config.deterministic_key = NEW_DETERMINISTIC_KEY).or_panic
    config.key_derivation_salt = NEW_SALT
  end
  nil
end

register_spec_connections
RotationTestUser.migrator.drop_and_create.or_panic

# it: rotates encryption keys for all encrypted attributes
RotationTestUser.clear.or_panic
original_keys
users = [] of RotationTestUser
10.times do |i|
  user = RotationTestUser.create_strict(name: "User #{i}", email: "user#{i}@example.com", phone: "+1-555-#{i.to_s.rjust(4, '0')}", ssn: "#{i.to_s.rjust(3, '0')}-12-3456").or_panic
  users << user
end
original_values = users.map do |user|
  {id: user.id, email: user.email.or_panic, phone: user.phone.or_panic, ssn: user.ssn.or_panic}
end
new_keys
[:email, :phone, :ssn].each do |attribute|
  count = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, attribute,
    old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
    old_salt: ORIGINAL_SALT, batch_size: 5, progress: false).or_panic
  assert count == 10
end
original_values.each do |original|
  user = RotationTestUser.find_strict(original[:id]).or_panic
  assert user.email.or_panic == original[:email]
  assert user.phone.or_panic == original[:phone]
  assert user.ssn.or_panic == original[:ssn]
end
original_keys
user = RotationTestUser.find_strict(users.first.id).or_panic
assert user.email.is_a?(DecryptionError)

# it: handles nil values during rotation
RotationTestUser.clear.or_panic
original_keys
user_with_nil = RotationTestUser.create_strict(name: "No Email User", phone: "+1-555-9999").or_panic
user_with_values = RotationTestUser.create_strict(name: "Full User", email: "full@example.com", phone: "+1-555-8888", ssn: "999-88-7777").or_panic
new_keys
[:email, :phone, :ssn].each do |attribute|
  Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, attribute,
    old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
    old_salt: ORIGINAL_SALT, progress: false).or_panic
end
retrieved_nil = RotationTestUser.find_strict(user_with_nil.id).or_panic
assert retrieved_nil.email.or_panic.nil?
assert retrieved_nil.ssn.or_panic.nil?
assert retrieved_nil.phone.or_panic == "+1-555-9999"
retrieved_full = RotationTestUser.find_strict(user_with_values.id).or_panic
assert retrieved_full.email.or_panic == "full@example.com"
assert retrieved_full.phone.or_panic == "+1-555-8888"
assert retrieved_full.ssn.or_panic == "999-88-7777"

# it: maintains deterministic searchability after rotation
RotationTestUser.clear.or_panic
original_keys
user1 = RotationTestUser.create_strict(name: "Search Test 1", email: "search1@example.com", phone: "+1-555-1111").or_panic
user2 = RotationTestUser.create_strict(name: "Search Test 2", email: "search2@example.com", phone: "+1-555-2222").or_panic
found = RotationTestUser.find_by_email("search1@example.com").or_panic
assert !found.nil?
assert found.as(RotationTestUser).id == user1.id
new_keys
[:email, :phone].each do |attribute|
  Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, attribute,
    old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
    old_salt: ORIGINAL_SALT, progress: false).or_panic
end
found = RotationTestUser.find_by_email("search1@example.com").or_panic
assert !found.nil?
assert found.as(RotationTestUser).id == user1.id
found = RotationTestUser.find_by_phone("+1-555-2222").or_panic
assert !found.nil?
assert found.as(RotationTestUser).id == user2.id
results = RotationTestUser.where_email("search2@example.com").select.or_panic
assert results.size == 1
assert results.first.id == user2.id

# it: handles errors gracefully and restores original keys
RotationTestUser.clear.or_panic
original_keys
RotationTestUser.create_strict(name: "Error Test", email: "error@example.com", ssn: "111-22-3333").or_panic
new_keys
invalid_key = Base64.encode("invalid_key_32_bytes_!!!!!!!!!!!")
error = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, :email,
  old_keys: {primary: invalid_key, deterministic: invalid_key}, old_salt: ORIGINAL_SALT, progress: false)
assert error.is_a?(DecryptionError)
assert KeyProvider.primary_key == Base64.decode(NEW_PRIMARY_KEY)
assert KeyProvider.deterministic_key == Base64.decode(NEW_DETERMINISTIC_KEY)

# it: handles batch processing correctly
RotationTestUser.clear.or_panic
original_keys
50.times do |i|
  RotationTestUser.create_strict(name: "Batch User #{i}", email: "batch#{i}@example.com", ssn: "#{i.to_s.rjust(3, '0')}-99-8888").or_panic
end
new_keys
count = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, :email,
  old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
  old_salt: ORIGINAL_SALT, batch_size: 7, progress: false).or_panic
assert count == 50
RotationTestUser.order(id: :asc).select.or_panic.each_with_index do |user, i|
  assert user.email.or_panic == "batch#{i}@example.com"
end

# it: rotates only non-deterministic fields correctly
RotationTestUser.clear.or_panic
original_keys
users = Array(RotationTestUser).new(5) do |i|
  RotationTestUser.create_strict(name: "ND Test #{i}", email: "nd#{i}@example.com", ssn: "#{i}00-11-2222").or_panic
end
Grant::Encryption.configure do |config|
  (config.primary_key = NEW_PRIMARY_KEY).or_panic
  (config.deterministic_key = ORIGINAL_DETERMINISTIC_KEY).or_panic
  config.key_derivation_salt = ORIGINAL_SALT
end
count = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, :ssn,
  old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: nil}, old_salt: ORIGINAL_SALT, progress: false).or_panic
assert count == 5
users.each_with_index do |original_user, i|
  user = RotationTestUser.find_strict(original_user.id).or_panic
  assert user.ssn.or_panic == "#{i}00-11-2222"
end
found = RotationTestUser.find_by_email("nd2@example.com").or_panic
assert !found.nil?
assert found.as(RotationTestUser).id == users[2].id

# it: handles interruption and resume
RotationTestUser.clear.or_panic
original_keys
20.times do |i|
  RotationTestUser.create_strict(name: "Resume Test #{i}", email: "resume#{i}@example.com", ssn: "#{i.to_s.rjust(3, '0')}-55-6666").or_panic
end
new_keys
first_10 = RotationTestUser.limit(10).select.or_panic
first_10.each do |user|
  original_keys
  email_value = user.email.or_panic
  new_keys
  (user.email = email_value).or_panic
  user.save_strict(validate: false).or_panic
end
count = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, :email,
  old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
  old_salt: ORIGINAL_SALT, progress: false).or_panic
assert count == 20
RotationTestUser.all("ORDER BY id").or_panic.each_with_index do |user, i|
  assert user.email.or_panic == "resume#{i}@example.com"
end

# it: rotates multiple fields in a single pass
RotationTestUser.clear.or_panic
original_keys
10.times do |i|
  RotationTestUser.create_strict(name: "Multi #{i}", email: "multi#{i}@example.com", phone: "+1-555-#{i.to_s.rjust(4, '0')}", ssn: "#{i.to_s.rjust(3, '0')}-77-8888").or_panic
end
new_keys
total_rotated = 0
[:email, :phone, :ssn].each do |field|
  count = Grant::Encryption::MigrationHelpers.rotate_encryption(RotationTestUser, field,
    old_keys: {primary: ORIGINAL_PRIMARY_KEY, deterministic: ORIGINAL_DETERMINISTIC_KEY},
    old_salt: ORIGINAL_SALT, progress: false).or_panic
  total_rotated += count
end
assert total_rotated == 30
RotationTestUser.all("ORDER BY id").or_panic.each_with_index do |user, i|
  assert user.email.or_panic == "multi#{i}@example.com"
  assert user.phone.or_panic == "+1-555-#{i.to_s.rjust(4, '0')}"
  assert user.ssn.or_panic == "#{i.to_s.rjust(3, '0')}-77-8888"
end

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
