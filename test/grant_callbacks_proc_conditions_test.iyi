module test/grant_callbacks_proc_conditions_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}
# Proc/lambda if:/unless: conditions on lifecycle callbacks (not just Symbols).

pub class ProcCallbackModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table proc_callback_models

  column id : Int64, primary: true
  column name : String?
  column enabled : Bool = true

  property log = [] of String

  # Proc condition gating a before_save callback
  before_save :log_enabled, if: ->(r : ProcCallbackModel) { !!r.enabled }

  # Proc unless condition gating an after_save callback
  after_save :log_after, unless: ->(r : ProcCallbackModel) { !!r.skip_after }

  property skip_after = false

  private def log_enabled
    log << "before_save:enabled"
  end

  private def log_after
    log << "after_save"
  end
end

# Symbol-form conditions (previously implemented but untested — the
# NamedTuple/NamedTupleLiteral macro fix is what makes these actually run).
pub class SymbolCallbackModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table symbol_callback_models

  column id : Int64, primary: true
  column name : String?
  column active : Bool = true

  property log = [] of String

  before_save :log_active, if: :active?
  after_save :log_done, unless: :inactive?

  def active? : Bool
    !!active
  end

  def inactive? : Bool
    !active
  end

  private def log_active
    log << "before_save:active"
  end

  private def log_done
    log << "after_save:done"
  end
end

# Proc condition on an around callback
pub class ProcAroundCallbackModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table proc_around_callback_models

  column id : Int64, primary: true
  column name : String?
  column wrap : Bool = true

  property log = [] of String

  around_save :wrap_save, if: ->(r : ProcAroundCallbackModel) { !!r.wrap }

  private def wrap_save(block : Proc(Nil))
    log << "around:before"
    block.call
    log << "around:after"
  end
end


register_spec_connections
ProcCallbackModel.migrator.drop_and_create.or_panic
ProcAroundCallbackModel.migrator.drop_and_create.or_panic
SymbolCallbackModel.migrator.drop_and_create.or_panic

# it: runs before_save when the if: method is truthy
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = SymbolCallbackModel.new
m.name = "x"
m.active = true
m.save
assert m.log.includes?("before_save:active")
assert m.log.includes?("after_save:done")

# it: skips before_save when the if: method is falsey
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = SymbolCallbackModel.new
m.name = "x"
m.active = false
m.save
assert !m.log.includes?("before_save:active")
# unless: :inactive? is now truthy -> after_save skipped
assert !m.log.includes?("after_save:done")

# it: runs the callback when the proc is truthy
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcCallbackModel.new
m.name = "x"
m.enabled = true
m.save
assert m.log.includes?("before_save:enabled")

# it: skips the callback when the proc is falsey
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcCallbackModel.new
m.name = "x"
m.enabled = false
m.save
assert !m.log.includes?("before_save:enabled")

# it: runs when the proc is falsey
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcCallbackModel.new
m.name = "x"
m.skip_after = false
m.save
assert m.log.includes?("after_save")

# it: skips when the proc is truthy
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcCallbackModel.new
m.name = "x"
m.skip_after = true
m.save
assert !m.log.includes?("after_save")

# it: wraps when the proc is truthy
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcAroundCallbackModel.new
m.name = "x"
m.wrap = true
m.save
assert m.log == ["around:before", "around:after"]

# it: does not wrap when the proc is falsey (still saves)
ProcCallbackModel.clear.or_panic
ProcAroundCallbackModel.clear.or_panic
SymbolCallbackModel.clear.or_panic
m = ProcAroundCallbackModel.new
m.name = "x"
m.wrap = false
result = m.save
assert result
assert m.log.empty?
