module test/grant_query_where_nested_hash_test
import grant/base::{Base}
import grant/polymorphic
import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import grant/adapter/driver::{Value}
import grant/query/where_field::{Bind}
import std/regex
import std/time::{Time}
import test/spec_helper::{register_spec_connections}
  pub class WfAuthor < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_authors

    column id : Int64, primary: true
    column name : String?
    column active : Bool?

    has_many :posts, class_name: WfPost, foreign_key: author_id
  end

  pub class WfPost < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_posts

    column id : Int64, primary: true
    column title : String?
    column published : Bool?
    column score : Int32?

    belongs_to author : WfAuthor, foreign_key: author_id : Int64?, optional: true
    has_many :comments, as: :commentable, class_name: WfComment
    has_many :taggings, class_name: WfTagging, foreign_key: post_id
    has_many :tags, class_name: WfTag, through: :taggings, source: :tag
  end

  pub class WfComment < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_comments

    column id : Int64, primary: true
    column body : String?

    belongs_to :commentable, polymorphic: true, optional: true
  end

  pub class WfTag < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_tags

    column id : Int64, primary: true
    column label : String?
  end

  pub class WfTagging < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_taggings

    column id : Int64, primary: true

    belongs_to post : WfPost, foreign_key: post_id : Int64?, optional: true
    belongs_to tag : WfTag, foreign_key: tag_id : Int64?, optional: true
  end

  # A second commentable, to prove the polymorphic type column is matched.
  pub class WfVideo < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_videos

    column id : Int64, primary: true
    column title : String?

    has_many :comments, as: :commentable, class_name: WfComment
  end

  pub class WfMeasure < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table wf_measures

    column id : Int64, primary: true
    column label : String?
    column rank : Int32?
    column amount : Float64?
    column happened_at : Time?
  end
def post_titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map(&.title.to_s)
end

def comment_bodies(relation : Builder(WfComment)) : Array(String)
  relation.order(:id).select.or_panic.map(&.body.to_s)
end
def wf_create_tables : Nil
  WfAuthor.migrator.drop_and_create.or_panic
  WfPost.migrator.drop_and_create.or_panic
  WfComment.migrator.drop_and_create.or_panic
  WfTag.migrator.drop_and_create.or_panic
  WfTagging.migrator.drop_and_create.or_panic
  WfVideo.migrator.drop_and_create.or_panic
  WfMeasure.migrator.drop_and_create.or_panic
  nil
end

def wf_clear_tables : Nil
  WfTagging.clear.or_panic
  WfComment.clear.or_panic
  WfPost.clear.or_panic
  WfTag.clear.or_panic
  WfVideo.clear.or_panic
  WfAuthor.clear.or_panic
  WfMeasure.clear.or_panic
  nil
end

register_spec_connections
wf_create_tables

# it: filters on the joined table's columns
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
relation = WfPost.joins(:author).where(wf_authors: {active: true})
assert post_titles(relation) == ["by ann", "by cy"]

# it: accepts the association name as the key
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
assert post_titles(WfPost.joins(:author).where(author: {name: "bob"})) == ["by bob"]
assert post_titles(WfPost.joins(:author).where(author: {name: ["ann", "cy"]})) == ["by ann", "by cy"]

# it: mixes joined and own columns
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
relation = WfPost.joins(:author).where(published: true, wf_authors: {active: true, name: "cy"})
assert post_titles(relation) == ["by cy"]

# it: supports ranges, nil and enums like a flat hash
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
assert post_titles(WfPost.joins(:author).where(wf_authors: {id: 1_i64..})).size == 3
assert post_titles(WfPost.joins(:author).where(wf_authors: {name: nil})) == [] of String

# it: accepts the model's own table
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
assert post_titles(WfPost.where(wf_posts: {published: false})) == ["by bob"]

# it: works under or
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
relation = WfPost.joins(:author).where(title: "anonymous").or_where(wf_authors: {name: "bob"})
assert post_titles(relation) == ["by bob"]

# it: rejects an unknown table
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
error = WfPost.where(secrets: {name: "x"}).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/Unknown table/)

# it: rejects an unknown column on a known table
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
error = WfPost.joins(:author).where(wf_authors: {nonsense: 1}).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/Unknown query field/)

# it: rejects an identifier that is not a plain name
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
error = WfPost.joins(:author).where(wf_authors: {"name = 1 OR 1=1 OR x": 1}).select
assert error.is_a?(ArgumentError)

# it: requires the table to be joined by the time the SQL is built
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
error = WfPost.where(wf_authors: {active: true}).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/Unknown query table|Unknown query field/)

# it: matches the foreign key of one record
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
ann = WfAuthor.find_by_strict(name: "ann").or_panic
assert post_titles(WfPost.where(author: ann)) == ["by ann"]
assert WfPost.where(author: ann).to_sql.includes?("author_id")

# it: matches an array of records with IN
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
authors = WfAuthor.where(name: ["ann", "cy"]).order(:id).select.or_panic
assert post_titles(WfPost.where(author: authors)) == ["by ann", "by cy"]
relation = WfPost.where(author: authors)
assert relation.to_sql.includes?("IN")

# it: matches nil as an absent parent
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
assert post_titles(WfPost.where(author: nil)) == ["anonymous"]

# it: accepts a bare key
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
ann = WfAuthor.find_by_strict(name: "ann").or_panic
assert post_titles(WfPost.where(author: ann.id)) == ["by ann"]
assert post_titles(WfPost.where(author: [ann.id, nil])) == ["by ann", "anonymous"]

# it: matches an empty array to nothing
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
assert post_titles(WfPost.where(author: [] of WfAuthor)) == [] of String

# it: works with where.not, or and rewhere
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
ann = WfAuthor.find_by_strict(name: "ann").or_panic
bob = WfAuthor.find_by_strict(name: "bob").or_panic
assert post_titles(WfPost.where.not(author: ann, published: false)) == ["by ann", "by bob", "by cy", "anonymous"]
assert post_titles(WfPost.where(author: ann).or_where(author: bob)) == ["by ann", "by bob"]
assert post_titles(WfPost.where(author: ann).rewhere(author: bob)) == ["by bob"]

# it: does not load or query the records it is given
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
ann = WfAuthor.find_by_strict(name: "ann").or_panic
# The relation is built from the record's key alone.
relation = WfPost.where(author: ann)
assert !relation.to_sql.includes?("wf_authors")

# it: matches the id and the type column
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
post = WfPost.find_by_strict(title: "by ann").or_panic
video = WfVideo.create_strict(title: "clip").or_panic
WfComment.create_strict(body: "on post", commentable_id: post.id, commentable_type: WfPost.to_s).or_panic
WfComment.create_strict(body: "on video", commentable_id: video.id, commentable_type: WfVideo.to_s).or_panic

assert comment_bodies(WfComment.where(commentable: post)) == ["on post"]
assert comment_bodies(WfComment.where(commentable: video)) == ["on video"]
assert WfComment.where(commentable: post).to_sql.includes?("commentable_type")

# it: keeps records of different types apart even when their ids collide
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
post = WfPost.find_by_strict(title: "by ann").or_panic
WfVideo.clear.or_panic
video = WfVideo.new(title: "clip")
video.id = post.id
video.save_strict.or_panic
assert video.id == post.id
WfComment.create_strict(body: "on post", commentable_id: post.id, commentable_type: WfPost.to_s).or_panic
WfComment.create_strict(body: "on video", commentable_id: video.id, commentable_type: WfVideo.to_s).or_panic

assert comment_bodies(WfComment.where(commentable: video)) == ["on video"]
assert comment_bodies(WfComment.where(commentable: post)) == ["on post"]

# it: handles an array of mixed types
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
post = WfPost.find_by_strict(title: "by ann").or_panic
other_post = WfPost.find_by_strict(title: "by bob").or_panic
video = WfVideo.create_strict(title: "clip").or_panic
WfComment.create_strict(body: "on post", commentable_id: post.id, commentable_type: WfPost.to_s).or_panic
WfComment.create_strict(body: "on other post", commentable_id: other_post.id, commentable_type: WfPost.to_s).or_panic
WfComment.create_strict(body: "on video", commentable_id: video.id, commentable_type: WfVideo.to_s).or_panic
WfComment.create_strict(body: "loose").or_panic

mixed = [post.as(Base), video.as(Base)]
assert comment_bodies(WfComment.where(commentable: mixed)) == ["on post", "on video"]
assert comment_bodies(WfComment.where(commentable: [post, other_post])) == ["on post", "on other post"]

# it: matches nil to a missing target
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
WfComment.create_strict(body: "loose").or_panic
post = WfPost.find_by_strict(title: "by ann").or_panic
WfComment.create_strict(body: "on post", commentable_id: post.id, commentable_type: WfPost.to_s).or_panic
assert comment_bodies(WfComment.where(commentable: nil)) == ["loose"]

# it: requires records, not bare keys, so the type can be matched
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
error = WfComment.where(commentable: [1_i64, 2_i64]).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/polymorphic/)

# it: rejects a record under a name that is not an association
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
ann = WfAuthor.find_by_strict(name: "ann").or_panic
error = WfPost.where(nonsense: ann).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/not an association/)

# it: reads an array value as an IN list, as where(**args) does
    wf_clear_tables
    ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
    bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
    cy = WfAuthor.create_strict(name: "cy", active: true).or_panic

    WfPost.create_strict(title: "by ann", published: true, score: 1, author_id: ann.id).or_panic
    WfPost.create_strict(title: "by bob", published: false, score: 2, author_id: bob.id).or_panic
    WfPost.create_strict(title: "by cy", published: true, score: 3, author_id: cy.id).or_panic
    WfPost.create_strict(title: "anonymous", published: true, score: 4).or_panic
scores = ([1_i64, 3_i64] of Value).as(Bind)
matches = {"score" => scores} of String => Bind
assert post_titles(WfPost.where(matches)) == ["by ann", "by cy"]
assert post_titles(WfPost.where(title: "by bob").or_where(matches)) == ["by ann", "by bob", "by cy"]

WfPost.adapter.close.or_panic
