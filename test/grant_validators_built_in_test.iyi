module test/grant_validators_built_in_test
import grant/base::{Base}
import std/text
import std/regex

# Test models use the adapter selected by the current spec run. This keeps
# PostgreSQL parity evidence from silently exercising SQLite instead.
pub class NumericProduct < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table numeric_products

  column id : Int64, primary: true
  column price : Float64?
  column quantity : Int32?

  validates_numericality_of :price, greater_than: 0
  validates_numericality_of :quantity, only_integer: true
end

pub class NumericScore < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table numeric_scores

  column id : Int64, primary: true
  column even_score : Int32
  column odd_score : Int32

  validates_numericality_of :even_score, even: true
  validates_numericality_of :odd_score, odd: true
end

pub class ConditionalOrder < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table conditional_orders

  column id : Int64, primary: true
  column status : String
  column total : Float64?

  validates_numericality_of :total, greater_than: 0, if: :completed?

  def completed? : Bool
    status == "completed"
  end
end

pub class FormatUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table format_users

  column id : Int64, primary: true
  column username : String
  column phone : String

  validates_format_of :phone, with: /\A\d{3}-\d{3}-\d{4}\z/
  validates_format_of :username, without: /\A(admin|root|superuser)\z/, message: "is reserved"
end

pub class EmailContact < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table email_contacts

  column id : Int64, primary: true
  column email : String

  validates_email :email
end

pub class UrlLink < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table url_links

  column id : Int64, primary: true
  column url : String

  validates_url :url
end

pub class LengthPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table length_posts

  column id : Int64, primary: true
  column title : String
  column body : String

  validates_length_of :title, minimum: 3, maximum: 20
  validates_length_of :body, minimum: 10, allow_blank: true
end

pub class ExactLengthCode < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table exact_length_codes

  column id : Int64, primary: true
  column code : String

  validates_length_of :code, is: 4
end

pub class RangePassword < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table range_passwords

  column id : Int64, primary: true
  column password : String

  validates_length_of :password, in: 6..20
end

pub class ConfirmAccount < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table confirm_accounts

  column id : Int64, primary: true
  column email : String

  validates_confirmation_of :email
end

pub class AcceptanceSignup < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table acceptance_signups

  column id : Int64, primary: true

  validates_acceptance_of :terms_of_service
end

pub class InclusionSubscription < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table inclusion_subscriptions

  column id : Int64, primary: true
  column plan : String

  validates_inclusion_of :plan, in: ["basic", "premium", "enterprise"]
end

pub class ExclusionUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table exclusion_users

  column id : Int64, primary: true
  column username : String

  validates_exclusion_of :username, in: ["admin", "root", "superuser"]
end

pub class AssociatedOrder < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table associated_orders

  column id : Int64, primary: true
  column number : String

  has_many :items, class_name: AssociatedItem, foreign_key: :order_id

  validates_associated :items
end

pub class AssociatedItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table associated_items

  column id : Int64, primary: true
  column name : String
  column order_id : Int64?

  validate :name, "can't be blank" do |item|
    !item.name.to_s.strip.empty?
  end
end

pub class ComplexProfile < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table complex_profiles

  column id : Int64, primary: true
  column username : String
  column email : String
  column age : Int32
  column bio : String

  validates_length_of :username, minimum: 3
  validates_email :email
  validates_numericality_of :age, less_than: 120
  validates_length_of :bio, maximum: 500
end

# it: validates numeric values
product = NumericProduct.new(price: 10.5, quantity: 5)
assert product.valid?.or_panic

product.price = nil
assert !product.valid?.or_panic
assert product.errors.first.message == "is not a number"

# it: validates greater_than constraint
product = NumericProduct.new(price: 0.5, quantity: 5)
assert product.valid?.or_panic # 0.5 > 0

product.price = -1.0
assert !product.valid?.or_panic
assert product.errors.first.message.includes?("greater than 0")

product.price = 10.0
assert product.valid?.or_panic

# it: validates only_integer option
product = NumericProduct.new(price: 10.5, quantity: "5.5")
assert !product.valid?.or_panic
assert product.errors.map(&.message).includes?("must be an integer")

product.quantity = 5
assert product.valid?.or_panic

# it: validates even/odd options
score = NumericScore.new(even_score: 3, odd_score: 4)
assert !score.valid?.or_panic

score.even_score = 4
score.odd_score = 3
assert score.valid?.or_panic

# it: supports conditional validation
order = ConditionalOrder.new(status: "pending", total: nil)
assert order.valid?.or_panic # total not required when pending

order.status = "completed"
assert !order.valid?.or_panic # total required when completed
assert order.errors.first.message == "is not a number"

order.total = 100.0
assert order.valid?.or_panic

# it: validates with pattern
user = FormatUser.new(username: "john_doe", phone: "123")
assert !user.valid?.or_panic
assert user.errors.first.message.includes?("is invalid")

user.phone = "123-456-7890"
assert user.valid?.or_panic

# it: validates without pattern
user = FormatUser.new(username: "admin", phone: "123-456-7890")
assert !user.valid?.or_panic
assert user.errors.first.message.includes?("is reserved")

user.username = "john"
assert user.valid?.or_panic

# it: validates email format
contact = EmailContact.new(email: "invalid")
assert !contact.valid?.or_panic
assert contact.errors.first.message.includes?("is not a valid email")

contact.email = "user@example.com"
assert contact.valid?.or_panic

# it: validates URL format
link = UrlLink.new(url: "not-a-url")
assert !link.valid?.or_panic
assert link.errors.first.message.includes?("is not a valid URL")

link.url = "https://example.com"
assert link.valid?.or_panic

# it: validates minimum length
post = LengthPost.new(title: "Hi", body: "This is long enough body")
assert !post.valid?.or_panic
assert post.errors.first.message.includes?("minimum is 3 characters")

post.title = "Hello"
assert post.valid?.or_panic

# it: validates maximum length
post = LengthPost.new(title: "A very long title that exceeds maximum", body: "Long enough body text")
assert !post.valid?.or_panic
assert post.errors.first.message.includes?("maximum is 20 characters")

# it: validates exact length
code = ExactLengthCode.new(code: "ABC")
assert !code.valid?.or_panic
assert code.errors.first.message.includes?("should be 4 characters")

code.code = "ABCD"
assert code.valid?.or_panic

# it: validates length in range
password = RangePassword.new(password: "ab")
assert !password.valid?.or_panic

password.password = "abcdef"
assert password.valid?.or_panic

password.password = "a" * 21
assert !password.valid?.or_panic

# it: validates confirmation fields
account = ConfirmAccount.new(email: "user@example.com")
account.email_confirmation = "wrong@example.com"
assert !account.valid?.or_panic
assert account.errors.map(&.message).includes?("doesn't match confirmation")

account.email_confirmation = "user@example.com"
assert account.valid?.or_panic

# it: validates acceptance fields
signup = AcceptanceSignup.new
assert !signup.valid?.or_panic

signup.terms_of_service = "yes"
assert signup.valid?.or_panic

# it: validates value is in list
subscription = InclusionSubscription.new(plan: "basic")
assert subscription.valid?.or_panic

subscription.plan = "ultra"
assert !subscription.valid?.or_panic
assert subscription.errors.first.message.includes?("is not included in the list")

# it: validates value is not in list
user = ExclusionUser.new(username: "admin")
assert !user.valid?.or_panic
assert user.errors.first.message.includes?("is reserved")

user.username = "john"
assert user.valid?.or_panic

# it: validates associated records
order = AssociatedOrder.new(number: "A-1")
item = AssociatedItem.new(name: "")
order.set_loaded_association("items", [item.as(Base)])
assert !order.valid?.or_panic
assert order.errors.map(&.message).includes?("is invalid")

item.name = "Line item"
assert order.valid?.or_panic

# it: runs all validators and collects all errors
profile = ComplexProfile.new(
username: "ab",   # Too short
email: "invalid", # Invalid format
age: 150,         # Too high
bio: "a" * 501    # Too long
)

assert !profile.valid?.or_panic
assert profile.errors.size == 4

error_messages = profile.errors.map(&.message)
assert error_messages.includes?("is too short (minimum is 3 characters)")
assert error_messages.includes?("is not a valid email")
assert error_messages.includes?("must be less than 120")
assert error_messages.includes?("is too long (maximum is 500 characters)")

