module test/grant_schema_w6b_internal_metadata_wired_test

import grant/base::{Base}
import grant/schema/migration_context::{MigrationContext}
import grant/schema/migration::{InvalidMigration}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError, EnvironmentMismatchError}
import test/m03_fixture
import test/m03_fixture::{M03CreateUsers}
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class W6bGuardedRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_guarded_rows
  column id : Int64, primary: true
  column name : String?
end

private def w6b_context(environment : String?, protected_environments : Array(String) = InternalMetadata::DEFAULT_PROTECTED) : MigrationContext
  MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, verbose: false,
    environment: environment, protected_environments: protected_environments)
end

register_spec_connections
restore_default_spec_connections

# it: records the environment on migrate and checks it afterwards
::Test::M03Fixture.reset_in_place
context = w6b_context("development")
assert context.recorded_environment.or_panic.nil?
context.migrate.or_panic
assert context.recorded_environment.or_panic == "development"
context.check_protected_environments_strict.or_panic
error = w6b_context("test").check_protected_environments_strict
assert error.is_a?(EnvironmentMismatchError)
assert error.as(EnvironmentMismatchError).message.to_s.includes?("development")
w6b_context("test").check_protected_environments_strict(force: true).or_panic

# it: refuses a protected environment, recorded or only named
::Test::M03Fixture.reset_in_place
w6b_context("production").migrate.or_panic
error = w6b_context("production").check_protected_environments_strict
assert error.is_a?(ProtectedEnvironmentError)
assert error.as(ProtectedEnvironmentError).environment == "production"
assert w6b_context(nil).check_protected_environments_strict.is_a?(ProtectedEnvironmentError)
w6b_context(nil).check_protected_environments_strict(force: true).or_panic
w6b_context("production", protected_environments: ["prod"]).check_protected_environments_strict.or_panic

# it: protects a database that recorded nothing by the environment the context names
::Test::M03Fixture.reset_in_place
assert w6b_context("production").check_protected_environments_strict.is_a?(ProtectedEnvironmentError)
w6b_context("development").check_protected_environments_strict.or_panic
w6b_context(nil).check_protected_environments_strict.or_panic

# it: re-records the environment with set_environment!
::Test::M03Fixture.reset_in_place
w6b_context("development").migrate.or_panic
w6b_context("staging").set_environment_strict.or_panic
assert w6b_context("staging").recorded_environment.or_panic == "staging"
w6b_context("staging").check_protected_environments_strict.or_panic
assert w6b_context(nil).set_environment_strict.is_a?(InvalidMigration)

# it: blocks Model.migrator.drop_and_create on a database recorded as production
::Test::M03Fixture.reset_in_place
W6bGuardedRow.migrator.drop_and_create.or_panic
W6bGuardedRow.create(name: "kept")
InternalMetadata.new(::Test::M03Fixture.adapter).record_environment("production").or_panic
assert W6bGuardedRow.migrator.drop_and_create.is_a?(ProtectedEnvironmentError)
assert W6bGuardedRow.count.or_panic == 1
W6bGuardedRow.migrator.drop_and_create(force: true).or_panic
assert W6bGuardedRow.count.or_panic == 0

# it: lets drop_and_create run on development databases and checks a named environment
::Test::M03Fixture.reset_in_place
W6bGuardedRow.migrator.drop_and_create.or_panic
InternalMetadata.new(::Test::M03Fixture.adapter).record_environment("development").or_panic
W6bGuardedRow.migrator.drop_and_create.or_panic
W6bGuardedRow.migrator.drop_and_create(environment: "development").or_panic
assert W6bGuardedRow.migrator.drop_and_create(environment: "test").is_a?(EnvironmentMismatchError)

# it: has no effect without a metadata table
::Test::M03Fixture.reset_in_place
assert !::Test::M03Fixture.table?("ar_internal_metadata")
W6bGuardedRow.migrator.drop_and_create.or_panic
assert !::Test::M03Fixture.table?("ar_internal_metadata")
::Test::M03Fixture.reset_in_place
W6bGuardedRow.migrator.drop.or_panic
