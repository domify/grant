module test/grant_validations_validator_info_evaluation_test
import grant/base::{Base}
import grant/validator_info::{ValidatorInfo}
import test/v02_reflection_evaluation_counter
import test/validation_details_support::{same_details?}
import test/spec_helper::{register_spec_connections}

pub class V02rAccount < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v02r_accounts
  column id : Int64, primary: true
  column role : String?
  column score : Int32?

  ROLE_NAMES = ["owner", "member"]
  BANNED_NAMES = ["banned"]

  validates_inclusion_of :role, in: V02rAccount.allowed_roles
  validates_exclusion_of :role, in: BANNED_NAMES + ["root"]
  validates_numericality_of :score, in: 1..10, allow_nil: true

  def self.allowed_roles : Array(String)
    V02ReflectionEvaluationCounter.calls_to_allowed_roles += 1
    ROLE_NAMES
  end
end

register_spec_connections

# it: records a method call option as its source text without calling it
V02ReflectionEvaluationCounter.calls_to_allowed_roles = 0
inclusion = V02rAccount.validators_on(:role).find { |info| info.kind == :inclusion }.as(ValidatorInfo)
assert inclusion.option(:in) == "V02rAccount.allowed_roles"
assert V02ReflectionEvaluationCounter.calls_to_allowed_roles == 0

# it: records any other non-literal expression as its source text
exclusion = V02rAccount.validators_on(:role).find { |info| info.kind == :exclusion }.as(ValidatorInfo)
assert exclusion.option(:in) == "BANNED_NAMES + [\"root\"]"

# it: keeps literal ranges as data
numericality = V02rAccount.validators_on(:score).first
assert same_details?({:in => numericality.option(:in)}, {:in => (1..10)})

# it: still evaluates the option on every validation
V02ReflectionEvaluationCounter.calls_to_allowed_roles = 0
assert V02rAccount.new(role: "owner").valid?.or_panic
assert !V02rAccount.new(role: "guest").valid?.or_panic
assert V02ReflectionEvaluationCounter.calls_to_allowed_roles == 2
