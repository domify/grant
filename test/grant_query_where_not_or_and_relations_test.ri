module test/grant_query_where_not_or_and_relations_test

import std/regex
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class WfAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_authors
  column id : Int64, primary: true
  column name : String?
  column active : Bool?
  has_many :posts, class_name: WfPost, foreign_key: author_id
end

pub class WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts
  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?
  belongs_to author : WfAuthor, foreign_key: author_id : Int64?, optional: true
end

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map { |post| post.title.to_s }
end

private def reset : Nil
  WfPost.clear.or_panic
  WfAuthor.clear.or_panic
  WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  WfPost.create_strict(title: "d", published: true, score: nil).or_panic
  nil
end

register_spec_connections
WfAuthor.migrator.drop_and_create.or_panic
WfPost.migrator.drop_and_create.or_panic


# it: ORs the two relations' conditions
reset
relation = WfPost.where(title: "a").or_where(WfPost.where(title: "c"))
assert titles(relation) == ["a", "c"]
assert relation.to_sql.includes?("OR")

# it: parenthesizes each side
reset
relation = WfPost.where(published: true, score: 1).or_where(WfPost.where(published: false, score: 2))
assert titles(relation) == ["a", "b"]
relation = WfPost.where(published: true, score: 3).or_where(WfPost.where(title: "b"))
assert titles(relation) == ["b", "c"]

# it: keeps a condition ANDed afterwards outside the OR
reset
relation = WfPost.where(title: "a").or_where(WfPost.where(title: "b")).where(published: true)
assert titles(relation) == ["a"]

# it: keeps bind order across the OR (numbered on PG)
reset
relation = WfPost.where(title: "a", score: 1).or_where(WfPost.where(title: ["b", "c"], published: false)).where(score: 1..2)
assert titles(relation) == ["a", "b"]
relation = WfPost.where("score = :x", x: 1).or_where(WfPost.where("score = :y AND title = :z", y: 3, z: "c"))
assert titles(relation) == ["a", "c"]

# it: chains
reset
relation = WfPost.where(title: "a").or_where(WfPost.where(title: "b")).or_where(WfPost.where(title: "d"))
assert titles(relation) == ["a", "b", "d"]

# it: is unconstrained when either side has no conditions
reset
assert titles(WfPost.where(title: "a").or_where(WfPost.all)).size == 4
assert titles(WfPost.all.or_where(WfPost.where(title: "a"))).size == 4

# it: accepts relations built from the same joins, ordering and limit
reset
left = WfPost.joins(:author).where(title: "a").order(:id).limit(3)
right = WfPost.joins(:author).where(title: "b").order(:id).limit(3)
assert left.or_where(right).to_sql.includes?("OR")

# it: raises ArgumentError naming what differs
reset
error = WfPost.where(title: "a").or_where(WfPost.joins(:author).where(title: "b")).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/structurally compatible.*\[:joins\]/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").limit(1)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/\[:limit\]/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").order(:id)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/:order/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").offset(1)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/:offset/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").distinct).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/:distinct/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").group_by(:title)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/:group/)
error = WfPost.where(title: "a").or_where(WfPost.where(title: "b").includes(:author)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/:includes/)

# it: leaves both relations untouched
reset
left = WfPost.where(title: "a")
right = WfPost.where(title: "b")
left.or_where(right)
assert titles(left) == ["a"]
assert titles(right) == ["b"]

# it: still supports the keyword, string and block forms
reset
assert titles(WfPost.where(title: "a").or_where(title: "b")) == ["a", "b"]
assert titles(WfPost.where(title: "a").or_where("title = ?", "c")) == ["a", "c"]
assert titles(WfPost.where(title: "a").or_where(&.where(title: "d"))) == ["a", "d"]

# it: ANDs the two relations' conditions
reset
relation = WfPost.where(published: true).and_where(WfPost.where(score: 1..2))
assert titles(relation) == ["a"]

# it: keeps both conditions on the same column
reset
relation = WfPost.where(score: 1..3).and_where(WfPost.where(score: 2..4))
assert titles(relation) == ["b", "c"]

# it: groups an OR on the other side
reset
other = WfPost.where(title: "a").or_where(WfPost.where(title: "b"))
assert titles(WfPost.where(published: true).and_where(other)) == ["a"]

# it: groups an OR on the receiver
reset
receiver = WfPost.where(title: "a").or_where(WfPost.where(title: "b"))
assert titles(receiver.and_where(WfPost.where(published: false))) == ["b"]

# it: does nothing for an empty relation
reset
assert titles(WfPost.where(title: "a").and_where(WfPost.all)) == ["a"]

# it: raises ArgumentError for incompatible relations
reset
error = WfPost.where(title: "a").and_where(WfPost.joins(:author).where(title: "b")).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/structurally compatible.*\[:joins\]/)
error = WfPost.where(title: "a").and_where(WfPost.where(title: "b").limit(2)).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.matches?(/\[:limit\]/)

# it: keeps the keyword and string forms
reset
assert titles(WfPost.where(published: true).and_where(score: 3)) == ["c"]
assert titles(WfPost.where(published: true).and_where("score = ?", 1)) == ["a"]

WfPost.adapter.close.or_panic
