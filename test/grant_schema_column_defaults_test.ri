module test/grant_schema_column_defaults_test

import grant/base::{Base}
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/table_definition::{TableDefinition}
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/schema::{Dialect, InvalidDefinition}
import std/time::{Time}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

pub class M02aDefaultRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_default_rows
  column id : Int64, primary: true
  column token : String?, default_sql: "lower('ABC')"
  column total : Int32?, default_sql: "1 + 2"
  column stamped : Time?, default_sql: "CURRENT_TIMESTAMP"
  column role : String? = "member"
end

# it: emits expressions the way each database needs them
build = ->(dialect : Dialect) do
  RecordingStatements.new(dialect).create_table_statements(:m02a_expr, id: false) do |t|
    t.datetime(:created_at, default_sql: "CURRENT_TIMESTAMP")
    t.string(:token, default_sql: "lower('X')")
    t.integer(:n, default: 5)
    t.string(:role, default: "it's")
    t.boolean(:on, default: false)
    t.string(:nothing, default: nil)
  end.or_panic.first
end
pg = build.call(Dialect::Pg)
assert pg.includes?("\"created_at\" TIMESTAMP(6) DEFAULT CURRENT_TIMESTAMP")
assert pg.includes?("\"token\" VARCHAR DEFAULT lower('X')")
assert pg.includes?("\"n\" INTEGER DEFAULT 5")
assert pg.includes?("\"role\" VARCHAR DEFAULT 'it''s'")
assert pg.includes?("\"on\" BOOLEAN DEFAULT FALSE")
assert pg.includes?("\"nothing\" VARCHAR DEFAULT NULL")
my = build.call(Dialect::Mysql)
assert my.includes?("`created_at` DATETIME(6) DEFAULT CURRENT_TIMESTAMP")
assert my.includes?("`token` VARCHAR(255) DEFAULT (lower('X'))")
lite = build.call(Dialect::Sqlite)
assert lite.includes?("\"created_at\" DATETIME DEFAULT CURRENT_TIMESTAMP")
assert lite.includes?("\"token\" VARCHAR(255) DEFAULT (lower('X'))")

# Supplemental expression-parenthesis checks.
dialect = Dialect::Mysql
assert dialect.default_expression("CURRENT_TIMESTAMP(6)") == "CURRENT_TIMESTAMP(6)"
assert dialect.default_expression("(uuid())") == "(uuid())"
assert Dialect::Pg.default_expression("gen_random_uuid()") == "gen_random_uuid()"

# it: emits the statement for PostgreSQL and MySQL
pg = RecordingStatements.new(Dialect::Pg)
assert pg.change_column_default_statements(:users, :role, from: nil, to: "member").or_panic == ["ALTER TABLE \"users\" ALTER COLUMN \"role\" SET DEFAULT 'member'"]
assert pg.change_column_default_statements(:users, :role, to: nil).or_panic == ["ALTER TABLE \"users\" ALTER COLUMN \"role\" DROP DEFAULT"]
assert pg.change_column_default_statements(:users, :at, default_sql: "now()").or_panic == ["ALTER TABLE \"users\" ALTER COLUMN \"at\" SET DEFAULT now()"]
my = RecordingStatements.new(Dialect::Mysql)
assert my.change_column_default_statements(:users, :role, to: 3).or_panic == ["ALTER TABLE `users` ALTER COLUMN `role` SET DEFAULT 3"]
assert my.change_column_default_statements(:users, :at, default_sql: "lower('A')").or_panic == ["ALTER TABLE `users` ALTER COLUMN `at` SET DEFAULT (lower('A'))"]

# it: needs a target, on SQLite too
assert RecordingStatements.new(Dialect::Pg).change_column_default_statements(:users, :role).is_a?(InvalidDefinition)
assert RecordingStatements.new(Dialect::Sqlite).change_column_default_statements(:users, :role).is_a?(InvalidDefinition)

register_spec_connections
restore_default_spec_connections

# it: emits default_sql and literal defaults from a model
M02aDefaultRow.migrator.drop_and_create.or_panic
sql = M02aDefaultRow.migrator.create_sql
assert sql.includes?("DEFAULT 'member'")
case CURRENT_ADAPTER
when "pg"
  assert sql.includes?("DEFAULT lower('ABC')")
  assert sql.includes?("DEFAULT 1 + 2")
else
  assert sql.includes?("DEFAULT (lower('ABC'))")
  assert sql.includes?("DEFAULT (1 + 2)")
end
assert sql.includes?("DEFAULT CURRENT_TIMESTAMP")

# it: applies the SQL defaults in the database
M02aDefaultRow.migrator.drop_and_create.or_panic
insert = CURRENT_ADAPTER == "mysql" ? "INSERT INTO m02a_default_rows () VALUES ()" : "INSERT INTO m02a_default_rows DEFAULT VALUES"
M02aDefaultRow.exec(insert).or_panic
row = M02aDefaultRow.first_strict.or_panic
assert row.token == "abc"
assert row.total == 3
assert row.role == "member"
assert !row.stamped.nil?

# it: changes a default in place, or says why it cannot
M02aDefaultRow.migrator.drop_and_create.or_panic
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
statements.change_column_default(:m02a_default_rows, :role, from: "member", to: "admin").or_panic
insert = CURRENT_ADAPTER == "mysql" ? "INSERT INTO m02a_default_rows () VALUES ()" : "INSERT INTO m02a_default_rows DEFAULT VALUES"
M02aDefaultRow.exec(insert).or_panic
assert M02aDefaultRow.first_strict.or_panic.role == "admin"
statements.change_column_default(:m02a_default_rows, :role, to: nil).or_panic
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_default_rows).or_panic.find { |column| column.name == "role" }.as(ColumnInfo).default.nil?
statements.change_column_default(:m02a_default_rows, :total, default_sql: "2 * 5").or_panic
M02aDefaultRow.exec(insert).or_panic
assert M02aDefaultRow.order(id: :desc).first_strict.or_panic.total == 10
M02aDefaultRow.migrator.drop.or_panic
