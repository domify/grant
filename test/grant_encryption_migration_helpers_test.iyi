module test/grant_encryption_migration_helpers_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/migration_helpers
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/cipher::{DecryptionError}
import grant/error::{ArgumentError}
import grant/events::{SQL}
import grant/notifications
import std/base64::{Base64}
import test/spec_helper::{register_spec_connections}

pub class MigEncTransparent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table mig_enc_transparents
  column id : Int64, primary: true
  column name : String?
  encrypts ssn : String, deterministic: true
end

pub class MigEncLegacy < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table mig_enc_legacies
  column id : Int64, primary: true
  column name : String?
  encrypts :ssn
end

private def mig_enc_exec(sql : String) : Nil
  MigEncTransparent.adapter.open { |db| db.exec(sql) }.or_panic
  nil
end

private def mig_enc_reset : Nil
  MigEncTransparent.migrator.drop_and_create.or_panic
  MigEncLegacy.migrator.drop_and_create.or_panic
  mig_enc_exec("ALTER TABLE mig_enc_legacies ADD COLUMN ssn TEXT")
end

private def mig_enc_raw(table : String, column : String) : Array(String?)
  MigEncTransparent.adapter.open do |db|
    db.query("SELECT #{column} FROM #{table} ORDER BY id")
  end.or_panic.map { |row| row[column].as(String?) }
end

private def mig_enc_capture(&block : -> T) : Array(String) forall T
  statements = [] of String
  handler = ->(event : SQL) { statements << event.sql; nil }
  Grant::Notifications.subscribed(SQL, handler) { yield }
  statements
end

register_spec_connections
Grant::Encryption.configure do |config|
  (config.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
  (config.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
  config.key_derivation_salt = "migration-helpers-salt"
end

# it: encrypts plaintext in place for a transparent attribute, in keyset batches
mig_enc_reset
25.times { |i| mig_enc_exec("INSERT INTO mig_enc_transparents (name, ssn) VALUES ('n#{i}', '000-00-#{1000 + i}')") }
mig_enc_exec("INSERT INTO mig_enc_transparents (name, ssn) VALUES ('nil ssn', NULL)")
entries = mig_enc_capture do
  assert Grant::Encryption::MigrationHelpers.encrypt_column(MigEncTransparent, :ssn, batch_size: 7, progress: false).or_panic == 26
end
raw = mig_enc_raw("mig_enc_transparents", "ssn")
assert raw.compact.size == 25
raw.compact.each { |value| assert !value.starts_with?("000-00-") }
assert MigEncTransparent.order(id: :asc).select.or_panic.compact_map(&.ssn).first == "000-00-1000"
assert MigEncTransparent.where(ssn: "000-00-1005").count.or_panic == 1
selects = entries.select { |entry| entry.includes?("SELECT") && entry.includes?("ORDER BY") && !entry.includes?("COUNT") }
assert selects.size == 4
assert entries.none? { |entry| entry.includes?("OFFSET") }
selects.each_with_index { |entry, i| assert entry.includes?("> ") if i > 0 }
assert entries.count { |entry| entry.starts_with?("UPDATE") } == 4

# it: is idempotent: a second run leaves ciphertext untouched
mig_enc_reset
3.times { |i| mig_enc_exec("INSERT INTO mig_enc_transparents (name, ssn) VALUES ('n#{i}', 'plain-#{i}')") }
Grant::Encryption::MigrationHelpers.encrypt_column(MigEncTransparent, :ssn, batch_size: 2, progress: false).or_panic
first = mig_enc_raw("mig_enc_transparents", "ssn")
Grant::Encryption::MigrationHelpers.encrypt_column(MigEncTransparent, :ssn, batch_size: 2, progress: false).or_panic
assert mig_enc_raw("mig_enc_transparents", "ssn") == first

# it: writes ciphertext to <attr>_encrypted from a plaintext source column
mig_enc_reset
4.times { |i| mig_enc_exec("INSERT INTO mig_enc_legacies (name, ssn) VALUES ('n#{i}', 'legacy-#{i}')") }
assert Grant::Encryption::MigrationHelpers.encrypt_column(MigEncLegacy, :ssn, batch_size: 3, progress: false).or_panic == 4
mig_enc_raw("mig_enc_legacies", "ssn_encrypted").compact.each { |value| assert !value.includes?("legacy-") }
assert MigEncLegacy.order(id: :asc).select.or_panic.map { |row| row.ssn.or_panic } == ["legacy-0", "legacy-1", "legacy-2", "legacy-3"]

# it: rejects attributes that are not encrypted
mig_enc_reset
assert Grant::Encryption::MigrationHelpers.encrypt_column(MigEncLegacy, :name, progress: false).is_a?(ArgumentError)

# it: restores plaintext in the same column for a transparent attribute and skips plaintext rows
mig_enc_reset
3.times { |i| MigEncTransparent.create_strict(name: "n#{i}", ssn: "secret-#{i}").or_panic }
mig_enc_exec("INSERT INTO mig_enc_transparents (name, ssn) VALUES ('already plain', 'plain-row')")
assert Grant::Encryption::MigrationHelpers.decrypt_column(MigEncTransparent, :ssn, batch_size: 2, progress: false).or_panic == 3
assert mig_enc_raw("mig_enc_transparents", "ssn") == ["secret-0", "secret-1", "secret-2", "plain-row"]
assert Grant::Encryption::MigrationHelpers.decrypt_column(MigEncTransparent, :ssn, batch_size: 2, progress: false).or_panic == 0

# it: writes plaintext to a target column for the <attr>_encrypted form
mig_enc_reset
2.times { |i| MigEncLegacy.create_strict(name: "n#{i}", ssn: "kept-#{i}").or_panic }
assert Grant::Encryption::MigrationHelpers.decrypt_column(MigEncLegacy, :ssn, target_column: :ssn, batch_size: 1, progress: false).or_panic == 2
assert mig_enc_raw("mig_enc_legacies", "ssn") == ["kept-0", "kept-1"]

# it: re-encrypts a transparent attribute written under other keys
mig_enc_reset
old_primary = Base64.encode("old_primary_key_32_bytes_long!!!")
old_determ = Base64.encode("old_determ_key_32_bytes_long!!!!")
Grant::Encryption.with_context(primary_key: old_primary, deterministic_key: old_determ) do
  5.times { |i| MigEncTransparent.create_strict(name: "n#{i}", ssn: "rot-#{i}").or_panic }
end.or_panic
assert MigEncTransparent.all.select.is_a?(DecryptionError)
assert Grant::Encryption::MigrationHelpers.rotate_encryption(MigEncTransparent, :ssn, old_keys: {primary: old_primary, deterministic: old_determ}, batch_size: 2, progress: false).or_panic == 5
assert MigEncTransparent.order(id: :asc).select.or_panic.map(&.ssn) == (0...5).map { |i| "rot-#{i}" }
assert MigEncTransparent.where(ssn: "rot-3").count.or_panic == 1

# it: describes a transparent column and the data migration
mig_enc_reset
text = Grant::Encryption::MigrationHelpers.generate_migration(MigEncTransparent, :ssn).or_panic
assert text.includes?("alter_table :mig_enc_transparents")
assert text.includes?("change_column :ssn, :text")
assert text.includes?("add_index :ssn")
assert text.includes?("Grant::Encryption::MigrationHelpers.encrypt_column(")
assert text.includes?("MigEncTransparent")

# it: describes the extra column of the <attr>_encrypted form, without an index when not deterministic
mig_enc_reset
text = Grant::Encryption::MigrationHelpers.generate_migration(MigEncLegacy, :ssn).or_panic
assert text.includes?("add_column :ssn_encrypted, :text")
assert !text.includes?("add_index")
assert text.includes?("drop_column :ssn")

# it: rejects attributes that are not encrypted
mig_enc_reset
assert Grant::Encryption::MigrationHelpers.generate_migration(MigEncLegacy, :name).is_a?(ArgumentError)

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
