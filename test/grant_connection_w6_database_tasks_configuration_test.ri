module test/grant_connection_w6_database_tasks_configuration_test
import grant/database_configurations::{DatabaseConfigurations, DatabaseConfigurationError}
import grant/tasks/database::{Database}
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import test/w6_c04_support::{W6C04}
import std/file::{File}
import std/dir::{Dir}

def w6_env(values : Hash(String, String) = {} of String => String) : Proc(String, String?)
  ->(key : String) { values[key]? }
end

def w6_adapter_key : String
  W6C04.pg? ? "postgres" : "sqlite3"
end

    yaml = <<-YAML
      test:
        primary:
          url: #{W6C04.url("tasks_primary")}
        primary_replica:
          url: #{W6C04.url("tasks_primary")}
          replica: true
        reports:
          url: #{W6C04.url("tasks_reports")}
          database_tasks: false
      YAML


# it: leaves replicas and database_tasks: false databases out of the task list
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic

assert configurations.task_configs.map(&.name) == ["primary"]
assert configurations.configs_for(env: "test").map(&.name) == ["primary", "primary_replica", "reports"]
assert Database.for_configurations(configurations).map(&.name) == ["primary"]

# it: creates and drops a database whose tasks are enabled
W6C04.drop("tasks_primary")
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic
tasks = Database.for_config(configurations.db_config("primary").or_panic)

assert tasks.database_tasks?
assert tasks.create.or_panic
assert tasks.exists?.or_panic
assert tasks.drop(force: true).or_panic
assert !tasks.exists?.or_panic

# it: reads the two-tier form as the primary database
yaml = <<-YAML
  test:
    adapter: #{w6_adapter_key}
    url: #{W6C04.url("tasks_single")}
    pool: 7
  production:
    adapter: #{w6_adapter_key}
    url: #{W6C04.url("tasks_single_prod")}
  YAML
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic

assert configurations.configs_for(env: "test").map(&.name) == ["primary"]
primary = configurations.db_config("primary").or_panic
assert primary.url == W6C04.url("tasks_single")
assert primary.pool_size == 7
assert primary.adapter.or_panic.to_s == (W6C04.pg? ? Pg.to_s : Sqlite.to_s)
assert configurations.db_config("primary", "production").or_panic.url == W6C04.url("tasks_single_prod")

# it: honors database_tasks: false in the two-tier form
yaml = <<-YAML
  test:
    adapter: #{w6_adapter_key}
    url: #{W6C04.url("tasks_single_off")}
    database_tasks: false
  YAML
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic

assert !configurations.db_config("primary").or_panic.database_tasks?
assert configurations.task_configs.empty?
assert Database.for_configurations(configurations).empty?

# it: applies DATABASE_URL to the single database
yaml = <<-YAML
  test:
    adapter: #{w6_adapter_key}
    url: #{W6C04.url("tasks_single")}
  YAML
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env({"DATABASE_URL" => W6C04.url("tasks_from_env")})).or_panic

assert configurations.db_config("primary").or_panic.url == W6C04.url("tasks_from_env")

# it: reads a SQLite file named by database:
yaml = <<-YAML
  test:
    adapter: sqlite3
    database: ./db/test.sqlite3
  YAML
configurations = DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic

assert configurations.db_config("primary").or_panic.url == "sqlite3:./db/test.sqlite3"

# it: runs the tasks of the single database
W6C04.drop("tasks_single_run")
yaml = <<-YAML
  test:
    adapter: #{w6_adapter_key}
    url: #{W6C04.url("tasks_single_run")}
  YAML
tasks = Database.for_configurations(DatabaseConfigurations.parse(yaml, "test", w6_env).or_panic).first

assert tasks.create.or_panic
assert tasks.exists?.or_panic
assert tasks.drop(force: true).or_panic

# it: still rejects a file that is not a mapping of environments
error = DatabaseConfigurations.parse("- one\n- two\n", "test", w6_env)
assert error.is_a?(DatabaseConfigurationError)
error = DatabaseConfigurations.parse("test: nope\n", "test", w6_env)
assert error.is_a?(DatabaseConfigurationError)

W6C04.cleanup
