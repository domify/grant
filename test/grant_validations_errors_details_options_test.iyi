module test/grant_validations_errors_details_options_test
import grant/base::{Base}
import grant/errors::{Errors}
import grant/error
import test/validation_details_support::{same_details?}
import test/spec_helper::{register_spec_connections}

register_spec_connections


pub class V02dTicket < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v02d_tickets

  column id : Int64, primary: true
  column code : String?
  column short_code : String?
  column long_code : String?
  column exact_code : String?
  column score : Int32?

  validates_length_of :code, minimum: 4
  validates_length_of :short_code, maximum: 2
  validates_length_of :long_code, is: 6
  validates_numericality_of :score, greater_than: 0, allow_nil: true
  validates_presence_of :exact_code
end

begin
  # it: carries count: for length validators
  begin
    ticket = V02dTicket.new(code: "ab", short_code: "abcd", long_code: "abc", exact_code: "x")
    assert !ticket.valid?.or_panic
    assert same_details?(ticket.errors.details["code"], [{:error => :too_short, :count => 4}])
    assert same_details?(ticket.errors.details["short_code"], [{:error => :too_long, :count => 2}])
    assert same_details?(ticket.errors.details["long_code"], [{:error => :wrong_length, :count => 6}])
  end

  # it: carries count: and value: for numericality

  begin
    ticket = V02dTicket.new(code: "abcd", short_code: "a", long_code: "abcdef", exact_code: "x", score: -3)
    assert !ticket.valid?.or_panic
    assert same_details?(ticket.errors.details["score"], [{:error => :greater_than, :count => 0, :value => -3}])
  end

  # it: has no options for a plain presence failure

  begin
    ticket = V02dTicket.new(code: "abcd", short_code: "a", long_code: "abcdef", exact_code: nil)
    assert !ticket.valid?.or_panic
    assert same_details?(ticket.errors.details["exact_code"], [{:error => :blank}])
  end

  # it: merges the options given to errors.add into the detail

  begin
    errors = Errors.new
    errors.add(:age, "too low", type: :greater_than, count: 18, value: 3)
    assert same_details?(errors.details["age"], [{:error => :greater_than, :count => 18, :value => 3}])
    assert errors.first.options[:count] == 18
    assert same_details?(errors.first.detail, {:error => :greater_than, :count => 18, :value => 3})
  end

  # it: falls back to :invalid and stores options of many types

  begin
    errors = Errors.new
    errors.add(:name, "odd", flag: true, ratio: 1.5, names: ["a", "b"], range: 1..3)
    assert same_details?(errors.details["name"], [{:error => :invalid, :flag => true, :ratio => 1.5, :names => ["a", "b"], :range => (1..3)}])
  end

  # it: builds details lazily and does not share hashes between calls

  begin
    errors = Errors.new
    errors.add(:name, :too_short, count: 3)
    first = errors.details
    first["name"].first[:count] = 99
    assert errors.details["name"].first[:count] == 3
  end

  # it: keeps details keyed by attribute name Strings

  begin
    errors = Errors.new
    errors.add(:name, :blank)
    assert errors.details.keys == ["name"]
  end
end
