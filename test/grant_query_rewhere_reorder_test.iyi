module test/grant_query_rewhere_reorder_test

import grant/base::{Base}
import grant/query/builder::{Builder}
import test/spec_helper::{register_spec_connections}

pub class WfAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_authors
  column id : Int64, primary: true
  column name : String?
  column active : Bool?
  has_many :posts, class_name: WfPost, foreign_key: author_id
end

pub class WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts
  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?
  belongs_to author : WfAuthor, foreign_key: author_id : Int64?, optional: true
end

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.select.or_panic.map { |post| post.title.to_s }
end

private def reset : Nil
  WfPost.clear.or_panic
  WfAuthor.clear.or_panic
  WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  nil
end

register_spec_connections
WfAuthor.migrator.drop_and_create.or_panic
WfPost.migrator.drop_and_create.or_panic

# it: replaces the conditions on its own columns and keeps the others
reset
relation = WfPost.where(published: true, score: 3).rewhere(published: false)
assert relation.to_sql.split("WHERE").last.includes?("score")
assert titles(relation) == [] of String
assert titles(WfPost.where(published: true, score: 2).rewhere(published: false)) == ["b"]

# it: replaces every kind of condition on the column
reset
assert titles(WfPost.where(score: 1..2).where(published: true).rewhere(score: 3)) == ["c"]
assert titles(WfPost.where(score: [1, 2]).rewhere(score: 3)) == ["c"]

# it: replaces nil-aware lists, arrays holding ranges and record lists
reset
assert titles(WfPost.where(score: [1, nil]).rewhere(score: 3)) == ["c"]
assert titles(WfPost.where(score: [1, 3..4]).rewhere(score: 2)) == ["b"]
ann = WfAuthor.create_strict(name: "ann").or_panic
bob = WfAuthor.create_strict(name: "bob").or_panic
cy = WfAuthor.create_strict(name: "cy").or_panic
WfPost.create_strict(title: "by cy", author_id: cy.id).or_panic
assert titles(WfPost.where(author: [ann, bob]).rewhere(author: cy)) == ["by cy"]
assert titles(WfPost.where(author: [ann, nil]).rewhere(author: cy)) == ["by cy"]

# it: keeps a copied relation's list conditions apart from the receiver's
reset
base = WfPost.where(published: true)
with_list = base.where(score: [3, nil])
base.where(score: [1, nil]).rewhere(score: 2)
assert titles(with_list.rewhere(score: 1)) == ["a"]
assert titles(base).sorted == ["a", "c"]

# it: behaves like where for a column with no condition yet
reset
assert titles(WfPost.where(published: true).rewhere(score: 3)) == ["c"]

# it: takes a hash
reset
assert titles(WfPost.where(published: true, score: 2).rewhere({published: false})) == ["b"]

# it: leaves the receiver untouched
reset
base = WfPost.where(published: true)
base.rewhere(published: false)
assert titles(base) == ["a", "c"]

# it: replaces the order
reset
assert titles(WfPost.order(score: :asc).reorder(score: :desc)) == ["c", "b", "a"]
assert titles(WfPost.order(score: :desc).reorder(:score)) == ["a", "b", "c"]

# it: takes several symbols
reset
relation = WfPost.order(score: :desc).reorder(:published, :score)
assert relation.to_sql.includes?("ORDER BY published ASC, score ASC")
assert titles(relation) == ["b", "a", "c"]

# it: takes an array
reset
assert titles(WfPost.order(score: :desc).reorder([:published, :score])) == ["b", "a", "c"]

# it: clears the order with nil
reset
relation = WfPost.order(score: :desc).reorder(nil)
assert !relation.to_sql.includes?("score DESC")
assert relation.order_fields.empty?

# it: does not touch the receiver
reset
base = WfPost.order(score: :desc)
base.reorder(nil)
assert titles(base) == ["c", "b", "a"]

# it: flips an explicit order
reset
assert titles(WfPost.order(score: :asc).reverse_order) == ["c", "b", "a"]

# it: reverses the primary key order of an unordered relation
reset
relation = WfPost.all.reverse_order
assert relation.to_sql.includes?("ORDER BY id DESC")
assert titles(relation) == ["c", "b", "a"]
assert titles(WfPost.where(published: true).reverse_order) == ["c", "a"]

# it: is its own inverse
reset
assert titles(WfPost.all.reverse_order.reverse_order) == ["a", "b", "c"]

# it: still lets first and last work
reset
assert WfPost.all.reverse_order.first_strict.or_panic.title == "c"
assert WfPost.order(:score).last_strict.or_panic.title == "c"

# it: reselect replaces the projection
reset
assert WfPost.select(:id, :title).reselect(:id, :score).to_sql.includes?("SELECT id, score FROM")

# it: regroup replaces the grouping
reset
assert WfPost.group_by(:published).regroup(:score).to_sql.includes?("GROUP BY score")

WfPost.adapter.close.or_panic
