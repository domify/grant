module test/grant_encryption_options_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/compression
import std/base64::{Base64}
import test/spec_helper::{register_spec_connections}
pub class OptionsEncCaseUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table options_enc_case_users

  column id : Int64, primary: true
  encrypts email : String, deterministic: true, ignore_case: true
  encrypts login : String, deterministic: true, downcase: true
end

pub class OptionsEncBodyDoc < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table options_enc_body_docs

  column id : Int64, primary: true
  encrypts packed : String, compress: true
  encrypts loose : String
  encrypts small_threshold : String, compress: true, compress_threshold: 10
end


private def options_enc_raw(table : String, column : String, id) : String?
  OptionsEncCaseUser.adapter.open do |db|
    db.scalar("SELECT #{column} FROM #{table} WHERE id = #{id}")
  end.or_panic.as(String?)
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "options-salt"
register_spec_connections
OptionsEncCaseUser.migrator.drop_and_create.or_panic
OptionsEncBodyDoc.migrator.drop_and_create.or_panic

# it: matches regardless of case while returning the original
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
user = OptionsEncCaseUser.create_strict(email: "Ada@Example.COM").or_panic

assert user.email == "Ada@Example.COM"
found = OptionsEncCaseUser.find_strict(user.id.as(Int64)).or_panic
assert found.email == "Ada@Example.COM"

{"ada@example.com", "ADA@EXAMPLE.COM", "Ada@Example.COM"}.each do |spelling|
  assert OptionsEncCaseUser.where(email: spelling).select.or_panic.map(&.id) == [user.id]
end
assert OptionsEncCaseUser.find_by_email("aDa@eXample.com").or_panic.as(OptionsEncCaseUser).id == user.id

# it: stores the lower-cased value in the column and the original in original_<attr>
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
user = OptionsEncCaseUser.create_strict(email: "Ada@Example.COM").or_panic
searchable = options_enc_raw("options_enc_case_users", "email", user.id).as(String)
original = options_enc_raw("options_enc_case_users", "original_email", user.id).as(String)

assert searchable == OptionsEncCaseUser.email_encrypted_attribute.seal("ada@example.com").or_panic
assert original != searchable
assert OptionsEncCaseUser.original_email_encrypted_attribute.open(original).or_panic == "Ada@Example.COM"
assert !searchable.includes?("Ada")

# it: updates the original case together with the searchable value
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
user = OptionsEncCaseUser.create_strict(email: "Ada@Example.COM").or_panic
user.email = "ADA@example.org"
user.save_strict.or_panic

reloaded = OptionsEncCaseUser.find_strict(user.id.as(Int64)).or_panic
assert reloaded.email == "ADA@example.org"
assert OptionsEncCaseUser.where(email: "ada@example.com").count.or_panic == 0
assert OptionsEncCaseUser.where(email: "Ada@Example.ORG").count.or_panic == 1

# it: is rejected without deterministic: true
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
# Compile-time check: `encrypts x : String, ignore_case: true` raises in the
# macro, so the runtime contract is the attribute's own flags.
assert OptionsEncCaseUser.email_encrypted_attribute.deterministic
assert OptionsEncCaseUser.email_encrypted_attribute.options.ignore_case?

# it: stores and returns the lower-cased value and queries case-insensitively
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
user = OptionsEncCaseUser.create_strict(email: "x@y.z", login: "MiXeD_Login").or_panic

assert user.login == "mixed_login"
assert OptionsEncCaseUser.find_strict(user.id.as(Int64)).or_panic.login == "mixed_login"
assert OptionsEncCaseUser.where(login: "MIXED_login").count.or_panic == 1
assert options_enc_raw("options_enc_case_users", "login", user.id) == OptionsEncCaseUser.login_encrypted_attribute.seal("mixed_login").or_panic

# it: shrinks large values and round-trips them
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
text = "the quick brown fox jumps over the lazy dog. " * 40
doc = OptionsEncBodyDoc.create_strict(packed: text, loose: text).or_panic

assert OptionsEncBodyDoc.find_strict(doc.id.as(Int64)).or_panic.packed == text
packed_size = options_enc_raw("options_enc_body_docs", "packed", doc.id).as(String).size
loose_size = options_enc_raw("options_enc_body_docs", "loose", doc.id).as(String).size
assert packed_size < (loose_size // 4)

# it: leaves values under the threshold uncompressed
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
doc = OptionsEncBodyDoc.create_strict(packed: "short value", loose: "short value").or_panic
packed_size = options_enc_raw("options_enc_body_docs", "packed", doc.id).as(String).size
loose_size = options_enc_raw("options_enc_body_docs", "loose", doc.id).as(String).size
assert packed_size == loose_size
assert OptionsEncBodyDoc.find_strict(doc.id.as(Int64)).or_panic.packed == "short value"

# it: honors a per-attribute threshold
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
text = "abc" * 30
doc = OptionsEncBodyDoc.create_strict(small_threshold: text, loose: text).or_panic
small = options_enc_raw("options_enc_body_docs", "small_threshold", doc.id).as(String).size
loose = options_enc_raw("options_enc_body_docs", "loose", doc.id).as(String).size
assert small < loose
assert OptionsEncBodyDoc.find_strict(doc.id.as(Int64)).or_panic.small_threshold == text

# it: round-trips a value that looks like the compression marker
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
tricky = "#{::Grant::Encryption::Compression::MARKER}not really compressed"
doc = OptionsEncBodyDoc.create_strict(packed: tricky, loose: tricky).or_panic
found = OptionsEncBodyDoc.find_strict(doc.id.as(Int64)).or_panic
assert found.packed == tricky
assert found.loose == tricky

# it: reads values written before compress: was turned on
OptionsEncCaseUser.clear.or_panic
OptionsEncBodyDoc.clear.or_panic
text = "old data " * 60
sealed = ::Grant::Encryption::Compression.decode(::Grant::Encryption::Compression.encode(text, false, 140))
assert sealed == text
assert ::Grant::Encryption::Compression.encode(text, true, 140).starts_with?(::Grant::Encryption::Compression::MARKER)
assert ::Grant::Encryption::Compression.decode(::Grant::Encryption::Compression.encode(text, true, 140)) == text

(KeyProvider.primary_key = nil)
(KeyProvider.deterministic_key = nil)
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
