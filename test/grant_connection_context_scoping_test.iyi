module test/grant_connection_context_scoping_test

import grant/base::{Base}
import grant/connection_handling::{ConnectionHandling, UnestablishedConnectionError}

pub class Todo < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table todos
  column id : Int64, primary: true
  column name : String?
  column priority : Int32?
  timestamps
end

pub class C01ScopeOther < Base
  table c01_scope_others
  column id : Int64, primary: true
end

pub class C01ScopeUnverifiedOne < Base
  table c01_scope_unverified_ones
  column id : Int64, primary: true
  connects_to database: {writing: "c01_scope_missing_one"}
end

pub class C01ScopeUnverifiedTwo < Base
  table c01_scope_unverified_twos
  column id : Int64, primary: true
  connects_to database: :c01_scope_missing_two
end

# it: keeps another class's context when reset_connecting_to runs inside a block
C01ScopeOther.connected_to(role: :reading) do
  Todo.connected_to(shard: :x) do
    Todo.reset_connecting_to
  end
  assert C01ScopeOther.connected_to?(role: :reading).or_panic
end
assert C01ScopeOther.connection_context.nil?

# it: leaves an enclosing connecting_to alone when reset runs inside another class's block
Todo.connecting_to(role: :reading)
C01ScopeOther.connected_to(shard: :x) do
  Todo.reset_connecting_to
  assert C01ScopeOther.current_shard == :x
end
assert C01ScopeOther.connection_context.nil?
assert Todo.connected_to?(role: :reading).or_panic
Todo.reset_connecting_to
assert Todo.connection_context.nil?

# it: removes a connecting_to made inside a block when the block ends
Todo.connected_to(role: :reading) do
  Todo.connecting_to(shard: :inner)
  assert Todo.current_shard == :inner
end
assert Todo.connection_context.nil?

# it: names every declaring model with missing connections in one error
error = ConnectionHandling.verify_all_strict
assert error.is_a?(UnestablishedConnectionError)
message = error.as(UnestablishedConnectionError).message
assert message.includes?("#{C01ScopeUnverifiedOne} declares connections that are not established: c01_scope_missing_one")
assert message.includes?("#{C01ScopeUnverifiedTwo} declares connections that are not established: c01_scope_missing_two")
