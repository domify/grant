module test/grant_connection_w6_connected_to_role_hash_test
import grant
import grant/base::{Base}
import grant/error::{ArgumentError}
import grant/error_taxonomy::{ReadOnlyError}
import grant/connection_registry::{ConnectionRegistry}
import grant/database_configurations::{DatabaseConfigurations}
import test/w6_c04_support::{W6C04}

pub class W6RoleHashThing < Base
  table w6_role_hash_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "w6_rh_primary", reading: "w6_rh_replica"}
end
pub class W6RoleHashOtherThing < Base
  table w6_role_hash_other_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "w6_rh_primary", reading: "w6_rh_replica"}
end

ddl = ["CREATE TABLE w6_role_hash_things (#{W6C04.id_column}, label TEXT)",
       "CREATE TABLE w6_role_hash_other_things (#{W6C04.id_column}, label TEXT)"]
W6C04.provision("w6_rh_primary", ddl)
W6C04.provision("w6_rh_replica", ddl)
W6C04.exec("w6_rh_primary", "INSERT INTO w6_role_hash_things (label) VALUES ('primary row')")
W6C04.exec("w6_rh_replica", "INSERT INTO w6_role_hash_things (label) VALUES ('replica row')")
W6C04.exec("w6_rh_primary", "INSERT INTO w6_role_hash_other_things (label) VALUES ('other primary row')")
W6C04.exec("w6_rh_replica", "INSERT INTO w6_role_hash_other_things (label) VALUES ('other replica row')")
W6C04.establish("w6_rh_primary", "w6_rh_primary", :writing)
W6C04.establish("w6_rh_replica", "w6_rh_replica", :reading)

# it: uses the only role of the hash and its connection
label = W6RoleHashThing.connected_to(database: {reading: "w6_rh_replica"}) do
  assert W6RoleHashThing.current_role == :reading
  assert W6RoleHashThing.current_database == "w6_rh_replica"
  W6RoleHashThing.first_strict.or_panic.label
end
assert label.or_panic == "replica row"
assert W6RoleHashThing.connected_to(database: {writing: "w6_rh_primary"}) {
  W6RoleHashThing.first_strict.or_panic.label
}.or_panic == "primary row"

# it: prevents writes in the reading role and leaves both databases alone
error = W6RoleHashThing.connected_to(database: {reading: "w6_rh_replica"}) {
  W6RoleHashThing.create_strict(label: "refused")
}
assert error.is_a?(ReadOnlyError)
assert W6C04.strings("w6_rh_primary", "SELECT label FROM w6_role_hash_things ORDER BY id") == ["primary row"]
assert W6C04.strings("w6_rh_replica", "SELECT label FROM w6_role_hash_things ORDER BY id") == ["replica row"]

# it: writes to the connection of a writing role
W6RoleHashThing.connected_to(database: {writing: "w6_rh_primary"}) {
  W6RoleHashThing.create_strict(label: "written")
}.or_panic
assert W6C04.strings("w6_rh_primary", "SELECT label FROM w6_role_hash_things ORDER BY id").includes?("written")
assert W6C04.strings("w6_rh_replica", "SELECT label FROM w6_role_hash_things ORDER BY id") == ["replica row"]

# it: picks the connection of role: when the hash names several roles
roles = {writing: "w6_rh_primary", reading: "w6_rh_replica"}
assert W6RoleHashThing.connected_to(database: roles, role: :reading) {
  W6RoleHashThing.first_strict.or_panic.label
}.or_panic == "replica row"
assert W6RoleHashThing.connected_to(database: roles, role: :writing) {
  W6RoleHashThing.first_strict.or_panic.label
}.or_panic == "primary row"

# it: needs role: when the hash names several roles, and a role the hash has
error = W6RoleHashThing.connected_to(database: roles) { nil }
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("needs role:")
error = W6RoleHashThing.connected_to(database: roles, role: :other) { nil }
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("no connection for role :other")

# it: accepts a Hash of role to connection name
role_hash = {:reading => "w6_rh_replica"}
assert W6RoleHashThing.connected_to(database: role_hash) {
  W6RoleHashThing.first_strict.or_panic.label
}.or_panic == "replica row"

# it: lets the hash override what the model declared, for the block only
assert W6RoleHashThing.connected_to(database: {reading: "w6_rh_primary"}) {
  W6RoleHashThing.first_strict.or_panic.label
}.or_panic == "primary row"
assert W6RoleHashThing.connected_to(role: :reading) {
  W6RoleHashThing.first_strict.or_panic.label
} == "replica row"

# it: answers connected_to? for the role and restores the previous context
W6RoleHashThing.connected_to(database: {reading: "w6_rh_replica"}) do
  assert W6RoleHashThing.connected_to?(role: :reading).or_panic
end.or_panic
assert !W6RoleHashThing.connected_to?(role: :reading).or_panic
assert W6RoleHashThing.current_database == "w6_rh_primary"

# it: sizes the pool of each role on its own connection
yaml = <<-YAML
  test:
    w6_rhp:
      url: #{W6C04.url("w6_rh_primary")}
      pool: 5
    w6_rhp_replica:
      url: #{W6C04.url("w6_rh_replica")}
      pool: 2
      replica: true
  YAML
DatabaseConfigurations.parse(yaml, "test", ->(_key : String) { nil.as(String?) }).or_panic.establish_connections.or_panic
writer = ConnectionRegistry.get_adapter("w6_rhp", :writing)
reader = ConnectionRegistry.get_adapter("w6_rhp", :reading)
assert ConnectionRegistry.connection_spec("w6_rhp", :writing).as(ConnectionRegistry::ConnectionSpec).pool_size == 5
assert ConnectionRegistry.connection_spec("w6_rhp", :reading).as(ConnectionRegistry::ConnectionSpec).pool_size == 2
writer.open { |db| db.scalar("SELECT 1") }.or_panic
reader.open { |db| db.scalar("SELECT 1") }.or_panic
assert writer.pool_stat.size == 5
assert reader.pool_stat.size == 2
W6C04.remove("w6_rhp", :writing)
W6C04.remove("w6_rhp", :reading)

# it: switches several models at once with connected_to_many
labels = ::Grant.connected_to_many(W6RoleHashThing, W6RoleHashOtherThing, role: :reading) do
  {W6RoleHashThing.first_strict.or_panic.label, W6RoleHashOtherThing.first_strict.or_panic.label}
end
assert labels == {"replica row", "other replica row"}

W6C04.remove("w6_rh_primary", :writing)
W6C04.remove("w6_rh_replica", :reading)
W6C04.cleanup
