module test/grant_connection_w6_abstract_class_routing_test
import grant/base::{Base}
import grant/connection_handling::{ConnectionHandling}
import test/w6_c04_support::{W6C04}

pub abstract class W6AppRecord < Base
  primary_abstract_class
  connects_to(
    database: {writing: "w6_abs_main", reading: "w6_abs_main_r"},
    shards: {
      default: {writing: "w6_abs_main", reading: "w6_abs_main_r"},
      extra:   {writing: "w6_abs_extra"},
    }
  )
end

parent_roles = W6AppRecord.connection_config
parent_shards = W6AppRecord.shard_config
W6AppRecord.connection_config = {} of Symbol => String
W6AppRecord.shard_config = {} of Symbol => Hash(Symbol, String)
W6AppRecord.default_database_name = "primary"

pub class W6AbsEarlyThing < W6AppRecord
  table w6_abs_things
  column id : Int64, primary: true
  column label : String?
end

pub class W6AbsGrandThing < W6AbsEarlyThing
  table w6_abs_things
end

pub class W6AbsOwnThing < W6AppRecord
  table w6_abs_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "w6_abs_other", reading: "w6_abs_other_r"}
end

pub class W6AbsLateThing < W6AppRecord
  table w6_abs_things
  column id : Int64, primary: true
  column label : String?
end

pub class W6AbsUnrelatedThing < Base
  table w6_abs_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "w6_abs_other", reading: "w6_abs_other_r"}
end

W6AppRecord.default_database_name = "w6_abs_main"
W6AppRecord.connection_config = parent_roles
W6AppRecord.shard_config = parent_shards

ddl = ["CREATE TABLE w6_abs_things (#{W6C04.id_column}, label TEXT)"]
{"w6_abs_main" => "main", "w6_abs_main_r" => "main replica",
 "w6_abs_other" => "other", "w6_abs_other_r" => "other replica",
 "w6_abs_extra" => "extra"}.each do |name, label|
  W6C04.provision(name, ddl)
  W6C04.exec(name, "INSERT INTO w6_abs_things (label) VALUES ('#{label}')")
  W6C04.establish(name, name, name.ends_with?("_r") ? :reading : :writing)
end

# it: routes every child to the parent's databases, whatever order they were declared in
assert W6AbsEarlyThing.connected_to(role: :writing) { W6AbsEarlyThing.first_strict.or_panic.label } == "main"
assert W6AbsEarlyThing.connected_to(role: :reading) { W6AbsEarlyThing.first_strict.or_panic.label } == "main replica"
assert W6AbsGrandThing.connected_to(role: :writing) { W6AbsGrandThing.first_strict.or_panic.label } == "main"
assert W6AbsGrandThing.connected_to(role: :reading) { W6AbsGrandThing.first_strict.or_panic.label } == "main replica"
assert W6AbsLateThing.connected_to(role: :writing) { W6AbsLateThing.first_strict.or_panic.label } == "main"
assert W6AbsLateThing.connected_to(role: :reading) { W6AbsLateThing.first_strict.or_panic.label } == "main replica"

# it: writes through a child to the parent's writer, never its reader
W6AbsGrandThing.create_strict(label: "from grandchild").or_panic
assert W6C04.strings("w6_abs_main", "SELECT label FROM w6_abs_things ORDER BY id") == ["main", "from grandchild"]
assert W6C04.strings("w6_abs_main_r", "SELECT label FROM w6_abs_things ORDER BY id") == ["main replica"]
W6C04.exec("w6_abs_main", "DELETE FROM w6_abs_things WHERE label = 'from grandchild'")

# it: lets a child's own connects_to replace the parent's whole declaration
assert W6AbsOwnThing.connected_to(role: :writing) { W6AbsOwnThing.first_strict.or_panic.label } == "other"
assert W6AbsOwnThing.connected_to(role: :reading) { W6AbsOwnThing.first_strict.or_panic.label } == "other replica"
assert W6AbsOwnThing.shard_keys.empty?
assert !W6AbsOwnThing.sharded?
assert W6AbsEarlyThing.shard_keys == [:default, :extra]

# it: serves the parent's shards to its children
assert W6AbsEarlyThing.connected_to(role: :writing, shard: :extra) { W6AbsEarlyThing.first_strict.or_panic.label } == "extra"
assert W6AbsGrandThing.connected_to(role: :writing, shard: :default) { W6AbsGrandThing.first_strict.or_panic.label } == "main"

# it: applies connected_to on the abstract parent to its children only
W6AppRecord.connected_to(role: :reading) do
  assert W6AbsLateThing.first_strict.or_panic.label == "main replica"
  assert W6AbsGrandThing.first_strict.or_panic.label == "main replica"
  assert W6AbsUnrelatedThing.connection_context.nil?
  assert !W6AbsUnrelatedThing.preventing_writes?
end

# it: applies connected_to on Grant::Base to the children of the primary abstract class
assert ConnectionHandling.primary_abstract_class_name == W6AppRecord.to_s
Base.connected_to(role: :reading) do
  assert W6AbsEarlyThing.first_strict.or_panic.label == "main replica"
  assert W6AbsOwnThing.first_strict.or_panic.label == "other replica"
  assert W6AbsUnrelatedThing.first_strict.or_panic.label == "other replica"
end

# it: follows a change made on the parent after a child resolved it
original = W6AppRecord.connection_config
W6AppRecord.connection_config = {:writing => "w6_abs_extra"}
assert W6AbsLateThing.connected_to(role: :writing) { W6AbsLateThing.first_strict.or_panic.label } == "extra"
W6AppRecord.connection_config = original
assert W6AbsLateThing.connected_to(role: :writing) { W6AbsLateThing.first_strict.or_panic.label } == "main"

# it: keeps the abstract marker on the parent alone
assert W6AppRecord.abstract_class?
assert !W6AbsEarlyThing.abstract_class?
assert !W6AbsGrandThing.abstract_class?

["w6_abs_main", "w6_abs_main_r", "w6_abs_other", "w6_abs_other_r", "w6_abs_extra"].each do |name|
  W6C04.remove(name, :writing)
  W6C04.remove(name, :reading)
end
W6C04.cleanup
