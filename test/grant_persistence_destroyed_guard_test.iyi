module test/grant_persistence_destroyed_guard_test
import grant
import grant/base::{Base}
import grant/errors::{RecordDestroyedError}
import grant/error::{ErrorBase}
import test/spec_helper::{register_spec_connections}

pub class GuardedItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table guarded_items
  column id : Int64, primary: true
  column name : String?
  column counter : Int32?
  column active : Bool?
  timestamps
end

register_spec_connections
GuardedItem.migrator.drop_and_create.or_panic

def destroyed_item : GuardedItem
  item = GuardedItem.create_strict(name: "gone", counter: 1, active: true).or_panic
  assert item.destroy.or_panic
  item
end

# it: freezes a record after destroy
GuardedItem.clear.or_panic
item = GuardedItem.create_strict(name: "live").or_panic
assert !item.frozen?
item.destroy.or_panic
assert item.destroyed?
assert item.frozen?
assert !item.persisted?

# it: raises from save, save!, update and update!
GuardedItem.clear.or_panic
item = destroyed_item
item.name = "again"
error = item.save
assert error.is_a?(RecordDestroyedError)
assert error.as(RecordDestroyedError).message.includes?("destroyed #{GuardedItem}")
assert item.save_strict.is_a?(RecordDestroyedError)
assert item.update(name: "x").is_a?(RecordDestroyedError)
assert item.update_strict(name: "x").is_a?(RecordDestroyedError)
assert item.update_attribute(:name, "x").is_a?(RecordDestroyedError)
assert item.toggle_strict(:active).is_a?(RecordDestroyedError)

# it: raises from update_columns, update_column and touch
GuardedItem.clear.or_panic
item = destroyed_item
assert item.update_columns(name: "x").is_a?(RecordDestroyedError)
assert item.update_column(:name, "x").is_a?(RecordDestroyedError)
assert item.touch.is_a?(RecordDestroyedError)

# it: raises from increment!, decrement! and a second destroy
GuardedItem.clear.or_panic
item = destroyed_item
assert item.increment_strict(:counter).is_a?(RecordDestroyedError)
assert item.decrement_strict(:counter).is_a?(RecordDestroyedError)
assert item.destroy.is_a?(RecordDestroyedError)
assert item.destroy_strict.is_a?(RecordDestroyedError)

# it: does not write a row back for a destroyed record
GuardedItem.clear.or_panic
item = destroyed_item
id = item.id
assert item.save.is_a?(RecordDestroyedError)
assert GuardedItem.find(id).or_panic.nil?
assert GuardedItem.count.or_panic == 0

# it: is a Grant::ErrorBase
GuardedItem.clear.or_panic
item = destroyed_item
error = item.save
assert error.is_a?(ErrorBase)
assert error.is_a?(RecordDestroyedError)

# it: still allows in-memory reads and the in-memory increment
GuardedItem.clear.or_panic
item = destroyed_item
assert item.name == "gone"
item.increment(:counter).or_panic
assert item.counter == 2

# it: leaves live records alone
GuardedItem.clear.or_panic
item = GuardedItem.create_strict(name: "alive").or_panic
item.update_strict(name: "still alive").or_panic
assert item.touch.or_panic
assert GuardedItem.find_strict(item.id).or_panic.name == "still alive"

GuardedItem.adapter.close.or_panic
