module test/grant_schema_m02a_review_test
import grant/base::{Base}
import grant/converters::{Enum}
import grant/schema/schema_statements::{RecordingStatements}
import grant/adapter/schema::{Dialect, InvalidDefinition}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

pub enum M02aReviewLevel
  Low
  High
end
pub class M02aReviewEnumRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_review_enum_rows
  column id : Int64, primary: true
  column level_as_int : M02aReviewLevel?, converter: Enum(M02aReviewLevel, Int64)
  column level_as_text : M02aReviewLevel?, converter: Enum(M02aReviewLevel, String)
end
register_spec_connections
restore_default_spec_connections

# it: maps the column to the converter's storage type
sql = M02aReviewEnumRow.migrator.create_sql
q = "\""
int_type = CURRENT_ADAPTER == "sqlite" ? "INTEGER" : "BIGINT"
text_type = CURRENT_ADAPTER == "pg" ? "TEXT" : "VARCHAR(255)"
assert sql.includes?("#{q}level_as_int#{q} #{int_type}")
assert sql.includes?("#{q}level_as_text#{q} #{text_type}")

# it: round trips an integer-stored enum
M02aReviewEnumRow.migrator.drop_and_create.or_panic
row = M02aReviewEnumRow.new
row.level_as_int = M02aReviewLevel::High
row.level_as_text = M02aReviewLevel::Low
row.save_strict.or_panic
found = M02aReviewEnumRow.find_strict(row.id).or_panic
assert found.level_as_int == M02aReviewLevel::High
assert found.level_as_text == M02aReviewLevel::Low
M02aReviewEnumRow.migrator.drop.or_panic

# it: raises InvalidDefinition for an unknown symbol type
error = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02a_review_t) { |t| t.column(:x, :nope) }
assert error.is_a?(InvalidDefinition)
assert error.as(InvalidDefinition).message.to_s.includes?("Unknown column type :nope")

# it: accepts a symbol kind
sql = RecordingStatements.new(Dialect::Mysql).create_table_statements(:m02a_review_t, id: false) { |t| t.column(:n, :smallint) }.or_panic
assert sql.first.includes?("`n` SMALLINT")
