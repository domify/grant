module test/grant_transaction_cross_database_nesting_test
import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/driver::{Connection}
import grant/errors::{ErrorBase}
import grant/transaction::{current_connection?}
import test/transaction_sql_recorder::{record, begins}
import grant
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

def other_database : String
  "#{CURRENT_ADAPTER}_with_replica"
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: routes a model back onto its own open transaction from inside another database's transaction
Parent.clear.or_panic
error = Parent.transaction do
  outer_connection = current_connection?(Parent.transaction_adapter)
  Grant.transaction(other_database) do
    current = current_connection?(Parent.transaction_adapter)
    assert current.as(Connection).object_id == outer_connection.as(Connection).object_id
    Parent.create_strict(name: "Nested").or_panic
  end.or_panic
  ErrorBase.new("outer failure")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer failure"
assert Parent.count.or_panic == 0

# it: opens a savepoint on the outer connection, not a second BEGIN
statements = record do
  Parent.transaction do
    Grant.transaction(other_database) do
      Parent.transaction(requires_new: true) { nil }.or_panic
    end.or_panic
  end.or_panic
end
assert begins(statements).size == 2
assert statements.includes?("SAVEPOINT sp_1")

# it: enlists commit callbacks with the model's own transaction
events = [] of Symbol
Parent.transaction do
  Grant.transaction(other_database) do
    Parent.transaction do
      Parent.current_transaction.after_commit { events << :parent_commit; nil }
    end.or_panic
  end.or_panic
  assert events.empty?
end.or_panic
assert events == [:parent_commit]
Parent.adapter.close.or_panic
Grant.connection(other_database).close.or_panic
