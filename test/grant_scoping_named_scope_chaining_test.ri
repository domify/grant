module test/grant_scoping_named_scope_chaining_test
import std/env
import std/time::{Time}
import grant/base::{Base}
import grant/query/builder::{Builder}
import test/spec_helper::{register_spec_connections}

pub class NamedScopeChainModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table named_scope_chain_models
  column id : Int64, primary: true
  column status : String
  column published : Bool = false
  column deleted_at : Time?

  scope :published, ->(query : Builder(NamedScopeChainModel)) { query.where(published: true) }
  scope :with_status, ->(query : Builder(NamedScopeChainModel), status : String) { query.where(status: status) }
  scope :status_named, ->(status : String) { NamedScopeChainModel.where(status: status) }
  scope :recent, ->(query : Builder(NamedScopeChainModel)) { query.order(id: :desc) }
  default_scope { where(deleted_at: nil) }
end

register_spec_connections
NamedScopeChainModel.migrator.drop_and_create.or_panic

# it: chains named scopes over the same relation and preserves the default scope
NamedScopeChainModel.unscoped.delete_all.or_panic
visible = NamedScopeChainModel.create_strict(status: "active", published: true).or_panic
NamedScopeChainModel.create_strict(status: "inactive", published: true).or_panic
NamedScopeChainModel.create_strict(status: "active", published: true, deleted_at: Time.utc).or_panic
relation = NamedScopeChainModel.published.with_status("active")
results = relation.all.select.or_panic
class_method_results = NamedScopeChainModel.published.status_named("active").all.select.or_panic
assert results.map(&.id) == [visible.id]
assert class_method_results.map(&.id) == [visible.id]

# it: chains a named scope after regular relation methods
NamedScopeChainModel.unscoped.delete_all.or_panic
older = NamedScopeChainModel.create_strict(status: "active", published: true).or_panic
newer = NamedScopeChainModel.create_strict(status: "active", published: true).or_panic
results = NamedScopeChainModel.published.where(status: "active").recent.all.select.or_panic
assert results.map(&.id) == [newer.id, older.id]
NamedScopeChainModel.adapter.close.or_panic
