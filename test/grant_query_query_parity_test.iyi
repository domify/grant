module test/grant_query_query_parity_test

import grant/base::{Base}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
  timestamps
  has_many :students, class_name: Student
  validate :name, "Name cannot be blank" do |parent|
    !parent.name.to_s.strip.empty?
  end
end

pub class Teacher < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table teachers
  column id : Int64, primary: true
  column name : String?
  has_many :klasses, class_name: Klass
end

pub class Student < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table students
  column id : Int64, primary: true
  column name : String?
  has_many :enrollments, class_name: Enrollment
  has_many :klasses, class_name: Klass, through: :enrollments
end

pub class Klass < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table klasses
  column id : Int64, primary: true
  column name : String?
  belongs_to teacher : Teacher
  has_many :enrollments, class_name: Enrollment
  has_many :students, class_name: Student, through: :enrollments
end

pub class Enrollment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table enrollments
  column id : Int64, primary: true
  belongs_to student : Student
  belongs_to klass : Klass
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: returns the primary keys of matching records
Parent.clear.or_panic
a = Parent.create_strict(name: "ids-a").or_panic
b = Parent.create_strict(name: "ids-b").or_panic
Parent.create_strict(name: "other").or_panic
ids = Parent.where(name: ["ids-a", "ids-b"]).ids.or_panic
assert ids.map(&.as(Int64)).sorted == [a.id, b.id].map(&.as(Int64)).sorted

# it: returns all ids when unfiltered
Parent.clear.or_panic
Parent.create_strict(name: "p1").or_panic
Parent.create_strict(name: "p2").or_panic
assert Parent.ids.or_panic.size == 2

# it: returns an empty array for a none relation
assert Parent.where(name: "anything").none.ids.or_panic.empty?

# it: drops ordering with unscope(:order)
sql = Parent.where(name: "x").order(name: :asc).unscope(:order).raw_sql
assert !sql.includes?("ORDER BY name")

# it: drops where conditions with unscope(:where)
query = Parent.where(name: "x").where(name: "y").unscope(:where)
assert query.where_fields.empty?

# it: drops limit and offset
query = Parent.where(name: "x").limit(10).offset(5).unscope(:limit, :offset)
assert query.limit.nil?
assert query.offset.nil?

# it: drops group_by, having and joins
query = Parent
  .joins("students", on: "students.parent_id = parents.id")
  .group_by(:name)
  .having("COUNT(*) > ?", 1)
  .unscope(:joins, :group, :having)
assert query.join_clauses.empty?
assert query.group_fields.empty?
assert query.having_clauses.empty?

# it: raises on an unknown component
error = Parent.where(name: "x").unscope(:bogus).select
assert error.is_a?(ArgumentError)

# it: resolves a has_many association into an INNER JOIN
# Parent has_many :students  (students.parent_id -> parents.id)
sql = Parent.joins(:students).raw_sql
assert sql.includes?("INNER JOIN students ON students.parent_id = parents.id")

# it: resolves a belongs_to association into an INNER JOIN
# Klass belongs_to :teacher  (klasses.teacher_id -> teachers.id)
sql = Klass.joins(:teacher).raw_sql
assert sql.includes?("INNER JOIN teachers ON teachers.id = klasses.teacher_id")

# it: resolves multiple associations
sql = Parent.joins(:students).where(name: "x").raw_sql
assert sql.includes?("INNER JOIN students")
assert sql.includes?("WHERE")

# it: left_joins(association) emits a LEFT JOIN
sql = Parent.left_joins(:students).raw_sql
assert sql.includes?("LEFT JOIN students ON students.parent_id = parents.id")

# it: keeps the explicit-string overload working
sql = Parent.joins("students", on: "students.parent_id = parents.id").raw_sql
assert sql.includes?("INNER JOIN students ON students.parent_id = parents.id")

# it: raises for an unknown association
error = Parent.joins(:nonexistent_assoc).select
assert error.is_a?(ArgumentError)

# it: includes the comment in the executed SQL (not just raw_sql)
Parent.clear.or_panic
Parent.create_strict(name: "annotated").or_panic
query = Parent.where(name: "annotated").annotate("from dashboard")
assert query.raw_sql.includes?("/* from dashboard */")
# The executed statement carries the comment too — exercising the path
# proves it does not break execution.
assert query.select.or_panic.size == 1

# it: sanitizes the comment by stripping */
sql = Parent.where(name: "x").annotate("evil */ DROP TABLE parents; /*").raw_sql
assert !sql.includes?("*/ DROP TABLE")
assert sql.includes?("/* evil  DROP TABLE parents;")

# it: yields only records matching the relation
Parent.clear.or_panic
Parent.create_strict(name: "match").or_panic
Parent.create_strict(name: "match").or_panic
Parent.create_strict(name: "nope").or_panic
seen = [] of String
Parent.where(name: "match").find_each(batch_size: 1) do |parent|
  seen << parent.name.to_s
end.or_panic
assert seen.size == 2
assert seen.all? { |n| n == "match" }

# it: yields batches of matching records
Parent.clear.or_panic
5.times { |_| Parent.create_strict(name: "batch").or_panic }
batch_sizes = [] of Int32
total = 0
Parent.where(name: "batch").find_in_batches(batch_size: 2) do |batch|
  batch_sizes << batch.size
  total += batch.size
end.or_panic
assert total == 5
assert batch_sizes.first == 2

# it: updates matching rows from a Hash
Parent.clear.or_panic
Parent.create_strict(name: "before").or_panic
Parent.create_strict(name: "before").or_panic
Parent.create_strict(name: "keep").or_panic
affected = Parent.where(name: "before").update_all({"name" => "after"}).or_panic
assert affected == 2
assert Parent.where(name: "after").count.or_panic == 2
assert Parent.where(name: "keep").count.or_panic == 1

# it: updates from named arguments
Parent.clear.or_panic
Parent.create_strict(name: "named-before").or_panic
Parent.where(name: "named-before").update_all(name: "named-after").or_panic
assert Parent.where(name: "named-after").count.or_panic == 1

# it: is injection-safe: values are bound, not interpolated
Parent.clear.or_panic
p = Parent.create_strict(name: "victim").or_panic
# A classic injection payload as a value must be stored verbatim,
# never executed. The parents table must survive.
payload = "x'); DROP TABLE parents; --"
Parent.where(id: p.id).update_all({"name" => payload}).or_panic
reloaded = Parent.find_strict(p.id).or_panic
assert reloaded.name == payload
# Table intact, row still present.
assert Parent.count.or_panic == 1

# it: still supports the raw string form
Parent.clear.or_panic
Parent.create_strict(name: "raw").or_panic
Parent.where(name: "raw").update_all("name = 'raw-updated'").or_panic
assert Parent.where(name: "raw-updated").count.or_panic == 1
