module test/grant_columns_uuid_test
import grant/base::{Base}
import std/uuid::{UUID}
import test/spec_helper::{register_spec_connections}

pub class UUIDModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table uuids
  column uuid : UUID?, primary: true
end

register_spec_connections
UUIDModel.migrator.drop_and_create.or_panic

# it: correctly sets a RFC4122 V4 UUID on save
item = UUIDModel.new
assert item.uuid.nil?
item.save.or_panic
assert item.uuid.is_a?(UUID)
assert item.uuid.as(UUID).version == 4
assert (item.uuid.as(UUID).bytes[8] & 0xc0_u8) == 0x80_u8

# Also verify the generated key survives the adapter's storage and hydration.
key = item.uuid.as(UUID)
assert UUIDModel.find_strict(key.to_s).or_panic.uuid == key
assert UUIDModel.count.or_panic == 1
UUIDModel.adapter.close.or_panic
