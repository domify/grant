module test/grant_connection_reconnect_policy_test
import grant/adapter/pool_support
import std/time::{Span}

# it: classifies statements
reads = ["SELECT 1", "  select * from t", "\nSHOW server_version", "EXPLAIN SELECT 1", "VALUES (1)"]
others = ["INSERT INTO t VALUES (1)", "UPDATE t SET a = 1", "DELETE FROM t", "WITH x AS (SELECT 1) SELECT * FROM x",
          "EXPLAIN ANALYZE DELETE FROM t", "SET search_path TO x", "", "   "]
reads.each { |sql| assert Grant::Adapter::PoolSupport.idempotent_read?(sql) }
others.each { |sql| assert !Grant::Adapter::PoolSupport.idempotent_read?(sql) }
assert !Grant::Adapter::PoolSupport.idempotent_read?(nil)

# it: backs off exponentially up to a cap
base = Span.milliseconds(100_i64)
assert Grant::Adapter::PoolSupport.backoff(base, 0) == Span.milliseconds(100_i64)
assert Grant::Adapter::PoolSupport.backoff(base, 1) == Span.milliseconds(200_i64)
assert Grant::Adapter::PoolSupport.backoff(base, 3) == Span.milliseconds(800_i64)
assert Grant::Adapter::PoolSupport.backoff(base, 30) == Grant::Adapter::PoolSupport::MAX_BACKOFF
