module test/grant_dirty_changes_to_save_test
import test/dirty_family_models::{F01Post}
import std/gc::{GC}

# Hash value equality is checked entry by entry; see port/bugs/iyi-hash-equality.md.
pub def same_changes?(actual : Hash(String, A), expected : Hash(String, B)) : Bool forall A, B
  return false unless actual.size == expected.size
  expected.each do |key, value|
    return false unless actual.has_key?(key) && actual[key] == value
  end
  true
end

# it: reports changes_to_save and has_changes_to_save?
post = F01Post.create_strict(title: "a", views: 1).or_panic
assert !post.has_changes_to_save?
assert post.changes_to_save.empty?

post.title = "b"
assert post.has_changes_to_save?
assert same_changes?(post.changes_to_save, {"title" => {"a", "b"}})
assert post.changed_attribute_names_to_save == ["title"]

# it: reads attributes as the database holds them
post = F01Post.create_strict(title: "a", views: 1).or_panic
post.title = "b"

assert same_changes?(post.attributes_in_database, {"title" => "a"})
assert post.attribute_in_database("title") == "a"
assert post.title_in_database == "a"
assert post.attribute_in_database("views") == 1
assert post.views_in_database == 1

# it: returns the pending change for one attribute
post = F01Post.create_strict(title: "a").or_panic
post.title = "b"

assert post.attribute_change_to_be_saved("title") == {"a", "b"}
assert post.title_change_to_be_saved == {"a", "b"}
assert post.attribute_change_to_be_saved("views").nil?
assert post.views_change_to_be_saved.nil?

# it: clears the pending changes after save
post = F01Post.create_strict(title: "a").or_panic
post.title = "b"
post.save_strict.or_panic
assert !post.has_changes_to_save?
assert post.attributes_in_database.empty?

# it: does not allocate when checking has_changes_to_save?
post = F01Post.create_strict(title: "a").or_panic
post.title = "b"
assert post.has_changes_to_save?

# Warm up, then compare GC bytes across many calls.
post.has_changes_to_save?
GC.collect
collections = GC.stats.collections
before = GC.stats.bytes_since_collection
1000.times { post.has_changes_to_save? }
assert (GC.stats.bytes_since_collection - before) == 0
assert GC.stats.collections == collections

clean = F01Post.create_strict(title: "a").or_panic
clean.has_changes_to_save?
collections = GC.stats.collections
before = GC.stats.bytes_since_collection
1000.times { clean.has_changes_to_save? }
assert (GC.stats.bytes_since_collection - before) == 0
assert GC.stats.collections == collections
