module test/grant_encryption_unencrypted_fallback_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/config::{Config}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/cipher::{Cipher, DecryptionError}
import std/base64::{Base64}
import test/spec_helper::{register_spec_connections}

pub class UnencNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table unenc_notes
  column id : Int64, primary: true
  encrypts note : String, support_unencrypted_data: true
  encrypts strict : String
  encrypts tag : String, deterministic: true, support_unencrypted_data: true
  encrypts :legacy_note, support_unencrypted_data: true
end

private def unenc_insert(column : String, value : String) : Int64
  UnencNote.adapter.open do |db|
    db.exec("INSERT INTO unenc_notes (#{column}) VALUES ('#{value}')").or_panic
    db.scalar("SELECT MAX(id) FROM unenc_notes").or_panic.as(Int64)
  end.or_panic
end

private def unenc_raw(id : Int64?) : String
  UnencNote.adapter.open do |db|
    db.scalar("SELECT note FROM unenc_notes WHERE id = #{id}")
  end.or_panic.as(String)
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "unencrypted-salt"
register_spec_connections
UnencNote.migrator.drop_and_create.or_panic
Config.support_unencrypted_data = false

# it: tells ciphertext from plaintext without decrypting
sealed = Base64.decode(UnencNote.note_encrypted_attribute.seal("hello world").or_panic)
assert Cipher.encrypted_payload?(sealed)
assert !Cipher.encrypted_payload?("hello world")
assert !Cipher.encrypted_payload?("")
broken = String.new(sealed.bytesize) { |buffer| buffer.copy_from(sealed.to_unsafe, sealed.bytesize) }
broken.to_unsafe[0] = 0x7f_u8
assert !Cipher.encrypted_payload?(broken)

# it: does not use exceptions to decide (plaintext that is valid Base64 passes through)
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
attribute = UnencNote.note_encrypted_attribute
assert attribute.open_with_index("dGVzdA==").or_panic == {"dGVzdA==", -1}
assert attribute.open_with_index("not base64 at all!").or_panic == {"not base64 at all!", -1}

# it: reads plaintext rows for attributes that opt in and ciphertext as usual
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
plain_id = unenc_insert("note", "written before encryption")
assert UnencNote.find_strict(plain_id).or_panic.note == "written before encryption"
created = UnencNote.create_strict(note: "written after").or_panic
assert UnencNote.find_strict(created.id).or_panic.note == "written after"
raw = unenc_raw(created.id)
assert raw != "written after"

# it: keeps failing closed for attributes without the flag
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
plain_id = unenc_insert("strict", "plaintext in a strict column")
assert UnencNote.find_strict(plain_id).is_a?(DecryptionError)

# it: still rejects tampered ciphertext when the flag is on
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
created = UnencNote.create_strict(note: "sealed").or_panic
bytes = Base64.decode(unenc_raw(created.id))
bytes.to_unsafe[bytes.bytesize - 1] = bytes.to_unsafe[bytes.bytesize - 1] ^ 0x01_u8
assert UnencNote.note_encrypted_attribute.open(Base64.encode(bytes)).is_a?(DecryptionError)

# it: is honored by the generated getter of the <attr>_encrypted form
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
plain_id = unenc_insert("legacy_note_encrypted", "legacy plaintext")
assert UnencNote.find_strict(plain_id).or_panic.legacy_note.or_panic == "legacy plaintext"

# it: makes every attribute tolerate plaintext, and switching it off restores strictness
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
plain_id = unenc_insert("strict", "global plaintext")
Config.support_unencrypted_data = true
assert UnencNote.find_strict(plain_id).or_panic.strict == "global plaintext"
Config.support_unencrypted_data = false
assert UnencNote.find_strict(plain_id).is_a?(DecryptionError)

# it: matches both forms of a deterministic attribute while the flag is on
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
plain_id = unenc_insert("tag", "vip")
sealed_record = UnencNote.create_strict(tag: "vip").or_panic
UnencNote.create_strict(tag: "regular").or_panic
assert UnencNote.where(tag: "vip").select.or_panic.compact_map(&.id).sorted == [plain_id, sealed_record.id.as(Int64)].sorted
assert UnencNote.where(tag: ["vip", "regular"]).count.or_panic == 3
assert UnencNote.where(tag: "vip").to_sql.includes?("IN")

# it: excludes both forms with a negated comparison
Config.support_unencrypted_data = false
UnencNote.clear.or_panic
unenc_insert("tag", "vip")
UnencNote.create_strict(tag: "vip").or_panic
regular = UnencNote.create_strict(tag: "regular").or_panic
assert UnencNote.where(:tag, :neq, "vip").select.or_panic.map(&.id) == [regular.id]
assert UnencNote.where(:tag, :neq, "vip").to_sql.includes?("NOT IN")

Config.support_unencrypted_data = false
KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
