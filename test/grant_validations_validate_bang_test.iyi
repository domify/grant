module test/grant_validations_validate_bang_test
import grant/base::{Base}
import grant/errors::{RecordInvalid, RecordNotSaved}
import grant/error::{ErrorBase}
import test/spec_helper::{register_spec_connections}

pub class V01BangPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v01_bang_posts

  column id : Int64, primary: true
  column title : String?
  column summary : String?

  validates_presence_of :title
  validates_presence_of :summary, on: :publish
end

register_spec_connections

# it: returns the record when it is valid
post = V01BangPost.new
post.title = "Hi"
assert post.validate_strict.or_panic.object_id == post.object_id

# it: raises Grant::RecordInvalid with the full messages when invalid
post = V01BangPost.new
ex = post.validate_strict
assert ex.is_a?(RecordInvalid)
assert ex.as(RecordInvalid).message == "Validation failed: Title can't be blank"
assert ex.as(RecordInvalid).record.as(V01BangPost).object_id == post.object_id
assert post.errors.map { |error| error.field.to_s } == ["title"]

# it: is a Grant::RecordNotSaved and a Grant::ErrorBase
assert V01BangPost.new.validate_strict.is_a?(RecordNotSaved)
assert V01BangPost.new.validate_strict.is_a?(ErrorBase)

# it: accepts a context
post = V01BangPost.new
post.title = "Hi"
assert post.validate_strict.or_panic.object_id == post.object_id
ex = post.validate_strict(:publish)
assert ex.is_a?(RecordInvalid)
assert ex.as(RecordInvalid).message.includes?("Summary can't be blank")
ex = post.validate_strict(context: :publish)
assert ex.is_a?(RecordInvalid)
assert ex.as(RecordInvalid).message.includes?("Summary can't be blank")
post.summary = "s"
assert post.validate_strict(:publish).or_panic.object_id == post.object_id
assert post.validate_strict([:create, :publish]).or_panic.object_id == post.object_id

# it: has a validate(context) alias returning Bool
post = V01BangPost.new
post.title = "Hi"
assert post.validate.or_panic
assert !post.validate(:publish).or_panic
assert !post.validate(context: :publish).or_panic
assert post.errors.map { |error| error.field.to_s } == ["summary"]
