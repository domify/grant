module test/grant_query_executor_test
import test/transaction_crud_models::{Parent}
import grant/query/executor::{List}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
Parent.clear.or_panic

# it: runs a list query and hydrates its records
parent = Parent.create_strict(name: "Executor parent").or_panic
executor = Parent.where(name: "Executor parent").assembler.select
assert executor.is_a?(List(Parent))
records = executor.run.or_panic
assert records.size == 1
assert records.first.id == parent.id
assert records.first.name == "Executor parent"

Parent.adapter.close.or_panic
