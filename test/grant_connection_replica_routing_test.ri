module test/grant_connection_replica_routing_test
import grant/base::{Base}
import grant/adapter/base
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/drivers::{open_connection}
import grant/adapter/driver::{Value}
import grant/connection_registry::{ConnectionRegistry}
import grant/health_monitor::{HealthMonitor}
import grant/replica_load_balancer::{ReplicaEntry, RoundRobinStrategy, WeightedStrategy, LeastConnectionsStrategy, RandomStrategy}
import grant/error::{ErrorBase}
import std/file::{File}
import std/dir::{Dir}
import grant/adapter/pool_support::{ticks}
import std/set
import test/pool_spec_support::{C02Support}

C02_RR_DIR = File.join(Dir.tempdir, "c02_rr_#{ticks}")
C02_RR_W = File.join(C02_RR_DIR, "writer.sqlite3")
C02_RR_A = File.join(C02_RR_DIR, "reader_a.sqlite3")
C02_RR_B = File.join(C02_RR_DIR, "reader_b.sqlite3")

pub class C02RoutedRecord < Base
  table c02_routed_records
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "c02_rr_writer", reading: "c02_rr_reader"}
end

pub class C02StrategyRecord < Base
  table c02_strategy_records
  column id : Int64, primary: true
  column label : String?
  configure_connection(load_balancing_strategy: ::Grant::ReplicaLoadBalancer::WeightedStrategy.new)
  connects_to database: {writing: "c02_rr_writer", reading: "c02_rr_strategy"}
end

pub def labels_in(path : String) : Array(String)
  labels = [] of String
  db = open_connection(path).or_panic
  db.query("SELECT label FROM c02_routed_records ORDER BY id").or_panic.each do |row|
    labels << row["label"].as(String)
  end
  db.close.or_panic
  labels
end

pub def register_readers : Nil
  ConnectionRegistry.establish_connection(database: "c02_rr_reader", adapter: Sqlite, url: "sqlite3:#{C02_RR_A}", role: :reading, replica_index: 0).or_panic
  ConnectionRegistry.establish_connection(database: "c02_rr_reader", adapter: Sqlite, url: "sqlite3:#{C02_RR_B}", role: :reading, replica_index: 1).or_panic
  nil
end

pub def read_label(record_class : C02RoutedRecord.class) : String
  record_class.connected_to(role: :reading) { record_class.first_strict.or_panic.label.as(String) }
end

HealthMonitor.test_mode = true
Dir.mkdir_p(C02_RR_DIR)
{C02_RR_W => "writer row", C02_RR_A => "reader a row", C02_RR_B => "reader b row"}.each do |path, label|
  File.delete(path) if File.exists?(path)
  db = open_connection(path).or_panic
  db.exec("CREATE TABLE c02_routed_records (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT)").or_panic
  db.exec("INSERT INTO c02_routed_records (label) VALUES ('#{label}')").or_panic
  db.close.or_panic
end
ConnectionRegistry.establish_connection(database: "c02_rr_writer", adapter: Sqlite, url: "sqlite3:#{C02_RR_W}", role: :writing).or_panic

# it: reads from the replicas and sends writes to the writer only
register_readers
assert read_label(C02RoutedRecord).includes?("reader")

C02RoutedRecord.create_strict(label: "written").or_panic

assert labels_in(C02_RR_W).includes?("written")
assert labels_in(C02_RR_A) == ["reader a row"]
assert labels_in(C02_RR_B) == ["reader b row"]
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: keeps both replicas registered under one database and spreads reads across them
register_readers
balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)
assert balancer.size == 2

# A model read resolves its adapter more than once, so count picks on the
# balancer itself to see the rotation.
picked = Set(String).new
4.times { picked << balancer.next_replica.as(::Grant::Adapter::Base::Base).url }
assert picked.size == 2

4.times { assert read_label(C02RoutedRecord).includes?("reader") }
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: registers a replica idempotently: the same key replaces it and closes the old pool
register_readers
balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)
old = ConnectionRegistry.get_adapter("c02_rr_reader", :reading)
old.open(&.scalar("SELECT 1")).or_panic
old_pool = old.database.or_panic

register_readers
register_readers

assert balancer.size == 2
assert old_pool.pool.stats.open_connections == 0
assert ConnectionRegistry.get_adapter("c02_rr_reader", :reading).object_id != old.object_id
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: removes a replica from rotation when its connection is removed
register_readers
assert ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)
assert balancer.size == 1
4.times { assert read_label(C02RoutedRecord) == "reader a row" }
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: registers several replicas in one call
register_readers
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

ConnectionRegistry.establish_replicas(
  database: "c02_rr_reader", adapter: Sqlite,
  urls: ["sqlite3:#{C02_RR_A}", "sqlite3:#{C02_RR_B}"]).or_panic

assert ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer).size == 2
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: sends a read to the replica with fewer connections checked out, and counts them back down
register_readers
ConnectionRegistry.load_balancing_strategy("c02_rr_reader", ::Grant::ReplicaLoadBalancer::LeastConnectionsStrategy.new)
balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)
first = balancer.replicas[0]
second = balancer.replicas[1]

hold = Channel(Nil).new
release = Channel(Nil).new
finished = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    first.open do |_|
      hold.send(nil).or_panic
      release.receive.or_panic
    end.or_panic
    finished.send(nil).or_panic
  end
  hold.receive.or_panic
  assert first.active_checkouts == 1
  4.times { assert balancer.next_replica.as(::Grant::Adapter::Base::Base).object_id == second.object_id }
  release.send(nil).or_panic
  finished.receive.or_panic
end
assert first.active_checkouts == 0
assert second.active_checkouts == 0

# Idle again: both are candidates.
picked = Set(String).new
4.times { picked << balancer.next_replica.as(::Grant::Adapter::Base::Base).name }
assert picked.size == 2
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: releases the count when the block raises
register_readers
adapter = ConnectionRegistry.get_adapter("c02_rr_reader", :reading)

error = adapter.open { |_| ErrorBase.new("boom") }
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"

assert adapter.active_checkouts == 0
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: picks without allocating
register_readers
ConnectionRegistry.load_balancing_strategy("c02_rr_reader", ::Grant::ReplicaLoadBalancer::LeastConnectionsStrategy.new)
balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)
balancer.next_replica.as(::Grant::Adapter::Base::Base)

# Native allocator counter corresponding to upstream GC.stats.total_bytes.
before = IyiMark.allocated_since
10_000.times { balancer.next_replica.as(::Grant::Adapter::Base::Base) }
assert (IyiMark.allocated_since - before) < 65_536
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: keeps rotating when the round-robin and weighted cursors wrap around
register_readers
round_robin = ::Grant::ReplicaLoadBalancer::RoundRobinStrategy.new
round_robin.current_index.set(2147483647 - 1)
picks = Array(Int32).new(4) { round_robin.next_index(3) }
picks.each { |index| assert index >= 0 && index < 3 }

weighted = ::Grant::ReplicaLoadBalancer::WeightedStrategy.new
weighted.cursor.set(2147483647.to_i64 + 5)
4.times do
  index = weighted.next_index(3)
  assert index >= 0 && index < 3
end

least = ::Grant::ReplicaLoadBalancer::LeastConnectionsStrategy.new
least.tie_breaker.set(2147483647)
entries = [::Grant::ReplicaLoadBalancer::ReplicaEntry.new(ConnectionRegistry.get_adapter("c02_rr_writer", :writing))]
assert !least.pick(entries).nil?
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: gives each replica reads in proportion to its weight
register_readers
ConnectionRegistry.establish_connection(
  database: "c02_rr_reader", adapter: Sqlite, url: "sqlite3:#{C02_RR_A}",
  role: :reading, replica_index: 0, replica_weight: 3).or_panic
ConnectionRegistry.load_balancing_strategy("c02_rr_reader", ::Grant::ReplicaLoadBalancer::WeightedStrategy.new)
balancer = ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer)

counts = Hash(String, Int32).new(0)
8.times { counts[balancer.next_replica.as(::Grant::Adapter::Base::Base).url.includes?("reader_a") ? "a" : "b"] += 1 }

assert counts["a"] == 6
assert counts["b"] == 2
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: compiles in a model body and applies the strategy to replicas registered afterwards
register_readers
ConnectionRegistry.establish_connection(
  database: "c02_rr_strategy", adapter: Sqlite, url: "sqlite3:#{C02_RR_A}", role: :reading).or_panic

assert ConnectionRegistry.get_load_balancer("c02_rr_strategy").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer).strategy.object_id == C02StrategyRecord.load_balancing_strategy.object_id
ConnectionRegistry.remove_connection("c02_rr_strategy", :reading).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

# it: applies a strategy set at runtime to replicas that already exist
register_readers
strategy = ::Grant::ReplicaLoadBalancer::RandomStrategy.new
C02RoutedRecord.load_balancing_strategy = strategy

assert ConnectionRegistry.get_load_balancer("c02_rr_reader").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer).strategy.object_id == strategy.object_id
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 0).or_panic
ConnectionRegistry.remove_connection("c02_rr_reader", :reading, replica_index: 1).or_panic

ConnectionRegistry.remove_connection("c02_rr_writer", :writing).or_panic
ConnectionRegistry.remove_connection("c02_rr_strategy", :reading).or_panic
[C02_RR_W, C02_RR_A, C02_RR_B].each { |path| File.delete(path) }
Dir.delete(C02_RR_DIR)
C02Support.cleanup
