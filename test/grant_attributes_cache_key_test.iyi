module test/grant_attributes_cache_key_test

import grant/base::{Base}
import test/attribute_spec_models::{AttrPost}
import test/spec_helper::{register_spec_connections}
import grant/events::{SQL}
import grant/notifications
import std/text
import std/time::{Time}

pub class AttrSlugged < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table attr_slugged
  column id : Int64, primary: true
  column slug : String?
  to_param :slug
end

pub class AttrPlain < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table attr_plains
  column id : Int64, primary: true
  column note : String
end

private def clear_records : Nil
  AttrPost.clear.or_panic
  AttrSlugged.clear.or_panic
  AttrPlain.clear.or_panic
  nil
end

private def capture_sql(&block : -> T) : Array(String) forall T
  statements = [] of String
  subscription = ::Grant::Notifications.subscribe(SQL) do |event|
    statements << event.sql
    nil
  end
  yield
  subscription.unsubscribe
  statements
end

private def cache_stamp(stamp : Time) : String
  stamp.year.to_s.rjust(4, '0') + stamp.month.to_s.rjust(2, '0') +
    stamp.day.to_s.rjust(2, '0') + stamp.hour.to_s.rjust(2, '0') +
    stamp.minute.to_s.rjust(2, '0') + stamp.second.to_s.rjust(2, '0') +
    (stamp.nanosecond // 1000).to_s.rjust(6, '0')
end

register_spec_connections
AttrPost.migrator.drop_and_create.or_panic
AttrSlugged.migrator.drop_and_create.or_panic
AttrPlain.migrator.drop_and_create.or_panic

# it: builds keys for new and persisted records
clear_records
post = AttrPost.new
assert post.to_key.nil?
assert post.to_param.nil?
assert post.cache_key == "attr_posts/new"
post.save_strict.or_panic
assert post.to_key == [post.id]
assert post.to_param == post.id.to_s
assert post.cache_key == "attr_posts/#{post.id}"

# it: versions from the in-memory updated_at without querying
clear_records
post = AttrPost.create_strict(title: "v").or_panic
stamp = post.updated_at.as(Time)
expected = cache_stamp(stamp)
statements = capture_sql do
  assert post.cache_version == expected
  assert post.cache_key_with_version == "attr_posts/#{post.id}-#{expected}"
end
assert statements.empty?

# it: has no version without an updated_at
clear_records
plain = AttrPlain.create_strict(note: "n").or_panic
assert plain.cache_version.nil?
assert plain.cache_key_with_version == plain.cache_key

# it: supports to_param :column overrides
clear_records
slugged = AttrSlugged.new(slug: "hello-world")
assert slugged.to_param.nil?
slugged.save_strict.or_panic
assert slugged.to_param == "hello-world"

# it: builds collection_cache_key from one aggregate query
clear_records
AttrPost.create_strict(title: "a").or_panic
newest = AttrPost.create_strict(title: "b").or_panic
relation = AttrPost.where(published: nil)
key = nil.as(String?)
statements = capture_sql { key = relation.collection_cache_key.or_panic }
assert statements.size == 1
assert statements.first.includes?("COUNT(*)")
assert statements.first.includes?("MAX(")
assert key.to_s.starts_with?("attr_posts/query-")
assert key.to_s.includes?("-2-")
assert key.to_s.ends_with?(cache_stamp(newest.updated_at.as(Time)))

# it: changes collection_cache_key when rows change
clear_records
AttrPost.create_strict(title: "a").or_panic
before = AttrPost.collection_cache_key.or_panic
AttrPost.create_strict(title: "b").or_panic
assert AttrPost.collection_cache_key.or_panic != before

# Memoized aggregate versions reset on an in-place relation change.
relation = AttrPost.all
version = ""
statements = capture_sql do
  version = relation.cache_version.or_panic
  assert relation.cache_version.or_panic == version
end
assert statements.size == 1
assert version.starts_with?("2-")
relation.where_in_place(title: "a")
statements = capture_sql { version = relation.cache_version.or_panic }
assert statements.size == 1
assert version.starts_with?("1-")
statements = capture_sql { assert AttrPost.none.cache_version.or_panic == "0" }
assert statements.empty?
AttrPlain.create_strict(note: "count only").or_panic
assert AttrPlain.all.cache_version.or_panic == "1"
