module test/grant_querying_reload_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}
import grant/querying::{NotFound}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: reloads the record from the database
Parent.clear.or_panic
parent = Parent.create(name: "Parent")
Parent.find_strict(parent.id).or_panic.update(name: "Other").or_panic
assert parent.reload.or_panic.name == "Other"

# it: refreshes the receiver in place and clears dirty state
Parent.clear.or_panic
parent = Parent.create_strict(name: "Original").or_panic
parent.name = "Unsaved change"
assert parent.changed?
Parent.find_strict(parent.id).or_panic.update_strict(name: "Changed elsewhere").or_panic
reloaded = parent.reload.or_panic
assert reloaded.object_id == parent.object_id
assert parent.name == "Changed elsewhere"
assert !parent.changed?
assert parent.changes.empty?
assert parent.previous_changes.empty?

# it: raises an error if the record no longer exists
Parent.clear.or_panic
parent = Parent.create(name: "Parent")
parent.destroy.or_panic
assert parent.reload.is_a?(NotFound)
