module test/grant_query_implicit_order_test

import grant/base::{Base}
import grant/settings::{settings}
import test/spec_helper::{register_spec_connections}
import test/transaction_crud_models::{Parent}
import test/query_relation_sql_capture::{capture_sql, seed_parents}

pub class ImplicitOrderParent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
  timestamps
  implicit_order_column :name
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: no longer forces ORDER BY primary key DESC
assert !settings.implicit_order
assert !Parent.where(name: "a").to_sql.includes?("ORDER BY")
assert !Parent.all.to_sql.includes?("ORDER BY")
assert !Parent.where("name != ?", "zzz").limit(3).to_sql.includes?("ORDER BY")

# it: runs unordered reads without ORDER BY
seed_parents(["a", "b"])
statements = capture_sql { Parent.where("name != ?", "zzz").to_a.or_panic }
assert statements.size == 1
assert !statements.first.includes?("ORDER BY")

# it: still orders first, last and find_each by the primary key
seed_parents(["c", "a", "b"])
ids = Parent.order(:id).to_a.or_panic.map(&.id)
assert Parent.first.or_panic.as(Parent).id == ids.first
assert Parent.last.or_panic.as(Parent).id == ids.last
assert Parent.where("name != ?", "zzz").first.or_panic.as(Parent).id == ids.first
assert Parent.where("name != ?", "zzz").last.or_panic.as(Parent).id == ids.last
seen = [] of Int64?
Parent.find_each(batch_size: 2) { |parent| seen << parent.id }.or_panic
assert seen == ids
seen = [] of Int64?
Parent.where("name != ?", "zzz").find_each(batch_size: 2) { |parent| seen << parent.id }.or_panic
assert seen == ids

# it: orders first ascending and last descending by primary key in SQL
seed_parents(["a", "b"])
assert capture_sql { Parent.first.or_panic }.first.includes?("ORDER BY id ASC")
assert capture_sql { Parent.last.or_panic }.first.includes?("ORDER BY id DESC")

# it: keeps an explicit ORDER BY untouched
seed_parents(["c", "a", "b"])
assert Parent.order(:name).first.or_panic.as(Parent).name == "a"
assert Parent.order(name: :desc).first.or_panic.as(Parent).name == "c"
assert Parent.order(:name).last.or_panic.as(Parent).name == "c"

# it: restores ORDER BY primary key DESC when Grant.settings.implicit_order is true
seed_parents(["a", "b"])
settings.implicit_order = true
assert Parent.where(name: "a").to_sql.includes?("ORDER BY")
assert Parent.where(name: "a").to_sql.includes?("DESC")
assert Parent.where("name != ?", "zzz").to_a.or_panic.compact_map(&.name) == ["b", "a"]
assert Parent.order(:name).to_sql.includes?("ORDER BY name ASC")
settings.implicit_order = false
assert !Parent.where(name: "a").to_sql.includes?("ORDER BY")

# it: declares the columns
assert ImplicitOrderParent.implicit_order_columns == ["name"]
assert Parent.implicit_order_columns.empty?

# it: drives first and last, with the primary key as tiebreaker
seed_parents(["c", "a", "b", "a"])
assert ImplicitOrderParent.first.or_panic.as(ImplicitOrderParent).name == "a"
assert ImplicitOrderParent.last.or_panic.as(ImplicitOrderParent).name == "c"
assert ImplicitOrderParent.where("name != ?", "zzz").first.or_panic.as(ImplicitOrderParent).name == "a"
assert ImplicitOrderParent.where("name != ?", "zzz").first(3).or_panic.compact_map(&.name) == ["a", "a", "b"]
assert ImplicitOrderParent.where("name != ?", "zzz").last(2).or_panic.compact_map(&.name) == ["b", "c"]
assert ImplicitOrderParent.second.or_panic.as(ImplicitOrderParent).name == "a"
assert ImplicitOrderParent.third.or_panic.as(ImplicitOrderParent).name == "b"
firsts = ImplicitOrderParent.where(name: "a").order(:id).to_a.or_panic
assert ImplicitOrderParent.where(name: "a").first.or_panic.as(ImplicitOrderParent).id == firsts.first.id
assert ImplicitOrderParent.where(name: "a").last.or_panic.as(ImplicitOrderParent).id == firsts.last.id

# it: puts the implicit columns and then the key in the SQL
seed_parents(["a"])
assert capture_sql { ImplicitOrderParent.where("name != ?", "zzz").first.or_panic }.first.includes?("ORDER BY name ASC, id ASC")
assert capture_sql { ImplicitOrderParent.where("name != ?", "zzz").last.or_panic }.first.includes?("ORDER BY name DESC, id DESC")

# it: drives find_each and find_in_batches
seed_parents(["c", "a", "b", "d", "e"])
seen_names = [] of String?
ImplicitOrderParent.where("name != ?", "zzz").find_each(batch_size: 2) { |parent| seen_names << parent.name }.or_panic
assert seen_names == ["a", "b", "c", "d", "e"]
seen_names = [] of String?
ImplicitOrderParent.find_each(batch_size: 2) { |parent| seen_names << parent.name }.or_panic
assert seen_names == ["a", "b", "c", "d", "e"]
batches = [] of Array(String?)
ImplicitOrderParent.where("name != ?", "zzz").find_in_batches(batch_size: 2) { |batch| batches << batch.map(&.name) }.or_panic
assert batches == [["a", "b"], ["c", "d"], ["e"]]

# it: does not order plain relations
assert !ImplicitOrderParent.where(name: "a").to_sql.includes?("ORDER BY")
assert !ImplicitOrderParent.all.to_sql.includes?("ORDER BY")

# it: yields to an explicit order
seed_parents(["c", "a", "b"])
assert ImplicitOrderParent.order(name: :desc).first.or_panic.as(ImplicitOrderParent).name == "c"
assert ImplicitOrderParent.order(name: :desc).last.or_panic.as(ImplicitOrderParent).name == "a"

Parent.adapter.close.or_panic
