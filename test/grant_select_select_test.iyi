module test/grant_select_select_test

import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class Article < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table articles
  column id : Int64, primary: true
  column articlebody : String?
end

pub class Comment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table comments
  column id : Int64, primary: true
  column commentbody : String?
  column articleid : Int64?
end

pub class ArticleViewModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column articlebody : String?
  column commentbody : String?
  select_statement "SELECT articles.id, articles.articlebody, comments.commentbody FROM articles JOIN comments ON comments.articleid = articles.id"
end

pub class EventCon < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table "event_cons"
  column id : Int64, primary: true
  column con_name : String
  column event_name : String?
  select_statement "select con_name FROM event_cons"
end

pub def reset_records : Nil
  Article.clear.or_panic
  Comment.clear.or_panic
  EventCon.clear.or_panic
  nil
end

register_spec_connections
Article.migrator.drop_and_create.or_panic
Comment.migrator.drop_and_create.or_panic
EventCon.migrator.drop_and_create.or_panic

# it: generates custom SQL with the query macro
reset_records
assert ArticleViewModel.select == "SELECT articles.id, articles.articlebody, comments.commentbody FROM articles JOIN comments ON comments.articleid = articles.id"

# it: uses custom SQL to populate a view model - #all
reset_records
first = Article.new
first.articlebody = "The Article Body"
first.save_strict.or_panic
comment = Comment.new
comment.commentbody = "The Comment Body"
comment.articleid = first.id
comment.save_strict.or_panic
viewmodel = ArticleViewModel.all.to_a.or_panic
assert viewmodel.first.articlebody == "The Article Body"
assert viewmodel.first.commentbody == "The Comment Body"

# it: allow only selecting specific columns
reset_records
EventCon.create(con_name: "Con0", event_name: "Event0")
EventCon.create(con_name: "Con1", event_name: "Event1")
EventCon.create(con_name: "Con2", event_name: "Event2")
EventCon.all.to_a.or_panic.each_with_index do |env, idx|
  assert env.id.nil?
  assert env.con_name == "Con#{idx}"
  assert env.event_name.nil?
end

Article.adapter.close.or_panic
