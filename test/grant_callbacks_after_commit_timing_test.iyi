module test/grant_callbacks_after_commit_timing_test
import grant/base::{Base}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{enqueue_pending_callback}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class CommitTimingModel < Base
  connection sqlite
  table commit_timing_models

  column id : Int64, primary: true
  column name : String?
  timestamps

  # Shared log so tests can observe callback order vs. transaction boundary.
  @@event_log = [] of String
  def self.event_log : Array(String)
    @@event_log
  end
  def self.event_log=(value : Array(String)) : Array(String)
    @@event_log = value
  end

  after_commit do
    CommitTimingModel.event_log << "after_commit:#{name}"
  end

  after_rollback do
    CommitTimingModel.event_log << "after_rollback:#{name}"
  end

  after_create_commit do
    CommitTimingModel.event_log << "after_create_commit:#{name}"
  end

  after_update_commit do
    CommitTimingModel.event_log << "after_update_commit:#{name}"
  end

  after_destroy_commit do
    CommitTimingModel.event_log << "after_destroy_commit:#{name}"
  end
end

# A second, unrelated model class — used to verify cross-model semantics.
pub class CommitTimingOther < Base
  connection sqlite
  table commit_timing_others

  column id : Int64, primary: true
  column label : String?
  timestamps

  @@event_log = [] of String
  def self.event_log : Array(String)
    @@event_log
  end
  def self.event_log=(value : Array(String)) : Array(String)
    @@event_log = value
  end

  after_commit do
    CommitTimingOther.event_log << "after_commit:#{label}"
  end

  after_rollback do
    CommitTimingOther.event_log << "after_rollback:#{label}"
  end
end


register_spec_connections
CommitTimingModel.migrator.drop_and_create.or_panic
CommitTimingOther.migrator.drop_and_create.or_panic

def reset_logs : Nil
  CommitTimingModel.event_log.clear
  CommitTimingOther.event_log.clear
  nil
end

# it: does NOT fire after_commit while the block is still running
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
fired_inside = false

CommitTimingModel.transaction do
  m = CommitTimingModel.new(name: "mid-block")
  m.save

  # callback must not have fired yet
  fired_inside = CommitTimingModel.event_log.any?(&.starts_with?("after_commit"))
end

assert !fired_inside

# it: fires after_commit exactly once after outermost COMMIT
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.transaction do
  m = CommitTimingModel.new(name: "committed")
  m.save
end

ac = CommitTimingModel.event_log.select { |e| e == "after_commit:committed" }
assert ac.size == 1

# it: fires after_create_commit after outermost COMMIT (not before)
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
seq = [] of String

CommitTimingModel.transaction do
  m = CommitTimingModel.new(name: "newrec")
  m.save
  seq << "still_in_tx"
end
seq << "after_tx"

# Verify the callback fired after the transaction, not inside
# event_log receives the callback; seq records what ran synchronously
assert CommitTimingModel.event_log.includes?("after_create_commit:newrec")
assert CommitTimingModel.event_log.includes?("after_commit:newrec")

# it: fires after_update_commit after outermost COMMIT
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
m = CommitTimingModel.create_strict(name: "orig").or_panic
reset_logs

CommitTimingModel.transaction do
  m.name = "updated"
  m.save
end

assert CommitTimingModel.event_log.includes?("after_update_commit:updated")
assert CommitTimingModel.event_log.includes?("after_commit:updated")

# it: fires after_destroy_commit after outermost COMMIT
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
m = CommitTimingModel.create_strict(name: "to_destroy").or_panic
reset_logs

CommitTimingModel.transaction do
  m.destroy
end

assert CommitTimingModel.event_log.includes?("after_destroy_commit:to_destroy")
assert CommitTimingModel.event_log.includes?("after_commit:to_destroy")

# it: fires after_rollback (not after_commit) when block raises
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
error = begin
  CommitTimingModel.transaction do
    CommitTimingModel.new(name: "lost").save
    ErrorBase.new("kaboom")
  end
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "kaboom"

assert CommitTimingModel.event_log.includes?("after_rollback:lost")
assert !CommitTimingModel.event_log.includes?("after_commit:lost")

# it: fires after_rollback when Grant::Transaction::Rollback is raised
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.transaction do
  CommitTimingModel.new(name: "sentinel").save
  Rollback.new
end

assert CommitTimingModel.event_log.includes?("after_rollback:sentinel")
assert !CommitTimingModel.event_log.includes?("after_commit:sentinel")

# it: fires after_commit immediately on success (implicit single-save tx)
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.new(name: "solo").save

assert CommitTimingModel.event_log.includes?("after_commit:solo")

# it: does NOT fire after_rollback on a successful implicit save
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.new(name: "solo-ok").save

assert !CommitTimingModel.event_log.includes?("after_rollback:solo-ok")

# it: fires after_commit for both model classes after the single commit
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.transaction do
  CommitTimingModel.new(name: "alpha").save
  CommitTimingOther.new(label: "beta").save
end

assert CommitTimingModel.event_log.includes?("after_commit:alpha")
assert CommitTimingOther.event_log.includes?("after_commit:beta")

# it: fires after_rollback for both model classes on exception
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
error = begin
  CommitTimingModel.transaction do
    CommitTimingModel.new(name: "alpha-rb").save
    CommitTimingOther.new(label: "beta-rb").save
    ErrorBase.new("tx fail")
  end
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "tx fail"

assert CommitTimingModel.event_log.includes?("after_rollback:alpha-rb")
assert CommitTimingOther.event_log.includes?("after_rollback:beta-rb")

# it: defers callbacks from inner savepoint until outermost commit
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.transaction do
  CommitTimingModel.transaction do
    CommitTimingModel.new(name: "inner").save
    # Still inside outer — must not have fired
    assert CommitTimingModel.event_log.empty?
  end
  # Released savepoint — still inside outer — still must not have fired
  assert CommitTimingModel.event_log.empty?
end

assert CommitTimingModel.event_log.includes?("after_commit:inner")

# it: fires after_rollback (never after_commit) for saves undone by a savepoint rollback
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
CommitTimingModel.transaction do
  CommitTimingModel.new(name: "kept").save

  CommitTimingModel.transaction(requires_new: true) do
    CommitTimingModel.new(name: "undone").save
    Rollback.new
  end
end

assert CommitTimingModel.event_log.includes?("after_rollback:undone")
assert !CommitTimingModel.event_log.includes?("after_commit:undone")
# The outer save is untouched by the savepoint rollback
assert CommitTimingModel.event_log.includes?("after_commit:kept")
assert !CommitTimingModel.event_log.includes?("after_rollback:kept")

# it: does NOT fire the outer transaction's callbacks when the inner one commits
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
outer_fired_after_inner_commit = false

CommitTimingModel.transaction do
  CommitTimingModel.new(name: "outer-rec").save

  CommitTimingModel.transaction(independent: true) do
    # no-op inner body: its COMMIT must not touch the outer's queue
  end

  outer_fired_after_inner_commit =
    CommitTimingModel.event_log.includes?("after_commit:outer-rec")
end

assert !outer_fired_after_inner_commit
assert CommitTimingModel.event_log.includes?("after_commit:outer-rec")

# it: still fires the outer save's after_rollback when the outer rolls back after an inner commit
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
error = begin
  CommitTimingModel.transaction do
    CommitTimingModel.new(name: "outer-doomed").save

    CommitTimingModel.transaction(independent: true) do
      # inner commits independently; outer's callbacks must survive it
    end

    ErrorBase.new("outer dies")
  end
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer dies"

# Outer tx rolled back — its save gets after_rollback, never after_commit.
# (Under the old fiber-global queue the inner COMMIT had already drained
# and FIRED after_commit:outer-doomed against data that was never
# durably committed.)
assert CommitTimingModel.event_log.includes?("after_rollback:outer-doomed")
assert !CommitTimingModel.event_log.includes?("after_commit:outer-doomed")

# it: keeps inner savepoint callbacks until the outer transaction completes
CommitTimingModel.clear.or_panic
CommitTimingOther.clear.or_panic
reset_logs
error = begin
  CommitTimingModel.transaction do
    CommitTimingModel.new(name: "outer-doomed-inner-commit").save

    CommitTimingModel.transaction do
      # A released savepoint is not durable while the outer transaction
      # is open. Enqueue directly to avoid SQLite's second-writer limit.
      enqueue_pending_callback(
        -> { CommitTimingModel.event_log << "after_commit:inner-savepoint"; nil },
        -> { CommitTimingModel.event_log << "after_rollback:inner-savepoint"; nil }
      )
    end

    assert !CommitTimingModel.event_log.includes?("after_commit:inner-savepoint")
    assert !CommitTimingModel.event_log.includes?("after_rollback:inner-savepoint")
    assert !CommitTimingModel.event_log.includes?("after_commit:outer-doomed-inner-commit")
    ErrorBase.new("outer dies")
  end
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer dies"

assert CommitTimingModel.event_log.includes?("after_rollback:inner-savepoint")
assert CommitTimingModel.event_log.includes?("after_rollback:outer-doomed-inner-commit")
assert !CommitTimingModel.event_log.includes?("after_commit:inner-savepoint")
assert CommitTimingModel.where(name: "outer-doomed-inner-commit").select.or_panic.first?.nil?
CommitTimingModel.adapter.close.or_panic
