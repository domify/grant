module test/grant_persistence_helpers_operations_test
import grant/base
import std/env
import std/text
import test/spec_helper::{register_spec_connections}
import grant/error::{ErrorBase}
register_spec_connections

pub class PersistenceWidget < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table persistence_widgets

  column id : Int64, primary: true
  column name : String?
  column counter : Int32?
  column big_counter : Int64?
  column active : Bool?

  validate :name, "Name cannot be blank" do |w|
    !w.name.to_s.strip.empty?
  end
end

# Model with callbacks to prove update_attribute runs callbacks while
# update_columns skips them.
pub class CallbackWidget < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table callback_widgets

  column id : Int64, primary: true
  column name : String?

  property before_save_count : Int32 = 0

  before_save :bump

  def bump : Nil
    @before_save_count += 1
    nil
  end
end


PersistenceWidget.migrator.drop_and_create.or_panic
CallbackWidget.migrator.drop_and_create.or_panic

# it: persists a single attribute
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Original", counter: 0).or_panic
assert w.update_attribute(:name, "Changed").or_panic
assert PersistenceWidget.find_strict(w.id).or_panic.name == "Changed"

# it: skips validations (saves even when the record is invalid)
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Valid", counter: 0).or_panic
assert w.update_attribute(:name, "").or_panic
reloaded = PersistenceWidget.find_strict(w.id).or_panic
assert reloaded.name == ""

# it: raises on failure with the bang variant when validation is bypassed but save fails
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Valid", counter: 0).or_panic
assert w.update_attribute_strict(:counter, 5).or_panic
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 5

# it: updates the column directly and in-memory
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Original", counter: 1).or_panic
assert w.update_columns(name: "Direct").or_panic
assert w.name == "Direct"
assert PersistenceWidget.find_strict(w.id).or_panic.name == "Direct"

# it: skips callbacks
PersistenceWidget.clear
CallbackWidget.clear
w = CallbackWidget.create_strict(name: "Start").or_panic
assert w.before_save_count == 1
w.update_columns(name: "NoCallback").or_panic
assert w.before_save_count == 1
assert CallbackWidget.find_strict(w.id).or_panic.name == "NoCallback"

# it: skips validations
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Valid", counter: 0).or_panic
assert w.update_columns(name: "").or_panic
assert PersistenceWidget.find_strict(w.id).or_panic.name == ""

# it: raises on a new (unsaved) record
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.new(name: "New")
error = w.update_columns(name: "Nope")
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("new record")

# it: increment! persists +1 by default
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Counter", counter: 10).or_panic
w.increment_strict(:counter).or_panic
assert w.counter == 11
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 11

# it: increment! accepts a custom step
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Counter", counter: 10).or_panic
w.increment_strict(:counter, 5).or_panic
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 15

# it: decrement! persists -1 by default
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Counter", counter: 10).or_panic
w.decrement_strict(:counter).or_panic
assert w.counter == 9
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 9

# it: non-bang increment mutates in-memory only
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Counter", counter: 10).or_panic
w.increment(:counter, 3).or_panic
assert w.counter == 13
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 10

# it: skips validations on increment!
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Valid", counter: 0).or_panic
w.name = ""
w.increment_strict(:counter).or_panic
assert PersistenceWidget.find_strict(w.id).or_panic.counter == 1

# it: flips a boolean and persists
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Toggler", active: false).or_panic
w.toggle_strict(:active).or_panic
assert w.active == true
assert PersistenceWidget.find_strict(w.id).or_panic.active == true

# it: non-bang toggle mutates in-memory only
PersistenceWidget.clear
CallbackWidget.clear
w = PersistenceWidget.create_strict(name: "Toggler", active: false).or_panic
w.toggle(:active).or_panic
assert w.active == true
assert PersistenceWidget.find_strict(w.id).or_panic.active == false

PersistenceWidget.adapter.close.or_panic
