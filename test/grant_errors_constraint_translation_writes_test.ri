module test/grant_errors_constraint_translation_writes_test
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite, Value}
import grant/connection_registry::{ConnectionRegistry}
import grant/errors::{RecordNotSaved, RecordInvalid}
import grant/error_taxonomy::{StatementInvalid, RecordNotUnique, InvalidForeignKey, NotNullViolation}
import grant/adapter/sqlite_connection::{SQLiteError}
import grant/adapter/pg_connection::{PQError}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class G01Account < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table g01_accounts
  column id : Int64, primary: true
  column email : String
  column code : String?
end

pub class G01Note < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table g01_notes
  column id : Int64, primary: true
  column account_id : Int64?
  column body : String?
end

private def create_g01_tables
  adapter = G01Account.adapter
  statements = if adapter.postgres?
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id BIGSERIAL PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id BIGSERIAL PRIMARY KEY, account_id BIGINT REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               else
                 # The MySQL branch is adapter-out-of-scope.
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id INTEGER PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id INTEGER PRIMARY KEY, account_id INTEGER REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               end
  statements.each { |statement| adapter.open { |db| db.exec(statement) }.or_panic }
end

register_spec_connections

# it: raises RecordNotUnique for a duplicate key
create_g01_tables
G01Account.adapter.open { |db| db.exec("INSERT INTO g01_accounts (email) VALUES ('a@example.com')") }.or_panic
statement = "INSERT INTO g01_accounts (email) VALUES (?)"
error = G01Account.adapter.open(statement, ["a@example.com"] of Value) do |db|
  db.exec(G01Account.adapter.ensure_clause_template(statement), ["a@example.com"] of Value)
end
assert error.is_a?(RecordNotUnique)
assert error.is_a?(StatementInvalid)
assert !error.as(StatementInvalid).cause.nil?

# it: raises RecordNotUnique through the adapter's insert
create_g01_tables
G01Account.create_strict(email: "dup@example.com").or_panic
error = G01Account.adapter.insert("g01_accounts", ["email"], ["dup@example.com"] of Value, lastval: nil)
assert error.is_a?(RecordNotUnique)

# it: raises InvalidForeignKey for a missing parent
create_g01_tables
error = G01Note.adapter.insert("g01_notes", ["account_id"], [999_i64] of Value, lastval: nil)
assert error.is_a?(InvalidForeignKey)

# it: raises InvalidForeignKey when deleting a referenced parent
create_g01_tables
account = G01Account.create_strict(email: "parent@example.com").or_panic
G01Note.create_strict(account_id: account.id, body: "child").or_panic
error = G01Account.adapter.delete("g01_accounts", "id", account.id)
assert error.is_a?(InvalidForeignKey)

# it: raises NotNullViolation for a NULL in a NOT NULL column
create_g01_tables
statement = "INSERT INTO g01_accounts (email) VALUES (NULL)"
error = G01Account.adapter.open(statement) { |db| db.exec(statement) }
assert error.is_a?(NotNullViolation)

# it: translates errors raised inside a transaction block
create_g01_tables
G01Account.create_strict(email: "tx@example.com").or_panic
error = G01Account.transaction do
  G01Account.adapter.insert("g01_accounts", ["email"], ["tx@example.com"] of Value, lastval: nil)
end
assert error.is_a?(RecordNotUnique)
assert G01Account.count.or_panic == 1

# it: exposes the translated error on RecordNotSaved from create!
create_g01_tables
G01Account.create_strict(email: "same@example.com").or_panic
error = G01Account.create_strict(email: "same@example.com")
assert error.is_a?(RecordNotSaved)
assert !error.is_a?(RecordInvalid)
assert error.as(RecordNotSaved).statement_error.is_a?(RecordNotUnique)

# it: keeps save returning false with the driver message on the record
create_g01_tables
G01Account.create_strict(email: "same@example.com").or_panic
duplicate = G01Account.new(email: "same@example.com")
assert duplicate.save.or_panic == false
assert duplicate.errors.empty? == false

# it: reports a foreign key failure from save! as RecordNotSaved with an InvalidForeignKey cause
create_g01_tables
note = G01Note.new(account_id: 424242_i64, body: "orphan")
error = note.save_strict
assert error.is_a?(RecordNotSaved)
assert error.as(RecordNotSaved).statement_error.is_a?(InvalidForeignKey)

# Native checks retain SQL, redacted binds and the driver's exact cause;
# failed writes roll back preceding work and leave the connection usable.
create_g01_tables
account = G01Account.create_strict(email: "original@example.com").or_panic
error = G01Account.transaction do
  G01Account.create_strict(email: "rolled-back@example.com").or_panic
  G01Account.adapter.insert("g01_accounts", ["email"], ["original@example.com"] of Value, lastval: nil)
end
assert error.is_a?(RecordNotUnique)
failure = error.as(RecordNotUnique)
assert failure.sql == "INSERT INTO \"g01_accounts\" (\"email\") VALUES (?)"
assert failure.binds == ["[FILTERED]"]
if G01Account.adapter.postgres?
  assert failure.cause.is_a?(PQError)
  assert failure.cause.as(PQError).sqlstate == "23505"
else
  assert failure.cause.is_a?(SQLiteError)
  assert failure.cause.as(SQLiteError).code == 19
end
assert G01Account.count.or_panic == 1
assert G01Account.find_strict(account.id).or_panic.email == "original@example.com"
assert G01Account.adapter.insert("g01_accounts", ["email"], ["fresh@example.com"] of Value, lastval: "id").or_panic > 0
assert G01Account.count.or_panic == 2
duplicate = G01Account.new(email: "original@example.com")
assert duplicate.save.or_panic == false
assert duplicate.new_record?
assert duplicate.errors.first.message.includes?(G01Account.adapter.postgres? ? "duplicate key value" : "UNIQUE constraint failed")
duplicate.email = "recovered@example.com"
assert duplicate.save.or_panic
assert duplicate.errors.empty?
assert G01Account.adapter.delete("g01_accounts", "id", duplicate.id).or_panic.changes == 1
