module test/grant_locking_lock_clause_test
import grant/base::{Base}
import grant/locking::{LockMode}
import grant/locking/clause::{Clause, clause}
import grant/error::{ArgumentError}
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import std/process::{Process}
import std/file::{File}
import std/env::{ENV}
import test/spec_helper::{register_spec_connections}
register_spec_connections

pub class LockClauseSpecItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table lock_clause_spec_items
  column id : Int64, primary: true
  column label : String
end
LockClauseSpecItem.migrator.drop_and_create.or_panic
LOCK_CLAUSE_SPEC_NO_KEY = clause("FOR NO KEY UPDATE")
LOCK_CLAUSE_SPEC_OF = clause("FOR UPDATE OF lock_clause_spec_items")

private def lock_clause_spec_pg : Pg
  Pg.new("lock_clause_pg", "postgres://localhost/lock_clause")
end
private def lock_clause_spec_sqlite : Sqlite
  Sqlite.new("lock_clause_sqlite", "sqlite3::memory:")
end

# it: accepts a string literal and a constant
LockClauseSpecItem.clear.or_panic
assert clause("FOR SHARE").sql == "FOR SHARE"
assert LOCK_CLAUSE_SPEC_NO_KEY.sql == "FOR NO KEY UPDATE"
assert LOCK_CLAUSE_SPEC_NO_KEY.to_s == "FOR NO KEY UPDATE"

# it: rejects a clause that is not plain keywords and identifiers, even from a constant
LockClauseSpecItem.clear.or_panic
injected = "FOR UPDATE; DROP TABLE lock_clause_spec_items"
error = Clause.__from_literal(injected)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Invalid lock clause")
assert Clause.__from_literal("FOR UPDATE -- x").is_a?(ArgumentError)
assert Clause.__from_literal("").is_a?(ArgumentError)
assert Clause.__from_literal("FOR UPDATE 'x'").is_a?(ArgumentError)

# it: does not compile for a value built at runtime
LockClauseSpecItem.clear.or_panic
source = "lock_clause_runtime_probe.ri"
defer File.delete(source) if File.exists?(source)
File.write(source, <<-IYI
module lock_clause_runtime
import grant/locking/clause::{clause}
import std/env::{ENV}
name = ENV["LOCK_NAME"]? || "x"
clause("FOR \#{name}")
IYI
)
compiler = ENV["RIS"]? || "/home/priit/contribute/ris/bin/ris"
status = Process.run(compiler, ["build", source, "-o", "build/tmp/lock_clause_runtime"]).or_panic
assert !status.success?
assert (status.stdout + status.stderr).includes?("takes a string literal or a constant"), status.stdout + status.stderr
File.delete(source)

# it: appends the clause on PostgreSQL
LockClauseSpecItem.clear.or_panic
pg = lock_clause_spec_pg
relation = LockClauseSpecItem.where(id: 1).lock(LOCK_CLAUSE_SPEC_NO_KEY)
assert relation.lock_sql(pg) == "FOR NO KEY UPDATE"
assert relation.lock_clause == LOCK_CLAUSE_SPEC_NO_KEY
assert relation.lock_mode.nil?
assert LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_OF).lock_sql(pg) == "FOR UPDATE OF lock_clause_spec_items"

# it: is a no-op on SQLite, which has no row locks
LockClauseSpecItem.clear.or_panic
assert LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).lock_sql(lock_clause_spec_sqlite) == ""

# it: ends up in the generated select for the running adapter
LockClauseSpecItem.clear.or_panic
sql = LockClauseSpecItem.where(id: 1).lock(LOCK_CLAUSE_SPEC_NO_KEY).to_sql
if LockClauseSpecItem.adapter.supports_lock_mode?(LockMode::Update)
  assert sql.ends_with?("FOR NO KEY UPDATE")
else
  assert !sql.includes?("FOR ")
end

# it: runs on the database (rows come back either way)
LockClauseSpecItem.clear.or_panic
# A raw clause is sent as written. FOR NO KEY UPDATE is PostgreSQL's own
# lock mode, which MySQL does not have, so MySQL runs a clause of its own.
custom_clause = LOCK_CLAUSE_SPEC_NO_KEY
item = LockClauseSpecItem.create_strict(label: "a").or_panic
LockClauseSpecItem.transaction do
  assert LockClauseSpecItem.where(id: item.id).lock(custom_clause).first_strict.or_panic.label == "a"
end.or_panic

# it: lets a clause replace a mode and a mode replace a clause
LockClauseSpecItem.clear.or_panic
by_mode = LockClauseSpecItem.lock(LockMode::Share)
by_clause = by_mode.lock(LOCK_CLAUSE_SPEC_NO_KEY)
assert by_clause.lock_mode.nil?
assert !by_clause.lock_clause.nil?
back = by_clause.lock(LockMode::UpdateNoWait)
assert back.lock_clause.nil?
assert back.lock_mode == LockMode::UpdateNoWait

# it: never changes the relation it was called on
LockClauseSpecItem.clear.or_panic
original = LockClauseSpecItem.lock
original.lock(LOCK_CLAUSE_SPEC_NO_KEY)
original.unlock
assert original.lock_mode == LockMode::Update
assert original.lock_clause.nil?

# it: drops a mode lock
LockClauseSpecItem.clear.or_panic
relation = LockClauseSpecItem.where(id: 1).lock
assert relation.unlock.lock_mode.nil?
assert relation.unlock.lock_sql(lock_clause_spec_pg).nil?
assert !relation.unlock.to_sql.includes?("FOR ")

# it: drops a clause lock
LockClauseSpecItem.clear.or_panic
relation = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).unlock
assert relation.lock_clause.nil?
assert relation.lock_sql(lock_clause_spec_pg).nil?

# it: is what lock(false) does, and lock(true) is plain lock
LockClauseSpecItem.clear.or_panic
assert LockClauseSpecItem.lock.lock(false).lock_mode.nil?
assert LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).lock(false).lock_clause.nil?
assert LockClauseSpecItem.lock(true).lock_mode == LockMode::Update
assert LockClauseSpecItem.lock(LockMode::Share).lock(true).lock_mode == LockMode::Update

# it: clears a lock inherited from a named scope or a merge
LockClauseSpecItem.clear.or_panic
locked = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY)
merged = LockClauseSpecItem.where(id: 1).merge(locked)
assert merged.lock_clause == LOCK_CLAUSE_SPEC_NO_KEY
assert merged.unlock.lock_clause.nil?
assert merged.unscope(:lock).lock_clause.nil?

# it: reports locked? for either kind of lock
LockClauseSpecItem.clear.or_panic
assert !LockClauseSpecItem.where(id: 1).locked?
assert LockClauseSpecItem.lock.locked?
assert LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).locked?
assert !LockClauseSpecItem.lock.unlock.locked?

# it: leaves a relation that was never locked untouched
LockClauseSpecItem.clear.or_panic
assert LockClauseSpecItem.where(id: 1).unlock.lock_mode.nil?

# it: keeps the receiver's lock when the other relation has none
LockClauseSpecItem.clear.or_panic
merged = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).merge(LockClauseSpecItem.where(id: 1))
assert merged.lock_clause == LOCK_CLAUSE_SPEC_NO_KEY

# it: takes the other relation's mode over a clause
LockClauseSpecItem.clear.or_panic
merged = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).merge(LockClauseSpecItem.lock(LockMode::Share))
assert merged.lock_clause.nil?
assert merged.lock_mode == LockMode::Share

# it: treats two different clauses as incompatible for and/or
LockClauseSpecItem.clear.or_panic
first = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_NO_KEY).where(id: 1)
second = LockClauseSpecItem.lock(LOCK_CLAUSE_SPEC_OF).where(id: 2)
assert first.or_where(second).select.is_a?(ArgumentError)
