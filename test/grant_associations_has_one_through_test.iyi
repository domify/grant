module test/grant_associations_has_one_through_test
import grant/base::{Base}
import grant/querying::{NotFound}
import test/spec_helper::{register_spec_connections}

pub class ThroughUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_users

  column id : Int64, primary: true
  column name : String?

  has_one :profile, class_name: ThroughProfile, foreign_key: :through_user_id
  has_one :avatar, class_name: ThroughAvatar, through: :through_profiles, foreign_key: :through_user_id
end

pub class ThroughProfile < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_profiles

  column id : Int64, primary: true
  column bio : String?
  column through_user_id : Int64?
  column through_avatar_id : Int64?

  belongs_to :through_user, optional: true
  belongs_to :through_avatar, optional: true
end

pub class ThroughAvatar < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_avatars

  column id : Int64, primary: true
  column url : String?
end

register_spec_connections
ThroughUser.migrator.drop_and_create.or_panic
ThroughProfile.migrator.drop_and_create.or_panic
ThroughAvatar.migrator.drop_and_create.or_panic

# it: returns the associated record through an intermediate table
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user = ThroughUser.new
user.name = "Jane"
assert user.save

avatar = ThroughAvatar.new
avatar.url = "https://example.com/jane.png"
assert avatar.save

profile = ThroughProfile.new
profile.bio = "Hello world"
profile.through_user_id = user.id
profile.through_avatar_id = avatar.id
assert profile.save

result = user.avatar.or_panic
assert !result.nil?
assert result.as(ThroughAvatar).id == avatar.id
assert result.as(ThroughAvatar).url == "https://example.com/jane.png"

# it: returns nil when no intermediate record exists
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user = ThroughUser.new
user.name = "Bob"
assert user.save

assert user.avatar.or_panic.nil?

# it: returns nil when intermediate exists but has no target
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user = ThroughUser.new
user.name = "Carol"
assert user.save

profile = ThroughProfile.new
profile.bio = "No avatar"
profile.through_user_id = user.id
profile.through_avatar_id = nil
assert profile.save

assert user.avatar.or_panic.nil?

# it: returns the correct record among multiple users
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user1 = ThroughUser.new
user1.name = "Dave"
assert user1.save

user2 = ThroughUser.new
user2.name = "Eve"
assert user2.save

avatar1 = ThroughAvatar.new
avatar1.url = "https://example.com/dave.png"
assert avatar1.save

avatar2 = ThroughAvatar.new
avatar2.url = "https://example.com/eve.png"
assert avatar2.save

profile1 = ThroughProfile.new
profile1.bio = "Dave's profile"
profile1.through_user_id = user1.id
profile1.through_avatar_id = avatar1.id
assert profile1.save

profile2 = ThroughProfile.new
profile2.bio = "Eve's profile"
profile2.through_user_id = user2.id
profile2.through_avatar_id = avatar2.id
assert profile2.save

assert user1.avatar.or_panic.as(ThroughAvatar).url == "https://example.com/dave.png"
assert user2.avatar.or_panic.as(ThroughAvatar).url == "https://example.com/eve.png"

# it: returns the record when it exists
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user = ThroughUser.new
user.name = "Frank"
assert user.save

avatar = ThroughAvatar.new
avatar.url = "https://example.com/frank.png"
assert avatar.save

profile = ThroughProfile.new
profile.bio = "Frank's profile"
profile.through_user_id = user.id
profile.through_avatar_id = avatar.id
assert profile.save

result = user.avatar_strict.or_panic
assert result.url == "https://example.com/frank.png"

# it: raises NotFound when no record exists
ThroughAvatar.clear.or_panic
ThroughProfile.clear.or_panic
ThroughUser.clear.or_panic
user = ThroughUser.new
user.name = "Grace"
assert user.save

assert user.avatar_strict.is_a?(NotFound)

ThroughUser.adapter.close.or_panic
