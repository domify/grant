module test/grant_convenience_create_block_array_test
import grant/base::{Base}
import grant/errors::{RecordInvalid, RecordNotSaved}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class ConvItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table conv_items
  column id : Int64, primary: true
  column name : String
  column status : String?
  column kind : String?
  column qty : Int32?
  validate :name, "Name cannot be blank" do |item|
    !item.name.to_s.strip.empty?
  end
end

register_spec_connections
ConvItem.migrator.drop_and_create.or_panic
ConvItem.connection.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_conv_items_name ON conv_items(name)").or_panic

# it: yields the record after the attributes are assigned
ConvItem.clear.or_panic
seen : String? = nil
item = ConvItem.new(name: "a") do |record|
  seen = record.name
  record.status = "block"
end
assert seen == "a"
assert item.status == "block"
assert item.new_record?

# it: tracks values set in the block as changes
ConvItem.clear.or_panic
item = ConvItem.new(name: "a") { |record| record.status = "x" }
assert item.status_changed?

# it: accepts an attributes hash
ConvItem.clear.or_panic
item = ConvItem.new({"name" => "h"} of Symbol | String => ::Grant::Adapter::Sqlite::Value) { |record| record.kind = "hash" }
assert item.name == "h"
assert item.kind == "hash"

# it: yields the record before it is saved
ConvItem.clear.or_panic
item = ConvItem.create(name: "a") { |record| record.status = "from block" }
assert item.persisted?
assert ConvItem.find_strict(item.id).or_panic.status == "from block"

# it: lets the block fix an otherwise invalid record
ConvItem.clear.or_panic
assert ConvItem.create(name: "") { |record| record.name = "fixed" }.persisted?

# it: raises from create! with a block when the save fails
ConvItem.clear.or_panic
error = ConvItem.create_strict(name: "") { |record| record.status = "x" }
assert error.is_a?(RecordInvalid)

# it: persists from create! with a block
ConvItem.clear.or_panic
item = ConvItem.create_strict(name: "b") { |record| record.qty = 3 }.or_panic
assert ConvItem.find_strict(item.id).or_panic.qty == 3

# it: creates every record and returns them in order
ConvItem.clear.or_panic
items = ConvItem.create([{name: "one"}, {name: "two"}, {name: "three"}])
assert items.map { |record| record.name } == ["one", "two", "three"]
assert items.all? { |record| record.persisted? }
assert ConvItem.count.or_panic == 3

# it: yields each record to the block
ConvItem.clear.or_panic
items = ConvItem.create([{name: "one"}, {name: "two"}]) { |record| record.status = "bulk" }
assert items.map { |record| record.status } == ["bulk", "bulk"]

# it: returns invalid records unsaved without stopping the others
ConvItem.clear.or_panic
items = ConvItem.create([{name: "ok"}, {name: ""}, {name: "ok2"}])
assert items.map { |record| record.persisted? } == [true, false, true]

# it: raises from create! and rolls the whole batch back
ConvItem.clear.or_panic
error = ConvItem.create_strict([{name: "first"}, {name: ""}])
assert error.is_a?(RecordInvalid)
assert ConvItem.count.or_panic == 0

# it: rolls the whole batch back when a database constraint fails
ConvItem.clear.or_panic
ConvItem.create_strict(name: "taken").or_panic
error = ConvItem.create_strict([{name: "fresh"}, {name: "taken"}])
assert error.is_a?(RecordNotSaved)
assert !ConvItem.where(name: "fresh").exists?.or_panic

# it: runs the whole batch inside one transaction
ConvItem.clear.or_panic
opened_inside = [] of Bool
ConvItem.create([{name: "x"}, {name: "y"}]) { |record| opened_inside << ConvItem.transaction_open? }
assert opened_inside == [true, true]

# Native regression checks for the strict array/block overload and initializer
# callback ordering, alongside the original examples above.
ConvItem.clear.or_panic
captured = [] of ConvItem
result = ConvItem.create_strict([{name: "first"}, {name: "second"}]) do |record|
  captured << record
  record.status = "strict block"
  record.name = "" if record.name == "second"
end
assert result.is_a?(RecordInvalid)
assert ConvItem.count.or_panic == 0
assert captured.size == 2
assert captured.all? { |record| record.new_record? }
assert captured[0].id.nil?
# Rollback restores the pre-save state, including unsaved block attributes.
assert captured[0].status == "strict block"

ConvItem.clear.or_panic
created = ConvItem.create_strict([{name: "first"}, {name: "second"}]) { |record| record.qty = 4 }.or_panic
assert !created.nil?
assert created.as(Array(ConvItem)).map { |record| record.name } == ["first", "second"]
assert created.as(Array(ConvItem)).all? { |record| record.persisted? && record.qty == 4 }

pub class ConvInitItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table conv_init_items
  column id : Int64, primary: true
  column name : String?
  column status : String?
  column seen : String?
  after_initialize :record_seen
  def record_seen
    @seen = "#{@name}/#{@status}"
  end
end
initialized = ConvInitItem.new(name: "assigned") { |record| record.status = "block" }
assert initialized.seen == "assigned/block"
assert initialized.status_changed?
