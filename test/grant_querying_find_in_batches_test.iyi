module test/grant_querying_find_in_batches_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}
import grant/error::{ArgumentError}
import grant/errors::{Rollback}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: finds records in batches and yields all the records
Parent.clear.or_panic
model_ids = (0...100).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save
  model
end.map(&.id)
found_models = [] of Int64?
Parent.find_in_batches(batch_size: 10) do |batch|
  batch.each { |model| found_models << model.id }
  assert batch.size == 10
end.or_panic
assert found_models.compact.sorted == model_ids.compact

# it: doesnt yield when no records are found
Parent.clear.or_panic
Parent.find_in_batches { raise "find_in_batches did yield but shouldn't have" }.or_panic

# it: errors when batch_size is < 1
Parent.clear.or_panic
error = Parent.find_in_batches(batch_size: 0) { raise "should have raised" }
assert error.is_a?(ArgumentError)

# it: returns a small batch when there arent enough results
Parent.clear.or_panic
(0...9).each { |i| Parent.new(name: "model_#{i}").save }
Parent.find_in_batches(batch_size: 11) { |batch| assert batch.size == 9 }.or_panic

# it: can start from an offset other than 0
Parent.clear.or_panic
created_models = (0...10).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save
  model
end.map(&.id)
created_models.shift
created_models.shift
found_models = [] of Int64?
Parent.find_in_batches(offset: 2) do |batch|
  batch.each { |model| found_models << model.id }
end.or_panic
assert found_models.compact.sorted == created_models.compact

# it: doesnt obliterate a parameterized query
Parent.clear.or_panic
created_models = (0...10).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save
  model
end.map(&.id)
looking_for_ids = (0...5).map { |index| created_models[index] }
Parent.find_in_batches("WHERE id IN(#{looking_for_ids.join(",")})") do |batch|
  # Native equality requires matching array element types; every expected ID must be non-nil.
  assert batch.compact_map(&.id) == looking_for_ids.map { |id| id.as(Int64) }
end.or_panic

# Bound predicates and initial offsets survive multiple pages.
found_models.clear
Parent.find_in_batches("WHERE name != ?", ["model_0"], batch_size: 2, offset: 2) do |batch|
  batch.each { |model| found_models << model.id }
end.or_panic
assert found_models == (3...10).map { |index| created_models[index] }
error = Parent.find_in_batches("WHERE id > 0 ORDER BY id") { raise "invalid clause yielded" }
assert error.is_a?(ArgumentError)
seen = 0
error = Parent.find_in_batches(batch_size: 2) do |_batch|
  seen += 1
  Rollback.new
end
assert error.is_a?(Rollback)
assert seen == 1
Parent.adapter.close.or_panic
