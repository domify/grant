module test/grant_querying_relation_calculations_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class RelationCalculationModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table relation_calculation_models
  column id : Int64, primary: true
  column category : String
  column amount : Int64
end

register_spec_connections
RelationCalculationModel.migrator.drop_and_create.or_panic

# it: runs SQL calculations on a filtered relation
RelationCalculationModel.clear.or_panic
RelationCalculationModel.create_strict(category: "included", amount: 10_i64).or_panic
RelationCalculationModel.create_strict(category: "included", amount: 20_i64).or_panic
RelationCalculationModel.create_strict(category: "excluded", amount: 100_i64).or_panic
relation = RelationCalculationModel.where(category: "included")
assert relation.sum(:amount).or_panic == 30.0
assert relation.avg(:amount).or_panic == 15.0
assert relation.average(:amount).or_panic == 15.0
assert relation.min(:amount).or_panic == 10_i64
assert relation.minimum(:amount).or_panic == 10_i64
assert relation.max(:amount).or_panic == 20_i64
assert relation.maximum(:amount).or_panic == 20_i64

# it: returns empty-relation calculation values
RelationCalculationModel.clear.or_panic
relation = RelationCalculationModel.where(category: "missing")
assert relation.sum(:amount).or_panic == 0.0
assert relation.avg(:amount).or_panic.nil?
assert relation.min(:amount).or_panic.nil?
assert relation.max(:amount).or_panic.nil?

RelationCalculationModel.adapter.close.or_panic
