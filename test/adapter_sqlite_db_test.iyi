module test/adapter_sqlite_db_test

import db/db/core::{TransactionState}
import grant/adapter/sqlite_connection::{Connection, Value}
import grant/errors::{DatabaseError}
import std/slice::{Bytes}

conn = Connection.open(":memory:").or_panic
assert conn.native_connection.transaction_state == TransactionState::Idle
assert conn.scalar("PRAGMA foreign_keys").or_panic == 1_i64
assert conn.scalar("PRAGMA busy_timeout").or_panic == 5000_i64
conn.execute("/* raw */ BEGIN").or_panic
assert conn.in_transaction?
assert conn.native_connection.transaction_state == TransactionState::InTransaction
conn.execute("SAVEPOINT nested").or_panic
conn.execute("ROLLBACK TO nested").or_panic
assert conn.in_transaction?
conn.execute("COMMIT").or_panic
assert !conn.in_transaction?

assert conn.execute("CREATE TABLE rejected (id); SELECT 2").is_a?(DatabaseError)
assert conn.scalar("SELECT count(*) FROM sqlite_master WHERE name = 'rejected'").or_panic == 0_i64
assert conn.execute("").is_a?(DatabaseError)
assert conn.scalar("SELECT ?", [] of Value).is_a?(DatabaseError)
assert conn.scalar("SELECT ?", [1_i64, 2_i64] of Value).is_a?(DatabaseError)
assert conn.scalar("SELECT ?", [17_i64] of Value).or_panic == 17_i64
assert conn.scalar("SELECT ?", [] of Value).is_a?(DatabaseError)
assert conn.scalar("SELECT ?", [nil] of Value).or_panic.nil?
assert conn.scalar("SELECT ?", [23_i64] of Value).or_panic == 23_i64

bytes = Bytes.new(3)
bytes[0] = 65_u8
bytes[1] = 0_u8
bytes[2] = 66_u8
assert conn.scalar("SELECT ?", [bytes] of Value).or_panic == "A\0B"
assert conn.scalar("SELECT ?", ["C\0D"] of Value).or_panic == "C\0D"
assert conn.execute("SELECT 1\0; SELECT 2").is_a?(DatabaseError)
conn.close.or_panic
assert conn.native_connection.closed?
assert !conn.in_transaction?
assert conn.execute("SELECT 1").is_a?(DatabaseError)
