module test/grant_query_calculate_test

import grant/base::{Base}
import grant/query/aggregations::{Calculation}
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class CaRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ca_rows
  column id : Int64, primary: true
  column team : String
  column points : Int64
end

# Native Hash equality currently depends on insertion order; SQL group order is unspecified.
private def same_hash?(actual : A, expected : Hash(K, V)) : Bool forall A, K, V
  return false unless actual.is_a?(Hash)
  actual_entries = [] of String
  expected_entries = [] of String
  actual.each { |key, value| actual_entries << "#{key.inspect} => #{value.inspect}" }
  expected.each { |key, value| expected_entries << "#{key.inspect} => #{value.inspect}" }
  actual_entries.sorted == expected_entries.sorted
end

private def reset : Nil
  CaRow.clear.or_panic
  CaRow.create_strict(team: "red", points: 4_i64).or_panic
  CaRow.create_strict(team: "red", points: 6_i64).or_panic
  CaRow.create_strict(team: "blue", points: 10_i64).or_panic
  nil
end

register_spec_connections
CaRow.migrator.drop_and_create.or_panic

# it: dispatches to the named aggregates
reset
relation = CaRow.all
assert relation.calculate(:count).or_panic == 3_i64
assert relation.calculate(:count, :points).or_panic == 3_i64
assert relation.calculate(:sum, :points).or_panic == 20_i64
assert relation.calculate(:average, :points).or_panic == 20.0 / 3
assert relation.calculate(:avg, :points).or_panic == 20.0 / 3
assert relation.calculate(:minimum, :points).or_panic == 4_i64
assert relation.calculate(:min, :points).or_panic == 4_i64
assert relation.calculate(:maximum, :points).or_panic == 10_i64
assert relation.calculate(:max, :points).or_panic == 10_i64

# it: takes a Grant::Calculation
reset
assert CaRow.all.calculate(Calculation::Sum, "points").or_panic == 20_i64
assert CaRow.calculate(Calculation::Count).or_panic == 3_i64

# it: returns a Hash per group
reset
assert same_hash?(CaRow.group_records(:team).calculate(:sum, :points).or_panic, {"red" => 10_i64, "blue" => 10_i64} of Value => Value)
assert same_hash?(CaRow.group_records(:team).calculate(:count).or_panic, {"red" => 2_i64, "blue" => 1_i64} of Value => Int64)
assert same_hash?(CaRow.group_records(:team).calculate(:maximum, :points).or_panic, {"red" => 6_i64, "blue" => 10_i64} of Value => Value)

# it: is available on the model class
reset
assert CaRow.calculate(:sum, :points).or_panic == 20_i64

# it: raises for an unknown operation or a missing column
reset
unknown = CaRow.all.calculate(:median, :points)
assert unknown.is_a?(ArgumentError)
assert unknown.as(ArgumentError).message.includes?("Unknown calculation :median")
missing = CaRow.all.calculate(:sum)
assert missing.is_a?(ArgumentError)
assert missing.as(ArgumentError).message.includes?("needs a column")

# it: maps every symbol to a Calculation
reset
{count: Calculation::Count, sum: Calculation::Sum, average: Calculation::Average,
 avg: Calculation::Average, minimum: Calculation::Minimum, min: Calculation::Minimum,
 maximum: Calculation::Maximum, max: Calculation::Maximum}.each do |name, expected|
  assert Calculation.from_symbol(name).or_panic == expected
end

CaRow.adapter.close.or_panic
