module test/grant_query_merge_test

import grant/query/builder::{Builder}
import test/where_family_models::{wf_create_tables, wf_clear_tables}
import test/spec_helper::{register_spec_connections}

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map(&.title.to_s)
end

private def prepare_records : Nil
  wf_clear_tables
  WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  nil
end

register_spec_connections
wf_create_tables

# it: replaces an equality on the same column, last wins
prepare_records
merged = WfPost.where(published: true).merge(WfPost.where(published: false))
assert titles(merged) == ["b"]
assert merged.to_sql.split("WHERE").last.split("published").size - 1 == 1


# it: replaces IN and range conditions on the column an equality names
prepare_records
merged = WfPost.where(score: [1, 2]).where(score: 1..2).merge(WfPost.where(score: 3))
assert titles(merged) == ["c"]


# it: replaces nil-aware lists and record lists on the same column
prepare_records
assert titles(WfPost.where(score: [1, nil]).merge(WfPost.where(score: 3))) == ["c"]

ann = WfAuthor.create_strict(name: "ann").or_panic
bob = WfAuthor.create_strict(name: "bob").or_panic
cy = WfAuthor.create_strict(name: "cy").or_panic
WfPost.create_strict(title: "by cy", author_id: cy.id).or_panic
assert titles(WfPost.where(author: [ann, bob]).merge(WfPost.where(author: cy))) == ["by cy"]


# it: lets a later rewhere replace a list merged in from the other relation
prepare_records
merged = WfPost.where(published: true).merge(WfPost.where(score: [1, nil]))
assert titles(merged.rewhere(score: 3)) == ["c"]


# it: keeps conditions on other columns
prepare_records
merged = WfPost.where(published: true, score: 3).merge(WfPost.where(published: false))
assert titles(merged) == [] of String
assert merged.to_sql.includes?("score")
assert titles(WfPost.where(published: true, score: 1).merge(WfPost.where(score: 3))) == ["c"]


# it: keeps a non-equality condition on a column the other side ranges over
prepare_records
merged = WfPost.where(score: 2).merge(WfPost.where(score: 1..2))
assert titles(merged) == ["b"]


# it: ANDs conditions on different columns
prepare_records
assert titles(WfPost.where(published: true).merge(WfPost.where(score: 3))) == ["c"]


# it: leaves the receiver and the merged relation untouched
prepare_records
left = WfPost.where(published: true)
right = WfPost.where(published: false)
left.merge(right)
assert titles(left) == ["a", "c"]
assert titles(right) == ["b"]


# it: does not corrupt an OR chain on the receiver
prepare_records
left = WfPost.where(title: "a").or_where(title: "b")
assert titles(left.merge(WfPost.where(published: false))) == ["b"]
assert titles(left.merge(WfPost.where(title: "c"))) == [] of String


# it: groups an OR chain on the merged side
prepare_records
right = WfPost.where(title: "a").or_where(title: "c")
assert titles(WfPost.where(published: true).merge(right)) == ["a", "c"]
assert titles(WfPost.where(score: 3).merge(right)) == ["c"]


# it: takes the proc form: the block gets an empty relation to fill
prepare_records
merged = WfPost.where(published: true).merge(&.where(published: false))
assert titles(merged) == ["b"]
assert titles(WfPost.where(published: true).merge(&.where(score: 3))) == ["c"]


# it: takes keyword conditions
prepare_records
assert titles(WfPost.where(published: true).merge(published: false)) == ["b"]


# it: merges order, limit and select from the other relation
prepare_records
merged = WfPost.where(published: true).merge(WfPost.order(id: :desc).limit(1).select(:id, :title))
assert merged.select.or_panic.map(&.title.to_s) == ["c"]


# it: merges a named scope relation
prepare_records
scope = WfPost.where(score: 2)
assert titles(WfPost.where(published: false).merge(scope)) == ["b"]
