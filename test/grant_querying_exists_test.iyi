module test/grant_querying_exists_test
import grant/base::{Base}
import test/transaction_crud_models::{Parent}
import test/querying_spec_models::{Student}
import test/spec_helper::{register_spec_connections}

pub class Kvs < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table kvs
  column k : String, primary: true, auto: false
  column v : String?
end

pub class ScopedExists < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table scoped_exists
  column id : Int64, primary: true
  column visible : Bool = true
  default_scope { where(visible: true) }
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic
Student.migrator.drop_and_create.or_panic
Kvs.migrator.drop_and_create.or_panic

# Numeric primary key.
# it: should return true
Parent.clear.or_panic
model = Parent.new(name: "Some Name")
assert model.save
assert Parent.exists?(model.id).or_panic

# String primary key.
# it: should return true
Parent.clear.or_panic
assert Kvs.new(k: "EXISTS_ID").save
assert Kvs.exists?("EXISTS_ID").or_panic

# Named tuple criteria.
# it: should return true
Parent.clear.or_panic
model = Parent.new(name: "Some Name")
assert model.save
assert Parent.exists?(name: "Some Name", id: model.id).or_panic

# Hash criteria with both symbol and string keys.
# it: should return true
Parent.clear.or_panic
model = Parent.new(name: "Some Name")
assert model.save
assert Parent.exists?({:name => "Some Name", "id" => model.id}).or_panic

# Nil column value.
# it: should return true
Parent.clear.or_panic
model = Student.new
assert model.save
assert Student.exists?(name: nil, id: model.id).or_panic

# Numeric primary key.
# it: should return false
Parent.clear.or_panic
assert !Parent.exists?(234567).or_panic

# String primary key.
# it: should return false
Parent.clear.or_panic
assert !Kvs.exists?("SOME_KEY").or_panic

# Named tuple criteria.
# it: should return false
Parent.clear.or_panic
model = Parent.new(name: "Some Name")
assert model.save
assert !Parent.exists?(name: "Some Other Name", id: model.id).or_panic

# Hash criteria.
# it: should return false
Parent.clear.or_panic
model = Parent.new(name: "Some Name")
assert model.save
assert !Parent.exists?({:name => "Some Other Name", "id" => model.id}).or_panic

# Nil column value.
# it: should return false
Parent.clear.or_panic
model = Student.new(name: "Jim")
assert model.save
assert !Student.exists?(name: nil, id: model.id).or_panic

assert !Parent.exists?(nil).or_panic
# Every overload composes with the current scope, including explicit unscoped blocks.
ScopedExists.migrator.drop_and_create.or_panic
hidden = ScopedExists.create_strict(visible: false).or_panic
assert !ScopedExists.exists?(hidden.id).or_panic
assert !ScopedExists.exists?(id: hidden.id).or_panic
assert !ScopedExists.exists?({"id" => hidden.id}).or_panic
assert ScopedExists.unscoped { ScopedExists.exists?(hidden.id) }.or_panic
assert !ScopedExists.exists?(hidden.id).or_panic
Parent.adapter.close.or_panic
