module test/grant_validators_uniqueness_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class UniqueUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table unique_users

  column id : Int64, primary: true
  column email : String?
  column username : String?

  validates_uniqueness_of :email
  validates_uniqueness_of :username, case_sensitive: false, message: "is already taken"
end

pub class ScopedUnique < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table scoped_uniques

  column id : Int64, primary: true
  column name : String?
  column category : String?
  column region : String?
  column code : String?

  validates_uniqueness_of :name, scope: [:category]
  validates_uniqueness_of :code, scope: [:category, :region]
end

register_spec_connections
UniqueUser.migrator.drop_and_create.or_panic
ScopedUnique.migrator.drop_and_create.or_panic

# it: passes when no duplicate exists
begin
  UniqueUser.clear.or_panic
  user = UniqueUser.new
  user.email = "unique@example.com"
  user.username = "uniqueuser"
  assert user.valid?.or_panic
end

# it: fails when a duplicate exists
begin
  UniqueUser.clear.or_panic
  existing = UniqueUser.new
  existing.email = "taken@example.com"
  existing.username = "taken"
  existing.save_strict.or_panic

  duplicate = UniqueUser.new
  duplicate.email = "taken@example.com"
  duplicate.username = "different"
  assert !duplicate.valid?.or_panic
  assert duplicate.errors.first.field == "email"
  assert duplicate.errors.first.message == "has already been taken"
end

# it: allows updating the same record (excludes self)
begin
  UniqueUser.clear.or_panic
  user = UniqueUser.new
  user.email = "self@example.com"
  user.username = "selfuser"
  user.save_strict.or_panic

  # Simulate updating by re-fetching
  found = UniqueUser.find_strict(user.id).or_panic
  found.username = "updatedname"
  assert found.valid?.or_panic
end

# it: allows nil values by default
begin
  UniqueUser.clear.or_panic
  user = UniqueUser.new
  user.email = nil
  user.username = "niluser"
  assert user.valid?.or_panic
end

# it: supports custom error message
begin
  UniqueUser.clear.or_panic
  existing = UniqueUser.new
  existing.email = "first@example.com"
  existing.username = "firstuser"
  existing.save_strict.or_panic

  duplicate = UniqueUser.new
  duplicate.email = "second@example.com"
  duplicate.username = "firstuser"
  assert !duplicate.valid?.or_panic
  assert duplicate.errors.first.message == "is already taken"
end

# it: is case-sensitive by default
begin
  UniqueUser.clear.or_panic
  existing = UniqueUser.new
  existing.email = "CaseSensitive@example.com"
  existing.username = "caseuser"
  existing.save_strict.or_panic

  different_case = UniqueUser.new
  different_case.email = "casesensitive@example.com"
  different_case.username = "caseuser2"
  # Default is case-sensitive, so different case is a different value
  assert different_case.valid?.or_panic
end

# it: detects duplicates case-insensitively when case_sensitive: false
begin
  UniqueUser.clear.or_panic
  existing = UniqueUser.new
  existing.email = "first@example.com"
  existing.username = "CaseUser"
  existing.save_strict.or_panic

  duplicate = UniqueUser.new
  duplicate.email = "second@example.com"
  duplicate.username = "caseuser" # different case
  # username uses case_sensitive: false
  assert !duplicate.valid?.or_panic
  assert duplicate.errors.first.field == "username"
end

# it: validates uniqueness within scope
begin
  ScopedUnique.clear.or_panic
  existing = ScopedUnique.new
  existing.name = "Widget"
  existing.category = "Electronics"
  existing.region = "US"
  existing.save_strict.or_panic

  # Same name but different category — should pass
  different_scope = ScopedUnique.new
  different_scope.name = "Widget"
  different_scope.category = "Toys"
  different_scope.region = "US"
  assert different_scope.valid?.or_panic

  # Same name and same category — should fail
  duplicate = ScopedUnique.new
  duplicate.name = "Widget"
  duplicate.category = "Electronics"
  duplicate.region = "EU"
  assert !duplicate.valid?.or_panic
  assert duplicate.errors.first.field == "name"
end

# it: validates uniqueness with multi-field scope
begin
  ScopedUnique.clear.or_panic
  existing = ScopedUnique.new
  existing.name = "Widget"
  existing.category = "Electronics"
  existing.region = "US"
  existing.code = "EL-US-001"
  existing.save_strict.or_panic

  # Same code, different scope (category+region) — should pass
  different_scope = ScopedUnique.new
  different_scope.name = "Other"
  different_scope.category = "Toys"
  different_scope.region = "US"
  different_scope.code = "EL-US-001"
  assert different_scope.valid?.or_panic

  # Same code, same scope (category+region) — should fail
  duplicate = ScopedUnique.new
  duplicate.name = "Another"
  duplicate.category = "Electronics"
  duplicate.region = "US"
  duplicate.code = "EL-US-001"
  assert !duplicate.valid?.or_panic
  assert duplicate.errors.map(&.field).includes?("code")
end

# it: allows updating the scoped record itself
begin
  ScopedUnique.clear.or_panic
  record = ScopedUnique.new
  record.name = "Gadget"
  record.category = "Tech"
  record.region = "EU"
  record.save_strict.or_panic

  found = ScopedUnique.find_strict(record.id).or_panic
  found.region = "UK"
  assert found.valid?.or_panic
end
