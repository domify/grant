module test/grant_attributes_normalized_query_test
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
import std/text

pub class NrmQueryUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table nrm_query_users
  column id : Int64, primary: true
  column email : String?
  column note : String?
  normalizes :email, with: ->(value : String) { value.strip.downcase }
end

register_spec_connections
id_column = CURRENT_ADAPTER == "pg" ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY AUTOINCREMENT"
NrmQueryUser.exec("DROP TABLE IF EXISTS nrm_query_users").or_panic
NrmQueryUser.exec("CREATE TABLE nrm_query_users (id #{id_column}, email VARCHAR(255), note VARCHAR(255))").or_panic
NrmQueryUser.create_strict(email: "a@b.com", note: " Keep ").or_panic

# it: find_by normalizes the search value
found = NrmQueryUser.find_by(email: " A@B ".gsub("@B", "@B.COM")).or_panic
assert (found ? found.email : nil) == "a@b.com"

# it: find_by! normalizes the search value
assert NrmQueryUser.find_by_strict(email: "  A@B.com").or_panic.email == "a@b.com"

# it: where normalizes equality values
assert NrmQueryUser.where(email: " A@B.COM ").count.or_panic == 1

# it: chained find_by on a relation normalizes
assert !NrmQueryUser.where(note: " Keep ").find_by(email: "A@B.COM").or_panic.nil?

# it: where normalizes each element of an IN list
assert NrmQueryUser.where(email: [" A@B.COM ", "missing@x.com"]).count.or_panic == 1
assert NrmQueryUser.where.not(email: [" A@B.COM "]).count.or_panic == 0

# it: where.not normalizes equality values
assert NrmQueryUser.where.not(email: " A@B.COM ").count.or_panic == 0

# it: leaves other columns untouched
assert NrmQueryUser.where(note: "keep").count.or_panic == 0
assert NrmQueryUser.where(note: " Keep ").count.or_panic == 1

# it: keeps nil conditions as IS NULL
assert NrmQueryUser.where(email: nil).count.or_panic == 0
NrmQueryUser.adapter.close.or_panic
