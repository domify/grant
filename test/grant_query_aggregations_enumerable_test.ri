module test/grant_query_aggregations_enumerable_test

import grant/base::{Base}
import test/spec_helper::{register_spec_connections}
import std/env

pub class AeItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ae_items
  column id : Int64, primary: true
  column weight : Int64
end

pub def reset_items : Nil
  AeItem.clear
  AeItem.create_strict(weight: 2_i64).or_panic
  AeItem.create_strict(weight: 5_i64).or_panic
  nil
end

register_spec_connections
AeItem.migrator.drop_and_create.or_panic

# it: keeps the block forms of Enumerable on a relation
reset_items
assert AeItem.all.sum { |item| item.weight || raise "missing weight" }.or_panic == 7_i64
assert AeItem.all.max_of { |item| item.weight || raise "missing weight" }.or_panic == 5_i64
assert AeItem.all.count { |item| (item.weight || raise "missing weight") > 3 }.or_panic == 1

# it: answers the column forms in SQL
reset_items
assert AeItem.all.sum(:weight).or_panic == 7_i64
assert AeItem.all.count(:weight).or_panic == 2_i64

# it: counts through the model class, with a column and distinct
reset_items
assert AeItem.count.or_panic == 2_i64
assert AeItem.count(:weight).or_panic == 2_i64
assert AeItem.count(:weight, distinct: true).or_panic == 2_i64

# it: sums and averages through the model class as scalars
reset_items
assert AeItem.sum(:weight).or_panic == 7_i64
assert AeItem.sum(:weight).or_panic.is_a?(Int64)
assert AeItem.avg(:weight).or_panic == 3.5
assert AeItem.min(:weight).or_panic == 2_i64
assert AeItem.max(:weight).or_panic == 5_i64
# Supplemental checks distinguish SQL DISTINCT and grouped/empty count shapes.
AeItem.create_strict(weight: 2_i64).or_panic
assert AeItem.count(:weight).or_panic == 3_i64
assert AeItem.count(:weight, distinct: true).or_panic == 2_i64
assert AeItem.all.distinct.count(:weight).or_panic == 2_i64
assert AeItem.none.count(:weight).or_panic == 0_i64
assert AeItem.where(weight: 99_i64).count(:weight).or_panic == 0_i64
grouped = AeItem.group_by(:weight).count(:weight).or_panic
assert grouped.is_a?(Hash(::Grant::Adapter::Driver::Value, Int64))
assert grouped[2_i64] == 2 if grouped.is_a?(Hash(::Grant::Adapter::Driver::Value, Int64))
assert AeItem.all.count(:all, distinct: true).is_a?(::Grant::Error::ArgumentError)
AeItem.adapter.close.or_panic
