module test/grant_schema_micrate_sql_files_test
import grant/schema/migration::{SqlFileMigration, InvalidMigration}
import grant/schema/migration_context::{MigrationContext}
import grant/schema/schema_migration::{SchemaMigration, Tracking}
import grant/schema/command_recorder::{IrreversibleMigration}
import grant/adapter/base::{Base}
import std/file::{File}
import std/set
import test/m03_fixture
import test/m03_fixture::{M03CreatePosts}
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

private def m03_write(dir : String, file : String, text : String) : Nil
  File.write(File.join(dir, file), text)
  nil
end
private def m03_micrate_seed(adapter : Base, rows : Array(Tuple(Int64, Bool))) : Nil
  SchemaMigration.new(adapter, Tracking::Micrate).create_table.or_panic
  truthy = adapter.sqlite? ? {"1", "0"} : {"true", "false"}
  ([{0_i64, true}] + rows).each do |version, applied|
    adapter.open { |db| db.exec("INSERT INTO micrate_db_version (version_id, is_applied) VALUES (#{version}, #{applied ? truthy[0] : truthy[1]})") }.or_panic
  end
end
register_spec_connections
restore_default_spec_connections
adapter = ::Test::M03Fixture.adapter

# it: parses Up and Down sections, multi-line statements and StatementBegin blocks
::Test::M03Fixture.reset_in_place
text = <<-SQL
-- a leading comment
-- +micrate Up
-- +micrate StatementBegin
CREATE TABLE m03_sql_one (
  id INTEGER PRIMARY KEY,
  note VARCHAR(20)
);
-- +micrate StatementEnd
INSERT INTO m03_sql_one (id, note) VALUES (1, 'a;b');

-- +micrate Down
DROP TABLE m03_sql_one;
SQL
migration = SqlFileMigration.parse(1_i64, "Create", text).or_panic
assert migration.up_statements.size == 2
assert migration.up_statements[0].starts_with?("CREATE TABLE m03_sql_one (")
assert migration.up_statements[0].includes?("note VARCHAR(20)\n);")
assert migration.up_statements[1] == "INSERT INTO m03_sql_one (id, note) VALUES (1, 'a;b');"
assert migration.down_statements == ["DROP TABLE m03_sql_one;"]
assert !migration.no_transaction?
assert SqlFileMigration.parse(2_i64, "X", "-- +micrate Up\n-- +micrate NoTransaction\nSELECT 1;\n").or_panic.no_transaction?

# it: rejects malformed files
::Test::M03Fixture.reset_in_place
error = SqlFileMigration.parse(1_i64, "Bad", "CREATE TABLE x (a INT);\n-- +micrate Up\n")
assert error.is_a?(InvalidMigration)
assert error.as(InvalidMigration).message.includes?("before the -- +micrate Up")
error = SqlFileMigration.parse(1_i64, "Bad", "-- +micrate Up\n-- +micrate StatementBegin\nSELECT 1;\n")
assert error.is_a?(InvalidMigration)
assert error.as(InvalidMigration).message.includes?("unterminated")
error = SqlFileMigration.parse(1_i64, "Bad", "-- +micrate Up\nSELECT 1\n")
assert error.is_a?(InvalidMigration)
assert error.as(InvalidMigration).message.includes?("semicolon")

# it: migrates and rolls back files from a directory
::Test::M03Fixture.reset_in_place
::Test::M03Fixture.tmpdir do |dir|
  m03_write(dir, "20240401000001_create_sql_one.sql", "-- +micrate Up\nCREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_one;\n")
  m03_write(dir, "20240401000002_create_sql_two.sql", "-- +micrate Up\nCREATE TABLE m03_sql_two (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_two;\n")
  m03_write(dir, "notes.txt", "ignored")
  context = MigrationContext.new(adapter, paths: [dir], verbose: false)
  assert context.migrations.or_panic.map { |entry| entry.name } == ["CreateSqlOne", "CreateSqlTwo"]
  assert context.migrate.or_panic == [20240401000001_i64, 20240401000002_i64]
  assert ::Test::M03Fixture.table?("m03_sql_two")
  assert ::Test::M03Fixture.versions == [20240401000001_i64, 20240401000002_i64]
  context.rollback.or_panic
  assert !::Test::M03Fixture.table?("m03_sql_two")
  assert ::Test::M03Fixture.table?("m03_sql_one")
end

# it: mixes Crystal classes and SQL files in one version order
::Test::M03Fixture.reset_in_place
::Test::M03Fixture.tmpdir do |dir|
  m03_write(dir, "20240401000005_create_sql_one.sql", "-- +micrate Up\nCREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_one;\n")
  context = MigrationContext.for(adapter, M03CreatePosts, paths: [dir], verbose: false)
  assert context.migrations.or_panic.map { |entry| entry.version } == [20240101000003_i64, 20240401000005_i64]
  assert context.migrate.or_panic.size == 2
end

# it: refuses a file without a Down section when rolling back
::Test::M03Fixture.reset_in_place
::Test::M03Fixture.tmpdir do |dir|
  m03_write(dir, "20240401000001_create_sql_one.sql", "-- +micrate Up\nCREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY);\n")
  context = MigrationContext.new(adapter, paths: [dir], verbose: false)
  context.migrate.or_panic
  error = context.rollback
  assert error.is_a?(IrreversibleMigration)
  assert error.as(IrreversibleMigration).message.includes?("Down")
end

# it: keeps working on top of an existing Micrate install's table
::Test::M03Fixture.reset_in_place
::Test::M03Fixture.tmpdir do |dir|
  m03_write(dir, "20240401000001_create_sql_one.sql", "-- +micrate Up\nCREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_one;\n")
  m03_write(dir, "20240401000002_create_sql_two.sql", "-- +micrate Up\nCREATE TABLE m03_sql_two (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_two;\n")
  adapter.open { |db| db.exec("CREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY)") }.or_panic
  m03_micrate_seed(adapter, [{20240401000001_i64, true}, {20240401000002_i64, true}, {20240401000002_i64, false}])
  context = MigrationContext.new(adapter, paths: [dir], tracking: Tracking::Micrate, verbose: false)
  expected = Set(Int64).new
  expected.add(20240401000001_i64)
  assert context.applied_versions.or_panic == expected
  assert context.pending.or_panic.map { |entry| entry.version } == [20240401000002_i64]
  assert context.migrate.or_panic == [20240401000002_i64]
  assert ::Test::M03Fixture.versions(tracking: Tracking::Micrate) == [20240401000001_i64, 20240401000002_i64]
  assert !::Test::M03Fixture.table?("schema_migrations")
  context.rollback.or_panic
  assert ::Test::M03Fixture.versions(tracking: Tracking::Micrate) == [20240401000001_i64]
  rows = adapter.open { |db| db.scalar("SELECT COUNT(*) FROM micrate_db_version WHERE version_id = 20240401000002").or_panic.as(Int64) }.or_panic
  assert rows == 4
end

# it: creates the Micrate table when there is none
::Test::M03Fixture.reset_in_place
::Test::M03Fixture.tmpdir do |dir|
  m03_write(dir, "20240401000001_create_sql_one.sql", "-- +micrate Up\nCREATE TABLE m03_sql_one (id INTEGER PRIMARY KEY);\n-- +micrate Down\nDROP TABLE m03_sql_one;\n")
  context = MigrationContext.new(adapter, paths: [dir], tracking: Tracking::Micrate, verbose: false)
  context.migrate.or_panic
  assert ::Test::M03Fixture.table?("micrate_db_version")
  assert context.current_version.or_panic == 20240401000001_i64
end
::Test::M03Fixture.reset_in_place
