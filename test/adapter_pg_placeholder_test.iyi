module test/adapter_pg_placeholder_test
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}

pg_adapter = Pg.new(name: "pg_test", url: "postgres://localhost/test")

# it: converts a single ? to $1
result = pg_adapter.ensure_clause_template("id = ?")
assert result == "id = $1"

# it: converts multiple ? to $1, $2, $3
result = pg_adapter.ensure_clause_template("name = ? AND age = ? AND active = ?")
assert result == "name = $1 AND age = $2 AND active = $3"

# it: returns clause unchanged when no ? present
result = pg_adapter.ensure_clause_template("SELECT * FROM users")
assert result == "SELECT * FROM users"

# it: handles DELETE statement with ? placeholders
result = pg_adapter.ensure_clause_template("DELETE FROM users WHERE id = ?")
assert result == "DELETE FROM users WHERE id = $1"

# it: handles UPDATE statement with ? placeholders
result = pg_adapter.ensure_clause_template("UPDATE users SET name = ?, age = ? WHERE id = ?")
assert result == "UPDATE users SET name = $1, age = $2 WHERE id = $3"

# it: handles IS NULL clauses mixed with ? placeholders
result = pg_adapter.ensure_clause_template("name IS NULL AND age = ?")
assert result == "name IS NULL AND age = $1"

# it: returns clause unchanged (? is native for SQLite)
sqlite_adapter = Sqlite.new(name: "sqlite_test", url: "sqlite3::memory:")
result = sqlite_adapter.ensure_clause_template("id = ? AND name = ?")
assert result == "id = ? AND name = ?"

