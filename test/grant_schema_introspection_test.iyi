module test/grant_schema_introspection_test

import grant/schema/column_info::{ColumnInfo, IndexInfo, TypeFamily, ReferentialAction}
import grant/schema/introspection::{TableNotFound}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections
schema = ::Test::SchemaFixture.adapter.schema
::Test::SchemaFixture.create_in_place

# it: lists the tables of the connection
assert schema.tables.or_panic.includes?("m01_authors")
assert schema.tables.or_panic.includes?("m01_posts")
assert !schema.tables.or_panic.includes?("sqlite_sequence")

# it: answers for strings and symbols
assert schema.table_exists?(:m01_authors).or_panic
assert schema.table_exists?("m01_authors").or_panic
assert !schema.table_exists?(:m01_nothing).or_panic

# it: describes every column in table order
columns = schema.columns(:m01_authors).or_panic
assert columns.map { |column| column.name } == ["id", "email", "bio", "active", "created_at"]
assert columns.map { |column| column.position } == [1, 2, 3, 4, 5]

# it: reports nullability, defaults and type families
by_name = {} of String => ColumnInfo
schema.columns(:m01_authors).or_panic.each { |column| by_name[column.name] = column }
assert !by_name["email"].null?
assert by_name["email"].type_family == TypeFamily::String
assert by_name["email"].limit == 120
assert by_name["bio"].null?
assert by_name["bio"].type_family == TypeFamily::Text
assert by_name["bio"].default.nil?
assert !by_name["active"].default.nil?
assert by_name["active"].type_family == TypeFamily::Boolean
assert by_name["created_at"].type_family == TypeFamily::DateTime

# it: reports precision and scale of decimals
score = schema.columns(:m01_posts).or_panic.find { |column| column.name == "score" }.as(ColumnInfo)
assert score.type_family == TypeFamily::Decimal
assert score.precision == 10
assert score.scale == 2

# it: marks the auto-incrementing primary key
id = schema.columns(:m01_authors).or_panic.first
assert id.primary_key?
assert id.auto_increment?
assert !id.null?
assert id.type_family == TypeFamily::Integer

# it: raises TableNotFound for an unknown table
error = schema.columns(:m01_nothing)
assert error.is_a?(TableNotFound)
assert error.as(TableNotFound).message.includes?("m01_nothing")

# it: checks the name and optionally the type family
assert schema.column_exists?(:m01_authors, :email).or_panic
assert schema.column_exists?(:m01_authors, :email, TypeFamily::String).or_panic
assert !schema.column_exists?(:m01_authors, :email, TypeFamily::Integer).or_panic
assert !schema.column_exists?(:m01_authors, :nope).or_panic
assert !schema.column_exists?(:m01_nothing, :id).or_panic

# it: returns a single column key
assert schema.primary_key(:m01_authors).or_panic == ["id"]

# it: returns a composite key in key order
assert schema.primary_key(:m01_memberships).or_panic == ["author_id", "group_id"]

# it: lists indexes without the primary key
indexes = {} of String => IndexInfo
schema.indexes(:m01_posts).or_panic.each { |index| indexes[index.name] = index }
assert indexes.keys.includes?("index_m01_posts_on_author_id_and_title")
assert indexes.keys.includes?("index_m01_posts_on_score")
composite = indexes["index_m01_posts_on_author_id_and_title"]
assert composite.columns == ["author_id", "title"]
assert composite.unique?
assert !indexes["index_m01_posts_on_score"].unique?
assert schema.indexes(:m01_authors).or_panic.none? { |index| index.unique? }

# it: reports expression indexes
if CURRENT_ADAPTER != "mysql"
  index = schema.indexes(:m01_authors).or_panic.find { |candidate| candidate.name == "index_m01_authors_on_lower_email" }.as(IndexInfo)
  assert index.expression?
  assert index.columns.first.includes?("lower")
end

# it: answers index_exists?
assert schema.index_exists?(:m01_posts, ["author_id", "title"], unique: true).or_panic
assert !schema.index_exists?(:m01_posts, ["title"]).or_panic
assert schema.index_exists?(:m01_posts, name: "index_m01_posts_on_score").or_panic

# it: describes columns, target and actions
key = schema.foreign_keys(:m01_posts).or_panic.first
assert key.columns == ["author_id"]
assert key.column == "author_id"
assert key.to_table == "m01_authors"
assert key.primary_key_columns == ["id"]
assert key.on_delete == ReferentialAction::Cascade
assert key.on_update == ReferentialAction::NoAction
assert key.name == "fk_m01_posts_author" unless CURRENT_ADAPTER == "sqlite"

# it: reads update and delete actions separately
key = schema.foreign_keys(:m01_memberships).or_panic.first
assert key.on_update == ReferentialAction::Cascade
assert key.on_delete == (CURRENT_ADAPTER == "mysql" ? ReferentialAction::Restrict : ReferentialAction::SetNull)

# it: is empty for a table without keys and answers foreign_key_exists?
assert schema.foreign_keys(:m01_authors).or_panic.empty?
assert schema.foreign_key_exists?(:m01_posts, to_table: :m01_authors).or_panic
assert schema.foreign_key_exists?(:m01_posts, column: :author_id).or_panic
assert !schema.foreign_key_exists?(:m01_posts, column: :title).or_panic

# it: maps adapter type spellings to families
{
  "bigint" => TypeFamily::Integer,
  "int(11)" => TypeFamily::Integer,
  "INTEGER" => TypeFamily::Integer,
  "smallserial" => TypeFamily::Integer,
  "tinyint(1)" => TypeFamily::Boolean,
  "character varying" => TypeFamily::String,
  "double precision" => TypeFamily::Float,
  "numeric(10,2)" => TypeFamily::Decimal,
  "timestamp with time zone" => TypeFamily::DateTime,
  "date" => TypeFamily::Date,
  "bytea" => TypeFamily::Binary,
  "jsonb" => TypeFamily::Json,
  "uuid" => TypeFamily::Uuid,
  "point" => TypeFamily::Other,
  "" => TypeFamily::Other,
}.each { |sql_type, family| assert TypeFamily.classify(sql_type) == family }
::Test::SchemaFixture.drop_in_place
