module test/grant_query_find_each_test
import grant/base::{Base}
import grant/error::{ArgumentError}
import grant/query/batches::{BatchOptionIgnoredError}
import grant/adapter/driver::{Value}
import std/iterator
import std/enumerable
import test/query_relation_sql_capture::{capture_sql}
import test/spec_helper::{register_spec_connections}
  pub class FindEachItem < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table find_each_items

    column id : Int64, primary: true
    column label : String
    column bucket : Int64
  end
def seed_items(count : Int32 = 10) : Array(FindEachItem)
  FindEachItem.migrator.drop_and_create.or_panic
  (1..count).map { |index| FindEachItem.create_strict(label: "item#{index}", bucket: (index % 3).to_i64).or_panic }
end

register_spec_connections

# it: yields every record once through the relation form
items = seed_items
seen = [] of Int64
FindEachItem.where(:bucket, :gteq, 0_i64).find_each(batch_size: 3) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == items.map(&.id.as(Int64))

# it: batches by a composite cursor that is not the primary key
items = seed_items
batches = [] of Array(Int64)
FindEachItem.all.find_in_batches(batch_size: 4, cursor: [:bucket, :id]) do |batch|
  batches << batch.map(&.id.as(Int64))
end.or_panic

expected = items.sorted { |a, b| a.bucket == b.bucket ? (a.id.as(Int64) < b.id.as(Int64) ? -1 : (a.id == b.id ? 0 : 1)) : (a.bucket.as(Int64) < b.bucket.as(Int64) ? -1 : 1) }.map(&.id.as(Int64))
assert batches.flat_map { |batch| batch } == expected
assert batches.map(&.size) == [4, 4, 2]

# it: keeps the direction of an order that carries a NULL placement
items = seed_items(5)
seen = [] of Int64
FindEachItem.order(:id, :asc, nulls: :first).find_each(batch_size: 2) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == items.map(&.id.as(Int64))

# it: refuses to batch by a raw ORDER BY expression
seed_items(3)
error = FindEachItem.order("lower(label)").find_each(batch_size: 2) { }
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("raw ORDER BY")

# it: honors start, finish and descending order on the primary key
items = seed_items
ids = items.map(&.id.as(Int64))

seen = [] of Int64
FindEachItem.all.find_each(batch_size: 2, start: ids[2], finish: ids[6]) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == ids.skip(2).first(5)

descending = [] of Int64
FindEachItem.all.find_each(batch_size: 3, order: :desc, start: ids[7], finish: ids[3]) { |item| descending << item.id.as(Int64) }.or_panic
assert descending == ids.skip(3).first(5).reversed

# it: keeps the relation's order and limit, and applies its offset to the first batch only
items = seed_items
ids = items.map(&.id.as(Int64))

seen = [] of Int64
FindEachItem.order(id: :desc).limit(5).find_each(batch_size: 2) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == ids.reversed.first(5)

skipped = [] of Int64
FindEachItem.order(id: :asc).offset(3).find_each(batch_size: 2) { |item| skipped << item.id.as(Int64) }.or_panic
assert skipped == ids.skip(3)

# it: ignores the relation order under an explicit cursor, or raises with error_on_ignore
items = seed_items
ids = items.map(&.id.as(Int64))

seen = [] of Int64
FindEachItem.order(id: :desc).find_each(batch_size: 4, cursor: [:id]) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == ids

error = FindEachItem.order(id: :desc).find_each(cursor: [:id], error_on_ignore: true) { |_item| }
assert error.is_a?(BatchOptionIgnoredError)
assert error.as(BatchOptionIgnoredError).message.includes?("cursor")

FindEachItem.all.find_each(cursor: [:id], error_on_ignore: true) { |_item| }.or_panic

# it: rejects a batch size below one and an unknown order
seed_items(1)
error = FindEachItem.all.find_each(batch_size: 0) { |_item| }
assert error.is_a?(ArgumentError)
error = FindEachItem.all.find_in_batches(order: :sideways) { |_batch| }
assert error.is_a?(ArgumentError)

# it: returns lazy iterators that run one query per batch
items = seed_items
iterator = FindEachItem.all.find_in_batches(batch_size: 3).or_panic

statements = capture_sql do
  first = iterator.next
assert first.is_a?(Array(FindEachItem))
assert first.as(Array(FindEachItem)).map(&.id.as(Int64)) == items.first(3).map(&.id.as(Int64))
end
assert statements.size == 1

each_iterator = FindEachItem.all.find_each(batch_size: 4).or_panic
assert each_iterator.first(5).map(&.id.as(Int64)).to_a == items.first(5).map(&.id.as(Int64))
assert FindEachItem.all.find_each(batch_size: 4).or_panic.to_a.size == 10

assert FindEachItem.all.find_in_batches(batch_size: 4).or_panic.map(&.size).to_a == [4, 4, 2]

# it: pages with a keyset predicate and never OFFSET
seed_items
statements = capture_sql { FindEachItem.all.find_each(batch_size: 3) { |_item| }.or_panic }

assert statements.size == 4
statements.each { |sql| assert !sql.includes?("OFFSET") }
statements.skip(1).each { |sql| assert sql.includes?(">") }

# it: delegates Model.find_each and Model.find_in_batches to the keyset builder
items = seed_items
ids = items.map(&.id.as(Int64))

statements = capture_sql do
  seen = [] of Int64
  FindEachItem.find_each(batch_size: 4) { |item| seen << item.id.as(Int64) }.or_panic
assert seen == ids
end
statements.each { |sql| assert !sql.includes?("OFFSET") }

batch_sizes = [] of Int32
FindEachItem.find_in_batches(batch_size: 4, start: ids[1], cursor: [:id]) { |batch| batch_sizes << batch.size }.or_panic
assert batch_sizes == [4, 4, 1]

assert FindEachItem.find_each(batch_size: 4, finish: ids[4]).or_panic.map(&.id.as(Int64)).to_a == ids.first(5)
assert FindEachItem.find_each("WHERE bucket = ?", [1_i64] of Value, batch_size: 2).or_panic.map(&.id.as(Int64)).to_a == items.select { |item| item.bucket == 1 }.map(&.id.as(Int64))
assert FindEachItem.find_each(batch_size: 3, offset: 4).or_panic.map(&.id.as(Int64)).to_a == ids.skip(4)

error = FindEachItem.find_each("WHERE bucket = 1 ORDER BY id DESC") { |_item| }
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("WHERE clause")

# it: returns empty iterators for a none relation
seed_items(3)
statements = capture_sql do
assert FindEachItem.none.find_each.or_panic.to_a.empty?
assert FindEachItem.none.find_in_batches.or_panic.to_a.empty?
end
assert statements.empty?

# it: does not mutate the source relation
seed_items
relation = FindEachItem.where(:bucket, :gteq, 0_i64)
conditions = relation.where_fields.size
relation.find_each(batch_size: 2) { |_item| }.or_panic
assert relation.where_fields.size == conditions
assert relation.order_fields.empty?

FindEachItem.adapter.close.or_panic
