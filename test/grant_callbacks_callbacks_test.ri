module test/grant_callbacks_callbacks_test
import grant/base::{Base}
import grant/error::{ErrorBase}
import grant/callbacks::{Failure}
import std/io::{Memory}
import std/uuid::{UUID}
import test/spec_helper::{register_spec_connections}

# Crystal IO::Error becomes a returned native stream error. Memory's native
# writer panics on a closed stream, so check that boundary before writing.
pub class IOError < ErrorBase
end

pub class CallbackHistory < Memory
  def append_line(text : String) : Nil | Failure
    return Failure.new(IOError.new("Closed stream")) if closed?
    self << text + "\n"
    nil
  end
end

pub class Callback < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table callbacks
  column id : Int64, primary: true
  column name : String?
  property history : CallbackHistory = CallbackHistory.new

  {% for name in ["after_initialize", "after_find", "before_validation", "after_validation", "before_save", "after_save", "before_create", "after_create", "before_update", "after_update", "before_destroy", "after_destroy", "after_touch", "after_commit", "after_rollback", "after_create_commit", "after_update_commit", "after_destroy_commit", "after_save_commit"] %}
    {{ name.id }} _{{ name.id }}
    private def _{{ name.id }} : Nil | Failure
      history.append_line({{ name }})
    end
  {% end %}
end

pub class Item < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table items
  column item_id : String, primary: true, auto: false
  column item_name : String?
  before_create :generate_uuid

  def generate_uuid : String
    @item_id = UUID.v4.to_s
  end
end

register_spec_connections
Callback.migrator.drop_and_create.or_panic
Item.migrator.drop_and_create.or_panic

# it: runs before_save, before_create, after_create, after_save
callback = Callback.new(name: "foo")
callback.history = CallbackHistory.new
callback.save.or_panic
assert callback.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_create\nafter_create\nafter_save\nafter_create_commit\nafter_save_commit\nafter_commit"

# it: runs before_save, before_update, after_update, after_save
Callback.new(name: "foo").save.or_panic
callback = Callback.first_strict.or_panic
callback.history = CallbackHistory.new
callback.save.or_panic
assert callback.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_update\nafter_update\nafter_save\nafter_update_commit\nafter_save_commit\nafter_commit"

# it: runs before_destroy, after_destroy
Callback.new(name: "foo").save.or_panic
callback = Callback.first_strict.or_panic
callback.history = CallbackHistory.new
callback.destroy.or_panic
assert callback.history.to_s.strip == "before_destroy\nafter_destroy\nafter_destroy_commit\nafter_commit"

# it: should not get swallowed
callback = Callback.new(name: "foo")
callback.history.close
# The strict native boundary exposes the error that Crystal's save raises.
error = callback.save_strict
assert error.is_a?(IOError)
assert error.as(IOError).message == "Closed stream"

# it: should successfully trigger the callback
item = Item.new(item_name: "item1")
assert item.item_id.nil?
item.before_create
assert item.item_id.is_a?(String)

# it: should successfully trigger the callback
items = [] of Item
items << Item.new(item_name: "item1")
items << Item.new(item_name: "item2")
items << Item.new(item_name: "item3")
items << Item.new(item_name: "item4")
assert items.all? { |item| item.item_id.nil? }
items.each(&.before_create)
assert items.all? { |item| item.item_id.is_a?(String) }

Callback.adapter.close.or_panic
