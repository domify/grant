module test/grant_query_unscope_where_column_test

import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import test/where_family_models::{wf_create_tables, wf_clear_tables}
import test/spec_helper::{register_spec_connections}

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map(&.title.to_s)
end

private def prepare_records : Nil
  wf_clear_tables
  ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
  WfPost.create_strict(title: "a", published: true, score: 1, author_id: ann.id).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  nil
end

register_spec_connections
wf_create_tables

# it: drops only the named column's conditions
prepare_records
relation = WfPost.where(published: true, score: 3).unscope(where: :published)
assert titles(relation) == ["c"]
assert !relation.to_sql.split("FROM").last.includes?("published")


# it: accepts an array of columns
prepare_records
relation = WfPost.where(published: true, score: 3, title: "c").unscope(where: [:published, :score])
assert titles(relation) == ["c"]


# it: drops every condition on the column, ranges and lists included
prepare_records
relation = WfPost.where(score: 1..2).where(score: [1, 2]).where(published: false).unscope(where: :score)
assert titles(relation) == ["b"]


# it: drops nil-aware lists and arrays holding ranges on the column
prepare_records
assert titles(WfPost.where(score: [1, nil]).where(published: true).unscope(where: :score)) == ["a", "c"]
assert titles(WfPost.where(score: [1, 5..9]).unscope(where: :score)) == ["a", "b", "c"]


# it: combines with plain components
prepare_records
relation = WfPost.where(published: true).order(score: :desc).unscope(:order, where: :published)
assert !relation.to_sql.includes?("ORDER BY")
assert !relation.to_sql.split("FROM").last.includes?("published")
assert titles(relation).size == 3


# it: leaves the receiver untouched
prepare_records
base = WfPost.where(published: true)
base.unscope(where: :published)
assert titles(base) == ["a", "c"]


# it: does nothing for a column with no condition
prepare_records
assert titles(WfPost.where(published: true).unscope(where: :score)) == ["a", "c"]


# it: resolves a belongs_to name to its foreign key
prepare_records
author = WfAuthor.first_strict.or_panic
relation = WfPost.where(author: author, published: true).unscope(where: :author)
assert titles(relation) == ["a", "c"]


# it: unscopes includes, preload and eager_load
prepare_records
relation = WfPost.includes(:author).preload(:tags).eager_load(:comments)
assert relation.unscope(:includes).includes_associations.empty?
assert relation.unscope(:preload).preload_associations.empty?
assert relation.unscope(:eager_load).eager_load_associations.empty?
assert !relation.unscope(:includes).preload_associations.empty?


# it: still rejects unknown components
prepare_records
error = WfPost.where(score: 1).unscope(:nonsense).select
assert error.is_a?(ArgumentError)
assert error.message.includes?("unknown component") if error.is_a?(ArgumentError)
