module test/grant_associations_w6_collection_relation_test

import grant/base::{Base}
import grant/query/aggregations::{CalculationResult}
import grant/adapter/driver::{Value}
import grant/events::{SQL}
import grant/notifications
import test/spec_helper::{register_spec_connections}
import std/indexable
import std/big::{BigDecimal}
import std/text
import std/enumerable

pub class W6rUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6r_users
  column id : Int64, primary: true
  column name : String?
  has_many :w6r_posts, class_name: W6rPost, foreign_key: :w6r_user_id
  has_many :w6r_published_posts, -> { where(active: true) }, class_name: W6rPost, foreign_key: :w6r_user_id
  has_many :w6r_links, class_name: W6rLink, foreign_key: :w6r_user_id
  has_many :w6r_tags, class_name: W6rTag, through: :w6r_links
end

pub class W6rPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6r_posts
  column id : Int64, primary: true
  column title : String?
  column score : Int32?
  column active : Bool?
  column w6r_user_id : Int64?
  belongs_to :w6r_user, class_name: W6rUser, foreign_key: :w6r_user_id, optional: true
end

pub class W6rTag < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6r_tags
  column id : Int64, primary: true
  column label : String?
end

pub class W6rLink < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6r_links
  column id : Int64, primary: true
  column w6r_user_id : Int64?
  column w6r_tag_id : Int64?
  belongs_to :w6r_user, class_name: W6rUser, foreign_key: :w6r_user_id, optional: true
  belongs_to :w6r_tag, class_name: W6rTag, foreign_key: :w6r_tag_id, optional: true
end

private def w6r_selects(statements : Array(String)) : Array(String)
  statements.select { |sql| sql.lstrip.upcase.starts_with?("SELECT") }
end

private def w6r_fixture : Tuple(W6rUser, W6rUser)
  user = W6rUser.create_strict(name: "u").or_panic
  other = W6rUser.create_strict(name: "o").or_panic
  [{"a", 3, true}, {"b", 1, true}, {"c", 2, false}, {"d", 5, true}].each do |row|
    title, score, active = row
    W6rPost.create_strict(title: title, score: score, active: active, w6r_user_id: user.id).or_panic
  end
  W6rPost.create_strict(title: "z", score: 100, active: true, w6r_user_id: other.id).or_panic
  {user, other}
end

private def clear_records : Nil
  W6rLink.clear.or_panic
  W6rTag.clear.or_panic
  W6rPost.clear.or_panic
  W6rUser.clear.or_panic
  nil
end

private def statements(&block : -> T) : Array(String) forall T
  captured = [] of String
  subscription = ::Grant::Notifications.subscribe(SQL) do |event|
    captured << event.sql
    nil
  end
  yield
  subscription.unsubscribe
  captured
end

register_spec_connections
W6rUser.migrator.drop_and_create.or_panic
W6rPost.migrator.drop_and_create.or_panic
W6rTag.migrator.drop_and_create.or_panic
W6rLink.migrator.drop_and_create.or_panic

# it: orders and limits in SQL without loading the association
clear_records
user, _ = w6r_fixture
collection = user.w6r_posts
titles = [] of String?
captured = statements do
  titles = collection.order(score: :desc).limit(2).map(&.title).or_panic
end
assert titles == ["d", "a"]
selects = w6r_selects(captured)
assert selects.size == 1
assert selects.first.upcase.includes?("ORDER BY")
assert selects.first.upcase.includes?("LIMIT 2")
assert !collection.loaded?

# it: applies offset, reorder and reverse_order
clear_records
user, _ = w6r_fixture
assert user.w6r_posts.order(score: :asc).offset(1).limit(2).map(&.title).or_panic == ["c", "a"]
assert user.w6r_posts.order(score: :asc).reorder(score: :desc).first.or_panic.as(W6rPost).title == "d"
assert user.w6r_posts.order(score: :asc).reverse_order.first.or_panic.as(W6rPost).title == "d"

# it: plucks only the requested columns
clear_records
user, _ = w6r_fixture
values = [] of Array(Value)
captured = statements do
  values = user.w6r_posts.order(:score).pluck(:title, :score).or_panic
end
assert values.map { |row| {row[0], row[1].to_s} } == [{"b", "1"}, {"c", "2"}, {"a", "3"}, {"d", "5"}]
selects = w6r_selects(captured)
assert selects.size == 1
assert !selects.first.includes?("active")

# it: aggregates in SQL
clear_records
user, _ = w6r_fixture
sum = nil.as(CalculationResult?)
captured = statements { sum = user.w6r_posts.sum(:score).or_panic }
assert sum.to_s == "11"
assert w6r_selects(captured).first.upcase.includes?("SUM(")
assert user.w6r_posts.sum(:score, as: Int64).or_panic == 11_i64
assert user.w6r_posts.sum(:score, as: Float64).or_panic == 11.0
assert user.w6r_posts.sum(:score, as: BigDecimal).or_panic == BigDecimal.new("11")
assert user.w6r_posts.minimum(:score).or_panic.to_s == "1"
assert user.w6r_posts.maximum(:score).or_panic.to_s == "5"
assert user.w6r_posts.average(:score).or_panic.to_s.to_f == 2.75

# it: answers distinct and group in SQL
clear_records
user, _ = w6r_fixture
W6rPost.create_strict(title: "a", score: 9, active: false, w6r_user_id: user.id).or_panic
assert user.w6r_posts.select(:title).distinct.count.or_panic == 4
grouped = user.w6r_posts.group_records(:active).count.or_panic
assert !grouped.is_a?(Int64)
assert (grouped.is_a?(Hash) ? grouped.size : 0) == 2

# it: iterates in batches with find_each and in_batches
clear_records
user, _ = w6r_fixture
seen = [] of String?
captured = statements do
  user.w6r_posts.find_each(batch_size: 2) { |post| seen << post.title }.or_panic
end
assert seen.compact.sorted == ["a", "b", "c", "d"]
assert w6r_selects(captured).size >= 2
sizes = [] of Int32
user.w6r_posts.in_batches(of: 3, load: true) { |batch| sizes << batch.select.or_panic.size }.or_panic
assert sizes.sum == 4
batches = [] of Int32
user.w6r_posts.find_in_batches(batch_size: 3) { |batch| batches << batch.size }.or_panic
assert batches == [3, 1]

# it: joins and preloads from the owner scope
clear_records
user, _ = w6r_fixture
assert user.w6r_posts.joins(:w6r_user).count.or_panic == 4
posts = user.w6r_posts.includes(:w6r_user).select.or_panic
assert posts.size == 4
assert posts.first.w6r_user_strict.or_panic.id == user.id

# it: chains where, not and the where chain onto the owner scope
clear_records
user, _ = w6r_fixture
assert user.w6r_posts.where(active: true).order(:score).map(&.title).or_panic == ["b", "a", "d"]
assert user.w6r_posts.where("score > ?", 2).count.or_panic == 2
assert user.w6r_posts.where(:score, :gt, 2).count.or_panic == 2
assert user.w6r_posts.where.not(:score, 2).count.or_panic == 3

# it: keeps the association scope when chaining
clear_records
user, _ = w6r_fixture
assert user.w6r_published_posts.order(score: :desc).pluck(:title).or_panic.map(&.first) == ["d", "a", "b"]
assert user.w6r_published_posts.sum(:score).or_panic.to_s == "9"

# it: works on a has_many :through collection
clear_records
user, _ = w6r_fixture
other_tag = W6rTag.create_strict(label: "x").or_panic
tags = ["t1", "t2", "t3"].map { |label| W6rTag.create_strict(label: label).or_panic }
tags.each { |tag| W6rLink.create_strict(w6r_user_id: user.id, w6r_tag_id: tag.id).or_panic }
W6rLink.create_strict(w6r_user_id: W6rUser.create_strict(name: "n").or_panic.id, w6r_tag_id: other_tag.id).or_panic
assert user.w6r_tags.order(label: :desc).limit(2).pluck(:label).or_panic.map(&.first) == ["t3", "t2"]
assert user.w6r_tags.count.or_panic == 3
assert user.w6r_tags.pluck(:label).or_panic.size == 3

# it: leaves Enumerable methods on loaded records untouched
clear_records
user, _ = w6r_fixture
collection = user.w6r_posts
collection.load_target.or_panic
captured = statements do
  assert collection.compact_map(&.title).or_panic.sorted == ["a", "b", "c", "d"]
  assert collection.sum { |post| post.score || 0 }.or_panic == 11
  assert collection.group_by(&.active).or_panic.size == 2
end
assert captured.empty?
