module test/grant_validations_validator_test
import grant/base::{Base}
import std/text

pub class NameTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column name : String?

  validate :name, "cannot be blank", ->(s : NameTest) do
    !s.name.to_s.strip.empty?
  end
end

pub class EmailTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column email : String?

  validate :email, "cannot be blank" do |email_test|
    !email_test.email.to_s.strip.empty?
  end
end

pub class PasswordTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column password : String?
  column password_validation : String?

  validate "password and validation should match" do |password_test|
    password_test.password == password_test.password_validation
  end
end

# it: returns true if name is set
subject = NameTest.new
subject.name = "name"
assert subject.valid?.or_panic == true

# it: returns false if name is blank
subject = NameTest.new
subject.name = ""
assert subject.valid?.or_panic == false

# it: returns true if email is set
subject = EmailTest.new
subject.email = "test@example.com"
assert subject.valid?.or_panic == true

# it: returns false if email is blank
subject = EmailTest.new
subject.email = ""
assert subject.valid?.or_panic == false

# it: returns true if passwords match
subject = PasswordTest.new
subject.password = "123"
subject.password_validation = "123"
assert subject.valid?.or_panic == true

# it: returns false if password does not match
subject = PasswordTest.new
subject.password = "123"
subject.password_validation = "1234"
assert subject.valid?.or_panic == false

# it: returns true if name is rectified after after failing
subject = NameTest.new
subject.name = ""
assert subject.valid?.or_panic == false

subject.name = "name"
assert subject.valid?.or_panic == true
