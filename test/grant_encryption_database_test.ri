module test/grant_encryption_database_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/key_provider::{KeyProvider}
import std/base64::{Base64}
import std/regex
import std/text
import test/spec_helper::{register_spec_connections}

pub class EncryptedUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table encrypted_users
  column id : Int64, primary: true
  column name : String
  encrypts :email, deterministic: true
  encrypts :phone, deterministic: true
  encrypts :ssn
  timestamps
end

register_spec_connections
EncryptedUser.migrator.drop_and_create.or_panic
Grant::Encryption.configure do |config|
  (config.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
  (config.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
  config.key_derivation_salt = Base64.encode("test_salt_key_32_bytes_long!!!!!")
end

# it: saves and retrieves encrypted data
EncryptedUser.clear.or_panic
user = EncryptedUser.new(name: "John Doe", email: "john@example.com", phone: "+1-555-0123", ssn: "123-45-6789")
user.save_strict.or_panic
assert user.persisted?
assert !user.id.nil?
retrieved = EncryptedUser.find_strict(user.id).or_panic
assert retrieved.name == "John Doe"
assert retrieved.email.or_panic == "john@example.com"
assert retrieved.phone.or_panic == "+1-555-0123"
assert retrieved.ssn.or_panic == "123-45-6789"

# it: stores encrypted data in database
EncryptedUser.clear.or_panic
user = EncryptedUser.create_strict(name: "Jane Doe", email: "jane@example.com", ssn: "987-65-4321").or_panic
adapter = EncryptedUser.adapter
raw_data = adapter.open do |db|
  query = adapter.ensure_clause_template("SELECT email_encrypted, ssn_encrypted FROM encrypted_users WHERE id = ?")
  db.query(query, [user.id.as(Int64)] of ::Grant::Adapter::Driver::Value)
end.or_panic.first
email_encrypted = raw_data["email_encrypted"].as(String?)
ssn_encrypted = raw_data["ssn_encrypted"].as(String?)
assert !email_encrypted.nil?
assert !ssn_encrypted.nil?
assert /^[A-Za-z0-9+\/=]+$/.match?(email_encrypted.as(String))
assert /^[A-Za-z0-9+\/=]+$/.match?(ssn_encrypted.as(String))

# it: queries deterministic encrypted fields
EncryptedUser.clear.or_panic
user1 = EncryptedUser.create_strict(name: "User 1", email: "user1@example.com", phone: "+1-555-0001").or_panic
user2 = EncryptedUser.create_strict(name: "User 2", email: "user2@example.com", phone: "+1-555-0002").or_panic
user3 = EncryptedUser.create_strict(name: "User 3", email: "user1@example.com", phone: "+1-555-0003").or_panic
results = EncryptedUser.where_email("user1@example.com").select.or_panic
assert results.size == 2
assert results.map { |row| row.id.as(Int64) }.sorted == [user1.id.as(Int64), user3.id.as(Int64)].sorted
found = EncryptedUser.find_by_phone("+1-555-0002").or_panic
assert !found.nil?
assert found.as(EncryptedUser).id == user2.id
found = EncryptedUser.find_by_email("user2@example.com").or_panic
assert !found.nil?
assert found.as(EncryptedUser).id == user2.id

# it: handles nil values in database
EncryptedUser.clear.or_panic
user = EncryptedUser.create_strict(name: "No Email User").or_panic
assert user.email.or_panic.nil?
assert user.ssn.or_panic.nil?
retrieved = EncryptedUser.find_strict(user.id).or_panic
assert retrieved.email.or_panic.nil?
assert retrieved.ssn.or_panic.nil?
(retrieved.email = "newemail@example.com").or_panic
(retrieved.ssn = "555-55-5555").or_panic
retrieved.save_strict.or_panic
updated = EncryptedUser.find_strict(user.id).or_panic
assert updated.email.or_panic == "newemail@example.com"
assert updated.ssn.or_panic == "555-55-5555"
(updated.email = nil).or_panic
updated.save_strict.or_panic
final = EncryptedUser.find_strict(user.id).or_panic
assert final.email.or_panic.nil?

# it: tracks changes to encrypted attributes
EncryptedUser.clear.or_panic
user = EncryptedUser.create_strict(name: "Track User", email: "original@example.com").or_panic
(user.email = "new@example.com").or_panic
assert user.changed?
assert user.changed.includes?("email_encrypted")
user.save_strict.or_panic
assert !user.changed?
assert user.saved_change_to_attribute?("email_encrypted")

# it: handles bulk inserts with encryption
EncryptedUser.clear.or_panic
users = [] of EncryptedUser
100.times do |i|
  users << EncryptedUser.new(name: "Bulk User #{i}", email: "bulk#{i}@example.com", ssn: "555-00-#{i.to_s.rjust(4, '0')}")
end
users.each { |row| row.save_strict.or_panic }
assert EncryptedUser.count.or_panic == 100
sample = EncryptedUser.find_by_email("bulk50@example.com").or_panic
assert !sample.nil?
assert sample.as(EncryptedUser).ssn.or_panic == "555-00-0050"

# it: combines encrypted and non-encrypted fields in queries
EncryptedUser.clear.or_panic
user1 = EncryptedUser.create_strict(name: "Alice", email: "alice@example.com").or_panic
EncryptedUser.create_strict(name: "Bob", email: "bob@example.com").or_panic
user3 = EncryptedUser.create_strict(name: "Alice", email: "alice2@example.com").or_panic
results = EncryptedUser.where_encrypted(name: "Alice", email: "alice@example.com").select.or_panic
assert results.size == 1
assert results.first.id == user1.id
results = EncryptedUser.where_encrypted(name: "Alice", email: "alice2@example.com").select.or_panic
assert results.size == 1
assert results.first.id == user3.id

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
