module test/grant_connection_abstract_inheritance_test
import grant/base::{Base}
import grant/connection_handling::{ConnectionHandling}

# Native classes cannot reopen. Keep the parent's DSL on its original declaration;
# apply its captured configuration after the children exist, through the same setters.
pub abstract class C01AbstractRecord < Base
  abstract_class
  connects_to(database: {writing: "c01_abs_writer", reading: "c01_abs_reader"}, shards: {
    default: {writing: "c01_abs_writer", reading: "c01_abs_reader"},
    two: {writing: "c01_abs_two", reading: "c01_abs_two_reader"},
  })
end
parent_roles = C01AbstractRecord.connection_config
parent_shards = C01AbstractRecord.shard_config
C01AbstractRecord.connection_config = {} of Symbol => String
C01AbstractRecord.shard_config = {} of Symbol => Hash(Symbol, String)
C01AbstractRecord.default_database_name = "primary"

pub class C01EarlyChild < C01AbstractRecord
  table c01_early_children
  column id : Int64, primary: true
end
pub class C01GrandChild < C01EarlyChild
end
pub class C01OverridingChild < C01AbstractRecord
  table c01_overriding_children
  column id : Int64, primary: true
  connects_to database: {writing: "c01_own_writer", reading: "c01_own_reader"}
end
pub class C01LateChild < C01AbstractRecord
  table c01_late_children
  column id : Int64, primary: true
end
pub abstract class C01PrimaryAbstract < Base
  primary_abstract_class
end
pub class InheritanceTodo < Base
  table todos
  column id : Int64, primary: true
end

C01AbstractRecord.default_database_name = "c01_abs_writer"
C01AbstractRecord.connection_config = parent_roles
C01AbstractRecord.shard_config = parent_shards

# it: propagates a later connects_to on the parent to earlier and later children
names = {C01EarlyChild.default_database_name, C01LateChild.default_database_name,
  C01GrandChild.default_database_name}
assert names == {"c01_abs_writer", "c01_abs_writer", "c01_abs_writer"}
assert C01EarlyChild.connection_config.to_s ==
  {:writing => "c01_abs_writer", :reading => "c01_abs_reader"}.to_s
assert C01GrandChild.connection_config[:reading] == "c01_abs_reader"
assert C01LateChild.shard_keys == [:default, :two]
assert C01GrandChild.sharded?

# it: lets a child's own connects_to win over the parent's
assert C01OverridingChild.default_database_name == "c01_own_writer"
assert C01OverridingChild.connection_config[:reading] == "c01_own_reader"
assert C01OverridingChild.shard_keys.empty?
assert !C01OverridingChild.sharded?
assert C01EarlyChild.default_database_name == "c01_abs_writer"

# it: follows a change made on the parent after children resolved it
original = C01AbstractRecord.connection_config
C01AbstractRecord.connection_config = {:writing => "c01_moved", :reading => "c01_moved_reader"}
assert C01GrandChild.connection_config[:writing] == "c01_moved"
C01AbstractRecord.connection_config = original
assert C01GrandChild.connection_config[:writing] == "c01_abs_writer"

# it: does not let one model's connects_to reach its siblings
assert C01OverridingChild.default_database_name != C01LateChild.default_database_name

# it: marks abstract classes without inheriting the marker
assert C01AbstractRecord.abstract_class?
assert !C01EarlyChild.abstract_class?
assert !C01GrandChild.abstract_class?
assert !InheritanceTodo.abstract_class?

# it: records the primary abstract class
assert C01PrimaryAbstract.abstract_class?
assert ConnectionHandling.primary_abstract_class_name == C01PrimaryAbstract.to_s

# it: applies connected_to on the abstract parent to its children only
C01AbstractRecord.connected_to(role: :reading) do
  assert C01GrandChild.connected_to?(role: :reading).or_panic
  assert C01GrandChild.preventing_writes?
  assert !InheritanceTodo.connected_to?(role: :reading).or_panic
end
