module test/spike_crud_test
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class SpikeRecord < Base
  table spike_records
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column name : String
  getter callback_ran : Bool = false
  after_destroy :after_deletion
  private def after_deletion
    @callback_ran = true
  end
end

register_spec_connections
SpikeRecord.migrator.drop_and_create.or_panic
record = SpikeRecord.create(name: "before")
assert record.persisted?
record.name = "after"
assert record.save.or_panic
assert SpikeRecord.find_strict(record.id).or_panic.name == "after"
assert SpikeRecord.where(name: "after").select.or_panic.size == 1
assert record.destroy.or_panic
assert record.callback_ran
assert record.destroyed?
assert SpikeRecord.find(record.id).nil?
SpikeRecord.adapter.close.or_panic
