module test/grant_schema_timestamps_ddl_test
import grant/base::{Base}
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/table_definition::{TableDefinition}
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/schema::{Dialect}
import grant/error::{ErrorBase}
import std/time::{Time}
import std/regex
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

pub class M02aStampedRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_stamped_rows
  column id : Int64, primary: true
  column name : String?
  column created_at : Time?, null: false
  column updated_at : Time?
end

# it: is NOT NULL with microsecond precision by default
body = ->(t : TableDefinition) { t.timestamps }
pg = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02a_t, id: false) { |t| body.call(t) }.or_panic.first
assert pg.includes?("\"created_at\" TIMESTAMP(6) NOT NULL")
assert pg.includes?("\"updated_at\" TIMESTAMP(6) NOT NULL")
my = RecordingStatements.new(Dialect::Mysql).create_table_statements(:m02a_t, id: false) { |t| body.call(t) }.or_panic.first
assert my.includes?("`created_at` DATETIME(6) NOT NULL")
lite = RecordingStatements.new(Dialect::Sqlite).create_table_statements(:m02a_t, id: false) { |t| body.call(t) }.or_panic.first
assert lite.includes?("\"updated_at\" DATETIME NOT NULL")

# it: honors precision: and null:
sql = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02a_t, id: false) do |t|
  t.timestamps(precision: 3, null: true)
end.or_panic.first
assert sql.includes?("\"created_at\" TIMESTAMP(3),")
assert sql.includes?("\"updated_at\" TIMESTAMP(3)\n")
assert RecordingStatements.new(Dialect::Mysql).create_table_statements(:m02a_t, id: false) { |t| t.timestamps(precision: 0) }.or_panic.first.includes?("`created_at` DATETIME(0) NOT NULL")

# it: uses one ALTER on PostgreSQL and MySQL
assert RecordingStatements.new(Dialect::Pg).add_timestamps_statements(:users).or_panic == ["ALTER TABLE \"users\" ADD COLUMN \"created_at\" TIMESTAMP(6) NOT NULL, ADD COLUMN \"updated_at\" TIMESTAMP(6) NOT NULL"]
assert RecordingStatements.new(Dialect::Mysql).add_timestamps_statements(:users, precision: 3, null: true).or_panic == ["ALTER TABLE `users` ADD COLUMN `created_at` DATETIME(3), ADD COLUMN `updated_at` DATETIME(3)"]
assert RecordingStatements.new(Dialect::Pg).remove_timestamps_statements(:users) == ["ALTER TABLE \"users\" DROP COLUMN \"created_at\", DROP COLUMN \"updated_at\""]

# it: uses one ALTER per column on SQLite and rebuilds the table for a NOT NULL add without default
lite = RecordingStatements.new(Dialect::Sqlite)
assert lite.add_timestamps_statements(:users, null: true).or_panic == ["ALTER TABLE \"users\" ADD COLUMN \"created_at\" DATETIME", "ALTER TABLE \"users\" ADD COLUMN \"updated_at\" DATETIME"]
assert lite.remove_timestamps_statements(:users).size == 2
definition = "CREATE TABLE \"users\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"name\" VARCHAR(255))"
lite.sqlite_tables["users"] = {definition, [] of String}
rebuild = lite.add_timestamps_statements(:users).or_panic
assert rebuild.first == "PRAGMA foreign_keys = OFF"
assert rebuild.any? { |text| text.includes?("\"created_at\" DATETIME NOT NULL") }
assert lite.add_timestamps_statements(:users, default: "1970-01-01 00:00:00").or_panic.first.includes?("NOT NULL DEFAULT '1970-01-01 00:00:00'")

register_spec_connections
restore_default_spec_connections
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)

# it: honors null: false in the create SQL
sql = M02aStampedRow.migrator.create_sql
assert sql.matches?(/created_at["`] [A-Z0-9()]+ NOT NULL/)
assert !sql.matches?(/updated_at["`] [A-Z0-9()]+ NOT NULL/)

# it: creates NOT NULL timestamps and rejects a null
statements.drop_table(:m02a_stamps, if_exists: true).or_panic
statements.create_table(:m02a_stamps) do |t|
  t.string(:name)
  t.timestamps
end.or_panic
columns = {} of String => ColumnInfo
::Test::SchemaFixture.adapter.schema.columns(:m02a_stamps).or_panic.each { |column| columns[column.name] = column }
assert !columns["created_at"].null?
assert !columns["updated_at"].null?
error = ::Test::SchemaFixture.adapter.open { |db| db.exec("INSERT INTO m02a_stamps (name) VALUES ('x')") }
assert error.is_a?(ErrorBase)

# it: adds and removes timestamps on an existing table
statements.drop_table(:m02a_stamps, if_exists: true).or_panic
statements.create_table(:m02a_stamps) { |t| t.string(:name) }.or_panic
if CURRENT_ADAPTER == "sqlite"
  statements.add_timestamps(:m02a_stamps, default: "1970-01-01 00:00:00").or_panic
else
  statements.add_timestamps(:m02a_stamps).or_panic
end
columns = ::Test::SchemaFixture.adapter.schema.columns(:m02a_stamps).or_panic
assert columns.map { |column| column.name } == ["id", "name", "created_at", "updated_at"]
assert columns.reject { |column| ["id", "name"].includes?(column.name) }.all? { |column| !column.null? }
statements.remove_timestamps(:m02a_stamps).or_panic
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_stamps).or_panic.map { |column| column.name } == ["id", "name"]
statements.add_timestamps(:m02a_stamps, null: true, precision: 3).or_panic
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_stamps).or_panic.find { |column| column.name == "created_at" }.as(ColumnInfo).null?

# it: enforces NOT NULL on a model column declared null: false
M02aStampedRow.migrator.drop_and_create.or_panic
assert !::Test::SchemaFixture.adapter.schema.columns(:m02a_stamped_rows).or_panic.find { |column| column.name == "created_at" }.as(ColumnInfo).null?
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_stamped_rows).or_panic.find { |column| column.name == "updated_at" }.as(ColumnInfo).null?
statements.drop_table(:m02a_stamps, if_exists: true).or_panic
M02aStampedRow.migrator.drop.or_panic
