module test/grant_transaction_handle_test
import std/enumerable
import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/driver::{Connection}
import grant/errors::{Rollback, ErrorBase, NotOpenError, InvalidSavepointNameError}
import grant/transaction::{Handle, IsolationLevel, ConnectionTransactions}
import grant::{transaction, connection}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: is a closed null handle that runs after_commit immediately
handle = Parent.current_transaction
assert !handle.open?
assert handle.closed?
assert handle.isolation.nil?
ran = false
handle.after_commit { ran = true; nil }
assert ran
rolled = false
handle.after_rollback { rolled = true; nil }
assert !rolled

# it: reports open? and isolation
Parent.transaction(isolation: IsolationLevel::ReadCommitted) do
  handle = Parent.current_transaction
  assert handle.open?
  assert handle.isolation == IsolationLevel::ReadCommitted
  assert !handle.readonly?
end.or_panic

# it: is the same handle in joined blocks and closed after the transaction
captured : Handle? = nil
Parent.transaction do
  outer = Parent.current_transaction
  Parent.transaction { assert Parent.current_transaction.object_id == outer.object_id }.or_panic
  captured = outer
end.or_panic
assert !captured.nil? && !captured.as(Handle).open?

# it: fires after_commit at COMMIT, not before, and drops after_rollback
events = [] of Symbol
Parent.transaction do
  Parent.current_transaction.after_commit { events << :commit; nil }
  Parent.current_transaction.after_rollback { events << :rollback; nil }
  assert events.empty?
end.or_panic
assert events == [:commit]

# it: fires after_rollback on Rollback and drops after_commit
events = [] of Symbol
Parent.transaction do
  Parent.current_transaction.after_commit { events << :commit; nil }
  Parent.current_transaction.after_rollback { events << :rollback; nil }
  Rollback.new
end.or_panic
assert events == [:rollback]

# it: fires after_rollback when an exception escapes
events = [] of Symbol
error = Parent.transaction do
  Parent.current_transaction.after_rollback { events << :rollback; nil }
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert events == [:rollback]

# it: runs callbacks in registration order
order = [] of Int32
Parent.transaction do
  handle = Parent.current_transaction
  handle.after_commit { order << 1; nil }
  handle.after_commit { order << 2; nil }
end.or_panic
assert order == [1, 2]

# it: commits a begun transaction
Parent.clear.or_panic
connection = Parent.connection
events = [] of Symbol
handle = connection.begin_transaction.or_panic
assert handle.open?
handle.after_commit { events << :commit; nil }
Parent.create_strict(name: "Manual").or_panic
handle.commit.or_panic
assert !handle.open?
assert events == [:commit]
assert !Parent.transaction_open?
assert Parent.count.or_panic == 1

# it: rolls back a begun transaction
Parent.clear.or_panic
connection = Parent.connection
events = [] of Symbol
handle = connection.begin_transaction.or_panic
handle.after_rollback { events << :rollback; nil }
Parent.create_strict(name: "Manual").or_panic
connection.rollback.or_panic
assert events == [:rollback]
assert !Parent.transaction_open?
assert Parent.count.or_panic == 0

# it: opens nested manual handles as savepoints
Parent.clear.or_panic
connection = Parent.connection
outer = connection.begin_transaction.or_panic
Parent.create_strict(name: "Outer").or_panic
inner = connection.begin_transaction.or_panic
assert inner.open?
Parent.create_strict(name: "Inner").or_panic
inner.rollback.or_panic
assert !inner.open?
assert outer.open?
outer.commit.or_panic
assert Parent.all.select.or_panic.map { |parent| parent.name } == ["Outer"]

# it: raises NotOpenError when nothing is open or a handle is reused
connection = Parent.connection
assert connection.commit.is_a?(NotOpenError)
assert connection.rollback.is_a?(NotOpenError)
handle = connection.begin_transaction.or_panic
handle.commit.or_panic
assert handle.commit.is_a?(NotOpenError)

# it: runs named savepoint blocks and validates the name
Parent.clear.or_panic
connection = Parent.connection
Parent.transaction do
  Parent.create_strict(name: "Outer").or_panic
  connection.savepoint("before_extra") do
    Parent.create_strict(name: "Extra").or_panic
    Rollback.new
  end.or_panic
end.or_panic
assert Parent.count.or_panic == 1
assert connection.savepoint("x") { nil }.is_a?(NotOpenError)
Parent.transaction do
  assert connection.savepoint("x; DROP TABLE parents") { nil }.is_a?(InvalidSavepointNameError)
end.or_panic

# it: shares the stack with Model.transaction
Parent.clear.or_panic
transaction do
  assert Parent.transaction_open?
  Parent.create_strict(name: "Via Grant").or_panic
  Rollback.new
end.or_panic
assert Parent.count.or_panic == 0

# it: accepts a database name and options
Parent.clear.or_panic
transaction(CURRENT_ADAPTER, isolation: IsolationLevel::ReadCommitted) do
  Parent.create_strict(name: "Named").or_panic
end.or_panic
assert Parent.count.or_panic == 1

# it: runs raw connection SQL inside the transaction
Parent.clear.or_panic
::Grant.connection(CURRENT_ADAPTER).transaction do
  ::Grant.connection(CURRENT_ADAPTER).execute("INSERT INTO parents (name) VALUES ('raw')").or_panic
  Rollback.new
end.or_panic
assert Parent.count.or_panic == 0
Parent.adapter.close.or_panic
