module test/grant_perf_w6_statement_count_test
import grant/base::{Base}
import grant/errors::{DatabaseError}
import grant/error::{ErrorBase}
import grant/transaction::{Options}
import grant/events::{TransactionStart}
import grant/notifications
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Native counterpart of the upstream db log backend: observe statements at
# the driver's actual prepare boundary, including transaction control.
pub class W6PerfStatementLog
  getter list_of_statements = [] of String
end
W6_PERF_STATEMENT_LOG = W6PerfStatementLog.new
W6_PERF_BEGIN = "BEGIN"

private def w6_perf_statements(&block : -> T) : Array(String) forall T
  W6_PERF_STATEMENT_LOG.list_of_statements.clear
  connection = W6PerfPerson.__connection
  previous = connection.query_observer
  connection.query_observer = ->(sql : String) { W6_PERF_STATEMENT_LOG.list_of_statements << sql; nil }
  yield
  connection.query_observer = previous
  W6_PERF_STATEMENT_LOG.list_of_statements.dup
end

pub class W6PerfPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_people
  column id : Int64, primary: true
  column name : String
  column score : Int32?
  timestamps
end

pub class W6PerfAuditedPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_audited_people
  column id : Int64, primary: true
  column name : String
  column touches : Int32 = 0
  before_save :write_audit_row

  private def write_audit_row
    W6PerfPerson.create_strict(name: "audit of #{name}").or_panic
  end
end

private def reset
  W6PerfPerson.clear.or_panic
  W6PerfAuditedPerson.clear.or_panic
end

register_spec_connections
W6PerfPerson.migrator.drop_and_create.or_panic
W6PerfAuditedPerson.migrator.drop_and_create.or_panic

# it: runs nothing for a record with no changes
reset
person = W6PerfPerson.create_strict(name: "Clean").or_panic
loaded = W6PerfPerson.find_strict(person.id).or_panic
statements = w6_perf_statements { assert loaded.save.or_panic }
assert statements.empty?

# it: runs nothing for a record that was just saved
reset
person = W6PerfPerson.create_strict(name: "Fresh").or_panic
statements = w6_perf_statements { assert person.save.or_panic }
assert statements.empty?

# Native regression checks for the deferred transaction lifecycle.
created_at = person.created_at
updated_at = person.updated_at
assert person.save.or_panic
assert person.created_at == created_at
assert person.updated_at == updated_at

committed = false
statements = w6_perf_statements do
  value = W6PerfPerson.transaction(Options.new(lazy_begin: true)) do
    W6PerfPerson.current_transaction.after_commit { committed = true; nil }
    42
  end.or_panic
  assert value == 42
end
assert statements.empty?
assert committed
assert !W6PerfPerson.transaction_open?
assert W6PerfPerson.__connection.transaction_materializer.nil?

rolled_back = false
statements = w6_perf_statements do
  error = W6PerfPerson.transaction(Options.new(lazy_begin: true)) do
    W6PerfPerson.current_transaction.after_rollback { rolled_back = true; nil }
    ErrorBase.new("before any statement")
  end
  assert error.is_a?(ErrorBase)
  assert error.as(ErrorBase).message == "before any statement"
end
assert statements.empty?
assert rolled_back
assert !W6PerfPerson.transaction_open?
assert W6PerfPerson.__connection.transaction_materializer.nil?

statements = w6_perf_statements do
  W6PerfPerson.transaction(Options.new(lazy_begin: true)) do
    W6PerfPerson.transaction(requires_new: true) { nil }.or_panic
  end.or_panic
end
assert statements.size == 4
assert statements[0] == (W6PerfPerson.adapter.postgres? ? "BEGIN READ WRITE" : "BEGIN")
assert statements[1].starts_with?("SAVEPOINT ")
assert statements[2].starts_with?("RELEASE SAVEPOINT ")
assert statements[3] == "COMMIT"

start_contexts = [] of Bool
::Grant::Notifications.subscribed(TransactionStart, ->(event : TransactionStart) { start_contexts << W6PerfPerson.current_transaction.open?; nil }) do
  W6PerfPerson.transaction { nil }.or_panic
  W6PerfPerson.transaction(Options.new(lazy_begin: true)) { W6PerfPerson.count.or_panic }.or_panic
end
assert start_contexts == [true, true]

W6PerfPerson.__connection.close.or_panic
failed_person = W6PerfPerson.new(name: "closed connection")
error = failed_person.save_strict
assert error.is_a?(DatabaseError)
assert failed_person.new_record?
assert failed_person.id.nil?
assert !W6PerfPerson.transaction_open?
assert W6PerfPerson.__connection.transaction_materializer.nil?
