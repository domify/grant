module test/grant_convenience_methods_query_test
import grant/base
import std/env
import std/time::{Time}
import test/spec_helper::{register_spec_connections}
import grant/querying::{NotFound, NotUnique}
import grant/columns::{Type}
register_spec_connections

pub class ConvenienceUser < ::Grant::Base::Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table convenience_users

  column id : Int64, primary: true
  column name : String
  column email : String
  column age : Int32
  column created_at : Time?
  column updated_at : Time?

  # Add unique index on email for upsert tests
  # In real app this would be in migration
end

ConvenienceUser.migrator.drop_and_create.or_panic
ConvenienceUser.exec("CREATE UNIQUE INDEX IF NOT EXISTS idx_convenience_users_email ON convenience_users(email)").or_panic

# it: extracts single column values
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
names = ConvenienceUser.order(id: :asc).pluck(:name).or_panic
assert names == [["John"], ["Jane"]]

# it: extracts multiple column values
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
data = ConvenienceUser.order(id: :asc).pluck(:name, :age).or_panic
assert data == [["John", 25], ["Jane", 30]]

# it: respects where conditions
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
ConvenienceUser.create_strict(name: "Jim", email: "jim@example.com", age: 35).or_panic
names = ConvenienceUser.where(age: 30..40).order(age: :asc).pluck(:name).or_panic
assert names == [["Jane"], ["Jim"]]

# it: respects order
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "Charlie", email: "charlie@example.com", age: 35).or_panic
ConvenienceUser.create_strict(name: "Alice", email: "alice@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Bob", email: "bob@example.com", age: 30).or_panic
names = ConvenienceUser.order(name: :asc).pluck(:name).or_panic
assert names == [["Alice"], ["Bob"], ["Charlie"]]

# it: extracts values from the first record
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
data = ConvenienceUser.order(name: :asc).pick(:name, :age).or_panic
assert data == ["Jane", 30]

# it: returns nil when no records exist
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
data = ConvenienceUser.pick(:name, :age).or_panic
assert data.nil?

# it: respects where conditions
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
data = ConvenienceUser.where(age: 30..30).pick(:name, :age).or_panic
assert data == ["Jane", 30]

# it: processes records in batches
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
10.times do |i|
  ConvenienceUser.create_strict(name: "User#{i}", email: "user#{i}@example.com", age: 20 + i).or_panic
end
total_users = ConvenienceUser.count.or_panic
assert total_users == 10
batch_sizes = [] of Int32
total_processed = 0
ConvenienceUser.in_batches(of: 3) do |batch|
  batch_sizes << batch.to_a.or_panic.size.to_i32
  total_processed += batch.to_a.or_panic.size
end
assert total_processed == 10
assert batch_sizes == [3, 3, 3, 1]

# it: respects start and finish constraints
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
10.times do |i|
  ConvenienceUser.create_strict(name: "User#{i}", email: "user#{i}@example.com", age: 20 + i).or_panic
end
users = ConvenienceUser.order(id: :asc).select.or_panic
assert users.size == 10
start_id = (users[2].id || raise "missing id")
finish_id = (users[7].id || raise "missing id")
processed_ids = [] of Int64
ConvenienceUser.in_batches(of: 2, start: start_id, finish: finish_id) do |batch|
  batch.each { |user| processed_ids << (user.id || raise "missing id") }.or_panic
end
assert processed_ids.size == 6
assert processed_ids.min == start_id
assert processed_ids.max == finish_id

# it: processes batches in descending order
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
5.times do |i|
  ConvenienceUser.create_strict(name: "User#{i}", email: "user#{i}@example.com", age: 20 + i).or_panic
end
batch_first_names = [] of String
ConvenienceUser.in_batches(of: 2, order: :desc) do |batch|
  batch_first_names << (batch.first_strict.or_panic.name || raise "missing name")
end
assert batch_first_names.first == "User4"

# it: does not mutate the source relation or accumulate cursor predicates across batches
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
8.times do |i|
  ConvenienceUser.create_strict(name: "User#{i}", email: "user#{i}@example.com", age: 20 + i).or_panic
end
relation = ConvenienceUser.where(:age, :gteq, 20)
where_count_before = relation.where_fields.size
seen = [] of Int64
relation.in_batches(of: 1) do |batch|
  batch.each { |user| seen << (user.id || raise "missing id") }.or_panic
end
assert seen.size == 8
assert seen.uniq.size == 8
assert relation.where_fields.size == where_count_before

# it: adds comments to queries
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
users = ConvenienceUser.where(name: "John").annotate("Dashboard query").select.or_panic
assert users.size == 1
assert users.first.name == "John"

# it: returns the single record
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
user = ConvenienceUser.sole.or_panic
assert user.name == "John"

# it: raises NotFound when no records exist
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
error = ConvenienceUser.sole
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{ConvenienceUser} found"

# it: raises NotUnique when multiple records exist
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
error = ConvenienceUser.sole
assert error.is_a?(NotUnique)
assert error.as(NotUnique).message.includes?("Multiple #{ConvenienceUser} records found")

# it: works with query builder
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
user = ConvenienceUser.where(name: "John").sole.or_panic
assert user.email == "john@example.com"

# it: returns the single matching record
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
user = ConvenienceUser.find_sole_by(email: "john@example.com").or_panic
assert user.name == "John"

# it: raises NotFound when no matching record
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
error = ConvenienceUser.find_sole_by(email: "nonexistent@example.com")
assert error.is_a?(NotFound)

# it: raises NotUnique when multiple records match
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "John", email: "john2@example.com", age: 30).or_panic
error = ConvenienceUser.find_sole_by(name: "John")
assert error.is_a?(NotUnique)

# it: destroys all matching records
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
ConvenienceUser.create_strict(name: "John", email: "john2@example.com", age: 35).or_panic
count = ConvenienceUser.destroy_by(name: "John").or_panic
assert count == 2
remaining = ConvenienceUser.all.to_a.or_panic
assert remaining.size == 1
assert remaining.first.name == "Jane"

# it: returns 0 when no records match
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
count = ConvenienceUser.destroy_by(name: "Nonexistent").or_panic
assert count == 0

# it: works with query builder
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
ConvenienceUser.create_strict(name: "Jim", email: "jim@example.com", age: 35).or_panic
count = ConvenienceUser.where(age: 30..40).destroy_all.or_panic
assert count == 2
assert ConvenienceUser.count.or_panic == 1

# it: deletes all matching records
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
ConvenienceUser.create_strict(name: "John", email: "john2@example.com", age: 35).or_panic
rows_affected = ConvenienceUser.delete_by(name: "John").or_panic
assert rows_affected == 2
assert ConvenienceUser.count.or_panic == 1

# it: returns 0 when no records match
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
rows_affected = ConvenienceUser.delete_by(name: "Nonexistent").or_panic
assert rows_affected == 0

# it: updates updated_at timestamp
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
user1 = ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
user2 = ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
original_time = Time.utc(2000, 1, 1)
user1.updated_at = original_time
user1.save_strict(skip_timestamps: true).or_panic
user2.updated_at = original_time
user2.save_strict(skip_timestamps: true).or_panic
rows_affected = ConvenienceUser.touch_all.or_panic
assert rows_affected == 2
user1 = ConvenienceUser.find_strict((user1.id || raise "missing id")).or_panic
user2 = ConvenienceUser.find_strict((user2.id || raise "missing id")).or_panic
assert (user1.updated_at || raise "missing timestamp") > original_time
assert (user2.updated_at || raise "missing timestamp") > original_time

# it: works with query builder
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
user2 = ConvenienceUser.create_strict(name: "Jane", email: "jane@example.com", age: 30).or_panic
original_time = Time.utc(2000, 1, 1)
user2.updated_at = original_time
user2.save_strict(skip_timestamps: true).or_panic
rows_affected = ConvenienceUser.where(name: "Jane").touch_all.or_panic
assert rows_affected == 1
user2 = ConvenienceUser.find_strict((user2.id || raise "missing id")).or_panic
assert (user2.updated_at || raise "missing timestamp") > original_time

# it: increments counter columns
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
user = ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
rows_affected = ConvenienceUser.update_counters((user.id || raise "missing id"), {:age => 5}).or_panic
assert rows_affected == 1
user = ConvenienceUser.find_strict((user.id || raise "missing id")).or_panic
assert user.age == 30

# it: decrements counter columns
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
user = ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
rows_affected = ConvenienceUser.update_counters((user.id || raise "missing id"), {:age => -3}).or_panic
assert rows_affected == 1
user = ConvenienceUser.find_strict((user.id || raise "missing id")).or_panic
assert user.age == 22

# it: updates multiple counters
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
user = ConvenienceUser.create_strict(name: "John", email: "john@example.com", age: 25).or_panic
rows_affected = ConvenienceUser.update_counters((user.id || raise "missing id"), {:age => 10}).or_panic
assert rows_affected == 1
user = ConvenienceUser.find_strict((user.id || raise "missing id")).or_panic
assert user.age == 35

# it: returns 0 for non-existent record
ConvenienceUser.clear
ConvenienceUser.exec("DELETE FROM convenience_users").or_panic
rows_affected = ConvenienceUser.update_counters(999999, {:age => 5}).or_panic
assert rows_affected == 0
ConvenienceUser.adapter.close.or_panic
