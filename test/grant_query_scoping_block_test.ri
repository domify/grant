module test/grant_query_scoping_block_test

import grant/base::{Base}
import grant/scoping
import grant/error::{ErrorBase}
import test/spec_helper::{register_spec_connections}

pub class ScopingBlockWidget < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table scoping_block_widgets
  column id : Int64, primary: true
  column name : String?
  column color : String?
end

pub class ScopingBlockGadget < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table scoping_block_gadgets
  column id : Int64, primary: true
  column color : String?
  column deleted : Bool = false
  default_scope { where(deleted: false) }
end

private def prepare_records : Nil
  ScopingBlockWidget.migrator.drop_and_create.or_panic
  ScopingBlockGadget.migrator.drop_and_create.or_panic
  ScopingBlockWidget.create(name: "a", color: "red")
  ScopingBlockWidget.create(name: "b", color: "red")
  ScopingBlockWidget.create(name: "c", color: "blue")
  ScopingBlockGadget.create(color: "red")
  ScopingBlockGadget.create(color: "red", deleted: true)
  nil
end

register_spec_connections

# it: makes the relation the current scope for class-level queries
prepare_records
ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  assert ScopingBlockWidget.count.or_panic == 2
  assert ScopingBlockWidget.all.map(&.name.to_s).or_panic.sorted == ["a", "b"]
  assert ScopingBlockWidget.where(name: "c").to_a.or_panic.empty?
  assert ScopingBlockWidget.where(name: "a").first.or_panic.as(ScopingBlockWidget).color == "red"
end
assert ScopingBlockWidget.count.or_panic == 3

# it: is available on a relation
prepare_records
ScopingBlockWidget.where(color: "blue").scoping do
  assert ScopingBlockWidget.count.or_panic == 1
  assert ScopingBlockWidget.first.or_panic.as(ScopingBlockWidget).name == "c"
end

# it: returns the block's value
prepare_records
value = ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) { ScopingBlockWidget.count.or_panic }
assert value == 2

# it: nests and restores each level
prepare_records
ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  ScopingBlockWidget.scoping(ScopingBlockWidget.unscoped.where(color: "blue")) do
    assert ScopingBlockWidget.count.or_panic == 1
  end
  assert ScopingBlockWidget.count.or_panic == 2
end
assert ScopingBlockWidget.count.or_panic == 3

# it: restores the previous scope when the block raises
prepare_records
error = ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  assert ScopingBlockWidget.count.or_panic == 2
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.message == "boom"
assert ScopingBlockWidget.count.or_panic == 3
assert ::Grant::Scoping.current_stacks.nil?

# it: is local to the fiber that opened the block
prepare_records
seen_in_other_fiber = Channel(Int64).new
ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  group do |tasks|
    tasks.spawn { seen_in_other_fiber.send(ScopingBlockWidget.count.or_panic).or_panic }
    assert seen_in_other_fiber.receive.or_panic == 3
    assert ScopingBlockWidget.count.or_panic == 2
  end
end

# it: is ignored by unscoped and does not touch other models
prepare_records
ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  assert ScopingBlockWidget.unscoped.count.or_panic == 3
  assert ScopingBlockGadget.count.or_panic == 1
end

# it: is hidden inside the block form of unscoped, as ActiveRecord's
prepare_records
ScopingBlockWidget.scoping(ScopingBlockWidget.where(color: "red")) do
  assert ScopingBlockWidget.unscoped { |_| ScopingBlockWidget.count.or_panic } == 3
  ScopingBlockWidget.unscoped do |_|
    ScopingBlockWidget.scoping(ScopingBlockWidget.unscoped.where(color: "blue")) do
      assert ScopingBlockWidget.count.or_panic == 1
    end
  end
  assert ScopingBlockWidget.count.or_panic == 2
end
assert ::Grant::Scoping.current_stacks.nil?

# it: keeps the default scope of a relation built from the model
prepare_records
ScopingBlockGadget.scoping(ScopingBlockGadget.where(color: "red")) do
  assert ScopingBlockGadget.count.or_panic == 1
end
ScopingBlockGadget.scoping(ScopingBlockGadget.unscoped.where(color: "red")) do
  assert ScopingBlockGadget.count.or_panic == 2
end
assert ScopingBlockGadget.count.or_panic == 1
