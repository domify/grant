module test/adapter_pg_db_test

import db/db/core::{TransactionState}
import grant/adapter/pg_connection::{Connection}
import grant/adapter/driver::{Value}
import grant/errors::{DatabaseError}
import test/spec_helper::{CURRENT_ADAPTER, ADAPTER_URL}

if CURRENT_ADAPTER == "pg"
  conn = Connection.open(ADAPTER_URL).or_panic
  assert conn.execute("SELECT 1").or_panic.last_insert_id == -1_i64
  assert conn.native_connection.transaction_state == TransactionState::Idle
  conn.execute("/* raw */ BEGIN").or_panic
  assert conn.in_transaction?
  conn.execute("SAVEPOINT nested").or_panic
  assert conn.execute("SELECT 1 / 0").is_a?(DatabaseError)
  assert conn.in_transaction?
  assert conn.native_connection.transaction_state == TransactionState::FailedTransaction
  conn.execute("ROLLBACK TO nested").or_panic
  assert conn.native_connection.transaction_state == TransactionState::InTransaction
  conn.execute("COMMIT").or_panic
  assert !conn.in_transaction?
  assert conn.execute("SELECT 1 / 0").is_a?(DatabaseError)
  assert !conn.in_transaction?
  assert conn.scalar("SELECT ?::integer", [17_i64] of Value).or_panic == 17_i64
  assert conn.scalar("SELECT $1::integer", [23_i64] of Value).or_panic == 23_i64
  assert conn.scalar("SELECT 1.50::numeric").or_panic == 1.5_f64
  assert conn.scalar("SELECT 17::numeric").or_panic == 17_i64
  assert conn.scalar("SELECT decode('410042', 'hex')").or_panic.to_s == "Bytes[65, 0, 66]"
  assert conn.scalar("SELECT TIMESTAMP '2026-10-16 12:34:56.123456'").or_panic == "2026-10-16T12:34:56.123456Z"
  assert conn.scalar("SELECT TIMESTAMP '2026-10-16 12:34:56'").or_panic == "2026-10-16T12:34:56Z"
  assert conn.scalar("SELECT TIMESTAMP '2026-10-16 12:34:56.1'").or_panic == "2026-10-16T12:34:56.1Z"
  assert conn.execute("SELECT 1; SELECT 2").is_a?(DatabaseError)
  # Draining an unread result must retain errors and leave the next query usable.
  error = conn.query("SELECT $1::integer / 0", [1_i64] of Value) { |rs| 7 }
  assert error.is_a?(DatabaseError)
  assert error.as(DatabaseError).sql == "SELECT $1::integer / 0"
  assert error.as(DatabaseError).binds == ["[FILTERED]"]
  assert !conn.in_transaction?
  conn.query("SELECT generate_series(1, 3)") do |rs|
    rs.each { rs.read.or_panic; rs.close }.or_panic
    9
  end.or_panic
  assert conn.scalar("SELECT 2").or_panic == 2_i64
  conn.close.or_panic
  assert conn.native_connection.closed?
  assert !conn.in_transaction?
end
