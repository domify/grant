module test/grant_connection_w6_no_database_error_test

import grant/base::{Base}
import grant/adapter/base
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/connection_registry::{ConnectionRegistry}
import grant/error::{ErrorBase}
import grant/error_taxonomy::{NoDatabaseError, ConnectionFailed, ConnectionNotEstablished, ConnectionTimeoutError}
import grant/database::{ConnectionRefused}
import test/w6_c04_support::{W6C04}
import test/spec_helper::{register_spec_connections}
import std/time::{Span}

pub class W6NoDbThing < Base
  table w6_no_db_things
  column id : Int64, primary: true
  column label : String?
end

private def w6_missing_url : String
  W6C04.pg? ? W6C04.pg_url("grant_w6_c04_does_not_exist") : "sqlite3:/w6_c04_no_such_directory/missing.sqlite3"
end

private def w6_refused_url : String
  W6C04.pg? ? "postgres://localhost:1/w6_refused" : "postgres://localhost:1/w6_refused"
end

private def missing_adapter : ::Grant::Adapter::Base::Base
  W6C04.pg? ? Pg.new("w6_no_db", w6_missing_url) : Sqlite.new("w6_no_db", w6_missing_url)
end

private def cleanup : Nil
  ConnectionRegistry.remove_connection("w6_no_db", :writing).or_panic
  ConnectionRegistry.remove_connection("w6_refused", :writing).or_panic
  nil
end

register_spec_connections

# it: raises NoDatabaseError for a database that does not exist
adapter = missing_adapter
error = adapter.open("SELECT 1") { |db| db.scalar("SELECT 1") }
assert error.is_a?(NoDatabaseError)
assert !error.as(NoDatabaseError).cause.nil?
assert error.as(NoDatabaseError).message.includes?("w6_no_db")
cleanup

# it: raises NoDatabaseError through a model on a registered connection
if W6C04.pg?
  ConnectionRegistry.establish_connection(database: "w6_no_db", adapter: Pg, url: w6_missing_url, role: :writing, pool_size: 2, initial_pool_size: 0).or_panic
else
  ConnectionRegistry.establish_connection(database: "w6_no_db", adapter: Sqlite, url: w6_missing_url, role: :writing, pool_size: 2, initial_pool_size: 0).or_panic
end
error = W6NoDbThing.connected_to(database: "w6_no_db") { W6NoDbThing.count }
assert error.is_a?(NoDatabaseError)
cleanup

# it: reports a missing database from verify! and active?
adapter = missing_adapter
assert adapter.verify_strict.is_a?(NoDatabaseError)
assert !adapter.active?
cleanup

# it: raises ConnectionFailed for a server that refuses the connection
adapter = Pg.new("w6_refused", w6_refused_url)
error = adapter.open("SELECT 1") { |db| db.scalar("SELECT 1") }
assert error.is_a?(ConnectionFailed)
assert error.is_a?(ConnectionNotEstablished)
assert error.as(ConnectionFailed).cause.is_a?(ConnectionRefused)
assert adapter.verify_strict.is_a?(ConnectionFailed)
assert !adapter.active?
cleanup

# it: does not mistake a refused connection for a missing database
adapter = Pg.new("w6_refused", w6_refused_url)
error = adapter.open { |db| db.scalar("SELECT 1") }
assert error.is_a?(ConnectionFailed)
assert !error.is_a?(NoDatabaseError)
cleanup

# it: raises ConnectionTimeoutError when no pooled connection frees up in time
url = W6C04.provision("w6_no_db_pool", ["CREATE TABLE w6_no_db_things (#{W6C04.id_column}, label TEXT)"])
if W6C04.pg?
  ConnectionRegistry.establish_connection(database: "w6_no_db", adapter: Pg, url: url, role: :writing, pool_size: 1, initial_pool_size: 1, checkout_timeout: Span.milliseconds(100_i64), retry_attempts: 0).or_panic
else
  ConnectionRegistry.establish_connection(database: "w6_no_db", adapter: Sqlite, url: url, role: :writing, pool_size: 1, initial_pool_size: 1, checkout_timeout: Span.milliseconds(100_i64), retry_attempts: 0).or_panic
end
adapter = ConnectionRegistry.get_adapter("w6_no_db", :writing)
adapter.with_connection do |_held|
  other = Channel(Tuple(ErrorBase?)).new
  group do |tasks|
    tasks.spawn do
      result = adapter.open_pool_connection { |db| db.scalar("SELECT 1") }
      other.send({result.is_a?(ErrorBase) ? result : nil}).or_panic
    end
    assert other.receive.or_panic[0].is_a?(ConnectionTimeoutError)
  end
end.or_panic
cleanup
W6C04.cleanup
