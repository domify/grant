module test/grant_associations_has_many_test
import std/random::{Random}
import grant/base::{Base}
import grant/querying::{NotFound}
import test/spec_helper::{register_spec_connections}

pub class Teacher < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table teachers
  column id : Int64, primary: true
  column name : String?
  has_many :klasses, class_name: Klass
end
pub class Klass < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table klasses
  column id : Int64, primary: true
  column name : String?
  belongs_to teacher : Teacher
end
pub class CourierService < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table services
  column owner_id : Int64, primary: true, auto: false
  column name : String
  has_many :couriers, class_name: Courier, foreign_key: "service_id"
end
pub class Courier < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table couriers
  column courier_id : Int32, primary: true, auto: false
  column issuer_id : Int32
  belongs_to service : CourierService, primary_key: "owner_id"
end

register_spec_connections

# it: provides a method to retrieve associated objects
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

class1 = Klass.new
class1.name = "Test class 1"
class1.teacher = teacher
class1.save

class2 = Klass.new
class2.name = "Test class 2"
class2.teacher = teacher
class2.save

class3 = Klass.new
class3.name = "Test class 3"
class3.save

assert teacher.klasses.size.or_panic == 2

# it: #all
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

klass1 = Klass.new
klass1.name = "Test class X"
klass1.teacher = teacher
klass1.save

klass2 = Klass.new
klass2.name = "Test class X"
klass2.teacher = teacher
klass2.save

klass3 = Klass.new
klass3.name = "Test class with different name"
klass3.teacher = teacher
klass3.save

klasses = teacher.klasses.all("AND klasses.name = ? ORDER BY klasses.id DESC", ["Test class X"]).or_panic
assert klasses.map { |record| record.id } == [klass2.id, klass1.id]

# it: #find_by
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

klass1 = Klass.new
klass1.name = "Test class X"
klass1.teacher = teacher
klass1.save

klass2 = Klass.new
klass2.name = "Test class X"
klass2.teacher = teacher
klass2.save

klass3 = Klass.new
klass3.name = "Test class with different name"
klass3.teacher = teacher
klass3.save

klass = teacher.klasses.find_by(name: "Test class with different name").or_panic
if klass
  assert klass.id == klass3.id
  assert klass.name == "Test class with different name"
else
  assert !klass.nil?
end

# it: #find_by!
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

klass1 = Klass.new
klass1.name = "Test class X"
klass1.teacher = teacher
klass1.save

klass2 = Klass.new
klass2.name = "Test class X"
klass2.teacher = teacher
klass2.save

klass3 = Klass.new
klass3.name = "Test class with different name"
klass3.teacher = teacher
klass3.save

klass = teacher.klasses.find_by_strict(name: "Test class with different name").or_panic
assert klass.id == klass3.id
assert klass.name == "Test class with different name"

error = teacher.klasses.find_by_strict(name: "not_found")
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{Klass} found where name = not_found"

# it: #find
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

klass1 = Klass.new
klass1.name = "Test class X"
klass1.teacher = teacher
klass1.save

klass2 = Klass.new
klass2.name = "Test class X"
klass2.teacher = teacher
klass2.save

klass3 = Klass.new
klass3.name = "Test class with different name"
klass3.teacher = teacher
klass3.save

klass = teacher.klasses.find(klass1.id).or_panic
if klass
  assert klass.id == klass1.id
  assert klass.name == "Test class X"
else
  assert !klass.nil?
end

# it: #find!
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
teacher = Teacher.new
teacher.name = "test teacher"
teacher.save

klass1 = Klass.new
klass1.name = "Test class X"
klass1.teacher = teacher
klass1.save

klass2 = Klass.new
klass2.name = "Test class X"
klass2.teacher = teacher
klass2.save

klass3 = Klass.new
klass3.name = "Test class with different name"
klass3.teacher = teacher
klass3.save

klass = teacher.klasses.find_strict(klass1.id).or_panic
assert klass.id == klass1.id
assert klass.name == "Test class X"

id = klass3.id.as(Int64) + 42

error = teacher.klasses.find_strict(id)
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{Klass} found where id = #{id}"

# it: should respect the current primary key
Teacher.migrator.drop_and_create.or_panic
Klass.migrator.drop_and_create.or_panic
CourierService.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
service_id = (Random.new.rand(1_000_000_000) + 1).to_i64
courier_id = (service_id % 1_000_000).to_i32
courier1 = Courier.new
courier1.courier_id = courier_id
courier1.issuer_id = courier_id

courier2 = Courier.new
courier2.courier_id = courier_id + 1
courier2.issuer_id = courier_id + 1

courier3 = Courier.new
courier3.courier_id = courier_id + 2
courier3.issuer_id = courier_id + 2

service = CourierService.create_strict(name: "My service", owner_id: service_id).or_panic
[courier1, courier2, courier3].each do |courier|
  courier.service = service
  courier.save_strict.or_panic
end

couriers = service.couriers.to_a.or_panic.sorted_by { |record| record.courier_id.as(Int32) }

assert couriers.size == 3
assert couriers[0].courier_id == courier1.courier_id
assert couriers[0].issuer_id == courier1.issuer_id

assert couriers[1].courier_id == courier2.courier_id
assert couriers[1].issuer_id == courier2.issuer_id

assert couriers[2].courier_id == courier3.courier_id
assert couriers[2].issuer_id == courier3.issuer_id

Teacher.adapter.close.or_panic
