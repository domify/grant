module test/grant_callbacks_abort_test
import test/transaction_crud_models::{CallbackWithAbort}
import std/io::{Memory}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

register_spec_connections
CallbackWithAbort.migrator.drop_and_create.or_panic


# it: rolls back if abort at before_validation
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "before_validation", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_validation."]
assert cwa.history.to_s.strip == "after_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("before_validation").nil?

# it: rolls back if abort at after_validation
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "after_validation", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_validation."]
assert cwa.history.to_s.strip == "before_validation\nafter_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("after_validation").nil?

# it: doesn't run other callbacks if abort at before_save
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "before_save", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_save."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nafter_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("before_save").nil?

# it: only runs before_save if abort at before_create
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "before_create", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_create."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nafter_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("before_create").nil?

# it: rolls back if abort at after_create
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "after_create", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_create."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_create\nafter_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("after_create").nil?

# it: rolls back if abort at after_save
CallbackWithAbort.clear.or_panic
cwa = CallbackWithAbort.new(abort_at: "after_save", do_abort: true)
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_save."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_create\nafter_create\nafter_rollback"
assert !cwa.persisted?
assert cwa.new_record?
assert !cwa.changed?
assert CallbackWithAbort.find("after_save").nil?

# it: rolls back if abort at before_validation
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "before_validation", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("before_validation").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_validation."]
assert cwa.history.to_s.strip == "after_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("before_validation").or_panic.do_abort == false

# it: rolls back if abort at after_validation
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "after_validation", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("after_validation").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_validation."]
assert cwa.history.to_s.strip == "before_validation\nafter_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("after_validation").or_panic.do_abort == false

# it: doesn't run other callbacks if abort at before_save
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "before_save", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("before_save").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_save."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nafter_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("before_save").or_panic.do_abort == false

# it: only runs before_save if abort at before_update
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "before_update", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("before_update").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_update."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nafter_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("before_update").or_panic.do_abort == false

# it: rolls back if abort at after_update
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "after_update", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("after_update").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_update."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_update\nafter_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("after_update").or_panic.do_abort == false

# it: rolls back if abort at after_save
CallbackWithAbort.clear.or_panic
assert CallbackWithAbort.new(abort_at: "after_save", do_abort: false).save.or_panic
cwa = CallbackWithAbort.find_strict("after_save").or_panic
cwa.do_abort = true
cwa.history = Memory.new
assert !cwa.save.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_save."]
assert cwa.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_update\nafter_update\nafter_rollback"
assert cwa.persisted?
assert !cwa.new_record?
assert cwa.do_abort == true
assert cwa.changed?
assert CallbackWithAbort.find_strict("after_save").or_panic.do_abort == false

# it: doesn't run other callbacks if abort at before_destroy
CallbackWithAbort.clear.or_panic
CallbackWithAbort.new(abort_at: "before_destroy", do_abort: true).save.or_panic
cwa = CallbackWithAbort.find_strict("before_destroy").or_panic
cwa.history = Memory.new
cwa.destroy.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at before_destroy."]
assert cwa.history.to_s.strip == "after_rollback"
assert CallbackWithAbort.find("before_destroy").is_a?(CallbackWithAbort)

# it: runs before_destroy and destroy successfully if abort at after_destory
CallbackWithAbort.clear.or_panic
CallbackWithAbort.new(abort_at: "after_destroy", do_abort: true).save.or_panic
cwa = CallbackWithAbort.find_strict("after_destroy").or_panic
cwa.history = Memory.new
cwa.destroy.or_panic
assert cwa.errors.map(&.to_s) == ["Aborted at after_destroy."]
assert cwa.history.to_s.strip == "before_destroy\nafter_rollback"
assert CallbackWithAbort.find("after_destroy").nil?

# it: rolls back only the aborted save
CallbackWithAbort.clear.or_panic
kept = CallbackWithAbort.new(abort_at: "kept", do_abort: false)
aborted = CallbackWithAbort.new(abort_at: "after_save", do_abort: true)
aborted.history = Memory.new
CallbackWithAbort.transaction do
  assert kept.save.or_panic
  assert !aborted.save.or_panic
  assert aborted.history.to_s.strip == "before_validation\nafter_validation\nbefore_save\nbefore_create\nafter_create\nafter_rollback"
  assert !aborted.persisted?
  assert aborted.new_record?
  assert CallbackWithAbort.find("kept").is_a?(CallbackWithAbort)
  assert CallbackWithAbort.find("after_save").nil?
end
assert CallbackWithAbort.find("kept").is_a?(CallbackWithAbort)
assert CallbackWithAbort.find("after_save").nil?

CallbackWithAbort.adapter.close.or_panic
