module test/grant_validations_condition_arrays_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}
register_spec_connections

pub class V01Conditional < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v01_conditionals

  column id : Int64, primary: true
  column name : String?
  column plan : String?
  column active : Bool = true
  column admin : Bool = false
  column trial : Bool = false

  property log = [] of String

  def active? : Bool
    !!active
  end

  def admin? : Bool
    !!admin
  end

  def trial? : Bool
    !!trial
  end

  # Both terms must hold.
  validates_presence_of :name, if: [:active?, ->(r : V01Conditional) { r.plan == "pro" }]
  # Skipped when any unless: term holds.
  validates_length_of :name, minimum: 3, allow_nil: true, unless: [:admin?, ->(r : V01Conditional) { r.trial? }]
  # Combined if: and unless: lists.
  validates_inclusion_of :plan, in: %w[pro free], if: [:active?], unless: [:admin?]
  # validate :method with arrays
  validate :must_not_be_reserved, if: [:active?, ->(r : V01Conditional) { !r.name.nil? }], unless: [:admin?]

  before_validation :log_before, if: [:active?, ->(r : V01Conditional) { r.plan == "pro" }]
  after_validation :log_after, if: :active?, unless: [:admin?, ->(r : V01Conditional) { r.trial? }]
  before_save :log_save, if: [:active?], unless: [:trial?]

  private def must_not_be_reserved : Nil
    errors.add(:name, "is reserved") if name == "root"
    nil
  end

  private def log_before : Nil
    log << "before"
    nil
  end

  private def log_after : Nil
    log << "after"
    nil
  end

  private def log_save : Nil
    log << "save"
    nil
  end
end
V01Conditional.migrator.drop_and_create.or_panic

private def conditional(name : String? = "Ada", plan : String? = "pro", active : Bool = true, admin : Bool = false, trial : Bool = false) : V01Conditional
  record = V01Conditional.new
  record.name = name
  record.plan = plan
  record.active = active
  record.admin = admin
  record.trial = trial
  record
end

# it: validates when every term holds
record = conditional(name: nil)
assert !record.valid?.or_panic
assert record.errors.map(&.field.to_s).includes?("name")

# it: skips when the Symbol term is false
record = conditional(name: nil, active: false, plan: nil)
assert record.valid?.or_panic

# it: skips when the Proc term is false
record = conditional(name: nil, plan: "free")
record.errors.clear
assert record.valid?.or_panic

# it: validates when no term holds
assert !conditional(name: "Al").valid?.or_panic

# it: skips when the Symbol term holds
assert conditional(name: "Al", admin: true).valid?.or_panic

# it: skips when the Proc term holds
assert conditional(name: "Al", trial: true).valid?.or_panic

# it: requires every if: term and no unless: term
assert !conditional(plan: "gold").valid?.or_panic
assert conditional(plan: "gold", admin: true).valid?.or_panic
assert conditional(plan: "gold", active: false).valid?.or_panic

# it: runs when the conditions hold
record = conditional(name: "root")
assert !record.valid?.or_panic
assert record.errors.map(&.to_s).includes?("Name is reserved")

# it: is skipped by unless:
assert conditional(name: "root", admin: true).valid?.or_panic

# it: run only when every if: term holds and no unless: term does
record = conditional
record.valid?.or_panic
assert record.log == ["before", "after"]

record = conditional(plan: "free")
record.valid?.or_panic
assert record.log == ["after"]

record = conditional(admin: true)
record.valid?.or_panic
assert record.log == ["before"]

record = conditional(trial: true)
record.valid?.or_panic
assert record.log == ["before"]

# it: supports single-element arrays on save callbacks
record = conditional
assert record.save.or_panic
assert record.log.includes?("save")

record = conditional(trial: true)
assert record.save.or_panic
assert !record.log.includes?("save")
