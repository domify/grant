module test/grant_connection_with_connection_pool_test
import std/time::{Span}
import grant/adapter/base::{Base}
import test/pool_spec_support::{C02Support}
import test/spec_helper::{CURRENT_ADAPTER}
import grant/connection_registry::{ConnectionRegistry}
import grant/error::{ErrorBase}
import grant/error_taxonomy::{ConnectionTimeoutError}
import grant/adapter/pool_support::{ticks}

private def establish(pool_size : Int32 = 3, checkout_timeout : Span = Span.seconds(5_i64)) : Base
  adapter = C02Support.establish("c02_pin", :writing, pool_size: pool_size, initial_pool_size: 1, max_idle_pool_size: 3, checkout_timeout: checkout_timeout)
  adapter.open do |connection|
    connection.exec("DROP TABLE IF EXISTS c02_pinned_items").or_panic
    create_table = case CURRENT_ADAPTER
                   when "pg" then "CREATE TABLE c02_pinned_items (id BIGSERIAL PRIMARY KEY, name TEXT)"
                   else           "CREATE TABLE c02_pinned_items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
                   end
    connection.exec(create_table)
  end.or_panic
  adapter
end

private def cleanup
  ConnectionRegistry.get_adapter("c02_pin", :writing).open { |connection| connection.exec("DROP TABLE IF EXISTS c02_pinned_items") }.or_panic
  ConnectionRegistry.remove_connection("c02_pin", :writing).or_panic
end

# it: keeps every statement of the block on one connection, so session state survives
adapter = establish
adapter.with_connection do |raw|
  raw.exec("CREATE TEMPORARY TABLE c02_scratch (id INTEGER)").or_panic
  adapter.open { |connection| connection.exec("INSERT INTO c02_scratch VALUES (1)") }.or_panic
  adapter.open { |connection| connection.exec("INSERT INTO c02_scratch VALUES (2)") }.or_panic
  assert adapter.open { |connection| connection.scalar("SELECT COUNT(*) FROM c02_scratch") }.or_panic == 2
  assert adapter.open { |connection| connection.object_id == raw.object_id }.or_panic
  assert adapter.pool_stat.busy == 1
end.or_panic
cleanup

# it: releases the connection when the block ends, and when it raises
adapter = establish
adapter.with_connection { |connection| connection.scalar("SELECT 1") }.or_panic
assert adapter.pool_stat.busy == 0
assert adapter.pinned_connection?.nil?
error = adapter.with_connection { |_| ErrorBase.new("boom") }
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert adapter.pool_stat.busy == 0
assert adapter.pinned_connection?.nil?
cleanup

# it: reuses the pinned connection when nested
adapter = establish
adapter.with_connection do |outer|
  adapter.with_connection { |connection| assert connection.object_id == outer.object_id }.or_panic
  assert adapter.pool_stat.busy == 1
end.or_panic
cleanup

# it: pins only the calling fiber
adapter = establish
other_fiber_saw_pin = Channel(Bool).new
adapter.with_connection do |raw|
  group do |tasks|
    tasks.spawn do
      adapter.open { |connection| other_fiber_saw_pin.send(connection.object_id == raw.object_id) }.or_panic
    end
    assert !other_fiber_saw_pin.receive.or_panic
  end
end.or_panic
cleanup

# it: keeps a second fiber waiting on the checkout timeout while the pool is exhausted by pins
adapter = establish(pool_size: 1, checkout_timeout: Span.milliseconds(100_i64))
blocked = Channel(ErrorBase?).new
started = ticks
adapter.with_connection do |_|
  group do |tasks|
    tasks.spawn do
      result = adapter.open { |connection| connection.scalar("SELECT 1") }
      blocked.send(result.is_a?(ErrorBase) ? result : nil).or_panic
    end
    sleep(0).or_panic
    assert adapter.pool_stat.waiting == 1
    assert blocked.receive.is_a?(ConnectionTimeoutError)
    assert ticks - started >= 100
    assert adapter.pool_stat.waiting == 0
  end
end.or_panic
assert adapter.pool_stat.busy == 0
assert adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic == 1
cleanup
C02Support.cleanup
