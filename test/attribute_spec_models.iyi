module test/attribute_spec_models
import grant/base::{Base}
import grant/converters
pub enum Level
  Low
  High
end
pub class AttrPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table attr_posts
  column id : Int64, primary: true
  column title : String?
  column views : Int32?
  column published : Bool?
  column level : Level?, column_type: "TEXT", converter: ::Grant::Converters::Enum(::Test::AttributeSpecModels::Level, String)
  column author_id : Int64?
  timestamps
  alias_attribute :name, :title
end
