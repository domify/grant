module test/grant_tasks_seeds_test
import grant/seeds
import test/spec_helper
import grant/connections::{Connections}
import grant/errors::{ErrorBase}
SpecHelper.register_spec_connections
adapter = Connections[SpecHelper::CURRENT_ADAPTER]

def reset_seeds : Nil
  adapter = Connections[SpecHelper::CURRENT_ADAPTER]
  adapter.open { |db| db.exec("DROP TABLE IF EXISTS grant_seeds").or_panic; db.exec("DROP TABLE IF EXISTS m04_seed_items").or_panic; nil }.or_panic
  ::Grant::Seeds.clear_definitions_in_place
end
reset_seeds
# it: runs the block once and records the name
count = 0
assert ::Grant::Seeds.load_once("first", adapter) { count += 1 }.or_panic
assert !::Grant::Seeds.load_once("first", adapter) { count += 1 }.or_panic
assert !::Grant::Seeds.load_once("first", adapter) { count += 1 }.or_panic
assert count == 1
assert ::Grant::Seeds.applied?("first", adapter).or_panic
assert ::Grant::Seeds.applied(adapter).or_panic == ["first"]
reset_seeds
# it: keeps separate names independent
ran = [] of String
::Grant::Seeds.load_once("a", adapter) { ran << "a" }.or_panic
::Grant::Seeds.load_once("b", adapter) { ran << "b" }.or_panic
::Grant::Seeds.load_once("a", adapter) { ran << "a again" }.or_panic
assert ran == ["a", "b"]
assert ::Grant::Seeds.applied(adapter).or_panic.sorted == ["a", "b"]
reset_seeds
# it: commits the record and the block's writes together, so a failing block runs again
adapter.open { |db| db.exec("CREATE TABLE m04_seed_items (name VARCHAR(40))") }.or_panic
attempts = 0
error = ::Grant::Seeds.load_once("flaky", adapter) do
  adapter.open { |db| db.exec("INSERT INTO m04_seed_items (name) VALUES ('partial')") }.or_panic
  attempts += 1
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.message == "boom" if error.is_a?(ErrorBase)
assert !::Grant::Seeds.applied?("flaky", adapter).or_panic
assert adapter.open { |db| db.scalar("SELECT COUNT(*) FROM m04_seed_items") }.or_panic == 0
assert ::Grant::Seeds.load_once("flaky", adapter) {
  adapter.open { |db| db.exec("INSERT INTO m04_seed_items (name) VALUES ('whole')") }.or_panic
  attempts += 1
}.or_panic
assert attempts == 2
assert adapter.open { |db| db.scalar("SELECT COUNT(*) FROM m04_seed_items") }.or_panic == 1
reset_seeds
# it: can be reset with forget
count = 0
::Grant::Seeds.load_once("again", adapter) { count += 1 }.or_panic
::Grant::Seeds.forget("again", adapter).or_panic
::Grant::Seeds.load_once("again", adapter) { count += 1 }.or_panic
assert count == 2
reset_seeds
# it: reports whether any seed was applied without creating the table
assert !::Grant::Seeds.any_applied?(adapter).or_panic
assert !::Grant::Seeds.table_exists?(adapter).or_panic
::Grant::Seeds.load_once("x", adapter) { nil }.or_panic
assert ::Grant::Seeds.any_applied?(adapter).or_panic
reset_seeds
# it: runs the blocks registered for the seeds path, each step idempotent with load_once
log = [] of String
::Grant::Seeds.define("/project/db/seeds.cr") do
  ::Grant::Seeds.load_once("one", adapter) { log << "one" }.or_panic
  log << "always"
end
::Grant::Seeds.define("/project/db/other_seeds.cr") { log << "other file" }
assert ::Grant::Seeds.defined?("db/seeds.cr")
assert ::Grant::Seeds.run("db/seeds.cr").or_panic == 1
assert ::Grant::Seeds.run("db/seeds.cr").or_panic == 1
assert log == ["one", "always", "always"]
reset_seeds
# it: raises SeedFileMissing for an unknown file and SeedsNotCompiled for an existing one
error = ::Grant::Seeds.run("db/m04_no_seeds.cr")
assert error.is_a?(::Grant::Seeds::SeedFileMissing)
assert error.message.includes?("m04_no_seeds.cr") if error.is_a?(ErrorBase)
assert ::Grant::Seeds.run("test/grant_tasks_seeds_test.ri").is_a?(::Grant::Seeds::SeedsNotCompiled)
reset_seeds
