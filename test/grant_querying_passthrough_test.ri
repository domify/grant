module test/grant_querying_passthrough_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: calls query against the db driver
Parent.clear.or_panic
Parent.query("SELECT name FROM parents") do |rs|
  assert rs.column_name(0) == "name"
  rs.close
end.or_panic

# it: calls scalar against the db driver
Parent.clear.or_panic
Parent.scalar("SELECT count(*) FROM parents") do |total|
  assert total == 0
end.or_panic

Parent.adapter.close.or_panic
