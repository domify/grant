module test/grant_schema_type_mapping_test
import grant/base::{Base}
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/table_definition::{TableDefinition}
import grant/schema/column_info::{ColumnInfo, TypeFamily}
import grant/adapter/schema::{Dialect, TypeCatalog, InvalidDefinition, UnsupportedOperation}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}
import std/time::{Time}
import std/slice::{Bytes}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

pub class M02aTypedRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_typed_rows
  column id : Int64, primary: true
  column code : String?, limit: 20
  column note : String?
  column happened : Time?, precision: 3
  column ratio : Float64?
  column flag : Bool?
end
private def m02a_kinds(t : TableDefinition) : Nil | ErrorBase
  t.string(:s)!
  t.string(:s_limited, limit: 40)!
  t.text(:body)!
  t.integer(:i)!
  t.integer(:i_limited, limit: 2)!
  t.smallint(:sm)!
  t.tinyint(:ti)!
  t.bigint(:bi)!
  t.boolean(:flag)!
  t.float(:f)!
  t.double(:d)!
  t.decimal(:price, precision: 12, scale: 2)!
  t.datetime(:at)!
  t.datetime(:at3, precision: 3)!
  t.date(:on)!
  t.time(:of)!
  t.binary(:bytes)!
  t.json(:doc)!
  t.uuid(:ident)
end

# it: "maps every kind on #
    {
      Dialect::Pg => [
        "\"s\" VARCHAR", "\"s_limited\" VARCHAR(40)", "\"body\" TEXT", "\"i\" INTEGER", "\"i_limited\" SMALLINT",
        "\"sm\" SMALLINT", "\"ti\" SMALLINT", "\"bi\" BIGINT", "\"flag\" BOOLEAN", "\"f\" REAL", "\"d\" DOUBLE PRECISION",
        "\"price\" NUMERIC(12, 2)", "\"at\" TIMESTAMP(6)", "\"at3\" TIMESTAMP(3)", "\"on\" DATE", "\"of\" TIME(6)",
        "\"bytes\" BYTEA", "\"doc\" JSON", "\"ident\" UUID",
      ],
      Dialect::Mysql => [
        "`s` VARCHAR(255)", "`s_limited` VARCHAR(40)", "`body` TEXT", "`i` INT", "`i_limited` SMALLINT",
        "`sm` SMALLINT", "`ti` TINYINT", "`bi` BIGINT", "`flag` TINYINT(1)", "`f` FLOAT", "`d` DOUBLE",
        "`price` DECIMAL(12, 2)", "`at` DATETIME(6)", "`at3` DATETIME(3)", "`on` DATE", "`of` TIME(6)",
        "`bytes` BLOB", "`doc` JSON", "`ident` CHAR(36)",
      ],
      Dialect::Sqlite => [
        "\"s\" VARCHAR(255)", "\"s_limited\" VARCHAR(40)", "\"body\" TEXT", "\"i\" INTEGER", "\"i_limited\" SMALLINT",
        "\"sm\" SMALLINT", "\"ti\" TINYINT", "\"bi\" BIGINT", "\"flag\" BOOLEAN", "\"f\" FLOAT", "\"d\" REAL",
        "\"price\" NUMERIC(12, 2)", "\"at\" DATETIME", "\"at3\" DATETIME", "\"on\" DATE", "\"of\" TIME",
        "\"bytes\" BLOB", "\"doc\" JSON", "\"ident\" CHAR(36)",
      ],
    }.each do |dialect, columns|
  sql = RecordingStatements.new(dialect).create_table_statements(:m02a_kinds, id: false) { |t| m02a_kinds(t) }.or_panic.first
  columns.each { |column| assert sql.includes?(column) }
end

# Supplemental MySQL size-selection assertions from the adapter-only example.
sql = RecordingStatements.new(Dialect::Mysql).create_table_statements(:sized, id: false) do |t|
  t.text(:a, limit: 100)
  t.text(:b, limit: 70_000)
  t.text(:c, limit: 20_000_000)
  t.binary(:d, limit: 200)
  t.integer(:e, limit: 3)
end.or_panic.first
assert sql.includes?("`a` TINYTEXT")
assert sql.includes?("`b` MEDIUMTEXT")
assert sql.includes?("`c` LONGTEXT")
assert sql.includes?("`d` TINYBLOB")
assert sql.includes?("`e` MEDIUMINT")

# it: rejects jsonb outside PostgreSQL and scale without precision
assert RecordingStatements.new(Dialect::Mysql).create_table_statements(:a) { |t| t.jsonb(:doc) }.is_a?(UnsupportedOperation)
assert RecordingStatements.new(Dialect::Pg).create_table_statements(:a, id: false) { |t| t.jsonb(:doc) }.or_panic.first.includes?("\"doc\" JSONB")
assert RecordingStatements.new(Dialect::Pg).create_table_statements(:a) { |t| t.decimal(:x, scale: 2) }.is_a?(InvalidDefinition)

# it: maps Int8, Int16, Bytes, Date, JSON::Any and BigDecimal per dialect
pg = TypeCatalog::PG
assert pg["Int8"] == "SMALLINT"
assert pg["Bytes"] == "BYTEA"
assert pg["JSON::Any"] == "JSONB"
assert TypeCatalog::MYSQL["Int8"] == "TINYINT"
assert TypeCatalog::MYSQL["JSON::Any"] == "JSON"
assert TypeCatalog::SQLITE["Bytes"] == "BLOB"

# it: refines BigDecimal by precision and scale and Time by precision
refine = ->(dialect : Dialect, key : String, base : String) do
  TypeCatalog.refine(dialect, key, base, nil, key == "Time" ? 3 : 12, key == "Time" ? nil : 2)
end
assert refine.call(Dialect::Pg, "BigDecimal", "NUMERIC").or_panic == "NUMERIC(12, 2)"
assert refine.call(Dialect::Mysql, "BigDecimal", "DECIMAL").or_panic == "DECIMAL(12, 2)"
assert refine.call(Dialect::Pg, "Time", "TIMESTAMP").or_panic == "TIMESTAMP(3)"
assert refine.call(Dialect::Mysql, "Time", "TIMESTAMP(6)").or_panic == "TIMESTAMP(3)"
assert refine.call(Dialect::Sqlite, "Time", "TIMESTAMP").or_panic == "TIMESTAMP"
assert TypeCatalog.refine(Dialect::Pg, "String", "TEXT", 30).or_panic == "VARCHAR(30)"
assert TypeCatalog.refine(Dialect::Pg, "String", "TEXT").or_panic == "TEXT"

register_spec_connections
restore_default_spec_connections

# it: emits limit and precision in the create SQL
M02aTypedRow.migrator.drop_and_create.or_panic
sql = M02aTypedRow.migrator.create_sql
case CURRENT_ADAPTER
when "pg"
  assert sql.includes?("\"code\" VARCHAR(20)")
  assert sql.includes?("\"note\" TEXT")
  assert sql.includes?("\"happened\" TIMESTAMP(3)")
when "mysql"
  assert sql.includes?("`code` VARCHAR(20)")
  assert sql.includes?("`note` VARCHAR(255)")
  assert sql.includes?("`happened` TIMESTAMP(3)")
else
  assert sql.includes?("\"code\" VARCHAR(20)")
  assert sql.includes?("\"note\" VARCHAR(255)")
  assert sql.includes?("\"happened\" TIMESTAMP")
end

# it: round trips values through the created table
M02aTypedRow.migrator.drop_and_create.or_panic
row = M02aTypedRow.new
row.code = "abc"
row.note = "text"
row.happened = Time.utc(2020, 1, 2, 3, 4, 5, nanosecond: 123_000_000)
row.ratio = 1.5
row.flag = true
row.save_strict.or_panic
found = M02aTypedRow.find_strict(row.id).or_panic
assert found.code == "abc"
assert found.note == "text"
assert found.happened.as(Time).to_unix_ms == Time.utc(2020, 1, 2, 3, 4, 5, nanosecond: 123_000_000).to_unix_ms
assert found.ratio == 1.5
assert found.flag == true

statements = AdapterStatements.new(::Test::SchemaFixture.adapter)

# it: creates every kind, inserts and reads the values back
statements.drop_table(:m02a_kinds, if_exists: true).or_panic
statements.create_table(:m02a_kinds) do |t|
  t.tinyint(:ti)
  t.smallint(:sm)
  t.decimal(:price, precision: 12, scale: 2)
  t.binary(:bytes)
  t.date(:on)
  t.text(:body)
  t.string(:s_limited, limit: 5)
  t.datetime(:at)
  t.json(:doc)
end.or_panic
adapter = ::Test::SchemaFixture.adapter
adapter.open do |db|
  quote = CURRENT_ADAPTER == "mysql" ? "`" : "\""
  placeholder = CURRENT_ADAPTER == "pg" ? "$1" : "?"
  bytes = Bytes.new(3)
  bytes[0] = 1_u8
  bytes[1] = 2_u8
  bytes[2] = 255_u8
  db.exec("INSERT INTO m02a_kinds (ti, sm, price, bytes, #{quote}on#{quote}, body, s_limited, #{quote}at#{quote}, doc) VALUES (5, 300, 12345.67, #{placeholder}, '2020-01-02', 'long text', 'abcde', '2020-01-02 03:04:05', '{\"a\":1}')", [bytes.as(Value)]).or_panic
  db.query("SELECT ti, sm, price, bytes, body, s_limited FROM m02a_kinds") do |rs|
    assert rs.move_next.or_panic
    assert rs.read.or_panic.to_s == "5"
    assert rs.read.or_panic.to_s == "300"
    assert rs.read.or_panic.to_s == "12345.67"
    assert rs.read.or_panic.to_s == "Bytes[1, 2, 255]"
    assert rs.read.or_panic.to_s == "long text"
    assert rs.read.or_panic.to_s == "abcde"
  end.or_panic
end.or_panic
columns = {} of String => ColumnInfo
adapter.schema.columns(:m02a_kinds).or_panic.each { |column| columns[column.name] = column }
assert columns["price"].precision == 12
assert columns["price"].scale == 2
assert columns["s_limited"].limit == 5
assert columns["body"].type_family == TypeFamily::Text

# it: enforces a varchar limit where the database does
if CURRENT_ADAPTER != "sqlite"
  statements.drop_table(:m02a_kinds, if_exists: true).or_panic
  statements.create_table(:m02a_kinds) { |t| t.string(:s_limited, limit: 3) }.or_panic
  assert adapter.open { |db| db.exec("INSERT INTO m02a_kinds (s_limited) VALUES ('toolong')") }.is_a?(ErrorBase)
end
statements.drop_table(:m02a_kinds, if_exists: true).or_panic
M02aTypedRow.migrator.drop.or_panic
