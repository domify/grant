module test/grant_migrator_defaults_test
import grant/base
import test/spec_helper

pub class MigratorDefaultLiteralRow < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table migrator_default_literal_rows

  column id : Int64, primary: true
  column status : String = "it's ready"
  column retry_count : Int32 = 3
  column is_enabled : Bool = true
  column is_archived : Bool = false
  column optional_note : String? = nil
end

SpecHelper.register_spec_connections

# it: persists Crystal literal defaults for direct SQL inserts
MigratorDefaultLiteralRow.migrator.drop_and_create.or_panic
insert_sql = "INSERT INTO migrator_default_literal_rows DEFAULT VALUES"
MigratorDefaultLiteralRow.exec(insert_sql).or_panic
row = (MigratorDefaultLiteralRow.first.or_panic || raise "expected row")
assert row.status == "it's ready"
assert row.retry_count == 3
assert row.is_enabled == true
assert row.is_archived == false
assert row.optional_note.nil?

# it: emits escaped string and scalar defaults in the create SQL
MigratorDefaultLiteralRow.migrator.drop_and_create.or_panic
create_sql = MigratorDefaultLiteralRow.migrator.create_sql
assert create_sql.includes?("DEFAULT 'it''s ready'")
assert create_sql.includes?("DEFAULT 3")
assert create_sql.includes?("DEFAULT TRUE")
assert create_sql.includes?("DEFAULT FALSE")
assert create_sql.includes?("DEFAULT NULL")
