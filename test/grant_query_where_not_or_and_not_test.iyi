module test/grant_query_where_not_or_and_not_test

import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts
  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?
end

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map { |post| post.title.to_s }
end

private def reset : Nil
  WfPost.clear.or_panic
  WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  WfPost.create_strict(title: "d", published: true, score: nil).or_panic
  nil
end

register_spec_connections
WfPost.migrator.drop_and_create.or_panic

# it: negates several keys together (NAND)
reset
relation = WfPost.where.not(published: true, score: 1)
assert relation.to_sql.includes?("NOT (")
assert titles(relation) == ["b", "c"]

# it: negates one key
reset
assert titles(WfPost.where.not(published: false)) == ["a", "c", "d"]
assert titles(WfPost.where.not(title: "a")) == ["b", "c", "d"]

# it: turns an array into NOT IN
reset
assert titles(WfPost.where.not(title: ["a", "b"])) == ["c", "d"]
assert titles(WfPost.where.not(title: [] of String)) == ["a", "b", "c", "d"]

# it: turns nil into IS NOT NULL
reset
assert titles(WfPost.where.not(score: nil)) == ["a", "b", "c"]

# it: negates a range, open ranges included
reset
assert titles(WfPost.where.not(score: 2..3)) == ["a"]
assert titles(WfPost.where.not(score: 2...3)) == ["a", "c"]
assert titles(WfPost.where.not(score: ..1)) == ["b", "c"]
assert titles(WfPost.where.not(score: 3..)) == ["a", "b"]

# it: treats a NULL column as unmatched on both sides, like SQL
reset
assert titles(WfPost.where(score: 1..3)) == ["a", "b", "c"]
assert titles(WfPost.where.not(score: 1..3)) == [] of String

# it: keeps the scalar two-argument form
reset
assert titles(WfPost.where.not(:title, "a")) == ["b", "c", "d"]

# it: combines with other conditions and binds in order
reset
relation = WfPost.where(published: true).where.not(title: ["a", "b"], score: 3).where(title: "c")
assert titles(relation) == ["c"]
relation = WfPost.where(published: true).where.not(title: ["a"], score: 1).where(score: 1..3)
assert titles(relation) == ["c"]
relation = WfPost.where(published: true).where.not(title: "d", score: 3).where(score: 1..3)
assert titles(relation) == ["a", "c"]

# it: rejects an unknown column
reset
assert WfPost.where.not(nonsense: 1).select.is_a?(ArgumentError)

# it: leaves the receiver untouched
reset
base = WfPost.where(published: true)
base.where.not(score: 1)
assert titles(base) == ["a", "c", "d"]

WfPost.adapter.close.or_panic
