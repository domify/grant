module test/grant_spec_support_transactional_wrapper_test

import grant/spec
import grant/spec_support/transactional::{within_transaction}
import grant/connections::{Connections}
import grant/connection_registry::{ConnectionRegistry}
import grant/adapter/base::{Base}
import grant/transaction::{TransactionState}
import grant/errors::{ErrorBase, Rollback}
import test/transaction_crud_models::{Parent}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
import std/time::{Time}

private def registered_writers : Array(Base)
  writers = [] of Base
  Connections.registered_connections.each do |pair|
    writer = pair[:writer]
    writers << writer unless writers.any? { |other| other.object_id == writer.object_id }
  end
  writers
end

register_spec_connections
restore_default_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: rolls back rows created inside the wrapper
Parent.clear.or_panic
within_transaction do
  Parent.create_strict(name: "gone").or_panic
  assert Parent.count.or_panic == 1
end.or_panic
assert Parent.count.or_panic == 0

# it: rolls back even when the body raises
Parent.clear.or_panic
error = within_transaction do
  Parent.create_strict(name: "gone").or_panic
  ErrorBase.new("example failed")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "example failed"
assert Parent.count.or_panic == 0
assert !::Grant::Transaction.in_explicit_transaction?

# it: opens a non-joinable transaction on every registered connection
Parent.clear.or_panic
writers = registered_writers
assert writers.size >= 2
within_transaction do
  assert TransactionState.fiber_stack.size == writers.size
  assert TransactionState.fiber_stack.all? { |state| !state.options.joinable }
  writers.each { |writer| assert !::Grant::Transaction.current_connection?(writer).nil? }
end.or_panic
assert !::Grant::Transaction.in_explicit_transaction?

# it: turns a nested transaction block into a savepoint so its Rollback undoes only its work
Parent.clear.or_panic
within_transaction do
  Parent.create_strict(name: "outer").or_panic
  Parent.transaction do
    Parent.create_strict(name: "inner").or_panic
    Rollback.new
  end.or_panic
  assert Parent.pluck(:name).or_panic.map(&.first) == ["outer"]
end.or_panic

# it: "runs after_commit when a save's savepoint is released, as ActiveRecord test transactions
Parent.clear.or_panic
log = [] of String
within_transaction do
  Parent.transaction do
    Parent.current_transaction.after_commit { log << "commit"; nil }
    Parent.current_transaction.after_rollback { log << "rollback"; nil }
    Parent.create_strict(name: "committed").or_panic
  end.or_panic
  assert log == ["commit"]
end.or_panic
assert log == ["commit"]

# it: runs after_rollback, not after_commit, for a savepoint that rolls back
Parent.clear.or_panic
log = [] of String
within_transaction do
  Parent.transaction do
    Parent.current_transaction.after_commit { log << "commit"; nil }
    Parent.current_transaction.after_rollback { log << "rollback"; nil }
    Rollback.new
  end.or_panic
end.or_panic
assert log == ["rollback"]

# it: runs after_commit when a manual savepoint under the wrapper commits
Parent.clear.or_panic
log = [] of String
within_transaction(only: [Parent.adapter.name]) do
  handle = Parent.connection.begin_transaction.or_panic
  Parent.current_transaction.after_commit { log << "commit"; nil }
  handle.commit.or_panic
  assert log == ["commit"]
end.or_panic

# it: rolls back writes made through every registered connection
Parent.clear.or_panic
replica_writer = ConnectionRegistry.get_adapter("#{CURRENT_ADAPTER}_with_replica", :writing)
writers = [Parent.adapter, replica_writer]
insert = "INSERT INTO parents (name, created_at, updated_at) VALUES ('via_adapter', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
within_transaction do
  replica_writer.open { |db| db.exec(insert) }.or_panic
end.or_panic
writers.each do |writer|
  count = writer.open { |db| db.scalar("SELECT COUNT(*) FROM parents") }.or_panic.to_s.to_i64
  assert count == 0
end

# it: limits the wrapper to the named connections
Parent.clear.or_panic
name = Parent.adapter.name
within_transaction(only: [name]) do
  assert TransactionState.fiber_stack.map { |state| state.adapter.name } == [name]
end.or_panic

# it: wraps every example when installed with .transactional
Parent.clear.or_panic
assert ::Grant::Spec.responds_to?(:transactional)
# Native scripts supply their example boundary explicitly to the installed hook.
::Grant::Spec.transactional(only: [Parent.adapter.name])
::Grant::Spec.run_example do
  Parent.create_strict(name: "installed").or_panic
  assert Parent.count.or_panic == 1
end.or_panic
assert Parent.count.or_panic == 0

# it: is cheaper than deleting from the tables afterwards
Parent.clear.or_panic
rounds = 30
started = Time.monotonic
rounds.times do
  Parent.create_strict(name: "x").or_panic
  Parent.clear.or_panic
end
delete_time = Time.monotonic - started
started = Time.monotonic
rounds.times do
  within_transaction { Parent.create_strict(name: "x").or_panic }.or_panic
end
rollback_time = Time.monotonic - started
assert rollback_time.total_nanoseconds < delete_time.total_nanoseconds * 4
