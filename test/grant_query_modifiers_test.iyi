module test/grant_query_modifiers_test
import test/query_spec_helper::{builder, with_legacy_implicit_order, same_entries?}
import grant/query/builder::{Builder}

with_legacy_implicit_order do

  # it: clears existing order and replaces
  query = builder.order(name: :asc).reorder(age: :desc)
  assert query.order_fields.size == 1
  assert query.order_fields.first[:field] == "age"
  assert query.order_fields.first[:direction] == Builder::Sort::Descending

  # it: clears multiple existing orders
  query = builder.order(name: :asc).order(age: :desc).reorder(name: :desc)
  assert query.order_fields.size == 1
  assert query.order_fields.first[:field] == "name"
  assert query.order_fields.first[:direction] == Builder::Sort::Descending

  # it: accepts a single symbol field
  query = builder.order(name: :desc).reorder(:age)
  assert query.order_fields.size == 1
  assert query.order_fields.first[:field] == "age"
  assert query.order_fields.first[:direction] == Builder::Sort::Ascending

  # it: flips ascending to descending
  query = builder.order(name: :asc).reverse_order
  assert query.order_fields.first[:direction] == Builder::Sort::Descending

  # it: flips descending to ascending
  query = builder.order(name: :desc).reverse_order
  assert query.order_fields.first[:direction] == Builder::Sort::Ascending

  # it: flips all order directions
  query = builder.order(name: :asc).order(age: :desc).reverse_order
  assert query.order_fields[0][:direction] == Builder::Sort::Descending
  assert query.order_fields[1][:direction] == Builder::Sort::Ascending

  # it: reverses the primary key order when no orders set
  query = builder.reverse_order
  assert same_entries?(query.order_fields, [{field: "id", direction: Builder::Sort::Descending}])

  # it: clears existing where conditions and replaces
  query = builder.where(name: "bob").rewhere(name: "alice")
  assert query.where_fields.size == 1
  field = query.where_fields.first
  assert field.to_s == {join: :and, field: "name", operator: :eq, value: "alice"}.to_s

  # it: keeps conditions on other columns
  query = builder.where(name: "bob").where(age: 25).rewhere(name: "alice")
  assert query.where_fields.size == 2
  assert query.where_fields.any? { |entry| entry.to_s == {join: :and, field: "age", operator: :eq, value: 25}.to_s }
  assert query.where_fields.any? { |entry| entry.to_s == {join: :and, field: "name", operator: :eq, value: "alice"}.to_s }

  # it: clears existing select columns and replaces
  query = builder.select(:id, :name).reselect(:id, :email)
  assert query.select_columns == ["id", "email"]

  # it: clears existing group and replaces with single field
  query = builder.group_by(:status).regroup(:department)
  assert query.group_fields.size == 1
  assert query.group_fields.first[:field] == "department"

  # it: accepts multiple fields
  query = builder.group_by(:status).regroup(:department, :role)
  assert query.group_fields.size == 2
  assert query.group_fields[0][:field] == "department"
  assert query.group_fields[1][:field] == "role"

  # it: sets the is_none flag
  query = builder.none
  assert query.is_none?

  # it: defaults to not none
  query = builder
  assert !query.is_none?

  # it: none chains safely with where and order
  query = builder.none.where(name: "bob").order(name: :asc)
  assert query.is_none?
  assert query.where_fields.size == 1
  assert query.order_fields.size == 1

  # it: copies none flag on dup
  original = builder.none
  copy = original.dup
  assert copy.is_none?

  # it: non-none is preserved on dup
  original = builder
  copy = original.dup
  assert !copy.is_none?

  # it: merges none flag from other builder
  b1 = builder
  b2 = builder.none
  b1 = b1.merge(b2)
  assert b1.is_none?
end
