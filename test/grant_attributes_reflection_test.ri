module test/grant_attributes_reflection_test
import test/attribute_spec_models::{AttrPost, Level}
import grant/converters

# it: describes columns as a constant array
columns = AttrPost.columns
assert columns.map(&.name) == AttrPost.attribute_names
assert columns.object_id == AttrPost.columns.object_id
id = AttrPost.columns_hash["id"]
assert id.crystal_type == "Int64"
assert id.primary?
assert !id.nilable?
title = AttrPost.columns_hash["title"]
assert title.crystal_type == "String"
assert title.nilable?
assert title.converter.nil?
assert AttrPost.columns_hash["level"].converter == "#{Grant::Converters::Enum(Level, String)}"

# it: maps attributes to type names
assert AttrPost.type_for_attribute("views") == "Int32"
assert AttrPost.type_for_attribute(:created_at) == "Time"
assert AttrPost.type_for_attribute("name") == "String"
assert AttrPost.type_for_attribute("nope").nil?
assert AttrPost.attribute_types["published"] == "Bool"
assert AttrPost.attribute_types.size == AttrPost.columns.size

# it: reports the primary key and content columns
assert AttrPost.primary_key == "id"
assert AttrPost.content_columns.map(&.name) == ["title", "views", "published", "level",
                                            "created_at", "updated_at"]

# it: accepts reset_column_information as a no-op
AttrPost.reset_column_information
assert AttrPost.columns.size == 8
