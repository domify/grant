module test/where_family_models

import grant/base::{Base}
pub import grant/polymorphic
import std/time::{Time}

pub class ::WfAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_authors

  column id : Int64, primary: true
  column name : String?
  column active : Bool?

  has_many :posts, class_name: ::WfPost, foreign_key: author_id
end

pub class ::WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts

  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?

  belongs_to author : ::WfAuthor, foreign_key: author_id : Int64?, optional: true
  has_many :comments, as: :commentable, class_name: ::WfComment
  has_many :taggings, class_name: ::WfTagging, foreign_key: post_id
  has_many :tags, class_name: ::WfTag, through: :taggings, source: :tag
end

pub class ::WfComment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_comments

  column id : Int64, primary: true
  column body : String?

  belongs_to :commentable, polymorphic: true, optional: true
end

pub class ::WfTag < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_tags

  column id : Int64, primary: true
  column label : String?
end

pub class ::WfTagging < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_taggings

  column id : Int64, primary: true

  belongs_to post : ::WfPost, foreign_key: post_id : Int64?, optional: true
  belongs_to tag : ::WfTag, foreign_key: tag_id : Int64?, optional: true
end

# A second commentable, to prove the polymorphic type column is matched.
pub class ::WfVideo < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_videos

  column id : Int64, primary: true
  column title : String?

  has_many :comments, as: :commentable, class_name: ::WfComment
end

pub class ::WfMeasure < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_measures

  column id : Int64, primary: true
  column label : String?
  column rank : Int32?
  column amount : Float64?
  column happened_at : ::Std::Time::Time?
end


pub def wf_create_tables : Nil
  ::WfAuthor.migrator.drop_and_create.or_panic
  ::WfPost.migrator.drop_and_create.or_panic
  ::WfComment.migrator.drop_and_create.or_panic
  ::WfTag.migrator.drop_and_create.or_panic
  ::WfTagging.migrator.drop_and_create.or_panic
  ::WfVideo.migrator.drop_and_create.or_panic
  ::WfMeasure.migrator.drop_and_create.or_panic
  nil
end

pub def wf_clear_tables : Nil
  ::WfTagging.clear.or_panic
  ::WfComment.clear.or_panic
  ::WfPost.clear.or_panic
  ::WfTag.clear.or_panic
  ::WfVideo.clear.or_panic
  ::WfAuthor.clear.or_panic
  ::WfMeasure.clear.or_panic
  nil
end
