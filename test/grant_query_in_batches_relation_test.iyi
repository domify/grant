module test/grant_query_in_batches_relation_test
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/query/batches::{BatchOptionIgnoredError}
import grant/adapter/driver::{Value}
import std/enumerable
import std/iterator
import test/query_relation_sql_capture::{capture_sql}
import test/spec_helper::{register_spec_connections}

pub class InBatchesItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table in_batches_items
  column id : Int64, primary: true
  column label : String
  column archived : Bool = false
end

def seed_batch_items(count : Int32 = 7) : Array(InBatchesItem)
  InBatchesItem.migrator.drop_and_create.or_panic
  (1..count).map { |index| InBatchesItem.create_strict(label: "item#{index}").or_panic }
end

register_spec_connections

# it: yields a relation whose update_all and delete_all run in SQL
items = seed_batch_items
ids = items.map(&.id.as(Int64))
yielded = [] of InBatchesItem.class | Builder(InBatchesItem).class
statements = capture_sql do
  InBatchesItem.all.in_batches(of: 3) do |batch|
    yielded << batch.class
    assert batch.update_all(archived: true).or_panic > 0
  end.or_panic
end
assert yielded.size == 3
assert InBatchesItem.where(archived: true).count.or_panic == 7
assert statements.count(&.starts_with?("SELECT")) == 3
statements.select(&.starts_with?("SELECT")).each { |sql| assert !sql.includes?("label") }
removed = 0_i64
InBatchesItem.where(:id, :lteq, ids[4]).in_batches(of: 2) { |batch| removed += batch.delete_all.or_panic }.or_panic
assert removed == 5
assert InBatchesItem.pluck(:id).or_panic.flat_map { |row| row } == ids.skip(5)

# it: plucks only the keys per batch and does not load records
seed_batch_items
statements = capture_sql do
  InBatchesItem.all.in_batches(of: 4) { |_batch| }.or_panic
end
assert statements.size == 2
statements.each { |sql| assert !sql.includes?("OFFSET") }
statements.each { |sql| assert !sql.includes?("label") }

# it: supports pluck, count and enumeration on the batch relation
items = seed_batch_items
ids = items.map(&.id.as(Int64))
plucked = [] of Array(Int64)
InBatchesItem.all.in_batches(of: 3) do |batch|
  assert batch.to_a.or_panic.size <= 3
  plucked << batch.pluck(:id).or_panic.map { |row| row.first.as(Int64) }
end.or_panic
assert plucked.flat_map { |batch| batch } == ids
counts = [] of Int64
InBatchesItem.all.in_batches(of: 3) do |batch|
  assert batch.count.or_panic == batch.size.or_panic
  counts << batch.size.or_panic
end.or_panic
assert counts == [3_i64, 3_i64, 1_i64]
assert InBatchesItem.order(:id).count.or_panic == 7
firsts = [] of String
InBatchesItem.all.in_batches(of: 3, order: :desc) { |batch| firsts << batch.first_strict.or_panic.label.as(String) }.or_panic
assert firsts.first == "item7"

# it: memoizes the records with load: true
seed_batch_items
labels = [] of String
statements = capture_sql do
  InBatchesItem.all.in_batches(of: 4, load: true) do |batch|
    assert batch.loaded?
    batch.each { |item| labels << item.label.as(String) }.or_panic
    assert batch.to_a.or_panic.size <= 4
  end.or_panic
end
assert labels.size == 7
assert statements.size == 2
statements.each { |sql| assert sql.starts_with?("SELECT") }

# it: returns a lazy iterator of batch relations
seed_batch_items
iterator = InBatchesItem.all.in_batches(of: 3).or_panic
statements = capture_sql do
  first = iterator.next.as(Builder(InBatchesItem))
  assert first.to_a.or_panic.size == 3
end
assert statements.size == 2
assert InBatchesItem.all.in_batches(of: 3).or_panic.map { |batch| batch.to_a.or_panic.size }.to_a == [3, 3, 1]

# it: applies start, finish, cursor and error_on_ignore like find_each
items = seed_batch_items
ids = items.map(&.id.as(Int64))
seen = [] of Int64
InBatchesItem.all.in_batches(of: 2, start: ids[1], finish: ids[5]) do |batch|
  batch.pluck(:id).or_panic.each { |row| seen << row.first.as(Int64) }
end.or_panic
assert seen == ids.skip(1).first(5)
error = InBatchesItem.order(:label).in_batches(cursor: [:id], error_on_ignore: true) { |_batch| }
assert error.is_a?(BatchOptionIgnoredError)

# it: keeps the source relation untouched and yields nothing for an empty or none relation
seed_batch_items
relation = InBatchesItem.where(archived: false)
before = relation.where_fields.size
relation.in_batches(of: 2) { |_batch| }.or_panic
assert relation.where_fields.size == before
called = false
InBatchesItem.where(label: "missing").in_batches { |_batch| called = true }.or_panic
InBatchesItem.none.in_batches { |_batch| called = true }.or_panic
assert !called
assert InBatchesItem.none.in_batches.or_panic.to_a.empty?
assert InBatchesItem.none.in_batches(load: true).or_panic.to_a.empty?

# it: delegates Model.in_batches
seed_batch_items
counts = [] of Int64
InBatchesItem.in_batches(of: 3) { |batch| counts << batch.to_a.or_panic.size.to_i64 }.or_panic
assert counts == [3_i64, 3_i64, 1_i64]

InBatchesItem.adapter.close.or_panic
