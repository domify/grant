module test/grant_enum_attributes_test

import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
import std/enum

pub class EnumArticle < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table enum_articles

  column id : Int64, primary: true
  column title : String

  pub enum Status
    Draft
    Published
    Archived
  end

  enum_attribute status : ::Test::GrantEnumAttributesTest::EnumArticle::Status = :draft, column_type: String
end

pub class OptionalEnumItem < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table optional_enum_items

  column id : Int64, primary: true
  column name : String

  pub enum Priority
    Low
    Medium
    High
  end

  enum_attribute priority : ::Test::GrantEnumAttributesTest::OptionalEnumItem::Priority?, column_type: String
end

pub class MultiEnumTask < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table multi_enum_tasks

  column id : Int64, primary: true
  column title : String

  pub enum Status
    Pending
    InProgress
    Completed
  end

  pub enum Priority
    Low
    Medium
    High
  end

  enum_attribute status : ::Test::GrantEnumAttributesTest::MultiEnumTask::Status, default: :pending
  enum_attribute priority : ::Test::GrantEnumAttributesTest::MultiEnumTask::Priority, default: :medium
end

pub class IntegerEnumUser < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table integer_enum_users

  column id : Int64, primary: true
  column name : String

  pub enum Role
    Guest  = 0
    Member = 1
    Admin  = 2
  end

  enum_attribute role : ::Test::GrantEnumAttributesTest::IntegerEnumUser::Role = :member, column_type: Int32
end

register_spec_connections
id_column = CURRENT_ADAPTER == "pg" ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY AUTOINCREMENT"

EnumArticle.exec("DROP TABLE IF EXISTS enum_articles").or_panic
EnumArticle.exec("CREATE TABLE enum_articles (id #{id_column}, title TEXT NOT NULL, status TEXT)").or_panic
OptionalEnumItem.exec("DROP TABLE IF EXISTS optional_enum_items").or_panic
OptionalEnumItem.exec("CREATE TABLE optional_enum_items (id #{id_column}, name TEXT NOT NULL, priority TEXT)").or_panic
MultiEnumTask.exec("DROP TABLE IF EXISTS multi_enum_tasks").or_panic
MultiEnumTask.exec("CREATE TABLE multi_enum_tasks (id #{id_column}, title TEXT NOT NULL, status TEXT, priority TEXT)").or_panic
IntegerEnumUser.exec("DROP TABLE IF EXISTS integer_enum_users").or_panic
IntegerEnumUser.exec("CREATE TABLE integer_enum_users (id #{id_column}, name TEXT NOT NULL, role INTEGER)").or_panic

# it: creates enum column with converter
article = EnumArticle.new(title: "Test Article")
assert article.status == EnumArticle::Status::Draft

# it: persists and retrieves enum values
article = EnumArticle.create_strict(title: "Test", status: :published).or_panic

loaded = EnumArticle.find_strict(article.id.as(Int64)).or_panic
assert loaded.status == EnumArticle::Status::Published

# it: handles nil enum values when allowed
item = OptionalEnumItem.create_strict(name: "Item").or_panic
assert item.priority.nil?

loaded = OptionalEnumItem.find_strict(item.id.as(Int64)).or_panic
assert loaded.priority.nil?

# it: generates predicate methods for each enum value
article = EnumArticle.new

assert article.draft?
assert !article.published?
assert !article.archived?

# it: predicate methods update with value changes
article = EnumArticle.new
article.status = EnumArticle::Status::Published

assert !article.draft?
assert article.published?

# it: generates bang methods to set enum values
article = EnumArticle.new(title: "Bang")

article.published_strict.or_panic
assert article.status == EnumArticle::Status::Published
assert article.published?

article.archived_strict.or_panic
assert article.status == EnumArticle::Status::Archived
assert article.archived?

EnumArticle.clear.or_panic
EnumArticle.create_strict(title: "Draft 1", status: :draft).or_panic
EnumArticle.create_strict(title: "Draft 2", status: :draft).or_panic
EnumArticle.create_strict(title: "Published 1", status: :published).or_panic
EnumArticle.create_strict(title: "Archived 1", status: :archived).or_panic

# it: generates scopes for each enum value
assert EnumArticle.draft.count.or_panic == 2
assert EnumArticle.published.count.or_panic == 1
assert EnumArticle.archived.count.or_panic == 1

# it: scopes can be chained
articles = EnumArticle.published.where(title: "Published 1")
assert articles.count.or_panic == 1
assert articles.first_strict.or_panic.title == "Published 1"

# it: provides access to all enum values
statuses = EnumArticle.statuses.values
assert statuses.includes?(EnumArticle::Status::Draft)
assert statuses.includes?(EnumArticle::Status::Published)
assert statuses.includes?(EnumArticle::Status::Archived)

# it: provides enum mapping
mapping = EnumArticle.status_mapping
assert mapping["draft"] == EnumArticle::Status::Draft
assert mapping["published"] == EnumArticle::Status::Published
assert mapping["archived"] == EnumArticle::Status::Archived

# it: sets default enum value
article = EnumArticle.new
assert article.status == EnumArticle::Status::Draft

# it: respects explicitly set values over defaults
article = EnumArticle.new
assert article.status == EnumArticle::Status::Draft
article.status = EnumArticle::Status::Published
assert article.status == EnumArticle::Status::Published

# it: doesn't override existing record values
article = EnumArticle.new(title: "Test")
article.status = EnumArticle::Status::Published
article.save_strict.or_panic
loaded = EnumArticle.find_strict(article.id.as(Int64)).or_panic
assert loaded.status == EnumArticle::Status::Published

# it: supports multiple enum attributes
task = MultiEnumTask.new(title: "Task")

assert task.status == MultiEnumTask::Status::Pending
assert task.priority == MultiEnumTask::Priority::Medium

assert task.pending?
assert task.medium?

task.completed_strict.or_panic
task.high_strict.or_panic

assert task.status == MultiEnumTask::Status::Completed
assert task.priority == MultiEnumTask::Priority::High

# it: supports integer column storage
user = IntegerEnumUser.create_strict(name: "John", role: :admin).or_panic

# Verify it's stored as integer
placeholder = CURRENT_ADAPTER == "pg" ? "$1" : "?"
role_column = CURRENT_ADAPTER == "mysql" ? "`role`" : "\"role\""
raw_value = IntegerEnumUser.connection.select_value("SELECT #{role_column} FROM integer_enum_users WHERE id = #{placeholder}", [user.id] of ::Grant::Adapter::Driver::Value).or_panic
assert raw_value.to_s == "2" # Admin = 2

loaded = IntegerEnumUser.find_strict(user.id.as(Int64)).or_panic
assert loaded.role == IntegerEnumUser::Role::Admin
