module test/grant_query_existence_predicates_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}
import test/query_relation_sql_capture::{capture_sql, seed_parents}
import grant/querying::{NotFound, NotUnique}
import std/text

register_spec_connections
Parent.migrator.drop_and_create.or_panic


# it: answers false/true without loading anything
begin
  seed_parents(["a"])
  relation = Parent.where(name: "nope")

  assert relation.empty?.or_panic
  assert relation.none?.or_panic
  assert !relation.any?.or_panic
  assert !relation.many?.or_panic
  assert !relation.one?.or_panic
end


# it: answers one? but not many?
begin
  seed_parents(["a", "b"])
  relation = Parent.where(name: "a")

  assert !relation.empty?.or_panic
  assert !relation.none?.or_panic
  assert relation.any?.or_panic
  assert !relation.many?.or_panic
  assert relation.one?.or_panic
end


# it: answers many? but not one?
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  assert !relation.empty?.or_panic
  assert !relation.none?.or_panic
  assert relation.any?.or_panic
  assert relation.many?.or_panic
  assert !relation.one?.or_panic
end


# it: uses LIMIT 1 for empty?, any? and none?
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  [
  capture_sql { relation.empty?.or_panic },
  capture_sql { relation.any?.or_panic },
  capture_sql { relation.none?.or_panic },
  ].each do |statements|
    assert statements.size == 1
    assert statements.first.includes?("LIMIT 1")
    assert !statements.first.includes?("LIMIT 2")
    assert !statements.first.includes?("ORDER BY")
    assert !statements.first.includes?("created_at")
  end
end


# it: uses LIMIT 2 for many? and one?
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  [
  capture_sql { relation.many?.or_panic },
  capture_sql { relation.one?.or_panic },
  ].each do |statements|
    assert statements.size == 1
    assert statements.first.includes?("LIMIT 2")
    assert !statements.first.includes?("ORDER BY")
    assert !statements.first.includes?("created_at")
  end
end


# it: uses LIMIT 2 for sole and never loads more than two rows
begin
  seed_parents(["a", "b", "c"])

  statements = capture_sql do
    assert Parent.where("name != ?", "zzz").sole.is_a?(NotUnique)
  end

  assert statements.size == 1
  assert statements.first.includes?("LIMIT 2")
  assert Parent.where(name: "a").sole.or_panic.name == "a"
  assert Parent.where(name: "nope").sole.is_a?(NotFound)
end


# it: does not hydrate the full relation to answer emptiness
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  capture_sql { relation.empty?.or_panic; relation.many?.or_panic }.each do |sql|
    assert !sql.includes?("name, created_at")
  end
  assert !relation.loaded?
end


# it: respects an existing limit
begin
  seed_parents(["a", "b", "c"])

  assert !Parent.where("name != ?", "zzz").limit(1).many?.or_panic
  assert Parent.where("name != ?", "zzz").limit(1).one?.or_panic
  assert Parent.where("name != ?", "zzz").limit(2).many?.or_panic
end


# it: respects an existing offset
begin
  seed_parents(["a", "b", "c"])

  assert Parent.where("name != ?", "zzz").offset(2).one?.or_panic
  assert !Parent.where("name != ?", "zzz").offset(2).many?.or_panic
  assert Parent.where("name != ?", "zzz").offset(3).empty?.or_panic
  assert Parent.where("name != ?", "zzz").offset(1).many?.or_panic
end


# it: answer without SQL
begin
  seed_parents(["a", "b"])
  relation = Parent.where("name != ?", "zzz").none

  statements = capture_sql do
    assert relation.empty?.or_panic
    assert !relation.any?.or_panic
    assert relation.none?.or_panic
    assert !relation.many?.or_panic
    assert !relation.one?.or_panic
  end
  assert statements.empty?
end


# it: fall back to Enumerable
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  assert relation.any? { |parent| parent.name == "a" }.or_panic
  assert !relation.any? { |parent| parent.name == "q" }.or_panic
  assert relation.none? { |parent| parent.name == "q" }.or_panic
  assert relation.one? { |parent| parent.name == "a" }.or_panic
  assert !relation.one? { |parent| parent.name != "a" }.or_panic
  assert relation.many? { |parent| parent.name != "a" }.or_panic
  assert !relation.many? { |parent| parent.name == "a" }.or_panic
end


# it: stays unchanged and unloaded
begin
  seed_parents(["a", "b"])
  relation = Parent.where("name != ?", "zzz")
  sql = relation.to_sql

  relation.empty?.or_panic
  relation.any?.or_panic
  relation.many?.or_panic
  relation.one?.or_panic
  relation.none?.or_panic

  assert relation.to_sql == sql
  assert relation.limit.nil?
  assert !relation.loaded?
end

Parent.adapter.close.or_panic
