module test/grant_encryption_transparent_column_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/cipher::{Cipher}
import grant/encryption/key_provider::{KeyProvider}
import grant/error::{ArgumentError}
import std/base64::{Base64}
import std/time::{Time}
import std/json::{JSON, Any}
import test/spec_helper::{register_spec_connections}
pub class TransparentEncUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table transparent_enc_users

  column id : Int64, primary: true
  column name : String?

  encrypts email : String, deterministic: true
  encrypts balance : Int64
  encrypts seen_at : ::Std::Time::Time
  encrypts prefs : ::Std::Json::Any
  encrypts ratio : Float64
  encrypts active : Bool
  encrypts big_count : UInt64
  # The original storage form keeps working next to the new one.
  encrypts :legacy_note, deterministic: true
end


private def transparent_raw_column(user : TransparentEncUser, column : String) : String?
  TransparentEncUser.adapter.open do |db|
    db.scalar("SELECT #{column} FROM transparent_enc_users WHERE id = #{user.id}")
  end.or_panic.as(String?)
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "transparent-salt"
register_spec_connections
TransparentEncUser.migrator.drop_and_create.or_panic

# it: stores ciphertext in the column of the same name and reads it back typed
TransparentEncUser.clear.or_panic
when_seen = Time.utc(2026, 9, 29, 12, 30, 45, nanosecond: 123_456_789)
user = TransparentEncUser.create_strict(name: "Ada", email: "ada@example.com", balance: 1_234_567_890_123_i64, seen_at: when_seen, prefs: JSON.parse(%({"theme":"dark","n":[1,2]})), ratio: 2.5, active: true).or_panic

stored = TransparentEncUser.find_strict(user.id.as(Int64)).or_panic
assert stored.email == "ada@example.com"
assert stored.balance == 1_234_567_890_123_i64
assert stored.seen_at == when_seen
assert stored.prefs.as(Any)["theme"].as_s == "dark"
assert stored.ratio == 2.5
assert stored.active == true

{"email", "balance", "seen_at", "prefs", "ratio", "active"}.each do |column|
  raw = transparent_raw_column(user, column).as(String)
  assert raw != "ada@example.com"
  assert !raw.includes?("dark")
  assert Cipher.encrypted_payload?(Base64.decode(raw))
end
assert !transparent_raw_column(user, "email").as(String).includes?("ada")

# it: round-trips integers outside the Int64 range
TransparentEncUser.clear.or_panic
user = TransparentEncUser.create_strict(big_count: 18_446_744_073_709_551_615_u64).or_panic
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.big_count == 18_446_744_073_709_551_615_u64

# it: keeps nil as NULL
TransparentEncUser.clear.or_panic
user = TransparentEncUser.create_strict(name: "Nobody").or_panic
assert transparent_raw_column(user, "email").nil?
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.email.nil?

# it: rewrites where(email:) for deterministic attributes at builder time
TransparentEncUser.clear.or_panic
ada = TransparentEncUser.create_strict(email: "ada@example.com", balance: 1_i64).or_panic
TransparentEncUser.create_strict(email: "bob@example.com", balance: 2_i64).or_panic

assert TransparentEncUser.where(email: "ada@example.com").select.or_panic.map(&.id) == [ada.id]
assert TransparentEncUser.where(email: ["ada@example.com", "bob@example.com"]).count.or_panic == 2
assert TransparentEncUser.where(email: "nobody@example.com").count.or_panic == 0
assert TransparentEncUser.where(email: nil).count.or_panic == 0
assert TransparentEncUser.find_by_email("ada@example.com").or_panic.as(TransparentEncUser).id == ada.id
assert TransparentEncUser.where_email("bob@example.com").count.or_panic == 1
assert TransparentEncUser.find_by(email: "ada@example.com").or_panic.as(TransparentEncUser).id == ada.id

sql = TransparentEncUser.where(email: "ada@example.com").to_sql
assert sql.includes?("email")
assert !sql.includes?("ada@example.com")

# it: computes one ciphertext per lookup, not per row
TransparentEncUser.clear.or_panic
5.times { |i| TransparentEncUser.create_strict(email: "user#{i}@example.com").or_panic }
attribute = TransparentEncUser.email_encrypted_attribute
values = attribute.query_values("user1@example.com").or_panic
assert values.size == 1
assert attribute.query_value("user1@example.com").or_panic == values.first

# it: refuses to match non-deterministic encrypted attributes by value
TransparentEncUser.clear.or_panic
assert TransparentEncUser.where(balance: 5_i64).count.is_a?(ArgumentError)

# it: refuses range and LIKE comparisons on deterministic encrypted attributes
TransparentEncUser.clear.or_panic
error = TransparentEncUser.where(:email, :like, "%ada%").count
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("only equality")
error = TransparentEncUser.where(:email, :gt, "a").count
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("only equality")
assert TransparentEncUser.where(:email, :neq, "ada@example.com").count.or_panic == 0

# it: still reads and queries the <attr>_encrypted form
TransparentEncUser.clear.or_panic
user = TransparentEncUser.create_strict(legacy_note: "old style").or_panic
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.legacy_note.or_panic == "old style"
assert !transparent_raw_column(user, "legacy_note_encrypted").as(String).includes?("old style")
assert TransparentEncUser.find_by_legacy_note("old style").or_panic.as(TransparentEncUser).id == user.id
assert TransparentEncUser.where(legacy_note: "old style").count.or_panic == 1

# it: reads rows that an earlier <attr>_encrypted declaration wrote
TransparentEncUser.clear.or_panic
user = TransparentEncUser.create_strict(legacy_note: "kept").or_panic
assert ::Grant::Encryption.decrypt(transparent_raw_column(user, "legacy_note_encrypted"), TransparentEncUser.to_s, "legacy_note").or_panic == "kept"
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.legacy_note.or_panic == "kept"

# it: updates typed values
TransparentEncUser.clear.or_panic
user = TransparentEncUser.create_strict(email: "ada@example.com", balance: 1_i64).or_panic
user.balance = 99_i64
user.save_strict.or_panic
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.balance == 99_i64
assert TransparentEncUser.find_strict(user.id.as(Int64)).or_panic.email == "ada@example.com"

# it: masks the value in inspect
TransparentEncUser.clear.or_panic
user = TransparentEncUser.new(email: "ada@example.com", balance: 5_i64)
assert !user.inspect.includes?("ada@example.com")
assert user.inspect.includes?("email: [FILTERED]")

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
