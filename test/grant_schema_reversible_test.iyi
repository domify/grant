module test/grant_schema_reversible_test
import grant/schema/migration::{Migration, InvalidMigration}
import grant/schema/command_recorder::{CommandRecorder, IrreversibleMigration}
import grant/schema/schema_statements::{RecordingStatements}
import grant/schema/migration_context::{MigrationContext}
import grant/adapter/schema::{Dialect}
import grant/error::{ErrorBase}
import test/m03_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class M03ReversibleChange < Migration
  migration_version 20240301000001
  def change : Nil | ErrorBase | Cancelled
    create_table(:m03_users) { |t| t.string(:email) }!
    add_column(:m03_users, :age, :integer)!
    add_index(:m03_users, :email)!
    rename_column(:m03_users, :age, :years)
  end
end
pub class M03ExecuteInChange < Migration
  migration_version 20240301000002
  def change : Nil | ErrorBase | Cancelled
    create_table(:m03_posts) { |t| t.string(:title) }!
    execute("UPDATE m03_posts SET title = 'x'")
  end
end
pub class M03ReversibleBlock < Migration
  migration_version 20240301000003
  def change : Nil | ErrorBase | Cancelled
    create_table(:m03_tags) { |t| t.string(:label) }!
    reversible do |direction|
      direction.up { execute("INSERT INTO m03_tags (label) VALUES ('seed')") }
      direction.down { execute("DELETE FROM m03_tags") }
    end!
    up_only { execute("INSERT INTO m03_tags (label) VALUES ('second')") }
  end
end
pub class M03UpWithoutDown < Migration
  migration_version 20240301000004
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_comments) { |t| t.string(:body) }
  end
end
pub class M03RevertBlock < Migration
  migration_version 20240301000005
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_revert) { |t| t.string(:label) }!
    execute("CREATE TABLE m03_dry (label VARCHAR(10))")!
    revert { create_table(:m03_dry) { |t| t.string(:label) } }
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_revert)
  end
end
pub class M03NothingDefined < Migration
  migration_version 20240301000006
end
private def m03_sql_of(dialect : Dialect, migration : Migration, direction : Symbol) : Array(String)
  recording = RecordingStatements.new(dialect)
  migration.attach(recording, ::Test::M03Fixture.adapter)
  (direction == :up ? migration.up : migration.down).or_panic
  recording.statements
end
register_spec_connections
restore_default_spec_connections

# it: records the inverse of each call and replays them in reverse
::Test::M03Fixture.reset_in_place
up = m03_sql_of(Dialect::Pg, M03ReversibleChange.new, :up)
assert up.first.starts_with?("CREATE TABLE \"m03_users\"")
assert up.any? { |sql| sql.includes?("ADD COLUMN \"age\"") }
down = m03_sql_of(Dialect::Pg, M03ReversibleChange.new, :down)
assert down[0] == "ALTER TABLE \"m03_users\" RENAME COLUMN \"years\" TO \"age\""
assert down.any? { |sql| sql.starts_with?("DROP INDEX") && sql.includes?("index_m03_users_on_email") }
assert down.any? { |sql| sql.includes?("DROP COLUMN \"age\"") }
assert down.last == "DROP TABLE \"m03_users\""

# it: names the inverse of a recorded command
::Test::M03Fixture.reset_in_place
recorder = CommandRecorder.new
commands = recorder.capture do
  recorder.add_column(:m03_users, :age, :integer)
  recorder.add_index(:m03_users, :age, unique: true)
  recorder.create_table(:m03_a) { |t| t.string(:x) }
  recorder.rename_table(:m03_a, :m03_b)
  recorder.add_foreign_key(:m03_posts, :m03_users)
  recorder.add_reference(:m03_posts, :user)
  recorder.add_timestamps(:m03_posts)
  recorder.enable_extension(:hstore)
end.or_panic
assert commands.map { |command| command.name } == ["add_column", "add_index", "create_table", "rename_table", "add_foreign_key", "add_reference", "add_timestamps", "enable_extension"]
assert commands.map { |command| command.inverse_name } == ["remove_column", "remove_index", "drop_table", "rename_table", "remove_foreign_key", "remove_reference", "remove_timestamps", "disable_extension"]
assert commands.all? { |command| command.reversible? }
assert recorder.commands.empty?

# it: raises IrreversibleMigration before anything runs when a step has no inverse
::Test::M03Fixture.reset_in_place
recording = RecordingStatements.new(Dialect::Pg)
migration = M03ExecuteInChange.new
migration.attach(recording, ::Test::M03Fixture.adapter)
error = migration.down
assert error.is_a?(IrreversibleMigration)
assert error.as(IrreversibleMigration).message.to_s.includes?("execute")
assert recording.statements.empty?
[::Test::M03Fixture.adapter].each do |adapter|
  context = MigrationContext.for(adapter, M03ExecuteInChange, verbose: false)
  context.migrate.or_panic
  assert context.rollback.is_a?(IrreversibleMigration)
  assert ::Test::M03Fixture.table?("m03_posts")
  assert ::Test::M03Fixture.versions == [20240301000002_i64]
end

# it: gives reversible blocks a direction on each side
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03ReversibleBlock, verbose: false)
context.migrate.or_panic
assert ::Test::M03Fixture.adapter.open { |db| db.scalar("SELECT COUNT(*) FROM m03_tags") }.or_panic.as(Int64) == 2
context.rollback.or_panic
assert !::Test::M03Fixture.table?("m03_tags")

# it: treats up without down as irreversible
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03UpWithoutDown, verbose: false)
context.migrate.or_panic
error = context.rollback
assert error.is_a?(IrreversibleMigration)
assert error.as(IrreversibleMigration).message.to_s.includes?("no down")

# it: runs a revert block backwards inside up
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03RevertBlock, verbose: false)
context.migrate.or_panic
assert ::Test::M03Fixture.table?("m03_revert")
assert !::Test::M03Fixture.table?("m03_dry")

# it: rejects a migration that defines nothing
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03NothingDefined, verbose: false)
error = context.migrate
assert error.is_a?(InvalidMigration)
assert error.as(InvalidMigration).message.to_s.includes?("none of change")

# it: migrates and rolls back an automatic change on the real database
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03ReversibleChange, verbose: false)
context.migrate.or_panic
assert ::Test::M03Fixture.column?("m03_users", "years")
context.rollback.or_panic
assert !::Test::M03Fixture.table?("m03_users")
::Test::M03Fixture.reset_in_place
