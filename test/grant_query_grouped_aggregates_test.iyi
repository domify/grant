module test/grant_query_grouped_aggregates_test
import grant/base::{Base}
import grant/adapter/driver::{Value}
import test/spec_helper::{register_spec_connections}
import test/query_relation_sql_capture::{capture_sql}

pub class GrSale < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table gr_sales
  column id : Int64, primary: true
  column region : String
  column channel : String
  column cents : Int64
  column weight : Float64
  column shipped_on : String?
end

def prepare_records : Nil
  GrSale.clear.or_panic
  GrSale.create_strict(region: "east", channel: "web", cents: 100_i64, weight: 1.5, shipped_on: "2026-09-01").or_panic
  GrSale.create_strict(region: "east", channel: "shop", cents: 300_i64, weight: 2.5, shipped_on: nil).or_panic
  GrSale.create_strict(region: "west", channel: "web", cents: 50_i64, weight: 0.5, shipped_on: "2026-09-03").or_panic
  GrSale.create_strict(region: "west", channel: "web", cents: 70_i64, weight: 1.0, shipped_on: "2026-09-05").or_panic
  nil
end

# Exact hash comparison avoids iyi's equality bug for union-typed keys.
def equal_groups?(actual : Hash(K, V), expected : Hash(EK, EV)) : Bool forall K, V, EK, EV
  return false unless actual.size == expected.size
  equal = true
  expected.each { |key, value| equal = false unless actual.has_key?(key) && actual[key] == value }
  equal
end

register_spec_connections
GrSale.migrator.drop_and_create.or_panic


# it: sums per group
prepare_records
result = GrSale.group_records(:region).sum(:cents).or_panic
assert equal_groups?(result.as(Hash(Value, Value)), {"east" => 400_i64, "west" => 120_i64})
result.as(Hash(Value, Value)).values.each { |value| assert value.is_a?(Int64) }

# it: sums float columns per group as Float64
prepare_records
assert equal_groups?(GrSale.group_records(:region).sum(:weight).or_panic.as(Hash(Value, Value)), {"east" => 4.0, "west" => 1.5})

# it: averages per group
prepare_records
assert equal_groups?(GrSale.group_records(:region).avg(:cents).or_panic.as(Hash(Value, Value)), {"east" => 200.0, "west" => 60.0})
assert equal_groups?(GrSale.group_records(:region).average(:weight).or_panic.as(Hash(Value, Value)), {"east" => 2.0, "west" => 0.75})

# it: takes the minimum and maximum per group
prepare_records
assert equal_groups?(GrSale.group_records(:region).minimum(:cents).or_panic.as(Hash(Value, Value)), {"east" => 100_i64, "west" => 50_i64})
assert equal_groups?(GrSale.group_records(:region).maximum(:cents).or_panic.as(Hash(Value, Value)), {"east" => 300_i64, "west" => 70_i64})
assert equal_groups?(GrSale.group_records(:region).min(:shipped_on).or_panic.as(Hash(Value, Value)), {"east" => "2026-09-01", "west" => "2026-09-03"})

# it: keys a multi-column group by the array of values
prepare_records
assert equal_groups?(GrSale.group_records(:region, :channel).sum(:cents).or_panic.as(Hash(Array(Value), Value)), {(["east", "web"] of Value) => 100_i64, (["east", "shop"] of Value) => 300_i64, (["west", "web"] of Value) => 120_i64})

# it: groups by an expression
prepare_records
assert equal_groups?(GrSale.group_records("substr(shipped_on, 1, 7)").sum(:cents).or_panic.as(Hash(Value, Value)), {"2026-09" => 220_i64, nil => 300_i64})

# it: counts a column per group
prepare_records
assert equal_groups?(GrSale.group_records(:region).count(:shipped_on).or_panic.as(Hash(Value, Int64)), {"east" => 1_i64, "west" => 2_i64})
assert equal_groups?(GrSale.group_records(:region).count(:channel, distinct: true).or_panic.as(Hash(Value, Int64)), {"east" => 2_i64, "west" => 1_i64})

# it: runs one GROUP BY statement for the whole result
prepare_records
statements = capture_sql { GrSale.group_records(:region).sum(:cents).or_panic }
assert statements.size == 1
assert statements.first.includes?("SUM(")
assert statements.first.includes?("GROUP BY")
assert capture_sql { GrSale.group_records(:region, :channel).avg(:cents).or_panic }.size == 1
assert capture_sql { GrSale.group_records(:region).max(:cents).or_panic }.size == 1

# it: applies having to the groups
prepare_records
assert equal_groups?(GrSale.group_records(:region).having("SUM(cents) > ?", 200).sum(:cents).or_panic.as(Hash(Value, Value)), {"east" => 400_i64})

# it: applies where before grouping
prepare_records
assert equal_groups?(GrSale.where(channel: "web").group_records(:region).sum(:cents).or_panic.as(Hash(Value, Value)), {"east" => 100_i64, "west" => 120_i64})

# it: applies limit to the groups, in order
prepare_records
assert equal_groups?(GrSale.group_records(:region).order(:region).limit(1).sum(:cents).or_panic.as(Hash(Value, Value)), {"east" => 400_i64})

# it: returns an empty Hash for an empty or none relation
prepare_records
assert equal_groups?(GrSale.where(region: "north").group_records(:region).sum(:cents).or_panic.as(Hash(Value, Value)), {} of Value => Value)
assert GrSale.none.group_records(:region).sum(:cents).or_panic.as(Hash(Value, Value)).empty?
assert GrSale.none.group_records(:region).avg(:cents).or_panic.as(Hash(Value, Value)).empty?
assert GrSale.none.group_records(:region).max(:cents).or_panic.as(Hash(Value, Value)).empty?

# it: does not answer a grouped relation with a scalar
prepare_records
assert GrSale.group_records(:region).sum(:cents).or_panic.is_a?(Hash(Value, Value))
assert GrSale.group_records(:region).avg(:cents).or_panic.is_a?(Hash(Value, Value))
assert GrSale.group_records(:region).min(:cents).or_panic.is_a?(Hash(Value, Value))
assert GrSale.group_records(:region).max(:cents).or_panic.is_a?(Hash(Value, Value))

# it: leaves an ungrouped relation a scalar
prepare_records
assert GrSale.all.sum(:cents).or_panic == 520_i64
assert GrSale.all.avg(:cents).or_panic == 130.0
assert GrSale.all.max(:cents).or_panic == 300_i64
