module test/grant_schema_ddl_transaction_test

import grant/schema/migration::{Migration, MigrationEntry}
import grant/schema/migration_context::{MigrationContext}
import grant/adapter/schema::{InvalidDefinition}
import grant/error::{ErrorBase}
import std/time::{Span}
import test/m03_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class M03FailsAfterCreate < Migration
  migration_version 20240501000001
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_atomic) { |t| t.string(:label) }!
    ErrorBase.new("boom after create")
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_atomic)
  end
end

pub class M03FailsWithoutTransaction < Migration
  migration_version 20240501000002
  disable_ddl_transaction_in_place
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_atomic) { |t| t.string(:label) }!
    ErrorBase.new("boom after create")
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_atomic)
  end
end

pub class M03ConcurrentIndex < Migration
  migration_version 20240501000003
  disable_ddl_transaction_in_place
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_users) { |t| t.string(:email) }!
    add_index(:m03_users, :email, algorithm: :concurrently)
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_users)
  end
end

pub class M03ConcurrentIndexInTransaction < Migration
  migration_version 20240501000004
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_users) { |t| t.string(:email) }!
    add_index(:m03_users, :email, algorithm: :concurrently)
  end
end

pub class M03RebuildsColumn < Migration
  migration_version 20240501000005
  def initialize(@fail : Bool = false)
  end
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_users) do |t|
      t.string(:email)
      t.integer(:age)
    end!
    remove_column(:m03_users, :age)!
    add_column(:m03_users, :nick, :string)!
    @fail ? ErrorBase.new("boom after rebuild") : nil
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_users)
  end
end

register_spec_connections
restore_default_spec_connections
adapter = ::Test::M03Fixture.adapter

# it: rolls a failed migration back with its version when the database has transactional DDL
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03FailsAfterCreate, verbose: false)
error = context.migrate
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("boom after create")
if adapter.supports_ddl_transactions?
  assert !::Test::M03Fixture.table?("m03_atomic")
else
  assert ::Test::M03Fixture.table?("m03_atomic")
end
assert ::Test::M03Fixture.versions.empty?

# it: leaves the DDL in place when the migration opts out
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03FailsWithoutTransaction, verbose: false)
error = context.migrate
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("boom after create")
assert ::Test::M03Fixture.table?("m03_atomic")
assert ::Test::M03Fixture.versions.empty?

# it: releases the migration lock after a failure
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03FailsAfterCreate, verbose: false, lock_timeout: Span.milliseconds(200_i64))
2.times do
  adapter.open { |db| db.exec("DROP TABLE IF EXISTS m03_atomic") }.or_panic
  error = context.migrate
  assert error.is_a?(ErrorBase)
  assert error.as(ErrorBase).message.includes?("boom after create")
end

# it: builds an index concurrently only outside a transaction
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03ConcurrentIndex, verbose: false)
context.migrate.or_panic
assert ::Test::M03Fixture.versions == [20240501000003_i64]
assert adapter.schema.indexes("m03_users").or_panic.map { |index| index.name }.includes?("index_m03_users_on_email")
context.rollback.or_panic
assert ::Test::M03Fixture.versions.empty?
inside = MigrationContext.for(adapter, M03ConcurrentIndexInTransaction, verbose: false)
if adapter.postgres?
  error = inside.migrate
  assert error.is_a?(InvalidDefinition)
  assert error.as(InvalidDefinition).message.includes?("CONCURRENTLY")
end

# it: runs SQLite table rebuilds inside the migration's transaction
::Test::M03Fixture.reset_in_place
if adapter.sqlite?
  entry = MigrationEntry.new(20240501000005_i64, "M03RebuildsColumn", -> { M03RebuildsColumn.new(true).as(Migration) })
  context = MigrationContext.new(adapter, [entry], verbose: false)
  error = context.migrate
  assert error.is_a?(ErrorBase)
  assert error.as(ErrorBase).message.includes?("boom after rebuild")
  assert !::Test::M03Fixture.table?("m03_users")
  enforced = adapter.open { |db| db.scalar("PRAGMA foreign_keys").or_panic.as(Int64) }.or_panic
  assert enforced == 1
  ok = MigrationContext.for(adapter, M03RebuildsColumn, verbose: false)
  ok.migrate.or_panic
  assert ::Test::M03Fixture.column?("m03_users", "nick")
  assert !::Test::M03Fixture.column?("m03_users", "age")
end
::Test::M03Fixture.reset_in_place
