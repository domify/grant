module test/grant_associations_collection_build_create_test
import grant/base::{Base}
import grant/errors::{RecordNotSaved, RecordInvalid}
import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}

pub class BcAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table bc_authors
  column id : Int64, primary: true
  column name : String?
  has_many :bc_books, class_name: BcBook, foreign_key: :bc_author_id, inverse_of: :bc_author
end

pub class BcBook < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table bc_books
  column id : Int64, primary: true
  column title : String?
  column pages : Int32?
  column bc_author_id : Int64?
  belongs_to :bc_author, class_name: BcAuthor, foreign_key: :bc_author_id, optional: true
  validate "title must be present" do |book|
    !book.title.to_s.empty?
  end
end

private def statements(&block : -> T) : Array(String) forall T
  captured = [] of String
  connection = BcAuthor.__connection
  previous = connection.query_observer
  connection.query_observer = ->(sql : String) { captured << sql; nil }
  yield
  connection.query_observer = previous
  captured
end

private def statement_count(sqls : Array(String), verb : String) : Int32
  sqls.count { |sql| sql.lstrip.upcase.starts_with?(verb.upcase) }
end

register_spec_connections
BcAuthor.migrator.drop_and_create.or_panic
BcBook.migrator.drop_and_create.or_panic

# it: sets the foreign key and the inverse association
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

book = author.bc_books.build(title: "T")

assert !book.persisted?
assert book.bc_author_id == author.id
assert book.association_loaded?(:bc_author)
assert book.bc_author.or_panic.as(BcAuthor).object_id == author.object_id

# it: yields the new record to a block after attributes are assigned
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic
seen_title = nil.as(String?)

book = author.bc_books.build(title: "T") do |built|
  seen_title = built.title
  built.pages = 12
end

assert seen_title == "T"
assert book.pages == 12

# it: accepts a Hash of attributes
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

book = author.bc_books.build({"title" => "H", "pages" => 3})

assert book.title == "H"
assert book.pages == 3
assert book.bc_author_id == author.id

# it: accepts an Array of Hashes and NamedTuples
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

from_hashes = author.bc_books.build([{"title" => "1"}, {"title" => "2"}])
from_tuples = author.bc_books.build([{title: "3"}, {title: "4"}])

assert from_hashes.map(&.title) == ["1", "2"]
assert from_tuples.map(&.title) == ["3", "4"]
assert (from_hashes + from_tuples).all? { |book| book.bc_author_id == author.id }
assert BcBook.count.or_panic == 0

# it: works on an owner that is not saved yet
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.new(name: "new")

book = author.bc_books.build(title: "T")

assert book.bc_author_id.nil?
assert !book.persisted?

# it: tracks the built record in a loaded collection
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic
collection = author.bc_books
collection.load_target.or_panic

book = collection.build(title: "T")

assert collection.to_a.or_panic.includes?(book)

# it: saves the record with the owner's key
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

book = author.bc_books.create(title: "T").or_panic

assert book.persisted?
assert BcBook.find_strict(book.id).or_panic.bc_author_id == author.id

# it: returns the unsaved record when validation fails
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

book = author.bc_books.create(title: "").or_panic

assert !book.persisted?
assert BcBook.count.or_panic == 0

# it: supports the block form and a Hash
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

first = author.bc_books.create(title: "T") { |built| built.pages = 7 }.or_panic
second = author.bc_books.create({"title" => "H"}).or_panic

assert BcBook.find_strict(first.id).or_panic.pages == 7
assert BcBook.find_strict(second.id).or_panic.title == "H"

# it: creates every element of an Array inside one transaction
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

created = [] of BcBook
statements = statements do
  created = author.bc_books.create([{title: "1"}, {title: "2"}, {title: "3"}]).or_panic
end

assert created.size == 3
assert BcBook.where(bc_author_id: author.id).count.or_panic == 3
# MySQL opens a transaction with START TRANSACTION, the others with BEGIN.
assert statement_count(statements, CURRENT_ADAPTER == "mysql" ? "START TRANSACTION" : "BEGIN") == 1
assert statement_count(statements, "COMMIT") == 1

# it: raises RecordNotSaved for an owner that is not saved
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.new(name: "new")

error = author.bc_books.create(title: "T")
assert error.is_a?(RecordNotSaved)

assert error.as(RecordNotSaved).message.to_s.includes?("parent is saved")
assert BcBook.count.or_panic == 0

# it: raises when the record is invalid
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

assert author.bc_books.create_strict(title: "").is_a?(RecordInvalid)

# it: raises RecordNotSaved for an owner that is not saved
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.new(name: "new")

assert author.bc_books.create_strict(title: "T").is_a?(RecordNotSaved)
assert author.bc_books.create_strict([{title: "T"}]).is_a?(RecordNotSaved)

# it: supports the block form
BcBook.clear.or_panic
BcAuthor.clear.or_panic
author = BcAuthor.create_strict(name: "a").or_panic

book = author.bc_books.create_strict(title: "T") { |built| built.pages = 9 }.or_panic

assert BcBook.find_strict(book.id).or_panic.pages == 9

BcAuthor.adapter.close.or_panic
