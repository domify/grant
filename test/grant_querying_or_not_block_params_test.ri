module test/grant_querying_or_not_block_params_test
import grant/error::{ErrorBase}
import test/querying_spec_models::{Review}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Review.migrator.drop_and_create.or_panic


# it: returns the correct rows when the block has a single where condition
Review.clear.or_panic
Review.create(name: "alice", downvotes: 1)
Review.create(name: "bob", downvotes: 2)
_r3 = Review.create(name: "carol", downvotes: 3)
# WHERE name = 'bob' OR (name = 'alice')
found = Review.where(name: "bob").or_where(&.where(name: "alice")).select.or_panic
names = found.map(&.name)
assert names.includes?("alice")
assert names.includes?("bob")
assert !names.includes?("carol")

# it: returns the correct rows when the block has multiple where conditions ANDed together
Review.clear.or_panic
Review.create(name: "alice", downvotes: 30)
_r2 = Review.create(name: "alice", downvotes: 99)
_r3 = Review.create(name: "carol", downvotes: 30)
# WHERE name = 'carol' OR (name = 'alice' AND downvotes = 30)
found = Review.where(name: "carol").or_where(&.where(name: "alice").where(downvotes: 30)).select.or_panic
names = found.map(&.name)
assert names.includes?("alice")
assert names.includes?("carol")
assert found.size == 2
# alice with downvotes=30, carol — NOT alice with downvotes=99
assert found.none? { |r| r.name == "alice" && r.downvotes == 99 }

# it: chains where + or-block and returns only matching rows
Review.clear.or_panic
r_alice = Review.create(name: "alice", downvotes: 5)
r_bob = Review.create(name: "bob", downvotes: 10)
_r_eve = Review.create(name: "eve", downvotes: 20)
# WHERE downvotes = 5 OR (name = 'bob' AND downvotes = 10)
found = Review.where(downvotes: 5).or_where(&.where(name: "bob").where(downvotes: 10)).select.or_panic
assert found.size == 2
ids = found.map(&.id)
assert ids.includes?(r_alice.id)
assert ids.includes?(r_bob.id)

# it: excludes rows matching parameterized conditions inside the block
Review.clear.or_panic
_r1 = Review.create(name: "banned", downvotes: 0)
Review.create(name: "good", downvotes: 0)
Review.create(name: "neutral", downvotes: 0)
# WHERE downvotes >= 0 AND NOT (name = 'banned')
found = Review.where.gteq(:downvotes, 0).not(&.where(name: "banned")).select.or_panic
names = found.map(&.name)
assert !names.includes?("banned")
assert names.includes?("good")
assert names.includes?("neutral")

# it: excludes rows matching multiple ANDed parameterized conditions
Review.clear.or_panic
_r1 = Review.create(name: "banned", downvotes: 5)
r2 = Review.create(name: "banned", downvotes: 99) # different downvotes — NOT excluded
r3 = Review.create(name: "good", downvotes: 5)    # different name — NOT excluded
# WHERE downvotes >= 0 AND NOT (name = 'banned' AND downvotes = 5)
found = Review.where.gteq(:downvotes, 0).not(&.where(name: "banned").where(downvotes: 5)).select.or_panic
ids = found.map(&.id)
assert ids.includes?(r2.id)
assert ids.includes?(r3.id)
assert !ids.includes?(_r1.id)

# it: assembles a three-part query and returns only the matching result set
Review.clear.or_panic
r_a = Review.create(name: "alice", downvotes: 1)
r_b = Review.create(name: "bob", downvotes: 2)
r_c = Review.create(name: "carol", downvotes: 3)
_r_d = Review.create(name: "dave", downvotes: 4)
# WHERE name = 'alice' OR (name = 'bob' AND downvotes = 2) OR (name = 'carol' AND downvotes = 3)
found = Review
  .where(name: "alice")
  .or_where(&.where(name: "bob").where(downvotes: 2))
  .or_where(&.where(name: "carol").where(downvotes: 3))
  .select.or_panic
ids = found.map(&.id)
assert ids.includes?(r_a.id)
assert ids.includes?(r_b.id)
assert ids.includes?(r_c.id)
assert !ids.includes?(_r_d.id)
assert found.size == 3

# Grouped negation keeps its source relation and values independent.
base = Review.where.gteq(:downvotes, 0)
negated = base.not(&.where(name: "bob"))
assert base.count.or_panic == 4
assert negated.count.or_panic == 3
assert base.not { |query| query }.count.or_panic == 4
assert base.not(&.where(no_such_column: "x")).select.is_a?(ErrorBase)
identity = base.object_id
base.not_in_place(&.where(name: "dave"))
assert base.object_id == identity
assert base.count.or_panic == 3
Review.adapter.close.or_panic
