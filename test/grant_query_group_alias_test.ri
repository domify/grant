module test/grant_query_group_alias_test

import grant/base::{Base}
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class GaOrder < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ga_orders
  column id : Int64, primary: true
  column status : String
  column region : String
  column cents : Int64
  column placed_on : String
end

# GROUP BY does not promise row order; compare every key/value and the cardinality.
private def same_hash?(actual : A, expected : Hash(K, V)) : Bool forall A, K, V
  return false unless actual.is_a?(Hash)
  actual_entries = [] of String
  expected_entries = [] of String
  actual.each { |key, value| actual_entries << "#{key.inspect} => #{value.inspect}" }
  expected.each { |key, value| expected_entries << "#{key.inspect} => #{value.inspect}" }
  actual_entries.sorted == expected_entries.sorted
end

private def reset : Nil
  GaOrder.clear.or_panic
  GaOrder.create_strict(status: "open", region: "east", cents: 100_i64, placed_on: "2026-09-27 10:00:00").or_panic
  GaOrder.create_strict(status: "open", region: "west", cents: 250_i64, placed_on: "2026-09-27 12:00:00").or_panic
  GaOrder.create_strict(status: "done", region: "east", cents: 400_i64, placed_on: "2026-09-28 09:00:00").or_panic
  nil
end

register_spec_connections
GaOrder.migrator.drop_and_create.or_panic

# it: answers group like group_by
reset
assert GaOrder.group_records(:status).raw_sql == GaOrder.group_by(:status).raw_sql
assert GaOrder.group_records(:status, :region).raw_sql == GaOrder.group_by([:status, :region]).raw_sql
assert same_hash?(GaOrder.all.group_records(:status).count.or_panic, {"open" => 2_i64, "done" => 1_i64})
assert same_hash?(GaOrder.group_records(:status, :region).count.or_panic, {
  ["open", "east"] => 1_i64, ["open", "west"] => 1_i64, ["done", "east"] => 1_i64,
})

# it: keeps group_by working
reset
assert same_hash?(GaOrder.group_by(:status).count.or_panic, {"open" => 2_i64, "done" => 1_i64})

# it: groups by a SQL expression
reset
counts = GaOrder.group_records("substr(placed_on, 1, 10)").count.or_panic
assert same_hash?(counts, {"2026-09-27" => 2_i64, "2026-09-28" => 1_i64})
assert same_hash?(GaOrder.group_by("substr(placed_on, 1, 10)").count.or_panic, counts.as(Hash(Value, Int64)))

# it: mixes columns and expressions across calls
reset
assert same_hash?(GaOrder.group_records(:status).group_records("substr(placed_on, 1, 10)").count.or_panic, {
  ["open", "2026-09-27"] => 2_i64, ["done", "2026-09-28"] => 1_i64,
})

# it: has a bang form, and unscope drops the grouping
reset
relation = GaOrder.all
relation.group_in_place(:status)
assert relation.group_fields.size == 1
assert relation.unscope(:group).group_fields.empty?
assert GaOrder.group_records(:status).regroup(:region).group_fields.map { |field| field[:field] } == ["region"]

# it: does not change the receiver
reset
base = GaOrder.where(status: "open")
base.group_records(:region)
base.group_records("lower(region)")
assert base.group_fields.empty?

# it: refuses an expression that is not a single clause
reset
{"status; DELETE FROM ga_orders" => "statement separator", "status -- x" => "comment marker",
 "lower(status" => "unbalanced", "'open" => "unterminated quote", " " => "blank"}.each do |sql, message|
  relation = GaOrder.group_records(sql)
  error = relation.select
  assert error.is_a?(ArgumentError)
  assert error.as(ArgumentError).message.includes?(message)
end

GaOrder.adapter.close.or_panic
