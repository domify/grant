module test/grant_converters_enum_test
import grant/converters
import test/converter_spec_support::{FieldEmitter}
import std/slice::{Bytes}

pub enum TestEnum
  Zero
  One
  Two
  Three = 17
end

# it: should convert a Test enum into a Number
assert Grant::Converters::Enum(TestEnum, Int8).to_db(TestEnum::One) == 1_i64
assert Grant::Converters::Enum(TestEnum, Float64).to_db(TestEnum::Two) == 2_i64
assert Grant::Converters::Enum(TestEnum, Int32).to_db(TestEnum::Three) == 17_i64

# it: should convert the RS value into a Test enum
rs = FieldEmitter(Int32).new
rs._set_values([0])
assert Grant::Converters::Enum(TestEnum, Int32).from_rs(rs) == TestEnum::Zero

# it: should convert the RS value into a Test enum
rs = FieldEmitter(Int16).new
rs._set_values([1_i16])
assert Grant::Converters::Enum(TestEnum, Int16).from_rs(rs) == TestEnum::One

# it: should convert the RS value into a Test enum
rs = FieldEmitter(Float64).new
rs._set_values([17.0])
assert Grant::Converters::Enum(TestEnum, Float64).from_rs(rs) == TestEnum::Three

# it: should convert a Test enum into a string
assert Grant::Converters::Enum(TestEnum, String).to_db(TestEnum::Two) == "Two"

# it: should convert the RS value into a Test enum
rs = FieldEmitter(String).new
rs._set_values(["Three"])
assert Grant::Converters::Enum(TestEnum, String).from_rs(rs) == TestEnum::Three

# it: should convert a Test enum into a string
assert Grant::Converters::Enum(TestEnum, Bytes).to_db(TestEnum::Two) == "Two"

# it: should convert an Int32 value into a Test enum
rs = FieldEmitter(Bytes).new
rs._set_values([Bytes.new(4) { |i| [90_u8, 101_u8, 114_u8, 111_u8][i] }])
assert Grant::Converters::Enum(TestEnum, Bytes).from_rs(rs) == TestEnum::Zero
