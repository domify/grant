module test/grant_query_having_test
import test/query_spec_helper::{Model, builder, with_legacy_implicit_order}
import grant/query/builder::{Builder}

with_legacy_implicit_order do

  # it: stores having clauses
  query = builder.having("COUNT(*) > ?", 5)
  assert query.having_clauses.size == 1
  assert query.having_clauses.first[:stmt] == "COUNT(*) > ?"
  assert query.having_clauses.first[:value] == 5

  # it: supports having without a value
  query = builder.having("COUNT(*) > 0")
  assert query.having_clauses.size == 1
  assert query.having_clauses.first[:value].nil?

  # it: chains multiple having clauses
  query = builder
    .group_by(:name)
    .having("COUNT(*) > ?", 5)
    .having("SUM(age) > ?", 100)
  assert query.having_clauses.size == 2

  # it: works with joins and group_by
  query = builder
    .joins("posts", on: "posts.user_id = table.id")
    .group_by(:name)
    .having("COUNT(*) > ?", 3)
  assert query.join_clauses.size == 1
  assert query.group_fields.size == 1
  assert query.having_clauses.size == 1

  # it: returns self for chaining
  query = builder.having("COUNT(*) > ?", 5)
  assert query.is_a?(Builder(Model))

  # it: copies having clauses on dup
  original = builder.having("COUNT(*) > ?", 5)
  copy = original.dup
  assert copy.having_clauses.size == 1
  assert copy.having_clauses.first[:stmt] == "COUNT(*) > ?"

  # it: dup creates independent copy
  original = builder.having("COUNT(*) > ?", 5)
  copy = original.dup
  copy = copy.having("SUM(age) > ?", 100)
  assert original.having_clauses.size == 1
  assert copy.having_clauses.size == 2

  # it: merges having clauses from another builder
  b1 = builder.having("COUNT(*) > ?", 5)
  b2 = builder.having("SUM(age) > ?", 100)
  b1 = b1.merge(b2)
  assert b1.having_clauses.size == 2
end
