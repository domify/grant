module test/grant_scoping_default_scope_everywhere_test
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}
import grant/querying::{ScopedRawSqlError}
import std/time::{Time}
import std/enumerable::{Enumerable}
import test/spec_helper::{register_spec_connections}

pub class EverywhereScopedRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table everywhere_scoped_records

  column id : Int64, primary: true
  column title : String
  column visible : Bool = true
  column category : String
  column score : Int64 = 0_i64
  timestamps

  has_many :children, class_name: EverywhereScopedChild, foreign_key: :record_id

  scope :in_alpha, -> { where(category: "alpha") }
  scope :in_category, ->(category : String) { where(category: category) }
  scope :in_beta, ->(query : Builder(EverywhereScopedRecord)) { query.where(category: "beta") }
  default_scope { where(visible: true) }
end

pub class EverywhereScopedChild < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table everywhere_scoped_children

  column id : Int64, primary: true
  column record_id : Int64
  column value : String

  # Optional: one fixture child deliberately points at a parent the default
  # scope hides, and a required belongs_to would (like Rails) reject that.
  belongs_to :record, class_name: EverywhereScopedRecord, foreign_key: :record_id, optional: true
end

pub class EverywhereScopedStiRecord < Base
  ::Grant::STI.enable
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table everywhere_scoped_sti_records

  column id : Int64, primary: true
  column type : String
  column title : String
  column visible : Bool = true

  default_scope { where(visible: true) }
end

pub class EverywhereScopedStiChild < EverywhereScopedStiRecord
end
pub class DefaultScopeGenericClassLookup
  def self.exists?(model_class : M.class, id : Int64) : Bool | ErrorBase forall M
    model_class.exists?(id)
  end
end

register_spec_connections
EverywhereScopedRecord.migrator.drop_and_create.or_panic
EverywhereScopedChild.migrator.drop_and_create.or_panic
EverywhereScopedStiRecord.migrator.drop_and_create.or_panic

pub def reset_records : Nil
  EverywhereScopedChild.unscoped.delete_all.or_panic
  EverywhereScopedRecord.unscoped.delete_all.or_panic
  EverywhereScopedRecord.create_strict(title: "visible one", visible: true, category: "alpha", score: 10_i64).or_panic
  EverywhereScopedRecord.create_strict(title: "visible two", visible: true, category: "alpha", score: 20_i64).or_panic
  EverywhereScopedRecord.create_strict(title: "visible three", visible: true, category: "beta", score: 30_i64).or_panic
  EverywhereScopedRecord.create_strict(title: "hidden", visible: false, category: "hidden", score: 100_i64).or_panic
  visible_id = EverywhereScopedRecord.unscoped.where(title: "visible one").first_strict.or_panic.id || raise "id missing"
  hidden_id = EverywhereScopedRecord.unscoped.where(title: "hidden").first_strict.or_panic.id || raise "id missing"
  EverywhereScopedChild.create_strict(record_id: visible_id, value: "visible child").or_panic
  EverywhereScopedChild.create_strict(record_id: hidden_id, value: "hidden child").or_panic
  nil
end

# it: keeps filters separate from default predicates when OR conditions are chained
reset_records
assert EverywhereScopedRecord.all.map(&.title).or_panic.sorted == ["visible one", "visible three", "visible two"]
assert EverywhereScopedRecord.where(title: "hidden").select.or_panic.empty?
assert EverywhereScopedRecord.where.not(:visible, true).select.or_panic.empty?
assert EverywhereScopedRecord.where(title: "missing").or_where(title: "hidden").select.or_panic.empty?
assert EverywhereScopedRecord.in_alpha.select.or_panic.map(&.title).sorted == ["visible one", "visible two"]
assert EverywhereScopedRecord.in_category("beta").select.or_panic.map(&.title) == ["visible three"]
assert EverywhereScopedRecord.in_beta.select.or_panic.map(&.title) == ["visible three"]
assert EverywhereScopedRecord.all("WHERE title IN (?, ?)", ["hidden", "visible two"] of Value).or_panic.map(&.title) == ["visible two"]
assert EverywhereScopedRecord.raw_all("WHERE title = ?", ["hidden"] of Value).or_panic.empty?

# it: dispatches default scopes through generic model references and composes with STI
reset_records
hidden_id = EverywhereScopedRecord.unscoped.where(title: "hidden").first_strict.or_panic.id || raise "id missing"
visible_id = EverywhereScopedRecord.unscoped.where(title: "visible one").first_strict.or_panic.id || raise "id missing"
assert !DefaultScopeGenericClassLookup.exists?(EverywhereScopedRecord, hidden_id).or_panic
assert DefaultScopeGenericClassLookup.exists?(EverywhereScopedRecord, visible_id).or_panic
EverywhereScopedStiRecord.unscoped.delete_all.or_panic
EverywhereScopedStiRecord.create_strict(title: "visible root", visible: true).or_panic
EverywhereScopedStiChild.create_strict(title: "visible child", visible: true).or_panic
EverywhereScopedStiChild.create_strict(title: "hidden child", visible: false).or_panic
assert EverywhereScopedStiRecord.all.map(&.title).or_panic.sorted == ["visible child", "visible root"]
assert EverywhereScopedStiChild.all.map(&.title).or_panic == ["visible child"]

# it: scopes class-level selection, ordering, projection, distinct, grouping, joins, and eager loading
reset_records
assert EverywhereScopedRecord.order(id: :desc).reorder(id: :asc).limit(2).offset(1).select.or_panic.map(&.title) == ["visible two", "visible three"]
assert EverywhereScopedRecord.select(:category).select.or_panic.map(&.category).uniq.sorted == ["alpha", "beta"]
assert EverywhereScopedRecord.pluck(:category).or_panic.map(&.as(String)).uniq.sorted == ["alpha", "beta"]
assert EverywhereScopedRecord.where(category: "alpha").pluck(:category).or_panic.uniq == [["alpha"] of Value]
assert EverywhereScopedRecord.ids.or_panic.size == 3
assert EverywhereScopedRecord.distinct.select(:category).select.or_panic.map(&.category).sorted == ["alpha", "beta"]
grouped_categories = EverywhereScopedRecord.group_by(:category).having("COUNT(*) > ?", 0_i64).select(:category).select.or_panic.map(&.category).sorted
assert grouped_categories == ["alpha", "beta"]
join_titles = EverywhereScopedRecord.joins("everywhere_scoped_children", on: "everywhere_scoped_children.record_id = everywhere_scoped_records.id").select.or_panic.map(&.title)
assert join_titles == ["visible one"]
left_join_titles = EverywhereScopedRecord.left_joins("everywhere_scoped_children", on: "everywhere_scoped_children.record_id = everywhere_scoped_records.id").select(:title).select.or_panic.map(&.title).sorted
assert left_join_titles == ["visible one", "visible three", "visible two"]
assert EverywhereScopedRecord.includes(:children).select.or_panic.map(&.title).sorted == ["visible one", "visible three", "visible two"]
assert EverywhereScopedRecord.preload(:children).select.or_panic.map(&.title).sorted == ["visible one", "visible three", "visible two"]
assert EverywhereScopedRecord.eager_load(:children).select.or_panic.map(&.title).sorted == ["visible one", "visible three", "visible two"]

# it: scopes lookups, first and last helpers, and class-level iteration
reset_records
visible = EverywhereScopedRecord.unscoped.where(title: "visible one").first_strict.or_panic
hidden = EverywhereScopedRecord.unscoped.where(title: "hidden").first_strict.or_panic
found = EverywhereScopedRecord.find(visible.id).or_panic
assert (found ? found.title : nil) == "visible one"
assert EverywhereScopedRecord.find(hidden.id).or_panic.nil?
assert EverywhereScopedRecord.find_by(title: "hidden").or_panic.nil?
found = EverywhereScopedRecord.find_by(title: "visible one").or_panic
assert (found ? found.id : nil) == visible.id
assert EverywhereScopedRecord.find_sole_by(title: "visible two").or_panic.title == "visible two"
assert (EverywhereScopedRecord.first.or_panic || raise "record missing").title == "visible one"
assert EverywhereScopedRecord.first_strict.or_panic.title == "visible one"
found = EverywhereScopedRecord.last.or_panic
assert (found ? found.title : nil) == "visible three"
assert EverywhereScopedRecord.last_strict.or_panic.title == "visible three"
found = EverywhereScopedRecord.take.or_panic
assert (found ? found.title : nil) == "visible one"
assert EverywhereScopedRecord.take(2).or_panic.map(&.title) == ["visible one", "visible two"]
ids_from_each = [] of Int64
EverywhereScopedRecord.find_each(batch_size: 2) { |record| ids_from_each << (record.id || raise "id missing") }.or_panic
assert ids_from_each.size == 3
batch_sizes = [] of Int32
EverywhereScopedRecord.find_in_batches(batch_size: 2) { |batch| batch_sizes << batch.size }.or_panic
assert batch_sizes == [2, 1]
yielded_batches = [] of Int32
EverywhereScopedRecord.in_batches(of: 2) { |batch| yielded_batches << batch.to_a.or_panic.size }.or_panic
assert yielded_batches == [2, 1]
streamed_titles = [] of String
EverywhereScopedRecord.each_streamed { |record| streamed_titles << (record.title || raise "title missing") }.or_panic
assert streamed_titles.size == 3
assert !streamed_titles.includes?("hidden")

# it: scopes calculations and existence checks
reset_records
hidden_id = EverywhereScopedRecord.unscoped.where(title: "hidden").first_strict.or_panic.id || raise "id missing"
visible_id = EverywhereScopedRecord.unscoped.where(title: "visible two").first_strict.or_panic.id || raise "id missing"
assert EverywhereScopedRecord.count.or_panic == 3
assert EverywhereScopedRecord.where(title: "hidden").count.or_panic == 0
assert !EverywhereScopedRecord.exists?(hidden_id).or_panic
assert !EverywhereScopedRecord.exists?(id: hidden_id).or_panic
assert !EverywhereScopedRecord.where(id: hidden_id).exists?.or_panic
assert EverywhereScopedRecord.exists?(visible_id).or_panic
assert EverywhereScopedRecord.sum(:score).or_panic == 60.0
assert EverywhereScopedRecord.avg(:score).or_panic == 20.0
assert EverywhereScopedRecord.average(:score).or_panic == 20.0
assert EverywhereScopedRecord.min(:score).or_panic == 10_i64
assert EverywhereScopedRecord.minimum(:score).or_panic == 10_i64
assert EverywhereScopedRecord.max(:score).or_panic == 30_i64
assert EverywhereScopedRecord.maximum(:score).or_panic == 30_i64
assert EverywhereScopedRecord.order(id: :asc).pick(:title).or_panic == ["visible one"] of Value

# it: scopes bulk writes and leaves the hidden row unchanged
reset_records
hidden_id = EverywhereScopedRecord.unscoped.where(title: "hidden").first_strict.or_panic.id || raise "id missing"
assert EverywhereScopedRecord.update_all(score: 99_i64).or_panic == 3
assert EverywhereScopedRecord.unscoped.where(id: hidden_id).first_strict.or_panic.title == "hidden"
EverywhereScopedRecord.unscoped do |_query|
  assert EverywhereScopedRecord.update_all(score: 101_i64).or_panic == 4
end
assert EverywhereScopedRecord.unscoped.where(id: hidden_id).first_strict.or_panic.score == 101_i64
assert EverywhereScopedRecord.where(title: "hidden").update_all(title: "changed hidden").or_panic == 0
assert EverywhereScopedRecord.update_counters(hidden_id, {:score => 5}).or_panic == 0
assert EverywhereScopedRecord.delete_by(title: "hidden").or_panic == 0
assert EverywhereScopedRecord.destroy_by(title: "hidden").or_panic == 0
assert EverywhereScopedRecord.where(title: "hidden").delete_all.or_panic == 0
assert EverywhereScopedRecord.where(title: "hidden").destroy_all.or_panic == 0
assert EverywhereScopedRecord.touch_all(time: Time.utc(2020, 1, 1)).or_panic == 3
assert EverywhereScopedRecord.unscoped.where(id: hidden_id).first_strict.or_panic.title == "hidden"
assert EverywhereScopedRecord.where(title: "visible one").update_all(title: "changed visible").or_panic == 1
assert EverywhereScopedRecord.delete_all.or_panic == 3
assert EverywhereScopedRecord.unscoped.where(id: hidden_id).first_strict.or_panic.title == "hidden"
EverywhereScopedRecord.clear.or_panic
assert EverywhereScopedRecord.unscoped.where(title: "hidden").count.or_panic == 1
assert EverywhereScopedRecord.unscoped.where(title: "changed visible").count.or_panic == 0

# it: requires unscoped for raw SQL and preserves both explicit unscoped forms
reset_records
result = EverywhereScopedRecord.query("SELECT * FROM everywhere_scoped_records") { |_rs| nil }
assert result.is_a?(ScopedRawSqlError)
unscoped_titles = EverywhereScopedRecord.unscoped.where(title: "hidden").select.or_panic.map(&.title)
assert unscoped_titles == ["hidden"]
block_titles = EverywhereScopedRecord.unscoped do |query|
  query.where(title: "hidden").select.or_panic.map(&.title)
end
assert block_titles == ["hidden"]
assert EverywhereScopedRecord.unscoped { EverywhereScopedRecord.count.or_panic } == 4

EverywhereScopedRecord.adapter.close.or_panic
