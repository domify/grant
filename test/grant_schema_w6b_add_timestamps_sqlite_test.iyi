module test/grant_schema_w6b_add_timestamps_sqlite_test
import grant/base::{Base}
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/schema::{Dialect}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

pub class W6bTimestamped < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_timestamped
  column id : Int64, primary: true
  column name : String?
  timestamps precision: 3, null: false
end

register_spec_connections
restore_default_spec_connections
adapter = ::Test::SchemaFixture.adapter
statements = AdapterStatements.new(adapter)
private def reset(statements : AdapterStatements) : Nil
  statements.drop_table(:w6b_stamped, if_exists: true).or_panic
  statements.create_table(:w6b_stamped) { |t| t.string(:name) }.or_panic
end

# it: adds NOT NULL timestamps to an empty table
reset(statements)
statements.add_timestamps(:w6b_stamped).or_panic
adapter.reset_schema_caches_in_place
columns = adapter.schema.columns(:w6b_stamped).or_panic
assert columns.map { |column| column.name } == ["id", "name", "created_at", "updated_at"]
assert columns.reject { |column| ["id", "name"].includes?(column.name) }.all? { |column| !column.null? }
assert adapter.open { |db| db.exec("INSERT INTO w6b_stamped (name) VALUES ('x')") }.is_a?(ErrorBase)
adapter.open { |db| db.exec("INSERT INTO w6b_stamped (name, created_at, updated_at) VALUES ('x', '2024-01-02 03:04:05', '2024-01-02 03:04:05')") }.or_panic

# it: keeps the primary key and an index through the rebuild
reset(statements)
statements.add_index(:w6b_stamped, :name).or_panic
statements.add_timestamps(:w6b_stamped).or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.primary_key(:w6b_stamped).or_panic == ["id"]
assert adapter.schema.indexes(:w6b_stamped).or_panic.any? { |index| index.columns == ["name"] }

# it: fails on a populated table, and succeeds there with null: true
reset(statements)
adapter.open { |db| db.exec("INSERT INTO w6b_stamped (name) VALUES ('old')") }.or_panic
assert statements.add_timestamps(:w6b_stamped).is_a?(ErrorBase)
adapter.reset_schema_caches_in_place
assert adapter.schema.columns(:w6b_stamped).or_panic.map { |column| column.name } == ["id", "name"]
assert adapter.open { |db| db.scalar("SELECT COUNT(*) FROM w6b_stamped").or_panic.as(Int64) }.or_panic == 1
statements.add_timestamps(:w6b_stamped, null: true).or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.columns(:w6b_stamped).or_panic.find { |column| column.name == "created_at" }.as(ColumnInfo).null?

# it: removes them again
reset(statements)
statements.add_timestamps(:w6b_stamped).or_panic
statements.remove_timestamps(:w6b_stamped).or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.columns(:w6b_stamped).or_panic.map { |column| column.name } == ["id", "name"]

# it: emits one rebuild for both columns on SQLite and one ALTER elsewhere
reset(statements)
dialect = Dialect.for(adapter)
recorder = RecordingStatements.new(dialect)
definition = "CREATE TABLE \"users\" (\"id\" INTEGER PRIMARY KEY, \"name\" VARCHAR(255))"
recorder.sqlite_tables["users"] = {definition, [] of String}
sql = recorder.add_timestamps_statements(:users).or_panic
if dialect == Dialect::Sqlite
  assert sql.count { |text| text.starts_with?("CREATE TABLE") } == 1
  assert sql.find { |text| text.starts_with?("CREATE TABLE") }.as(String).includes?("\"created_at\" DATETIME NOT NULL")
else
  assert sql.size == 1
end

# it: gives the model timestamps macro precision and null: in the DDL
reset(statements)
W6bTimestamped.migrator.drop_and_create.or_panic
adapter.reset_schema_caches_in_place
by_name = {} of String => ColumnInfo
adapter.schema.columns(:w6b_timestamped).or_panic.each { |column| by_name[column.name] = column }
assert !by_name["created_at"].null?
assert !by_name["updated_at"].null?
case CURRENT_ADAPTER
when "mysql"
  assert by_name["created_at"].sql_type.downcase.includes?("(3)")
when "pg"
  assert adapter.open { |db| db.scalar("SELECT datetime_precision FROM information_schema.columns WHERE table_name = 'w6b_timestamped' AND column_name = 'created_at'").or_panic.as(Int64) }.or_panic == 3
end
assert !W6bTimestamped.create(name: "x").created_at.nil?
assert !W6bTimestamped.first_strict.or_panic.updated_at.nil?
statements.drop_table(:w6b_stamped, if_exists: true).or_panic
W6bTimestamped.migrator.drop.or_panic
