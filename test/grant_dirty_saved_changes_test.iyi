module test/grant_dirty_saved_changes_test
import test/dirty_family_models::{F01Post}


# it: reports saved_change_to_<attr>? with from: and to: filters
post = F01Post.create_strict(title: "first", views: 1).or_panic
assert post.saved_change_to_title? # creation is a change from nil
post.title = "second"
assert post.saved_change_to_title? # still the create's change until saved
post.save_strict.or_panic
assert post.saved_change_to_title?
assert post.saved_change_to_title?(from: "first")
assert post.saved_change_to_title?(to: "second")
assert post.saved_change_to_title?(from: "first", to: "second")
assert !post.saved_change_to_title?(from: "nope")
assert !post.saved_change_to_title?(to: "nope")
assert !post.saved_change_to_views?

# it: returns the change as a tuple
post = F01Post.create_strict(title: "a").or_panic
post.title = "b"
post.save_strict.or_panic
assert post.saved_change_to_title == {"a", "b"}
assert post.saved_change_to_attribute("title") == {"a", "b"}
assert post.saved_change_to_attribute(:title) == {"a", "b"}
assert post.saved_change_to_views.nil?
assert post.saved_change_to_attribute("views").nil?

# it: exposes previously_was and previously_changed?
post = F01Post.create_strict(title: "a", views: 5).or_panic
post.title = "b"
post.save_strict.or_panic
assert post.title_previously_was == "a"
assert post.attribute_previously_was("title") == "a"
assert post.title_previously_changed?
assert post.title_previously_changed?(from: "a", to: "b")
assert !post.title_previously_changed?(from: "b")
assert post.attribute_previously_changed?("title", to: "b")
# An unchanged attribute reports its current value.
assert post.views_previously_was == 5
assert !post.views_previously_changed?

# it: matches a nil from: filter
post = F01Post.new(title: "x")
post.save_strict.or_panic
post.body = "text"
post.save_strict.or_panic
assert post.saved_change_to_body?(from: nil)
assert post.saved_change_to_body?(from: nil, to: "text")

# it: is usable from an after_save callback view of the record
post = F01Post.create_strict(title: "a").or_panic
post.update_strict(title: "b").or_panic
assert post.saved_change_to_title?(from: "a", to: "b")
post.update_strict(views: 3).or_panic
assert !post.saved_change_to_title?
assert post.saved_change_to_views?(to: 3)
