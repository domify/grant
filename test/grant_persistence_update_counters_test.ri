module test/grant_persistence_update_counters_test
import grant/base::{Base}
import std/time::{Time}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}
import test/write_sql_capture

pub class CounterTallyPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table counter_tally_posts
  column id : Int64, primary: true
  column title : String?
  column views_count : Int32?
  column likes_count : Int32?
  column big_count : Int64?
  column seen_at : Time?
  timestamps
end

pub def updates_in(statements : Array(String)) : Array(String)
  statements.select { |sql| sql.starts_with?("UPDATE") }
end

pub STAMP = Time.utc(2020, 1, 2, 3, 4, 5)
register_spec_connections
CounterTallyPost.migrator.drop_and_create.or_panic

# it: adjusts two counter columns in one statement
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", views_count: 10, likes_count: 4).or_panic
statements = Test::WriteSqlCapture.statements(CounterTallyPost.adapter) do
  assert CounterTallyPost.update_counters(post.id_strict.or_panic, {:views_count => 5, :likes_count => -1}).or_panic == 1
end
assert updates_in(statements).size == 1
reloaded = CounterTallyPost.find_strict(post.id).or_panic
assert reloaded.views_count == 15
assert reloaded.likes_count == 3

# it: updates every id in an array with one statement
CounterTallyPost.clear.or_panic
posts = Array(CounterTallyPost).new(3) { |i| CounterTallyPost.create_strict(title: "p#{i}", views_count: i).or_panic }
untouched = CounterTallyPost.create_strict(title: "other", views_count: 100).or_panic
statements = Test::WriteSqlCapture.statements(CounterTallyPost.adapter) do
  assert CounterTallyPost.update_counters(posts.map { |post| post.id_strict.or_panic }, {:views_count => 10}).or_panic == 3
end
updates = updates_in(statements)
assert updates.size == 1
assert updates.first.upcase.includes?(" IN ")
posts.each_with_index do |post, i|
  assert CounterTallyPost.find_strict(post.id).or_panic.views_count == i + 10
end
assert CounterTallyPost.find_strict(untouched.id).or_panic.views_count == 100

# it: counts a NULL column as zero
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p").or_panic
CounterTallyPost.update_counters(post.id_strict.or_panic, {:views_count => 2}).or_panic
assert CounterTallyPost.find_strict(post.id).or_panic.views_count == 2

# it: accepts Int64 deltas
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", big_count: 5_i64).or_panic
CounterTallyPost.update_counters(post.id_strict.or_panic, {:big_count => 4_000_000_000_i64}).or_panic
assert CounterTallyPost.find_strict(post.id).or_panic.big_count == 4_000_000_005_i64

# it: does not touch updated_at unless asked
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", views_count: 0).or_panic
post.touch(time: STAMP).or_panic
CounterTallyPost.update_counters(post.id_strict.or_panic, {:views_count => 1}).or_panic
assert CounterTallyPost.find_strict(post.id).or_panic.updated_at.as(Time) == STAMP

# it: touches updated_at in the same statement with touch: true
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", views_count: 0).or_panic
post.touch(time: STAMP).or_panic
statements = Test::WriteSqlCapture.statements(CounterTallyPost.adapter) do
  CounterTallyPost.update_counters(post.id_strict.or_panic, {:views_count => 1}, touch: true).or_panic
end
assert updates_in(statements).size == 1
assert CounterTallyPost.find_strict(post.id).or_panic.updated_at.as(Time) > STAMP

# it: touches named columns as well
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", views_count: 0).or_panic
post.touch(time: STAMP).or_panic
CounterTallyPost.update_counters([post.id_strict.or_panic], {:views_count => 1}, touch: [:seen_at]).or_panic
reloaded = CounterTallyPost.find_strict(post.id).or_panic
assert !reloaded.seen_at.nil?
assert reloaded.updated_at.as(Time) > STAMP

# it: rejects an unknown touch column
CounterTallyPost.clear.or_panic
post = CounterTallyPost.create_strict(title: "p", views_count: 0).or_panic
error = CounterTallyPost.update_counters(post.id_strict.or_panic, {:views_count => 1}, touch: :nope)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("nope")

# it: returns 0 for an empty list, a missing id and no counters
CounterTallyPost.clear.or_panic
assert CounterTallyPost.update_counters([] of Int64, {:views_count => 1}).or_panic == 0
assert CounterTallyPost.update_counters(999_999, {:views_count => 1}).or_panic == 0
post = CounterTallyPost.create_strict(title: "p", views_count: 1).or_panic
assert CounterTallyPost.update_counters(post.id_strict.or_panic, {} of Symbol => Int32).or_panic == 0
CounterTallyPost.adapter.close.or_panic
