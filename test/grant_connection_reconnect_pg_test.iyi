module test/grant_connection_reconnect_pg_test
import std/time::{Span}
import grant/adapter/base::{Base}
import grant/adapter/drivers::{open_connection}
import grant/error_taxonomy::{ConnectionFailed}
import grant/connection_registry::{ConnectionRegistry}
import test/pool_spec_support::{C02Support}
import test/spec_helper::{CURRENT_ADAPTER, ADAPTER_URL}

private def pooled_adapter(pool_size : Int32, initial_pool_size : Int32, retry_delay : Span) : Base
  C02Support.establish("c02_reconnect", :writing, pool_size: pool_size, initial_pool_size: initial_pool_size, retry_delay: retry_delay)
end

# needs a server to kill a backend on; PostgreSQL only
if CURRENT_ADAPTER == "pg"
  # it: recovers a read and refuses to replay a write after the backend is killed
  adapter = pooled_adapter(pool_size: 3, initial_pool_size: 1, retry_delay: Span.milliseconds(1_i64))
  kill_backend = -> do
    pid = adapter.open("SELECT 1") { |connection| connection.scalar("SELECT pg_backend_pid()") }.or_panic
    killer = open_connection(ADAPTER_URL).or_panic
    killer.scalar("SELECT pg_terminate_backend(#{pid})").or_panic
    killer.close.or_panic
    sleep(100).or_panic
    nil
  end

  kill_backend.call
  attempts = 0
  assert adapter.open("SELECT 1") { |connection| attempts += 1; connection.scalar("SELECT 1") }.or_panic == 1
  assert attempts == 2

  kill_backend.call
  attempts = 0
  error = adapter.open("UPDATE c02_never_written SET a = 1") { |connection| attempts += 1; connection.exec("SELECT 1") }
  assert error.is_a?(ConnectionFailed)
  assert attempts == 1

  assert adapter.active?
  ConnectionRegistry.remove_connection("c02_reconnect", :writing).or_panic
end
