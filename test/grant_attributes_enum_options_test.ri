module test/grant_attributes_enum_options_test

import grant/base::{Base}
import grant/enum_attributes::{UnknownEnumValueError}
import grant/errors::{RecordInvalid}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
import std/text
import std/enum

pub class EnoPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table eno_posts

  column id : Int64, primary: true
  column title : String

  pub enum Status
    Draft
    Published
    Archived
  end

  pub enum Visibility
    Draft
    Public
  end

  pub enum Level
    Low
    High
  end

  enum_attribute status : ::Test::GrantAttributesEnumOptionsTest::EnoPost::Status = :draft, prefix: true
  enum_attribute visibility : ::Test::GrantAttributesEnumOptionsTest::EnoPost::Visibility = :public, suffix: :vis, scopes: false
  enum_attribute level : ::Test::GrantAttributesEnumOptionsTest::EnoPost::Level?, column_type: Int32, validate: {allow_nil: true}
end

pub class EnoStrict < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table eno_stricts

  column id : Int64, primary: true

  pub enum Mode
    On
    Off
  end

  enum_attribute mode : ::Test::GrantAttributesEnumOptionsTest::EnoStrict::Mode?, validate: true
end

pub class EnoGuarded < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table eno_guardeds

  column id : Int64, primary: true
  column title : String

  pub enum Stage
    Open
    Closed
  end

  enum_attribute stage : ::Test::GrantAttributesEnumOptionsTest::EnoGuarded::Stage = :open

  validate "title must not be blank" do |model|
    !model.title.to_s.empty?
  end
end

# Native enum-valued Hash equality is recorded in port/bugs/enum_hash_equality.md.
private def same_mapping?(actual : Hash(String, V), expected : Hash(String, V)) : Bool forall V
  return false unless actual.size == expected.size
  expected.each do |key, value|
    return false unless actual.has_key?(key) && actual[key] == value
  end
  true
end

private def clear_records : Nil
  EnoPost.clear.or_panic
  EnoStrict.clear.or_panic
  EnoGuarded.clear.or_panic
  nil
end

register_spec_connections
id_column = CURRENT_ADAPTER == "pg" ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY AUTOINCREMENT"
EnoPost.exec("DROP TABLE IF EXISTS eno_posts").or_panic
EnoPost.exec("CREATE TABLE eno_posts (id #{id_column}, title VARCHAR(255) NOT NULL, status VARCHAR(255), visibility VARCHAR(255), level INTEGER)").or_panic
EnoStrict.exec("DROP TABLE IF EXISTS eno_stricts").or_panic
EnoStrict.exec("CREATE TABLE eno_stricts (id #{id_column}, mode VARCHAR(255))").or_panic
EnoGuarded.exec("DROP TABLE IF EXISTS eno_guardeds").or_panic
EnoGuarded.exec("CREATE TABLE eno_guardeds (id #{id_column}, title VARCHAR(255) NOT NULL, stage VARCHAR(255))").or_panic

# Upstream: prefixes predicates and scopes so shared member names do not collide
# it: "prefixes predicates and scopes so shared member names
clear_records
post = EnoPost.new(title: "t")
assert post.status_draft?
assert !post.status_published?
assert !post.draft_vis?
assert post.public_vis?

# it: generates not_<member> scopes
clear_records
EnoPost.create_strict(title: "a", status: :draft).or_panic
EnoPost.create_strict(title: "b", status: :published).or_panic
EnoPost.create_strict(title: "c", status: :archived).or_panic
assert EnoPost.status_published.count.or_panic == 1
assert EnoPost.not_status_published.count.or_panic == 2
assert EnoPost.not_status_draft.map { |record| record.title.as(String) }.or_panic.sorted == ["b", "c"]

# it: omits scopes with scopes: false
clear_records
assert !EnoPost.responds_to?(:draft_vis)
assert !EnoPost.responds_to?(:not_draft_vis)
assert EnoPost.responds_to?(:status_draft)

# it: persists a bang setter on a saved record and validates
clear_records
post = EnoPost.create_strict(title: "p").or_panic
assert post.status_published_strict.or_panic == EnoPost::Status::Published
assert EnoPost.find_strict(post.id).or_panic.status == EnoPost::Status::Published
assert !post.status_changed?

# it: runs validations in the persisting bang setter
clear_records
strict = EnoStrict.create_strict(mode: :on).or_panic
strict.mode = nil
assert strict.save_strict.is_a?(RecordInvalid)

# it: raises from the persisting bang setter when validation fails
clear_records
guarded = EnoGuarded.create_strict(title: "ok").or_panic
guarded.title = ""
assert guarded.closed_strict.is_a?(RecordInvalid)
assert EnoGuarded.find_strict(guarded.id).or_panic.stage == EnoGuarded::Stage::Open

# it: inserts a new record, like update! does
clear_records
post = EnoPost.new(title: "n")
post.status_archived_strict.or_panic
assert post.status == EnoPost::Status::Archived
assert !post.new_record?
assert EnoPost.find_strict(post.id).or_panic.status == EnoPost::Status::Archived

# it: assigns in memory with assign_<member>
clear_records
post = EnoPost.create_strict(title: "m").or_panic
assert post.assign_status_published == EnoPost::Status::Published
assert post.status == EnoPost::Status::Published
assert EnoPost.find_strict(post.id).or_panic.status == EnoPost::Status::Draft
assert post.status_changed?

# it: looks values up by name and symbol in where and find_by
clear_records
EnoPost.create_strict(title: "x", status: :published).or_panic
EnoPost.create_strict(title: "y", status: :draft).or_panic
assert EnoPost.where(status: "published").count.or_panic == 1
assert EnoPost.where(status: :published).count.or_panic == 1
assert EnoPost.where(status: EnoPost::Status::Published).count.or_panic == 1
found = EnoPost.find_by(status: "published").or_panic
assert (found.nil? ? nil : found.title) == "x"
assert EnoPost.where(status: ["published", "draft"]).count.or_panic == 2

# it: coerces names to integer storage
clear_records
EnoPost.create_strict(title: "lv", level: :high).or_panic
assert EnoPost.where(level: "high").count.or_panic == 1
assert EnoPost.where(level: "low").count.or_panic == 0

# it: exposes the name-to-value mapping
clear_records
assert same_mapping?(EnoPost.status_mapping, {"draft" => EnoPost::Status::Draft, "published" => EnoPost::Status::Published, "archived" => EnoPost::Status::Archived})
assert EnoPost.statuses.values == EnoPost::Status.values

# it: raises for an unknown name without validate:
clear_records
post = EnoPost.new(title: "t")
error = (post.status = "bogus")
assert error.is_a?(UnknownEnumValueError)

# it: reports an unknown name as a validation error with validate:
clear_records
strict = EnoStrict.new
strict.mode = "bogus"
assert !strict.valid?.or_panic
assert strict.errors.map(&.message).join.includes?("mode is not included in the list")
strict.mode = "on"
assert strict.valid?.or_panic

# it: forgets an unknown name once a member is assigned directly
clear_records
strict = EnoStrict.new
strict.mode = "bogus"
assert !strict.valid?.or_panic
strict.mode = EnoStrict::Mode::Off
assert strict.valid?.or_panic

# it: requires a value with validate: true and allows nil with allow_nil
clear_records
assert !EnoStrict.new.valid?.or_panic
assert EnoPost.new(title: "t").valid?.or_panic
