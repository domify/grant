module test/grant_schema_environment_protection_test
import grant/schema/migration_context::{MigrationContext}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError, EnvironmentMismatchError}
import test/m03_fixture
import test/m03_fixture::{M03CreateUsers}
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections

# it: records the environment the first time migrations run
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, verbose: false, environment: "development")
context.migrate.or_panic
metadata = InternalMetadata.new(::Test::M03Fixture.adapter)
assert metadata.environment.or_panic == "development"
assert ::Test::M03Fixture.table?("ar_internal_metadata")
other = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, verbose: false, environment: "test")
other.migrate.or_panic
assert metadata.environment.or_panic == "development"

# it: stores other keys and updates them in place
::Test::M03Fixture.reset_in_place
metadata = InternalMetadata.new(::Test::M03Fixture.adapter)
assert metadata["schema_sha1"].or_panic.nil?
metadata.[]=("schema_sha1", "abc").or_panic
metadata.[]=("schema_sha1", "def").or_panic
assert metadata["schema_sha1"].or_panic == "def"

# it: blocks destructive work against a protected environment
::Test::M03Fixture.reset_in_place
metadata = InternalMetadata.new(::Test::M03Fixture.adapter)
metadata.record_environment("production").or_panic
error = metadata.check_protected_environments_strict("production")
assert error.is_a?(ProtectedEnvironmentError)
assert error.as(ProtectedEnvironmentError).environment == "production"
assert metadata.check_protected_environments_strict("development").is_a?(ProtectedEnvironmentError)
metadata.check_protected_environments_strict("production", force: true).or_panic
metadata.check_protected_environments_strict("production", protected_environments: ["prod"]).or_panic

# it: flags a database that belongs to another environment
::Test::M03Fixture.reset_in_place
metadata = InternalMetadata.new(::Test::M03Fixture.adapter)
metadata.record_environment("development").or_panic
metadata.check_protected_environments_strict("development").or_panic
error = metadata.check_protected_environments_strict("test")
assert error.is_a?(EnvironmentMismatchError)
assert error.as(EnvironmentMismatchError).message.to_s.includes?("development")

# it: protects a database with no recorded environment by the environment asked for
::Test::M03Fixture.reset_in_place
metadata = InternalMetadata.new(::Test::M03Fixture.adapter)
assert metadata.environment.or_panic.nil?
assert metadata.check_protected_environments_strict("production").is_a?(ProtectedEnvironmentError)
metadata.check_protected_environments_strict("development").or_panic
::Test::M03Fixture.reset_in_place
