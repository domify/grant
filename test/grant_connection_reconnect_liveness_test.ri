module test/grant_connection_reconnect_liveness_test
import grant/adapter/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{NoDatabaseError, ConnectionFailed}
import test/pool_spec_support::{C02Support}
import test/spec_helper::{CURRENT_ADAPTER}

private def pooled_adapter : Base
  C02Support.establish("c02_reconnect", :writing)
end

# it: answers active? and verify! for a reachable database
adapter = pooled_adapter
assert adapter.active?
adapter.verify_strict.or_panic
ConnectionRegistry.remove_connection("c02_reconnect", :writing).or_panic

# it: raises Grant::ConnectionFailed from verify! and answers false from active? when unreachable
adapter = C02Support.new_adapter("c02_unreachable", C02Support.unreachable_url)
adapter.retry_attempts = 0
assert !adapter.active?
# SQLite has no server to refuse: a file in a missing directory is a missing database.
if CURRENT_ADAPTER == "sqlite"
  assert adapter.verify_strict.is_a?(NoDatabaseError)
else
  assert adapter.verify_strict.is_a?(ConnectionFailed)
end

# it: reconnect! replaces the pool and the old one is closed
adapter = pooled_adapter
adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic
old_pool = adapter.database.or_panic
adapter.reconnect_strict.or_panic
assert old_pool.pool.stats.open_connections == 0
assert adapter.database.or_panic.object_id != old_pool.object_id
assert adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic == 1
ConnectionRegistry.remove_connection("c02_reconnect", :writing).or_panic
C02Support.cleanup
