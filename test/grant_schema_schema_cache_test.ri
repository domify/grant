module test/grant_schema_schema_cache_test

import grant/base::{Base}
import grant/adapter/base
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import grant/schema/introspection::{CacheFileError}
import grant/schema/column_info::{ColumnInfo, IndexInfo, ForeignKeyInfo}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{ADAPTER_URL, register_spec_connections, restore_default_spec_connections}
import std/file::{File}
import std/text
import std/regex

pub class M01Note < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_notes
  column id : Int64, primary: true
  column title : String
end

@@m01_calls = {} of UInt64 => Array(String)

pub def record_call(id : UInt64, call : String) : Nil
  @@m01_calls[id] = [] of String unless @@m01_calls.has_key?(id)
  @@m01_calls[id] << call
  nil
end

pub class M01CountingPg < Pg
  def catalog_tables(namespace : String? = nil) : Array(String) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "tables")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).tables
  end
  def catalog_columns(table : String? = nil, namespace : String? = nil) : Array(ColumnInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "columns:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).columns(table)
  end
  def catalog_indexes(table : String? = nil, namespace : String? = nil) : Array(IndexInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "indexes:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).indexes(table)
  end
  def catalog_foreign_keys(table : String? = nil, namespace : String? = nil) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "foreign_keys:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).foreign_keys(table)
  end
end
pub class M01CountingSqlite < Sqlite
  def catalog_tables(namespace : String? = nil) : Array(String) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "tables")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).tables
  end
  def catalog_columns(table : String? = nil, namespace : String? = nil) : Array(ColumnInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "columns:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).columns(table)
  end
  def catalog_indexes(table : String? = nil, namespace : String? = nil) : Array(IndexInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "indexes:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).indexes(table)
  end
  def catalog_foreign_keys(table : String? = nil, namespace : String? = nil) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
    ::Test::GrantSchemaSchemaCacheTest.record_call(object_id, "foreign_keys:#{table}")
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).foreign_keys(table)
  end
end
pub alias M01CountingAdapter = M01CountingPg | M01CountingSqlite
private def counting_adapter : M01CountingAdapter
  ::Test::SpecHelper::CURRENT_ADAPTER == "pg" ? M01CountingPg.new(name: "m01_counting", url: ADAPTER_URL) : M01CountingSqlite.new(name: "m01_counting", url: ADAPTER_URL)
end

private def counting_calls(adapter : M01CountingAdapter) : Array(String)
  @@m01_calls[adapter.object_id]? || [] of String
end

register_spec_connections
restore_default_spec_connections
::Test::SchemaFixture.create_in_place

# it: loads each kind of catalog data with one query for every table
adapter = counting_adapter
schema = adapter.schema
schema.columns(:m01_authors).or_panic
schema.columns(:m01_posts).or_panic
schema.columns(:m01_memberships).or_panic
schema.indexes(:m01_authors).or_panic
schema.indexes(:m01_posts).or_panic
schema.foreign_keys(:m01_posts).or_panic
schema.foreign_keys(:m01_memberships).or_panic
schema.table_exists?(:m01_posts).or_panic
assert counting_calls(adapter).sorted == ["columns:", "foreign_keys:", "indexes:", "tables"]

# it: does not touch the catalog again on repeated reads
adapter = counting_adapter
schema = adapter.schema
schema.columns(:m01_posts).or_panic
schema.indexes(:m01_posts).or_panic
schema.foreign_keys(:m01_posts).or_panic
before = counting_calls(adapter).size
5.times do
  schema.columns(:m01_posts).or_panic
  schema.indexes(:m01_posts).or_panic
  schema.foreign_keys(:m01_posts).or_panic
  schema.tables.or_panic
  schema.primary_key(:m01_posts).or_panic
end
assert counting_calls(adapter).size == before

# it: makes the next read query everything again
adapter = counting_adapter
schema = adapter.schema
schema.columns(:m01_authors).or_panic
counting_calls(adapter).clear
schema.reset_in_place
schema.columns(:m01_authors).or_panic
assert counting_calls(adapter).includes?("columns:")

# it: re-reads only the reset table
adapter = counting_adapter
schema = adapter.schema
schema.columns(:m01_authors).or_panic
schema.columns(:m01_posts).or_panic
counting_calls(adapter).clear
schema.reset_in_place(:m01_posts)
schema.columns(:m01_authors).or_panic
assert !counting_calls(adapter).includes?("columns:m01_authors")
assert schema.columns(:m01_posts).or_panic.map { |column| column.name } == ["id", "author_id", "title", "score"]
assert counting_calls(adapter).select { |call| call.starts_with?("columns") } == ["columns:m01_posts"]

# it: resets the table when Grant::Migrator creates or drops it
schema = ::Test::SchemaFixture.adapter.schema
M01Note.migrator.drop.or_panic
assert !schema.table_exists?(:m01_notes).or_panic
assert !schema.column_exists?(:m01_notes, :title).or_panic
M01Note.migrator.create.or_panic
assert schema.table_exists?(:m01_notes).or_panic
assert schema.columns(:m01_notes).or_panic.map { |column| column.name } == ["id", "title"]
assert M01Note.table_exists?.or_panic
M01Note.migrator.drop.or_panic
assert !schema.table_exists?(:m01_notes).or_panic
assert !M01Note.table_exists?.or_panic

# it: sees raw DDL only after reset!
schema = ::Test::SchemaFixture.adapter.schema
assert !schema.column_exists?(:m01_authors, :nickname).or_panic
::Test::SchemaFixture.exec("ALTER TABLE m01_authors ADD COLUMN nickname VARCHAR(30)").or_panic
assert !schema.column_exists?(:m01_authors, :nickname).or_panic
schema.reset_in_place(:m01_authors)
assert schema.column_exists?(:m01_authors, :nickname).or_panic
::Test::SchemaFixture.create_in_place

# it: round trips the whole catalog through a file without queries
path = "build/m01_schema_cache.json"
source = counting_adapter.schema
source.dump(path).or_panic
assert File.exists?(path)
target_adapter = counting_adapter
target = target_adapter.schema
assert !target.loaded?
target.load(path).or_panic
assert target.loaded?
assert target.tables.or_panic == source.tables.or_panic
assert target.columns(:m01_posts).or_panic == source.columns(:m01_posts).or_panic
assert target.indexes(:m01_posts).or_panic == source.indexes(:m01_posts).or_panic
assert target.foreign_keys(:m01_memberships).or_panic == source.foreign_keys(:m01_memberships).or_panic
assert target.primary_key(:m01_memberships).or_panic == ["author_id", "group_id"]
assert counting_calls(target_adapter).empty?
File.delete(path)

# it: refuses a file from another adapter, another version, or garbage
schema = counting_adapter.schema
schema.dump(path).or_panic
original = File.read(path)
File.write(path, original.gsub(/"adapter":\s*"[^"]+"/, "\"adapter\": \"Other\""))
error = schema.load(path)
assert error.is_a?(CacheFileError)
assert error.as(CacheFileError).message.includes?("Other")
File.write(path, original.gsub(/"version":\s*\d+/, "\"version\": 99"))
error = schema.load(path)
assert error.is_a?(CacheFileError)
assert error.as(CacheFileError).message.includes?("version 99")
File.write(path, "not json")
assert schema.load(path).is_a?(CacheFileError)
assert schema.load("/nonexistent/m01.json").is_a?(CacheFileError)
assert !schema.load?("/nonexistent/m01.json").or_panic
File.delete(path)
::Test::SchemaFixture.drop_in_place
