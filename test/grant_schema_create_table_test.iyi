module test/grant_schema_create_table_test

import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/table_definition::{TableDefinition}
import grant/adapter/schema::{Dialect, InvalidDefinition, UnsupportedOperation}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

# it: creates a default bigint primary key table
sql = ->(dialect : Dialect) do
  RecordingStatements.new(dialect).create_table_statements(:m02a_users) do |t|
    t.string(:name, null: false, limit: 100)
    t.text(:bio)
  end
end
assert sql.call(Dialect::Pg).or_panic == ["CREATE TABLE \"m02a_users\" (\n  \"id\" BIGSERIAL PRIMARY KEY,\n  \"name\" VARCHAR(100) NOT NULL,\n  \"bio\" TEXT\n)"]
assert sql.call(Dialect::Mysql).or_panic == ["CREATE TABLE `m02a_users` (\n  `id` BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,\n  `name` VARCHAR(100) NOT NULL,\n  `bio` TEXT\n)"]
assert sql.call(Dialect::Sqlite).or_panic == ["CREATE TABLE \"m02a_users\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"name\" VARCHAR(100) NOT NULL,\n  \"bio\" TEXT\n)"]

# it: honors if_not_exists and temporary on every dialect
[Dialect::Pg, Dialect::Mysql, Dialect::Sqlite].each do |dialect|
  rec = RecordingStatements.new(dialect)
  text = rec.create_table_statements(:m02a_tmp, id: false, if_not_exists: true, temporary: true) { |t| t.integer(:n) }.or_panic.first
  assert text.starts_with?("CREATE TEMPORARY TABLE IF NOT EXISTS #{dialect.quote("m02a_tmp")} (")
  assert !text.includes?("PRIMARY KEY")
end

# it: drops first on force, cascading on PostgreSQL only
pg = RecordingStatements.new(Dialect::Pg)
assert pg.create_table_statements(:m02a_f, force: :cascade) { |t| t.integer(:n) }.or_panic.first == "DROP TABLE IF EXISTS \"m02a_f\" CASCADE"
lite = RecordingStatements.new(Dialect::Sqlite)
assert lite.create_table_statements(:m02a_f, force: :cascade) { |t| t.integer(:n) }.or_panic.first == "DROP TABLE IF EXISTS \"m02a_f\""
assert lite.create_table_statements(:m02a_f) { |t| t.integer(:n) }.or_panic.size == 1

# it: supports the id types
pg = RecordingStatements.new(Dialect::Pg)
assert pg.create_table_statements(:a, id: :uuid) { nil }.or_panic.first.includes?("\"id\" UUID PRIMARY KEY DEFAULT gen_random_uuid()")
assert pg.create_table_statements(:a, id: :integer, primary_key: :aid) { nil }.or_panic.first.includes?("\"aid\" SERIAL PRIMARY KEY")
my = RecordingStatements.new(Dialect::Mysql)
assert my.create_table_statements(:a, id: :string) { nil }.or_panic.first.includes?("`id` VARCHAR(255) PRIMARY KEY")
assert my.create_table_statements(:a, id: :nope) { nil }.is_a?(InvalidDefinition)

# it: emits table and column comments per dialect
body = ->(t : TableDefinition) { t.string(:name, comment: "Display name") }
assert RecordingStatements.new(Dialect::Pg).create_table_statements(:m02a_c, comment: "People") { |t| body.call(t) }.or_panic == [
  "CREATE TABLE \"m02a_c\" (\n  \"id\" BIGSERIAL PRIMARY KEY,\n  \"name\" VARCHAR\n)",
  "COMMENT ON TABLE \"m02a_c\" IS 'People'",
  "COMMENT ON COLUMN \"m02a_c\".\"name\" IS 'Display name'",
]
assert RecordingStatements.new(Dialect::Mysql).create_table_statements(:m02a_c, comment: "People") { |t| body.call(t) }.or_panic == ["CREATE TABLE `m02a_c` (\n  `id` BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,\n  `name` VARCHAR(255) COMMENT 'Display name'\n) COMMENT='People'"]
assert RecordingStatements.new(Dialect::Sqlite).create_table_statements(:m02a_c, comment: "People") { |t| body.call(t) }.or_panic.size == 1

# it: emits collation, array and raw types
pg = RecordingStatements.new(Dialect::Pg)
text = pg.create_table_statements(:a, id: false) do |t|
  t.string(:n, collation: "C")
  t.text(:tags, array: true)
  t.column(:e, "citext")
end.or_panic.first
assert text == "CREATE TABLE \"a\" (\n  \"n\" VARCHAR COLLATE \"C\",\n  \"tags\" TEXT[],\n  \"e\" citext\n)"
lite = RecordingStatements.new(Dialect::Sqlite)
assert lite.create_table_statements(:a, id: false) { |t| t.string(:n, collation: "NOCASE") }.or_panic.first.includes?("\"n\" VARCHAR(255) COLLATE NOCASE")
assert lite.create_table_statements(:a) { |t| t.text(:tags, array: true) }.is_a?(UnsupportedOperation)

# it: rejects duplicate columns and conflicting defaults
rec = RecordingStatements.new(Dialect::Pg)
error = rec.create_table_statements(:a) do |t|
  t.string(:n)
  t.string(:n)
end
assert error.is_a?(InvalidDefinition)
assert rec.create_table_statements(:a) { |t| t.string(:n, default: "x", default_sql: "lower('x')") }.is_a?(InvalidDefinition)

# it: supports if_exists and cascade
pg = RecordingStatements.new(Dialect::Pg)
assert pg.drop_table_statements(:a, :b, if_exists: true, cascade: true) == ["DROP TABLE IF EXISTS \"a\" CASCADE", "DROP TABLE IF EXISTS \"b\" CASCADE"]
assert RecordingStatements.new(Dialect::Mysql).drop_table_statements(:a) == ["DROP TABLE `a`"]

register_spec_connections
restore_default_spec_connections
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)

# it: creates, forces and drops a real table
statements.drop_table(:m02a_live, if_exists: true).or_panic
statements.create_table(:m02a_live, comment: "Live") do |t|
  t.string(:name, null: false)
  t.timestamps
end.or_panic
assert ::Test::SchemaFixture.adapter.schema.table_exists?(:m02a_live).or_panic
assert statements.create_table(:m02a_live) { |t| t.integer(:n) }.is_a?(ErrorBase)
statements.create_table(:m02a_live, if_not_exists: true) { |t| t.integer(:n) }.or_panic
statements.create_table(:m02a_live, force: true) { |t| t.integer(:n) }.or_panic
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_live).or_panic.map { |column| column.name } == ["id", "n"]
statements.drop_table(:m02a_live).or_panic
assert !::Test::SchemaFixture.adapter.schema.table_exists?(:m02a_live).or_panic
statements.drop_table(:m02a_live, :m02a_live_tmp, if_exists: true).or_panic

# it: creates a join table without an id
statements.create_table(:m02a_live, id: false) do |t|
  t.bigint(:a_id, null: false)
  t.bigint(:b_id, null: false)
end.or_panic
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_live).or_panic.map { |column| column.name } == ["a_id", "b_id"]
assert ::Test::SchemaFixture.adapter.schema.columns(:m02a_live).or_panic.none? { |column| column.primary_key? }
statements.drop_table(:m02a_live, :m02a_live_tmp, if_exists: true).or_panic

# it: creates a temporary table
sql = RecordingStatements.new(statements.dialect).create_table_statements(:m02a_live_tmp, temporary: true) { |t| t.integer(:n) }.or_panic
::Test::SchemaFixture.adapter.open do |db|
  sql.each { |statement| db.exec(statement).or_panic }
  db.exec("INSERT INTO m02a_live_tmp (n) VALUES (1)").or_panic
  assert db.scalar("SELECT COUNT(*) FROM m02a_live_tmp").or_panic == 1
end.or_panic
statements.drop_table(:m02a_live, :m02a_live_tmp, if_exists: true).or_panic
