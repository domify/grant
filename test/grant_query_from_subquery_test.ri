module test/grant_query_from_subquery_test
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import grant/adapter/driver::{Value}
import std/enumerable
import test/query_relation_sql_capture::{capture_sql}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

  pub class FsqRow < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table fsq_rows
    column id : Int64, primary: true
    column label : String
    column score : Int64
    column team : String
  end

  pub class FsqOther < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table fsq_others
    column id : Int64, primary: true
    column label : String
  end

def fsq_labels(relation : Builder(FsqRow)) : Array(String)
  relation.order(:id).select.or_panic.map(&.label.to_s)
end

register_spec_connections
FsqRow.migrator.drop_and_create.or_panic
FsqOther.migrator.drop_and_create.or_panic

def seed_rows : Nil
  FsqRow.clear.or_panic
  FsqOther.clear.or_panic
  FsqRow.create_strict(label: "a", score: 1_i64, team: "red").or_panic
  FsqRow.create_strict(label: "b", score: 5_i64, team: "red").or_panic
  FsqRow.create_strict(label: "c", score: 9_i64, team: "blue").or_panic
  FsqRow.create_strict(label: "d", score: 12_i64, team: "blue").or_panic
  nil
end

# it: selects from the subquery, aliased as the model table by default
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 4))
sql = relation.to_sql
assert sql.includes?("FROM (SELECT")
assert sql.includes?("AS #{FsqRow.quote("fsq_rows")}")
assert fsq_labels(relation) == ["b", "c", "d"]

# it: carries the subquery binds before the outer binds, in order
seed_rows
inner = FsqRow.where("score > ?", 4).where(team: "blue")
relation = FsqRow.from(inner, as: "fsq_rows").where("score < ?", 12)
assembler = relation.assembler
assembler.select
assert assembler.numbered_parameters == [4_i64, "blue", 12_i64] of Value
if CURRENT_ADAPTER == "pg"
  assert relation.to_sql.includes?("$1")
  assert relation.to_sql.includes?("$3")
  assert relation.to_sql.index("$1").as(Int32) < relation.to_sql.index("$2").as(Int32)
  assert relation.to_sql.index("$2").as(Int32) < relation.to_sql.index("$3").as(Int32)
end
assert fsq_labels(relation) == ["c"]

# it: nests a from inside a from without restarting the numbering
seed_rows
innermost = FsqRow.where("score > ?", 1)
middle = FsqRow.from(innermost).where("score < ?", 12)
outer = FsqRow.from(middle).where(team: "red")
assembler = outer.assembler
assembler.select
assert assembler.numbered_parameters == [1_i64, 12_i64, "red"] of Value
assert fsq_labels(outer) == ["b"]

# it: runs one statement, never the subquery on its own
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 4)).where(team: "blue")
statements = capture_sql { assert relation.select.or_panic.size == 2 }
assert statements.size == 1

# it: accepts a relation over another model with an explicit alias
seed_rows
FsqOther.create_strict(label: "z").or_panic
relation = FsqRow.from(FsqOther.select(:id, :label), as: "fsq_rows").select(:id, :label).where("1 = ?", 1)
assert relation.to_sql.includes?("fsq_others")
assert relation.select.or_panic.map(&.label) == ["z"]

# it: snapshots the subquery when from is called
seed_rows
inner = FsqRow.where("score > ?", 4)
relation = FsqRow.from(inner)
inner.where_in_place(team: "red")
assert fsq_labels(relation) == ["b", "c", "d"]

# it: supports the finders and aggregates over the derived table
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 4))
assert relation.count.or_panic == 3_i64
assert relation.exists?.or_panic
assert !relation.where(label: "a").exists?.or_panic
assert relation.sum(:score).or_panic == 26_i64
assert relation.order(:score).first.or_panic.as(FsqRow).label == "b"
assert relation.order(:score).limit(2).count.or_panic == 2_i64
assert relation.pluck(:label).or_panic.flat_map { |row| row }.map(&.to_s).sorted == ["b", "c", "d"]
assert relation.group_by(:team).count.or_panic.to_s.includes?("blue")

# it: supports a select list over the derived table
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 4).select(:id, :label)).select(:id, :label)
assert relation.order(:id).select.or_panic.map(&.label) == ["b", "c", "d"]

# it: uses a SQL string as the source, with binds
seed_rows
relation = FsqRow.from("(SELECT * FROM fsq_rows WHERE score > ?) recent", binds: [4_i64] of Value)
  .where(team: "red")
assert relation.to_sql.includes?("FROM (SELECT * FROM fsq_rows WHERE score >")
assembler = relation.assembler
assembler.select
assert assembler.numbered_parameters == [4_i64, "red"] of Value
assert fsq_labels(relation) == ["b"]

# it: aliases a plain table name
seed_rows
relation = FsqRow.from("fsq_rows", as: "fsq_rows")
assert relation.to_sql.includes?("FROM fsq_rows AS #{FsqRow.quote("fsq_rows")}")
assert relation.count.or_panic == 4_i64

# it: rejects a placeholder count that does not match the binds
seed_rows
error = FsqRow.from("(SELECT * FROM fsq_rows WHERE score > ?) recent").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("placeholder count")

# it: quotes a symbol source
seed_rows
relation = FsqRow.from(:fsq_rows)
assert relation.to_sql.includes?("FROM #{FsqRow.quote("fsq_rows")}")
assert relation.count.or_panic == 4_i64

# it: rejects a source that is not an identifier
seed_rows
error = FsqRow.from(:"fsq_rows; DROP TABLE x").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("not a valid identifier")
error = FsqRow.from(FsqRow.all, as: "x y").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("not a valid identifier")

# it: goes back to the model table and keeps the other clauses
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 100)).where(team: "red")
assert fsq_labels(relation).empty?
restored = relation.unscope(:from)
assert !restored.to_sql.includes?("(SELECT")
assert fsq_labels(restored) == ["a", "b"]

# it: is available as except(:from) and leaves the receiver alone
seed_rows
relation = FsqRow.from(FsqRow.where("score > ?", 100))
assert fsq_labels(relation.except(:from)).size == 4
assert fsq_labels(relation).empty?
assert !relation.only(:where).from_source?

# it: does not change the relation it was called on
seed_rows
base = FsqRow.where(team: "red")
derived = base.from(FsqRow.where("score > ?", 1))
assert !base.from_source?
assert derived.from_source?
assert fsq_labels(base) == ["a", "b"]

# it: takes the source of a merged relation
seed_rows
merged = FsqRow.where(team: "blue").merge(FsqRow.from(FsqRow.where("score > ?", 10)))
assert fsq_labels(merged) == ["d"]

# it: works on the model class
seed_rows
assert fsq_labels(FsqRow.from(FsqRow.where(team: "blue"))) == ["c", "d"]

FsqRow.adapter.close.or_panic
