module test/grant_query_left_outer_joins_test

import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class ::LoAuthor < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table lo_authors
    column id : Int64, primary: true
    column name : String
    has_many :books, class_name: ::LoBook, foreign_key: :lo_author_id
  end

pub class ::LoBook < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table lo_books
    column id : Int64, primary: true
    column title : String
    column lo_author_id : Int64?
    belongs_to :lo_author, class_name: ::LoAuthor, foreign_key: :lo_author_id, optional: true
    has_many :chapters, class_name: ::LoChapter, foreign_key: :lo_book_id
  end

pub class ::LoChapter < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table lo_chapters
    column id : Int64, primary: true
    column heading : String
    column lo_book_id : Int64?
  end

private def prepare_records : Nil
  LoChapter.clear.or_panic
  LoBook.clear.or_panic
  LoAuthor.clear.or_panic
  ada = LoAuthor.create_strict(name: "Ada").or_panic
  LoAuthor.create_strict(name: "Grace").or_panic
  book = LoBook.create_strict(title: "Notes", lo_author_id: ada.id).or_panic
  LoChapter.create_strict(heading: "One", lo_book_id: book.id).or_panic
  nil
end

register_spec_connections
LoAuthor.migrator.drop_and_create.or_panic
LoBook.migrator.drop_and_create.or_panic
LoChapter.migrator.drop_and_create.or_panic

# it: is the same query as left_joins for every form
prepare_records
assert LoAuthor.left_outer_joins(:books).raw_sql == LoAuthor.left_joins(:books).raw_sql
assert LoAuthor.left_outer_joins(books: :chapters).raw_sql == LoAuthor.left_joins(books: :chapters).raw_sql
assert LoAuthor.left_outer_joins("lo_books", on: "lo_books.lo_author_id = lo_authors.id").raw_sql == LoAuthor.left_joins("lo_books", on: "lo_books.lo_author_id = lo_authors.id").raw_sql
assert LoBook.left_outer_joins(:lo_author, as: "writers").raw_sql == LoBook.left_joins(:lo_author, as: "writers").raw_sql


# it: keeps rows that have no match
prepare_records
assert LoAuthor.left_outer_joins(:books).order(:name).select.or_panic.map(&.name) == ["Ada", "Grace"]
assert LoAuthor.joins(:books).select.or_panic.map(&.name) == ["Ada"]


# it: finds the rows without an association, the classic anti-join
prepare_records
assert LoAuthor.left_outer_joins(:books).where("lo_books.id IS NULL").select.or_panic.map(&.name) == ["Grace"]


# it: resolves nested associations
prepare_records
relation = LoAuthor.left_outer_joins(books: :chapters)
assert relation.raw_sql.includes?("LEFT JOIN lo_books ON lo_books.lo_author_id = lo_authors.id")
assert relation.raw_sql.includes?("LEFT JOIN lo_chapters ON lo_chapters.lo_book_id = lo_books.id")
assert relation.where("lo_chapters.id IS NULL").select.or_panic.map(&.name) == ["Grace"]


# it: accepts several associations and a raw fragment
prepare_records
assert LoBook.left_outer_joins(:lo_author, :chapters).raw_sql.includes?("LEFT JOIN lo_chapters")
fragment = "LEFT OUTER JOIN lo_books ON lo_books.lo_author_id = lo_authors.id"
assert LoAuthor.left_outer_joins(fragment).order(:name).select.or_panic.map(&.name) == ["Ada", "Grace"]


# it: de-duplicates a join requested twice
prepare_records
assert LoAuthor.left_outer_joins(:books).left_joins(:books).join_clauses.size == 1


# it: is available on the model class and as a bang form
prepare_records
assert LoAuthor.left_outer_joins(:books).select.or_panic.size == 2
relation = LoAuthor.all
relation.left_outer_joins_in_place(:books)
assert relation.join_clauses.size == 1


# it: does not change the receiver
prepare_records
base = LoAuthor.where(name: "Ada")
base.left_outer_joins(:books)
assert base.join_clauses.empty?
