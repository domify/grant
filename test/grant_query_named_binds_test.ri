module test/grant_query_named_binds_test

import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/sanitization::{rewrite_named_binds, sanitize_sql_array}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts
  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?
end

private def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map { |post| post.title.to_s }
end

private def reset : Nil
  WfPost.clear.or_panic
  WfPost.create_strict(title: "a: b", published: true, score: 1).or_panic
  WfPost.create_strict(title: "plain", published: false, score: 2).or_panic
  WfPost.create_strict(title: "it's :here", published: true, score: 3).or_panic
  WfPost.create_strict(title: "other", published: true, score: 4).or_panic
  nil
end

register_spec_connections
WfPost.migrator.drop_and_create.or_panic

# it: turns :name into ? in placeholder order
reset
sql, values = rewrite_named_binds("score > :min AND score < :max", {min: 1, max: 4}).or_panic
assert sql == "score > ? AND score < ?"
assert values == [1, 4]

# it: binds a name used twice twice
reset
sql, values = rewrite_named_binds("score = :n OR id = :n", {n: 3}).or_panic
assert sql == "score = ? OR id = ?"
assert values == [3, 3]

# it: expands a list to one placeholder per element
reset
sql, values = rewrite_named_binds("id IN (:ids)", {ids: [1, 2, 3]}).or_panic
assert sql == "id IN (?, ?, ?)"
assert values == [1, 2, 3]

# it: turns an empty list into NULL
reset
sql, values = rewrite_named_binds("id IN (:ids)", {ids: [] of Int32}).or_panic
assert sql == "id IN (NULL)"
assert values.empty?

# it: skips ::casts
reset
sql, values = rewrite_named_binds("score::text = :s AND x::int::text = :s", {s: "3"}).or_panic
assert sql == "score::text = ? AND x::int::text = ?"
assert values == ["3", "3"]

# it: skips text inside quotes and comments
reset
sql, values = rewrite_named_binds(
  "title = ':skip' AND note = \"a :b\" AND `c :d` = :real -- and :comment\n AND /* :block */ 1 = 1",
  {real: 1}
).or_panic
assert sql.includes?("':skip'")
assert sql.includes?("\"a :b\"")
assert sql.includes?("`c :d`")
assert sql.includes?("-- and :comment")
assert sql.includes?("/* :block */")
assert sql.includes?("= ?")
assert values == [1]

# it: handles a doubled quote inside a string
reset
sql, values = rewrite_named_binds("title = 'it''s :x' AND id = :id", {id: 7}).or_panic
assert sql == "title = 'it''s :x' AND id = ?"
assert values == [7]

# it: leaves a bare colon alone
reset
sql, _ = rewrite_named_binds("a[1:2] = :v AND t = '12:30'", {v: 1}).or_panic
assert sql == "a[1:2] = ? AND t = '12:30'"

# it: raises for a name with no value
reset
error = rewrite_named_binds("a = :a AND b = :b", {a: 1})
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Missing value for named bind :b")

# it: binds nil
reset
_, values = rewrite_named_binds("a = :a", {a: nil}).or_panic
assert values == [nil]

# it: binds values by name
reset
assert titles(WfPost.where("score > :min AND published = :published", min: 1, published: true)) == ["it's :here", "other"]

# it: works from the model and from a relation, and chains
reset
assert titles(WfPost.where("score >= :min", min: 2).where("score <= :max", max: 3)) == ["plain", "it's :here"]
assert titles(WfPost.where(published: true).where("score >= :min", min: 3)) == ["it's :here", "other"]

# it: keeps literal colons in strings
reset
assert titles(WfPost.where("title = 'a: b' AND score = :s", s: 1)) == ["a: b"]
assert titles(WfPost.where("title = :t", t: "it's :here")) == ["it's :here"]

# it: expands lists
reset
assert titles(WfPost.where("score IN (:scores)", scores: [1, 4])) == ["a: b", "other"]
assert titles(WfPost.where("score IN (:scores)", scores: [] of Int32)) == [] of String

# it: keeps bind order across clauses (numbered on PG)
reset
relation = WfPost.where(published: true).where("score BETWEEN :low AND :high", low: 2, high: 4).where(title: "other")
assert titles(relation) == ["other"]
relation = WfPost.where("score = :a", a: 1).or_where(WfPost.where("score = :b", b: 4))
assert titles(relation) == ["a: b", "other"]

# it: leaves a plain string without binds untouched
reset
assert titles(WfPost.where("title = 'plain'")) == ["plain"]
assert titles(WfPost.where("score > ?", 3)) == ["other"]

# it: raises for a missing value
reset
error = WfPost.where("score > :min AND score < :max", min: 1).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Missing value")

# it: takes a hash of named binds
reset
assert sanitize_sql_array(["a = :a AND b = :b", {a: 1, b: "x"}]).or_panic == "a = 1 AND b = 'x'"
assert sanitize_sql_array(["a::int = :a", {a: 1}]).or_panic == "a::int = 1"

WfPost.adapter.close.or_panic
