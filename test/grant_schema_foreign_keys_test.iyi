module test/grant_schema_foreign_keys_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect, UnsupportedOperation, InvalidDefinition}
import grant/schema/column_info::{ReferentialAction}
import grant/schema/introspection
import grant/error::{ErrorBase}
import grant/adapter/driver::{Value}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections

# it: adds a foreign key with the conventional column, key and name
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_foreign_key_statements(:posts, :users).or_panic == ["ALTER TABLE \"posts\" ADD CONSTRAINT \"fk_posts_user_id\" FOREIGN KEY (\"user_id\") REFERENCES \"users\" (\"id\")"]
assert RecordingStatements.new(Dialect::Mysql).add_foreign_key_statements(:posts, :users, column: :author_id, on_delete: :cascade, on_update: :restrict, name: "fk_a").or_panic == ["ALTER TABLE `posts` ADD CONSTRAINT `fk_a` FOREIGN KEY (`author_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT"]

# it: adds NOT VALID then validates on PostgreSQL, and ignores validate elsewhere
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_foreign_key_statements(:posts, :users, validate: false, deferrable: :deferred).or_panic.first.ends_with?("DEFERRABLE INITIALLY DEFERRED NOT VALID")
assert pg.validate_foreign_key_statements(:posts, :users).or_panic == ["ALTER TABLE \"posts\" VALIDATE CONSTRAINT \"fk_posts_user_id\""]
my = RecordingStatements.new(Dialect::Mysql)
assert !my.add_foreign_key_statements(:posts, :users, validate: false).or_panic.first.includes?("NOT VALID")
assert my.validate_foreign_key_statements(:posts, :users).or_panic.empty?
assert my.add_foreign_key_statements(:posts, :users, deferrable: true).is_a?(UnsupportedOperation)

# it: drops a foreign key per dialect
assert RecordingStatements.new(Dialect::Pg).remove_foreign_key_statements(:posts, :users, if_exists: true).or_panic == ["ALTER TABLE \"posts\" DROP CONSTRAINT IF EXISTS \"fk_posts_user_id\""]
assert RecordingStatements.new(Dialect::Mysql).remove_foreign_key_statements(:posts, name: "fk_x").or_panic == ["ALTER TABLE `posts` DROP FOREIGN KEY `fk_x`"]

# it: declares foreign keys in create_table
rec = RecordingStatements.new(Dialect::Sqlite)
sql = rec.create_table_statements(:posts) do |t|
  t.bigint(:user_id).or_panic
  t.foreign_key(:users, on_delete: :nullify)
end.or_panic
assert sql.first.includes?("CONSTRAINT \"fk_posts_user_id\" FOREIGN KEY (\"user_id\") REFERENCES \"users\" (\"id\") ON DELETE SET NULL")

# it: rejects unknown actions
assert RecordingStatements.new(Dialect::Pg).add_foreign_key_statements(:a, :b, on_delete: :explode).is_a?(InvalidDefinition)

private def setup : AdapterStatements
  statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
  statements.drop_table(:m02b_fk_child, :m02b_fk_parent, if_exists: true).or_panic
  statements.create_table(:m02b_fk_parent) { |t| t.string(:name) }.or_panic
  statements.create_table(:m02b_fk_child) do |t|
    t.bigint(:m02b_fk_parent_id).or_panic
    t.string(:note, null: false, default: "x")
  end.or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_fk_parent (name) VALUES ('p')")
  statements
end
private def cleanup : Nil
  AdapterStatements.new(::Test::SchemaFixture.adapter).drop_table(:m02b_fk_child, :m02b_fk_parent, if_exists: true).or_panic
end
private def scalar(sql : String) : Value
  ::Test::SchemaFixture.adapter.open { |db| db.scalar(sql) }.or_panic
end
schema = ::Test::SchemaFixture.adapter.schema

# it: adds a foreign key with on_delete and reads it back
statements = setup
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, on_delete: :cascade, on_update: :restrict).or_panic
key = schema.foreign_keys(:m02b_fk_child).or_panic.first
assert key.to_table == "m02b_fk_parent"
assert key.columns == ["m02b_fk_parent_id"]
assert key.on_delete == ReferentialAction::Cascade
assert key.on_update == ReferentialAction::Restrict
assert schema.foreign_key_exists?(:m02b_fk_child, :m02b_fk_parent).or_panic
cleanup

# it: enforces the key and cascades the delete
statements = setup
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, on_delete: :cascade).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id) VALUES (1)")
assert ::Test::SchemaFixture.adapter.open { |db| db.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id) VALUES (999)") }.is_a?(ErrorBase)
::Test::SchemaFixture.exec("DELETE FROM m02b_fk_parent WHERE id = 1")
assert scalar("SELECT COUNT(*) FROM m02b_fk_child") == 0
cleanup

# it: keeps rows and other columns through the SQLite rebuild
statements = setup
::Test::SchemaFixture.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id, note) VALUES (1, 'kept')")
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
assert scalar("SELECT note FROM m02b_fk_child") == "kept"
assert schema.columns(:m02b_fk_child).or_panic.map { |info| info.name } == ["id", "m02b_fk_parent_id", "note"]
assert !schema.columns(:m02b_fk_child).or_panic.find { |info| info.name == "note" }.as(::Grant::Schema::ColumnInfo::ColumnInfo).null?
cleanup

# it: adds NOT VALID then validates on PostgreSQL, checks existing rows on MySQL
statements = setup
::Test::SchemaFixture.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id) VALUES (999)")
if CURRENT_ADAPTER == "pg"
  statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, validate: false).or_panic
  assert scalar("SELECT convalidated FROM pg_constraint WHERE conname = 'fk_m02b_fk_child_m02b_fk_parent_id'") == false
  assert statements.validate_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).is_a?(ErrorBase)
  ::Test::SchemaFixture.exec("DELETE FROM m02b_fk_child")
  statements.validate_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
  assert scalar("SELECT convalidated FROM pg_constraint WHERE conname = 'fk_m02b_fk_child_m02b_fk_parent_id'") == true
else
  statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
  assert schema.foreign_keys(:m02b_fk_child).or_panic.size == 1
end
cleanup

# it: removes a foreign key and honors if_exists
statements = setup
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
statements.remove_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
assert schema.foreign_keys(:m02b_fk_child).or_panic.empty?
statements.remove_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, if_exists: true).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id) VALUES (999)")
cleanup

# it: skips an existing foreign key with if_not_exists
statements = setup
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id).or_panic
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, if_not_exists: true).or_panic
assert schema.foreign_keys(:m02b_fk_child).or_panic.size == 1
cleanup

# it: rebuilds a table that other tables reference without losing their rows
statements = setup
statements.add_foreign_key(:m02b_fk_child, :m02b_fk_parent, column: :m02b_fk_parent_id, on_delete: :cascade).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_fk_child (m02b_fk_parent_id) VALUES (1)")
statements.add_check_constraint(:m02b_fk_parent, "length(name) > 0", name: "m02b_fk_parent_name").or_panic
assert scalar("SELECT COUNT(*) FROM m02b_fk_child") == 1
assert schema.foreign_keys(:m02b_fk_child).or_panic.size == 1
cleanup
