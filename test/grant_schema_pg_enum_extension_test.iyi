module test/grant_schema_pg_enum_extension_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/introspection
import grant/adapter/schema::{Dialect, UnsupportedOperation}
import grant/errors::{ErrorBase}
import grant/connections::{Connections}
import test/spec_helper
import std/text
SpecHelper.register_spec_connections
pg = RecordingStatements.new(Dialect::Pg)
# it: creates, alters and drops enums
assert pg.create_enum_statements(:status, ["draft", "published"]).or_panic == ["CREATE TYPE \"status\" AS ENUM ('draft', 'published')"]
assert pg.create_enum_statements(:status, [:a], if_not_exists: true).or_panic.first.includes?("EXCEPTION WHEN duplicate_object")
assert pg.add_enum_value_statements(:status, :archived, after: :published, if_not_exists: true).or_panic == ["ALTER TYPE \"status\" ADD VALUE IF NOT EXISTS 'archived' AFTER 'published'"]
assert pg.rename_enum_value_statements(:status, :draft, :pending).or_panic == ["ALTER TYPE \"status\" RENAME VALUE 'draft' TO 'pending'"]
assert pg.rename_enum_statements(:status, :state).or_panic == ["ALTER TYPE \"status\" RENAME TO \"state\""]
assert pg.drop_enum_statements(:status, if_exists: true).or_panic == ["DROP TYPE IF EXISTS \"status\""]
# it: enables and disables extensions
assert pg.enable_extension_statements("pgcrypto") == ["CREATE EXTENSION IF NOT EXISTS \"pgcrypto\""]
assert pg.disable_extension_statements("pgcrypto") == ["DROP EXTENSION IF EXISTS \"pgcrypto\" CASCADE"]
# it: rejects enums off PostgreSQL and treats extensions as a no-op there
[Dialect::Mysql, Dialect::Sqlite].each do |dialect|
  rec = RecordingStatements.new(dialect)
  assert rec.create_enum_statements(:status, ["a"]).is_a?(UnsupportedOperation)
  assert rec.enable_extension_statements("pgcrypto").empty?
  assert rec.create_table_statements(:t) { |t| t.citext(:email) }.is_a?(UnsupportedOperation)
end
# it: emits the PostgreSQL column types
sql = pg.create_table_statements(:m02b_types, id: false) do |t|
  t.hstore(:attrs)
  t.citext(:email)
  t.inet(:ip)
  t.cidr(:net)
  t.macaddr(:mac)
  t.ltree(:path)
  t.money(:price)
  t.jsonb(:doc)
  t.enum(:state, enum_type: :status)
end.or_panic.first
assert sql == "CREATE TABLE \"m02b_types\" (\n  \"attrs\" hstore,\n  \"email\" citext,\n  \"ip\" inet,\n  \"net\" cidr,\n  \"mac\" macaddr,\n  \"path\" ltree,\n  \"price\" money,\n  \"doc\" JSONB,\n  \"state\" status\n)"
adapter = Connections[SpecHelper::CURRENT_ADAPTER]
statements = AdapterStatements.new(adapter)
schema = adapter.schema
# it: creates an enum, uses it in a table, extends it, and drops it (PostgreSQL)
if SpecHelper::CURRENT_ADAPTER == "pg"
  statements.drop_table(:m02b_en, if_exists: true).or_panic
  statements.drop_enum(:m02b_status, if_exists: true).or_panic
  statements.create_enum(:m02b_status, ["draft", "published"]).or_panic
  statements.create_enum(:m02b_status, ["draft", "published"], if_not_exists: true).or_panic
  assert statements.create_enum(:m02b_status, ["draft"]).is_a?(ErrorBase)
  assert schema.enums.or_panic["m02b_status"] == ["draft", "published"]
  statements.create_table(:m02b_en) { |t| t.enum(:state, enum_type: :m02b_status, default: "draft", null: false) }.or_panic
  adapter.open { |db| db.exec("INSERT INTO m02b_en (state) VALUES ('published')") }.or_panic
  assert adapter.open { |db| db.exec("INSERT INTO m02b_en (state) VALUES ('nonsense')") }.is_a?(ErrorBase)
  statements.add_enum_value(:m02b_status, :archived, after: :published).or_panic
  statements.rename_enum_value(:m02b_status, :draft, :pending).or_panic
  assert schema.enums.or_panic["m02b_status"] == ["pending", "published", "archived"]
  statements.drop_table(:m02b_en).or_panic
  statements.drop_enum(:m02b_status).or_panic
  assert !schema.enums.or_panic.has_key?("m02b_status")
end
# it: enables and disables an extension (PostgreSQL)
if SpecHelper::CURRENT_ADAPTER == "pg"
  statements.disable_extension("btree_gist").or_panic
  assert !schema.extension_enabled?("btree_gist").or_panic
  statements.enable_extension("btree_gist").or_panic
  statements.enable_extension("btree_gist").or_panic
  assert schema.extension_enabled?("btree_gist").or_panic
  statements.disable_extension("btree_gist").or_panic
end
# it: creates columns of the built-in PostgreSQL types (PostgreSQL)
if SpecHelper::CURRENT_ADAPTER == "pg"
  statements.drop_table(:m02b_ty, if_exists: true).or_panic
  statements.create_table(:m02b_ty) do |t|
    t.inet(:ip)
    t.cidr(:net)
    t.macaddr(:mac)
    t.money(:price)
    t.jsonb(:doc)
  end.or_panic
  adapter.open { |db| db.exec("INSERT INTO m02b_ty (ip, net, mac, price, doc) VALUES ('10.0.0.1', '10.0.0.0/8', '08:00:2b:01:02:03', 12.5, '{}')") }.or_panic
  assert schema.columns(:m02b_ty).or_panic.map { |c| c.sql_type } == ["bigint", "inet", "cidr", "macaddr", "money", "jsonb"]
  statements.drop_table(:m02b_ty).or_panic
end
# it: "treats extensions as a no-op where they
# Original description: treats extensions as a no-op where they do not exist
if SpecHelper::CURRENT_ADAPTER != "pg"
  statements.enable_extension("pgcrypto").or_panic
  assert schema.extensions.or_panic.empty?
end
