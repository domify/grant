module test/grant_query_advanced_query_test

import grant/base::{Base}
import grant/query/where_field::{StructuredWhere, RawWhereValues}
import test/query_spec_helper::{same_entries?}
import test/spec_helper::{register_spec_connections}
import std/time::{Time, Span}
import std/regex::{Regex}

pub class AdvancedQueryParent < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table advanced_query_parents

  column id : Int64, primary: true
  column name : String
  column email : String?
  column active : Bool = false
  column locked : Bool = false
  column role : String?
  column deleted_at : Time?
  column confirmed_at : Time?
  column created_at : Time = Time.utc
  column updated_at : Time = Time.utc

  has_many :children, class_name: ::Test::GrantQueryAdvancedQueryTest::AdvancedQueryChild
end

pub class AdvancedQueryChild < Base
  connection {{(env("CURRENT_ADAPTER") || "sqlite").id}}
  table advanced_query_children

  column id : Int64, primary: true
  column parent_id : Int64
  column name : String
  column created_at : Time = Time.utc
  column updated_at : Time = Time.utc

  belongs_to parent : ::Test::GrantQueryAdvancedQueryTest::AdvancedQueryParent
end

register_spec_connections

# it: merges where conditions
query1 = AdvancedQueryParent.where(name: "test")
query2 = AdvancedQueryParent.where(locked: true)

merged = query1.merge(query2)

assert merged.where_fields.size == 2
assert same_entries?([merged.where_fields[0]], [{join: :and, field: "name", operator: :eq, value: "test"}])
assert same_entries?([merged.where_fields[1]], [{join: :and, field: "locked", operator: :eq, value: true}])

# it: appends the other query's order when merging, like ActiveRecord
query1 = AdvancedQueryParent.order(name: :asc)
query2 = AdvancedQueryParent.order(id: :desc)

merged = query1.merge(query2)

assert merged.order_fields.map { |term| term[:field] } == ["name", "id"]

# it: merges group fields without duplicates
query1 = AdvancedQueryParent.where(id: [1, 2, 3]).group_by(:name)
query2 = AdvancedQueryParent.where(id: [1, 2, 3]).group_by(:name).group_by(:locked)

merged = query1.merge(query2)

assert merged.group_fields.size == 2
assert merged.group_fields.map { |f| f[:field] } == ["name", "locked"]

# it: uses other query's limit and offset
query1 = AdvancedQueryParent.limit(10).offset(5)
query2 = AdvancedQueryParent.limit(20).offset(10)

merged = query1.merge(query2)

assert merged.limit == 20
assert merged.offset == 10

# it: creates a copy of the query
original = AdvancedQueryParent.where(name: "test").order(id: :desc).limit(10)
copy = original.dup

# Modify copy
copy = copy.where(locked: true)

# Original should be unchanged
assert original.where_fields.size == 1
assert copy.where_fields.size == 2

# it: provides not_in method
query = AdvancedQueryParent.where.not_in(:id, [1, 2, 3])

assert query.where_fields.size == 1
field = query.where_fields[0]
# Since WhereField is a union type, we need to check which variant we have
case field
when StructuredWhere
  assert field[:field] == "id"
  assert field[:operator] == :nin
  assert field[:value] == [1, 2, 3]
else
  raise "Expected field-based condition but got statement-based"
end

# it: provides like method
query = AdvancedQueryParent.where.like(:name, "%test%")

assert query.where_fields.size == 1
field = query.where_fields[0]
case field
when StructuredWhere
  assert field[:operator] == :like
  assert field[:value] == "%test%"
else
  raise "Expected field-based condition"
end

# it: provides not_like method
query = AdvancedQueryParent.where.not_like(:name, "%spam%")

assert query.where_fields.size == 1
field = query.where_fields[0]
case field
when StructuredWhere
  assert field[:operator] == :nlike
  assert field[:value] == "%spam%"
else
  raise "Expected field-based condition"
end

# it: provides comparison methods
query = AdvancedQueryParent.where.gt(:id, 10).where.lt(:id, 20)

assert query.where_fields.size == 2

field1 = query.where_fields[0]
case field1
when StructuredWhere
  assert field1[:operator] == :gt
  assert field1[:value] == 10
else
  raise "Expected field-based condition"
end

field2 = query.where_fields[1]
case field2
when StructuredWhere
  assert field2[:operator] == :lt
  assert field2[:value] == 20
else
  raise "Expected field-based condition"
end

# it: provides is_null and is_not_null methods
query = AdvancedQueryParent.where.is_null(:deleted_at).where.is_not_null(:confirmed_at)

assert query.where_fields.size == 2

field1 = query.where_fields[0]
case field1
when StructuredWhere
  assert field1[:field] == "deleted_at"
  assert field1[:operator] == :eq
  assert field1[:value].nil?
else
  raise "Expected field-based condition"
end

field2 = query.where_fields[1]
case field2
when StructuredWhere
  assert field2[:field] == "confirmed_at"
  assert field2[:operator] == :neq
  assert field2[:value].nil?
else
  raise "Expected field-based condition"
end

# it: provides between method
query = AdvancedQueryParent.where.between(:id, 10..20)

assert query.where_fields.size == 2

field1 = query.where_fields[0]
case field1
when StructuredWhere
  assert field1[:operator] == :gteq
  assert field1[:value] == 10
else
  raise "Expected field-based condition"
end

field2 = query.where_fields[1]
case field2
when StructuredWhere
  assert field2[:operator] == :lteq
  assert field2[:value] == 20
else
  raise "Expected field-based condition"
end

# it: chains back to regular query methods
query = AdvancedQueryParent.where.gt(:id, 10).order(name: :asc).limit(5)

assert query.where_fields.size == 1
assert query.order_fields.size == 1
assert query.limit == 5

# it: supports subqueries in where conditions
admin_ids = AdvancedQueryParent.where(name: "admin").select(:id)
query = AdvancedQueryChild.where(parent_id: admin_ids)

assert query.where_fields.size == 1
# The subquery should be converted to SQL
field = query.where_fields[0]
case field
when RawWhereValues
  assert field[:stmt].includes?("#{AdvancedQueryChild.quote("parent_id")} IN (SELECT")
  assert field[:values] == ["admin"]
else
  raise "Expected statement-based condition for subquery"
end

# it: supports EXISTS subqueries
subquery = AdvancedQueryChild.where(name: "test")
query = AdvancedQueryParent.where.exists(subquery)

assert query.where_fields.size == 1
field = query.where_fields[0]
case field
when RawWhereValues
  assert !/EXISTS \(SELECT/.find(field[:stmt]).nil?
  assert field[:values] == ["test"]
else
  raise "Expected statement-based condition for EXISTS"
end

# it: supports NOT EXISTS subqueries
subquery = AdvancedQueryChild.where(name: "test")
query = AdvancedQueryParent.where.not_exists(subquery)

assert query.where_fields.size == 1
field = query.where_fields[0]
case field
when RawWhereValues
  assert !/NOT EXISTS \(SELECT/.find(field[:stmt]).nil?
  assert field[:values] == ["test"]
else
  raise "Expected statement-based condition for NOT EXISTS"
end

# it: combines multiple advanced features
# Complex query using multiple features
query = AdvancedQueryParent
  .where(active: true)
  .where.gt(:created_at, (Time.utc - Span.days(7_i64)))
  .where.not_like(:email, "%spam%")
  .or_where(&.where(role: "admin"))
  .not(&.where.is_null(:confirmed_at))
  .order(created_at: :desc)
  .limit(10)

# Should have multiple where conditions
assert query.where_fields.size > 3

# Should have order and limit
assert query.order_fields.size == 1
assert query.limit == 10


# Execute the translated nested-query shapes on the current adapter as well.
AdvancedQueryChild.migrator.drop_and_create.or_panic
AdvancedQueryParent.migrator.drop_and_create.or_panic
admin = AdvancedQueryParent.create_strict(name: "admin").or_panic
AdvancedQueryParent.create_strict(name: "other").or_panic
AdvancedQueryChild.create_strict(parent_id: admin.id, name: "test").or_panic
admin_ids = AdvancedQueryParent.where(name: "admin").select(:id)
assert AdvancedQueryChild.where(parent_id: admin_ids).where(name: "test").count.or_panic == 1
subquery = AdvancedQueryChild.where(name: "test")
assert AdvancedQueryParent.where.exists(subquery).count.or_panic == 2
assert AdvancedQueryParent.where.not_exists(subquery).count.or_panic == 0

invalid_subquery = AdvancedQueryChild.where(unknown_column: "bad")
assert AdvancedQueryParent.where.exists(invalid_subquery).count.is_a?(::Grant::Error::ArgumentError)
