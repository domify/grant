module test/grant_dirty_mutation_detection_test
import test/dirty_family_models::{F01Post, F01Tagged, F01Watched, F01WatchedNamed, F01Prefs, F01PlainPrefs, F01Settings}
import test/spec_helper::{CURRENT_ADAPTER}
import std/enumerable

# Full Hash equality without native tuple-valued Hash comparison bugs.
def same_changes?(actual : Hash(String, Tuple(A, A)), expected : Hash(String, Tuple(B, C))) : Bool forall A, B, C
  return false unless actual.size == expected.size
  expected.each do |name, pair|
    found = actual[name]?
    return false if found.nil? || found[0] != pair[0] || found[1] != pair[1]
  end
  true
end

def same_values?(actual : Hash(String, A), expected : Hash(String, B)) : Bool forall A, B
  return false unless actual.size == expected.size
  expected.each do |name, value|
    return false unless actual.has_key?(name) && actual[name] == value
  end
  true
end

# it: detects an Array edit on a model that has not called detect_mutation
record = F01Tagged.new(tags: ["a"])
assert !record.changed?
record.tags.as(Array(String)) << "b"
assert record.changed?
assert record.tags_changed?
assert F01Tagged.mutation_detected_attributes == ["tags"]

# it: detects an Array edit on a watched column
record = F01Watched.new(title: "t", tags: ["a"])
assert !record.changed?

record.tags.as(Array(String)) << "b"
assert record.changed?
assert record.tags_changed?
assert record.tags_was == ["a"]
assert record.tags_change == {["a"], ["a", "b"]}
assert same_changes?(record.changes_to_save, {"tags" => {["a"], ["a", "b"]}})
assert record.has_changes_to_save?
assert record.attribute_changed?("tags")

# it: is no longer dirty when the edit is undone
record = F01Watched.new(tags: ["a"])
record.tags.as(Array(String)) << "b"
assert record.changed?
record.tags.as(Array(String)).pop
assert !record.changed?

# it: always watches every Array column, whatever detect_mutation names
assert F01WatchedNamed.mutation_detected_attributes == ["tags", "labels"]

record = F01WatchedNamed.new(tags: ["a"], labels: ["x"])
record.labels.as(Array(String)) << "y"
assert record.changed == ["labels"]
record.tags.as(Array(String)) << "b"
assert record.changed.sorted == ["labels", "tags"]

# it: never watches scalar or String columns
watched = F01Watched.mutation_detected_attributes
assert watched == ["tags"]
assert F01Prefs.mutation_detected_attributes == ["_serialized_prefs"]
assert !watched.includes?("id")
assert !watched.includes?("views")
assert !watched.includes?("title")
assert F01Post.mutation_detected_attributes.empty?

# it: keeps the baseline as a copy, so the edit cannot rewrite it
record = F01Watched.new(tags: ["a"])
record.tags.as(Array(String)) << "b"
assert record.tags_in_database == ["a"]
assert same_values?(record.attributes_in_database, {"tags" => ["a"]})

# it: restores an edited Array to a copy of the original
record = F01Watched.new(tags: ["a"])
record.tags.as(Array(String)) << "b"
record.restore_tags_in_place
assert record.tags == ["a"]
assert !record.changed?

record.tags.as(Array(String)) << "c"
assert record.tags_was == ["a"]

# it: reports an edit as a saved change after changes_applied
record = F01Watched.new(tags: ["a"])
record.tags.as(Array(String)) << "b"
record.changes_applied

assert record.saved_change_to_tags == {["a"], ["a", "b"]}
assert !record.changed?
record.tags.as(Array(String)) << "c"
assert record.tags_was == ["a", "b"]

# it: detects an in-place edit of the serialized object
record = F01Prefs.new(title: "t")
record.prefs = F01Settings.new(theme: "light")
record.save_strict.or_panic
assert !record.changed?

record.prefs.as(F01Settings).theme = "dark"
assert record.changed?
assert record.changed == ["_serialized_prefs"]

record.prefs.as(F01Settings).theme = "light"
assert !record.changed?

# it: persists an in-place edit and records it as a saved change
record = F01Prefs.new(title: "t")
record.prefs = F01Settings.new
record.save_strict.or_panic
record.prefs.as(F01Settings).items << "one"
record.save_strict.or_panic

assert record.saved_change_to_attribute?("_serialized_prefs")
assert !record.changed?
assert F01Prefs.find_strict(record.id).or_panic.prefs.as(F01Settings).items == ["one"]

# it: ignores the same edit when the model has not opted in
record = F01PlainPrefs.new
record.prefs = F01Settings.new
record.save_strict.or_panic
record.prefs.as(F01Settings).theme = "dark"
assert !record.changed?

# it: persists an Array edit
if CURRENT_ADAPTER == "pg"
  record = F01Watched.create_strict(title: "t", tags: ["a"]).or_panic
  record.tags.as(Array(String)) << "b"
  record.save_strict.or_panic

  assert record.saved_change_to_tags == {["a"], ["a", "b"]}
  assert F01Watched.find_strict(record.id).or_panic.tags == ["a", "b"]
end

# it: still detects an in-place edit after update_columns
if CURRENT_ADAPTER == "pg"
  record = F01Watched.create_strict(title: "t", tags: ["a"]).or_panic
  record.update_columns(tags: ["a", "b"]).or_panic
  assert !record.changed?

  record.tags.as(Array(String)) << "c"
  assert record.changed?
  assert record.tags_change == {["a", "b"], ["a", "b", "c"]}
end

F01Post.adapter.close.or_panic
