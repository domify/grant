module test/grant_attributes_normalizes_test
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
pub class NrmAccount < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table nrm_accounts

  column id : Int64, primary: true
  column email : String?
  column handle : String?
  column nickname : String?
  column age : Int32?
  column code : String

  normalizes :email, :handle, with: ->(value : String) { value.strip.downcase }
  normalizes :age, with: ->(value : Int32) { value.clamp(0, 150) }
  normalizes :nickname, apply_to_nil: true do |value|
    value.nil? ? "anon" : value.strip
  end
  normalizes :code do |value|
    value.upcase
  end
end


register_spec_connections
id_column = CURRENT_ADAPTER == "pg" ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY AUTOINCREMENT"
NrmAccount.exec("DROP TABLE IF EXISTS nrm_accounts").or_panic
NrmAccount.exec("CREATE TABLE nrm_accounts (id #{id_column}, email VARCHAR(255), handle VARCHAR(255), nickname VARCHAR(255), age INTEGER, code VARCHAR(255) NOT NULL)").or_panic

# it: normalizes several attributes declared in one call
NrmAccount.clear.or_panic
account = NrmAccount.new(email: "  A@B.COM ", handle: " HeLLo ", code: "x")
assert account.email == "a@b.com"
assert account.handle == "hello"

# it: applies a typed proc to non-string columns
NrmAccount.clear.or_panic
account = NrmAccount.new(age: 900, code: "x")
assert account.age == 150

# it: applies in the setter, without validation
NrmAccount.clear.or_panic
account = NrmAccount.new(code: "x")
account.email = "  Q@Z.COM "
assert account.email == "q@z.com"
assert account.email_changed?

# it: does not run for nil unless apply_to_nil is set
NrmAccount.clear.or_panic
account = NrmAccount.new(code: "x")
account.email = nil
assert account.email.nil?
account.nickname = nil
assert account.nickname == "anon"
account.nickname = "  bob "
assert account.nickname == "bob"

# it: normalizes non-nilable columns
NrmAccount.clear.or_panic
assert NrmAccount.new(code: "abc").code == "ABC"

# it: persists the normalized value
NrmAccount.clear.or_panic
account = NrmAccount.create_strict(email: " P@Q.COM ", code: "k").or_panic
assert NrmAccount.find_strict(account.id).or_panic.email == "p@q.com"

# it: skips normalizers when loading from the database
NrmAccount.clear.or_panic
NrmAccount.exec("INSERT INTO nrm_accounts (email, code) VALUES ('  RAW@X.COM ', 'lower')").or_panic
loaded = NrmAccount.first_strict.or_panic
assert loaded.email == "  RAW@X.COM "
assert loaded.code == "lower"
assert !loaded.email_changed?

# it: bypasses nothing on update
NrmAccount.clear.or_panic
account = NrmAccount.create_strict(email: "a@b.com", code: "k").or_panic
account.update_strict(email: " NEW@B.COM ").or_panic
assert NrmAccount.find_strict(account.id).or_panic.email == "new@b.com"

# it: applies the declared normalizer
NrmAccount.clear.or_panic
assert NrmAccount.normalize_value_for(:email, " A@X ") == "a@x"
assert NrmAccount.normalize_value_for("age", 500) == 150

# it: passes through values of undeclared attributes
NrmAccount.clear.or_panic
assert NrmAccount.normalize_value_for(:unknown, " Keep ") == " Keep "
NrmAccount.adapter.close.or_panic
