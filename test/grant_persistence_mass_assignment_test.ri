module test/grant_persistence_mass_assignment_test
import grant/base::{Base}
import grant/error::{ConversionError}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class T6PersistenceRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_persistence_records
  column id : Int64, primary: true
  column name : String?
  column note : String?
  column counter : Int32?
  timestamps
end

register_spec_connections
T6PersistenceRecord.migrator.drop_and_create.or_panic

# it: converts mass-assigned values and tracks valid updates
T6PersistenceRecord.clear.or_panic
record = T6PersistenceRecord.create_strict(name: "before", counter: 1).or_panic
assert record.update(name: "after").or_panic
assert record.previous_changes["name"] == {"before", "after"}
assert record.saved_change_to_attribute?(:name)
assert T6PersistenceRecord.find_strict(record.id).or_panic.name == "after"

# it: reports invalid mass-assigned values as conversion errors
T6PersistenceRecord.clear.or_panic
record = T6PersistenceRecord.new(counter: "not-an-integer")
assert record.errors.any?(ConversionError)
assert !record.persisted?
assert T6PersistenceRecord.count.or_panic == 0
T6PersistenceRecord.adapter.close.or_panic
