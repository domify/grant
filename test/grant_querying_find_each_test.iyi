module test/grant_querying_find_each_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: finds all the records
Parent.clear.or_panic
model_ids = (0...100).map do |i|
  model = Parent.new(name: "role_#{i}")
  model.save.or_panic
  model
end.map(&.id)
found_roles = [] of Int64?
Parent.find_each { |model| found_roles << model.id }.or_panic
assert found_roles.compact.sorted == model_ids.compact

# it: doesnt yield when no records are found
Parent.clear.or_panic
Parent.find_each { raise "did yield" }.or_panic

# it: can start from an offset
Parent.clear.or_panic
created_models = (0...10).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save.or_panic
  model
end.map(&.id)
created_models.shift
created_models.shift
found_models = [] of Int64?
Parent.find_each(offset: 2) { |model| found_models << model.id }.or_panic
assert found_models.compact.sorted == created_models.compact

# it: doesnt obliterate a parameterized query
Parent.clear.or_panic
created_models = (0...10).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save.or_panic
  model
end.map(&.id)
looking_for_ids = (0...5).map { |index| created_models[index] }
found_models = [] of Int64?
Parent.find_each("WHERE id IN(#{looking_for_ids.join(",")})") do |model|
  found_models << model.id
end.or_panic
# Native arrays with different element union types compare unequal; cast each expected ID.
assert found_models.compact == looking_for_ids.map { |id| id.as(Int64) }

# Offsets apply once, even when iteration crosses several keyset pages.
found_models.clear
Parent.find_each(batch_size: 2, offset: 2) { |model| found_models << model.id }.or_panic
assert found_models == (2...10).map { |index| created_models[index] }
Parent.adapter.close.or_panic
