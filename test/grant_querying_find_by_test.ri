module test/grant_querying_find_by_test
import std/regex::{Regex}
import test/transaction_crud_models::{Parent, ReservedWord}
import test/querying_spec_models::{Review, Student}
import grant/querying::{NotFound}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
Review.migrator.drop_and_create.or_panic
Student.migrator.drop_and_create.or_panic
ReservedWord.migrator.drop_and_create.or_panic

# it: finds an object with a string field
Parent.clear.or_panic
name = "robinson"
model = Parent.new(name: name)
assert model.save.or_panic
found = Parent.find_by(name: name).or_panic
if pa = found
  assert pa.id == model.id
else
  assert !pa.nil?
end
found = Parent.find_by_strict(name: name).or_panic
assert found.is_a?(Parent)

# it: works with multiple arguments
Review.clear.or_panic
Review.create(name: "review1", upvotes: 2_i64)
Review.create(name: "review2", upvotes: 0_i64)
expected = Review.create(name: "review3", upvotes: 10_i64)
r = Review.find_by(name: "review3", upvotes: 10).or_panic
if r
  assert r.id == expected.id
else
  assert !r.nil?
end
error = Review.find_by_strict(name: "review1", upvotes: 20)
assert error.is_a?(NotFound)
assert error.as(NotFound).message.matches?(/No .*Review.* found where name = review1 and upvotes = 20/)

# it: finds an object with nil value
Student.clear.or_panic
model = Student.new
assert model.save.or_panic
found = Student.find_by(name: nil).or_panic
if stu = found
  assert stu.id == model.id
else
  assert !stu.nil?
end
found = Student.find_by_strict(name: nil).or_panic
assert found.is_a?(Student)

# it: works with reserved words
Parent.clear.or_panic
value = "robinson"
model = ReservedWord.new
model.all = value
assert model.save.or_panic
found = ReservedWord.find_by(all: value).or_panic
if rw = found
  assert rw.id == model.id
else
  assert !rw.nil?
end
found = ReservedWord.find_by_strict(all: value).or_panic
assert found.id == model.id

# it: finds an object when provided a hash
Parent.clear.or_panic
name = "johnson"
model = Parent.new(name: name)
assert model.save.or_panic
found = Parent.find_by({"name" => name}).or_panic
if pa = found
  assert pa.id == model.id
else
  assert !pa.nil?
end
found = Parent.find_by_strict({"name" => name}).or_panic
assert found.is_a?(Parent)

# it: returns nil or raises if no result
Parent.clear.or_panic
found = Parent.find_by(name: "xxx").or_panic
assert found.nil?
error = Parent.find_by_strict(name: "xxx")
assert error.is_a?(NotFound)
assert error.as(NotFound).message.matches?(/No .*Parent.* found where name = xxx/)

Parent.adapter.close.or_panic
