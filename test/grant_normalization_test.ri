module test/grant_normalization_test
import grant/base::{Base}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
import std/regex
import std/text
pub class NormalizedUser < Base

  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table normalized_users

  column id : Int64, primary: true
  column email : String?
  column phone : String?
  column username : String?
  column website : String?
  column name : String?

  # Simple normalizations
  normalizes :email do |value|
    value.downcase.strip
  end

  normalizes :phone do |value|
    value.gsub(/\D/, "")
  end

  # More complex normalization
  normalizes :username do |value|
    value.downcase.gsub(/[^a-z0-9_]/, "")
  end

  # Conditional normalization
  normalizes :website, if: :website_present? do |value|
    value.starts_with?("http") ? value : "https://#{value}"
  end

  # Trim whitespace from name
  normalizes :name do |value|
    value.strip
  end

  def website_present? : Bool
    value = website
    !value.nil? && !value.empty?
  end
end


register_spec_connections
NormalizedUser.exec("DROP TABLE IF EXISTS normalized_users").or_panic
case CURRENT_ADAPTER
when "sqlite"
  NormalizedUser.exec("CREATE TABLE normalized_users (id INTEGER PRIMARY KEY AUTOINCREMENT, email TEXT, phone TEXT, username TEXT, website TEXT, name TEXT, created_at TEXT, updated_at TEXT)").or_panic
when "pg"
  NormalizedUser.exec("CREATE TABLE normalized_users (id BIGSERIAL PRIMARY KEY, email VARCHAR, phone VARCHAR, username VARCHAR, website VARCHAR, name VARCHAR, created_at TIMESTAMP, updated_at TIMESTAMP)").or_panic
end

# it: normalizes email to lowercase and strips whitespace
user = NormalizedUser.new
user.email = "  JOHN@EXAMPLE.COM  "
user.valid?
assert user.email == "john@example.com"

# it: removes non-digits from phone numbers
user = NormalizedUser.new
user.phone = "(555) 123-4567"
user.valid?
assert user.phone == "5551234567"

# it: normalizes usernames
user = NormalizedUser.new
user.username = "John_Doe!"
user.valid?
assert user.username == "john_doe"

# it: strips whitespace from names
user = NormalizedUser.new
user.name = "  John Doe  "
user.valid?
assert user.name == "John Doe"

# it: adds https:// to websites when condition is met
user = NormalizedUser.new
user.website = "example.com"
user.valid?
assert user.website == "https://example.com"

# it: does not modify websites that already have protocol
user = NormalizedUser.new
user.website = "http://example.com"
user.valid?
assert user.website == "http://example.com"

# it: does not normalize when condition is not met
user = NormalizedUser.new
user.website = nil
user.valid?
assert user.website.nil?

# it: handles nil values gracefully
user = NormalizedUser.new
user.email = nil
user.phone = nil
user.username = nil
user.valid?
assert user.email.nil?
assert user.phone.nil?
assert user.username.nil?

# it: normalizes before saving
user = NormalizedUser.new
user.email = "  TEST@EXAMPLE.COM  "
user.phone = "(123) 456-7890"
user.save.or_panic
assert user.email == "test@example.com"
assert user.phone == "1234567890"
reloaded = NormalizedUser.find_strict(user.id).or_panic
assert reloaded.email == "test@example.com"
assert reloaded.phone == "1234567890"

# it: tracks changes after normalization
user = NormalizedUser.create(email: "old@example.com")
user.email = "  NEW@EXAMPLE.COM  "
user.valid?
assert user.email == "new@example.com"
assert user.email_changed?
assert user.email_was == "old@example.com"

# it: does not mark as changed if normalization returns to original value
user = NormalizedUser.create(email: "test@example.com")
user.email = "  TEST@EXAMPLE.COM  "
assert user.email == "test@example.com"
assert !user.email_changed?
user.valid?
assert !user.email_changed?

# it: marks as changed when normalization actually changes the value
user = NormalizedUser.new
user.email = "  TEST@EXAMPLE.COM  "
assert user.email_changed?
assert user.email_was.nil?
user.valid?
assert user.email == "test@example.com"
assert user.email_changed?
assert user.email_was.nil?
assert user.email_change == {nil, "test@example.com"}

# it: skips normalization when skip_normalization is true
user = NormalizedUser.new
user.email = "  JOHN@EXAMPLE.COM  "
user.valid?(skip_normalization: true)
assert user.email == "john@example.com"

# it: preserves changed status when skipping normalization
user = NormalizedUser.create(email: "test@example.com")
user.email = "  OTHER@EXAMPLE.COM  "
user.valid?(skip_normalization: true)
assert user.email == "other@example.com"
assert user.email_changed?

# it: normalizes on subsequent validation after skipping
user = NormalizedUser.new
user.email = "  JOHN@EXAMPLE.COM  "
user.valid?(skip_normalization: true)
user.valid?
assert user.email == "john@example.com"

# it: skips conditional (if:) normalizers when skip_normalization is true
user = NormalizedUser.new
user.website = "example.com"
user.valid?(skip_normalization: true)
assert user.website == "example.com"
user.valid?
assert user.website == "https://example.com"

# it: does not normalize values loaded from the database
NormalizedUser.exec("INSERT INTO normalized_users (email) VALUES ('  RAW@EXAMPLE.COM  ')").or_panic
loaded = NormalizedUser.where("email LIKE ?", "%RAW@EXAMPLE.COM%").first_strict.or_panic
assert loaded.email == "  RAW@EXAMPLE.COM  "
NormalizedUser.adapter.close.or_panic
