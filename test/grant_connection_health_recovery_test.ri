module test/grant_connection_health_recovery_test
import test/pool_spec_support::{C02Support}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import test/spec_helper::{CURRENT_ADAPTER}
import grant/connection_registry::{ConnectionRegistry}
import grant/health_monitor::{HealthMonitor}
import grant/error::{ErrorBase}
import grant/error_taxonomy::{ConnectionFailed}
import std/time::{Span, Time}

pub class C02FlakyAdapter < Sqlite
  property failing : Bool = false
  property probe_delay : Span = Span.seconds(0_i64)
  getter probes : Int32 = 0

  def ping : Nil | ErrorBase
    @probes += 1
    sleep(probe_delay.total_milliseconds.to_i32).or_panic if probe_delay > Span.seconds(0_i64)
    return ErrorBase.new("connection refused") if failing
    nil
  end
end

pub def flaky_spec(health_check_interval : Span = Span.seconds(30_i64), health_check_timeout : Span = Span.seconds(5_i64)) : ConnectionRegistry::ConnectionSpec
  ConnectionRegistry::ConnectionSpec.new("c02_flaky", C02FlakyAdapter, "sqlite3::memory:", :writing,
    health_check_interval: health_check_interval, health_check_timeout: health_check_timeout)
end

pub def wait_until(timeout : Span, &condition : -> Bool) : Nil
  deadline = Time.monotonic + timeout
  until condition.call
    break if Time.monotonic > deadline
    sleep(10).or_panic
  end
  nil
end

pub def fiber_count : Int32
  count = 0
  fiber = IyiScheduler.first_fiber
  while fiber
    count += 1
    fiber = fiber.next_fiber
  end
  count
end

HealthMonitor.test_mode = true

# it: flips to unhealthy when the probe fails and back when it recovers
adapter = C02FlakyAdapter.new("c02_flaky:writing", "sqlite3::memory:")
monitor = HealthMonitor.new(adapter, flaky_spec)
assert monitor.check_health_now
assert monitor.healthy?
adapter.failing = true
assert !monitor.check_health_now
assert !monitor.healthy?
assert !monitor.status[:healthy]
assert monitor.verify_strict.is_a?(ConnectionFailed)
adapter.failing = false
assert monitor.check_health_now
assert monitor.healthy?
monitor.verify_strict.or_panic
monitor.stop
ConnectionRegistry.clear_all.or_panic

# it: treats a probe that outlives health_check_timeout as unhealthy
adapter = C02FlakyAdapter.new("c02_flaky:writing", "sqlite3::memory:")
adapter.probe_delay = Span.milliseconds(300_i64)
monitor = HealthMonitor.new(adapter, flaky_spec(health_check_timeout: Span.milliseconds(50_i64)))
assert !monitor.check_health_now
assert !monitor.healthy?
monitor.stop
ConnectionRegistry.clear_all.or_panic

# it: leaves no fiber behind after a probe times out and starts no second probe while one is stuck
adapter = C02FlakyAdapter.new("c02_flaky:writing", "sqlite3::memory:")
adapter.probe_delay = Span.milliseconds(250_i64)
monitor = HealthMonitor.new(adapter, flaky_spec(health_check_timeout: Span.milliseconds(30_i64)))
sleep(0).or_panic
baseline = fiber_count
5.times { assert !monitor.check_health_now }
assert adapter.probes == 1
assert fiber_count <= baseline + 1
sleep(400).or_panic
assert fiber_count <= baseline
adapter.probe_delay = Span.seconds(0_i64)
assert monitor.check_health_now
assert adapter.probes == 2
monitor.stop
ConnectionRegistry.clear_all.or_panic

# it: recovers on the background timer and stops probing once stopped
HealthMonitor.test_mode = false
adapter = C02FlakyAdapter.new("c02_flaky:writing", "sqlite3::memory:")
adapter.failing = true
monitor = HealthMonitor.new(adapter, flaky_spec(health_check_interval: Span.milliseconds(20_i64)))
monitor.start
wait_until(Span.seconds(2_i64)) { !monitor.healthy? }
assert !monitor.healthy?
adapter.failing = false
wait_until(Span.seconds(2_i64)) { monitor.healthy? }
assert monitor.healthy?
monitor.stop
probes_at_stop = adapter.probes
sleep(100).or_panic
assert adapter.probes == probes_at_stop
ConnectionRegistry.clear_all.or_panic
HealthMonitor.test_mode = true

# it: routes get_adapter away from an unhealthy connection and back once it recovers
if CURRENT_ADAPTER == "pg"
  ConnectionRegistry.establish_connection(database: "c02_health", adapter: Pg, url: C02Support.url("c02_health"), role: :primary).or_panic
else
  ConnectionRegistry.establish_connection(database: "c02_health", adapter: Sqlite, url: C02Support.url("c02_health"), role: :primary).or_panic
end
ConnectionRegistry.establish_connection(database: "c02_health", adapter: C02FlakyAdapter, url: "sqlite3::memory:", role: :writing).or_panic
flaky = ConnectionRegistry.get_adapter("c02_health", :writing).as(C02FlakyAdapter)
primary = ConnectionRegistry.get_adapter("c02_health", :primary)
assert flaky.object_id != primary.object_id
flaky.failing = true
assert ConnectionRegistry.verify_strict("c02_health", :writing).is_a?(ConnectionFailed)
assert !ConnectionRegistry.health_status.find { |row| row[:key] == "c02_health:writing" }.as(NamedTuple(key: String, healthy: Bool, last_check: Time))[:healthy]
assert ConnectionRegistry.get_adapter("c02_health", :writing).object_id == primary.object_id
flaky.failing = false
ConnectionRegistry.verify_strict("c02_health", :writing).or_panic
assert ConnectionRegistry.get_adapter("c02_health", :writing).object_id == flaky.object_id
ConnectionRegistry.clear_all.or_panic
C02Support.cleanup

# it: reports connected? without raising when the connection is down or missing
ConnectionRegistry.establish_connection(database: "c02_health", adapter: C02FlakyAdapter, url: "sqlite3::memory:", role: :writing).or_panic
flaky = ConnectionRegistry.get_adapter("c02_health", :writing).as(C02FlakyAdapter)
assert ConnectionRegistry.connected?("c02_health", :writing)
flaky.failing = true
assert !ConnectionRegistry.connected?("c02_health", :writing)
assert !ConnectionRegistry.connected?("c02_health", :reading)
ConnectionRegistry.clear_all.or_panic
HealthMonitor.test_mode = true
