module test/grant_encryption_w6b_lazy_decrypt_test
import grant/base::{Base}
import grant/errors::{Rollback}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/encryption
import grant/encryption/context::{UnsupportedTypeError}
import grant/error::{ErrorBase, ArgumentError}
import grant/adapter/sqlite::{Connection, Value}
import std/base64::{Base64}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class W6bLazyUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# Capture the same decrypt log messages at the actual codec boundary. Returned
# errors let the scoped backend and verbosity restore before the result returns.
private def w6b_decrypts(&block : -> T) : Array(String) forall T
  messages = [] of String
  observer = ->(message : String) { messages << message; nil }
  previous = Config.verbose_logging
  Config.verbose_logging = true
  Config.with_operation_observer(observer) { yield }
  Config.verbose_logging = previous
  messages.select { |message| message.starts_with?("decrypt ") }
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "lazy-salt"
register_spec_connections
W6bLazyUser.migrator.drop_and_create.or_panic

# it: applies the ignore_case original through the lazy attribute
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(nickname: "Ada L").or_panic
assert W6bLazyUser.find_strict(user.id).or_panic.nickname.or_panic == "Ada L"
assert W6bLazyUser.where(nickname: "ada l").count.or_panic == 1_i64

# Companion values stay encrypted and loading keeps them sealed until read.
stored = W6bLazyUser.__connection.query("SELECT nickname, original_nickname FROM w6b_lazy_users WHERE id = #{user.id}").or_panic.first
assert stored["nickname"] != "ada l"
assert stored["original_nickname"] != "Ada L"
loaded = W6bLazyUser.find_strict(user.id).or_panic
assert w6b_decrypts { loaded.nickname.or_panic }.size == 1
assert w6b_decrypts { loaded.nickname.or_panic }.empty?
assert !loaded.has_changes_to_save?
(loaded.nickname = "Grace H").or_panic
loaded.save_strict.or_panic
assert loaded.reload.or_panic.nickname.or_panic == "Grace H"
assert W6bLazyUser.where(nickname: "grace h").count.or_panic == 1_i64
(loaded.nickname = nil).or_panic
loaded.save_strict.or_panic
assert loaded.reload.or_panic.nickname.or_panic.nil?
assert loaded.original_nickname.or_panic.nil?

# Old rows without the companion column value fall back to the normalized one.
user = W6bLazyUser.create_strict(nickname: "Ada L").or_panic
W6bLazyUser.__connection.execute("UPDATE w6b_lazy_users SET original_nickname = NULL WHERE id = #{user.id}").or_panic
assert W6bLazyUser.find_strict(user.id).or_panic.nickname.or_panic == "ada l"

# Encrypted comparisons use only operators that make sense on ciphertext.
assert W6bLazyUser.where(:nickname, :in, ["ADA L", "other"]).count.or_panic == 1_i64
assert W6bLazyUser.where(:nickname, :like, "Ad%").count.is_a?(ArgumentError)
assert W6bLazyUser.where(secret: "hush").count.is_a?(ArgumentError)

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
W6bLazyUser.__connection.close.or_panic
