module test/grant_persistence_w6_timestamps_test
import grant/base::{Base}
import grant/timestamps
import std/time::{Time, Span}
import test/spec_helper::{register_spec_connections}

pub class W6Stamped < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_stampeds

  column id : Int64, primary: true
  column title : String?
  timestamps precision: 3
end

pub class W6StampedSeconds < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_stamped_seconds

  column id : Int64, primary: true
  column title : String?
  timestamps precision: 0
end

pub class W6Dated < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_dateds

  column id : Int64, primary: true
  column title : String?
  date_timestamps
end

pub class W6Switch < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_switches

  column id : Int64, primary: true
  column title : String?
  timestamps
end

pub class W6SwitchChild < W6Switch
end

register_spec_connections
W6Stamped.migrator.drop_and_create.or_panic
W6StampedSeconds.migrator.drop_and_create.or_panic
W6Dated.migrator.drop_and_create.or_panic
W6Switch.migrator.drop_and_create.or_panic

def w6_today : Time
local = ::Grant::Timestamps.current_time
Time.utc(local.year, local.month, local.day)
end


# it: truncates stamped values to the declared fractional digits
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Stamped.new(title: "p")
row.set_timestamps(to: Time.utc(2020, 1, 2, 3, 4, 5, nanosecond: 123_456_789))
assert row.created_at.as(Time).nanosecond == 123_000_000
assert row.updated_at.as(Time).nanosecond == 123_000_000

seconds = W6StampedSeconds.new(title: "p")
seconds.set_timestamps(to: Time.utc(2020, 1, 2, 3, 4, 5, nanosecond: 999_999_999))
assert seconds.created_at.as(Time).nanosecond == 0

# it: stores what it stamped, so memory and database agree
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Stamped.create_strict(title: "p").or_panic
stored = W6Stamped.find_strict(row.id).or_panic
assert stored.created_at.as(Time).to_unix_ms == row.created_at.as(Time).to_unix_ms
assert (row.created_at.as(Time).nanosecond % 1_000_000) == 0

# it: applies to touch as well
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Stamped.create_strict(title: "p").or_panic
row.touch(time: Time.utc(2021, 6, 7, 8, 9, 10, nanosecond: 987_654_321)).or_panic
assert row.updated_at.as(Time).nanosecond == 987_000_000

# it: leaves models without precision: at full resolution
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
assert W6Switch.timestamp_precision.nil?
assert W6Stamped.timestamp_precision == 3

# it: stamps the current date at midnight UTC and round-trips it
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Dated.create_strict(title: "d").or_panic
assert row.created_on == w6_today
assert row.updated_on == w6_today

stored = W6Dated.find_strict(row.id).or_panic
assert stored.created_on == w6_today
assert stored.created_on.as(Time).hour == 0

# it: stamps updated_on only on later saves
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Dated.create_strict(title: "d").or_panic
row.set_timestamps(to: Time.utc(2000, 1, 1, 12, 30), mode: :update)
assert row.created_on == w6_today
assert row.updated_on == Time.utc(2000, 1, 1)

# it: touches updated_on with the date of the given time
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Dated.create_strict(title: "d").or_panic
row.touch(time: Time.utc(2020, 5, 6, 7, 8, 9)).or_panic
assert row.updated_on == Time.utc(2020, 5, 6)
assert W6Dated.find_strict(row.id).or_panic.updated_on == Time.utc(2020, 5, 6)

# it: stamps updated_on with a date in the bulk touch
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Dated.create_strict(title: "d").or_panic
assert W6Dated.where(id: row.id).touch_all(time: Time.utc(2022, 3, 4, 5, 6, 7)).or_panic == 1
assert W6Dated.find_strict(row.id).or_panic.updated_on == Time.utc(2022, 3, 4)

# it: uses the shared clock for the bulk touch default
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Dated.create_strict(title: "d").or_panic
stamped = W6Stamped.create_strict(title: "other").or_panic
# Start from an old stamp so the touch changes the row: MySQL counts
# changed rows, not matched ones.
stamped.update_columns(updated_at: Time.utc(2000, 1, 1)).or_panic
assert W6Stamped.touch_all.or_panic == 1
assert (W6Stamped.first_strict.or_panic.updated_at.as(Time) - ::Grant::Timestamps.current_time).total_seconds.abs <= 5.0
assert !row.id.nil?

# it: is a run-time writer, not only a class-body macro
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
W6Switch.record_timestamps = false
assert !W6Switch.record_timestamps?
row = W6Switch.create_strict(title: "off").or_panic
assert row.created_at.nil?
assert row.updated_at.nil?

W6Switch.record_timestamps = true
assert W6Switch.record_timestamps?
assert !W6Switch.create_strict(title: "on").or_panic.created_at.nil?
W6Switch.record_timestamps = true

# it: applies to subclasses and to updates
W6Stamped.clear.or_panic
W6StampedSeconds.clear.or_panic
W6Dated.clear.or_panic
W6Switch.clear.or_panic
row = W6Switch.create_strict(title: "x").or_panic
stamp = row.updated_at

W6Switch.record_timestamps = false
assert !W6SwitchChild.record_timestamps?
sleep 5
row.title = "y"
row.save_strict.or_panic
assert row.updated_at == stamp
W6Switch.record_timestamps = true

W6Stamped.adapter.close.or_panic
