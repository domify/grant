module test/adapter_db_test

import db/db/core
import db/db/core::{TransactionState}
import db/db/errors::{DBError}
import db/db/value::{CustomValue}
import db/db/testing/dummy_driver::{DummyConnection, DummyResultSet}
import std/time::{Time}
import std/slice::{Bytes}
import grant/adapter/driver::{LibraryConnection, Value, Mutation}
import grant/locking::{LockMode}
import grant/errors::{DatabaseError}
import grant/settings::{settings}

pub class TaggedValue < CustomValue
end

pub class Facade < LibraryConnection
  getter native_connection : DummyConnection
  getter path : String = "dummy://"

  def initialize
    @native_connection = DummyConnection.new(::Db::Core::Connection::Options.new)
  end

  def statement_sql(sql : String) : String
    sql
  end

  def translate(error : DBError, operation : String, sql : String? = nil) : DatabaseError
    DatabaseError.new(0, operation, error.message, sql)
  end

  def supports_lock_mode?(mode : LockMode) : Bool
    false
  end

  def lock_clause(mode : LockMode) : String
    ""
  end

  def open_independent : Facade
    Facade.new
  end

  def insert(sql : String, parameters : Array(Value), primary_name : String?) : Mutation | DatabaseError
    execute(sql, parameters)
  end

  def import_records(table_name : String, primary_name : String, fields : Array(String), rows : Array(Array(Value)), update_on_duplicate : Bool = false, columns : Array(String) = [] of String, ignore_on_duplicate : Bool = false) : Nil | DatabaseError
    DatabaseError.new(0, "import", "unused dummy operation")
  end
end

private def leave_query(conn : Facade) : Int32 | DatabaseError
  conn.query("1 2") { |rs| return 9 }
  0
end

conn = Facade.new
rows = conn.query("1,hello 2,NULL").or_panic
assert rows.size == 2
assert rows[0]["c0"] == 1_i64
assert rows[0]["c1"] == "hello"
assert rows[1]["c1"].nil?
assert DummyResultSet.last_result_set.closed?
assert leave_query(conn).or_panic == 9
assert DummyResultSet.last_result_set.closed?
failure = DatabaseError.new(1, "block", "rejected")
assert conn.query("1") { |rs| failure }.object_id == failure.object_id
assert DummyResultSet.last_result_set.closed?
assert conn.scalar("?", [17_i64] of Value).or_panic == 17_i64
mutation = conn.execute("anything").or_panic
assert mutation.changes == 0_i64
assert mutation.last_insert_id == 0_i64
settings.capture_statement_bind_values = true
error = conn.execute("raise", [7_i64] of Value)
assert error.is_a?(DatabaseError)
assert error.as(DatabaseError).sql == "raise"
assert error.as(DatabaseError).binds == ["7"]
settings.capture_statement_bind_values = false

seen = [] of String
conn.query_observer = ->(sql : String) { seen << sql; nil }
materializations = 0
conn.transaction_materializer = -> {
  materializations += 1
  result = conn.execute("inner")
  result.is_a?(DatabaseError) ? result : nil
}
conn.execute("outer").or_panic
assert materializations == 1
assert seen == ["inner", "outer"]
assert conn.last_statement == "outer"
conn.transaction_materializer = nil

assert !conn.in_transaction?
conn.native_connection.transaction_state = TransactionState::InTransaction
assert conn.in_transaction?
conn.native_connection.transaction_state = TransactionState::FailedTransaction
assert conn.in_transaction?
conn.native_connection.transaction_state = TransactionState::Idle
assert !conn.in_transaction?
assert conn.normalize(3_i16).or_panic == 3_i64
assert conn.normalize(2_f32).or_panic == 2_f64
bytes = Bytes.new(3)
bytes[0] = 65_u8
bytes[1] = 0_u8
bytes[2] = 66_u8
assert conn.normalize(bytes).or_panic == "A\0B"
assert conn.normalize(Time.utc(2026, 10, 16)).or_panic == "2026-10-16T00:00:00.000000Z"
assert conn.normalize(18446744073709551615_u64).or_panic == 18446744073709551615_u64
custom = TaggedValue.new
assert conn.normalize(custom).or_panic.as(TaggedValue).object_id == custom.object_id
values = [1_i64, nil] of Value
assert conn.normalize(values).or_panic == values
conn.close.or_panic
assert conn.closed?
assert !conn.in_transaction?
assert conn.execute("anything").is_a?(DatabaseError)
