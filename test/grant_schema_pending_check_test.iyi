module test/grant_schema_pending_check_test
import grant/schema/migration_context::{MigrationContext, PendingMigrationError, check_pending_strict, maintain_test_schema_strict}
import grant/events::{SQL}
import grant/notifications
import test/m03_fixture
import test/m03_fixture::{M03CreateUsers, M03AddAgeToUsers}
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections
adapter = ::Test::M03Fixture.adapter

# it: reports pending migrations without creating any table
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03CreateUsers, M03AddAgeToUsers, verbose: false)
assert context.needs_migration?.or_panic
assert !::Test::M03Fixture.table?("schema_migrations")
error = context.check_pending_strict
assert error.is_a?(PendingMigrationError)
assert error.as(PendingMigrationError).versions == [20240101000001_i64, 20240101000002_i64]
assert error.as(PendingMigrationError).message.to_s.includes?("20240101000001, 20240101000002")
assert check_pending_strict(context).is_a?(PendingMigrationError)

# it: is quiet once everything ran
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03CreateUsers, verbose: false)
context.migrate.or_panic
assert !context.needs_migration?.or_panic
context.check_pending_strict.or_panic
check_pending_strict(context).or_panic

# it: asks for one versions query per check
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03CreateUsers, M03AddAgeToUsers, verbose: false)
context.migrate.or_panic
queries = [] of String
handler = ->(event : SQL) { queries << event.sql; nil }
::Grant::Notifications.subscribed(SQL, handler) { assert !context.needs_migration?.or_panic }
assert queries.count { |sql| sql.includes?("FROM \"schema_migrations\"") || sql.includes?("FROM `schema_migrations`") } == 1

# it: maintains the test schema: migrates by default, or loads the schema the caller gives
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03CreateUsers, verbose: false)
maintain_test_schema_strict(context).or_panic
assert ::Test::M03Fixture.table?("m03_users")
assert !context.needs_migration?.or_panic
::Test::M03Fixture.reset_in_place
loaded = false
fresh = MigrationContext.for(adapter, M03CreateUsers, verbose: false)
assert maintain_test_schema_strict(fresh) { loaded = true }.is_a?(PendingMigrationError)
assert loaded

# it: does nothing when the schema is current
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(adapter, M03CreateUsers, verbose: false)
context.migrate.or_panic
called = false
maintain_test_schema_strict(context) { called = true }.or_panic
assert !called
::Test::M03Fixture.reset_in_place
