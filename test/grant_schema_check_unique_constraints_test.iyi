module test/grant_schema_check_unique_constraints_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect, UnsupportedOperation}
import grant/schema/constraint_catalog::{CheckConstraintInfo}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
import std/text
import std/regex

# it: adds check constraints, NOT VALID on PostgreSQL only
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_check_constraint_statements(:products, "price > 0", name: "price_check", validate: false).or_panic == ["ALTER TABLE \"products\" ADD CONSTRAINT \"price_check\" CHECK (price > 0) NOT VALID"]
assert pg.validate_check_constraint_statements(:products, name: "price_check") == ["ALTER TABLE \"products\" VALIDATE CONSTRAINT \"price_check\""]
my = RecordingStatements.new(Dialect::Mysql)
assert my.add_check_constraint_statements(:products, "price > 0", name: "price_check", validate: false).or_panic == ["ALTER TABLE `products` ADD CONSTRAINT `price_check` CHECK (price > 0)"]
assert my.remove_check_constraint_statements(:products, name: "price_check").or_panic == ["ALTER TABLE `products` DROP CHECK `price_check`"]
assert pg.add_check_constraint_statements(:products, "price > 0").or_panic.first.matches?(/CONSTRAINT "chk_products_[0-9a-f]{8}" CHECK/)

# it: adds and drops unique constraints per dialect
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_unique_constraint_statements(:sections, [:position, :page_id], deferrable: :immediate).or_panic == ["ALTER TABLE \"sections\" ADD CONSTRAINT \"uniq_sections_position_page_id\" UNIQUE (\"position\", \"page_id\") DEFERRABLE INITIALLY IMMEDIATE"]
assert pg.add_unique_constraint_statements(:sections, :position, name: "u", using_index: "idx").or_panic == ["ALTER TABLE \"sections\" ADD CONSTRAINT \"u\" UNIQUE USING INDEX \"idx\""]
assert RecordingStatements.new(Dialect::Mysql).remove_unique_constraint_statements(:sections, name: "u").or_panic == ["ALTER TABLE `sections` DROP INDEX `u`"]
assert pg.remove_unique_constraint_statements(:sections, name: "u").or_panic == ["ALTER TABLE \"sections\" DROP CONSTRAINT \"u\""]
assert RecordingStatements.new(Dialect::Sqlite).add_unique_constraint_statements(:s, :a, deferrable: true).is_a?(UnsupportedOperation)

# it: emits exclusion constraints on PostgreSQL only
pg = RecordingStatements.new(Dialect::Pg)
assert pg.add_exclusion_constraint_statements(:rooms, "tsrange(starts_at, ends_at) WITH &&", using: :gist, name: "no_overlap").or_panic == ["ALTER TABLE \"rooms\" ADD CONSTRAINT \"no_overlap\" EXCLUDE USING gist (tsrange(starts_at, ends_at) WITH &&)"]
assert RecordingStatements.new(Dialect::Mysql).add_exclusion_constraint_statements(:rooms, "x WITH &&").is_a?(UnsupportedOperation)

# it: declares constraints in create_table
sql = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02b_c) do |t|
  t.integer(:qty)
  t.check_constraint("qty >= 0", name: "qty_positive")
  t.unique_constraint(:qty, name: "qty_unique")
end.or_panic.first
assert sql.includes?("CONSTRAINT \"qty_unique\" UNIQUE (\"qty\")")
assert sql.includes?("CONSTRAINT \"qty_positive\" CHECK (qty >= 0)")

register_spec_connections
restore_default_spec_connections
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
schema = ::Test::SchemaFixture.adapter.schema

private def reset(statements : AdapterStatements) : Nil
  statements.drop_table(:m02b_ck, if_exists: true).or_panic
  statements.create_table(:m02b_ck) do |t|
    t.integer(:price)
    t.integer(:page_id)
    t.integer(:position)
  end.or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_ck (price, page_id, position) VALUES (5, 1, 1)").or_panic
end

# it: adds a check constraint, enforces it, and reads it back
reset(statements)
statements.add_check_constraint(:m02b_ck, "price > 0", name: "m02b_price_check").or_panic
assert ::Test::SchemaFixture.exec("INSERT INTO m02b_ck (price) VALUES (0)").is_a?(ErrorBase)
::Test::SchemaFixture.exec("INSERT INTO m02b_ck (price) VALUES (1)").or_panic
info = schema.check_constraints(:m02b_ck).or_panic.find { |check| check.name == "m02b_price_check" }.as(CheckConstraintInfo)
assert info.expression.includes?("price")
assert info.validated?
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: keeps existing rows when adding a check on SQLite and the data otherwise
reset(statements)
statements.add_check_constraint(:m02b_ck, "price > 0", name: "m02b_price_check").or_panic
::Test::SchemaFixture.adapter.open { |db| assert db.scalar("SELECT COUNT(*) FROM m02b_ck").or_panic == 1 }.or_panic
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: removes a check constraint by name and by expression
reset(statements)
statements.add_check_constraint(:m02b_ck, "price > 0", name: "m02b_price_check").or_panic
statements.remove_check_constraint(:m02b_ck, name: "m02b_price_check").or_panic
assert schema.check_constraints(:m02b_ck).or_panic.empty?
::Test::SchemaFixture.exec("INSERT INTO m02b_ck (price) VALUES (0)").or_panic
::Test::SchemaFixture.exec("DELETE FROM m02b_ck WHERE price = 0").or_panic
statements.add_check_constraint(:m02b_ck, "price >= 0").or_panic
statements.remove_check_constraint(:m02b_ck, "price >= 0").or_panic
assert schema.check_constraints(:m02b_ck).or_panic.empty?
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: adds NOT VALID then validates a check on PostgreSQL
reset(statements)
if CURRENT_ADAPTER == "pg"
  ::Test::SchemaFixture.exec("INSERT INTO m02b_ck (price) VALUES (-1)").or_panic
  statements.add_check_constraint(:m02b_ck, "price >= 0", name: "m02b_nv", validate: false).or_panic
  assert !schema.check_constraints(:m02b_ck).or_panic.find { |check| check.name == "m02b_nv" }.as(CheckConstraintInfo).validated?
  assert statements.validate_check_constraint(:m02b_ck, name: "m02b_nv").is_a?(ErrorBase)
  ::Test::SchemaFixture.exec("DELETE FROM m02b_ck WHERE price < 0").or_panic
  statements.validate_check_constraint(:m02b_ck, name: "m02b_nv").or_panic
  assert schema.check_constraints(:m02b_ck).or_panic.find { |check| check.name == "m02b_nv" }.as(CheckConstraintInfo).validated?
end
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: adds a unique constraint, enforces it, reads it back, and removes it
reset(statements)
statements.add_unique_constraint(:m02b_ck, [:position, :page_id], name: "m02b_uniq").or_panic
assert ::Test::SchemaFixture.exec("INSERT INTO m02b_ck (page_id, position) VALUES (1, 1)").is_a?(ErrorBase)
assert schema.unique_constraints(:m02b_ck).or_panic.map { |constraint| constraint.columns } == [["position", "page_id"]]
statements.remove_unique_constraint(:m02b_ck, name: "m02b_uniq").or_panic
assert schema.unique_constraints(:m02b_ck).or_panic.empty?
::Test::SchemaFixture.exec("INSERT INTO m02b_ck (page_id, position) VALUES (1, 1)").or_panic
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: removes a unique constraint by its columns
reset(statements)
statements.add_unique_constraint(:m02b_ck, :position).or_panic
statements.remove_unique_constraint(:m02b_ck, :position).or_panic
assert schema.unique_constraints(:m02b_ck).or_panic.empty?
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: promotes a concurrently built index to a unique constraint on PostgreSQL
reset(statements)
if CURRENT_ADAPTER == "pg"
  statements.add_index(:m02b_ck, :position, unique: true, name: "m02b_pos_idx", algorithm: :concurrently).or_panic
  statements.add_unique_constraint(:m02b_ck, :position, name: "m02b_pos_uniq", using_index: "m02b_pos_idx").or_panic
  assert schema.unique_constraints(:m02b_ck).or_panic.map { |constraint| constraint.name } == ["m02b_pos_uniq"]
end
statements.drop_table(:m02b_ck, if_exists: true).or_panic

# it: adds an exclusion constraint on PostgreSQL
reset(statements)
if CURRENT_ADAPTER == "pg"
  statements.drop_table(:m02b_rooms, if_exists: true).or_panic
  statements.create_table(:m02b_rooms) { |t| t.datetime(:starts_at); t.datetime(:ends_at) }.or_panic
  statements.add_exclusion_constraint(:m02b_rooms, "tsrange(starts_at, ends_at) WITH &&", using: :gist, name: "m02b_no_overlap").or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_rooms (starts_at, ends_at) VALUES ('2026-01-01 10:00', '2026-01-01 12:00')").or_panic
  assert ::Test::SchemaFixture.exec("INSERT INTO m02b_rooms (starts_at, ends_at) VALUES ('2026-01-01 11:00', '2026-01-01 13:00')").is_a?(ErrorBase)
  assert schema.exclusion_constraints(:m02b_rooms).or_panic.map { |constraint| constraint.name } == ["m02b_no_overlap"]
  statements.remove_exclusion_constraint(:m02b_rooms, name: "m02b_no_overlap").or_panic
  ::Test::SchemaFixture.exec("INSERT INTO m02b_rooms (starts_at, ends_at) VALUES ('2026-01-01 11:00', '2026-01-01 13:00')").or_panic
  statements.drop_table(:m02b_rooms).or_panic
end
statements.drop_table(:m02b_ck, if_exists: true).or_panic
