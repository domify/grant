module test/grant_validations_w6_presence_message_test
import grant/base::{Base}
import grant/error
import grant/errors::{RecordInvalid}
import grant/i18n
import grant/validators
import std/set
import std/text
import test/validation_details_support::{same_details?}
import test/spec_helper::{register_spec_connections}

pub class W6PmArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_pm_articles
  column id : Int64, primary: true
  column title : String?
  column summary : String?
  column body : String?
  column tags : String?
  column flagged : Bool?

  validates_presence_of :title, message: ->(record : W6PmArticle, data : ::Grant::Error::Options) { "needs a title (#{record.class.to_s.split("::").last}, #{data.size} options)" }
  validates_presence_of :summary, message: :w6_summary_required
  validates_presence_of :body, message: "is required", on: [:create, :publish]
  validates_presence_of :tags, allow_blank: true
  validates_presence_of :flagged, message: :w6_flag_required, if: ->(record : W6PmArticle) { record.title == "flag" }
end

register_spec_connections
W6PmArticle.migrator.drop_and_create.or_panic

def reset_i18n : Nil
  ::Grant::I18n.translator = ::Grant::I18n::DefaultTranslator.new
  ::Grant::I18n.locale = "en"
  nil
end

# it: accepts a Proc taking the record and the error's options
article = W6PmArticle.new(summary: "s", body: "b")
assert !article.valid?.or_panic
assert article.errors[:title] == ["needs a title (W6PmArticle, 0 options)"]
assert article.errors.first.type == :blank
assert same_details?(article.errors.details["title"], [{:error => :blank}])
reset_i18n

# it: accepts a Symbol that names a translation key
::Grant::I18n.store("errors.messages.w6_summary_required", "must say something")
article = W6PmArticle.new(title: "t", body: "b")
assert !article.valid?.or_panic
assert article.errors[:summary] == ["must say something"]
assert article.errors.full_messages == ["Summary must say something"]
# The error keeps its type: the key only picks the text.
assert article.errors.first.type == :blank
reset_i18n

# it: finds the Symbol key per model and per attribute
::Grant::I18n.store("errors.messages.w6_summary_required", "generic")
::Grant::I18n.store("errors.models.#{::Grant::I18n.model_key(W6PmArticle.to_s)}.attributes.summary.w6_summary_required", "model specific")
article = W6PmArticle.new(title: "t", body: "b")
article.valid?.or_panic
assert article.errors[:summary] == ["model specific"]
reset_i18n

# it: falls back to the invalid message for an unknown Symbol key
article = W6PmArticle.new(title: "t", body: "b")
article.valid?.or_panic
assert article.errors[:summary] == ["is invalid"]
reset_i18n

# it: accepts a String and honors on: contexts
article = W6PmArticle.new(title: "t", summary: "s")
assert !article.valid?.or_panic
assert article.errors[:body] == ["is required"]
assert article.valid?(:update).or_panic
assert !article.valid?(:publish).or_panic
reset_i18n

# it: combines with allow_blank:, if: and a Symbol on a Bool column
article = W6PmArticle.new(title: "flag", summary: "s", body: "b", tags: "")
assert !article.valid?.or_panic
assert article.errors.attribute_names == ["flagged"]
assert article.errors[:flagged] == ["is invalid"]
article.flagged = true
assert article.valid?.or_panic
reset_i18n

# it: persists nothing and raises Grant::RecordInvalid with the generated text
::Grant::I18n.store("errors.messages.w6_summary_required", "must say something")
article = W6PmArticle.new(title: "t", body: "b")
ex = article.save_strict
assert ex.is_a?(RecordInvalid)
invalid = ex.as(RecordInvalid)
assert invalid.message == "Validation failed: Summary must say something"
assert invalid.record.as(W6PmArticle).object_id == article.object_id
assert W6PmArticle.count.or_panic == 0
assert W6PmArticle.create_strict(title: "t", summary: "s", body: "b").or_panic.persisted?
reset_i18n

# it: follows ActiveRecord's blank? without allocating a String for non-Strings
assert ::Grant::Validators.blank?(nil)
assert ::Grant::Validators.blank?("  \n")
assert ::Grant::Validators.blank?(false)
assert !::Grant::Validators.blank?(true)
assert !::Grant::Validators.blank?(0)
assert ::Grant::Validators.blank?([] of Int32)
assert ::Grant::Validators.blank?({} of String => Int32)
assert ::Grant::Validators.blank?(Set(Int32).new)
assert !::Grant::Validators.blank?([1])
assert !::Grant::Validators.blank?(:name)
reset_i18n
W6PmArticle.adapter.close.or_panic
