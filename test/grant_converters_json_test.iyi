module test/grant_converters_json_test
import grant/converters
import test/converter_spec_support::{FieldEmitter, MyType}
import std/json::{Any, JSON}
import std/slice::{Bytes}

# it: should convert an Object into a String
assert Grant::Converters::Json(MyType, String).to_db(MyType.new) == MyType.new.to_json

# it: should convert the RS value into a MyType
rs = FieldEmitter(String).new
rs._set_values([MyType.new.to_json])
assert Grant::Converters::Json(MyType, String).from_rs(rs) == MyType.new

# it: should convert an Object into a String
assert Grant::Converters::Json(MyType, Any).to_db(MyType.new) == MyType.new.to_json

# it: should convert the RS value into a MyType
rs = FieldEmitter(Any).new
rs._set_values([JSON.parse(MyType.new.to_json)])
assert Grant::Converters::Json(MyType, Any).from_rs(rs) == MyType.new

# it: should convert an Object into Bytes
assert Grant::Converters::Json(MyType, Bytes).to_db(MyType.new) == Grant::Converters.text_bytes(MyType.new.to_json)

# it: should convert the RS value into a MyType
values = [123_u8, 34_u8, 110_u8, 97_u8, 109_u8, 101_u8, 34_u8, 58_u8, 34_u8,
          74_u8, 105_u8, 109_u8, 34_u8, 44_u8, 34_u8, 97_u8, 103_u8, 101_u8,
          34_u8, 58_u8, 49_u8, 50_u8, 125_u8]
rs = FieldEmitter(Bytes).new
rs._set_values([Bytes.new(values.size) { |i| values[i] }])
assert Grant::Converters::Json(MyType, Bytes).from_rs(rs) == MyType.new
