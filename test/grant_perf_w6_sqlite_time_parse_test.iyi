module test/grant_perf_w6_sqlite_time_parse_test
import grant/base::{Base}
import grant/adapter/driver::{Value}
import grant/errors::{ErrorBase}
import std/time::{Time}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class W6SqliteStamp < Base
  connection sqlite
  table w6_sqlite_stamps
  column id : Int64, primary: true
  column seen_at : Time?
end

def w6_reference_time(text : String) : Time
  # The native standard parser is the reference for the adapter fast path.
  Time.parse_rfc3339("#{text}Z")
end

def w6_stored_time(text : String) : Time? | ErrorBase
  W6SqliteStamp.clear!
  W6SqliteStamp.adapter.open do |db|
    db.exec("INSERT INTO w6_sqlite_stamps (id, seen_at) VALUES (1, ?)", [text] of Value)
  end.or_panic
  W6SqliteStamp.find_strict(1_i64)!.seen_at
end

register_spec_connections
if CURRENT_ADAPTER == "sqlite"
  W6SqliteStamp.migrator.drop_and_create.or_panic
  # it: "reads #
  [
    "2026-10-01 12:34:56",
    "2026-10-01 12:34:56.1",
    "2026-10-01 12:34:56.123",
    "2026-10-01 12:34:56.123456",
    "2026-10-01 12:34:56.123456789",
    "2026-02-28 23:59:59.999999",
    "2024-02-29 00:00:00",
    "1970-01-01 00:00:00",
    "0001-01-01 00:00:00",
  ].each do |text|
    assert w6_stored_time(text).or_panic == w6_reference_time(text)
  end

  # it: keeps every fractional digit of a nanosecond value
  stored = w6_stored_time("2026-10-01 12:34:56.123456789").or_panic.as(Time)
  assert stored.nanosecond == 123_456_789

  # it: reads a value written by a save back to the same instant
  moment = Time.utc(2026, 3, 4, 5, 6, 7, nanosecond: 891_234_000)
  W6SqliteStamp.clear.or_panic
  saved = W6SqliteStamp.create_strict(seen_at: moment).or_panic
  assert W6SqliteStamp.find_strict(saved.id).or_panic.seen_at == moment

  # it: falls back to the general parser for text the fast path does not own
  assert w6_stored_time("2026-13-45 99:99:99").is_a?(ErrorBase)
  W6SqliteStamp.adapter.close.or_panic
else
  # it: applies to the SQLite adapter only
  assert CURRENT_ADAPTER != "sqlite"
end
