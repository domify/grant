module test/grant_errors_errors_api_test
import grant/base::{Base}
import grant/errors::{Errors}
import grant/error::{Error, ConversionError}
import test/spec_helper::{register_spec_connections}

pub class ErrorsApiArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table errors_api_articles

  column id : Int64, primary: true
  column title : String?
  column body : String?

  validates_presence_of :title
  validates_presence_of :body
end

register_spec_connections

# it: adds an error with field and message
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  assert errors.size == 1
  assert errors.first.field == :name
  assert errors.first.message == "can't be blank"
end

# it: adds errors with string field names
begin
  errors = Errors.new
  errors.add("email", "is invalid")
  assert errors.size == 1
  assert errors.first.field == "email"
end

# it: adds multiple errors for the same field
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  assert errors.size == 2
end

# it: adds error with default empty message
begin
  errors = Errors.new
  errors.add(:name)
  assert errors.size == 1
  assert errors.first.message == ""
end

# it: appends an Error object
begin
  errors = Errors.new
  errors << Error.new(:name, "can't be blank")
  assert errors.size == 1
end

# it: supports chaining multiple pushes
begin
  errors = Errors.new
  errors << Error.new(:name, "can't be blank")
  errors << Error.new(:email, "is invalid")
  assert errors.size == 2
end

# it: returns messages for a field as symbol
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  assert errors[:name] == ["can't be blank", "is too short"]
end

# it: returns messages for a field as string
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert errors["name"] == ["can't be blank"]
end

# it: returns empty array for field with no errors
begin
  errors = Errors.new
  assert errors[:email] == [] of String
end

# it: returns messages matching symbol field stored as string
begin
  errors = Errors.new
  errors.add("name", "can't be blank")
  assert errors[:name] == ["can't be blank"]
end

# it: returns error at index
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")
  assert errors[0].field == :name
  assert errors[1].field == :email
end

# it: returns formatted messages
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  messages = errors.full_messages
  assert messages.includes?("Name can't be blank")
  assert messages.includes?("Email is invalid")
end

# it: returns message without prefix for :base errors
begin
  errors = Errors.new
  errors.add(:base, "Record is invalid")

  assert errors.full_messages == ["Record is invalid"]
end

# it: returns empty array when no errors
begin
  errors = Errors.new
  assert errors.full_messages == [] of String
end

# it: returns full messages for a specific field
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  messages = errors.full_messages_for(:name)
  assert messages.size == 2
  assert messages.includes?("Name can't be blank")
  assert messages.includes?("Name is too short")
end

# it: returns empty array for field with no errors
begin
  errors = Errors.new
  assert errors.full_messages_for(:email) == [] of String
end

# it: returns Error objects for a field
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  name_errors = errors.where(:name)
  assert name_errors.size == 2
  assert name_errors.all? { |e| e.field.to_s == "name" }
end

# it: returns empty array for field with no errors
begin
  errors = Errors.new
  assert errors.where(:email) == [] of Error
end

# it: returns true when error with matching message exists
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert errors.of_type(:name, "can't be blank")
end

# it: returns false when message doesn't match
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert !errors.of_type(:name, "is too short")
end

# it: returns false when field doesn't match
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert !errors.of_type(:email, "can't be blank")
end

# it: returns true when field has errors
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert errors.include?(:name)
end

# it: returns false when field has no errors
begin
  errors = Errors.new
  assert !errors.include?(:name)
end

# it: works with string field
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert errors.include?("name")
end

# it: returns unique field names with errors
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  names = errors.attribute_names
  assert names == ["name", "email"]
end

# it: returns empty array when no errors
begin
  errors = Errors.new
  assert errors.attribute_names == [] of String
end

# it: groups errors by field name
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  grouped = errors.group_by_attribute
  assert grouped.keys == ["name", "email"]
  assert grouped["name"].size == 2
  assert grouped["email"].size == 1
end

# it: returns false for any? when no errors
begin
  errors = Errors.new
  assert !errors.any?
end

# it: returns true for any? when errors exist
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  assert errors.any?
end

# it: returns true for empty? when no errors
begin
  errors = Errors.new
  assert errors.empty?
end

# it: returns false for empty? when errors exist
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  assert !errors.empty?
end

# it: returns number of errors
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  assert errors.size == 2
  assert errors.count == 2
end

# it: returns 0 when no errors
begin
  errors = Errors.new
  assert errors.size == 0
  assert errors.count == 0
end

# it: returns first error
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  assert errors.first.field == :name
  assert errors.first?.as(Error).field == :name
end

# it: returns last error
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  assert errors.last.field == :email
  assert errors.last?.as(Error).field == :email
end

# it: returns nil for first? and last? when empty
begin
  errors = Errors.new
  assert errors.first?.nil?
  assert errors.last?.nil?
end

# it: removes all errors
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  errors.clear
  assert errors.empty?
  assert errors.size == 0
end

# it: returns hash of field names to message arrays
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:name, "is too short")
  errors.add(:email, "is invalid")

  hash = errors.to_hash
  assert hash.keys == ["name", "email"]
  assert hash["name"] == ["can't be blank", "is too short"]
  assert hash["email"] == ["is invalid"]
end

# it: returns empty hash when no errors
begin
  errors = Errors.new
  assert errors.to_hash.to_s == ({} of String => Array(String)).to_s
end

# it: merges errors from another collection
begin
  errors1 = Errors.new
  errors1.add(:name, "can't be blank")

  errors2 = Errors.new
  errors2.add(:email, "is invalid")
  errors2.add(:age, "must be positive")

  errors1.merge_in_place(errors2)
  assert errors1.size == 3
  assert errors1[:name] == ["can't be blank"]
  assert errors1[:email] == ["is invalid"]
  assert errors1[:age] == ["must be positive"]
end

# it: returns a copy of the errors array
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  arr = errors.to_a
  assert arr.size == 2
  assert arr.is_a?(Array(Error))
end

# it: supports iteration with each
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  fields = [] of String
  errors.each { |e| fields << e.field.to_s }
  assert fields == ["name", "email"]
end

# it: supports map
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  fields = errors.map { |e| e.field.to_s }
  assert fields == ["name", "email"]
end

# it: supports select
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  name_errors = errors.select { |e| e.field.to_s == "name" }
  assert name_errors.size == 1
end

# it: serializes errors to JSON
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  json = errors.to_json
  assert json == %({"name":["can't be blank"]})
  assert errors.to_json_list.includes?("\"field\"")
end

# it: returns comma-separated full messages
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")
  errors.add(:email, "is invalid")

  assert errors.to_s == "Name can't be blank, Email is invalid"
end

# it: matches error type using class pattern
begin
  errors = Errors.new
  errors << ConversionError.new(:field, "bad value")

  assert errors.any?(ConversionError)
  assert errors.any?(Error)
end

# it: returns false when no matching type
begin
  errors = Errors.new
  errors.add(:name, "can't be blank")

  assert !errors.any?(ConversionError)
end

# it: model errors is a Grant::Errors instance
begin
  article = ErrorsApiArticle.new
  assert article.errors.is_a?(Errors)
end

# it: errors.add works on model
begin
  article = ErrorsApiArticle.new
  article.errors.add(:base, "Something went wrong")
  assert article.errors.any?
  assert article.errors[:base] == ["Something went wrong"]
end

# it: validation populates errors with rich API
begin
  article = ErrorsApiArticle.new
  article.title = nil
  article.body = nil
  assert !article.valid?.or_panic

  # Rich API
  assert article.errors.include?(:title)
  assert article.errors[:title] == ["can't be blank"]
  assert article.errors.full_messages.size > 0
  assert article.errors.to_hash.keys.size > 0
end

# it: errors.where returns Error objects
begin
  article = ErrorsApiArticle.new
  article.title = nil
  article.body = nil
  assert !article.valid?.or_panic

  title_errors = article.errors.where("title")
  assert title_errors.size == 1
  assert title_errors.first.message == "can't be blank"
end

# it: errors.of_type checks specific error
begin
  article = ErrorsApiArticle.new
  article.title = nil
  assert !article.valid?.or_panic

  assert article.errors.of_type("title", "can't be blank")
  assert !article.errors.of_type("title", "is too short")
end

# it: errors.full_messages_for works with model
begin
  article = ErrorsApiArticle.new
  article.title = nil
  article.body = nil
  assert !article.valid?.or_panic

  messages = article.errors.full_messages_for("title")
  assert messages.size == 1
  assert messages.first.includes?("Title")
end

# it: errors.clear resets validation state
begin
  article = ErrorsApiArticle.new
  article.title = nil
  assert !article.valid?.or_panic
  assert article.errors.any?

  article.errors.clear
  assert article.errors.empty?
end

# it: errors.merge! combines errors from another model
begin
  article1 = ErrorsApiArticle.new
  article1.title = nil
  article1.valid?.or_panic

  article2 = ErrorsApiArticle.new
  article2.body = nil
  article2.title = "valid"
  article2.valid?.or_panic

  article1.errors.merge_in_place(article2.errors)
  assert article1.errors.include?("title")
  assert article1.errors.include?("body")
end

# it: errors.to_hash provides structured access
begin
  article = ErrorsApiArticle.new
  article.title = nil
  article.body = nil
  assert !article.valid?.or_panic

  hash = article.errors.to_hash
  assert hash.has_key?("title")
  assert hash["title"].includes?("can't be blank")
end

# it: backward compatible: errors.each works
begin
  article = ErrorsApiArticle.new
  article.title = nil
  assert !article.valid?.or_panic

  fields = [] of String
  article.errors.each { |e| fields << e.field.to_s }
  assert fields.includes?("title")
end

# it: backward compatible: errors.map works
begin
  article = ErrorsApiArticle.new
  article.title = nil
  assert !article.valid?.or_panic

  fields = article.errors.map { |e| e.field.to_s }
  assert fields.includes?("title")
end

# it: backward compatible: errors << Error.new works
begin
  article = ErrorsApiArticle.new
  article.errors << Error.new(:custom, "custom error")
  assert article.errors.size == 1
  assert article.errors.first.field == :custom
end

# it: backward compatible: errors.first works
begin
  article = ErrorsApiArticle.new
  article.title = nil
  assert !article.valid?.or_panic

  assert article.errors.first.field == "title"
  assert article.errors.first.message == "can't be blank"
end

# it: backward compatible: errors.size works
begin
  article = ErrorsApiArticle.new
  article.title = nil
  article.body = nil
  assert !article.valid?.or_panic

  assert article.errors.size == 2
end
