module test/grant_query_aggregations_typed_test
import grant/base::{Base}
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError}
import std/big::{BigDecimal}
import test/spec_helper::{register_spec_connections}

pub class AtLedger < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table at_ledgers
  column id : Int64, primary: true
  column kind : String
  column cents : Int64
  column ratio : Float64
  column note : String?
end
BEYOND_FLOAT_PRECISION = 9_007_199_254_740_993_i64

def prepare_records : Nil
  AtLedger.clear.or_panic
  AtLedger.create_strict(kind: "a", cents: 10_i64, ratio: 0.5, note: "x").or_panic
  AtLedger.create_strict(kind: "a", cents: 10_i64, ratio: 1.25, note: "x").or_panic
  AtLedger.create_strict(kind: "b", cents: 30_i64, ratio: 2.0, note: nil).or_panic
  nil
end
register_spec_connections
AtLedger.migrator.drop_and_create.or_panic


# it: counts rows with a value for a column
prepare_records
assert AtLedger.count.or_panic == 3_i64
assert AtLedger.all.count(:note).or_panic == 2_i64
assert AtLedger.count(:note).or_panic == 2_i64
assert AtLedger.all.count("note").or_panic == 2_i64

# it: treats :all and * as the plain count
prepare_records
assert AtLedger.all.count(:all).or_panic == 3_i64
assert AtLedger.all.count("*").or_panic == 3_i64

# it: counts distinct values with COUNT(DISTINCT column) in one statement
prepare_records
assert AtLedger.all.count(:cents, distinct: true).or_panic == 2_i64
assert AtLedger.all.count(:note, distinct: true).or_panic == 1_i64
assert AtLedger.count(:cents, distinct: true).or_panic == 2_i64
sql = AtLedger.all.assembler.aggregate_sql("COUNT", "cents", :none, true)
assert sql.includes?("COUNT(DISTINCT")
assert !sql.includes?("FROM (")

# it: counts distinct values for a relation made distinct
prepare_records
assert AtLedger.distinct.count(:cents).or_panic == 2_i64

# it: honors where, limit and offset
prepare_records
assert AtLedger.where(kind: "a").count(:cents).or_panic == 2_i64
assert AtLedger.order(:id).limit(2).count(:note).or_panic == 2_i64
assert AtLedger.order(:id).offset(2).count(:note).or_panic == 0_i64

# it: returns a Hash per group
prepare_records
group_counts = AtLedger.group_records(:kind).count(:note).or_panic.as(Hash(Value, Int64))
# Preserve exact hash equality through its size and every key/value pair.
assert group_counts.size == 2 && group_counts["a"] == 2_i64 && group_counts["b"] == 0_i64

# it: needs a column for distinct
prepare_records
error = AtLedger.all.count(:all, distinct: true)
assert error.is_a?(ArgumentError)
assert error.message.includes?("needs a column") if error.is_a?(ArgumentError)

# it: sums an integer column exactly as Int64
prepare_records
result = AtLedger.sum(:cents).or_panic
assert result.is_a?(Int64)
assert result == 50_i64
assert AtLedger.where(kind: "a").sum(:cents).or_panic == 20_i64

# it: keeps every digit of a BIGINT sum above 2**53
prepare_records
AtLedger.clear.or_panic
AtLedger.create_strict(kind: "big", cents: BEYOND_FLOAT_PRECISION, ratio: 0.0).or_panic
AtLedger.create_strict(kind: "big", cents: BEYOND_FLOAT_PRECISION, ratio: 0.0).or_panic
total = AtLedger.all.sum(:cents).or_panic
assert total.is_a?(Int64)
assert total == BEYOND_FLOAT_PRECISION * 2
# A Float64 sum would have rounded to an even value 2**54 + 2.
assert (BEYOND_FLOAT_PRECISION * 2).to_f64.to_i64 != BEYOND_FLOAT_PRECISION * 2

# it: sums a float column as Float64
prepare_records
result = AtLedger.sum(:ratio).or_panic
assert result.is_a?(Float64)
assert result == 3.75

# it: sums an expression as an exact number
prepare_records
result = AtLedger.all.sum("cents * 2").or_panic
assert result.is_a?(Int64)
assert result == 100_i64

# it: returns the requested type with as:
prepare_records
assert AtLedger.all.sum(:cents, as: Int64).or_panic == 50_i64
assert AtLedger.all.sum(:cents, as: Float64).or_panic == 50.0
decimal = AtLedger.all.sum(:ratio, as: BigDecimal).or_panic
assert decimal.is_a?(BigDecimal)
assert decimal == BigDecimal.new("3.75")
assert AtLedger.all.sum(:cents, as: BigDecimal).or_panic == BigDecimal.new(50)

# it: refuses an Int64 result for a fractional sum
prepare_records
error = AtLedger.all.sum(:ratio, as: Int64)
assert error.is_a?(ArgumentError)
assert error.message.includes?("does not fit Int64") if error.is_a?(ArgumentError)

# it: sums an empty relation to zero of the column's type
prepare_records
empty = AtLedger.where(kind: "nothing")
assert empty.sum(:cents).or_panic == 0_i64
assert empty.sum(:cents).or_panic.is_a?(Int64)
assert empty.sum(:ratio).or_panic == 0.0
assert empty.sum(:ratio).or_panic.is_a?(Float64)
assert AtLedger.none.sum(:cents).or_panic == 0_i64

# it: honors limit, offset, distinct and having
prepare_records
assert AtLedger.order(:id).limit(2).sum(:cents).or_panic == 20_i64
assert AtLedger.order(:id).offset(2).sum(:cents).or_panic == 30_i64
assert AtLedger.distinct.sum(:cents).or_panic == 40_i64

# it: computes them over the relation
prepare_records
assert AtLedger.avg(:cents).or_panic == 50.0 / 3
assert AtLedger.average(:ratio).or_panic == 1.25
assert AtLedger.minimum(:cents).or_panic == 10_i64
assert AtLedger.maximum(:cents).or_panic == 30_i64
assert AtLedger.where(kind: "nothing").avg(:cents).or_panic.nil?
assert AtLedger.where(kind: "nothing").min(:cents).or_panic.nil?

# it: honors limit and offset
prepare_records
assert AtLedger.order(:id).limit(2).avg(:cents).or_panic == 10.0
assert AtLedger.order(:id).offset(2).max(:cents).or_panic == 30_i64
assert AtLedger.order(:id).limit(1).offset(1).min(:cents).or_panic == 10_i64

# it: raises when the class-level scalar is asked of a grouped scope
prepare_records
assert AtLedger.group_records(:kind).sum(:cents).or_panic.is_a?(Hash(Value, Value))
