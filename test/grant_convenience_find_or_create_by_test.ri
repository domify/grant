module test/grant_convenience_find_or_create_by_test
import test/convenience_models::{ConvItem, ConvInitItem, reset_items}
import grant/errors::{RecordInvalid}
import grant/columns::{Type}

reset_items

# it: runs the block only when it creates
ConvItem.clear
calls = 0
first = ConvItem.find_or_create_by(name: "a") { |record| calls += 1; record.status = "new" }.or_panic
assert first.status == "new"
again = ConvItem.find_or_create_by(name: "a") { |_| calls += 1 }.or_panic
assert again.id == first.id
assert calls == 1

# it: raises from the bang form when the create is invalid
ConvItem.clear
assert ConvItem.find_or_create_by_strict(name: "").is_a?(RecordInvalid)

# it: returns the existing record from the bang form
ConvItem.clear
existing = ConvItem.create_strict(name: "a").or_panic
assert ConvItem.find_or_create_by_strict(name: "a").or_panic.id == existing.id
assert ConvItem.count.or_panic == 1

# it: builds without saving in find_or_initialize_by and runs the block
ConvItem.clear
item = ConvItem.find_or_initialize_by(name: "z") { |record| record.kind = "blk" }.or_panic
assert item.new_record?
assert item.kind == "blk"
assert ConvItem.count.or_panic == 0

# it: creates with the equality attributes of the where clause
ConvItem.clear
item = ConvItem.where(status: "active", kind: "k").find_or_create_by(name: "rel").or_panic
assert item.persisted?
assert item.status == "active"
assert item.kind == "k"

# it: finds within the relation only
ConvItem.clear
ConvItem.create_strict(name: "a", status: "other").or_panic
item = ConvItem.where(status: "active").find_or_create_by(name: "z").or_panic
assert item.status == "active"
assert !ConvItem.where(status: "active").find_or_create_by(name: "a").or_panic.persisted?
assert ConvItem.count.or_panic == 2

# it: does not turn ranges, IN lists or other operators into defaults
ConvItem.clear
relation = ConvItem.where(qty: 1..5).where(kind: ["a", "b"]).where(:name, :like, "x%")
assert relation.scope_attributes.empty?
assert relation.find_or_initialize_by(name: "n").or_panic.qty.nil?

# it: lets explicit attributes win over the scope attributes
ConvItem.clear
assert ConvItem.where(status: "active").create(name: "a", status: "explicit").or_panic.status == "explicit"

# it: flows through named scopes
ConvItem.clear
item = ConvItem.drafts.find_or_create_by(name: "scoped").or_panic
assert item.status == "draft"
assert ConvItem.drafts.find_or_create_by(name: "scoped").or_panic.id == item.id

# it: supports the bang, initialize and block forms
ConvItem.clear
relation = ConvItem.where(status: "active")
assert relation.find_or_create_by_strict(name: "b") { |record| record.qty = 4 }.or_panic.qty == 4
built = relation.find_or_initialize_by(name: "c").or_panic
assert built.new_record?
assert built.status == "active"
assert relation.find_or_create_by_strict(name: "").is_a?(RecordInvalid)

# it: exposes first_or_create, first_or_create! and first_or_initialize
ConvItem.clear
relation = ConvItem.where(status: "active")
assert relation.first_or_initialize(name: "x").or_panic.new_record?
created = relation.first_or_create(name: "x").or_panic
assert created.persisted?
assert relation.first_or_create(name: "ignored").or_panic.id == created.id
assert relation.first_or_create_strict(name: "ignored").or_panic.id == created.id
assert ConvItem.where(status: "none").first_or_create_strict(name: "").is_a?(RecordInvalid)

# it: builds through new and build
ConvItem.clear
relation = ConvItem.where(status: "active")
assert relation.build(name: "b").or_panic.status == "active"
assert relation.new(name: "n") { |record| record.qty = 2 }.or_panic.qty == 2
assert relation.create(name: "c").or_panic.persisted?
assert relation.create_strict(name: "d").or_panic.status == "active"

# it: finds, creates and initializes at class level
ConvItem.clear
args = {"name" => "h"} of Symbol | String => Type
created = ConvItem.find_or_create_by(args) { |record| record.kind = "blk" }.or_panic
assert created.persisted?
assert created.kind == "blk"
assert ConvItem.find_or_create_by_strict(args).or_panic.id == created.id
assert ConvItem.find_or_initialize_by({"name" => "new"} of Symbol | String => Type).or_panic.new_record?
assert ConvItem.find_or_create_by_strict({"name" => ""} of Symbol | String => Type).is_a?(RecordInvalid)

# it: runs after_initialize after the scope attributes and the block are applied
ConvInitItem.migrator.drop_and_create.or_panic
built = ConvInitItem.where(status: "live").build(name: "n") { |record| record.status = "blk" }.or_panic
assert built.seen == "n/blk"
assert ConvInitItem.where(status: "live").new(name: "m").or_panic.seen == "m/live"
ConvItem.adapter.close.or_panic
