module test/grant_convenience_class_destroy_update_test
import test/convenience_models::{ConvItem, reset_items, statements}
import grant/querying::{NotFound}

reset_items

# it: destroys one record by id and returns it
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
destroyed = ConvItem.destroy(item.id || raise "missing id").or_panic
assert destroyed.destroyed?
assert ConvItem.count == 0

# it: raises NotFound for a missing id
ConvItem.clear
assert ConvItem.destroy(999_999).is_a?(NotFound)

# it: destroys many with one SELECT, then destroys each record
ConvItem.clear
ids = Array.new(3) { |i| ConvItem.create_strict(name: "n#{i}").or_panic.id || raise "missing id" }
destroyed_records = [] of ConvItem
sql = statements { destroyed_records = ConvItem.destroy(ids).or_panic }
assert sql.count { |s| s.includes?("SELECT") } == 1
assert destroyed_records.map { |r| r.id } == ids
assert destroyed_records.all? { |r| r.destroyed? }
assert ConvItem.count == 0

# it: raises NotFound for the array form when an id is missing, deleting nothing
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
assert ConvItem.destroy([(item.id || raise "missing id"), 999_999_i64]).is_a?(NotFound)
assert ConvItem.count == 1

# it: deletes by id with a count and no callbacks
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
assert ConvItem.delete(item.id || raise "missing id").or_panic == 1
assert ConvItem.delete(item.id || raise "missing id").or_panic == 0

# it: deletes many ids without loading records
ConvItem.clear
ids = Array.new(3) { |i| ConvItem.create_strict(name: "n#{i}").or_panic.id || raise "missing id" }
count = 0_i64
sql = statements { count = ConvItem.delete([ids[0], ids[1]]).or_panic }
assert count == 2
assert sql.count { |s| s.includes?("SELECT") } == 0
assert ConvItem.count == 1

# it: does nothing for an empty list
ConvItem.clear
ConvItem.create_strict(name: "a").or_panic
assert ConvItem.delete([] of Int64).or_panic == 0
assert ConvItem.count == 1

# it: updates one record by id
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
updated = ConvItem.update((item.id || raise "missing id"), status: "done").or_panic
assert updated.status == "done"
assert ConvItem.find_strict(item.id).or_panic.status == "done"

# it: accepts an attributes hash
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
assert ConvItem.update((item.id || raise "missing id"), {"kind" => "hash"}).or_panic.kind == "hash"

# it: updates many ids and returns the records in order
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
b = ConvItem.create_strict(name: "b").or_panic
records = ConvItem.update([(b.id || raise "missing id"), (a.id || raise "missing id")], status: "bulk").or_panic
assert records.map { |r| r.name } == ["b", "a"]
assert ConvItem.where(status: "bulk").count.or_panic == 2

# it: returns the record with errors when validation rejects the change
ConvItem.clear
item = ConvItem.create_strict(name: "a").or_panic
assert !ConvItem.update((item.id || raise "missing id"), name: "").or_panic.errors.empty?
assert ConvItem.find_strict(item.id).or_panic.name == "a"

# it: raises NotFound for a missing id
ConvItem.clear
assert ConvItem.update(999_999, status: "x").is_a?(NotFound)
ConvItem.adapter.close.or_panic
