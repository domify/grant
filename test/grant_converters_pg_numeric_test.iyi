module test/grant_converters_pg_numeric_test
import grant/converters::{PgNumeric}
import pg/pg/numeric::{Numeric}

# The upstream FieldEmitter supplies successive raw values rather than SQL rows.
pub class FieldEmitter
  @position = 0
  @field_position = 0
  @values = [] of Numeric

  def _set_values(values : Array(Numeric)) : Nil
    @values = [] of Numeric
    values.each { |value| @values << value }
    nil
  end

  def move_next : Bool
    @position += 1
    @field_position = 0
    @position < @values.size
  end

  def read : Numeric?
    raise "Overread" if @position >= @values.size
    value = @values[@position]
    @position += 1
    value
  end

  def column_count : Int32
    @values.size
  end

  def column_name(index : Int32) : String
    "Column #{index}"
  end

  def next_column_index : Int32
    @field_position
  end
end

# it: should convert a Float enum into a Float
assert PgNumeric.to_db(3.14) == 3.14

# it: should convert the RS value into a Float64
rs = FieldEmitter.new
rs._set_values([Numeric.new(2_i16, 0_i16, 0_i16, 1_i16, [1_i16, 3000_i16])])
assert PgNumeric.from_rs(rs).or_panic == 1.3

assert PgNumeric.to_db(nil).nil?
assert PgNumeric.from_db(1.3) == 1.3
assert PgNumeric.from_db("1.3").nil?
