module test/validation_details_support

# Native Hash inherits identity equality. Compare every key and typed value instead.
pub def same_details?(actual : Hash(K, A), expected : Hash(K, B)) : Bool forall K, A, B
  return false unless actual.size == expected.size
  expected.each do |key, value|
    return false unless actual.has_key?(key)
    found = actual[key]
    if found.is_a?(Range) && value.is_a?(Range)
      return false unless found.begin == value.begin && found.end == value.end &&
                          found.exclusive? == value.exclusive?
    else
      return false unless found == value
    end
  end
  true
end

pub def same_details?(actual : Array(A), expected : Array(B)) : Bool forall A, B
  return false unless actual.size == expected.size
  actual.each_with_index do |item, index|
    return false unless same_details?(item, expected[index])
  end
  true
end
