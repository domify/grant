module test/grant_connection_management_simple_test
import grant/base::{Base}
import grant/adapter/base
import test/spec_helper::{register_spec_connections}
register_spec_connections

pub class CMTestModel < Base
  connection sqlite
  table cm_test_models
  column id : Int64, primary: true
  column content : String
end

# it: stores the database name
assert CMTestModel.database_name == "sqlite"

# it: marks write operation
CMTestModel.mark_write_operation

# it: temporarily changes database context
original = CMTestModel.database_name
CMTestModel.connected_to(database: "temp_db") do
  assert CMTestModel.database_name == "temp_db"
end
assert CMTestModel.database_name == original

# it: sets and unsets prevent writes flag
assert !CMTestModel.preventing_writes?
CMTestModel.while_preventing_writes do
  assert CMTestModel.preventing_writes?
end
assert !CMTestModel.preventing_writes?

# it: returns an adapter instance
assert CMTestModel.adapter.is_a?(::Grant::Adapter::Base::Base)
