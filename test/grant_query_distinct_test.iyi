module test/grant_query_distinct_test
import test/query_spec_helper::{Model, builder, with_legacy_implicit_order}
import grant/query/builder::{Builder}

with_legacy_implicit_order do

  # it: sets the distinct flag
  query = builder.distinct
  assert query.distinct?

  # it: defaults to non-distinct
  query = builder
  assert !query.distinct?

  # it: returns self for chaining
  query = builder.distinct
  assert query.is_a?(Builder(Model))

  # it: works with where conditions
  query = builder.distinct.where(name: "bob")
  assert query.distinct?
  assert query.where_fields.size == 1

  # it: works with order
  query = builder.distinct.order(name: :asc)
  assert query.distinct?
  assert query.order_fields.size == 1

  # it: works with joins
  query = builder
    .distinct
    .joins("posts", on: "posts.user_id = table.id")
  assert query.distinct?
  assert query.join_clauses.size == 1

  # it: copies distinct flag on dup
  original = builder.distinct
  copy = original.dup
  assert copy.distinct?

  # it: non-distinct is preserved on dup
  original = builder
  copy = original.dup
  assert !copy.distinct?

  # it: merges distinct flag from other builder
  b1 = builder
  b2 = builder.distinct
  b1 = b1.merge(b2)
  assert b1.distinct?

  # it: does not set distinct when other is not distinct
  b1 = builder
  b2 = builder
  b1 = b1.merge(b2)
  assert !b1.distinct?
end
