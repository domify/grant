module test/grant_query_assemblers_sqlite_test
import test/query_spec_helper::{Model, sqlite_builder, query_fields, with_legacy_implicit_order, ignore_whitespace?}
import grant/adapter/driver::{Value}

with_legacy_implicit_order do
  # count

  # it: counts for where/count queries
  sql = "select count(*) from table where \"name\" = ?"
  assert ignore_whitespace?(sqlite_builder.where(name: "bob").assembler.count.raw_sql, sql)

  # it: simple counts
  sql = "select count(*) from table"
  assert ignore_whitespace?(sqlite_builder.assembler.count.raw_sql, sql)

  # it: adds group_by fields for where/count queries
  sql = "select count(*) from table where \"name\" = ? group by name"
  assert ignore_whitespace?(sqlite_builder.where(name: "bob").group_by(:name).assembler.count.raw_sql, sql)

  # group_by

  # it: adds group_by for select query
  sql = "select #{query_fields} from table group by name"
  assert ignore_whitespace?(sqlite_builder.group_by(:name).raw_sql, sql)

  # it: adds multiple group_by for select query
  sql = "select #{query_fields} from table group by name, age"
  assert ignore_whitespace?(sqlite_builder.group_by([:name, :age]).raw_sql, sql)

  # it: adds chain of group_by for select query
  sql = "select #{query_fields} from table group by id, name, age order by id desc"
  assert ignore_whitespace?(sqlite_builder.group_by(:id).group_by([:name, :age]).raw_sql, sql)

  # where

  # it: properly numbers fields
  sql = "select #{query_fields} from table where \"name\" = ? and \"age\" = ? order by id desc"
  query = sqlite_builder.where(name: "bob", age: "23")
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == ["bob", "23"] of Value

  # it: property defines IN query
  sql = "SELECT #{query_fields} FROM table WHERE \"date_completed\" IS NULL AND \"status\" IN (?,?) ORDER BY id DESC"
  query = sqlite_builder.where(date_completed: nil, status: ["outstanding", "in_progress"])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == ["outstanding", "in_progress"] of Value

  # it: property defines IN query with numbers
  sql = "SELECT #{query_fields} FROM table WHERE \"date_completed\" IS NULL AND \"id\" IN (?,?) ORDER BY id DESC"
  query = sqlite_builder.where(date_completed: nil, id: [1, 2])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [1_i64, 2_i64] of Value

  # it: property defines IN query with booleans
  sql = "SELECT #{query_fields} FROM table WHERE \"published\" IN (?,?) ORDER BY id DESC"
  query = sqlite_builder.where(published: [true, false])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [true, false] of Value

  # it: handles raw SQL
  sql = "select #{query_fields} from table where name = 'bob' and age = ? and color = ? order by id desc"
  query = sqlite_builder.where("name = 'bob'").where("age = ?", 23).where("color = ?", "red")
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [23_i64, "red"] of Value

  # order

  # it: uses default sort when no sort is provided
  assert ignore_whitespace?(sqlite_builder.raw_sql, "select #{query_fields} from table order by id desc")

  # it: uses specified sort when provided
  sql = "select #{query_fields} from table order by id asc"
  assert ignore_whitespace?(sqlite_builder.order(id: :asc).raw_sql, sql)

  # offset

  # it: adds offset for select query
  sql = "select #{query_fields} from table order by id desc offset 8"
  assert ignore_whitespace?(sqlite_builder.offset(8).raw_sql, sql)

  # it: adds offset for first query
  sql = "select #{query_fields} from table order by id desc limit 1 offset 3"
  assert ignore_whitespace?(sqlite_builder.offset(3).assembler.first.raw_sql, sql)

  # limit

  # it: adds limit for select query
  sql = "select #{query_fields} from table order by id desc limit 5"
  assert ignore_whitespace?(sqlite_builder.limit(5).raw_sql, sql)

  # select projection

  # it: uses projected columns in SELECT when select(*cols) is called
  sql = "select name from table order by id desc"
  assert ignore_whitespace?(sqlite_builder.select(:name).raw_sql, sql)

  # it: uses multiple projected columns in SELECT
  sql = "select name, age from table order by id desc"
  assert ignore_whitespace?(sqlite_builder.select(:name, :age).raw_sql, sql)

  # it: reselect replaces earlier projection in SELECT
  sql = "select age from table order by id desc"
  assert ignore_whitespace?(sqlite_builder.select(:name).reselect(:age).raw_sql, sql)

  # it: uses all model fields when no projection is set
  sql = "select #{query_fields} from table order by id desc"
  assert ignore_whitespace?(sqlite_builder.raw_sql, sql)

  # it: projection is preserved through first assembler
  sql = "select name from table order by id desc limit 1"
  assert ignore_whitespace?(sqlite_builder.select(:name).assembler.first.raw_sql, sql)
  nil
end
