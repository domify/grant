module test/grant_convenience_create_with_test
import test/convenience_models::{ConvItem, reset_items}
import grant/columns::{Type}
import test/hash_equality::{same_hash?}

reset_items

# it: supplies defaults for create and build
ConvItem.clear
relation = ConvItem.create_with(status: "draft", qty: 5)
item = relation.create(name: "a").or_panic
assert item.status == "draft"
assert item.qty == 5
assert relation.build(name: "b").or_panic.status == "draft"

# it: lets explicit attributes win over the defaults
ConvItem.clear
assert ConvItem.create_with(status: "draft").create(name: "a", status: "live").or_panic.status == "live"

# it: overrides scope attributes from the where clause
ConvItem.clear
item = ConvItem.where(status: "live").create_with(status: "draft").create(name: "a").or_panic
assert item.status == "draft"

# it: merges successive calls
ConvItem.clear
relation = ConvItem.create_with(status: "draft").create_with(kind: "k")
assert same_hash?(relation.create_with_attributes, {"status" => "draft", "kind" => "k"})

# it: clears the defaults when given an empty hash
ConvItem.clear
relation = ConvItem.create_with(status: "draft").create_with({} of String => Type)
assert relation.create_with_attributes.empty?

# it: copies the defaults when the relation is duplicated
ConvItem.clear
parent = ConvItem.create_with(status: "draft")
child = parent.create_with(kind: "child")
assert same_hash?(parent.create_with_attributes, {"status" => "draft"})
assert same_hash?(child.create_with_attributes, {"status" => "draft", "kind" => "child"})
copy = parent.dup
copy.create_with_in_place({"status" => "live"} of Symbol | String => Type)
assert parent.build(name: "p").or_panic.status == "draft"
assert copy.build(name: "c").or_panic.status == "live"

# it: returns a copy of the defaults so callers cannot alter the relation
ConvItem.clear
relation = ConvItem.create_with(status: "draft")
relation.create_with_attributes["status"] = "tampered"
assert relation.build(name: "x").or_panic.status == "draft"

# it: survives further chaining
ConvItem.clear
relation = ConvItem.create_with(status: "draft").where(kind: "k").order(id: :desc)
item = relation.create(name: "chain").or_panic
assert item.status == "draft"
assert item.kind == "k"

# it: applies to find_or_create_by and create_or_find_by
ConvItem.clear
relation = ConvItem.create_with(status: "draft")
assert relation.find_or_create_by(name: "a").or_panic.status == "draft"
assert relation.create_or_find_by(name: "b").or_panic.status == "draft"

# it: reports scope attributes from equality predicates only
ConvItem.clear
assert same_hash?(ConvItem.where(status: "x", kind: "y").where(:qty, :gt, 3).scope_attributes, {"status" => "x", "kind" => "y"})
assert ConvItem.scope_attributes.empty?

# it: is available on the class
ConvItem.clear
assert ConvItem.create_with(kind: "k").create(name: "a").or_panic.kind == "k"

# it: ignores equality predicates on other tables and unknown columns
ConvItem.clear
qualified = {"conv_items.status" => "own", "authors.id" => 5_i64, "other.kind" => "k", "not_a_column" => "x"} of Symbol | String => Type
assert same_hash?(ConvItem.where(qualified).scope_attributes, {"status" => "own"})

# it: keeps create_with defaults set inside a named scope body
ConvItem.clear
item = ConvItem.drafts.kinded.create(name: "r").or_panic
assert item.kind == "k"
assert item.qty == 1
assert item.status == "draft"
assert ConvItem.kinded.build(name: "s").or_panic.kind == "k"
ConvItem.adapter.close.or_panic
