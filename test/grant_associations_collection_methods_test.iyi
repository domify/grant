module test/grant_associations_collection_methods_test
import grant/base::{Base}
import grant/errors::{RecordNotSaved}
import test/spec_helper::{register_spec_connections}

pub class CollectionAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table collection_authors

  column id : Int64, primary: true
  column name : String?

  has_many :posts, class_name: CollectionPost, foreign_key: :collection_author_id
end

pub class CollectionPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table collection_posts

  column id : Int64, primary: true
  column title : String?
  column body : String?
  column collection_author_id : Int64?

  belongs_to :collection_author, optional: true

  validates_presence_of :title
end

register_spec_connections
CollectionAuthor.migrator.drop_and_create.or_panic
CollectionPost.migrator.drop_and_create.or_panic

# it: creates a new unsaved record with foreign key set
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Jane"
assert author.save.or_panic

post = author.posts.build(title: "New Post", body: "Content")

assert post.is_a?(CollectionPost)
assert post.title == "New Post"
assert post.body == "Content"
assert post.collection_author_id == author.id
assert post.new_record?

# it: does not persist the record
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Bob"
assert author.save.or_panic

author.posts.build(title: "Draft")

assert CollectionPost.where(collection_author_id: author.id).count.or_panic == 0

# it: creates and saves a new record with foreign key set
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Alice"
assert author.save.or_panic

post = author.posts.create(title: "Published", body: "Text").or_panic

assert post.is_a?(CollectionPost)
assert post.title == "Published"
assert post.collection_author_id == author.id
assert !post.new_record?

# it: returns record with errors if validation fails
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Author"
assert author.save.or_panic

# title is required, so nil title should fail validation
post = author.posts.create(body: "no title").or_panic

assert !post.errors.empty?

# it: persists the record in the database
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Charlie"
assert author.save.or_panic

author.posts.create(title: "Saved Post", body: "Body")

assert CollectionPost.where(collection_author_id: author.id).count.or_panic == 1

# it: creates and saves a new record
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Dave"
assert author.save.or_panic

post = author.posts.create_strict(title: "Must Save", body: "Body").or_panic

assert post.is_a?(CollectionPost)
assert post.collection_author_id == author.id
assert !post.new_record?

# it: raises on validation failure
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Eve"
assert author.save.or_panic

assert author.posts.create_strict(body: "no title").is_a?(RecordNotSaved)

# it: deletes all associated records via SQL when asked to with :delete_all
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Frank"
assert author.save.or_panic

3.times do |i|
  author.posts.create(title: "Post #{i}", body: "Body #{i}")
end

assert CollectionPost.where(collection_author_id: author.id).count.or_panic == 3

deleted = author.posts.delete_all(:delete_all).or_panic
assert deleted == 3

assert CollectionPost.where(collection_author_id: author.id).count.or_panic == 0

# it: returns 0 when no associated records exist
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Grace"
assert author.save.or_panic

assert author.posts.delete_all.or_panic == 0

# it: destroys all associated records with callbacks
CollectionPost.clear.or_panic
CollectionAuthor.clear.or_panic
author = CollectionAuthor.new
author.name = "Hank"
assert author.save.or_panic

3.times do |i|
  author.posts.create(title: "Post #{i}", body: "Body #{i}")
end

destroyed = author.posts.destroy_all.or_panic
assert destroyed.size == 3

assert CollectionPost.where(collection_author_id: author.id).count.or_panic == 0

CollectionAuthor.adapter.close.or_panic
