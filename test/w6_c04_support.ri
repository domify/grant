module test/w6_c04_support

# Native counterpart of crystal-upstream/spec/support/w6_c04_support.cr.
# Real databases for the connection and sharding specs of batch C04. Each spec
# names the databases it needs; the same example then runs on whichever adapter
# CURRENT_ADAPTER selects: one SQLite file per name, or one PostgreSQL database
# named `grant_w6_c04_<name>`. Rows are written and read through plain driver
# connections, so what a Grant query returns names the database it actually
# reached.
import std/text
import std/dir::{Dir}
import std/file::{File}
import std/time::{Span}
import grant/adapter/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/adapter/driver::{Value}
import grant/adapter/drivers::{open_connection}
import grant/adapter/pool_support::{ticks}
import grant/connection_registry::{ConnectionRegistry}
import test/spec_helper::{CURRENT_ADAPTER, ADAPTER_URL}

# The process id names the upstream directory; a start tick does here.
W6C04_DIR = File.join(Dir.tempdir, "w6_c04_#{ticks}")

pub class W6C04
  @@provisioned = [] of String

  def self.pg? : Bool
    CURRENT_ADAPTER == "pg"
  end

  def self.dir : String
    Dir.mkdir_p(W6C04_DIR)
    W6C04_DIR
  end

  # Upstream names the database `grant_w6_c04_<name>`. Port worktrees share
  # one PostgreSQL server, so the checkout's own database name prefixes it.
  def self.database_name(name : String) : String
    "#{checkout_database}_w6_c04_#{name}"
  end

  private def self.checkout_database : String
    path = ADAPTER_URL.split('?').first
    slash = path.rindex('/')
    slash.nil? ? "grant" : path[slash + 1, path.bytesize - slash - 1]
  end

  # A URL on the PostgreSQL server of `PG_DATABASE_URL`, naming *database*.
  def self.pg_url(database : String) : String
    scheme_end = ADAPTER_URL.index("://").as(Int32) + 3
    path_start = ADAPTER_URL.index("/", scheme_end) || ADAPTER_URL.bytesize
    "#{ADAPTER_URL[0, path_start]}/#{database}"
  end

  def self.url(name : String) : String
    pg? ? pg_url(database_name(name)) : "sqlite3:#{File.join(dir, "#{name}.sqlite3")}"
  end

  # Creates an empty database for *name* and returns its URL. Any earlier
  # database of that name is dropped first.
  def self.provision(name : String) : String
    drop(name)
    if pg?
      exec_on(pg_url("postgres"), "CREATE DATABASE #{database_name(name)}")
    end
    @@provisioned << name
    url(name)
  end

  # Provisions *name* and runs *ddl* in it.
  def self.provision(name : String, ddl : Array(String)) : String
    database_url = provision(name)
    connection = open_connection(driver_path(database_url)).or_panic
    ddl.each { |statement| connection.exec(statement).or_panic }
    connection.close.or_panic
    database_url
  end

  def self.drop(name : String) : Nil
    if pg?
      exec_on(pg_url("postgres"), "DROP DATABASE IF EXISTS #{database_name(name)} WITH (FORCE)")
    else
      path = File.join(dir, "#{name}.sqlite3")
      [path, "#{path}-wal", "#{path}-shm"].each { |file| File.delete(file) if File.exists?(file) }
    end
    nil
  end

  # Drops every database `provision` created in this process.
  def self.cleanup : Nil
    @@provisioned.each { |name| drop(name) }
    @@provisioned.clear
    if !pg? && Dir.exists?(W6C04_DIR)
      Dir.each_child(W6C04_DIR) { |child| File.delete(File.join(W6C04_DIR, child)) }
      Dir.delete(W6C04_DIR)
    end
    nil
  end

  # Runs *sql* with *args* straight against the database *name*.
  def self.exec(name : String, sql : String, args : Array(Value) = [] of Value) : Nil
    connection = open_connection(driver_path(url(name))).or_panic
    connection.exec(sql, args).or_panic
    connection.close.or_panic
    nil
  end

  # The first column of every row of *sql* in the database *name*, as strings.
  def self.strings(name : String, sql : String) : Array(String)
    connection = open_connection(driver_path(url(name))).or_panic
    values = connection.query(sql).or_panic.map { |row| row.values.first.to_s }
    connection.close.or_panic
    values
  end

  # `$1`-style on PostgreSQL, `?` on SQLite.
  def self.placeholder(index : Int32 = 1) : String
    pg? ? "$#{index}" : "?"
  end

  # Establishes the connection *database* on the database *name*.
  def self.establish(database : String, name : String, role : Symbol = :writing, verify_idle_after : Span? = Span.seconds(30_i64)) : Base
    if pg?
      ConnectionRegistry.establish_connection(database: database, adapter: Pg, url: url(name), role: role, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
    else
      ConnectionRegistry.establish_connection(database: database, adapter: Sqlite, url: url(name), role: role, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
    end
    ConnectionRegistry.get_adapter(database, role)
  end

  # Removes the registry connections the example established.
  def self.remove(database : String, role : Symbol = :writing) : Nil
    if ConnectionRegistry.connection_exists?(database, role)
      ConnectionRegistry.get_adapter(database, role).disconnect_strict.or_panic
    end
    ConnectionRegistry.remove_connection(database, role).or_panic
    nil
  end

  # The auto-increment id column definition of the adapter under test.
  def self.id_column : String
    pg? ? "id BIGSERIAL PRIMARY KEY" : "id INTEGER PRIMARY KEY AUTOINCREMENT"
  end

  # The native drivers take a SQLite file path; PostgreSQL keeps its URL.
  private def self.driver_path(url : String) : String
    url.starts_with?("sqlite3:") ? url[8, url.bytesize - 8] : url
  end

  private def self.exec_on(url : String, sql : String) : Nil
    connection = open_connection(driver_path(url)).or_panic
    connection.exec(sql).or_panic
    connection.close.or_panic
    nil
  end
end
