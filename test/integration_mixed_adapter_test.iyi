module test/integration_mixed_adapter_test

import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/connection_registry::{ConnectionRegistry}
import grant/notifications
import grant/events::{SQL}
import grant/errors::{ErrorBase, Rollback}
import std/env::{ENV}
import std/dir::{Dir}
import std/file
import std/text
import std/regex

C03_MIXED_DIR = "build/tmp/c03_mixed"
C03_MIXED_PG = ENV["PG_DATABASE_URL"]?

pub class C03LocalNote < Base
  connects_to database: "c03_local"
  table c03_mixed_notes
  column id : Int64, primary: true
  column label : String
  column amount : Int64?
end

pub class C03ServerNote < Base
  connects_to database: "c03_server"
  table c03_mixed_notes
  column id : Int64, primary: true
  column label : String
  column amount : Int64?
end

private def c03_capture_sql(&block : -> T) : Hash(String, Array(String)) forall T
  seen = {} of String => Array(String)
  subscription = ::Grant::Notifications.subscribe(SQL) do |event|
    statements = seen[event.connection]? || [] of String
    statements << event.sql
    seen[event.connection] = statements
    nil
  end
  yield
  subscription.unsubscribe
  seen
end

private def clear_notes : Nil
  C03LocalNote.adapter.open { |db| db.exec("DELETE FROM c03_mixed_notes") }.or_panic
  C03ServerNote.adapter.open { |db| db.exec("DELETE FROM c03_mixed_notes") }.or_panic
  nil
end

# it: needs PG_DATABASE_URL
# The fast harness supplies the PostgreSQL URL in both adapter runs.
assert !C03_MIXED_PG.nil?
Dir.mkdir_p(C03_MIXED_DIR)
ConnectionRegistry.establish_connection(database: "c03_local",
  url: "sqlite3:#{C03_MIXED_DIR}/local.sqlite3", role: :writing).or_panic
ConnectionRegistry.establish_connection(database: "c03_server",
  url: C03_MIXED_PG.as(String), role: :writing).or_panic
C03LocalNote.adapter.open do |db|
  db.exec("DROP TABLE IF EXISTS c03_mixed_notes").or_panic
  db.exec("CREATE TABLE c03_mixed_notes (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT NOT NULL, amount BIGINT)")
end.or_panic
C03ServerNote.adapter.open do |db|
  db.exec("DROP TABLE IF EXISTS c03_mixed_notes").or_panic
  db.exec("CREATE TABLE c03_mixed_notes (id BIGSERIAL PRIMARY KEY, label TEXT NOT NULL, amount BIGINT)")
end.or_panic

# it: infers a different adapter for each connection from its URL
clear_notes
assert C03LocalNote.adapter.is_a?(Sqlite)
assert C03ServerNote.adapter.is_a?(Pg)

# it: does create, read, update and destroy on both engines
clear_notes
local = C03LocalNote.create_strict(label: "on the device", amount: 5_i64).or_panic
server = C03ServerNote.create_strict(label: "on the server", amount: 9_i64).or_panic
assert C03LocalNote.find_strict(local.id).or_panic.label == "on the device"
assert C03ServerNote.find_strict(server.id).or_panic.label == "on the server"
local.update_strict(amount: 6_i64).or_panic
server.update_strict(amount: 10_i64).or_panic
assert C03LocalNote.find_strict(local.id).or_panic.amount == 6_i64
assert C03ServerNote.find_strict(server.id).or_panic.amount == 10_i64
local.destroy
server.destroy
assert C03LocalNote.count.or_panic == 0
assert C03ServerNote.count.or_panic == 0

# it: keeps the rows of each engine separate
clear_notes
C03LocalNote.create_strict(label: "local only").or_panic
C03ServerNote.create_strict(label: "server only").or_panic
assert C03LocalNote.all.select.or_panic.map(&.label) == ["local only"]
assert C03ServerNote.all.select.or_panic.map(&.label) == ["server only"]

# it: uses each engine's own placeholders and never leaks one into the other
clear_notes
seen = c03_capture_sql do
  C03LocalNote.create_strict(label: "alpha", amount: 1_i64).or_panic
  C03ServerNote.create_strict(label: "alpha", amount: 1_i64).or_panic
  assert C03LocalNote.where(label: "alpha").select.or_panic.size == 1
  assert C03ServerNote.where(label: "alpha").select.or_panic.size == 1
  assert C03LocalNote.where("amount > ?", 0_i64).select.or_panic.size == 1
  assert C03ServerNote.where("amount > ?", 0_i64).select.or_panic.size == 1
end
local_sql = seen[C03LocalNote.adapter.name].select { |sql| sql.includes?("c03_mixed_notes") }
server_sql = seen[C03ServerNote.adapter.name].select { |sql| sql.includes?("c03_mixed_notes") }
assert !local_sql.empty?
assert !server_sql.empty?
local_sql.each { |sql| assert /\$\d/.find(sql).nil? }
server_sql.each { |sql| assert !sql.includes?("?") }
assert server_sql.any? { |sql| !/\$\d/.find(sql).nil? }

# it: runs transactions on each engine independently
clear_notes
C03LocalNote.transaction do
  C03LocalNote.create_strict(label: "local committed").or_panic
  assert C03LocalNote.transaction_open?
end.or_panic
error = C03ServerNote.transaction do
  C03ServerNote.create_strict(label: "server rolled back").or_panic
  ErrorBase.new("abort server")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "abort server"
assert C03LocalNote.all.select.or_panic.map(&.label) == ["local committed"]
assert C03ServerNote.count.or_panic == 0

# it: does not pin the other engine: a transaction on one commits or rolls back without touching the other
clear_notes
error = C03LocalNote.transaction do
  C03LocalNote.create_strict(label: "local rolled back").or_panic
  C03ServerNote.create_strict(label: "server survives").or_panic
  ErrorBase.new("local abort")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "local abort"
assert C03LocalNote.count.or_panic == 0
assert C03ServerNote.all.select.or_panic.map(&.label) == ["server survives"]
C03ServerNote.transaction do
  C03ServerNote.create_strict(label: "server in tx").or_panic
  C03LocalNote.create_strict(label: "local survives").or_panic
  Rollback.new
end.or_panic
assert C03ServerNote.all.select.or_panic.map(&.label) == ["server survives"]
assert C03LocalNote.all.select.or_panic.map(&.label) == ["local survives"]

# it: handles typed values on both engines without cross-engine type leakage
clear_notes
big = 9_000_000_000_i64
C03LocalNote.create_strict(label: "big", amount: big).or_panic
C03ServerNote.create_strict(label: "big", amount: big).or_panic
assert C03LocalNote.first_strict.or_panic.amount == big
assert C03ServerNote.first_strict.or_panic.amount == big
C03LocalNote.create_strict(label: "nil amount").or_panic
C03ServerNote.create_strict(label: "nil amount").or_panic
assert C03LocalNote.where(label: "nil amount").first_strict.or_panic.amount.nil?
assert C03ServerNote.where(label: "nil amount").first_strict.or_panic.amount.nil?

C03ServerNote.adapter.open { |db| db.exec("DROP TABLE IF EXISTS c03_mixed_notes") }.or_panic
ConnectionRegistry.remove_connection("c03_local", :writing).or_panic
ConnectionRegistry.remove_connection("c03_server", :writing).or_panic
File.delete("#{C03_MIXED_DIR}/local.sqlite3")
Dir.delete(C03_MIXED_DIR)
