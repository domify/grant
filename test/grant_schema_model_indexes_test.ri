module test/grant_schema_model_indexes_test

import grant/base::{Base}
import grant/schema/introspection
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class M02bIndexedRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02b_indexed_rows
  column id : Int64, primary: true
  column email : String, limit: 100
  column last_name : String?, limit: 50
  column first_name : String?, limit: 50
  index :email, unique: true
  index [:last_name, :first_name], name: "m02b_indexed_rows_names"
end

register_spec_connections
restore_default_spec_connections

# it: adds the declared indexes to the creation statements
statements = M02bIndexedRow.migrator.create_statements.or_panic
assert statements.size == 3
assert statements.any? { |sql| sql.includes?("m02b_indexed_rows_names") }
assert statements.any? { |sql| sql.starts_with?("CREATE UNIQUE INDEX") }

# it: creates the table with its indexes and enforces the unique one
M02bIndexedRow.migrator.drop_and_create.or_panic
schema = M02bIndexedRow.adapter.schema
assert schema.index_exists?(:m02b_indexed_rows, ["email"], unique: true).or_panic
assert schema.index_exists?(:m02b_indexed_rows, name: "m02b_indexed_rows_names").or_panic
M02bIndexedRow.create_strict(email: "a@x").or_panic
assert M02bIndexedRow.create_strict(email: "a@x").is_a?(ErrorBase)
M02bIndexedRow.migrator.drop.or_panic
