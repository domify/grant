module test/grant_validations_errors_api_test
import grant/base::{Base}
import grant/errors::{Errors}
import test/spec_helper::{register_spec_connections}
import test/validation_details_support::{same_details?, json_for_messages}

register_spec_connections

pub class V02eProfile < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v02e_profiles

  column id : Int64, primary: true
  column first_name : String?
  column age : Int32?

  validates_presence_of :first_name
  validates_length_of :first_name, minimum: 3, allow_nil: true
  validates_numericality_of :age, greater_than: 17, allow_nil: true
end

begin
  V02eProfile.migrator.drop_and_create.or_panic

  begin
    # it: matches by type symbol, not by message
    begin
      errors = Errors.new
      errors.add(:name, "can't be blank", type: :blank)
      assert errors.of_type(:name, :blank)
      assert !errors.of_type(:name, :invalid)
      assert errors.of_type?(:name, :blank)
    end

    # it: matches the options of the error when given
    begin
      errors = Errors.new
      errors.add(:name, :too_short, count: 3)
      assert errors.of_type(:name, :too_short, count: 3)
      assert !errors.of_type(:name, :too_short, count: 4)
    end

    # it: keeps matching a String argument by message
    begin
      errors = Errors.new
      errors.add(:name, "is odd")
      assert errors.of_type(:name, "is odd")
      assert errors.has_message?(:name, "is odd")
      assert !errors.has_message?(:name, "is even")
    end
  end

  begin
    # it: filters by type and by options
    begin
      errors = Errors.new
      errors.add(:name, :too_short, count: 3)
      errors.add(:name, :too_short, count: 5)
      errors.add(:name, :blank)
      errors.add(:email, :blank)

      assert errors.where(:name).size == 3
      assert errors.where(:name, :too_short).size == 2
      assert errors.where(:name, :too_short, count: 5).size == 1
      assert errors.where(:name, :too_short, count: 5).first.options[:count] == 5
      assert errors.where(:name, :invalid).empty?
      assert errors.where(:nobody).empty?
    end
  end

  begin
    # it: returns messages, or full messages with full_messages: true
    begin
      record = V02eProfile.new(first_name: "ab", age: 3)
      assert !record.valid?.or_panic
      assert same_details?(record.errors.to_hash, {
        "first_name" => ["is too short (minimum is 3 characters)"],
        "age"        => ["must be greater than 17"],
      })
      assert same_details?(record.errors.to_hash(full_messages: true), {
        "first_name" => ["First name is too short (minimum is 3 characters)"],
        "age"        => ["Age must be greater than 17"],
      })
      assert same_details?(record.errors.messages, record.errors.to_hash)
    end
  end

  begin
    # it: serializes the ActiveRecord shape from as_json
    begin
      errors = Errors.new
      errors.add(:name, "can't be blank")
      errors.add(:name, "is too short")
      errors.add(:base, "is bad")
      assert same_details?(errors.as_json, {"name" => ["can't be blank", "is too short"], "base" => ["is bad"]})
      assert errors.as_json(full_messages: true)["name"] == ["Name can't be blank", "Name is too short"]
      assert json_for_messages(errors.as_json) == %({"name":["can't be blank","is too short"],"base":["is bad"]})
    end

    # it: serializes to_json in the ActiveRecord shape, to_json_list as field/message objects
    begin
      errors = Errors.new
      errors.add(:name, "can't be blank")
      assert errors.to_json == %({"name":["can't be blank"]})
      assert errors.to_json_list == %([{"field":"name","message":"can't be blank"}])
    end
  end

  begin
    # it: reports added? for the exact error
    begin
      errors = Errors.new
      errors.add(:name, :too_short, count: 3)
      assert errors.added?(:name, :too_short, count: 3)
      assert !errors.added?(:name, :too_short) # options must match exactly
      assert !errors.added?(:name, :too_short, count: 4)
      errors.add(:age, :invalid)
      assert errors.added?(:age) # :invalid is the default type
      errors.add(:base, "custom")
      assert errors.added?(:base, "custom")
    end

    # it: deletes by attribute, type and options and returns the messages
    begin
      errors = Errors.new
      errors.add(:name, :blank)
      errors.add(:name, :too_short, count: 3)
      errors.add(:email, :blank)

      assert errors.delete(:name, :too_short) == ["is too short (minimum is 3 characters)"]
      assert errors.size == 2
      assert errors.include?(:name)
      assert errors.delete(:name) == ["can't be blank"]
      assert !errors.include?(:name)
      assert errors.attribute_names == ["email"]
      assert errors.delete(:name).empty?
    end

    # it: lists messages_for, counts by attribute and exposes the error objects
    begin
      errors = Errors.new
      errors.add(:name, :blank)
      errors.add(:name, :invalid)
      errors.add(:email, :blank)
      assert errors.messages_for(:name) == ["can't be blank", "is invalid"]
      assert errors.count(:name) == 2
      assert errors.count(:nobody) == 0
      assert errors.count == 3
      assert errors.objects.size == 3
      assert errors.objects.object_id == errors.objects.object_id
    end

    # it: formats a full message for an attribute
    begin
      errors = Errors.new
      assert errors.full_message(:first_name, "is bad") == "First name is bad"
      assert errors.full_message(:base, "is bad") == "is bad"
    end

    # it: keeps its attribute index right across adds, deletes and clears
    begin
      errors = Errors.new
      errors.add(:a, :blank)
      assert errors[:a].size == 1 # builds the index
      errors.add(:a, :invalid)
      errors.add(:b, :blank)
      assert errors[:a].size == 2
      assert errors.attribute_names == ["a", "b"]
      assert errors.group_by_attribute.keys == ["a", "b"]
      errors.clear
      assert errors[:a].empty?
      assert !errors.include?(:a)
    end

    # it: removes duplicates with uniq!
    begin
      errors = Errors.new
      errors.add(:name, :blank)
      errors.add(:name, :blank)
      errors.add(:name, :too_short, count: 3)
      errors.add(:name, :too_short, count: 4)
      errors.uniq_in_place
      assert errors.size == 3
    end
  end

  begin
    # it: merge! copies the errors instead of sharing them
    begin
      source = Errors.new
      source.add(:name, "can't be blank", type: :blank)
      target = Errors.new
      target.merge_in_place(source)

      assert target.size == 1
      assert target.first.object_id != source.first.object_id
      target.first.message = "changed"
      assert source.first.message == "can't be blank"
    end

    # it: import copies one error, optionally under another attribute
    begin
      source = Errors.new
      source.add(:street, :blank)
      target = Errors.new
      copy = target.import_records(source.first, attribute: "address.street")
      assert copy.attribute == "address.street"
      assert target.of_type("address.street", :blank)
      assert source.first.attribute == "street"
    end

    # it: copy! replaces the errors with copies of another collection's
    begin
      source = Errors.new
      source.add(:name, :blank)
      target = Errors.new
      target.add(:old, :invalid)
      target.copy_in_place(source)
      assert target.attribute_names == ["name"]
      assert target.first.object_id != source.first.object_id
    end
  end
end
