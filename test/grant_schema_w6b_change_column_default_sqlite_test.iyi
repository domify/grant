module test/grant_schema_w6b_change_column_default_sqlite_test
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/schema::{Dialect, InvalidDefinition}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

register_spec_connections
restore_default_spec_connections
adapter = ::Test::SchemaFixture.adapter
statements = AdapterStatements.new(adapter)
insert_empty = ->(table : String) do
  sql = CURRENT_ADAPTER == "mysql" ? "INSERT INTO #{table} () VALUES ()" : "INSERT INTO #{table} DEFAULT VALUES"
  adapter.open { |db| db.exec(sql) }
end
column_default = ->(table : String, name : String) do
  adapter.reset_schema_caches_in_place
  adapter.schema.columns(table).or_panic.find { |column| column.name == name }.as(ColumnInfo).default
end
private def reset(statements : AdapterStatements) : Nil
  statements.drop_table(:w6b_defaults, if_exists: true).or_panic
  statements.create_table(:w6b_defaults) do |t|
    t.string(:role, null: false, default: "it's member")
    t.integer(:qty, default: 1)
    t.string(:label)
    t.index(:label, unique: true)
  end.or_panic
  ::Test::SchemaFixture.adapter.open { |db| db.exec("INSERT INTO w6b_defaults (role, qty, label) VALUES ('kept', 7, 'one')") }.or_panic
end

# it: sets a new literal default and keeps the rows
reset(statements)
statements.change_column_default(:w6b_defaults, :role, from: "it's member", to: "admin").or_panic
insert_empty.call("w6b_defaults").or_panic
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_defaults WHERE qty = 1").or_panic.as(String) }.or_panic == "admin"
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_defaults WHERE label = 'one'").or_panic.as(String) }.or_panic == "kept"

# it: replaces a default that holds an escaped quote
reset(statements)
statements.change_column_default(:w6b_defaults, :role, to: "o'neil").or_panic
insert_empty.call("w6b_defaults").or_panic
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_defaults WHERE qty = 1").or_panic.as(String) }.or_panic == "o'neil"

# it: drops the default and keeps NOT NULL
reset(statements)
statements.change_column_default(:w6b_defaults, :role, to: nil).or_panic
assert column_default.call("w6b_defaults", "role").nil?
assert !adapter.schema.columns(:w6b_defaults).or_panic.find { |column| column.name == "role" }.as(ColumnInfo).null?
assert insert_empty.call("w6b_defaults").is_a?(ErrorBase)

# it: sets an expression default and leaves the other defaults alone
reset(statements)
statements.change_column_default(:w6b_defaults, :qty, default_sql: "2 * 5").or_panic
insert_empty.call("w6b_defaults").or_panic
assert adapter.open { |db| db.scalar("SELECT qty FROM w6b_defaults WHERE qty <> 7").or_panic.as(Int64) }.or_panic == 10
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_defaults WHERE qty <> 7").or_panic.as(String) }.or_panic == "it's member"

# it: keeps the unique index
reset(statements)
statements.change_column_default(:w6b_defaults, :label, to: "x").or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.indexes(:w6b_defaults).or_panic.any? { |index| index.columns == ["label"] && index.unique? }

# it: renders the rebuild SQL on the recording mock
reset(statements)
if CURRENT_ADAPTER == "sqlite"
  recorder = RecordingStatements.new(Dialect::Sqlite)
  definition = "CREATE TABLE \"users\" (\"id\" INTEGER PRIMARY KEY, \"role\" VARCHAR(255) DEFAULT 'a b' NOT NULL)"
  recorder.sqlite_tables["users"] = {definition, [] of String}
  sql = recorder.change_column_default_statements(:users, :role, to: "c").or_panic.join("\n")
  assert sql.includes?("\"role\" VARCHAR(255)  NOT NULL DEFAULT 'c'")
  assert !sql.includes?("'a b'")
end

# it: needs a target
reset(statements)
assert statements.change_column_default(:w6b_defaults, :role).is_a?(InvalidDefinition)
statements.drop_table(:w6b_defaults, if_exists: true).or_panic
