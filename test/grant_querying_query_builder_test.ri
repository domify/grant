module test/grant_querying_query_builder_test
import test/transaction_crud_models::{Parent}
import test/querying_spec_models::{Review}
import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}
register_spec_connections
Review.migrator.drop_and_create.or_panic
Parent.migrator.drop_and_create.or_panic
# it: correctly queries all rows with a list of id values
review1 = Review.create(name: "one")
review2 = Review.create(name: "two")

found = Review.where(id: [review1.id, review2.id]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id
# it: correctly queries all rows with a list of id values and names
review1 = Review.create(name: "one")
review2 = Review.create(name: "two")

found = Review.where(name: ["one", "two"]).and_where(id: [review1.id, review2.id]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id
# it: correctly queries all rows with a list of id values or names
review1 = Review.create(name: "one")
review2 = Review.create(name: "two")

found = Review.where(id: [1001, 1002]).or_where(name: ["one", "two"]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id

found = Review.where(name: ["one", "two"]).or_where(id: [1001, 1002]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id
# it: correctly queries with ids fields which doest exists
Review.create(name: "one")
Review.create(name: "two")

found = Review.where(id: [1001, 1002]).order(id: :desc).select.or_panic
assert found.size == 0
# it: correctly queries string fields
review1 = Review.create(name: "one")
review2 = Review.create(name: "two")

found = Review.where(name: ["one", "two"]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id
# it: correctly queries number fields
Review.clear
review1 = Review.create(name: "one", downvotes: 99)
review2 = Review.create(name: "two", downvotes: -4)

found = Review.where(downvotes: [99, -4]).order(id: :desc).select.or_panic
assert found[0].id == review2.id
assert found[1].id == review1.id
if CURRENT_ADAPTER == "sqlite"
# it: correctly queries bool fields
Review.clear
Review.create(name: "one", published: true)
review2 = Review.create(name: "two", published: false)

found = Review.where(published: [false]).order(id: :desc).select.or_panic

assert found.size == 1
assert found[0].id == review2.id
else
# it: correctly queries bool fields
Review.clear
Review.create(name: "one", published: true)
review2 = Review.create(name: "two", published: false)

found = Review.where(published: [false]).order(id: :desc).select.or_panic
assert found.size == 1
assert found[0].id == review2.id
end
# it: should return true
model = Parent.new(name: "Some Name")
assert model.save.or_panic
assert Parent.where(id: model.id).exists?.or_panic
# it: should return true
model = Parent.new(name: "Some Name")
assert model.save.or_panic
assert Parent.where(name: "Some Name", id: model.id).exists?.or_panic
# it: should return false
assert !Parent.where(id: 234567).exists?.or_panic
# it: should return false
model = Parent.new(name: "Some Name")
assert model.save.or_panic
assert !Parent.where(name: "Some Other Name", id: model.id).exists?.or_panic
Review.adapter.close.or_panic
