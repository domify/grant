module test/grant_validation_helpers_lenght_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class LengthTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column title : String?
  column description : String?

  validate_min_length :title, 5
  validate_max_length :description, 25
end

register_spec_connections
LengthTest.migrator.drop_and_create.or_panic

# it: should work for length
length_test = LengthTest.new
length_test.title = "one"
length_test.description = "abcdefghijklmnopqrstuvwxyz"
length_test.save
assert length_test.errors.size == 2
assert length_test.errors[0].message == "title is too short. It must be at least 5"
assert length_test.errors[1].message == "description is too long. It must be at most 25"

# Boundary and returned-error checks for the native validation path.
assert LengthTest.new(title: "12345", description: "x" * 25).valid?.or_panic
missing = LengthTest.new.valid?
assert missing.is_a?(::Grant::Encryption::Sealed::NilAssertionError)
assert missing.as(::Grant::Error::ErrorBase).message == "Nil assertion failed"
LengthTest.adapter.close.or_panic
