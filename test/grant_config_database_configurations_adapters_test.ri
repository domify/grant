module test/grant_config_database_configurations_adapters_test
import grant/database_configurations::{DatabaseConfigurations}
import grant/adapter/registry::{Registry, UnknownAdapterError}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}

def c03_adapters_env(values : Hash(String, String)) : Proc(String, String?)
  ->(key : String) { values[key]? }
end

# it: loads a file whose other environments name an adapter this build never required
yaml = "test:\n  primary:\n    url: \"sqlite3::memory:\"\nproduction:\n  primary:\n    url: oracle://prod/app\n"
configs = DatabaseConfigurations.parse(yaml, "test", c03_adapters_env({} of String => String)).or_panic
assert configs.db_config("primary").or_panic.adapter.or_panic.to_s == Sqlite.to_s
production = configs.db_config("primary", "production").or_panic
assert production.adapter_name == "oracle"
assert production.adapter?.nil?
assert production.adapter.is_a?(UnknownAdapterError)

# it: still rejects an unknown adapter in the current environment
assert DatabaseConfigurations.parse("test:\n  primary:\n    adapter: oracle\n    url: x.db\n",
  "test", c03_adapters_env({} of String => String)).is_a?(UnknownAdapterError)

# it: lets the DATABASE_URL scheme replace the file's adapter key
yaml = "production:\n  primary:\n    adapter: sqlite\n    url: file.db\n    pool: 4\n"
env = c03_adapters_env({"DATABASE_URL" => "postgres://override/app"})
primary = DatabaseConfigurations.parse(yaml, "production", env).or_panic.db_config("primary").or_panic
assert primary.adapter.or_panic.to_s == Pg.to_s
assert primary.pool_size == 4

# it: keeps the file's adapter key when the override URL has no scheme
yaml = "production:\n  primary:\n    adapter: sqlite\n    url: file.db\n"
env = c03_adapters_env({"DATABASE_URL" => "other.db"})
primary = DatabaseConfigurations.parse(yaml, "production", env).or_panic.db_config("primary").or_panic
assert primary.url == "other.db"
assert primary.adapter.or_panic.to_s == Sqlite.to_s

# it: redacts passwords that contain a slash or an at sign
assert Registry.redact("postgres://user:pa/ss@host/db") == "postgres://***@host/db"
assert Registry.redact("postgres://user:p@ss@host/db?x=1") == "postgres://***@host/db?x=1"
assert Registry.redact("postgres://host/db") == "postgres://host/db"
