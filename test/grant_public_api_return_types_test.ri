module test/grant_public_api_return_types_test
import grant/base::{Base}
import grant/collection
import test/spec_helper::{register_spec_connections}

pub class PublicApiReturnTypeBook < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column author_id : Int64
  column owner_id : Int64
  column owner_type : String
  column title : String
end

pub class PublicApiReturnTypeAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column name : String

  has_many :books, class_name: PublicApiReturnTypeBook, foreign_key: :author_id
  has_many :owned_books, class_name: PublicApiReturnTypeBook, as: :owner
end

register_spec_connections

alias PublicApiRawScalarType = ::Grant::Adapter::Driver::Value

# it: preserves the class query API return types
assert typeof(PublicApiReturnTypeAuthor.all).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.all("JOIN books ON books.author_id = authors.id").or_panic).to_s == (Array(PublicApiReturnTypeAuthor) | ::Grant::Collection::Collection(PublicApiReturnTypeAuthor)).to_s
assert typeof(PublicApiReturnTypeAuthor.all("WHERE name = ?", ["Ada"] of ::Grant::Columns::Type).or_panic).to_s == (Array(PublicApiReturnTypeAuthor) | ::Grant::Collection::Collection(PublicApiReturnTypeAuthor)).to_s
assert typeof(PublicApiReturnTypeAuthor.first.or_panic).to_s == PublicApiReturnTypeAuthor?.to_s
assert typeof(PublicApiReturnTypeAuthor.first_strict.or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.find(1_i64).or_panic).to_s == PublicApiReturnTypeAuthor?.to_s
assert typeof(PublicApiReturnTypeAuthor.find_strict(1_i64).or_panic).to_s == PublicApiReturnTypeAuthor.to_s

assert typeof(PublicApiReturnTypeAuthor.find_by(name: "Ada").or_panic).to_s == PublicApiReturnTypeAuthor?.to_s
assert typeof(PublicApiReturnTypeAuthor.find_by({"name" => "Ada"}).or_panic).to_s == PublicApiReturnTypeAuthor?.to_s
assert typeof(PublicApiReturnTypeAuthor.find_by_strict(name: "Ada").or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.find_by_strict({"name" => "Ada"}).or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.sole.or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.find_sole_by(name: "Ada").or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.find_sole_by({"name" => "Ada"}).or_panic).to_s == PublicApiReturnTypeAuthor.to_s

assert typeof(PublicApiReturnTypeAuthor.find_each(&.name).or_panic).to_s == Nil.to_s
assert typeof(PublicApiReturnTypeAuthor.find_in_batches(&.size).or_panic).to_s == Nil.to_s
# `query` stays undeclared: it returns the query log wrapper's result, which varies with
# the logging setup.
assert typeof(PublicApiReturnTypeAuthor.scalar("SELECT 1").or_panic).to_s == PublicApiRawScalarType.to_s
assert typeof(PublicApiReturnTypeAuthor.scalar("SELECT 1") { |value| value.nil? ? nil : value.to_s }.or_panic).to_s == String?.to_s
assert typeof(PublicApiReturnTypeAuthor.scalar("SELECT ?", [1_i64] of ::Grant::Columns::Type) { |value| value.nil? ? nil : value.to_s }.or_panic).to_s == String?.to_s
assert typeof(PublicApiReturnTypeAuthor.new.reload.or_panic).to_s == PublicApiReturnTypeAuthor.to_s

# it: preserves every model where overload return type
assert typeof(PublicApiReturnTypeAuthor.where(name: "Ada")).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.where({"name" => "Ada"})).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.where(:name, :eq, "Ada")).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.where("name = ?", "Ada")).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.where("name = ? OR name = ?", "Ada", "Grace")).to_s == ::Grant::Query::Builder::Builder(PublicApiReturnTypeAuthor).to_s
assert typeof(PublicApiReturnTypeAuthor.where).to_s == ::Grant::Query::WhereChain::WhereChain(PublicApiReturnTypeAuthor).to_s

# it: preserves the lazy collection and transaction API return types
assert typeof(::Grant::Collection::Collection(PublicApiReturnTypeAuthor).new(-> { [] of PublicApiReturnTypeAuthor })).to_s == ::Grant::Collection::Collection(PublicApiReturnTypeAuthor).to_s
assert typeof(::Grant::Collection::Collection(PublicApiReturnTypeAuthor).new(-> { [] of PublicApiReturnTypeAuthor }).loaded?).to_s == Bool.to_s
assert typeof(::Grant::Errors::RecordDestroyedError.new("Author", "save")).to_s == ::Grant::Errors::RecordDestroyedError.to_s

# `clear` stays undeclared: it returns whatever the adapter's query log returns, which varies
# with the logging setup.
assert typeof(PublicApiReturnTypeAuthor.create(name: "Ada")).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.create({"name" => "Ada"})).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.create_strict(name: "Ada").or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.create_strict({"name" => "Ada"}).or_panic).to_s == PublicApiReturnTypeAuthor.to_s
assert typeof(PublicApiReturnTypeAuthor.import_records([] of PublicApiReturnTypeAuthor).or_panic).to_s == Nil.to_s
assert typeof(PublicApiReturnTypeAuthor.import_records(::Grant::Collection::Collection(PublicApiReturnTypeAuthor).new(-> { [] of PublicApiReturnTypeAuthor })).or_panic).to_s == Nil.to_s
assert typeof(PublicApiReturnTypeAuthor.import_records([] of PublicApiReturnTypeAuthor, update_on_duplicate: true, columns: ["name"]).or_panic).to_s == Nil.to_s
assert typeof(PublicApiReturnTypeAuthor.import_records([] of PublicApiReturnTypeAuthor, ignore_on_duplicate: true).or_panic).to_s == Nil.to_s

# Check the lazy collection's forwarded reads without executing type-only SQL expressions.
loads = 0
collection = ::Grant::Collection::Collection(Int32).new(-> { loads += 1; [1, 2] })
assert !collection.loaded?
assert loads == 0
assert collection.size == 2
assert collection.loaded?
assert collection.to_a == [1, 2]
assert collection.map { |value| value + 1 } == [2, 3]
assert loads == 1
