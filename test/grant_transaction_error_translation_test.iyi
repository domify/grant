module test/grant_transaction_error_translation_test
import grant/base::{Base}
import grant/error_taxonomy::{StatementInvalid, InvalidForeignKey, SerializationFailure}
import grant/transaction::{TransactionState, ReadOnlyError, IsolationLevel}
import grant/errors::{ErrorBase}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: raises a StatementInvalid from a failing statement inside a savepoint and keeps the outer work
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Kept").or_panic
  error = Parent.transaction(requires_new: true) do
    Parent.connection.execute("INSERT INTO no_such_table_for_translation_spec (x) VALUES (1)")
  end
  assert error.is_a?(StatementInvalid)
  Parent.create_strict(name: "After").or_panic
end.or_panic
assert Parent.all.or_panic.map { |parent| parent.name.to_s }.sorted == ["After", "Kept"]

# it: translates a constraint failure raised by COMMIT itself
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_children").or_panic
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_owners").or_panic
Parent.connection.execute("CREATE TABLE deferred_translation_owners (id INTEGER PRIMARY KEY)").or_panic
Parent.connection.execute("CREATE TABLE deferred_translation_children (owner_id INTEGER REFERENCES deferred_translation_owners (id) DEFERRABLE INITIALLY DEFERRED)").or_panic
error = Parent.transaction do
  Parent.connection.execute("INSERT INTO deferred_translation_children (owner_id) VALUES (42)")
end
assert error.is_a?(InvalidForeignKey)
assert error.as(InvalidForeignKey).sql == "COMMIT"
assert TransactionState.current_state?.nil?
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_children").or_panic
Parent.connection.execute("DROP TABLE IF EXISTS deferred_translation_owners").or_panic

if Parent.adapter.postgres?
  # it: raises Transaction::ReadOnlyError for a write inside a read-only transaction
  Parent.clear.or_panic
  error = Parent.transaction(readonly: true) do
    Parent.connection.execute("INSERT INTO parents (name) VALUES ('Rejected')")
  end
  assert error.is_a?(ReadOnlyError)
  assert Parent.count.or_panic == 0

  # it: raises SerializationFailure when a serializable transaction loses a write-skew race
  Parent.clear.or_panic
  second_read = Channel(Nil).new(1)
  first_committed = Channel(Nil).new
  results = [] of ErrorBase?
  serializable = IsolationLevel::Serializable
  group do |tasks|
    tasks.spawn do
      outcome = Parent.transaction(isolation: serializable) do
        Parent.where(name: "skew").count.or_panic
        second_read.receive.or_panic
        Parent.connection.execute("INSERT INTO parents (name) VALUES ('first')")
      end
      first_committed.send(nil).or_panic
      results << (outcome.is_a?(ErrorBase) ? outcome : nil)
    end

    tasks.spawn do
      outcome = Parent.transaction(isolation: serializable) do
        Parent.where(name: "first").count.or_panic
        second_read.send(nil).or_panic
        first_committed.receive.or_panic
        Parent.connection.execute("INSERT INTO parents (name) VALUES ('skew')")
      end
      results << (outcome.is_a?(ErrorBase) ? outcome : nil)
    end
  end
  failure = results.compact.first?
  assert failure.is_a?(SerializationFailure)
  # Grant::Transaction::SerializationError is an alias of SerializationFailure.
  assert failure.is_a?(::Grant::Transaction::SerializationError)
  assert results.compact.size == 1
end
Parent.adapter.close.or_panic
