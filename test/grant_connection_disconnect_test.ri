module test/grant_connection_disconnect_test
import grant/base::{Base}
import grant/adapter/base
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/errors::{DatabaseError}
import grant/connection_registry::{ConnectionRegistry}
import grant/health_monitor::{HealthMonitorRegistry}
import grant/replica_load_balancer
import test/pool_spec_support::{C02Support}
import test/spec_helper::{CURRENT_ADAPTER}

pub class C02LockProbeAdapter < Sqlite
  @@lookups : Int32 = 0

  def self.lookups : Int32
    @@lookups
  end

  def self.lookups=(value : Int32) : Int32
    @@lookups = value
  end

  def disconnect_strict : Nil | DatabaseError
    ConnectionRegistry.establish_connection(
      database: "c02_probe_#{@@lookups}", adapter: Sqlite, url: "sqlite3::memory:", role: :writing).or_panic
    C02LockProbeAdapter.lookups += 1
    super
  end
end

pub class C02DisconnectModel < Base
  table c02_disconnect_models
  column id : Int64, primary: true
  connects_to database: "c02_disconnect"
end

def used_adapter(role : Symbol = :writing) : ::Grant::Adapter::Base::Base
  adapter = C02Support.establish("c02_disconnect", role, pool_size: 3)
  adapter.open { |db| db.scalar("SELECT 1") }.or_panic
  adapter
end


# it: closes the old pool when a connection is replaced
adapter = used_adapter
old_pool = adapter.database.or_panic
assert old_pool.pool.stats.open_connections > 0

replacement = used_adapter

assert !(replacement.object_id == adapter.object_id)
assert old_pool.pool.stats.open_connections == 0
assert !(adapter.connected?)
assert replacement.connected?
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: closes every pool on clear_all
writer = used_adapter(:writing)
reader = used_adapter(:reading)
pools = [writer.database.or_panic, reader.database.or_panic]

ConnectionRegistry.clear_all.or_panic

pools.each { |pool| assert pool.pool.stats.open_connections == 0 }
assert ConnectionRegistry.adapter_names.empty?
assert !(ConnectionRegistry.connection_exists?("c02_disconnect", :writing))
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: removes one connection, stops its monitor and closes its pool
adapter = used_adapter
pool = adapter.database.or_panic
assert !HealthMonitorRegistry.get("c02_disconnect:writing").nil?

assert ConnectionRegistry.remove_connection("c02_disconnect", :writing).or_panic

assert pool.pool.stats.open_connections == 0
assert HealthMonitorRegistry.get("c02_disconnect:writing").nil?
assert !(ConnectionRegistry.connection_exists?("c02_disconnect", :writing))
assert !(ConnectionRegistry.remove_connection("c02_disconnect", :writing).or_panic)
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: drops a removed replica from the load balancer, and the balancer with the last one
used_adapter(:reading)
assert ConnectionRegistry.get_load_balancer("c02_disconnect").as(::Grant::ReplicaLoadBalancer::ReplicaLoadBalancer).size == 1

ConnectionRegistry.remove_connection("c02_disconnect", :reading)

assert ConnectionRegistry.get_load_balancer("c02_disconnect").nil?
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: closes pools after the registry lock is released
ConnectionRegistry.establish_connection(
  database: "c02_disconnect", adapter: C02LockProbeAdapter, url: C02Support.url("c02_disconnect"), role: :writing)
ConnectionRegistry.establish_connection(
  database: "c02_disconnect", adapter: C02LockProbeAdapter, url: C02Support.url("c02_disconnect"), role: :writing)
assert C02LockProbeAdapter.lookups == 1

ConnectionRegistry.remove_connection("c02_disconnect", :writing)
assert C02LockProbeAdapter.lookups == 2

ConnectionRegistry.establish_connection(
  database: "c02_disconnect", adapter: C02LockProbeAdapter, url: C02Support.url("c02_disconnect"), role: :writing)
ConnectionRegistry.clear_all.or_panic
assert C02LockProbeAdapter.lookups == 3
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: keeps connections registered on disconnect_all! and reopens them on next use
adapter = used_adapter

ConnectionRegistry.disconnect_all_strict.or_panic

assert !(adapter.connected?)
assert ConnectionRegistry.connection_exists?("c02_disconnect", :writing)
assert adapter.open { |db| db.scalar("SELECT 1") }.or_panic == 1
assert adapter.connected?
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: reopens a disconnected adapter that something still references
adapter = used_adapter
adapter.disconnect_strict.or_panic
assert adapter.pool_stat.connections == 0

assert adapter.open { |db| db.scalar("SELECT 1") }.or_panic == 1
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

# it: establishes, inspects, disconnects and removes the model's connection
C02DisconnectModel.establish_connection(
  url: C02Support.url("c02_disconnect"), adapter: (CURRENT_ADAPTER == "pg" ? Pg : Sqlite), pool_size: 4)

assert C02DisconnectModel.connected?
assert C02DisconnectModel.connection_pool.stat.size == 4
assert !C02DisconnectModel.retrieve_connection_pool.nil?

C02DisconnectModel.disconnect_strict.or_panic
assert !(C02DisconnectModel.connection_pool.connected?)

assert C02DisconnectModel.remove_connection.or_panic
assert C02DisconnectModel.retrieve_connection_pool.nil?
assert !(C02DisconnectModel.connected?)
assert !(C02DisconnectModel.remove_connection.or_panic)
ConnectionRegistry.clear_all.or_panic
C02LockProbeAdapter.lookups = 0

C02Support.cleanup
