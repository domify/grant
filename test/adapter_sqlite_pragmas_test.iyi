module test/adapter_sqlite_pragmas_test

import grant/adapter/sqlite::{Sqlite}
import grant/adapter/driver::{Value}
import grant/error_taxonomy::{InvalidForeignKey, LockWaitTimeout}
import std/file::{File}
import std/env
import std/uuid::{UUID}
import std/text

private def temp_sqlite_path : String
  "#{ENV["TMPDIR"]? || "build/tmp"}/grant_g01_pragmas_#{UUID.v4}.sqlite3"
end

private def remove_sqlite_files(path : String) : Nil
  ["", "-wal", "-shm", "-journal"].each do |suffix|
    filename = "#{path}#{suffix}"
    File.delete(filename) if File.exists?(filename)
  end
  nil
end

private def pragma(adapter : Sqlite, name : String) : String
  adapter.open { |db| db.scalar("PRAGMA #{name}").or_panic.to_s }.or_panic
end

# it: appends every default for a file URL without a query
private def example_1 : Nil
  assert Sqlite.url_with_pragmas("sqlite3:/tmp/app.db") == "sqlite3:/tmp/app.db?foreign_keys=1&journal_mode=wal&busy_timeout=5000&synchronous=normal"
  nil
end
example_1

# it: keeps explicit URL parameters and adds only the missing ones
private def example_2 : Nil
  assert Sqlite.url_with_pragmas("sqlite3:/tmp/app.db?busy_timeout=250&other=1") == "sqlite3:/tmp/app.db?busy_timeout=250&other=1&foreign_keys=1&journal_mode=wal&synchronous=normal"
  nil
end
example_2

# it: lets an explicit foreign_keys=0 win
private def example_3 : Nil
  assert Sqlite.url_with_pragmas("sqlite3:/tmp/app.db?foreign_keys=0").includes?("foreign_keys=0")
  assert !Sqlite.url_with_pragmas("sqlite3:/tmp/app.db?foreign_keys=0").includes?("foreign_keys=1")
  nil
end
example_3

# it: applies overrides over defaults, and lets the URL win over both
private def example_4 : Nil
  overrides = {"journal_mode" => "delete", "cache_size" => "-2000"}
  url = Sqlite.url_with_pragmas("sqlite3:/tmp/app.db?synchronous=full", overrides)
  assert url.includes?("journal_mode=delete")
  assert url.includes?("cache_size=-2000")
  assert url.includes?("synchronous=full")
  assert !url.includes?("synchronous=normal")
  assert !url.includes?("journal_mode=wal")
  nil
end
example_4

# it: only enforces foreign keys for in-memory databases
private def example_5 : Nil
  url = Sqlite.url_with_pragmas("sqlite3::memory:")
  assert url == "sqlite3::memory:?foreign_keys=1"
  nil
end
example_5

# it: recognizes memory databases
private def example_6 : Nil
  assert Sqlite.memory_url?("sqlite3::memory:")
  assert Sqlite.memory_url?("sqlite3:file:x?mode=memory")
  assert !Sqlite.memory_url?("sqlite3:/tmp/app.db")
  nil
end
example_6

# it: applies the defaults to every connection
private def example_7 : Nil
  path = temp_sqlite_path
  adapter = Sqlite.new(name: "g01_defaults", url: "sqlite3:#{path}")
  assert pragma(adapter, "foreign_keys") == "1"
  assert pragma(adapter, "journal_mode") == "wal"
  assert pragma(adapter, "busy_timeout") == "5000"
  assert pragma(adapter, "synchronous") == "1"
  adapter.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_7

# it: lets explicit URL parameters win
private def example_8 : Nil
  path = temp_sqlite_path
  adapter = Sqlite.new(
    name: "g01_explicit",
    url: "sqlite3:#{path}?foreign_keys=0&journal_mode=delete&busy_timeout=123&synchronous=full")
  assert pragma(adapter, "foreign_keys") == "0"
  assert pragma(adapter, "journal_mode") == "delete"
  assert pragma(adapter, "busy_timeout") == "123"
  assert pragma(adapter, "synchronous") == "2"
  adapter.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_8

# it: accepts a pragmas override for the connection
private def example_9 : Nil
  path = temp_sqlite_path
  adapter = Sqlite.new(name: "g01_override", url: "sqlite3:#{path}", pragmas: {journal_mode: "delete", busy_timeout: 42})
  assert pragma(adapter, "journal_mode") == "delete"
  assert pragma(adapter, "busy_timeout") == "42"
  assert pragma(adapter, "foreign_keys") == "1"
  adapter.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_9

# it: enforces declared foreign keys and reports them as InvalidForeignKey
private def example_10 : Nil
  path = temp_sqlite_path
  adapter = Sqlite.new(name: "g01_fk", url: "sqlite3:#{path}")
  adapter.open do |db|
    db.exec("CREATE TABLE g01_owners (id INTEGER PRIMARY KEY)").or_panic
    db.exec("CREATE TABLE g01_pets (id INTEGER PRIMARY KEY, owner_id INTEGER REFERENCES g01_owners(id))")
  end.or_panic
  error = adapter.open("INSERT INTO g01_pets (owner_id) VALUES (?)", [99_i64] of Value) do |db|
    db.exec("INSERT INTO g01_pets (owner_id) VALUES (?)", [99_i64] of Value)
  end
  assert error.is_a?(InvalidForeignKey)
  assert error.as(InvalidForeignKey).sql == "INSERT INTO g01_pets (owner_id) VALUES (?)"
  adapter.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_10

# it: does not enforce foreign keys when the URL turns them off
private def example_11 : Nil
  path = temp_sqlite_path
  adapter = Sqlite.new(name: "g01_fk_off", url: "sqlite3:#{path}?foreign_keys=0")
  adapter.open do |db|
    db.exec("CREATE TABLE g01_owners (id INTEGER PRIMARY KEY)").or_panic
    db.exec("CREATE TABLE g01_pets (id INTEGER PRIMARY KEY, owner_id INTEGER REFERENCES g01_owners(id))").or_panic
    db.exec("INSERT INTO g01_pets (owner_id) VALUES (99)")
  end.or_panic
  adapter.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_11

# it: waits for a busy database instead of failing at once
private def example_12 : Nil
  path = temp_sqlite_path
  writer = Sqlite.new(name: "g01_busy_writer", url: "sqlite3:#{path}")
  impatient = Sqlite.new(name: "g01_busy_impatient", url: "sqlite3:#{path}?busy_timeout=0")
  writer.open { |db| db.exec("CREATE TABLE g01_items (id INTEGER PRIMARY KEY)") }.or_panic
  writer.database.or_panic.using_connection do |holder|
    holder.exec("BEGIN IMMEDIATE").or_panic
    error = impatient.open("INSERT INTO g01_items DEFAULT VALUES") do |db|
      db.exec("INSERT INTO g01_items DEFAULT VALUES")
    end
    assert error.is_a?(LockWaitTimeout)
    holder.exec("ROLLBACK")
  end.or_panic
  writer.close.or_panic
  impatient.close.or_panic
  remove_sqlite_files(path)
  nil
end
example_12

# Every physical connection receives the same URL options, including replacements.
path = temp_sqlite_path
pooled = Sqlite.new("g01_pool", "sqlite3:#{path}?max_pool_size=2")
pooled.database.or_panic.using_connection do |first|
  pooled.database.or_panic.using_connection do |second|
    assert first.object_id != second.object_id
    assert second.scalar("PRAGMA foreign_keys").or_panic == 1_i64
    assert second.scalar("PRAGMA journal_mode").or_panic == "wal"
    assert second.scalar("PRAGMA busy_timeout").or_panic == 5000_i64
    assert second.scalar("PRAGMA synchronous").or_panic == 1_i64
  end.or_panic
end.or_panic
pooled.reconnect_strict.or_panic
assert pragma(pooled, "journal_mode") == "wal"
pooled.close.or_panic
remove_sqlite_files(path)
