module test/grant_validation_helpers_inequality_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class LessThanTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column int_32_lt : Int32?
  column float_32_lt : Float32?
  column int_32_lte : Int32?
  column float_32_lte : Float32?

  validate_less_than "int_32_lt", 10
  validate_less_than :float_32_lt, 20.5
  validate_less_than :int_32_lte, 50, true
  validate_less_than "float_32_lte", 100.25, true
end

pub class GreaterThanTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column int_32_lt : Int32?
  column float_32_lt : Float32?
  column int_32_lte : Int32?
  column float_32_lte : Float32?

  validate_greater_than "int_32_lt", 10
  validate_greater_than :float_32_lt, 20.5
  validate_greater_than :int_32_lte, 50, true
  validate_greater_than "float_32_lte", 100.25, true
end

register_spec_connections
LessThanTest.migrator.drop_and_create.or_panic
GreaterThanTest.migrator.drop_and_create.or_panic

# it: should work for less_than
record = LessThanTest.new
record.int_32_lt = 10
record.float_32_lt = 20.5.to_f32
record.int_32_lte = 52
record.float_32_lte = 155.55.to_f32
record.save.or_panic
assert record.errors.size == 4
assert record.errors[0].message == "int_32_lt must be less than 10"
assert record.errors[1].message == "float_32_lt must be less than 20.5"
assert record.errors[2].message == "int_32_lte must be less than or equal to 50"
assert record.errors[3].message == "float_32_lte must be less than or equal to 100.25"

# Native save returns Bool; its strict variant retains the upstream raised error.
error = LessThanTest.new.save_strict
assert error.is_a?(::Grant::Encryption::Sealed::NilAssertionError)
assert error.as(::Grant::Error::ErrorBase).message == "Nil assertion failed"

# it: should work for greater_than
record = GreaterThanTest.new
record.int_32_lt = 10
record.float_32_lt = 20.5.to_f32
record.int_32_lte = 49
record.float_32_lte = 100.20.to_f32
record.save.or_panic
assert record.errors.size == 4
assert record.errors[0].message == "int_32_lt must be greater than 10"
assert record.errors[1].message == "float_32_lt must be greater than 20.5"
assert record.errors[2].message == "int_32_lte must be greater than or equal to 50"
assert record.errors[3].message == "float_32_lte must be greater than or equal to 100.25"

# Native save returns Bool; its strict variant retains the upstream raised error.
error = GreaterThanTest.new.save_strict
assert error.is_a?(::Grant::Encryption::Sealed::NilAssertionError)
assert error.as(::Grant::Error::ErrorBase).message == "Nil assertion failed"

LessThanTest.migrator.drop.or_panic
GreaterThanTest.migrator.drop.or_panic
