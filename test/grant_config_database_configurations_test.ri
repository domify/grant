module test/grant_config_database_configurations_test
import grant
import grant/base::{Base}
import grant/database_configurations::{DatabaseConfigurations, DatabaseConfigurationError, DatabaseConfig}
import grant/adapter/registry::{UnknownAdapterError}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/adapter/mysql::{Mysql}
import grant/connection_registry::{ConnectionRegistry}
import grant/adapter/pool_support::{ticks}
import std/dir::{Dir}
import std/file::{File}

pub class C03ConfigModel < Base
  connects_to database: "c03cfg_db"
  table c03_config_models
  column id : Int64, primary: true
end

C03_CONFIG_YAML = <<-YAML
  development:
    primary:
      url: sqlite3:./dev.db
  production:
    primary:
      url: postgres://prod-writer/app
      pool: 10
    primary_replica:
      url: postgres://prod-reader/app
      replica: true
    reports:
      url: mysql://prod-reports/reports
      database_tasks: false
    legacy:
      adapter: sqlite
      url: file-legacy.db
  YAML

def c03_env(values : Hash(String, String)) : Proc(String, String?)
  ->(key : String) { values[key]? }
end


# it: lists every configuration of an environment with typed values
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", c03_env({} of String => String)).or_panic
production = configs.configs_for(env: "production")

assert production.map(&.name) == ["primary", "primary_replica", "reports", "legacy"]
primary = production.first
assert primary.adapter.or_panic.to_s == Pg.to_s
assert primary.pool_size == 10
assert !primary.replica?
assert primary.database_tasks?
assert primary.role == :writing
assert primary.scheme == "postgres"

# it: marks replicas, attaches them to their database, and tracks database_tasks
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", c03_env({} of String => String)).or_panic

replica = configs.db_config("primary_replica").or_panic
assert replica.replica?
assert replica.database == "primary"
assert replica.role == :reading
assert configs.configs_for(env: "production", include_replicas: false).map(&.name) == ["primary", "reports", "legacy"]
assert !configs.db_config("reports").or_panic.database_tasks?
assert configs.db_config("reports").or_panic.adapter.or_panic.to_s == Mysql.to_s
assert configs.config_for_database("primary", replica: true).as(DatabaseConfig).url == "postgres://prod-reader/app"

# it: filters by environment and name
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", c03_env({} of String => String)).or_panic

assert configs.configs_for(env: "development").map(&.url) == ["sqlite3:./dev.db"]
assert configs.configs_for(name: "primary").map(&.env) == ["development", "production"]
assert configs.configs_for(env: "production", name: "reports").size == 1
assert configs.configs_for(env: "staging").empty?
assert configs.find_db_config("missing").nil?
missing = configs.db_config("missing")
assert missing.is_a?(DatabaseConfigurationError)
assert missing.as(DatabaseConfigurationError).message.includes?("missing")

# it: lets DATABASE_URL replace the primary url of the current environment only
env = c03_env({"DATABASE_URL" => "postgres://override/app"})
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", env).or_panic

primary = configs.db_config("primary").or_panic
assert primary.url == "postgres://override/app"
assert primary.pool_size == 10
assert configs.db_config("primary", "development").or_panic.url == "sqlite3:./dev.db"
assert configs.db_config("reports").or_panic.url == "mysql://prod-reports/reports"

# it: lets a per-name <NAME>_DATABASE_URL win over DATABASE_URL for that name
env = c03_env({
  "DATABASE_URL"         => "postgres://generic/app",
  "PRIMARY_DATABASE_URL" => "postgres://specific/app",
  "REPORTS_DATABASE_URL" => "postgres://reports-override/reports",
})
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", env).or_panic

assert configs.db_config("primary").or_panic.url == "postgres://specific/app"
assert configs.db_config("reports").or_panic.url == "postgres://reports-override/reports"
assert configs.db_config("reports").or_panic.adapter.or_panic.to_s == Pg.to_s
assert !configs.db_config("reports").or_panic.database_tasks?
assert configs.db_config("primary_replica").or_panic.url == "postgres://prod-reader/app"

# it: builds the primary from DATABASE_URL when the environment is not in the file
env = c03_env({"DATABASE_URL" => "mysql://only-env/app"})
configs = DatabaseConfigurations.parse(C03_CONFIG_YAML, "staging", env).or_panic

assert configs.configs_for(env: "staging").map { |config| {config.name, config.adapter.or_panic.to_s} } == [{"primary", Mysql.to_s}]

# it: ignores an empty override
env = c03_env({"DATABASE_URL" => ""})
assert DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", env).or_panic.db_config("primary").or_panic.url == "postgres://prod-writer/app"

# it: takes an explicit adapter key over the URL scheme
assert DatabaseConfigurations.parse(C03_CONFIG_YAML, "production", c03_env({} of String => String)).or_panic.db_config("legacy").or_panic.adapter.or_panic.to_s == Sqlite.to_s

# it: reports a missing url, an unknown adapter, and malformed YAML
error = DatabaseConfigurations.parse("test:\n  primary:\n    pool: 3\n", "test", c03_env({} of String => String))
assert error.is_a?(DatabaseConfigurationError)
assert error.as(DatabaseConfigurationError).message.includes?("no url")
assert DatabaseConfigurations.parse("test:\n  primary:\n    url: oracle://h/d\n", "test", c03_env({} of String => String)).is_a?(UnknownAdapterError)
error = DatabaseConfigurations.parse("test: [unclosed", "test", c03_env({} of String => String))
assert error.is_a?(DatabaseConfigurationError)
assert error.as(DatabaseConfigurationError).message.includes?("Invalid database configuration")

# it: loads from a file path
path = File.join(Dir.tempdir, "c03_database_#{ticks}.yml")
File.write(path, C03_CONFIG_YAML)
assert DatabaseConfigurations.load(path, "development", c03_env({} of String => String)).or_panic.db_config("primary").or_panic.adapter.or_panic.to_s == Sqlite.to_s
File.delete(path)

# it: never prints credentials in redacted_url
config = DatabaseConfigurations.parse("test:\n  primary:\n    url: postgres://user:hunter2@h/d\n", "test", c03_env({} of String => String)).or_panic.db_config("primary").or_panic
assert !config.redacted_url.includes?("hunter2")

# it: registers primaries as writing and replicas as reading, and exposes the model's db_config
yaml = <<-YAML
  test:
    c03cfg_db:
      url: "sqlite3::memory:"
    c03cfg_db_replica:
      url: "sqlite3::memory:"
      replica: true
  YAML
previous = ::Grant.configurations?
configs = DatabaseConfigurations.parse(yaml, "test", c03_env({} of String => String)).or_panic
assert configs.establish_connections.or_panic.size == 2
assert ConnectionRegistry.connection_exists?("c03cfg_db", :writing)
assert ConnectionRegistry.connection_exists?("c03cfg_db", :reading)

::Grant.configurations = configs
assert C03ConfigModel.connected_to(role: :writing) { C03ConfigModel.connection_db_config.or_panic.name } == "c03cfg_db"
assert C03ConfigModel.connected_to(role: :reading) { C03ConfigModel.connection_db_config.or_panic }.replica?
::Grant.configurations = previous
ConnectionRegistry.remove_connection("c03cfg_db", :writing).or_panic
ConnectionRegistry.remove_connection("c03cfg_db", :reading).or_panic
