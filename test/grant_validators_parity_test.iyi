module test/grant_validators_parity_test
import grant/base::{Base}
import grant/validators::{Validator, EachValidator}
import grant/errors::{Errors}
import test/validation_details_support::{same_details?}
import std/text

# =============================================================================
# Validation parity features:
#   - validate :method_name (bare Symbol)
#   - validates_with (reusable validator class) + validates_each
#   - validates_comparison_of / validates_absence_of
#   - invalid?
#   - errors.details (typed codes)
#   - Proc/lambda if:/unless: conditions on validations
# =============================================================================

# --- validate :method_name -------------------------------------------------
pub class MethodValidationModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table method_validation_models

  column id : Int64, primary: true
  column total : Int32 = 0
  column discount : Int32 = 0

  validate :discount_within_total

  private def discount_within_total : Nil
    if discount > total
      errors.add(:discount, "cannot exceed total", type: :greater_than)
    end
    nil
  end
end

# bare-symbol validate scoped to a context + conditional
pub class MethodValidationContextModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table method_validation_context_models

  column id : Int64, primary: true
  column flagged : Bool = false
  column run_check : Bool = true

  validate :must_not_be_flagged, on: :update, if: :run_check?

  def run_check? : Bool
    !!run_check
  end

  private def must_not_be_flagged : Nil
    errors.add(:base, "flagged", type: :invalid) if flagged
    nil
  end
end

# --- validates_with / EachValidator ----------------------------------------
pub class EvenValueValidator < Validator
  def validate(record) : Nil
    record = record.as(WithValidatorModel)
    if (v = record.value) && v.odd?
      record.errors.add(:value, "must be even", type: :even)
    end
    nil
  end
end

pub class ConfigurableValidator < Validator
  def initialize(@limit : Int32)
  end

  def validate(record) : Nil
    record = record.as(WithValidatorModel)
    if (v = record.value) && v > @limit
      record.errors.add(:value, "exceeds #{@limit}", type: :too_big)
    end
    nil
  end
end

pub class WithValidatorModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table with_validator_models

  column id : Int64, primary: true
  column value : Int32?

  validates_with EvenValueValidator
  validates_with ConfigurableValidator, limit: 100
end

# EachValidator via validates_each
pub class PresenceEach < EachValidator
  def validate_each(record, attribute, value) : Nil
    if value.nil? || value.to_s.strip.empty?
      record.errors.add(attribute, "can't be blank", type: :blank)
    end
    nil
  end
end

pub class EachValidatorModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table each_validator_models

  column id : Int64, primary: true
  column name : String?
  column nickname : String?

  validates_each :name, :nickname, with: PresenceEach
end

# --- validates_comparison_of / validates_absence_of ------------------------
pub class ComparisonModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table comparison_models

  column id : Int64, primary: true
  column age : Int32?
  column started_at : Int32?
  column ended_at : Int32?
  column status : String?

  validates_comparison_of :age, greater_than_or_equal_to: 18
  validates_comparison_of :ended_at, greater_than: :started_at, allow_nil: true
  validates_comparison_of :status, other_than: "archived", allow_nil: true
end

pub class AbsenceModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table absence_models

  column id : Int64, primary: true
  column legacy_token : String?

  validates_absence_of :legacy_token
end

# --- Proc/lambda conditions ------------------------------------------------
pub class ProcConditionModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table proc_condition_models

  column id : Int64, primary: true
  column kind : String = "draft"
  column reason : String?

  # Proc condition: only require reason when kind == "published"
  validates_presence_of :reason, if: ->(r : ProcConditionModel) { r.kind == "published" }
end

pub class ProcUnlessModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table proc_unless_models

  column id : Int64, primary: true
  column skip : Bool = false
  column name : String?

  validates_presence_of :name, unless: ->(r : ProcUnlessModel) { !!r.skip }
end

pub class LengthDetailsModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table length_details_models

  column id : Int64, primary: true
  column code : String?

  validates_length_of :code, minimum: 4
end

# it: passes when the referenced method adds no errors
m = MethodValidationModel.new
m.total = 100
m.discount = 10
assert m.valid?.or_panic

# it: fails when the referenced method adds an error
m = MethodValidationModel.new
m.total = 100
m.discount = 150
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("discount")
assert m.errors[:discount].includes?("cannot exceed total")

# it: does not surface the placeholder :base entry when valid
m = MethodValidationModel.new
m.total = 100
m.discount = 10
m.valid?.or_panic
assert m.errors.size == 0

# it: respects on: context (skips on create, runs on update)
m = MethodValidationContextModel.new
m.flagged = true
assert m.valid?(context: :create).or_panic
assert !m.valid?(context: :update).or_panic

# it: respects if: condition on bare-symbol validate
m = MethodValidationContextModel.new
m.flagged = true
m.run_check = false
assert m.valid?(context: :update).or_panic

# it: passes when the validator records no errors
m = WithValidatorModel.new
m.value = 4
assert m.valid?.or_panic

# it: fails when the reusable validator records an error
m = WithValidatorModel.new
m.value = 3
assert !m.valid?.or_panic
assert m.errors[:value].includes?("must be even")

# it: forwards constructor arguments to a configurable validator
m = WithValidatorModel.new
m.value = 200 # even, but over limit 100
assert !m.valid?.or_panic
assert m.errors[:value].includes?("exceeds 100")

# it: passes both validators when value is even and under limit
m = WithValidatorModel.new
m.value = 50
assert m.valid?.or_panic

# it: runs the each-validator per attribute and fails on blanks
m = EachValidatorModel.new
m.name = "set"
m.nickname = nil
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("nickname")
assert !m.errors.map(&.field.to_s).includes?("name")

# it: passes when all attributes are present
m = EachValidatorModel.new
m.name = "set"
m.nickname = "nick"
assert m.valid?.or_panic

# it: passes when comparison holds
m = ComparisonModel.new
m.age = 21
assert m.valid?.or_panic

# it: fails when value is less than greater_than_or_equal_to operand
m = ComparisonModel.new
m.age = 17
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("age")

# it: supports a Symbol operand naming another attribute
m = ComparisonModel.new
m.age = 21
m.started_at = 10
m.ended_at = 5 # ended before started -> invalid
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("ended_at")

m.ended_at = 20 # after started -> valid
assert m.valid?.or_panic

# it: supports other_than with a literal
m = ComparisonModel.new
m.age = 21
m.status = "archived"
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("status")

m.status = "active"
assert m.valid?.or_panic

# it: passes when the field is nil/blank
m = AbsenceModel.new
m.legacy_token = nil
assert m.valid?.or_panic
m.legacy_token = "   "
assert m.valid?.or_panic

# it: fails when the field is present
m = AbsenceModel.new
m.legacy_token = "leftover"
assert !m.valid?.or_panic
assert m.errors[:legacy_token].includes?("must be blank")

# it: returns the inverse of valid?
m = MethodValidationModel.new
m.total = 100
m.discount = 10
assert !m.invalid?.or_panic

m.discount = 150
assert m.invalid?.or_panic

# it: honors the context argument
m = MethodValidationContextModel.new
m.flagged = true
assert !m.invalid?(context: :create).or_panic
assert m.invalid?(context: :update).or_panic

# it: exposes :blank for presence failures
m = ProcConditionModel.new
m.kind = "published"
m.reason = nil
assert !m.valid?.or_panic
assert same_details?(m.errors.details["reason"], [{:error => :blank}])

# it: exposes the custom type passed to errors.add
m = MethodValidationModel.new
m.total = 100
m.discount = 150
assert !m.valid?.or_panic
assert same_details?(m.errors.details["discount"], [{:error => :greater_than}])

# it: exposes :too_short for a minimum-length failure
m = LengthDetailsModel.new
m.code = "ab"
assert !m.valid?.or_panic
assert same_details?(m.errors.details["code"], [{:error => :too_short, :count => 4}])

# it: exposes :comparison for comparison failures
m = ComparisonModel.new
m.age = 5
assert !m.valid?.or_panic
assert same_details?(m.errors.details["age"], [{:error => :greater_than_or_equal_to, :count => 18, :value => 5}])

# it: falls back to :invalid when no type was provided
e = Errors.new
e.add(:name, "is weird")
assert same_details?(e.details["name"], [{:error => :invalid}])

# it: gates the validation by the proc result (if:)
m = ProcConditionModel.new
m.kind = "draft"
m.reason = nil
assert m.valid?.or_panic # reason not required for draft

m.kind = "published"
assert !m.valid?.or_panic # reason now required
assert m.errors.map(&.field.to_s).includes?("reason")

# it: gates the validation by the proc result (unless:)
m = ProcUnlessModel.new
m.skip = true
m.name = nil
assert m.valid?.or_panic # skipped

m.skip = false
assert !m.valid?.or_panic
assert m.errors.map(&.field.to_s).includes?("name")
