module test/grant_encryption_previous_schemes_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/encryption/cipher::{DecryptionError}
import std/base64::{Base64}
import test/spec_helper::{register_spec_connections}

PREV_ENC_KEY_NEW = Base64.encode("prev_current_key_32_bytes_long!!")
PREV_ENC_DET_NEW = Base64.encode("prev_current_det_32_bytes_long!!")
PREV_ENC_DET_MID = Base64.encode("prev_middle_det_32_bytes_long!!!")
PREV_ENC_DET_OLD = Base64.encode("prev_oldest_det_32_bytes_long!!!")
PREV_ENC_KEY_OLD = Base64.encode("prev_old_key_32_bytes_long!!!!!!")
PREV_ENC_SALT = "previous-schemes-salt"

pub class PrevEncPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table prev_enc_people
  column id : Int64, primary: true
  encrypts ssn : String, deterministic: true, previous: [
    {deterministic: true, key: PREV_ENC_DET_MID},
    {deterministic: true, key: PREV_ENC_DET_OLD},
  ]
  encrypts diary : String
end

private def raw(id : Int64?) : String
  PrevEncPerson.adapter.open do |db|
    db.scalar("SELECT ssn FROM prev_enc_people WHERE id = #{id}")
  end.or_panic.as(String)
end

register_spec_connections
Grant::Encryption.configure do |config|
  (config.primary_key = PREV_ENC_KEY_NEW).or_panic
  (config.deterministic_key = PREV_ENC_DET_NEW).or_panic
  config.key_derivation_salt = PREV_ENC_SALT
end
PrevEncPerson.migrator.drop_and_create.or_panic

# it: reads data written under an older scheme and writes new data with the current one
PrevEncPerson.clear.or_panic
attribute = PrevEncPerson.ssn_encrypted_attribute
older = Grant::Encryption.with_context(deterministic_key: PREV_ENC_DET_OLD) { PrevEncPerson.create_strict(ssn: "111-11-1111") }.or_panic
middle = Grant::Encryption.with_context(deterministic_key: PREV_ENC_DET_MID) { PrevEncPerson.create_strict(ssn: "222-22-2222") }.or_panic
current = PrevEncPerson.create_strict(ssn: "333-33-3333").or_panic
assert PrevEncPerson.find_strict(older.id).or_panic.ssn == "111-11-1111"
assert PrevEncPerson.find_strict(middle.id).or_panic.ssn == "222-22-2222"
assert PrevEncPerson.find_strict(current.id).or_panic.ssn == "333-33-3333"
assert attribute.open_with_index(raw(current.id)).or_panic == {"333-33-3333", 0}
assert attribute.open_with_index(raw(middle.id)).or_panic == {"222-22-2222", 1}
assert attribute.open_with_index(raw(older.id)).or_panic == {"111-11-1111", 2}
assert PrevEncPerson.find_strict(older.id).or_panic.encrypt.or_panic
assert attribute.open_with_index(raw(older.id)).or_panic == {"111-11-1111", 0}

# it: matches lookups against the current scheme only, until data is rewritten
PrevEncPerson.clear.or_panic
older = Grant::Encryption.with_context(deterministic_key: PREV_ENC_DET_OLD) { PrevEncPerson.create_strict(ssn: "444-44-4444") }.or_panic
assert PrevEncPerson.where(ssn: "444-44-4444").count.or_panic == 0
older.encrypt.or_panic
assert PrevEncPerson.where(ssn: "444-44-4444").count.or_panic == 1

# it: keeps a history of primary keys with Config.primary_keys
PrevEncPerson.clear.or_panic
written = Grant::Encryption.with_context(primary_key: PREV_ENC_KEY_OLD) { PrevEncPerson.create_strict(diary: "dear diary") }.or_panic
assert PrevEncPerson.find_strict(written.id).is_a?(DecryptionError)
(Config.primary_keys = [PREV_ENC_KEY_NEW, PREV_ENC_KEY_OLD]).or_panic
assert PrevEncPerson.find_strict(written.id).or_panic.diary == "dear diary"
fresh = PrevEncPerson.create_strict(diary: "new entry").or_panic
Grant::Encryption.with_context(primary_key: PREV_ENC_KEY_NEW) do
  assert PrevEncPerson.find_strict(fresh.id).or_panic.diary == "new entry"
end.or_panic
KeyProvider.previous_primary_keys = [] of String
# Removing a history invalidates the attribute's previously derived fallback keys.
assert PrevEncPerson.find_strict(written.id).is_a?(DecryptionError)
Grant::Encryption.with_context(primary_key: PREV_ENC_KEY_OLD) do
  assert PrevEncPerson.find_strict(written.id).or_panic.diary == "dear diary"
end.or_panic

# it: raises when no scheme can decrypt the value
PrevEncPerson.clear.or_panic
stranger = Grant::Encryption.with_context(deterministic_key: Base64.encode("stranger_det_32_bytes_long!!!!!!")) { PrevEncPerson.create_strict(ssn: "555-55-5555") }.or_panic
assert PrevEncPerson.find_strict(stranger.id).is_a?(DecryptionError)

KeyProvider.previous_primary_keys = [] of String
KeyProvider.previous_deterministic_keys = [] of String
KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
