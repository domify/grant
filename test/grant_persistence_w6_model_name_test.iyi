module test/grant_persistence_w6_model_name_test

import grant/base::{Base}
import grant/model_name
import grant/i18n

pub class ::W6Blog::Post < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_blog_posts
  column id : Int64, primary: true
  column first_name : String?
end
pub class ::W6Category < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_categories
  column id : Int64, primary: true
end
pub class ::W6Equipment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_equipment
  column id : Int64, primary: true
end


# it: has plural, collection, route_key, singular_route_key and param_key
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
name = W6Blog::Post.model_name
assert name.singular == "w6_blog_post"
assert name.plural == "w6_blog_posts"
assert name.collection == "w6_blog/posts"
assert name.route_key == "w6_blog_posts"
assert name.singular_route_key == "w6_blog_post"
assert name.param_key == "w6_blog_post"
assert name.i18n_key == "w6_blog/post"
assert name.element == "post"


# it: pluralizes irregular, y and uncountable names
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
assert W6Category.model_name.plural == "w6_categories"
assert W6Category.model_name.route_key == "w6_categories"
assert W6Equipment.model_name.plural == "w6_equipment"
assert W6Equipment.model_name.route_key == "w6_equipment_index"
assert W6Equipment.model_name.singular_route_key == "w6_equipment"

assert ::Grant::ModelName::ModelName.pluralize("person") == "people"
assert ::Grant::ModelName::ModelName.pluralize("box") == "boxes"
assert ::Grant::ModelName::ModelName.pluralize("order_item") == "order_items"
assert ::Grant::ModelName::ModelName.pluralize("blog_post") == "blog_posts"
assert ::Grant::ModelName::ModelName.pluralize("day") == "days"
assert ::Grant::ModelName::ModelName.pluralize("knife") == "knives"
assert ::Grant::ModelName::ModelName.pluralize("photo") == "photos"


# it: defaults to the humanized, unpluralized name
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
assert W6Category.model_name.human == "W6 category"
assert W6Category.model_name.human(count: 2) == "W6 category"


# it: prefers the one / other translation for a count
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
::Grant::I18n.store("models.w6_category.one", "Category")
::Grant::I18n.store("models.w6_category.other", "Categories")
assert W6Category.model_name.human(count: 1) == "Category"
assert W6Category.model_name.human(count: 3) == "Categories"
assert W6Category.model_name.human == "W6 category"


# it: falls back to models.<key> when there is no count translation
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
::Grant::I18n.store("models.w6_equipment", "Gear")
assert W6Equipment.model_name.human(count: 2) == "Gear"
assert W6Equipment.model_name.human == "Gear"


# it: titleizes by default and honors translations per locale
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
assert W6Blog::Post.human_attribute_name(:first_name) == "First name"
::Grant::I18n.store("attributes.w6_blog/post.first_name", "Prenom", "fr")
::Grant::I18n.with_locale("fr") { assert W6Blog::Post.human_attribute_name(:first_name) == "Prenom" }
assert W6Blog::Post.human_attribute_name(:first_name) == "First name"


# it: scopes with_locale to the current fiber and restores it
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
assert ::Grant::I18n.locale == "en"
::Grant::I18n.with_locale("fr") do
  assert ::Grant::I18n.locale == "fr"
  ::Grant::I18n.with_locale("de") { assert ::Grant::I18n.locale == "de" }
  assert ::Grant::I18n.locale == "fr"
end
assert ::Grant::I18n.locale == "en"


# it: does not leak into other fibers, so concurrent requests cannot race
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
group do |tasks|
  ::Grant::I18n.store("models.w6_category", "Categorie", "fr")
  channel = Channel(String).new
  done = Channel(Nil).new

  tasks.spawn do
    ::Grant::I18n.with_locale("fr") do
      sleep(0).or_panic
      channel.send(W6Category.model_name.human).or_panic
      done.receive.or_panic
    end
  end

  other = W6Category.model_name.human
  french = channel.receive.or_panic
  done.send(nil).or_panic

  assert other == "W6 category"
  assert french == "Categorie"
  assert ::Grant::I18n.locale == "en"


end

# it: keeps locale = as the process-wide default
::Grant::I18n.locale = "en"
::Grant::I18n.clear_cache
group do |tasks|
  ::Grant::I18n.locale = "fr"
  assert W6Category.model_name.human == "Categorie" # stored for fr above
  done = Channel(String).new
  tasks.spawn { done.send(::Grant::I18n.locale).or_panic }
  assert done.receive.or_panic == "fr"
  end

  ::Grant::I18n.locale = "en"
  ::Grant::I18n.clear_cache

  # Returned errors leave the scoped locale just as raised errors leave an ensure block.
  error = ::Grant::I18n.with_locale("fr") { ::Grant::Error::ErrorBase.new("locale failure") }
  assert error.is_a?(::Grant::Error::ErrorBase)
  assert error.message == "locale failure"
  assert ::Grant::I18n.locale == "en"
