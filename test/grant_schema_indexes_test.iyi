module test/grant_schema_indexes_test

import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect, InvalidDefinition, UnsupportedOperation}
import grant/schema/column_info::{IndexInfo}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}

private def m02b_index_recorder(dialect : Dialect) : RecordingStatements
  RecordingStatements.new(dialect)
end

# it: creates a plain, a unique and a multi-column index with the default name
pg = m02b_index_recorder(Dialect::Pg)
assert pg.add_index_statements(:users, :email).or_panic == ["CREATE INDEX \"index_users_on_email\" ON \"users\" (\"email\")"]
assert pg.add_index_statements(:users, [:a, :b], unique: true).or_panic == ["CREATE UNIQUE INDEX \"index_users_on_a_and_b\" ON \"users\" (\"a\", \"b\")"]
assert m02b_index_recorder(Dialect::Mysql).add_index_statements(:users, :email, name: "by_email").or_panic == ["CREATE INDEX `by_email` ON `users` (`email`)"]

# it: emits partial, using, order, opclass, include, concurrently and if_not_exists on PostgreSQL
pg = m02b_index_recorder(Dialect::Pg)
assert pg.add_index_statements(:users, :email, unique: true, where: "deleted_at IS NULL", if_not_exists: true).or_panic == ["CREATE UNIQUE INDEX IF NOT EXISTS \"index_users_on_email\" ON \"users\" (\"email\") WHERE deleted_at IS NULL"]
assert pg.add_index_statements(:docs, :body, using: :gin, name: "docs_body").or_panic == ["CREATE INDEX \"docs_body\" ON \"docs\" USING gin (\"body\")"]
assert pg.add_index_statements(:users, [:name, :age], order: {name: :desc}, opclass: {name: "text_pattern_ops"}, include: :email).or_panic == ["CREATE INDEX \"index_users_on_name_and_age\" ON \"users\" (\"name\" text_pattern_ops DESC, \"age\") INCLUDE (\"email\")"]
assert pg.add_index_statements(:users, :email, algorithm: :concurrently).or_panic == ["CREATE INDEX CONCURRENTLY \"index_users_on_email\" ON \"users\" (\"email\")"]
assert pg.add_index_statements(:users, :email, comment: "lookup").or_panic.last == "COMMENT ON INDEX \"index_users_on_email\" IS 'lookup'"

# it: needs a name for an expression index and wraps the expression
pg = m02b_index_recorder(Dialect::Pg)
assert pg.add_index_statements(:users, "lower(email)").is_a?(InvalidDefinition)
assert pg.add_index_statements(:users, "lower(email)", name: "users_lower_email").or_panic == ["CREATE INDEX \"users_lower_email\" ON \"users\" ((lower(email)))"]

# it: ignores concurrently on SQLite and rejects unsupported options
lite = m02b_index_recorder(Dialect::Sqlite)
assert lite.add_index_statements(:users, :email, algorithm: :concurrently, where: "a IS NULL").or_panic == ["CREATE INDEX \"index_users_on_email\" ON \"users\" (\"email\") WHERE a IS NULL"]
assert lite.add_index_statements(:users, :email, include: :a).is_a?(UnsupportedOperation)
assert lite.add_index_statements(:users, :email, using: :gin).is_a?(UnsupportedOperation)
assert lite.add_index_statements(:users, :email, name: "x" * 80).is_a?(InvalidDefinition)

# it: drops and renames indexes per dialect
pg = m02b_index_recorder(Dialect::Pg)
assert pg.remove_index_statements(:users, :email, if_exists: true, algorithm: :concurrently).or_panic == ["DROP INDEX CONCURRENTLY IF EXISTS \"index_users_on_email\""]
assert m02b_index_recorder(Dialect::Mysql).remove_index_statements(:users, name: "x").or_panic == ["DROP INDEX `x` ON `users`"]
assert m02b_index_recorder(Dialect::Sqlite).remove_index_statements(:users, [:a, :b]).or_panic == ["DROP INDEX \"index_users_on_a_and_b\""]
assert pg.rename_index_statements(:users, "a", "b").or_panic == ["ALTER INDEX \"a\" RENAME TO \"b\""]
assert m02b_index_recorder(Dialect::Mysql).rename_index_statements(:users, "a", "b").or_panic == ["ALTER TABLE `users` RENAME INDEX `a` TO `b`"]
assert pg.remove_index_statements(:users).is_a?(InvalidDefinition)

# it: creates indexes declared in create_table after the table
pg = m02b_index_recorder(Dialect::Pg)
sql = pg.create_table_statements(:m02b_t) do |t|
  t.string(:email)
  t.index(:email, unique: true)
end.or_panic
assert sql.size == 2
assert sql.last == "CREATE UNIQUE INDEX \"index_m02b_t_on_email\" ON \"m02b_t\" (\"email\")"

register_spec_connections
restore_default_spec_connections
statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
schema = ::Test::SchemaFixture.adapter.schema

private def reset(statements : AdapterStatements) : Nil
  statements.drop_table(:m02b_ix, if_exists: true).or_panic
  statements.create_table(:m02b_ix) do |t|
    t.string(:email, null: false)
    t.string(:name)
    t.datetime(:deleted_at)
  end.or_panic
end

# it: round trips a unique partial index through introspection
reset(statements)
if CURRENT_ADAPTER == "mysql"
  assert statements.add_index(:m02b_ix, :email, unique: true, where: "deleted_at IS NULL").is_a?(UnsupportedOperation)
else
  statements.add_index(:m02b_ix, :email, unique: true, where: "deleted_at IS NULL").or_panic
  info = schema.indexes(:m02b_ix).or_panic.find { |index| index.name == "index_m02b_ix_on_email" }.as(IndexInfo)
  assert info.unique?
  assert info.columns == ["email"]
  assert info.partial?
  assert info.where.to_s.includes?("deleted_at IS NULL")
end
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: round trips a multi-column index and an expression index
reset(statements)
statements.add_index(:m02b_ix, [:email, :name]).or_panic
assert schema.index_exists?(:m02b_ix, [:email, :name]).or_panic
statements.add_index(:m02b_ix, "lower(email)", name: "m02b_ix_lower_email").or_panic unless CURRENT_ADAPTER == "mysql"
unless CURRENT_ADAPTER == "mysql"
  expression = schema.indexes(:m02b_ix).or_panic.find { |index| index.name == "m02b_ix_lower_email" }.as(IndexInfo)
  assert expression.expression?
end
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: enforces uniqueness
reset(statements)
statements.add_index(:m02b_ix, :email, unique: true).or_panic
::Test::SchemaFixture.exec("INSERT INTO m02b_ix (email) VALUES ('a@x')").or_panic
assert ::Test::SchemaFixture.exec("INSERT INTO m02b_ix (email) VALUES ('a@x')").is_a?(ErrorBase)
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: skips an existing index with if_not_exists and raises without it
reset(statements)
statements.add_index(:m02b_ix, :name).or_panic
assert statements.add_index(:m02b_ix, :name).is_a?(ErrorBase)
statements.add_index(:m02b_ix, :name, if_not_exists: true).or_panic unless CURRENT_ADAPTER == "mysql"
assert schema.indexes(:m02b_ix).or_panic.count { |index| index.columns == ["name"] } == 1
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: removes an index by name, by columns, and with if_exists
reset(statements)
statements.add_index(:m02b_ix, :name).or_panic
statements.remove_index(:m02b_ix, :name).or_panic
assert !schema.index_exists?(:m02b_ix, [:name]).or_panic
statements.remove_index(:m02b_ix, name: "nothing", if_exists: true).or_panic
assert statements.remove_index(:m02b_ix, name: "nothing").is_a?(ErrorBase)
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: renames an index
reset(statements)
statements.add_index(:m02b_ix, :name, name: "m02b_ix_old").or_panic
statements.rename_index(:m02b_ix, "m02b_ix_old", "m02b_ix_new").or_panic
assert schema.index_exists?(:m02b_ix, name: "m02b_ix_new").or_panic
assert !schema.index_exists?(:m02b_ix, name: "m02b_ix_old").or_panic
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: builds a concurrent index on PostgreSQL and refuses it inside a transaction
reset(statements)
if CURRENT_ADAPTER == "pg"
  statements.add_index(:m02b_ix, :name, algorithm: :concurrently).or_panic
  assert schema.index_exists?(:m02b_ix, [:name]).or_panic
  statements.remove_index(:m02b_ix, :name).or_panic
  error = statements.transaction { |tx| tx.add_index(:m02b_ix, :name, algorithm: :concurrently) }
  assert error.is_a?(InvalidDefinition)
  assert !schema.index_exists?(:m02b_ix, [:name]).or_panic
  statements.transaction(disable_ddl_transaction: true) { |tx| tx.add_index(:m02b_ix, :name, algorithm: :concurrently) }.or_panic
  assert schema.index_exists?(:m02b_ix, [:name]).or_panic
end
statements.drop_table(:m02b_ix, if_exists: true).or_panic

# it: creates indexes declared in create_table
reset(statements)
statements.create_table(:m02b_ix, force: true) do |t|
  t.string(:email)
  t.index(:email, unique: true)
end.or_panic
assert schema.index_exists?(:m02b_ix, [:email], unique: true).or_panic
statements.drop_table(:m02b_ix, if_exists: true).or_panic
