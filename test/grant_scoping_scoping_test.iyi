module test/grant_scoping_scoping_test
import std/time::{Time}
import grant/base::{Base}
import grant/query/builder::{Builder}
import test/spec_helper::{register_spec_connections}
pub class ScopedModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table scoped_models

  column id : Int64, primary: true
  column name : String?
  column status : String?
  column priority : Int32?
  column published : Bool = false
  column deleted_at : Time?
  timestamps

  # Define named scopes
  scope :published, ->(query : Builder(ScopedModel)) { query.where(published: true) }
  scope :active, ->(query : Builder(ScopedModel)) { query.where(status: "active") }
  scope :high_priority, ->(query : Builder(ScopedModel)) { query.where("priority > ?", 5) }
  scope :recent, ->(query : Builder(ScopedModel)) { query.order(created_at: :desc) }
  scope :by_name, ->(query : Builder(ScopedModel)) { query.order(:name) }

  # Default scope
  default_scope { where(deleted_at: nil) }
end

pub class UnorderedModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table unordered_models

  column id : Int64, primary: true
  column name : String?
  column position : Int32?
  timestamps

  # Model without default scope for comparison
  scope :ordered, ->(query : Builder(UnorderedModel)) { query.order(:position) }
end


register_spec_connections
ScopedModel.migrator.drop_and_create.or_panic
UnorderedModel.migrator.drop_and_create.or_panic

# it: defines class methods for scopes
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
assert ScopedModel.responds_to?(:published)
assert ScopedModel.responds_to?(:active)
assert ScopedModel.responds_to?(:high_priority)

# it: returns a query builder
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
query = ScopedModel.published
assert query.is_a?(Builder(ScopedModel))

# it: can chain scopes
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
relation = ScopedModel.published.active
assert relation.is_a?(ScopedModel::BuildNamedScopeRelation)
assert relation.where_fields.size == 2

# it: applies scope conditions
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
published = ScopedModel.new(name: "Published", published: true, status: "active")
published.save_strict.or_panic
unpublished = ScopedModel.new(name: "Unpublished", published: false, status: "active")
unpublished.save_strict.or_panic
results = ScopedModel.published.all.select.or_panic
assert results.map(&.name).includes?("Published")
assert !results.map(&.name).includes?("Unpublished")

# it: can combine multiple scopes
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
high_active = ScopedModel.new(name: "High Active", status: "active", priority: 8, published: true)
high_active.save_strict.or_panic
low_active = ScopedModel.new(name: "Low Active", status: "active", priority: 2, published: true)
low_active.save_strict.or_panic
high_inactive = ScopedModel.new(name: "High Inactive", status: "inactive", priority: 8, published: true)
high_inactive.save_strict.or_panic
results = ScopedModel.where(status: "active").where("priority > ?", 5).all.select.or_panic
assert results.map(&.name).includes?("High Active")
assert !results.map(&.name).includes?("Low Active")
assert !results.map(&.name).includes?("High Inactive")

# it: applies default scope to all queries
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
active1 = ScopedModel.new(name: "Active 1")
active1.save_strict.or_panic
active2 = ScopedModel.new(name: "Active 2")
active2.save_strict.or_panic
deleted = ScopedModel.new(name: "Deleted")
deleted.save_strict.or_panic
deleted.update(deleted_at: Time.utc)
results = ScopedModel.all.select.or_panic
assert results.size == 2
assert !results.map(&.name).includes?("Deleted")

# it: applies default scope to find methods
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
active = ScopedModel.new(name: "Active")
active.save_strict.or_panic
deleted = ScopedModel.new(name: "Deleted")
deleted.save_strict.or_panic
deleted.update(deleted_at: Time.utc)
assert !ScopedModel.find(active.id).or_panic.nil?
assert ScopedModel.find(deleted.id).or_panic.nil?

# it: bypasses default scope
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
active = ScopedModel.new(name: "Active")
active.save_strict.or_panic
deleted = ScopedModel.new(name: "Deleted")
deleted.save_strict.or_panic
deleted.update(deleted_at: Time.utc)
assert ScopedModel.all.select.or_panic.size == 1
assert ScopedModel.unscoped.all.select.or_panic.size == 2

# it: can be used with a block
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
active = ScopedModel.new(name: "Active")
active.save_strict.or_panic
deleted = ScopedModel.new(name: "Deleted")
deleted.save_strict.or_panic
deleted.update(deleted_at: Time.utc)
results = [] of ScopedModel
ScopedModel.unscoped do |query|
  results = query.all.select.or_panic
end
assert results.size == 2

# it: merges query conditions
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
query2 = ScopedModel.where(published: true)
merged = ScopedModel.merge(query2)
assert merged.raw_sql.includes?("(#{ScopedModel.quote("deleted_at")} IS NULL)")
assert merged.raw_sql.includes?("(#{ScopedModel.quote("published")} = ")

# it: uses most restrictive limit
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
query2 = ScopedModel.limit(5)
merged = ScopedModel.merge(query2)
assert merged.limit == 5

# it: allows adding custom methods to queries
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)

# it: works with order
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
ScopedModel.new(name: "B", published: true).save_strict.or_panic
ScopedModel.new(name: "A", published: true).save_strict.or_panic
ScopedModel.new(name: "C", published: false).save_strict.or_panic
results = ScopedModel.where(published: true).order(:name).all.select.or_panic
assert results.map(&.name) == ["A", "B"]

# it: works with limit and offset
ScopedModel.unscoped.delete_all.or_panic
UnorderedModel.all.select.or_panic.each(&.destroy)
5.times do |record_index|
  model = ScopedModel.new(name: "Model #{record_index}", published: true)
  model.save_strict.or_panic
end
results = ScopedModel.where(published: true).limit(2).offset(1).all.select.or_panic
assert results.size == 2
ScopedModel.adapter.close.or_panic
