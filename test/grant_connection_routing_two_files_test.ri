module test/grant_connection_routing_two_files_test
import grant/base::{Base}
import grant/error_taxonomy::{ReadOnlyError}
import std/time::{Span}
import test/w6_c04_support::{W6C04}

pub class C01RoutedRecord < Base
  table c01_routed_records
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "c01_route_writer", reading: "c01_route_reader"}
end

def c01_labels(name : String) : Array(String)
  W6C04.strings(name, "SELECT label FROM c01_routed_records ORDER BY id")
end

ddl = ["CREATE TABLE c01_routed_records (#{W6C04.id_column}, label TEXT)"]
W6C04.provision("writer", ddl)
W6C04.provision("reader", ddl)
W6C04.exec("writer", "INSERT INTO c01_routed_records (label) VALUES ('writer row')")
W6C04.exec("reader", "INSERT INTO c01_routed_records (label) VALUES ('reader row')")
W6C04.establish("c01_route_writer", "writer", :writing)
W6C04.establish("c01_route_reader", "reader", :reading)

# it: resolves the reading role to the reader file and the writing role to the writer file
assert C01RoutedRecord.connected_to(role: :reading) { C01RoutedRecord.adapter.url }.includes?("reader")
assert C01RoutedRecord.connected_to(role: :writing) { C01RoutedRecord.adapter.url }.includes?("writer")
assert C01RoutedRecord.connected_to(role: :primary) { C01RoutedRecord.adapter.url }.includes?("writer")

# it: returns different rows for each role, which only the right file can produce
assert C01RoutedRecord.connected_to(role: :reading) { C01RoutedRecord.first_strict.or_panic.label } == "reader row"
assert C01RoutedRecord.connected_to(role: :writing) { C01RoutedRecord.first_strict.or_panic.label } == "writer row"
assert C01RoutedRecord.connected_to(role: :primary) { C01RoutedRecord.first_strict.or_panic.label } == "writer row"

# it: sends writes to the writer file, never the reader file
C01RoutedRecord.create_strict(label: "written").or_panic
assert c01_labels("writer").includes?("written")
assert c01_labels("reader") == ["reader row"]

# it: refuses a write attempted in the reading role and leaves both files alone
before_writer = c01_labels("writer")
error = C01RoutedRecord.connected_to(role: :reading) { C01RoutedRecord.create_strict(label: "refused") }
assert error.is_a?(ReadOnlyError)
assert c01_labels("writer") == before_writer
assert c01_labels("reader") == ["reader row"]

# it: reads from the writer while stuck to the primary after a write
C01RoutedRecord.create_strict(label: "sticky").or_panic
C01RoutedRecord.stick_to_primary(Span.seconds(30_i64))
assert C01RoutedRecord.current_role == :primary
assert C01RoutedRecord.adapter.url.includes?("writer")

W6C04.remove("c01_route_writer", :writing)
W6C04.remove("c01_route_reader", :reading)
W6C04.cleanup
