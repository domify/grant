module test/grant_validations_error_object_test
import grant/base::{Base}
import grant/error::{Error, Value}
import grant/i18n
import test/spec_helper::{register_spec_connections}
import test/validation_details_support::{same_details?}

register_spec_connections

pub class V02oAccount < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table v02o_accounts

  column id : Int64, primary: true
  column first_name : String?
  column author_id : Int64?
end

begin
  begin
    # it: humanizes the attribute name
    begin
      assert Error.new(:first_name, "can't be blank").full_message == "First name can't be blank"
      assert Error.new("first_name", "can't be blank").to_s == "First name can't be blank"
    end

    # it: drops an _id suffix like ActiveRecord's humanize
    begin
      assert Error.new(:author_id, "is missing").full_message == "Author is missing"
    end

    # it: returns the message alone for base errors given as Symbol or String
    begin
      assert Error.new(:base, "went wrong").full_message == "went wrong"
      assert Error.new("base", "went wrong").full_message == "went wrong"
    end

    # it: uses the model's human_attribute_name once it belongs to a record
    begin
      ::Grant::I18n.store("attributes.#{::Grant::I18n.model_key(V02oAccount.to_s)}.first_name", "Given name")
      begin
        defer { ::Grant::I18n.translator = ::Grant::I18n::DefaultTranslator.new }
        account = V02oAccount.new
        account.errors.add(:first_name, :blank)
        assert account.errors.first.full_message == "Given name can't be blank"
        assert account.errors.full_messages == ["Given name can't be blank"]
      end
    end

    # it: is computed once per error
    begin
      error = Error.new(:name, "bad")
      assert error.full_message.object_id == error.full_message.object_id
    end
  end

  begin
    # it: exposes attribute, type, raw_type, options and message
    begin
      error = Error.new(:name, :too_short, options: {:count => 3.as(Value)})
      assert error.attribute == "name"
      assert error.type == :too_short
      assert error.raw_type == :too_short
      assert error.options[:count] == 3
      assert error.options?
      assert error.message == "is too short (minimum is 3 characters)"
      assert same_details?(error.detail, {:error => :too_short, :count => 3})
    end

    # it: keeps the constructor with a message and an optional type
    begin
      error = Error.new(:name, "bad", :blank)
      assert error.message == "bad"
      assert error.type == :blank
      assert !error.options?
      assert Error.new(:name).message == ""
    end
  end

  begin
    # it: matches by attribute, type and options
    begin
      error = Error.new(:name, :too_short, options: {:count => 3.as(Value)})
      assert error.match?(:name)
      assert error.match?("name")
      assert !error.match?(:other)
      assert error.match?(:name, :too_short)
      assert !error.match?(:name, :blank)
      assert error.match?(:name, :too_short, count: 3)
      assert !error.match?(:name, :too_short, count: 4)
      assert !error.match?(:name, :too_short, extra: 1)
    end

    # it: matches a String type against the message
    begin
      error = Error.new(:name, "is odd")
      assert error.match?(:name, "is odd")
      assert !error.match?(:name, "is even")
    end
  end

  begin
    # it: requires the options to be exactly the given ones
    begin
      error = Error.new(:name, :too_short, options: {:count => 3.as(Value)})
      assert error.strict_match?(:name, :too_short, count: 3)
      assert !error.strict_match?(:name, :too_short)
      assert !error.strict_match?(:name, :too_short, count: 3, extra: 1)
      assert Error.new(:name, :blank).strict_match?(:name, :blank)
    end
  end

  begin
    # it: duplicates the options and can move the error to another attribute
    begin
      error = Error.new(:name, :too_short, options: {:count => 3.as(Value)})
      copy = error.copy(:title)
      assert copy.attribute == "title"
      copy.options[:count] = 9
      assert error.options[:count] == 3
    end
  end
end
