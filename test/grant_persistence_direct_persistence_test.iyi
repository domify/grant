module test/grant_persistence_direct_persistence_test
import grant/base::{Base}
import grant/readonly::{ReadOnlyRecordError}
import std/time::{Time}
import test/spec_helper::{register_spec_connections}

pub class T6PersistenceRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_persistence_records
  column id : Int64, primary: true
  column name : String?
  column note : String?
  column counter : Int32?
  timestamps
end

pub class T6ReadonlyRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_readonly_records
  column id : Int64, primary: true
  column slug : String
  attr_readonly :slug
end

pub class T6TouchRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_touch_records
  column id : Int64, primary: true
  column name : String?
  column note : String?
  column counter : Int32?
  column last_seen_at : Time = Time.utc(2020, 1, 1)
  timestamps
  getter list_of_callback_events : Array(String) = [] of String
  before_save :record_before_save
  before_update :record_before_update
  after_save :record_after_save
  after_touch :record_after_touch

  private def record_before_save : Nil
    list_of_callback_events << "before_save"
    nil
  end

  private def record_before_update : Nil
    list_of_callback_events << "before_update"
    nil
  end

  private def record_after_save : Nil
    list_of_callback_events << "after_save"
    nil
  end

  private def record_after_touch : Nil
    list_of_callback_events << "after_touch"
    nil
  end
end

pub def clear_tables : Nil
  T6PersistenceRecord.clear.or_panic
  T6ReadonlyRecord.clear.or_panic
  T6TouchRecord.clear.or_panic
  nil
end

register_spec_connections
T6PersistenceRecord.migrator.drop_and_create.or_panic
T6ReadonlyRecord.migrator.drop_and_create.or_panic
T6TouchRecord.migrator.drop_and_create.or_panic

# it: updates a primary key using its original value in the where clause
clear_tables
record = T6PersistenceRecord.create_strict(name: "primary key").or_panic
old_id = record.id.as(Int64)
new_id = old_id + 100_000_000
assert record.update_columns(id: new_id).or_panic
assert record.id == new_id
assert T6PersistenceRecord.find(old_id).or_panic.nil?
assert T6PersistenceRecord.find_strict(new_id).or_panic.name == "primary key"

# it: clears only directly updated columns from dirty tracking
clear_tables
record = T6PersistenceRecord.create_strict(name: "original", note: "saved").or_panic
record.name = "direct"
record.note = "pending"
assert record.update_columns(name: "direct").or_panic
assert !record.name_changed?
assert record.note_changed?
assert record.changed == ["note"]
assert T6PersistenceRecord.find_strict(record.id).or_panic.name == "direct"
assert T6PersistenceRecord.find_strict(record.id).or_panic.note == "saved"

# it: rejects update_columns for read-only attributes before changing the record
clear_tables
record = T6ReadonlyRecord.create_strict(slug: "original").or_panic
assert record.update_columns(slug: "changed").is_a?(ReadOnlyRecordError)
assert record.slug == "original"
assert T6ReadonlyRecord.find_strict(record.id).or_panic.slug == "original"

# it: increments only the requested column and leaves other changes pending
clear_tables
record = T6TouchRecord.create_strict(name: "saved", note: "old note", counter: 0).or_panic
record.list_of_callback_events.clear
record.note = "unsaved note"
record.increment_strict(:counter).or_panic
fresh = T6TouchRecord.find_strict(record.id).or_panic
assert fresh.counter == 1
assert fresh.note == "old note"
assert record.counter == 1
assert record.note == "unsaved note"
assert !record.counter_changed?
assert record.note_changed?
assert record.list_of_callback_events.empty?

# it: touches timestamps without saving unrelated changes or running save callbacks
clear_tables
record = T6TouchRecord.new(name: "saved", note: "old note")
record.updated_at = Time.utc(2020, 1, 1)
record.save_strict(skip_timestamps: true).or_panic
record.list_of_callback_events.clear
record.note = "unsaved note"
assert record.touch.or_panic
fresh = T6TouchRecord.find_strict(record.id).or_panic
assert fresh.note == "old note"
assert !fresh.updated_at.nil?
assert record.note == "unsaved note"
assert record.note_changed?
assert record.list_of_callback_events == ["after_touch"]

# it: touches named non-nullable Time columns
clear_tables
old_time = Time.utc(2020, 1, 1)
record = T6TouchRecord.create_strict(name: "required time", last_seen_at: old_time).or_panic
assert record.touch(:last_seen_at).or_panic
assert T6TouchRecord.find_strict(record.id).or_panic.last_seen_at != old_time
T6PersistenceRecord.adapter.close.or_panic
