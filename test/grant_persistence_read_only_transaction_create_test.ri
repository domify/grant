module test/grant_persistence_read_only_transaction_create_test
import grant/base::{Base}
import grant/errors::{RecordNotSaved}
import grant/error_taxonomy::{StatementInvalid}
import grant/transaction::{ReadOnlyError}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class ReadOnlyTxRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table read_only_tx_rows
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
ReadOnlyTxRow.migrator.drop_and_create.or_panic

# SQLite has no read-only transaction mode; the database enforces it on
# PostgreSQL and MySQL only.
unless CURRENT_ADAPTER == "sqlite"
  # it: surfaces ReadOnlyError from create!
  ReadOnlyTxRow.clear.or_panic
  error = ReadOnlyTxRow.transaction(readonly: true) { ReadOnlyTxRow.create_strict(name: "blocked") }
  assert error.is_a?(ReadOnlyError)
  assert ReadOnlyTxRow.count.or_panic == 0

  # it: surfaces ReadOnlyError from save!
  ReadOnlyTxRow.clear.or_panic
  row = ReadOnlyTxRow.new(name: "blocked")
  error = ReadOnlyTxRow.transaction(readonly: true) { row.save_strict }
  assert error.is_a?(ReadOnlyError)

  # it: surfaces ReadOnlyError from update!
  ReadOnlyTxRow.clear.or_panic
  row = ReadOnlyTxRow.create_strict(name: "kept").or_panic
  error = ReadOnlyTxRow.transaction(readonly: true) { row.update_strict(name: "blocked") }
  assert error.is_a?(ReadOnlyError)
  assert ReadOnlyTxRow.find_strict(row.id).or_panic.name == "kept"
end

# it: keeps a translated statement error as the cause of RecordNotSaved
ReadOnlyTxRow.clear.or_panic
ReadOnlyTxRow.create_strict(id: 7_i64, name: "first").or_panic
error = ReadOnlyTxRow.create_strict(id: 7_i64, name: "duplicate")
assert error.is_a?(RecordNotSaved)
assert error.as(RecordNotSaved).cause.is_a?(StatementInvalid)
ReadOnlyTxRow.adapter.close.or_panic
