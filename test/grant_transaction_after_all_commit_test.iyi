module test/grant_transaction_after_all_commit_test
import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/driver::{Connection}
import grant/errors::{Rollback, ErrorBase}
import grant::{after_all_transactions_commit}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: runs immediately when no transaction is open
ran = false
after_all_transactions_commit { ran = true; nil }
assert ran
ran = false
Parent.after_all_transactions_commit { ran = true; nil }
assert ran

# it: runs after the outermost commit, not when a nested block finishes
events = [] of Symbol
Parent.transaction do
  Parent.transaction do
    after_all_transactions_commit { events << :after_all; nil }
  end.or_panic
  assert events.empty?
  Parent.transaction(requires_new: true) do
    Parent.after_all_transactions_commit { events << :model; nil }
  end.or_panic
  assert events.empty?
end.or_panic
assert events == [:after_all, :model]

# it: waits for the outer transaction when an independent inner transaction commits
events = [] of Symbol
Parent.transaction do
  Parent.transaction(independent: true) do
    after_all_transactions_commit { events << :after_all; nil }
  end.or_panic
  assert events.empty?
end.or_panic
assert events == [:after_all]

# it: is dropped when the transaction rolls back
events = [] of Symbol
Parent.transaction do
  after_all_transactions_commit { events << :after_all; nil }
  Rollback.new
end.or_panic
error = Parent.transaction do
  after_all_transactions_commit { events << :after_all; nil }
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert events.empty?

# it: is dropped when only its savepoint rolls back
events = [] of Symbol
Parent.transaction do
  after_all_transactions_commit { events << :kept; nil }
  Parent.transaction(requires_new: true) do
    after_all_transactions_commit { events << :dropped; nil }
    Rollback.new
  end.or_panic
end.or_panic
assert events == [:kept]

# it: runs after the record after_commit callbacks of the same transaction
events = [] of Symbol
Parent.transaction do
  after_all_transactions_commit { events << :after_all; nil }
  Parent.current_transaction.after_commit { events << :commit; nil }
end.or_panic
assert events == [:commit, :after_all]

# it: is owned by the registering fiber
events = [] of Symbol
done = Channel(Nil).new
Parent.transaction do
  after_all_transactions_commit { events << :main; nil }
  group do |tasks|
    tasks.spawn do
      # This fiber has no open transaction, so its block runs at once.
      after_all_transactions_commit { events << :other; nil }
      done.send(nil).or_panic
    end
    done.receive.or_panic
    assert events == [:other]
  end
end.or_panic
assert events == [:other, :main]
Parent.adapter.close.or_panic
