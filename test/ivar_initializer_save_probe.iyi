module test/ivar_initializer_save_probe
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class IvarInitializerPetController
  @pet = IvarInitializerPet.new
  @puppy = IvarInitializerPuppy.new

  def create(name : String) : IvarInitializerPet
    pet = IvarInitializerPet.new
    pet.name = name
    pet.save_strict.or_panic
    @pet = pet
  end
end

pub class IvarInitializerPet < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ivar_initializer_pets
  column id : Int64, primary: true
  column name : String
end

pub class IvarInitializerScopedPet < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ivar_initializer_scoped_pets
  column id : Int64, primary: true
  column adopted : Bool = false
  default_scope { where(adopted: false) }
end

pub class IvarInitializerPuppy < IvarInitializerScopedPet
end

register_spec_connections
IvarInitializerPet.migrator.drop_and_create.or_panic
pet = IvarInitializerPetController.new.create("Ruby")
puts "saved=#{pet.persisted?} id=#{pet.id}"
puts "found=#{IvarInitializerPet.find_strict(pet.id).or_panic.name}"
puts "replica_lag_threshold=#{IvarInitializerPet.replica_lag_threshold}"
puts "subclass_default_scope=#{IvarInitializerPuppy._has_default_scope?}"
IvarInitializerPet.adapter.close.or_panic
