module test/grant_convenience_relation_finders_test
import test/convenience_models::{ConvItem, reset_items, statements}
import grant/querying::{NotFound, NotUnique}
import grant/adapter/driver::{Value}

reset_items

pub def seed : Nil
  ConvItem.clear
  ConvItem.create_strict(name: "a", status: "draft", kind: "k1").or_panic
  ConvItem.create_strict(name: "b", status: "draft", kind: "k1").or_panic
  ConvItem.create_strict(name: "c", status: "live", kind: "k2").or_panic
  nil
end

# it: find_by narrows the relation
seed
assert (ConvItem.where(status: "draft").find_by(name: "b").or_panic || raise "missing record").name == "b"
assert ConvItem.where(status: "draft").find_by(name: "c").or_panic.nil?

# it: find_by matches nil as IS NULL and accepts a hash
seed
assert !ConvItem.where(status: "draft").find_by(qty: nil).or_panic.nil?
assert !ConvItem.where(status: "draft").find_by({"name" => "a"} of Symbol | String => Value).or_panic.nil?

# it: find_by! raises NotFound naming the criteria
seed
assert ConvItem.where(status: "draft").find_by_strict(name: "a").or_panic.name == "a"
error = ConvItem.where(status: "draft").find_by_strict(name: "c")
assert error.is_a?(NotFound)
assert error.as(NotFound).message.includes?("name = c")

# it: find_sole_by returns the only match and reads at most two rows
seed
assert ConvItem.where(status: "live").find_sole_by(name: "c").or_panic.name == "c"
error = nil
sql = statements { error = ConvItem.where(kind: "k1").find_sole_by(status: "draft") }
assert error.is_a?(NotUnique)

# it: find_sole_by limits the query to two rows
seed
sql = statements { ConvItem.where(kind: "k1").find_sole_by(status: "draft") }
assert sql.size == 1
assert sql.first.includes?("LIMIT 2")

# it: find_sole_by raises NotFound when nothing matches
seed
assert ConvItem.where(status: "live").find_sole_by(name: "a").is_a?(NotFound)

# it: works on named scopes
seed
assert !ConvItem.drafts.find_by(name: "a").or_panic.nil?
assert ConvItem.drafts.find_by(name: "c").or_panic.nil?
assert ConvItem.drafts.find_by_strict(name: "b").or_panic.name == "b"
assert ConvItem.drafts.find_sole_by(name: "a").or_panic.name == "a"
assert !ConvItem.drafts.find((ConvItem.find_by_strict(name: "a").or_panic.id || raise "missing id")).or_panic.nil?

# it: does not change the receiver
seed
relation = ConvItem.where(status: "draft")
relation.find_by(name: "a").or_panic
assert relation.where_fields.size == 1

# it: keeps the class-level finders working
seed
assert (ConvItem.find_by(name: "a").or_panic || raise "missing record").name == "a"
assert ConvItem.find_sole_by(name: "c").or_panic.name == "c"
ConvItem.adapter.close.or_panic
