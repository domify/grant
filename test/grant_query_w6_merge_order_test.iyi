module test/grant_query_w6_merge_order_test
import grant/base::{Base}
import grant/query/builder::{Builder}
import std/text
import test/spec_helper::{register_spec_connections}
pub class W6moItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6mo_items

  column id : Int64, primary: true
  column name : String?
  column rank : Int32 = 0
  column kind : String?
  column seq : Int32 = 0
end

pub class W6moPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6mo_posts

  column id : Int64, primary: true
  column status : String?
  column rank : Int32 = 0

  scope :drafts, -> { W6moPost.where(status: "draft") }
  scope :by_rank, -> { W6moPost.order(rank: :desc) }
  scope :by_id, ->(q : Builder(W6moPost)) { q.order(:id) }
end


def seqs(relation : Builder(W6moItem)) : Array(Int32)
  relation.select.or_panic.map(&.seq.as(Int32))
end

register_spec_connections
W6moItem.migrator.drop_and_create.or_panic
W6moPost.migrator.drop_and_create.or_panic

# it: appends the other relation's order after the receiver's
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.order(:name).merge(W6moItem.order(rank: :desc))
assert merged.to_sql.includes?("ORDER BY")
assert merged.order_fields.map { |term| term[:field] } == ["name", "rank"]
assert seqs(merged) == [2, 3, 4, 1]

# it: orders by the receiver first, then breaks ties with the merged relation
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
# name ASC puts the two "a" rows first; rank DESC then sorts inside each name.
assert seqs(W6moItem.order(:name).merge(W6moItem.order(rank: :desc))).first(2) == [2, 3]
assert seqs(W6moItem.order(:name).merge(W6moItem.order(rank: :asc))).first(2) == [3, 2]

# it: does not repeat a term the receiver already orders by
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.order(:name).merge(W6moItem.order(:name).order(:rank))
assert merged.order_fields.map { |term| term[:field] } == ["name", "rank"]

# it: keeps the receiver's order when the other relation has none
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
assert seqs(W6moItem.order(rank: :desc, seq: :asc).merge(W6moItem.where(kind: "x"))) == [2, 1]

# it: takes the other relation's order when the receiver has none
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
assert seqs(W6moItem.where(kind: "x").merge(W6moItem.order(seq: :desc))) == [2, 1]

# it: lets a reordered relation replace the receiver's order
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.order(:name).merge(W6moItem.reorder(rank: :desc, seq: :asc))
assert merged.order_fields.map { |term| term[:field] } == ["rank", "seq"]
assert seqs(merged) == [2, 4, 1, 3]

# it: lets reorder(nil) on the merged relation drop the receiver's order
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
assert W6moItem.order(:name).merge(W6moItem.reorder(nil)).order_fields.empty?

# it: appends through the block and keyword forms
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.order(:name).merge(&.order(rank: :desc))
assert merged.order_fields.map { |term| term[:field] } == ["name", "rank"]
assert W6moItem.order(:name).merge(kind: "x").order_fields.map { |term| term[:field] } == ["name"]

# it: appends when a named-scope style relation is merged with merge_builder
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
base = W6moItem.order(:name).where(kind: "x")
merged = base.merge(W6moItem.order(:rank))
assert merged.order_fields.map { |term| term[:field] } == ["name", "rank"]
assert merged.to_sql.split("ORDER BY").size - 1 == 1

# it: keeps raw order terms when merging
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.order("lower(name) DESC").merge(W6moItem.order(:seq))
assert merged.to_sql.includes?("lower(name) DESC")
assert merged.to_sql.includes?("ORDER BY")
assert seqs(merged).first == 1

# it: leaves both relations unchanged
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
left = W6moItem.order(:name)
right = W6moItem.order(:rank)
left.merge(right)
assert left.order_fields.map { |term| term[:field] } == ["name"]
assert right.order_fields.map { |term| term[:field] } == ["rank"]

# it: takes the other relation's from source and common table expressions
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.where(kind: "x").merge(W6moItem.from(W6moItem.where(rank: 2), as: "sub"))
assert merged.to_sql.includes?("sub")
assert seqs(merged) == [2]
with_cte = W6moItem.where(kind: "x").merge(W6moItem.with(:picked, W6moItem.where(kind: "y")))
assert with_cte.to_sql.includes?("WITH")
assert seqs(with_cte) == [1, 2]

# it: applies the unscoping of the merged relation
W6moItem.clear.or_panic
W6moItem.create_strict(name: "b", rank: 1, kind: "x", seq: 1).or_panic
W6moItem.create_strict(name: "a", rank: 2, kind: "x", seq: 2).or_panic
W6moItem.create_strict(name: "a", rank: 1, kind: "y", seq: 3).or_panic
W6moItem.create_strict(name: "b", rank: 2, kind: "y", seq: 4).or_panic
merged = W6moItem.where(kind: "x").order(:name).merge(W6moItem.unscope(:where))
assert seqs(merged).size == 4
merged = W6moItem.where(kind: "x").where(rank: 1).merge(W6moItem.unscope(where: :kind))
assert seqs(merged) == [1, 3]
merged = W6moItem.where(kind: "x").order(:name).merge(W6moItem.unscope(:order))
assert merged.order_fields.empty?

# it: replaces a same-column equality from an earlier where
W6moPost.clear.or_panic
W6moPost.create_strict(status: "draft", rank: 1).or_panic
W6moPost.create_strict(status: "live", rank: 2).or_panic
W6moPost.create_strict(status: "draft", rank: 3).or_panic
relation = W6moPost.by_id.where(status: "live").drafts
assert relation.to_sql.split("WHERE").last.split("status").size - 1 == 1
assert relation.select.or_panic.map(&.rank.as(Int32)) == [1, 3]

# it: keeps conditions on other columns
W6moPost.clear.or_panic
W6moPost.create_strict(status: "draft", rank: 1).or_panic
W6moPost.create_strict(status: "live", rank: 2).or_panic
W6moPost.create_strict(status: "draft", rank: 3).or_panic
assert W6moPost.by_id.where(rank: 3).drafts.select.or_panic.map(&.rank.as(Int32)) == [3]

# it: appends the scope's order to the existing order
W6moPost.clear.or_panic
W6moPost.create_strict(status: "draft", rank: 1).or_panic
W6moPost.create_strict(status: "live", rank: 2).or_panic
W6moPost.create_strict(status: "draft", rank: 3).or_panic
relation = W6moPost.by_id.order(:status).by_rank
assert relation.order_fields.map { |term| term[:field] } == ["id", "status", "rank"]
assert relation.drafts.order_fields.map { |term| term[:field] } == ["id", "status", "rank"]

# it: appends the order of a scope that takes the relation
W6moPost.clear.or_panic
W6moPost.create_strict(status: "draft", rank: 1).or_panic
W6moPost.create_strict(status: "live", rank: 2).or_panic
W6moPost.create_strict(status: "draft", rank: 3).or_panic
relation = W6moPost.by_rank.by_id
assert relation.order_fields.map { |term| term[:field] } == ["rank", "id"]

W6moItem.adapter.close.or_panic
