module test/grant_schema_w6b_mysql_live_test
import grant/schema/schema_statements::{AdapterStatements}
import grant/schema/column_info::{ColumnInfo, IndexInfo, ReferentialAction}
import grant/schema/introspection
import test/schema_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
import std/text
import std/enumerable

private def setup : AdapterStatements
  statements = AdapterStatements.new(::Test::SchemaFixture.adapter)
  statements.drop_table(:w6b_live_children, :w6b_live, if_exists: true).or_panic
  statements.create_table(:w6b_live, comment: "Live table") do |t|
    t.string(:name, null: false, limit: 40, comment: "Display name").or_panic
    t.string(:role, null: false, default: "it's member").or_panic
    t.integer(:qty, default: 3).or_panic
    t.boolean(:active, null: false, default: true).or_panic
    t.datetime(:stamped, default_sql: "CURRENT_TIMESTAMP").or_panic
    t.decimal(:price, precision: 10, scale: 2, default: 1.5).or_panic
    t.timestamps(precision: 3).or_panic
    t.index(:name, unique: true)
  end.or_panic
  statements
end

register_spec_connections
restore_default_spec_connections
adapter = ::Test::SchemaFixture.adapter

# it: reads columns, defaults and nullability back from the catalog
statements = setup
adapter.reset_schema_caches_in_place
columns = adapter.schema.columns(:w6b_live).or_panic.index_by { |column| column.name }
assert columns.keys == ["id", "name", "role", "qty", "active", "stamped", "price", "created_at", "updated_at"]
assert !columns["name"].null?
assert !columns["name"].primary_key?
assert columns["id"].primary_key?
assert columns["qty"].default.to_s.includes?("3")
assert columns["role"].default.to_s.includes?("it")
assert columns["stamped"].default.to_s.upcase.includes?("CURRENT_TIMESTAMP")
assert !columns["created_at"].null?

# it: stores the defaults it was given
statements = setup
insert = CURRENT_ADAPTER == "mysql" ? "INSERT INTO w6b_live (name, created_at, updated_at) VALUES ('a', NOW(), NOW())" : "INSERT INTO w6b_live (name, created_at, updated_at) VALUES ('a', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
adapter.open { |db| db.exec(insert) }.or_panic
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_live") }.or_panic == "it's member"
assert adapter.open { |db| db.scalar("SELECT qty FROM w6b_live") }.or_panic == 3
assert !adapter.open { |db| db.scalar("SELECT stamped FROM w6b_live") }.or_panic.nil?

# it: reads indexes, with their uniqueness, back from the catalog
statements = setup
adapter.reset_schema_caches_in_place
index = adapter.schema.indexes(:w6b_live).or_panic.find { |info| info.columns == ["name"] }.as(IndexInfo)
assert index.unique?

# it: reads foreign key actions back from the catalog
statements = setup
statements.create_table(:w6b_live_children) do |t|
  t.references(:live, foreign_key: {to_table: :w6b_live, on_delete: :cascade, on_update: :restrict})
end.or_panic
adapter.reset_schema_caches_in_place
key = adapter.schema.foreign_keys(:w6b_live_children).or_panic.first
assert key.to_table == "w6b_live"
assert key.on_delete == ReferentialAction::Cascade
assert key.on_update == ReferentialAction::Restrict

# it: keeps the default and comment when only the type changes
statements = setup
statements.change_column(:w6b_live, :qty, :bigint).or_panic
adapter.reset_schema_caches_in_place
info = adapter.schema.columns(:w6b_live).or_panic.find { |column| column.name == "qty" }.as(ColumnInfo)
assert info.sql_type.downcase.includes?("bigint")
assert info.default.to_s.includes?("3")
statements.change_column(:w6b_live, :stamped, :datetime, precision: 6).or_panic
assert adapter.schema.columns(:w6b_live).or_panic.find { |column| column.name == "stamped" }.as(ColumnInfo).default.to_s.upcase.includes?("CURRENT_TIMESTAMP")

# it: drops a default on a nullable column so an insert that skips it stores NULL
statements = setup
statements.change_column_default(:w6b_live, :qty, to: nil).or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.columns(:w6b_live).or_panic.find { |column| column.name == "qty" }.as(ColumnInfo).default.nil?
adapter.open { |db| db.exec("INSERT INTO w6b_live (name, created_at, updated_at) VALUES ('b', '2024-01-01 00:00:00', '2024-01-01 00:00:00')") }.or_panic
assert adapter.open { |db| db.scalar("SELECT qty FROM w6b_live WHERE name = 'b'") }.or_panic.nil?

# it: restates a column with a quoted default through change_column_null
statements = setup
statements.change_column_null(:w6b_live, :role, true).or_panic
statements.change_column_null(:w6b_live, :role, false).or_panic
adapter.reset_schema_caches_in_place
assert adapter.schema.columns(:w6b_live).or_panic.find { |column| column.name == "role" }.as(ColumnInfo).default.to_s.includes?("it")
adapter.open { |db| db.exec("INSERT INTO w6b_live (name, created_at, updated_at) VALUES ('c', '2024-01-01 00:00:00', '2024-01-01 00:00:00')") }.or_panic
assert adapter.open { |db| db.scalar("SELECT role FROM w6b_live WHERE name = 'c'") }.or_panic == "it's member"
statements.drop_table(:w6b_live_children, :w6b_live, if_exists: true).or_panic
