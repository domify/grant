module test/grant_schema_migration_context_test
import grant/schema/migration::{Migration, InvalidMigration}
import grant/schema/migration_context::{MigrationContext, MigrationStatus, UnknownMigrationVersion}
import grant/schema/schema_migration::{SchemaMigration}
import grant/error::{ErrorBase}
import grant/events::{SQL}
import grant/notifications
import std/io::{Memory}
import std/text
import std/regex
import test/m03_fixture
import test/m03_fixture::{M03CreateUsers, M03AddAgeToUsers, M03CreatePosts}
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class M03RawExecute < Migration
  migration_version 20240201000001

  def up : Nil | ErrorBase | Cancelled
    create_table :m03_widgets do |t|
      t.string :label
    end!
    execute "INSERT INTO m03_widgets (label) VALUES ('first')"
  end

  def down : Nil | ErrorBase | Cancelled
    drop_table :m03_widgets
  end
end

pub class M03QualifiedPg < Migration
  migration_version 20240201000002

  def up : Nil | ErrorBase | Cancelled
    create_table "public.m03_widgets" do |t|
      t.string :label
    end!
    add_index("public.m03_widgets", :label)!
    add_column("public.m03_widgets", :note, :string)!
    execute "INSERT INTO public.m03_widgets (label) VALUES ('first')"
  end

  def down : Nil | ErrorBase | Cancelled
    drop_table "public.m03_widgets"
  end
end

pub class M03Chatty < Migration
  migration_version 20240201000004

  def up : Nil | ErrorBase | Cancelled
    say "hello from the migration"
    say_with_time("backfill") { 3 }
    announce "announced"
    suppress_messages { say "hidden" }
    nil
  end

  def down : Nil | ErrorBase | Cancelled
  end
end

pub class M03SlowOnce < Migration
  migration_version 20240201000003

  @@runs : Int32 = 0
  def self.runs : Int32
    @@runs
  end
  def self.runs=(value : Int32) : Int32
    @@runs = value
  end

  def up : Nil | ErrorBase | Cancelled
    self.class.runs += 1
    sleep(100)!
    nil
  end

  def down : Nil | ErrorBase | Cancelled
  end
end

register_spec_connections
restore_default_spec_connections

# it: migrates everything pending, in version order, and tracks it
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreatePosts, M03AddAgeToUsers, M03CreateUsers, verbose: false)
assert context.pending.or_panic.map { |entry| entry.version } == [20240101000001_i64, 20240101000002_i64, 20240101000003_i64]
assert context.migrate.or_panic == [20240101000001_i64, 20240101000002_i64, 20240101000003_i64]
assert ::Test::M03Fixture.table?("m03_users")
assert ::Test::M03Fixture.column?("m03_users", "age")
assert ::Test::M03Fixture.table?("m03_posts")
assert ::Test::M03Fixture.versions == [20240101000001_i64, 20240101000002_i64, 20240101000003_i64]
assert context.current_version.or_panic == 20240101000003_i64
assert context.migrate.or_panic.empty?

# it: migrates up and down to a version
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03AddAgeToUsers, M03CreatePosts, verbose: false)
assert context.migrate(20240101000002_i64).or_panic == [20240101000001_i64, 20240101000002_i64]
assert !::Test::M03Fixture.table?("m03_posts")
assert context.migrate(20240101000003_i64).or_panic == [20240101000003_i64]
assert context.migrate(20240101000001_i64).or_panic == [20240101000003_i64, 20240101000002_i64]
assert !::Test::M03Fixture.column?("m03_users", "age")
assert ::Test::M03Fixture.table?("m03_users")
assert context.migrate(0_i64).or_panic == [20240101000001_i64]
assert !::Test::M03Fixture.table?("m03_users")
assert ::Test::M03Fixture.versions.empty?
assert context.migrate(42_i64).is_a?(UnknownMigrationVersion)

# it: rolls back by step, redoes, and moves forward
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03AddAgeToUsers, M03CreatePosts, verbose: false)
context.migrate.or_panic
assert context.rollback.or_panic == [20240101000003_i64]
assert !::Test::M03Fixture.table?("m03_posts")
assert context.rollback(2).or_panic == [20240101000002_i64, 20240101000001_i64]
assert !::Test::M03Fixture.table?("m03_users")

assert context.forward.or_panic == [20240101000001_i64]
assert context.forward(2).or_panic == [20240101000002_i64, 20240101000003_i64]
assert context.forward.or_panic.empty?

assert context.redo(2).or_panic == [20240101000003_i64, 20240101000002_i64, 20240101000002_i64, 20240101000003_i64]
assert ::Test::M03Fixture.versions.size == 3
assert ::Test::M03Fixture.column?("m03_users", "age")

# it: runs and reverses one version with up and down, skipping what already happened
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03AddAgeToUsers, verbose: false)
assert context.up(20240101000002_i64).or_panic == [20240101000002_i64] if context.up(20240101000001_i64).or_panic == [20240101000001_i64]
assert context.up(20240101000002_i64).or_panic.empty?
assert ::Test::M03Fixture.column?("m03_users", "age")
assert context.down(20240101000002_i64).or_panic == [20240101000002_i64]
assert context.down(20240101000002_i64).or_panic.empty?
assert !::Test::M03Fixture.column?("m03_users", "age")
assert context.up(1_i64).is_a?(UnknownMigrationVersion)

# it: reports status, including a recorded version that has no file
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03AddAgeToUsers, verbose: false)
context.forward.or_panic
SchemaMigration.new(::Test::M03Fixture.adapter).record(20200101000000_i64).or_panic
rows = context.status.or_panic
assert rows.map { |entry| entry.version } == [20200101000000_i64, 20240101000001_i64, 20240101000002_i64]
assert rows.map { |row| row.state } == ["up", "up", "down"]
assert rows[0].missing?
assert rows[0].name == MigrationStatus::NO_FILE
assert rows[1].name == "#{M03CreateUsers}"
assert rows[2].to_s == "down  20240101000002  #{M03AddAgeToUsers}"

# it: reads the applied versions with one SELECT however many migrations there are
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03AddAgeToUsers, M03CreatePosts, verbose: false)
context.migrate.or_panic
queries = [] of String
handler = ->(event : SQL) { queries << event.sql; nil }
::Grant::Notifications.subscribed(SQL, handler) do
  assert context.pending.or_panic.empty?
end
assert queries.count { |sql| sql.includes?("schema_migrations") } == 1

# it: announces each migration and the schema calls it makes
::Test::M03Fixture.reset_in_place
io = Memory.new
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, output: io)
context.migrate.or_panic
text = io.to_s
assert text.includes?("== #{M03CreateUsers}: migrating")
assert text.includes?("-- create_table(:m03_users)")
assert text.matches?(/-> [0-9]+\.[0-9]{4}s/)
assert text.includes?("== #{M03CreateUsers}: migrated (")
io.clear
context.rollback.or_panic
assert io.to_s.includes?("== #{M03CreateUsers}: reverting")
assert io.to_s.includes?("-- drop_table")

# it: prints the SQL of a dry run and changes nothing
::Test::M03Fixture.reset_in_place
io = Memory.new
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, output: io, dry_run: true)
assert context.migrate.or_panic == [20240101000001_i64]
assert io.to_s.includes?("CREATE TABLE")
assert !::Test::M03Fixture.table?("m03_users")
assert !::Test::M03Fixture.table?("schema_migrations")

# it: prints say, say_with_time and announce output and silences it with suppress_messages
::Test::M03Fixture.reset_in_place
io = Memory.new
context = MigrationContext.for(::Test::M03Fixture.adapter, M03Chatty, output: io)
context.migrate.or_panic
text = io.to_s
assert text.includes?("-- hello from the migration")
assert text.includes?("-- backfill")
assert text.includes?("   -> 3 rows")
assert text.includes?("== #{M03Chatty}: announced =")
assert !text.includes?("hidden")

# it: runs a migration once when two runners start together
::Test::M03Fixture.reset_in_place
M03SlowOnce.runs = 0
done = Channel(Nil).new
group do |tasks|
  2.times do
    tasks.spawn do
      MigrationContext.for(::Test::M03Fixture.adapter, M03SlowOnce, verbose: false).migrate.or_panic
      done.send(nil).or_panic
    end
  end
  2.times { done.receive.or_panic }
end
assert M03SlowOnce.runs == 1
assert ::Test::M03Fixture.versions == [20240201000003_i64]

# it: rejects two migrations with the same version
::Test::M03Fixture.reset_in_place
context = MigrationContext.for(::Test::M03Fixture.adapter, M03CreateUsers, M03CreateUsers, verbose: false)
error = context.migrate
assert error.is_a?(InvalidMigration)
assert error.as(InvalidMigration).message.matches?(/same|Two migrations/)

# it: runs a raw execute and qualified table names through the runner
::Test::M03Fixture.reset_in_place
qualified = ::Test::M03Fixture.adapter.postgres? ? "public.m03_widgets" : "m03_widgets"
klass = ::Test::M03Fixture.adapter.postgres? ? M03QualifiedPg : M03RawExecute
context = MigrationContext.for(::Test::M03Fixture.adapter, klass, verbose: false)
context.migrate.or_panic
assert ::Test::M03Fixture.table?("m03_widgets")
count = ::Test::M03Fixture.adapter.open { |db| db.scalar("SELECT COUNT(*) FROM #{qualified}").or_panic.as(Int64) }.or_panic
assert count == 1
context.rollback.or_panic
assert !::Test::M03Fixture.table?("m03_widgets")
::Test::M03Fixture.reset_in_place
