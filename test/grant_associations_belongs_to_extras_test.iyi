module test/grant_associations_belongs_to_extras_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class BteAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table bte_authors
  column id : Int64, primary: true
  column name : String?
end

pub class BtePost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table bte_posts
  column id : Int64, primary: true
  column title : String?
  belongs_to :bte_author, class_name: BteAuthor, foreign_key: bte_author_id : Int64?,
    default: ->(post : BtePost) { BteAuthor.find_by(name: "house") }
end

pub class BteNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table bte_notes
  column id : Int64, primary: true
  belongs_to :bte_author, class_name: BteAuthor, foreign_key: bte_author_id : Int64?, optional: true
end
register_spec_connections
BteAuthor.migrator.drop_and_create.or_panic
BtePost.migrator.drop_and_create.or_panic
BteNote.migrator.drop_and_create.or_panic

# it: fills a missing parent before validation on create
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
house = BteAuthor.create_strict(name: "house").or_panic

post = BtePost.new(title: "t")
assert post.save.or_panic

assert post.bte_author_id == house.id
assert BtePost.find_strict(post.id).or_panic.bte_author_id == house.id

# it: satisfies the required-parent validation
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
BteAuthor.create_strict(name: "house").or_panic

assert BtePost.new(title: "t").valid?.or_panic

# it: does not override a parent that is set
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
BteAuthor.create_strict(name: "house").or_panic
other = BteAuthor.create_strict(name: "other").or_panic

post = BtePost.new(title: "t")
post.bte_author = other
assert post.save.or_panic

assert post.bte_author_id == other.id

# it: leaves the key empty when the default finds nothing
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
post = BtePost.new(title: "t")

assert !post.valid?.or_panic
assert post.bte_author_id.nil?

# it: does not run on update
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
house = BteAuthor.create_strict(name: "house").or_panic
post = BtePost.create_strict(title: "t").or_panic
assert post.bte_author_id == house.id

BtePost.where(id: post.id).update_all(bte_author_id: nil).or_panic
reloaded = BtePost.find_strict(post.id).or_panic
reloaded.title = "changed"
assert reloaded.save(validate: false).or_panic

assert BtePost.find_strict(post.id).or_panic.bte_author_id.nil?

# it: reflect the foreign key's dirty state
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
one = BteAuthor.create_strict(name: "one").or_panic
two = BteAuthor.create_strict(name: "two").or_panic
note = BteNote.create_strict(bte_author_id: one.id).or_panic

assert !note.bte_author_changed?
assert note.bte_author_previously_changed? # the create set the key

note = BteNote.find_strict(note.id).or_panic
assert !note.bte_author_changed?
assert !note.bte_author_previously_changed?

note.bte_author = two
assert note.bte_author_changed?
assert !note.bte_author_previously_changed?

note.save_strict.or_panic
assert !note.bte_author_changed?
assert note.bte_author_previously_changed?

note.save_strict.or_panic
assert !note.bte_author_previously_changed?

# it: is true while an unsaved parent is assigned
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
note = BteNote.new
assert !note.bte_author_changed?

note.bte_author = BteAuthor.new(name: "fresh")
assert note.bte_author_changed?

# it: saves the parent with the child
BtePost.clear.or_panic
BteNote.clear.or_panic
BteAuthor.clear.or_panic
note = BteNote.new
note.bte_author = BteAuthor.new(name: "fresh")

assert note.save.or_panic

assert BteAuthor.find_by(name: "fresh").or_panic.as(BteAuthor).id == note.bte_author_id

BteAuthor.adapter.close.or_panic
