module test/grant_querying_from_rs_test
import grant/base::{Base}
import grant/adapter/driver::{Value}
import test/querying_spec_models::{Review}
import test/converter_spec_support::{FieldEmitter}
import std/time::{Time}
import test/spec_helper::{register_spec_connections}

macro build_review_emitter
  begin
    %emitter = FieldEmitter(Value).new
    %emitter._set_values([
      8_i64,
      "name",
      nil,
      nil,
      nil,
      nil,
      true,
      Time.utc,
    ] of Value)
    %emitter
  end
end

def method_which_takes_any_model(model : T) forall T
  model.from_rs(build_review_emitter)
end

# it: Builds a model from a resultset
model = Review.from_rs(build_review_emitter).or_panic
assert model.class.to_s == Review.to_s

# Named result columns keep reordered and partial projections aligned.
register_spec_connections
Review.migrator.drop_and_create.or_panic
review = Review.create_strict(name: "named", published: true).or_panic
loaded = Review.connection.with_result_set("SELECT name, id, published FROM reviews") do |rs|
  found = nil.as(Review?)
  rs.each { found = Review.from_rs(rs).or_panic }
  found
end.or_panic.as(Review)
assert loaded.id == review.id
assert loaded.name == "named"
assert loaded.published == true
assert !loaded.new_record?
assert !loaded.changed?
Review.adapter.close.or_panic
