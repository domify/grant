module test/grant_callbacks_around_callbacks_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class AroundCallbackModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table around_callback_models

  column id : Int64, primary: true
  column name : String?

  property log : Array(String) = [] of String

  around_save do |block|
    log << "around_save:before"
    block.call
    log << "around_save:after"
  end

  around_create do |block|
    log << "around_create:before"
    block.call
    log << "around_create:after"
  end

  around_update do |block|
    log << "around_update:before"
    block.call
    log << "around_update:after"
  end

  around_destroy do |block|
    log << "around_destroy:before"
    block.call
    log << "around_destroy:after"
  end
end

# Model that can conditionally halt around callbacks
pub class HaltingAroundModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table halting_around_models

  column id : Int64, primary: true
  column name : String?

  property log : Array(String) = [] of String
  property halt_around_save : Bool = false
  property halt_around_create : Bool = false
  property halt_around_destroy : Bool = false

  around_save do |block|
    if halt_around_save
      log << "around_save:halted"
      # Not calling block.call — operation should be halted
    else
      log << "around_save:before"
      block.call
      log << "around_save:after"
    end
  end

  around_create do |block|
    if halt_around_create
      log << "around_create:halted"
    else
      block.call
    end
  end

  around_destroy do |block|
    if halt_around_destroy
      log << "around_destroy:halted"
    else
      block.call
    end
  end

  after_save do
    log << "after_save"
  end
end

# Model with multiple around_save callbacks to test nesting
pub class MultiAroundModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table multi_around_models

  column id : Int64, primary: true
  column name : String?

  property log : Array(String) = [] of String

  # First registered = outermost wrapper
  around_save do |block|
    log << "outer:before"
    block.call
    log << "outer:after"
  end

  # Second registered = inner wrapper
  around_save do |block|
    log << "inner:before"
    block.call
    log << "inner:after"
  end
end

# Model with method-based around callback
pub class MethodAroundModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table method_around_models

  column id : Int64, primary: true
  column name : String?

  property log : Array(String) = [] of String

  around_save :wrap_in_logging

  private def wrap_in_logging(block : Proc(Nil))
    log << "method_around:before"
    block.call
    log << "method_around:after"
  end
end

register_spec_connections
AroundCallbackModel.migrator.drop_and_create.or_panic
HaltingAroundModel.migrator.drop_and_create.or_panic
MultiAroundModel.migrator.drop_and_create.or_panic
MethodAroundModel.migrator.drop_and_create.or_panic

# it: wraps the save operation with before/after behavior
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = AroundCallbackModel.new
record.name = "test"
record.save.or_panic

assert record.log.includes?("around_save:before")
assert record.log.includes?("around_save:after")
# Verify order: around_save:before comes before around_save:after
before_idx = (record.log.index("around_save:before") || raise "Missing callback entry")
after_idx = (record.log.index("around_save:after") || raise "Missing callback entry")
assert before_idx < after_idx

# it: actually persists the record when block is called
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = AroundCallbackModel.new
record.name = "persisted"
result = record.save.or_panic
assert result
assert AroundCallbackModel.where(name: "persisted").first.or_panic.is_a?(AroundCallbackModel)

# it: wraps the create operation
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = AroundCallbackModel.new
record.name = "test_create"
record.save.or_panic

assert record.log.includes?("around_create:before")
assert record.log.includes?("around_create:after")

# it: does not run around_create on update
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = AroundCallbackModel.new
record.name = "update_test"
record.save.or_panic
record.log.clear

record.name = "update_test_modified"
record.save.or_panic

assert !record.log.includes?("around_create:before")
assert !record.log.includes?("around_create:after")

# it: wraps the update operation
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
created = AroundCallbackModel.new
created.name = "to_update"
created.save.or_panic
record = AroundCallbackModel.where(name: "to_update").first_strict.or_panic
record.log.clear

record.name = "to_update_v2"
record.save.or_panic

assert record.log.includes?("around_update:before")
assert record.log.includes?("around_update:after")

# it: does not run around_update on create
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = AroundCallbackModel.new
record.name = "create_only"
record.save.or_panic

assert !record.log.includes?("around_update:before")
assert !record.log.includes?("around_update:after")

# it: wraps the destroy operation
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
created = AroundCallbackModel.new
created.name = "to_destroy"
created.save.or_panic
record = AroundCallbackModel.where(name: "to_destroy").first_strict.or_panic
record.log.clear

record.destroy.or_panic

assert record.log.includes?("around_destroy:before")
assert record.log.includes?("around_destroy:after")

# it: actually destroys the record when block is called
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
created = AroundCallbackModel.new
created.name = "will_die"
created.save.or_panic
record = AroundCallbackModel.where(name: "will_die").first_strict.or_panic
result = record.destroy.or_panic
assert result
assert AroundCallbackModel.where(name: "will_die").first.or_panic.nil?

# it: halts save when around_save does not call block
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = HaltingAroundModel.new
record.name = "halt_save"
record.halt_around_save = true
result = record.save.or_panic
assert !result
assert HaltingAroundModel.where(name: "halt_save").first.or_panic.nil?

# it: halts create when around_create does not call block
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = HaltingAroundModel.new
record.name = "halt_create"
record.halt_around_create = true
result = record.save.or_panic
assert !result
assert HaltingAroundModel.where(name: "halt_create").first.or_panic.nil?

# it: halts destroy when around_destroy does not call block
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
created = HaltingAroundModel.new
created.name = "no_destroy"
created.save.or_panic
record = HaltingAroundModel.where(name: "no_destroy").first_strict.or_panic
record.halt_around_destroy = true
result = record.destroy.or_panic
assert !result
# Record should still exist
assert HaltingAroundModel.where(name: "no_destroy").first.or_panic.is_a?(HaltingAroundModel)

# it: does not run after_save when around_save halts
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = HaltingAroundModel.new
record.name = "halt_no_after"
record.halt_around_save = true
record.save.or_panic

assert record.log.includes?("around_save:halted")
assert !record.log.includes?("after_save")

# it: nests callbacks in registration order (first = outermost)
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = MultiAroundModel.new
record.name = "multi"
record.save.or_panic

# First registered wraps second registered wraps operation
assert record.log.includes?("outer:before")
assert record.log.includes?("inner:before")
assert record.log.includes?("inner:after")
assert record.log.includes?("outer:after")

# Verify nesting order
outer_before = (record.log.index("outer:before") || raise "Missing callback entry")
inner_before = (record.log.index("inner:before") || raise "Missing callback entry")
inner_after = (record.log.index("inner:after") || raise "Missing callback entry")
outer_after = (record.log.index("outer:after") || raise "Missing callback entry")

assert outer_before < inner_before
assert inner_before < inner_after
assert inner_after < outer_after

# it: uses a named method as around callback
AroundCallbackModel.clear.or_panic
HaltingAroundModel.clear.or_panic
MultiAroundModel.clear.or_panic
MethodAroundModel.clear.or_panic
record = MethodAroundModel.new
record.name = "method_cb"
record.save.or_panic

assert record.log.includes?("method_around:before")
assert record.log.includes?("method_around:after")
