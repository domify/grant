module test/grant_validators_contexts_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class ContextUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table context_users

  column id : Int64, primary: true
  column username : String?
  column email : String?
  column terms_accepted : Bool = false
  column update_reason : String?

  # Always required (default context: :save)
  validates_presence_of :username

  # Required only on create
  validate :terms_accepted, "must be accepted on signup", ->(record : ContextUser) {
    !!record.terms_accepted
  }, context: :create

  # Required only on update
  validates_presence_of :update_reason, on: :update
end

pub class ContextPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table context_posts

  column id : Int64, primary: true
  column title : String?
  column body : String?
  column priority : Int32 = 1
  column status : String = "draft"

  # Always required
  validates_presence_of :title

  # Body length only checked on update
  validates_length_of :body, minimum: 10, on: :update

  # Priority only checked on create
  validates_numericality_of :priority, greater_than: 0, on: :create

  # Status only checked on update
  validates_inclusion_of :status, in: ["draft", "published", "archived"], on: :update
end

register_spec_connections


# it: runs create-only validators when context is :create
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = true
  assert record.valid?(context: :create).or_panic

  record.terms_accepted = false
  assert !record.valid?(context: :create).or_panic
  assert record.errors.first.field == "terms_accepted"
end

# it: skips create-only validators when context is :update
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = false        # would fail on create
  record.update_reason = "some reason" # required on update
  assert record.valid?(context: :update).or_panic
end

# it: runs update-only validators when context is :update
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = true
  record.update_reason = nil
  assert !record.valid?(context: :update).or_panic
  assert record.errors.first.field == "update_reason"
end

# it: skips update-only validators when context is :create
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = true
  record.update_reason = nil # would fail on update
  assert record.valid?(context: :create).or_panic
end

# it: runs save validators on both create and update context
begin
  record = ContextUser.new
  record.username = nil
  record.email = "john@example.com"
  record.terms_accepted = true

  assert !record.valid?(context: :create).or_panic
  assert record.errors.first.field == "username"

  record.errors.clear
  assert !record.valid?(context: :update).or_panic
  assert record.errors.first.field == "username"
end

# it: runs save validators when no context is specified
begin
  record = ContextUser.new
  record.username = nil

  assert !record.valid?.or_panic
  assert record.errors.first.field == "username"
end

# it: applies correct validators for each context
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = true
  record.update_reason = "updating profile"

  # Should pass both contexts
  assert record.valid?(context: :create).or_panic
  assert record.valid?(context: :update).or_panic
end

# Upstream: defaults to :create for a new record, so on: :update validators do not run
# it: "defaults to :create for a new record, so on: :update validators
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = false # create-only fails
  record.update_reason = nil    # update-only would fail

  assert !record.valid?.or_panic
  error_fields = record.errors.map(&.field.to_s)
  assert error_fields.includes?("terms_accepted")
  assert !error_fields.includes?("update_reason")
end

# it: runs every validator for an explicit :save context
begin
  record = ContextUser.new
  record.username = "john"
  record.email = "john@example.com"
  record.terms_accepted = false
  record.update_reason = nil

  assert !record.valid?(context: :save).or_panic
  error_fields = record.errors.map(&.field.to_s)
  assert error_fields.includes?("terms_accepted")
  assert error_fields.includes?("update_reason")
end

# it: validates_length_of with on: :update
begin
  record = ContextPost.new
  record.title = "Hi"
  record.body = "Short"

  # On create, body length not checked
  assert record.valid?(context: :create).or_panic

  # On update, body must be >= 10 chars
  assert !record.valid?(context: :update).or_panic
  assert record.errors.first.field == "body"

  record.body = "This is long enough"
  assert record.valid?(context: :update).or_panic
end

# it: validates_numericality_of with on: :create
begin
  record = ContextPost.new
  record.title = "Hello"
  record.body = "Long enough content"
  record.priority = -1

  # On create, priority must be > 0
  assert !record.valid?(context: :create).or_panic
  assert record.errors.first.field == "priority"

  # On update, priority not validated
  record.errors.clear
  assert record.valid?(context: :update).or_panic
end

# it: validates_inclusion_of with on: :update
begin
  record = ContextPost.new
  record.title = "Hello"
  record.body = "Long enough content"
  record.priority = 1
  record.status = "invalid_status"

  # On create, status not validated
  assert record.valid?(context: :create).or_panic

  # On update, status must be in list
  assert !record.valid?(context: :update).or_panic
  assert record.errors.first.field == "status"
end
