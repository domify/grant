module test/grant_locking_lock_wait_test
import grant/base::{Base}
import grant/locking::{LockMode, LockWaitTimeoutError}
import grant/error_taxonomy::{LockWaitTimeout}
import test/spec_helper::{register_spec_connections}

pub class LockWaitSpecJob < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table lock_wait_spec_jobs

  column id : Int64, primary: true
  column state : String
end

register_spec_connections
LockWaitSpecJob.migrator.drop_and_create.or_panic

# Holds a row lock in a second task (so on a second connection) while the
# block runs, then lets that task commit.
private def lock_wait_spec_holding(id : Int64, mode : LockMode = LockMode::Update, &block : -> T) forall T
  held = Channel(Nil).new
  release = Channel(Nil).new
  failures = [] of String
  outcomes = [] of T
  group do |tasks|
    tasks.spawn do
      result = LockWaitSpecJob.transaction do
        locked = LockWaitSpecJob.where(id: id).lock(mode).first_strict
        if locked.is_a?(::Error)
          locked
        else
          held.send(nil).or_panic
          release.receive.or_panic
          nil
        end
      end
      if result.is_a?(::Error)
        failures << result.message
        held.send(nil).or_panic if failures.size == 1 && outcomes.empty?
      end
    end

    select
    when held.receive
    when timeout(10000)
      raise "the lock holder never took its lock"
    end
    raise failures.first unless failures.empty?

    outcomes << block.call
    release.send(nil).or_panic
  end
  raise failures.first unless failures.empty?
  outcomes.first
end

private def lock_wait_spec_real_locks? : Bool
  LockWaitSpecJob.adapter.supports_lock_mode?(LockMode::Update)
end

if lock_wait_spec_real_locks?
  # it: raises LockWaitTimeout for NOWAIT on a row another connection holds
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  lock_wait_spec_holding(job.id_strict.or_panic) do
    LockWaitSpecJob.transaction do
      error = LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateNoWait).first_strict
      assert error.is_a?(LockWaitTimeout)
      if error.is_a?(LockWaitTimeout)
        assert !error.cause.nil?
        assert error.sql.to_s.includes?("NOWAIT")
      end
      nil
    end.or_panic
  end

  # it: is the same class the Locking namespace names
  LockWaitSpecJob.clear.or_panic
  # ris metaclass `==` is identity-blind, so the classes are compared by name.
  assert LockWaitTimeoutError.to_s == LockWaitTimeout.to_s

  # it: raises LockWaitTimeout from with_lock and lock! in NOWAIT mode, leaving the record untouched
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  lock_wait_spec_holding(job.id_strict.or_panic) do
    assert job.with_lock(LockMode::UpdateNoWait) { |_locked| :never }.is_a?(LockWaitTimeout)

    LockWaitSpecJob.transaction do
      assert job.lock_strict(LockMode::UpdateNoWait).is_a?(LockWaitTimeout)
      nil
    end.or_panic
  end
  assert job.state == "queued"

  # it: hands a free row to SKIP LOCKED callers and skips the held one
  LockWaitSpecJob.clear.or_panic
  first = LockWaitSpecJob.create_strict(state: "first").or_panic
  second = LockWaitSpecJob.create_strict(state: "second").or_panic
  lock_wait_spec_holding(first.id_strict.or_panic) do
    LockWaitSpecJob.transaction do
      picked = LockWaitSpecJob.order(:id).lock(LockMode::UpdateSkipLocked).first_strict.or_panic
      assert picked.id == second.id
      nil
    end.or_panic
  end

  # it: returns nothing from SKIP LOCKED when every row is held
  LockWaitSpecJob.clear.or_panic
  only = LockWaitSpecJob.create_strict(state: "only").or_panic
  lock_wait_spec_holding(only.id_strict.or_panic) do
    LockWaitSpecJob.transaction do
      assert LockWaitSpecJob.lock(LockMode::UpdateSkipLocked).first.or_panic.nil?
      assert LockWaitSpecJob.lock(LockMode::UpdateSkipLocked).to_a.or_panic.empty?
      nil
    end.or_panic
  end

  # it: makes a plain FOR UPDATE wait until the holder commits
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  events = [] of String
  waiter_done = Channel(Nil).new
  group do |waiters|
    lock_wait_spec_holding(job.id_strict.or_panic) do
      waiters.spawn do
        LockWaitSpecJob.transaction do
          LockWaitSpecJob.where(id: job.id).lock.first_strict.or_panic
          events << "waiter got the lock"
          nil
        end.or_panic
        waiter_done.send(nil).or_panic
      end

      sleep 150
      events << "holder still holds"
      assert events == ["holder still holds"]
    end

    select
    when waiter_done.receive
    when timeout(10000)
      raise "the waiter never got the lock"
    end
  end
  assert events == ["holder still holds", "waiter got the lock"]

  # it: lets FOR SHARE readers share and blocks a NOWAIT writer
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  lock_wait_spec_holding(job.id_strict.or_panic, LockMode::Share) do
    LockWaitSpecJob.transaction do
      assert LockWaitSpecJob.where(id: job.id).lock(LockMode::Share).first_strict.or_panic.state == "queued"
      assert LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateNoWait).first_strict.is_a?(LockWaitTimeout)
      nil
    end.or_panic
  end

  # it: releases the lock when the holder commits, so a later NOWAIT succeeds
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  lock_wait_spec_holding(job.id_strict.or_panic) { nil }

  LockWaitSpecJob.transaction do
    assert LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateNoWait).first_strict.or_panic.state == "queued"
    nil
  end.or_panic
else
  # it: treats NOWAIT and SKIP LOCKED as no-ops: another connection's lock never blocks or hides a row
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic

  lock_wait_spec_holding(job.id_strict.or_panic) do
    LockWaitSpecJob.transaction do
      nowait = LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateNoWait).first_strict.or_panic
      assert nowait.state == "queued"
      skipped = LockWaitSpecJob.lock(LockMode::UpdateSkipLocked).to_a.or_panic
      assert skipped.map(&.id) == [job.id]
      nil
    end.or_panic
  end

  # it: runs with_lock in NOWAIT mode without raising
  LockWaitSpecJob.clear.or_panic
  job = LockWaitSpecJob.create_strict(state: "queued").or_panic
  assert job.with_lock(LockMode::UpdateNoWait) { |locked| locked.state } == "queued"
end

LockWaitSpecJob.adapter.close.or_panic
