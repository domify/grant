module test/grant_persistence_dup_clone_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class CopyArticle < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table copy_articles

  column id : Int64, primary: true
  column title : String?
  column body : String?
  column views : Int32?
  timestamps

  property initialize_runs : Int32 = 0
  after_initialize :count_initialize

  private def count_initialize
    @initialize_runs += 1
  end
end

private def write_statements(&block : -> T) : Array(String) forall T
  statements = [] of String
  connection = CopyArticle.__connection
  previous = connection.query_observer
  connection.query_observer = ->(sql : String) {
    if sql.starts_with?("INSERT") || sql.starts_with?("UPDATE") || sql.starts_with?("DELETE")
      statements << sql
    end
    nil
  }
  yield
  connection.query_observer = previous
  statements
end

register_spec_connections
CopyArticle.migrator.drop_and_create.or_panic

# it: returns a new record with the attributes but no identity
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Hello", body: "World", views: 3).or_panic
copy = original.dup

assert copy.new_record?
assert !copy.persisted?
assert !copy.destroyed?
assert copy.id.nil?
assert copy.title == "Hello"
assert copy.body == "World"
assert copy.views == 3

# it: runs after_initialize callbacks on the copy
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Init").or_panic
runs = original.initialize_runs
assert original.dup.initialize_runs == runs + 1
assert original.clone.initialize_runs == runs

# it: clears the creation and update timestamps
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Stamped").or_panic
assert !original.created_at.nil?
copy = original.dup
assert copy.created_at.nil?
assert copy.updated_at.nil?
copy.save_strict.or_panic
assert !copy.created_at.nil?

# it: inserts a separate row when saved and leaves the original untouched
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Original").or_panic
copy = original.dup
copy.title = "Copy"
copy.save_strict.or_panic

assert !copy.id.nil?
assert copy.id != original.id
assert CopyArticle.count.or_panic == 2
assert CopyArticle.find_strict(original.id).or_panic.title == "Original"
assert CopyArticle.find_strict(copy.id).or_panic.title == "Copy"

# it: is unequal to the original
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Original").or_panic
assert !(original.dup == original)

# it: does not carry dirty history or pending changes into the copy
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Original").or_panic
original.title = "Edited"
copy = original.dup
assert !copy.changed?
assert original.changed?
copy.title = "Other"
assert original.title == "Edited"

# it: does not share the errors collection
CopyArticle.clear.or_panic
original = CopyArticle.new
original.errors.add(:base, "broken")
copy = original.dup
assert copy.errors.size == 0
assert original.errors.size == 1

# it: forgets a destroyed state
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Doomed").or_panic
original.destroy.or_panic
copy = original.dup
assert !copy.destroyed?
assert copy.new_record?
copy.save_strict.or_panic
assert CopyArticle.count.or_panic == 1

# it: keeps the read-only flag, as ActiveRecord does
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Frozen").or_panic
original.readonly_in_place
assert original.dup.readonly?

# it: keeps the identity and persisted state
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Same").or_panic
copy = original.clone

assert !(copy.object_id == original.object_id)
assert copy.persisted?
assert !copy.new_record?
assert copy.id == original.id
assert (copy == original)

# it: has its own dirty tracking
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Same").or_panic
copy = original.clone
original.title = "Edited"

assert original.changed?
assert !copy.changed?
assert copy.title == "Same"

# it: carries pending changes as separate state
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Same").or_panic
original.title = "Edited"
copy = original.clone
assert copy.changed?
copy.save_strict.or_panic
assert original.changed?
assert CopyArticle.find_strict(original.id).or_panic.title == "Edited"

# it: saves as an update, not an insert
CopyArticle.clear.or_panic
original = CopyArticle.create_strict(title: "Same").or_panic
copy = original.clone
copy.title = "Updated"
statements = write_statements { copy.save_strict.or_panic }
assert statements.size == 1
assert statements.first.upcase.includes?("UPDATE")
assert CopyArticle.count.or_panic == 1
CopyArticle.adapter.close.or_panic
