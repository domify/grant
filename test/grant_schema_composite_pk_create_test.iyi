module test/grant_schema_composite_pk_create_test

import grant/base::{Base}
import grant/composite_primary_key::{composite_primary_key}
import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/adapter/schema::{Dialect, InvalidDefinition}
import grant/error::{ErrorBase}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}
import std/text

pub class M02aLineItem < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m02a_line_items
  column order_id : Int64, primary: true, auto: false
  column product_id : Int64, primary: true, auto: false
  column quantity : Int32
  composite_primary_key order_id, product_id
end

# it: emits PRIMARY KEY (a, b) for an explicit key list
[Dialect::Pg, Dialect::Mysql, Dialect::Sqlite].each do |dialect|
  sql = RecordingStatements.new(dialect).create_table_statements(:m02a_pairs, id: false, primary_key: [:a_id, :b_id]) do |t|
    t.bigint(:a_id).or_panic
    t.bigint(:b_id).or_panic
    t.string(:note)
  end.or_panic.first
  assert sql.includes?("PRIMARY KEY (#{dialect.quote("a_id")}, #{dialect.quote("b_id")})")
  assert sql.split("PRIMARY KEY").size - 1 == 1
  assert sql.includes?("#{dialect.quote("a_id")} #{dialect.pg? ? "BIGINT" : "BIGINT"} NOT NULL")
end

# it: collects columns flagged primary_key: true
sql = RecordingStatements.new(Dialect::Pg).create_table_statements(:m02a_flagged, id: false) do |t|
  t.bigint(:a_id, primary_key: true).or_panic
  t.bigint(:b_id, primary_key: true)
end.or_panic.first
assert sql == "CREATE TABLE \"m02a_flagged\" (\n  \"a_id\" BIGINT NOT NULL,\n  \"b_id\" BIGINT NOT NULL,\n  PRIMARY KEY (\"a_id\", \"b_id\")\n)"

# it: makes a single flagged column the key and skips the auto id
sql = RecordingStatements.new(Dialect::Sqlite).create_table_statements(:m02a_one) do |t|
  t.string(:code, primary_key: true, null: false)
end.or_panic.first
assert sql == "CREATE TABLE \"m02a_one\" (\n  \"code\" VARCHAR(255) NOT NULL PRIMARY KEY\n)"

# it: renames the auto key with primary_key: and rejects unknown or doubled keys
rec = RecordingStatements.new(Dialect::Mysql)
assert rec.create_table_statements(:m02a_named, primary_key: :ident) { nil }.or_panic.first.includes?("`ident` BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY")
error = rec.create_table_statements(:m02a_bad, id: false, primary_key: [:a, :b]) { |t| t.integer(:a) }
assert error.is_a?(InvalidDefinition)
assert error.as(InvalidDefinition).message.includes?("not defined")
error = rec.create_table_statements(:m02a_bad, id: false, primary_key: [:a, :b]) do |t|
  t.integer(:a, primary_key: true).or_panic
  t.integer(:b)
end
assert error.is_a?(InvalidDefinition)
assert error.as(InvalidDefinition).message.includes?("not both")

register_spec_connections
restore_default_spec_connections
adapter = ::Test::SchemaFixture.adapter
statements = AdapterStatements.new(adapter)

# it: creates a real composite key table and enforces it
statements.drop_table(:m02a_pairs, if_exists: true).or_panic
statements.create_table(:m02a_pairs, id: false, primary_key: [:a_id, :b_id]) do |t|
  t.bigint(:a_id).or_panic
  t.bigint(:b_id).or_panic
  t.string(:note)
end.or_panic
columns = adapter.schema.columns(:m02a_pairs).or_panic
assert columns.select { |column| column.primary_key? }.map { |column| column.name }.sorted == ["a_id", "b_id"]
adapter.open do |db|
  db.exec("INSERT INTO m02a_pairs (a_id, b_id) VALUES (1, 1)").or_panic
  db.exec("INSERT INTO m02a_pairs (a_id, b_id) VALUES (1, 2)")
end.or_panic
assert adapter.open { |db| db.exec("INSERT INTO m02a_pairs (a_id, b_id) VALUES (1, 2)") }.is_a?(ErrorBase)

# it: derives PRIMARY KEY (a, b) from a model with several primary columns
sql = M02aLineItem.migrator.create_sql
assert sql.includes?("PRIMARY KEY (\"order_id\", \"product_id\")")
assert sql.split("PRIMARY KEY").size - 1 == 1
assert !sql.includes?("SERIAL")
M02aLineItem.migrator.drop_and_create.or_panic
assert adapter.schema.columns(:m02a_line_items).or_panic.select { |column| column.primary_key? }.map { |column| column.name }.sorted == ["order_id", "product_id"]
adapter.open do |db|
  db.exec("INSERT INTO m02a_line_items (order_id, product_id, quantity) VALUES (1, 1, 2)").or_panic
  db.exec("INSERT INTO m02a_line_items (order_id, product_id, quantity) VALUES (1, 2, 3)")
end.or_panic
assert M02aLineItem.count.or_panic == 2
assert adapter.open { |db| db.exec("INSERT INTO m02a_line_items (order_id, product_id, quantity) VALUES (1, 2, 9)") }.is_a?(ErrorBase)
statements.drop_table(:m02a_pairs, if_exists: true).or_panic
M02aLineItem.migrator.drop.or_panic
