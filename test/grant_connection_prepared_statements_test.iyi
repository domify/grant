module test/grant_connection_prepared_statements_test
import test/pool_spec_support::{C02Support}
import test/spec_helper::{CURRENT_ADAPTER}
import grant/adapter/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/connection_registry::{ConnectionRegistry}
import grant/health_monitor::{HealthMonitor}
import grant/adapter/pool_support::{StringKeyCache}
import std/uri::{URI}

pub def cached_statements_after(adapter : Base, count : Int32) : Int32
  count.times { |i| adapter.with_connection(&.scalar("SELECT #{i + 1}")).or_panic }
  adapter.with_connection(&.statement_cache_size).or_panic
end

HealthMonitor.test_mode = true

# it: prepares and caches statements by default
adapter = C02Support.establish("c02_prepared", pool_size: 1, initial_pool_size: 1)

assert adapter.database.or_panic.prepared_statements?
assert adapter.database.or_panic.prepared_statements_cache?
assert cached_statements_after(adapter, 5) >= 5
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

# it: keeps statement_limit as the most statements cached per connection
adapter = C02Support.establish("c02_prepared", pool_size: 1, initial_pool_size: 1, statement_limit: 3)

assert cached_statements_after(adapter, 12) <= 3

# An evicted statement is simply prepared again.
assert adapter.open(&.scalar("SELECT 1")).or_panic == 1
assert adapter.with_connection(&.statement_cache_size).or_panic <= 3
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

# it: evicts the least recently used statement, so one still in use stays cached
cache = StringKeyCache(String).new
cache.limit = 3
cache.fetch("a") { "A" }.or_panic
cache.fetch("b") { "B" }.or_panic
cache.fetch("c") { "C" }.or_panic
assert cache.fetch("a") { "rebuilt A" }.or_panic == "A"

cache.fetch("d") { "D" }.or_panic

assert cache.size == 3
assert cache.fetch("a") { "rebuilt A" }.or_panic == "A"
assert cache.fetch("b") { "rebuilt B" }.or_panic == "rebuilt B"
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

# it: stops caching when statement_limit is 0
adapter = C02Support.establish("c02_prepared", pool_size: 1, initial_pool_size: 1, statement_limit: 0)

assert !adapter.database.or_panic.prepared_statements_cache?
assert cached_statements_after(adapter, 5) == 0
assert adapter.open(&.scalar("SELECT 41 + 1")).or_panic == 42
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

# it: turns preparing off for PgBouncer-style pooling where the driver supports it
adapter = C02Support.establish("c02_prepared", pool_size: 1, initial_pool_size: 1, prepared_statements: false)

if CURRENT_ADAPTER == "pg"
  assert !adapter.database.or_panic.prepared_statements?
  assert cached_statements_after(adapter, 5) == 0
else
  # SQLite can only prepare, and crystal-mysql cannot bind values without
  # preparing, so the flag is ignored rather than breaking queries.
  assert adapter.database.or_panic.prepared_statements?
end

# MySQL casts to SIGNED (a BIGINT); it has no CAST(... AS BIGINT).
sql = adapter.ensure_clause_template(CURRENT_ADAPTER == "mysql" ? "SELECT CAST(? AS SIGNED) + 1" : "SELECT CAST(? AS BIGINT) + 1")
assert adapter.open(&.query_one(sql, 41, as: Int64)).or_panic == 42
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

# it: forwards the options as URL parameters only when they differ from the defaults
defaults = ConnectionRegistry::ConnectionSpec.new("u", Pg, "postgres://localhost/app", :writing)
assert !URI.parse(defaults.build_pool_url).query_params.has_key?("prepared_statements")
assert !URI.parse(defaults.build_pool_url).query_params.has_key?("prepared_statements_cache")

tuned = ConnectionRegistry::ConnectionSpec.new(
  "u", Pg, "postgres://localhost/app", :writing, prepared_statements: false, statement_limit: 0)
params = URI.parse(tuned.build_pool_url).query_params
assert params["prepared_statements"] == "false"
assert params["prepared_statements_cache"] == "false"

sqlite = ConnectionRegistry::ConnectionSpec.new(
  "u", Sqlite, "sqlite3:./app.db", :writing, prepared_statements: false)
assert !URI.parse(sqlite.build_pool_url).query_params.has_key?("prepared_statements")
ConnectionRegistry.remove_connection("c02_prepared", :writing).or_panic

C02Support.cleanup
