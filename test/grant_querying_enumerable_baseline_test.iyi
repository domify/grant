module test/grant_querying_enumerable_baseline_test
import std/enumerable::{Enumerable}
import grant/query/builder::{Builder}
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

pub def reset_parents : Nil
  Parent.clear.or_panic
  Parent.new(name: "alice").save
  Parent.new(name: "bob").save
  Parent.new(name: "carol").save
  Parent.new(name: "dave").save
  Parent.new(name: "eve").save
  nil
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: iterates over query results
reset_parents
names = [] of String?
Parent.where(name: "alice").each do |record|
  names << record.name
end.or_panic
assert names.size == 1
assert names.first == "alice"

# it: iterates over multiple results
reset_parents
names = [] of String?
Parent.where(name: ["alice", "bob", "carol"]).each do |record|
  names << record.name
end.or_panic
assert names.size == 3

# it: transforms query results
reset_parents
names = Parent.where(name: ["alice", "bob"]).map(&.name).or_panic
assert names.size == 2
assert names.includes?("alice")
assert names.includes?("bob")

# it: filters out records matching the condition
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).reject { |r| r.name == "carol" }.or_panic
assert results.size == 2
assert !results.map(&.name).includes?("carol")

# it: executes the query and returns records
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).select.or_panic
assert results.size == 3

# it: returns all matching records
reset_parents
results = Parent.where(name: ["alice", "bob"]).to_a.or_panic
assert results.size == 2

# it: returns Int64 from SQL COUNT
reset_parents
count = Parent.where(name: ["alice", "bob", "carol"]).count.or_panic
assert count.is_a?(Int64)
assert count == 3

# it: returns true when records exist
reset_parents
assert Parent.where(name: "alice").any?.or_panic

# it: returns false when no records match
reset_parents
assert !Parent.where(name: "nonexistent").any?.or_panic

# it: returns the first matching record
reset_parents
result = Parent.where(name: "alice").first.or_panic
assert !result.nil?
assert result.as(Parent).name == "alice"

# it: checks for record existence via SQL
reset_parents
assert Parent.where(name: "alice").exists?.or_panic
assert !Parent.where(name: "nonexistent").exists?.or_panic

# it: supports where + order + limit chaining
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).order(name: :asc).limit(2).select.or_panic
assert results.size == 2
assert results.first.name == "alice"

# it: returns Int64 (same as count)
reset_parents
size = Parent.where(name: ["alice", "bob", "carol"]).size.or_panic
assert size.is_a?(Int64)
assert size == 3

# it: requires .all before .select with block
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.select do |r|
  r.name == "alice" || r.name == "bob"
end
assert results.size == 2

# it: requires .all before .count with block
reset_parents
count = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.count do |r|
  r.name == "alice"
end
assert count == 1

# it: requires .all before .any? with block
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.any? do |r|
  r.name == "carol"
end
assert result

# it: requires .all before .min_by
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.min_by { |r| r.name || "" }
assert result.name == "alice"

# it: requires .all before .max_by
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.max_by { |r| r.name || "" }
assert result.name == "carol"

# it: requires .all before .sort_by
reset_parents
results = Parent.where(name: ["carol", "alice", "bob"]).to_a.or_panic.sorted_by { |r| r.name || "" }
assert results.map(&.name) == ["alice", "bob", "carol"]

# it: requires .all before .reduce
reset_parents
total = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.reduce("") { |acc, r| acc + (r.name || "") }
assert total.includes?("alice")
assert total.includes?("bob")
assert total.includes?("carol")

# it: requires .all before .partition
reset_parents
a_names, others = Parent.where(name: ["alice", "bob", "carol"]).to_a.or_panic.partition do |r|
  name = r.name
  name ? name.starts_with?("a") : false
end
assert a_names.size == 1
assert others.size == 2

Parent.adapter.close.or_panic
