module test/querying_spec_models
pub import grant/base
import grant/base::{Base}
import std/time::{Time}

pub class Review < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table reviews
  column id : Int64, primary: true
  column name : String?
  column downvotes : Int32?
  column upvotes : Int64?
  column sentiment : Float32?
  column interest : Float64?
  column published : Bool?
  column created_at : Time?
end

pub class Student < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table students
  column id : Int64, primary: true
  column name : String?
end
