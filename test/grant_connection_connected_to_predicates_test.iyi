module test/grant_connection_connected_to_predicates_test
import grant
import grant/base::{Base}
import grant/error::{ArgumentError, ErrorBase}

pub class C01PredicateBase < Base
  table c01_predicate_bases
  column id : Int64, primary: true
end
pub class C01PredicateOther < Base
  table c01_predicate_others
  column id : Int64, primary: true
end
pub class C01PredicateChild < C01PredicateBase
end
pub class PredicateTodo < Base
  table todos
  column id : Int64, primary: true
end

# it: reports the role and shard in effect
assert C01PredicateBase.connected_to?(role: :writing).or_panic
assert !C01PredicateBase.connected_to?(role: :reading).or_panic
C01PredicateBase.connected_to(role: :reading, shard: :one) do
  assert C01PredicateBase.connected_to?(role: :reading).or_panic
  assert C01PredicateBase.connected_to?(role: :reading, shard: :one).or_panic
  assert !C01PredicateBase.connected_to?(role: :reading, shard: :two).or_panic
  assert !C01PredicateBase.connected_to?(role: :writing).or_panic
  assert C01PredicateBase.connected_to?(shard: :one).or_panic
end
assert !C01PredicateBase.connected_to?(role: :reading).or_panic

# it: counts an unsharded connection as the default shard
assert C01PredicateBase.connected_to?(shard: :default).or_panic
assert !C01PredicateBase.connected_to?(shard: :one).or_panic

# it: requires a role or a shard
assert C01PredicateBase.connected_to?.is_a?(ArgumentError)

# it: applies a parent's block to subclasses but not to unrelated models
C01PredicateBase.connected_to(role: :reading) do
  assert C01PredicateChild.connected_to?(role: :reading).or_panic
  assert !C01PredicateOther.connected_to?(role: :reading).or_panic
end
C01PredicateChild.connected_to(role: :reading) do
  assert !C01PredicateBase.connected_to?(role: :reading).or_panic
end

# it: switches the fiber without a block until reset
C01PredicateBase.connecting_to(role: :reading, shard: :one)
assert C01PredicateBase.connected_to?(role: :reading, shard: :one).or_panic
assert C01PredicateBase.preventing_writes?
assert !C01PredicateOther.connected_to?(role: :reading).or_panic
C01PredicateBase.reset_connecting_to
assert !C01PredicateBase.connected_to?(role: :reading).or_panic
assert C01PredicateBase.current_shard.nil?

# it: is fiber-local
group do |tasks|
  seen = Channel(Bool).new
  C01PredicateBase.connecting_to(role: :reading)
  tasks.spawn { seen.send(C01PredicateBase.connected_to?(role: :reading).or_panic).or_panic }
  assert !seen.receive.or_panic
  assert C01PredicateBase.connected_to?(role: :reading).or_panic
  C01PredicateBase.reset_connecting_to
end

# it: switches every listed class, and only those
def check_many : Int32
  assert C01PredicateBase.connected_to?(role: :reading).or_panic
  assert C01PredicateOther.connected_to?(role: :reading).or_panic
  assert !PredicateTodo.connected_to?(role: :reading).or_panic
  42
end
value = ::Grant.connected_to_many(C01PredicateBase, C01PredicateOther, role: :reading) do
  check_many
end
assert value == 42
assert !C01PredicateBase.connected_to?(role: :reading).or_panic
assert !C01PredicateOther.connected_to?(role: :reading).or_panic

# it: accepts an array literal and passes shard and prevent_writes
def check_array : Nil
  assert C01PredicateBase.current_shard == :one
  assert C01PredicateOther.current_shard == :one
  assert C01PredicateOther.preventing_writes?
end
::Grant.connected_to_many([C01PredicateBase, C01PredicateOther], shard: :one, prevent_writes: true) do
  check_array
end

# it: restores contexts when the block raises
error = ::Grant.connected_to_many(C01PredicateBase, C01PredicateOther, role: :reading) do
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.message == "boom"
assert C01PredicateBase.connection_context.nil?
assert C01PredicateOther.connection_context.nil?
