module test/write_sql_capture

import grant/adapter/base::{Base}

# Capture the same write statements as upstream's grant.sql memory backend.
pub def statements(adapter : Base, &block : -> T) : Array(String) forall T
  captured = [] of String
  adapter.with_connection do |db|
    previous = db.query_observer
    db.query_observer = ->(sql : String) {
      captured << sql if sql.starts_with?("UPDATE") || sql.starts_with?("INSERT") || sql.starts_with?("DELETE")
      nil
    }
    yield
    db.query_observer = previous
    nil
  end.or_panic
  captured
end
