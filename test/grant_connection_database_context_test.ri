module test/grant_connection_database_context_test
import grant/base::{Base}

pub class ConnectionDatabaseContextTestModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table connection_database_context_test_models

  column id : Int64, primary: true
end


# it: restores the default database after overlapping fiber contexts
group do |tasks|
    original_database = ConnectionDatabaseContextTestModel.database_name
    fiber_a_entered = Channel(Nil).new
    fiber_b_entered = Channel(Nil).new
    fiber_a_exited = Channel(Nil).new
    fiber_b_exited = Channel(Nil).new

    database_seen_by_a = ""
    database_seen_by_a_after_b_entered = ""
    database_seen_by_b = ""
    database_seen_by_b_after_a_exited = ""
    default_database_seen_by_b_after_a_exited = ""

    tasks.spawn do
      ConnectionDatabaseContextTestModel.connected_to(database: "context_database_a") do
        database_seen_by_a = ConnectionDatabaseContextTestModel.current_database
        fiber_a_entered.send(nil).or_panic
        fiber_b_entered.receive.or_panic
        database_seen_by_a_after_b_entered = ConnectionDatabaseContextTestModel.current_database
      end
      fiber_a_exited.send(nil).or_panic
    end

    tasks.spawn do
      fiber_a_entered.receive.or_panic
      ConnectionDatabaseContextTestModel.connected_to(database: "context_database_b") do
        database_seen_by_b = ConnectionDatabaseContextTestModel.current_database
        fiber_b_entered.send(nil).or_panic
        fiber_a_exited.receive.or_panic
        database_seen_by_b_after_a_exited = ConnectionDatabaseContextTestModel.current_database
        default_database_seen_by_b_after_a_exited = ConnectionDatabaseContextTestModel.default_database_name
      end
      fiber_b_exited.send(nil).or_panic
    end

    fiber_b_exited.receive.or_panic

    assert database_seen_by_a == "context_database_a"
    assert database_seen_by_a_after_b_entered == "context_database_a"
    assert database_seen_by_b == "context_database_b"
    assert database_seen_by_b_after_a_exited == "context_database_b"
    assert default_database_seen_by_b_after_a_exited == original_database
    assert ConnectionDatabaseContextTestModel.database_name == original_database
    assert ConnectionDatabaseContextTestModel.current_database == original_database
  end
