module test/grant_querying_all_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: finds all the records
Parent.clear.or_panic
models = (0...100).map do |i|
  model = Parent.new(name: "model_#{i}")
  model.save
  model
end
model_ids = models.map { |model| model.id }
all = Parent.all.or_panic
assert all.size == model_ids.size
assert all.compact_map { |model| model.id }.sorted == model_ids.compact

# it: finds records with question mark substition
name = "findable model"
Parent.new(name: name).save
set = Parent.all("WHERE name = ?", [name]).or_panic
assert set.size == 1
assert set.first.name == name

Parent.adapter.close.or_panic
