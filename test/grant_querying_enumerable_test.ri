module test/grant_querying_enumerable_test
import grant/query/builder::{Builder}
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}

pub def reset_parents : Nil
  Parent.clear.or_panic
  Parent.create(name: "alice")
  Parent.create(name: "bob")
  Parent.create(name: "carol")
  Parent.create(name: "dave")
  Parent.create(name: "eve")
  nil
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: iterates over all matching records directly on the query builder
reset_parents
names = [] of String?
Parent.where(name: ["alice", "bob", "carol"]).each do |record|
  names << record.name
end.or_panic
assert names.size == 3
assert names.includes?("alice")
assert names.includes?("bob")
assert names.includes?("carol")

# it: works on a filtered query
reset_parents
count = 0
Parent.where(name: "alice").each { |_| count += 1 }.or_panic
assert count == 1

# it: transforms records using a block directly on the query builder
reset_parents
names = Parent.where(name: ["alice", "bob"]).map(&.name).or_panic
assert names.size == 2
assert names.includes?("alice")
assert names.includes?("bob")

# it: maps to different types
reset_parents
ids = Parent.where(name: ["alice", "bob"]).map(&.id).or_panic
assert ids.size == 2
ids.each { |id| assert !id.nil? }

# it: filters records in-memory using a block
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).select do |r|
  name = r.name
  name ? name.starts_with?("a") || name.starts_with?("c") : false
end.or_panic
assert results.size == 2
assert results.map(&.name).includes?("alice")
assert results.map(&.name).includes?("carol")

# it: works alongside SQL where clauses
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).select do |r|
  r.name == "bob"
end.or_panic
assert results.size == 1
assert results.first.name == "bob"

# it: still works as SQL execution when called without a block
reset_parents
results = Parent.where(name: ["alice", "bob"]).select.or_panic
assert results.size == 2

# it: still works for column projection with symbol arguments
reset_parents
builder = Parent.where(name: "alice").select(:name)
assert builder.is_a?(Builder(Parent))

# it: filters out records matching the block condition
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).reject do |r|
  r.name == "carol"
end.or_panic
assert results.size == 2
assert !results.map(&.name).includes?("carol")

# it: counts records matching a block condition
reset_parents
count = Parent.where(name: ["alice", "bob", "carol"]).count do |r|
  name = r.name
  name ? name.starts_with?("a") : false
end.or_panic
assert count == 1

# it: returns 0 when no records match the block
reset_parents
count = Parent.where(name: ["alice", "bob"]).count do |r|
  r.name == "nonexistent"
end.or_panic
assert count == 0

# it: still executes SQL COUNT when called without a block
reset_parents
count = Parent.where(name: ["alice", "bob"]).count.or_panic
assert count == 2

# it: returns true when at least one record matches the block
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).any? do |r|
  r.name == "carol"
end.or_panic
assert result

# it: returns false when no records match the block
reset_parents
result = Parent.where(name: ["alice", "bob"]).any? do |r|
  r.name == "nonexistent"
end.or_panic
assert !result

# it: still works as existence check without a block
reset_parents
assert Parent.where(name: "alice").any?.or_panic
assert !Parent.where(name: "nonexistent").any?.or_panic

# it: returns true when no records match the block
reset_parents
result = Parent.where(name: ["alice", "bob"]).none? do |r|
  r.name == "carol"
end.or_panic
assert result

# it: returns false when at least one record matches
reset_parents
result = Parent.where(name: ["alice", "bob"]).none? do |r|
  r.name == "alice"
end.or_panic
assert !result

# it: returns true when all records match the block
reset_parents
result = Parent.where(name: ["alice", "bob"]).all? do |r|
  name = r.name
  !name.nil? && name.size > 0
end.or_panic
assert result

# it: returns false when not all records match
reset_parents
result = Parent.where(name: ["alice", "bob"]).all? do |r|
  r.name == "alice"
end.or_panic
assert !result

# it: maps and removes nil values
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).compact_map do |r|
  name = r.name
  (name && name.starts_with?("a")) ? name.upcase : nil
end.or_panic
assert results.size == 1
assert results.first == "ALICE"

# it: maps and flattens the results
reset_parents
results = Parent.where(name: ["alice", "bob"]).flat_map do |r|
  [r.name, r.name.to_s.upcase]
end.or_panic
assert results.size == 4

# it: finds the record with the minimum value
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).min_by { |r| r.name || "" }.or_panic
assert result.name == "alice"

# it: finds the record with the maximum value
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).max_by { |r| r.name || "" }.or_panic
assert result.name == "carol"

# it: sorts records by the given block after converting to array
reset_parents
results = Parent.where(name: ["carol", "alice", "bob"]).to_a.or_panic.sorted_by { |r| r.name || "" }
assert results.map(&.name) == ["alice", "bob", "carol"]

# it: groups records by a block into a hash
reset_parents
groups = Parent.where(name: ["alice", "bob", "carol"]).group_by do |r|
  name = r.name
  (name && name.starts_with?("a")) ? "a_names" : "other"
end.or_panic
assert groups["a_names"].size == 1
assert groups["other"].size == 2

# it: splits records into two arrays based on a block
reset_parents
a_names, others = Parent.where(name: ["alice", "bob", "carol"]).partition do |r|
  name = r.name
  name ? name.starts_with?("a") : false
end.or_panic
assert a_names.size == 1
assert a_names.first.name == "alice"
assert others.size == 2

# it: reduces records to a single value
reset_parents
combined = Parent.where(name: ["alice", "bob"]).reduce("names:") do |acc, r|
  "#{acc} #{r.name}"
end.or_panic
assert combined.includes?("alice")
assert combined.includes?("bob")

# it: iterates with an accumulator object
reset_parents
result = Parent.where(name: ["alice", "bob", "carol"]).each_with_object([] of String) do |r, arr|
  arr << (r.name || "unknown").upcase
end.or_panic
assert result.size == 3
assert result.includes?("ALICE")
assert result.includes?("BOB")
assert result.includes?("CAROL")

# it: sums values returned by the block
reset_parents
total = Parent.where(name: ["alice", "bob", "carol"]).sum { |r| (r.name || "").size }.or_panic
assert total == 13

# it: converts query results to an array
reset_parents
results = Parent.where(name: ["alice", "bob"]).to_a.or_panic
assert results.is_a?(Array(Parent))
assert results.size == 2

# it: returns an integer value usable in arithmetic
reset_parents
size = Parent.where(name: ["alice", "bob", "carol"]).size.or_panic
assert (size == 3)
assert (size > 0)
assert (size < 100)

# it: can be passed to methods expecting numeric types
reset_parents
size = Parent.where(name: ["alice", "bob"]).size.or_panic
result = size + 1
assert result == 3

# it: Builder includes Enumerable
reset_parents
builder = Parent.where(name: "alice")
assert builder.is_a?(Enumerable)

# it: works with order + each
reset_parents
names = [] of String?
Parent.where(name: ["carol", "alice", "bob"]).order(name: :asc).each { |r| names << r.name }.or_panic
assert names == ["alice", "bob", "carol"]

# it: works with limit + map
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).order(name: :asc).limit(2).map(&.name).or_panic
assert results.size == 2
assert results == ["alice", "bob"]

# it: works with offset + to_a
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).order(name: :asc).offset(1).limit(2).to_a.or_panic
assert results.size == 2

# it: works with select (filter) after order
reset_parents
results = Parent.where(name: ["alice", "bob", "carol"]).order(name: :asc).select do |r|
  r.name != "bob"
end.or_panic
assert results.size == 2
assert results.map(&.name) == ["alice", "carol"]

Parent.adapter.close.or_panic
