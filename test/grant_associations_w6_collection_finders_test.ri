module test/grant_associations_w6_collection_finders_test

import grant/base::{Base}
import grant/querying::{NotFound}
import grant/events::{SQL}
import grant/notifications
import test/spec_helper::{register_spec_connections}
import std/indexable
import std/text

pub class W6fUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6f_users
  column id : Int64, primary: true
  column name : String?
  has_many :w6f_posts, class_name: W6fPost, foreign_key: :w6f_user_id
  has_many :w6f_links, class_name: W6fLink, foreign_key: :w6f_user_id
  has_many :w6f_tags, class_name: W6fTag, through: :w6f_links
end

pub class W6fPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6f_posts
  column id : Int64, primary: true
  column title : String?
  column w6f_user_id : Int64?
end

pub class W6fTag < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6f_tags
  column id : Int64, primary: true
  column label : String?
end

pub class W6fLink < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6f_links
  column id : Int64, primary: true
  column w6f_user_id : Int64?
  column w6f_tag_id : Int64?
  belongs_to :w6f_user, class_name: W6fUser, foreign_key: :w6f_user_id, optional: true
  belongs_to :w6f_tag, class_name: W6fTag, foreign_key: :w6f_tag_id, optional: true
end

private def w6f_selects(statements : Array(String)) : Array(String)
  statements.select { |sql| sql.lstrip.upcase.starts_with?("SELECT") }
end

private def w6f_user_with_posts(count : Int32 = 6) : Tuple(W6fUser, Array(W6fPost))
  user = W6fUser.create_strict(name: "u").or_panic
  other = W6fUser.create_strict(name: "o").or_panic
  W6fPost.create_strict(title: "foreign", w6f_user_id: other.id).or_panic
  posts = (1..count).map { |i| W6fPost.create_strict(title: "p#{i}", w6f_user_id: user.id).or_panic }
  {user, posts}
end

private def clear_records : Nil
  W6fLink.clear.or_panic
  W6fTag.clear.or_panic
  W6fPost.clear.or_panic
  W6fUser.clear.or_panic
  nil
end

private def statements(&block : -> T) : Array(String) forall T
  captured = [] of String
  subscription = ::Grant::Notifications.subscribe(SQL) do |event|
    captured << event.sql
    nil
  end
  yield
  subscription.unsubscribe
  captured
end

register_spec_connections
W6fUser.migrator.drop_and_create.or_panic
W6fPost.migrator.drop_and_create.or_panic
W6fTag.migrator.drop_and_create.or_panic
W6fLink.migrator.drop_and_create.or_panic

# it: reads first and last with LIMIT instead of loading the association
clear_records
user, posts = w6f_user_with_posts
collection = user.w6f_posts
first = nil.as(W6fPost?)
last = nil.as(W6fPost?)
captured = statements do
  first = collection.first.or_panic
  last = collection.last.or_panic
end
assert first.as(W6fPost).id == posts.first.id
assert last.as(W6fPost).id == posts.last.id
selects = w6f_selects(captured)
assert selects.size == 2
selects.each { |sql| assert sql.upcase.includes?("LIMIT 1") }
assert selects.last.upcase.includes?("DESC")
assert !collection.loaded?

# it: returns the first and last n records with LIMIT n
clear_records
user, posts = w6f_user_with_posts
firsts = [] of W6fPost
lasts = [] of W6fPost
captured = statements do
  firsts = user.w6f_posts.first(2).or_panic
  lasts = user.w6f_posts.last(2).or_panic
end
assert firsts.map(&.id) == posts.first(2).map(&.id)
assert lasts.map(&.id) == posts.reversed.first(2).reversed.map(&.id)
w6f_selects(captured).each { |sql| assert sql.upcase.includes?("LIMIT 2") }

# it: answers take and take(n) without ordering
clear_records
user, posts = w6f_user_with_posts
ids = posts.map(&.id)
assert ids.includes?(user.w6f_posts.take.or_panic.as(W6fPost).id)
assert user.w6f_posts.take(3).or_panic.size == 3
user.w6f_posts.take(3).or_panic.each { |post| assert ids.includes?(post.id) }
assert user.w6f_posts.take_strict.or_panic.w6f_user_id == user.id

# it: reads second through fifth and forty_two by offset
clear_records
user, posts = w6f_user_with_posts
collection = user.w6f_posts
assert collection.second.or_panic.as(W6fPost).id == posts[1].id
assert collection.third.or_panic.as(W6fPost).id == posts[2].id
assert collection.fourth.or_panic.as(W6fPost).id == posts[3].id
assert collection.fifth.or_panic.as(W6fPost).id == posts[4].id
assert collection.forty_two.or_panic.nil?
assert collection.second_to_last.or_panic.as(W6fPost).id == posts[-2].id
assert collection.third_to_last.or_panic.as(W6fPost).id == posts[-3].id
captured = statements { collection.third.or_panic }
assert w6f_selects(captured).first.upcase.includes?("OFFSET 2")

# it: returns nil or raises NotFound on an empty collection
clear_records
user = W6fUser.create_strict(name: "empty").or_panic
assert user.w6f_posts.first.or_panic.nil?
assert user.w6f_posts.last.or_panic.nil?
assert user.w6f_posts.take.or_panic.nil?
assert user.w6f_posts.second.or_panic.nil?
assert user.w6f_posts.first(2).or_panic.empty?
assert user.w6f_posts.first_strict.is_a?(NotFound)
assert user.w6f_posts.last_strict.is_a?(NotFound)
assert user.w6f_posts.second_strict.is_a?(NotFound)
assert user.w6f_posts.take_strict.is_a?(NotFound)

# it: finds several ids with one IN query, in the order given
clear_records
user, posts = w6f_user_with_posts
wanted = [posts[3].id, posts[0].id, posts[2].id]
found = [] of W6fPost
captured = statements { found = user.w6f_posts.find(wanted).or_panic }
assert found.map(&.id) == wanted
assert w6f_selects(captured).size == 1
assert user.w6f_posts.find(posts[1].id, posts[4].id).or_panic.map(&.id) == [posts[1].id, posts[4].id]

# it: does not find rows of another owner
clear_records
user, posts = w6f_user_with_posts
foreign = W6fPost.find_by_strict(title: "foreign").or_panic
assert user.w6f_posts.find(foreign.id).or_panic.nil?
assert user.w6f_posts.find([foreign.id, posts[0].id]).or_panic.map(&.id) == [posts[0].id]
assert user.w6f_posts.find_strict([foreign.id, posts[0].id]).is_a?(NotFound)
assert user.w6f_posts.find_strict(foreign.id).is_a?(NotFound)
assert user.w6f_posts.find_strict(posts[0].id).or_panic.id == posts[0].id

# it: answers from the loaded records without a query
clear_records
user, posts = w6f_user_with_posts
collection = user.w6f_posts
collection.load_target.or_panic
captured = statements do
  assert collection.first.or_panic.as(W6fPost).id == posts[0].id
  assert collection.last(2).or_panic.map(&.id) == posts.reversed.first(2).reversed.map(&.id)
  assert collection.take(2).or_panic.size == 2
  assert collection.second.or_panic.as(W6fPost).id == posts[1].id
  assert collection.third_to_last.or_panic.as(W6fPost).id == posts[-3].id
  assert collection.find([posts[2].id, posts[0].id]).or_panic.map(&.id) == [posts[2].id, posts[0].id]
end
assert captured.empty?

# it: reads the ordinals of a has_many :through collection in SQL
clear_records
user, _ = w6f_user_with_posts(1)
tags = (1..4).map { |i| W6fTag.create_strict(label: "t#{i}").or_panic }
tags.each { |tag| W6fLink.create_strict(w6f_user_id: user.id, w6f_tag_id: tag.id).or_panic }
W6fLink.create_strict(w6f_user_id: W6fUser.create_strict(name: "n").or_panic.id,
  w6f_tag_id: W6fTag.create_strict(label: "x").or_panic.id).or_panic
collection_tags = user.w6f_tags
assert collection_tags.first.or_panic.as(W6fTag).id == tags.first.id
assert collection_tags.last.or_panic.as(W6fTag).id == tags.last.id
assert collection_tags.second.or_panic.as(W6fTag).id == tags[1].id
assert collection_tags.first(2).or_panic.map(&.id) == tags.first(2).map(&.id)
assert collection_tags.find(tags[2].id).or_panic.as(W6fTag).id == tags[2].id
assert collection_tags.find([tags[3].id, tags[0].id]).or_panic.map(&.id) == [tags[3].id, tags[0].id]
assert !collection_tags.loaded?
