module test/grant_associations_has_one_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}
import grant/querying::{NotFound}

pub class User < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table users
  column id : Int64, primary: true
  column email : String?
  has_one :profile
end
pub class Profile < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table profiles
  column id : Int64, primary: true
  column name : String?
  column user_id : Int64?
end
pub class Character < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table characters
  column character_id : Int32, primary: true
  column name : String
end
pub class Courier < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table couriers
  column courier_id : Int32, primary: true, auto: false
  column issuer_id : Int32
  has_one issuer : Character, primary_key: "issuer_id", foreign_key: "character_id"
end

register_spec_connections

# it: provides a setter to set childrens's foriegn_key from parent
User.migrator.drop_and_create.or_panic
Profile.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
Character.migrator.drop_and_create.or_panic
profile = Profile.new
profile.name = "Test Profile"
profile.save.or_panic

user = User.new
user.email = "test@domain.com"
user.save.or_panic

user.profile = profile
assert profile.user_id == user.id

# it: provides a method to retrieve associated objects
User.migrator.drop_and_create.or_panic
Profile.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
Character.migrator.drop_and_create.or_panic
profile = Profile.new
profile.name = "Test Profile"
profile.save.or_panic

user = User.new
user.email = "test@domain.com"
user.save.or_panic

# profile's foriegn_key is now set, so calling save again
user.profile = profile
profile.save.or_panic

retrieved_profile = user.profile_strict.or_panic
assert retrieved_profile.id == profile.id

# it: provides a method to retrieve associated object that will raise if record is not found
User.migrator.drop_and_create.or_panic
Profile.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
Character.migrator.drop_and_create.or_panic
user = User.new
user.email = "test@domain.com"
user.save_strict.or_panic
error = user.profile_strict
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{Profile} found where user_id = #{user.id}"

# it: provides the ability to use a custom primary key
User.migrator.drop_and_create.or_panic
Profile.migrator.drop_and_create.or_panic
Courier.migrator.drop_and_create.or_panic
Character.migrator.drop_and_create.or_panic
courier = Courier.new
courier.courier_id = 139_132_750
courier.issuer_id = 999

character = Character.new
character.character_id = 999
character.name = "Mr Jones"
character.save.or_panic

courier.issuer = character
courier.save.or_panic

assert courier.issuer_strict.or_panic.character_id == 999

User.adapter.close.or_panic
