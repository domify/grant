module test/grant_convenience_create_or_find_by_test
import test/convenience_models::{ConvItem, reset_items, statements}
import grant/errors::{RecordInvalid, RecordNotFound}
import grant/transaction::{TransactionState}

reset_items

# it: creates without a prior SELECT
ConvItem.clear
sql = statements { ConvItem.create_or_find_by(name: "fresh").or_panic }
assert !sql.any? { |statement| statement.includes?("SELECT") }
assert ConvItem.count.or_panic == 1

# it: returns the existing row when the unique index rejects the insert
ConvItem.clear
existing = ConvItem.create_strict(name: "dup", status: "old").or_panic
found = ConvItem.create_or_find_by(name: "dup") { |record| record.status = "new" }.or_panic
assert found.id == existing.id
assert found.status == "old"
assert ConvItem.count.or_panic == 1

# it: resolves the race through RecordNotUnique inside an open transaction
ConvItem.clear
existing = ConvItem.create_strict(name: "dup").or_panic
ConvItem.transaction do
  found = ConvItem.create_or_find_by_strict(name: "dup").or_panic
  assert found.id == existing.id
  ConvItem.create_strict(name: "after").or_panic
end.or_panic
assert ConvItem.count.or_panic == 2

# it: opens one more savepoint than a plain create when nested in a transaction
ConvItem.clear
ConvItem.transaction do
  state = TransactionState.current_state? || raise "missing transaction"
  before = state.savepoint_counter
  ConvItem.create(name: "plain")
  plain_cost = state.savepoint_counter - before
  before = state.savepoint_counter
  ConvItem.create_or_find_by(name: "guarded").or_panic
  assert state.savepoint_counter - before == plain_cost + 1
end.or_panic

# it: does not swallow a non-unique failure in the bang form
ConvItem.clear
assert ConvItem.create_or_find_by_strict(name: "").is_a?(RecordInvalid)

# it: returns the unsaved record from the non-bang form on validation failure
ConvItem.clear
record = ConvItem.create_or_find_by(name: "").or_panic
assert !record.persisted?
assert !record.errors.empty?

# it: raises RecordNotFound when the conflict is not on the lookup attributes
ConvItem.clear
ConvItem.create_strict(name: "dup").or_panic
assert ConvItem.create_or_find_by_strict(name: "dup", status: "other").is_a?(RecordNotFound)

# it: works on a relation and inherits its scope attributes
ConvItem.clear
item = ConvItem.where(status: "active").create_or_find_by(name: "rel").or_panic
assert item.status == "active"
assert ConvItem.where(status: "active").create_or_find_by(name: "rel").or_panic.id == item.id

# it: resolves a real race between fibers
ConvItem.clear
results = Channel(Int64?).new
ids = [] of Int64?
group do |tasks|
  4.times do
    tasks.spawn do
      result = ConvItem.create_or_find_by(name: "raced")
      results.send(result.is_a?(ConvItem) ? result.id : nil).or_panic
    end
  end
  4.times { ids << results.receive.or_panic }
end
assert ids.compact.uniq.size == 1
assert ConvItem.where(name: "raced").count.or_panic == 1
ConvItem.adapter.close.or_panic
