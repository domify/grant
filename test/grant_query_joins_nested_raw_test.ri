module test/grant_query_joins_nested_raw_test
import grant/base::{Base}
import grant/error::{ArgumentError}
import grant/adapter/driver::{Value}
import std/enumerable
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}
  pub class JnUser < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table jn_users
    column id : Int64, primary: true
    column name : String
    has_many :posts, class_name: JnPost, foreign_key: :jn_user_id
  end

  pub class JnPost < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table jn_posts
    column id : Int64, primary: true
    column title : String
    column jn_user_id : Int64?
    belongs_to :jn_user, class_name: JnUser, foreign_key: :jn_user_id, optional: true
    has_many :comments, class_name: JnComment, foreign_key: :jn_post_id
  end

  pub class JnComment < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table jn_comments
    column id : Int64, primary: true
    column body : String
    column jn_post_id : Int64?
    belongs_to :jn_post, class_name: JnPost, foreign_key: :jn_post_id, optional: true
  end

  pub class JnEmployee < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table jn_employees
    column id : Int64, primary: true
    column name : String
    column jn_manager_id : Int64?
    belongs_to :jn_manager, class_name: JnEmployee, foreign_key: :jn_manager_id, optional: true
  end

def seed_blog : Nil
  ada = JnUser.create_strict(name: "Ada").or_panic
  grace = JnUser.create_strict(name: "Grace").or_panic
  JnUser.create_strict(name: "Nobody").or_panic
  first = JnPost.create_strict(title: "First", jn_user_id: ada.id).or_panic
  JnPost.create_strict(title: "Second", jn_user_id: ada.id).or_panic
  other = JnPost.create_strict(title: "Other", jn_user_id: grace.id).or_panic
  JnComment.create_strict(body: "nice", jn_post_id: first.id).or_panic
  JnComment.create_strict(body: "agreed", jn_post_id: first.id).or_panic
  JnComment.create_strict(body: "hm", jn_post_id: other.id).or_panic
  nil
end

register_spec_connections
JnUser.migrator.drop_and_create.or_panic
JnPost.migrator.drop_and_create.or_panic
JnComment.migrator.drop_and_create.or_panic
JnEmployee.migrator.drop_and_create.or_panic

# it: joins each level from the model the previous level reached
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
sql = JnUser.joins(posts: :comments).raw_sql
assert sql.includes?("INNER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id")
assert sql.includes?("INNER JOIN jn_comments ON jn_comments.jn_post_id = jn_posts.id")
assert sql.index("jn_posts ON").as(Int32) < sql.index("jn_comments ON").as(Int32)

# it: filters through the nested table
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
names = JnUser.joins(posts: :comments).where("jn_comments.body": "hm").select.or_panic.map(&.name.as(String))
assert names == ["Grace"]

# it: multiplies parent rows for a has_many chain and distinct collapses them
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
assert JnUser.joins(posts: :comments).select.or_panic.size == 3
assert JnUser.joins(posts: :comments).distinct.select.or_panic.map(&.name.as(String)).sorted == ["Ada", "Grace"]

# it: accepts arrays and several branches
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
sql = JnUser.joins(posts: [:comments, :jn_user]).raw_sql
assert sql.includes?("jn_comments ON")
assert sql.split("INNER JOIN jn_users").size - 1 == 1

# it: raises for an unknown association at any level
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
error = JnUser.joins(posts: :nope).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Unknown association :nope")
error = JnUser.joins(nope: :comments).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Unknown association :nope")

# it: resolves nested left joins
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
names = JnUser.left_joins(posts: :comments).where("jn_comments.id IS NULL").select.or_panic.map(&.name.as(String)).sorted
assert names == ["Ada", "Nobody"]

# it: emits the fragment as written
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
relation = JnUser.joins("INNER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id AND jn_posts.title = 'Other'")
assert relation.raw_sql.includes?("INNER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id AND jn_posts.title = 'Other'")
assert relation.select.or_panic.map(&.name.as(String)) == ["Grace"]

# it: supports a LEFT OUTER fragment through left_joins
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
names = JnUser.left_joins("LEFT OUTER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id").where("jn_posts.id IS NULL").select.or_panic.map(&.name.as(String))
assert names == ["Nobody"]

# it: lets where, order and aggregates qualify columns with the tables a fragment joins
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
relation = JnUser.joins("INNER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id")
assert relation.where("jn_posts.title": "Other").select.or_panic.map(&.name.as(String)) == ["Grace"]
assert relation.order("jn_posts.title", :desc).select.or_panic.map(&.name.as(String)) == ["Ada", "Grace", "Ada"]
assert relation.count("jn_posts.id").or_panic == 3_i64

aliased = JnUser.joins("LEFT JOIN jn_posts AS p ON p.jn_user_id = jn_users.id INNER JOIN jn_comments c ON c.jn_post_id = p.id")
assert aliased.where("c.body": "hm").select.or_panic.map(&.name.as(String)) == ["Grace"]
assert aliased.where("p.title": "First").distinct.select.or_panic.map(&.name.as(String)) == ["Ada"]

# it: refuses fragments that could carry another statement
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
error = JnUser.joins("INNER JOIN jn_posts ON 1=1; DROP TABLE jn_users").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("statement separator")
error = JnUser.joins("INNER JOIN jn_posts ON 1=1 -- x").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("comment marker")
error = JnUser.joins("  ").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("blank")

# it: does not change the receiver
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
base = JnUser.where(name: "Ada")
base.joins("INNER JOIN jn_posts ON jn_posts.jn_user_id = jn_users.id")
assert base.join_clauses.empty?

# it: joins a table to itself under an alias
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
boss = JnEmployee.create_strict(name: "Boss").or_panic
JnEmployee.create_strict(name: "Ann", jn_manager_id: boss.id).or_panic
JnEmployee.create_strict(name: "Bob", jn_manager_id: boss.id).or_panic
JnEmployee.create_strict(name: "Loner").or_panic

relation = JnEmployee.joins(:jn_manager, as: "managers").where("managers.name": "Boss").order(:name)
assert relation.raw_sql.includes?("INNER JOIN jn_employees AS managers ON managers.id = jn_employees.jn_manager_id")
assert relation.select.or_panic.map(&.name.as(String)) == ["Ann", "Bob"]

# it: supports a left alias and pluck across the alias
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
boss = JnEmployee.create_strict(name: "Boss").or_panic
JnEmployee.create_strict(name: "Ann", jn_manager_id: boss.id).or_panic
JnEmployee.create_strict(name: "Loner").or_panic

rows = JnEmployee.left_outer_joins(:jn_manager, as: "managers").order(:name).pluck("jn_employees.name", "managers.name").or_panic
assert rows == [["Ann", "Boss"] of Value, ["Boss", nil] of Value, ["Loner", nil] of Value]

# it: rejects an alias that is not an identifier
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
error = JnEmployee.joins(:jn_manager, as: "m; DROP").select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("alias must be an identifier")

# it: joins an association once when it is requested through different paths
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
once = JnUser.joins(:posts).joins(posts: :comments).raw_sql
assert once.split("INNER JOIN jn_posts").size - 1 == 1
assert once.split("INNER JOIN jn_comments").size - 1 == 1

# it: joins once when the same call repeats
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
assert JnUser.joins(:posts).joins(:posts).join_clauses.size == 1
assert JnUser.joins("jn_posts", on: "jn_posts.jn_user_id = jn_users.id").joins("jn_posts", on: "jn_posts.jn_user_id = jn_users.id").join_clauses.size == 1

# it: keeps a relation working after a merge that repeats a join
JnComment.clear.or_panic
JnPost.clear.or_panic
JnUser.clear.or_panic
JnEmployee.clear.or_panic
seed_blog
merged = JnUser.joins(:posts).merge(JnUser.joins(:posts).where(name: "Ada"))
assert merged.join_clauses.size == 1
assert merged.select.or_panic.map(&.name.as(String)).uniq == ["Ada"]

JnUser.adapter.close.or_panic
