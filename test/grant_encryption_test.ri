module test/grant_encryption_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/config::{Config}
import grant/encryption/key_provider::{KeyProvider}
import std/time::{Time}
import test/spec_helper::{register_spec_connections}

pub class EncryptedModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table encrypted_models
  column id : Int64, primary: true, auto: true
  column created_at : Time = Time.utc
  column updated_at : Time = Time.utc
  encrypts :ssn
  encrypts :email, deterministic: true
end

private def configure_encryption : Nil
  (KeyProvider.primary_key = Config.generate_key.or_panic).or_panic
  (KeyProvider.deterministic_key = Config.generate_key.or_panic).or_panic
  KeyProvider.key_derivation_salt = Config.generate_key.or_panic
  nil
end

register_spec_connections
# it: checks if encryption is configured
configure_encryption
assert ::Grant::Encryption.configured?

# it: generates a new key
configure_encryption
key = Config.generate_key.or_panic
assert !key.nil?
assert key.size == 44

# it: creates encrypted columns
configure_encryption
assert EncryptedModel.fields.includes?("ssn_encrypted")
assert EncryptedModel.fields.includes?("email_encrypted")

# it: provides virtual accessors
configure_encryption
model = EncryptedModel.new
assert model.responds_to?(:ssn)
assert model.responds_to?(:ssn=)
assert model.responds_to?(:email)
assert model.responds_to?(:email=)

# it: encrypts and decrypts non-deterministic fields
configure_encryption
model = EncryptedModel.new
(model.ssn = "123-45-6789").or_panic
assert !model.ssn_encrypted.nil?
assert model.ssn_encrypted.as(String).size > 0
assert model.ssn.or_panic == "123-45-6789"

# it: encrypts and decrypts deterministic fields
configure_encryption
model = EncryptedModel.new
(model.email = "jane@example.com").or_panic
assert !model.email_encrypted.nil?
assert model.email.or_panic == "jane@example.com"

# it: handles nil values
configure_encryption
model = EncryptedModel.new
(model.ssn = nil).or_panic
(model.email = nil).or_panic
assert model.ssn_encrypted.nil?
assert model.email_encrypted.nil?
assert model.ssn.or_panic.nil?
assert model.email.or_panic.nil?

# it: produces different ciphertexts for non-deterministic encryption
configure_encryption
model1 = EncryptedModel.new
model2 = EncryptedModel.new
(model1.ssn = "123-45-6789").or_panic
(model2.ssn = "123-45-6789").or_panic
assert model1.ssn_encrypted != model2.ssn_encrypted

# it: produces same ciphertext for deterministic encryption
configure_encryption
model1 = EncryptedModel.new
model2 = EncryptedModel.new
(model1.email = "same@example.com").or_panic
(model2.email = "same@example.com").or_panic
assert model1.email_encrypted == model2.email_encrypted

# it: provides query methods for deterministic fields
configure_encryption
assert EncryptedModel.responds_to?(:where_email)
assert EncryptedModel.responds_to?(:find_by_email)

# it: does not provide query methods for non-deterministic fields
configure_encryption
assert !EncryptedModel.responds_to?(:where_ssn)
assert !EncryptedModel.responds_to?(:find_by_ssn)

# it: provides encrypted query helpers
configure_encryption
assert EncryptedModel.responds_to?(:where_encrypted)
assert EncryptedModel.responds_to?(:find_by_encrypted)

# it: caches decrypted values
configure_encryption
model = EncryptedModel.new
(model.ssn = "999-88-7777").or_panic
value1 = model.ssn.or_panic
value2 = model.ssn.or_panic
assert value1 == value2
