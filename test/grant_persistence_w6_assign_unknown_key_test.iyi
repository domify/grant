module test/grant_persistence_w6_assign_unknown_key_test

import grant/base::{Base}
import grant/attributes::{UnknownAttributeError}
import test/spec_helper::{register_spec_connections}

pub class W6AssignOwner < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_assign_owners
  column id : Int64, primary: true
  column title : String?
  column views : Int32?
  alias_attribute :heading, :title
end

register_spec_connections
W6AssignOwner.migrator.drop_and_create.or_panic

# it: raises UnknownAttributeError naming the model and the key
owner = W6AssignOwner.new
error = owner.assign_attributes(title: "x", bogus: 1)
assert error.is_a?(UnknownAttributeError)
if error.is_a?(UnknownAttributeError)
  assert error.message.includes?("bogus")
  assert error.attribute_name == "bogus"
  assert error.model_name == W6AssignOwner.to_s
end

# it: assigns nothing when any key is unknown
owner = W6AssignOwner.new
assert owner.assign_attributes({"title" => "x", "nope" => "y"}).is_a?(UnknownAttributeError)
assert owner.title.nil?

# it: raises through attributes= too
owner = W6AssignOwner.new
result = (owner.attributes = {"nope" => "y"})
assert result.is_a?(UnknownAttributeError)

# it: accepts columns, symbols and aliases
owner = W6AssignOwner.new
owner.assign_attributes(heading: "aliased", views: "3")
assert owner.title == "aliased"
assert owner.views == 3
owner.assign_attributes({:title => "sym"})
assert owner.title == "sym"
assert owner.assignable_attribute?("heading")
assert !owner.assignable_attribute?("bogus")
