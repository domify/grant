module test/grant_errors_statement_invalid_test

import grant/base::{Base}
import grant/error::{ErrorBase}
import grant/error_taxonomy::{StatementInvalid}
import grant/adapter/driver::{Value}
import grant/settings::{settings}
import test/spec_helper::{register_spec_connections}

pub class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

private def with_bind_capture(enabled : Bool, &block : -> T) : T forall T
  previous = settings.capture_statement_bind_values?
  settings.capture_statement_bind_values = enabled
  result = yield
  settings.capture_statement_bind_values = previous
  result
end

register_spec_connections

# it: keeps the sql and one redacted entry per bind by default
error = StatementInvalid.new("boom", "SELECT * FROM users WHERE ssn = ? AND id = ?", ["123-45-6789", 7])
assert error.message == "boom"
assert error.sql == "SELECT * FROM users WHERE ssn = ? AND id = ?"
assert error.binds == ["[FILTERED]", "[FILTERED]"]
assert !error.binds.join.includes?("123-45-6789")

# it: defaults to no sql and no binds
error = StatementInvalid.new("boom")
assert error.sql.nil?
assert error.binds.empty?

# it: keeps the driver error as the cause
# ErrorBase is the native generic returned error corresponding to DB::Error.
driver_error = ErrorBase.new("driver")
assert StatementInvalid.new("boom", cause: driver_error).cause.as(ErrorBase).object_id == driver_error.object_id

# it: keeps truncated bind values when capture is enabled
with_bind_capture(true) do
  error = StatementInvalid.new("boom", "SELECT ?", ["short", 42, nil])
  assert error.binds == ["short", "42", ""]
end

# it: truncates each captured value
with_bind_capture(true) do
  error = StatementInvalid.new("boom", "SELECT ?", ["x" * 1_000_000])
  assert error.binds.first.size == StatementInvalid::MAX_BIND_LENGTH + 3
  assert error.binds.first.ends_with?("...")
end

# it: caps how many binds are kept
binds = Array.new(500) { |i| i }
assert StatementInvalid.new("boom", "SELECT 1", binds).binds.size == StatementInvalid::MAX_BINDS
with_bind_capture(true) do
  assert StatementInvalid.new("boom", "SELECT 1", binds).binds.size == StatementInvalid::MAX_BINDS
end

# it: never retains the original values
payload = "x" * 1_000_000
error = StatementInvalid.new("boom", "SELECT ?", [payload])
assert error.binds.first == "[FILTERED]"

# it: reports the failing sql and redacted binds
adapter = Parent.adapter
secret = "sekrit-value"
result = adapter.exists?("g01_missing_table", "name = ?", [secret] of Value)
assert result.is_a?(StatementInvalid)
error = result.as(StatementInvalid)
assert error.sql.to_s.includes?("g01_missing_table")
assert error.sql.to_s.starts_with?("SELECT EXISTS(")
assert error.binds == ["[FILTERED]"]
assert !error.message.includes?(secret) if adapter.postgres?
assert !error.cause.nil?

# it: reports the failing sql from a write
adapter = Parent.adapter
result = adapter.insert("g01_missing_table", ["name"], ["value"] of Value, lastval: nil)
assert result.is_a?(StatementInvalid)
error = result.as(StatementInvalid)
assert error.sql.to_s.includes?("INSERT INTO")
assert error.sql.to_s.includes?("g01_missing_table")
assert error.binds.size == 1

# it: includes captured values only when capture is enabled
adapter = Parent.adapter
with_bind_capture(true) do
  result = adapter.exists?("g01_missing_table", "name = ?", ["visible"] of Value)
  assert result.is_a?(StatementInvalid)
  assert result.as(StatementInvalid).binds == ["visible"]
end

# it: reports the statement that failed when the caller did not pass one
result = Parent.adapter.open { |db| db.exec("SELECT * FROM g01_missing_table") }
assert result.is_a?(StatementInvalid)
assert result.as(StatementInvalid).sql == "SELECT * FROM g01_missing_table"

# it: prefers the statement the caller passed
result = Parent.adapter.open("labelled statement") { |db| db.exec("SELECT * FROM g01_missing_table") }
assert result.is_a?(StatementInvalid)
assert result.as(StatementInvalid).sql == "labelled statement"
