module test/grant_query_cte_test
import std/enumerable
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/query/from_and_with::{CommonTableExpressions, UnsupportedCommonTableExpressionError}
import grant/error::{ErrorBase, ArgumentError}
import grant/adapter/driver::{Value}
import test/query_relation_sql_capture::{capture_sql}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

  pub class CteNode < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table cte_nodes
    column id : Int64, primary: true
    column parent_id : Int64?
    column label : String
    column weight : Int64
  end

def cte_labels(relation : Builder(CteNode)) : Array(String)
  relation.order(:id).select.or_panic.map(&.label.to_s)
end

def cte_tree_step : String
  "SELECT cte_nodes.id, cte_nodes.parent_id, cte_nodes.label, cte_nodes.weight " +
  "FROM cte_nodes INNER JOIN cte_tree ON cte_nodes.parent_id = cte_tree.id"
end

register_spec_connections
CteNode.migrator.drop_and_create.or_panic

def seed_nodes : Nil
  CteNode.clear.or_panic
  root = CteNode.create_strict(label: "root", weight: 1_i64).or_panic
  left = CteNode.create_strict(label: "left", weight: 2_i64, parent_id: root.id).or_panic
  CteNode.create_strict(label: "leaf", weight: 3_i64, parent_id: left.id).or_panic
  CteNode.create_strict(label: "right", weight: 4_i64, parent_id: root.id).or_panic
  CteNode.create_strict(label: "island", weight: 5_i64).or_panic
  nil
end

# it: renders WITH before the SELECT and reads from the CTE
seed_nodes
relation = CteNode.with(:heavy, CteNode.where("weight > ?", 2_i64)).from(:heavy)
assert relation.to_sql.starts_with?("WITH #{CteNode.quote("heavy")} AS (SELECT")
assert relation.to_sql.includes?("FROM #{CteNode.quote("heavy")}")
assert cte_labels(relation) == ["leaf", "right", "island"]

# it: takes raw SQL with binds
seed_nodes
relation = CteNode.with(:heavy, "SELECT * FROM cte_nodes WHERE weight > ?", [3_i64] of Value).from(:heavy)
assert cte_labels(relation) == ["right", "island"]

# it: numbers binds CTE first, then the main query
seed_nodes
relation = CteNode
  .with(:heavy, CteNode.where("weight > ?", 1_i64))
  .with(:light, CteNode.where("weight < ?", 5_i64))
  .from(:heavy)
  .where("weight < ?", 4_i64)
  .where("id IN (SELECT id FROM #{CteNode.quote("light")} WHERE label != 'x')")
assembler = relation.assembler
assembler.select
assert assembler.numbered_parameters == [1_i64, 5_i64, 4_i64] of Value
if CURRENT_ADAPTER == "pg"
  sql = relation.to_sql
  assert sql.index("$1").as(Int32) < sql.index("$2").as(Int32)
  assert sql.index("$2").as(Int32) < sql.index("$3").as(Int32)
end
assert cte_labels(relation) == ["left", "leaf"]

# it: keeps numbering when a CTE and a from subquery are combined
seed_nodes
relation = CteNode
  .with(:heavy, CteNode.where("weight > ?", 1_i64))
  .from(CteNode.where("weight < ?", 5_i64))
  .where("id IN (SELECT id FROM #{CteNode.quote("heavy")})")
  .where("weight > ?", 2_i64)
assembler = relation.assembler
assembler.select
assert assembler.numbered_parameters == [1_i64, 5_i64, 2_i64] of Value
assert cte_labels(relation) == ["leaf", "right"]

# it: replaces a CTE added under the same name
seed_nodes
relation = CteNode.with(:pick, CteNode.where(label: "root")).with(:pick, CteNode.where(label: "leaf")).from(:pick)
assert relation.common_tables.size == 1
assert cte_labels(relation) == ["leaf"]

# it: runs one statement
seed_nodes
relation = CteNode.with(:heavy, CteNode.where("weight > ?", 2_i64)).from(:heavy)
statements = capture_sql { assert relation.select.or_panic.size == 3 }
assert statements.size == 1

# it: works with count, exists?, pluck, first and aggregates
seed_nodes
relation = CteNode.with(:heavy, CteNode.where("weight > ?", 2_i64)).from(:heavy)
assert relation.count.or_panic == 3_i64
assert relation.exists?.or_panic
assert !relation.where(label: "root").exists?.or_panic
assert relation.sum(:weight).or_panic == 12_i64
assert relation.order(:id).first.or_panic.as(CteNode).label == "leaf"
assert relation.order(:id).pluck(:label).or_panic.flat_map { |row| row }.map(&.to_s) == ["leaf", "right", "island"]
assert relation.distinct.count.or_panic == 3_i64
assert relation.order(:id).limit(2).count.or_panic == 2_i64

# it: does not change the relation it was called on and unscopes
seed_nodes
base = CteNode.where(label: "root")
derived = base.with(:heavy, CteNode.all)
assert base.common_tables.empty?
assert derived.common_tables.size == 1
assert derived.unscope(:with).common_tables.empty?
assert !derived.except(:with).to_sql.includes?("WITH")

# it: carries CTEs through merge
seed_nodes
merged = CteNode.where("weight > ?", 0_i64).merge(CteNode.with(:one, CteNode.where(label: "root")).from(:one))
assert cte_labels(merged) == ["root"]

# it: rejects a name that is not an identifier
seed_nodes
error = CteNode.with("x; DROP TABLE y", CteNode.all).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("not a valid identifier")

# it: walks a tree from its anchor rows
seed_nodes
relation = CteNode.with_recursive(:cte_tree, CteNode.where(label: "left"), cte_tree_step).from(:cte_tree)
assert relation.to_sql.starts_with?("WITH RECURSIVE #{CteNode.quote("cte_tree")} AS (")
assert cte_labels(relation) == ["left", "leaf"]
assert cte_labels(CteNode.with_recursive(:cte_tree, CteNode.where(label: "root"), cte_tree_step).from(:cte_tree)) == ["root", "left", "leaf", "right"]

# it: accepts an anchor and step with binds, numbered in order
seed_nodes
step = cte_tree_step + " WHERE cte_nodes.weight < ?"
relation = CteNode
  .with_recursive(:cte_tree, "SELECT * FROM cte_nodes WHERE label = ?", step,
    anchor_binds: ["root"] of Value, step_binds: [4_i64] of Value)
  .from(:cte_tree)
  .where("weight > ?", 1_i64)
assembler = relation.assembler
assembler.select
assert assembler.numbered_parameters == ["root", 4_i64, 1_i64] of Value
assert cte_labels(relation) == ["left", "leaf"]

# it: can be used through a subselect in where
seed_nodes
relation = CteNode
  .with_recursive(:cte_tree, CteNode.where(label: "left"), cte_tree_step)
  .where("id IN (SELECT id FROM #{CteNode.quote("cte_tree")})")
assert cte_labels(relation) == ["left", "leaf"]

# it: stops a cycle at max_depth
seed_nodes
a = CteNode.create_strict(label: "cycle_a", weight: 9_i64).or_panic
b = CteNode.create_strict(label: "cycle_b", weight: 9_i64, parent_id: a.id).or_panic
a.parent_id = b.id
a.save_strict.or_panic

relation = CteNode.with_recursive(:cte_tree, CteNode.where(label: "cycle_a"), cte_tree_step, max_depth: 4).from(:cte_tree)
# anchor is depth 1; four levels in all, alternating b, a, b.
assert relation.select.or_panic.map(&.label) == ["cycle_a", "cycle_b", "cycle_a", "cycle_b"]
assert relation.to_sql.includes?("grant_depth < 4")

# it: applies a default depth guard
seed_nodes
assert CommonTableExpressions::DEFAULT_MAX_DEPTH == 1000
assert CteNode.with_recursive(:cte_tree, CteNode.where(label: "root"), cte_tree_step).to_sql.includes?("grant_depth < 1000")

# it: adds the guard to an existing WHERE
seed_nodes
guarded = CommonTableExpressions.guard_step(
  "SELECT a.id FROM a JOIN t ON a.p = t.id WHERE a.x = 'FROM WHERE' AND (a.y = 1)", 7).or_panic
assert guarded == "SELECT a.id, grant_depth + 1 FROM a JOIN t ON a.p = t.id WHERE grant_depth < 7 AND (a.x = 'FROM WHERE' AND (a.y = 1))"

# it: ignores FROM inside parentheses and quotes
seed_nodes
guarded = CommonTableExpressions.guard_step("SELECT EXTRACT(year FROM d), 'FROM' AS s FROM t", 3).or_panic
assert guarded == "SELECT EXTRACT(year FROM d), 'FROM' AS s, grant_depth + 1 FROM t WHERE grant_depth < 3"

# it: rejects a step the guard cannot wrap
seed_nodes
error = CommonTableExpressions.guard_step("SELECT 1", 3)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("must be SELECT")
error = CommonTableExpressions.guard_step("SELECT a FROM t ORDER BY a", 3)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("cannot contain ORDER")
error = CommonTableExpressions.guard_step("SELECT a FROM t LIMIT 3", 3)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("cannot contain LIMIT")
error = CommonTableExpressions.guard_step("SELECT a FROM t", 0)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("max_depth must be positive")

# it: needs unguarded: true for a raw recursive body
seed_nodes
body = "SELECT id, parent_id, label, weight FROM cte_nodes WHERE label = 'left' " +
       "UNION ALL SELECT n.id, n.parent_id, n.label, n.weight FROM cte_nodes n INNER JOIN cte_tree t ON n.parent_id = t.id"
error = CteNode.with_recursive(:cte_tree, body, unguarded: false).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("unguarded: true")
relation = CteNode.with_recursive(:cte_tree, body, unguarded: true).from(:cte_tree)
assert cte_labels(relation) == ["left", "leaf"]

# it: is an ErrorBase
seed_nodes
assert UnsupportedCommonTableExpressionError.new("x").is_a?(ErrorBase)

# it: checks the adapter of the statement's model
seed_nodes
# The running adapter supports CTEs on PostgreSQL, SQLite and MySQL 8+.
assert CteNode.with(:one, CteNode.all).from(:one).to_sql.starts_with?("WITH")

CteNode.adapter.close.or_panic
