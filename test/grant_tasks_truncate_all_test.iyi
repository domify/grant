module test/grant_tasks_truncate_all_test
import grant/tasks/database::{Database}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError}
import test/m04_tasks_fixture
import test/m04_tasks_fixture::{M04_TASK_MIGRATIONS}
import grant/events::{SQL}
import grant/notifications
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
import std/text

private def m04_truncate_world(tasks : Database, parents : Int32 = 3) : Nil
  tasks.create.or_panic
  tasks.migrate.or_panic
  tasks.adapter.open { |db| db.exec("CREATE TABLE m04_keep_me (id INTEGER PRIMARY KEY, label VARCHAR(20))").or_panic }.or_panic
  parents.times do |number|
    tasks.adapter.open { |db| db.exec("INSERT INTO m04_task_widgets (title) VALUES ('widget #{number}')").or_panic }.or_panic
  end
  tasks.adapter.open { |db| db.exec("INSERT INTO m04_task_gadgets (widget_id) SELECT id FROM m04_task_widgets").or_panic }.or_panic
  tasks.adapter.open { |db| db.exec("INSERT INTO m04_keep_me (id, label) VALUES (1, 'kept')").or_panic }.or_panic
  nil
end

register_spec_connections
restore_default_spec_connections

# it: empties every table, keeps the migration bookkeeping and returns the tables it emptied
::Test::M04TasksFixture.with_tasks(migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  m04_truncate_world(tasks)
  assert ::Test::M04TasksFixture.count(tasks, "m04_task_gadgets") == 3

  emptied = tasks.truncate_all.or_panic
  assert emptied.sorted == ["m04_keep_me", "m04_task_gadgets", "m04_task_widgets"]
  assert ::Test::M04TasksFixture.count(tasks, "m04_task_widgets") == 0
  assert ::Test::M04TasksFixture.count(tasks, "m04_task_gadgets") == 0
  assert ::Test::M04TasksFixture.count(tasks, "m04_keep_me") == 0
  assert ::Test::M04TasksFixture.count(tasks, "schema_migrations") == 3
  assert tasks.version.or_panic == 20260101000003_i64
  assert InternalMetadata.new(tasks.adapter).environment.or_panic == "development"
end

# it: restarts the id counters
::Test::M04TasksFixture.with_tasks(migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  m04_truncate_world(tasks)
  tasks.truncate_all.or_panic
  tasks.adapter.open { |db| db.exec("INSERT INTO m04_task_widgets (title) VALUES ('fresh')").or_panic }.or_panic
  assert tasks.adapter.open { |db| db.scalar("SELECT id FROM m04_task_widgets").or_panic.as(Int64) }.or_panic == 1
end

# it: keeps the tables named in except
::Test::M04TasksFixture.with_tasks(migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  m04_truncate_world(tasks)
  emptied = tasks.truncate_all(except: ["m04_keep_me"]).or_panic
  assert !emptied.includes?("m04_keep_me")
  assert ::Test::M04TasksFixture.count(tasks, "m04_keep_me") == 1
  assert ::Test::M04TasksFixture.count(tasks, "m04_task_widgets") == 0
end

# it: empties referenced tables whatever their order, without a per-table round trip on PostgreSQL
::Test::M04TasksFixture.with_tasks(migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  m04_truncate_world(tasks)
  statements = [] of String
  handler = ->(event : SQL) { statements << event.sql; nil }
  ::Grant::Notifications.subscribed(SQL, handler) { tasks.truncate_all.or_panic }
  truncates = statements.count { |sql| sql.lstrip.upcase.starts_with?("TRUNCATE") }
  if CURRENT_ADAPTER == "pg"
    assert truncates == 1
    assert statements.count { |sql| sql.lstrip.upcase.starts_with?("DELETE") } == 0
    assert statements.find { |sql| sql.lstrip.upcase.starts_with?("TRUNCATE") }.as(String).includes?("RESTART IDENTITY CASCADE")
  end
  assert ::Test::M04TasksFixture.count(tasks, "m04_task_gadgets") == 0
end

# it: refuses a protected environment unless forced
::Test::M04TasksFixture.with_tasks("production", migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  tasks.create.or_panic
  tasks.adapter.open { |db| db.exec("CREATE TABLE m04_prod_rows (id INTEGER)").or_panic }.or_panic
  tasks.adapter.open { |db| db.exec("INSERT INTO m04_prod_rows (id) VALUES (1)").or_panic }.or_panic
  assert tasks.truncate_all.is_a?(ProtectedEnvironmentError)
  assert ::Test::M04TasksFixture.count(tasks, "m04_prod_rows") == 1
  assert tasks.truncate_all(force: true).or_panic.includes?("m04_prod_rows")
  assert ::Test::M04TasksFixture.count(tasks, "m04_prod_rows") == 0
end

# it: does nothing on a database without tables
::Test::M04TasksFixture.with_tasks(migrations: M04_TASK_MIGRATIONS, db_dir: "db_m04") do |tasks|
  tasks.create.or_panic
  assert tasks.truncate_all.or_panic.empty?
end
