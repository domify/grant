module test/grant_public_api_return_types_associations_test
import grant/base::{Base}
import grant/collection
import grant/associations/composite_collection
import grant/composite_primary_key::{composite_primary_key}
import test/spec_helper::{register_spec_connections}

pub class PublicApiReturnTypeBook < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column author_id : Int64
  column owner_id : Int64
  column owner_type : String
  column title : String
end

pub class PublicApiReturnTypeAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column name : String

  has_many :books, class_name: PublicApiReturnTypeBook, foreign_key: :author_id
  has_many :owned_books, class_name: PublicApiReturnTypeBook, as: :owner
end

pub class PublicApiReturnTypeCompositeEntry < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column tenant_id : Int64
  column owner_id : Int64
  column title : String
end

pub class PublicApiReturnTypeCompositeOwner < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column tenant_id : Int64, primary: true, auto: false
  column id : Int64, primary: true, auto: false
  composite_primary_key tenant_id, id

  has_many :entries, class_name: PublicApiReturnTypeCompositeEntry, foreign_key: {:tenant_id, :owner_id}
end

register_spec_connections

alias PublicApiRawScalarType = ::Grant::Adapter::Driver::Value

# it: preserves generated association reader return types
author = PublicApiReturnTypeAuthor.new
assert typeof(author.books).to_s == ::Grant::AssociationCollection::AssociationCollection(PublicApiReturnTypeAuthor, PublicApiReturnTypeBook).to_s
assert typeof(author.reload_books.or_panic).to_s == ::Grant::AssociationCollection::AssociationCollection(PublicApiReturnTypeAuthor, PublicApiReturnTypeBook).to_s
assert typeof(author.owned_books).to_s == ::Grant::AssociationCollection::AssociationCollection(PublicApiReturnTypeAuthor, PublicApiReturnTypeBook).to_s
assert typeof(author.reload_owned_books.or_panic).to_s == ::Grant::AssociationCollection::AssociationCollection(PublicApiReturnTypeAuthor, PublicApiReturnTypeBook).to_s

composite_owner = PublicApiReturnTypeCompositeOwner.new(tenant_id: 1_i64, id: 1_i64)
assert typeof(composite_owner.entries).to_s == ::Grant::Associations::CompositeCollection::CompositeCollection(PublicApiReturnTypeCompositeOwner, PublicApiReturnTypeCompositeEntry).to_s
assert typeof(composite_owner.reload_entries.or_panic).to_s == ::Grant::Associations::CompositeCollection::CompositeCollection(PublicApiReturnTypeCompositeOwner, PublicApiReturnTypeCompositeEntry).to_s

# Exercise the owner tuple and key assignment behind the inferred reader types.
assert composite_owner.entries.owner_key.or_panic == [1_i64, 1_i64]
built = composite_owner.entries.build(title: "new").or_panic
assert built.tenant_id == 1_i64
assert built.owner_id == 1_i64
assert built.title == "new"
composite_owner.set_loaded_association("entries", [built])
assert composite_owner.entries.loaded?
composite_owner.reset_entries
assert !composite_owner.entries.loaded?
PublicApiReturnTypeCompositeEntry.migrator.drop_and_create.or_panic
PublicApiReturnTypeCompositeEntry.create_strict(tenant_id: 1_i64, owner_id: 1_i64, title: "matched").or_panic
PublicApiReturnTypeCompositeEntry.create_strict(tenant_id: 2_i64, owner_id: 1_i64, title: "other tenant").or_panic
PublicApiReturnTypeCompositeEntry.create_strict(tenant_id: 1_i64, owner_id: 2_i64, title: "other owner").or_panic
assert composite_owner.entries.to_a.or_panic.map(&.title) == ["matched"]
assert composite_owner.reload_entries.or_panic.loaded?
assert composite_owner.entries.to_a.or_panic.map(&.title) == ["matched"]

strict = ::Grant::Associations::CompositeCollection::CompositeCollection(PublicApiReturnTypeCompositeOwner, PublicApiReturnTypeCompositeEntry).new(
  composite_owner, "entries", ["tenant_id", "owner_id"], ["tenant_id", "id"], strict_loading_option: true)
assert strict.to_a.is_a?(::Grant::EagerLoading::StrictLoadingViolationError)
preloaded = ::Grant::Associations::CompositeCollection::CompositeCollection(PublicApiReturnTypeCompositeOwner, PublicApiReturnTypeCompositeEntry).new(
  composite_owner, "entries", ["tenant_id", "owner_id"], ["tenant_id", "id"], loaded_records: [built], strict_loading_option: true)
assert preloaded.to_a.or_panic == [built]
