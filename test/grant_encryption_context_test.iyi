module test/grant_encryption_context_test
import grant/base::{Base}
import grant/encryption
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/cipher::{DecryptionError}
import grant/error::{ArgumentError, ErrorBase}
import std/base64::{Base64}
import test/spec_helper::{register_spec_connections}

pub class CtxEncMember < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table ctx_enc_members
  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true
  encrypts secret : String
  encrypts :legacy_secret
end

private def ctx_enc_raw(column : String, id) : String?
  CtxEncMember.adapter.open do |db|
    db.scalar("SELECT #{column} FROM ctx_enc_members WHERE id = #{id}")
  end.or_panic.as(String?)
end

register_spec_connections
(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "context-salt"
CtxEncMember.migrator.drop_and_create.or_panic

# it: writes plaintext and reads the stored text back, then restores encryption
CtxEncMember.clear.or_panic
member = Grant::Encryption.without_encryption { CtxEncMember.create_strict(email: "raw@example.com", secret: "shh") }.or_panic
assert ctx_enc_raw("email", member.id) == "raw@example.com"
Grant::Encryption.without_encryption do
  assert CtxEncMember.find_strict(member.id).or_panic.email == "raw@example.com"
end
assert Grant::Encryption.encryption_enabled?
sealed = CtxEncMember.create_strict(email: "sealed@example.com").or_panic
assert ctx_enc_raw("email", sealed.id) != "sealed@example.com"
raw = Grant::Encryption.without_encryption { CtxEncMember.find_strict(sealed.id).or_panic.email }
assert raw == ctx_enc_raw("email", sealed.id)

# it: returns the block value and restores the context when the block raises
CtxEncMember.clear.or_panic
assert Grant::Encryption.without_encryption { 42 } == 42
error = Grant::Encryption.without_encryption { ErrorBase.new("boom") }
assert error.is_a?(ErrorBase)
assert error.message == "boom"
assert Grant::Encryption.encryption_enabled?

# it: is fiber-local: other fibers and children stay encrypted
CtxEncMember.clear.or_panic
seen = Channel(Bool).new
release = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    Grant::Encryption.without_encryption do
      seen.send(Grant::Encryption.encryption_enabled?).or_panic
      release.receive.or_panic
    end
  end
  assert !seen.receive.or_panic
  assert Grant::Encryption.encryption_enabled?
  child = Channel(Bool).new
  Grant::Encryption.without_encryption do
    assert !Grant::Encryption.encryption_enabled?
    tasks.spawn { child.send(Grant::Encryption.encryption_enabled?).or_panic }
    assert child.receive.or_panic
  end
  release.send(nil).or_panic
end

# it: is ignored inside protecting_encrypted_data
CtxEncMember.clear.or_panic
Grant::Encryption.protecting_encrypted_data do
  Grant::Encryption.without_encryption do
    assert Grant::Encryption.encryption_enabled?
    member = CtxEncMember.create_strict(email: "still@example.com").or_panic
    assert ctx_enc_raw("email", member.id) != "still@example.com"
  end
end

# it: pins keys for the block only
CtxEncMember.clear.or_panic
key = Base64.encode("tenant_key_for_context_32_bytes!")
det = Base64.encode("tenant_det_for_context_32_bytes!")
member = Grant::Encryption.with_context(primary_key: key, deterministic_key: det) do
  CtxEncMember.create_strict(email: "tenant@example.com", secret: "tenant secret")
end.or_panic
assert CtxEncMember.find_strict(member.id).is_a?(DecryptionError)
Grant::Encryption.with_context(primary_key: key, deterministic_key: det) do
  found = CtxEncMember.find_strict(member.id).or_panic
  assert found.email == "tenant@example.com"
  assert found.secret == "tenant secret"
  assert CtxEncMember.where(email: "tenant@example.com").count.or_panic == 1
end.or_panic

# it: is fiber-local
CtxEncMember.clear.or_panic
key = Base64.encode("tenant_key_for_context_32_bytes!")
release = Channel(Nil).new
pinned = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    Grant::Encryption.with_context(primary_key: key) do
      pinned.send(nil).or_panic
      release.receive.or_panic
    end.or_panic
  end
  pinned.receive.or_panic
  member = CtxEncMember.create_strict(secret: "global").or_panic
  assert CtxEncMember.find_strict(member.id).or_panic.secret == "global"
  release.send(nil).or_panic
end

# it: reports encrypted attributes
CtxEncMember.clear.or_panic
member = CtxEncMember.create_strict(email: "a@b.c", secret: "s", name: "Ada").or_panic
assert member.encrypted_attribute?(:email).or_panic
assert member.encrypted_attribute?("secret").or_panic
assert !member.encrypted_attribute?(:legacy_secret).or_panic
assert !member.encrypted_attribute?(:name).or_panic

# it: returns the ciphertext for an attribute
CtxEncMember.clear.or_panic
member = CtxEncMember.create_strict(email: "a@b.c", legacy_secret: "old form").or_panic
assert member.ciphertext_for(:email).or_panic == ctx_enc_raw("email", member.id)
assert member.ciphertext_for(:legacy_secret).or_panic == ctx_enc_raw("legacy_secret_encrypted", member.id)
assert member.ciphertext_for(:name).is_a?(ArgumentError)

# it: decrypts to plaintext columns and encrypts them again
CtxEncMember.clear.or_panic
member = CtxEncMember.create_strict(email: "a@b.c", secret: "s").or_panic
loaded = CtxEncMember.find_strict(member.id).or_panic
assert Grant::Encryption.without_encryption { loaded.decrypt }.or_panic
assert ctx_enc_raw("email", member.id) == "a@b.c"
assert ctx_enc_raw("secret", member.id) == "s"
Grant::Encryption.with_context { nil }.or_panic
assert loaded.encrypt.or_panic
assert ctx_enc_raw("email", member.id) != "a@b.c"
assert CtxEncMember.find_strict(member.id).or_panic.secret == "s"

# it: refuses to rewrite a new record
CtxEncMember.clear.or_panic
assert CtxEncMember.new(email: "x").encrypt.is_a?(ArgumentError)

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
