module test/m03_fixture
import std/dir::{Dir}
import std/file::{File}

import grant/schema/migration::{Migration}
import grant/error::{ErrorBase}
import grant/schema/introspection
import grant/schema/schema_migration::{SchemaMigration, Tracking}
import grant/adapter/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import test/spec_helper::{CURRENT_ADAPTER}

pub def adapter : Base
  ConnectionRegistry.get_adapter(CURRENT_ADAPTER)
end

pub TABLES = ["m03_users", "m03_posts", "m03_tags", "m03_comments", "m03_widgets",
  "m03_micrate_users", "m03_micrate_posts", "m03_atomic", "m03_sql_one", "m03_sql_two",
  "m03_lock_rows", "m03_tenant_items", "m03_a", "m03_b", "m03_c", "m03_d",
  "m03_join_a_m03_join_b", "m03_joins", "m03_revert", "m03_dry"]
pub TRACKING = ["schema_migrations", "micrate_db_version", "ar_internal_metadata"]

pub def reset_in_place(target : Base = adapter) : Nil
  (TABLES + TRACKING).each do |table|
    target.open { |db| db.exec("DROP TABLE IF EXISTS #{table}") }.or_panic
  end
  target.reset_schema_caches_in_place
end

pub def table?(name : String, target : Base = adapter) : Bool
  target.reset_schema_caches_in_place
  target.schema.table_exists?(name).or_panic
end

pub def column?(table : String, column : String, target : Base = adapter) : Bool
  target.reset_schema_caches_in_place
  target.schema.table_exists?(table).or_panic && target.schema.columns(table).or_panic.any? { |info| info.name == column }
end

pub def versions(target : Base = adapter, tracking : Tracking = Tracking::Grant) : Array(Int64)
  SchemaMigration.new(target, tracking).versions.or_panic.to_a.sorted
end

pub class M03CreateUsers < Migration
  migration_version 20240101000001
  def change : Nil | ErrorBase | Cancelled
    create_table(:m03_users) do |t|
      t.string(:email, null: false)!
      t.timestamps
    end
  end
end
pub class M03AddAgeToUsers < Migration
  migration_version 20240101000002
  def change : Nil | ErrorBase | Cancelled
    add_column(:m03_users, :age, :integer)!
    add_index(:m03_users, :age, unique: true)
  end
end
pub class M03CreatePosts < Migration
  migration_version 20240101000003
  def up : Nil | ErrorBase | Cancelled
    create_table(:m03_posts) { |t| t.string(:title) }
  end
  def down : Nil | ErrorBase | Cancelled
    drop_table(:m03_posts)
  end
end

@@tmp_counter : Int32 = 0
pub def tmpdir(&block : String -> T) : T forall T
  @@tmp_counter += 1
  dir = "build/tmp/m03_#{IyiScheduler.current.object_id}_#{@@tmp_counter}"
  Dir.mkdir_p(dir)
  defer cleanup_tmpdir(dir)
  yield dir
end
private def cleanup_tmpdir(dir : String) : Nil
  Dir.each_child(dir) { |child| File.delete(File.join(dir, child)) }
  Dir.delete(dir)
  nil
end
