module test/grant_query_where_range_test

import std/time::{Time}
import grant/base::{Base}
import grant/query/builder::{Builder}
import test/spec_helper::{register_spec_connections}

pub class WfMeasure < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_measures
  column id : Int64, primary: true
  column label : String?
  column rank : Int32?
  column amount : Float64?
  column happened_at : Time?
end

private def rank_labels(relation : Builder(WfMeasure)) : Array(String)
  relation.order(:rank).select.or_panic.map { |measure| measure.label.to_s }
end

private def reset : Nil
  WfMeasure.clear.or_panic
  (1..5).each do |rank|
    WfMeasure.create_strict(
      label: "m#{rank}", rank: rank, amount: rank * 1.5,
      happened_at: Time.utc(2024, rank, 1)
    ).or_panic
  end
end

register_spec_connections
WfMeasure.migrator.drop_and_create.or_panic

# it: keeps closed and exclusive-end ranges
reset
assert rank_labels(WfMeasure.where(rank: 2..4)) == ["m2", "m3", "m4"]
assert rank_labels(WfMeasure.where(rank: 2...4)) == ["m2", "m3"]

# it: keeps only the upper bound of a beginless range
reset
assert rank_labels(WfMeasure.where(rank: ..3)) == ["m1", "m2", "m3"]
assert rank_labels(WfMeasure.where(rank: ...3)) == ["m1", "m2"]
assert WfMeasure.where(rank: ..3).to_sql.includes?("<=")
assert WfMeasure.where(rank: ...3).to_sql.includes?("<")

# it: keeps only the lower bound of an endless range
reset
assert rank_labels(WfMeasure.where(rank: 4..)) == ["m4", "m5"]
assert rank_labels(WfMeasure.where(rank: 4...)) == ["m4", "m5"]
assert !WfMeasure.where(rank: 4..).to_sql.includes?("<")

# it: adds no condition for a range with neither bound
reset
assert WfMeasure.where(rank: (nil..nil)).count.or_panic == 5

# it: supports Float ranges
reset
assert rank_labels(WfMeasure.where(amount: 3.0..6.0)) == ["m2", "m3", "m4"]
assert rank_labels(WfMeasure.where(amount: ..3.0)) == ["m1", "m2"]
assert rank_labels(WfMeasure.where(amount: 6.0..)) == ["m4", "m5"]

# it: supports Time ranges
reset
span = Time.utc(2024, 2, 1)..Time.utc(2024, 4, 1)
assert rank_labels(WfMeasure.where(happened_at: span)) == ["m2", "m3", "m4"]
assert rank_labels(WfMeasure.where(happened_at: Time.utc(2024, 2, 1)...Time.utc(2024, 4, 1))) == ["m2", "m3"]
assert rank_labels(WfMeasure.where(happened_at: ..Time.utc(2024, 2, 1))) == ["m1", "m2"]
assert rank_labels(WfMeasure.where(happened_at: Time.utc(2024, 5, 1)..)) == ["m5"]

# it: supports String ranges
reset
assert rank_labels(WfMeasure.where(label: "m2".."m4")) == ["m2", "m3", "m4"]
assert rank_labels(WfMeasure.where(label: "m3"..)) == ["m3", "m4", "m5"]
assert rank_labels(WfMeasure.where(label: ..."m3")) == ["m1", "m2"]

# it: combines with other conditions and with and
reset
assert rank_labels(WfMeasure.where(rank: 2..).where(amount: ..6.0)) == ["m2", "m3", "m4"]
assert rank_labels(WfMeasure.where(rank: 1..).and_where(rank: ..2)) == ["m1", "m2"]

# it: groups an open range under or
reset
assert rank_labels(WfMeasure.where(label: "m1").or_where(rank: 5..)) == ["m1", "m5"]
assert rank_labels(WfMeasure.where(label: "m1").or_where(rank: ..2)) == ["m1", "m2"]
assert rank_labels(WfMeasure.where(label: "m1").or_where(rank: 4...5)) == ["m1", "m4"]

# it: binds the range values in order
reset
relation = WfMeasure.where(label: "m3").or_where(rank: 4..5).where(amount: ..100.0)
assert rank_labels(relation) == ["m3", "m4", "m5"]

# it: accepts ranges inside an array
reset
assert rank_labels(WfMeasure.where(rank: [1, 4..5])) == ["m1", "m4", "m5"]
assert rank_labels(WfMeasure.where(rank: [2..3, 5])) == ["m2", "m3", "m5"]
assert rank_labels(WfMeasure.where(rank: [..1, 5..])) == ["m1", "m5"]
assert rank_labels(WfMeasure.where(rank: [2...4, nil])) == ["m2", "m3"]
assert rank_labels(WfMeasure.where(label: ["m1", "m4".."m5"])) == ["m1", "m4", "m5"]
assert rank_labels(WfMeasure.where(rank: [1, 2..3]).where(amount: 3.0..)) == ["m2", "m3"]

# it: applies to where.between
reset
assert rank_labels(WfMeasure.where.between(:rank, 2..3)) == ["m2", "m3"]

WfMeasure.adapter.close.or_panic
