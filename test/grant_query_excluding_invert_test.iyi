module test/grant_query_excluding_invert_test
import test/where_family_models
import test/spec_helper::{register_spec_connections}
import grant/query/builder::{Builder}

private def titles(relation : Builder(::WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map(&.title.to_s)
end

private def prepare_records : Nil
  ::Test::WhereFamilyModels.wf_clear_tables
  ::WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  ::WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  ::WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  ::WfPost.create_strict(title: "d", published: true, score: nil).or_panic
  nil
end
register_spec_connections
::Test::WhereFamilyModels.wf_create_tables


# it: leaves out the given records
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
c = ::WfPost.find_by_strict(title: "c").or_panic
assert titles(::WfPost.excluding(a, c)) == ["b", "d"]
assert titles(::WfPost.excluding(a)) == ["b", "c", "d"]

# it: takes an array and a relation's records
prepare_records
records = ::WfPost.where(published: true).order(:id).select.or_panic
assert titles(::WfPost.excluding(records)) == ["b"]
assert titles(::WfPost.excluding(records.to_a)) == ["b"]

# it: chains onto a relation
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
assert titles(::WfPost.where(score: 1..3).excluding(a)) == ["b", "c"]
assert titles(::WfPost.excluding(a).where(score: 1..3)) == ["b", "c"]

# it: is a no-op for no records
prepare_records
assert titles(::WfPost.excluding([] of ::WfPost)) == ["a", "b", "c", "d"]
assert !::WfPost.excluding([] of ::WfPost).to_sql.includes?("NOT IN")

# it: ignores records that were never saved
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
assert titles(::WfPost.excluding(a, ::WfPost.new(title: "new"))) == ["b", "c", "d"]
assert titles(::WfPost.excluding(::WfPost.new(title: "new"))) == ["a", "b", "c", "d"]

# it: uses NOT IN on the primary key
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
b = ::WfPost.find_by_strict(title: "b").or_panic
assert ::WfPost.excluding(a, b).to_sql.includes?("NOT IN")

# it: spells without the same way
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
b = ::WfPost.find_by_strict(title: "b").or_panic
assert titles(::WfPost.without(a, b)) == ["c", "d"]
assert titles(::WfPost.where(score: 1..3).without([a])) == ["b", "c"]

# it: does not change the receiver
prepare_records
a = ::WfPost.find_by_strict(title: "a").or_panic
base = ::WfPost.where(score: 1..3)
base.excluding(a)
assert titles(base) == ["a", "b", "c"]

# it: negates all the conditions together
prepare_records
relation = ::WfPost.where(published: true, score: 1).invert_where
assert relation.to_sql.includes?("NOT (")
assert titles(relation) == ["b", "c"]

# it: negates a single condition
prepare_records
assert titles(::WfPost.where(score: 1..2).invert_where) == ["c"]
assert titles(::WfPost.where(title: ["a", "b"]).invert_where) == ["c", "d"]

# it: does nothing without conditions
prepare_records
assert titles(::WfPost.all.invert_where) == ["a", "b", "c", "d"]
assert !::WfPost.all.invert_where.to_sql.includes?("NOT")

# it: only inverts what came before it
prepare_records
assert titles(::WfPost.where(published: true).invert_where.where(score: 2..4)) == ["b"]

# it: follows SQL NULL logic like ActiveRecord: a NULL column matches neither side
prepare_records
assert titles(::WfPost.where(published: true, score: 1..3)) == ["a", "c"]
assert titles(::WfPost.where(published: true, score: 1..3).invert_where) == ["b"]
assert titles(::WfPost.where(score: nil).invert_where) == ["a", "b", "c"]

# it: inverts an or chain as one group
prepare_records
relation = ::WfPost.where(title: "a").or_where(title: "b").invert_where
assert titles(relation) == ["c", "d"]

# it: keeps bind order after the group (numbered on PG)
prepare_records
relation = ::WfPost.where(score: 1, title: "a").invert_where.where(title: "b").where(score: 2)
assert titles(relation) == ["b"]

# it: does not change the receiver
prepare_records
base = ::WfPost.where(published: false)
base.invert_where
assert titles(base) == ["b"]
