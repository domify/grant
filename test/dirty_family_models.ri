module test/dirty_family_models
import grant/base::{Base}
import std/env
import std/json::{serializable}
import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}
register_spec_connections

pub class F01Post < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_posts
  column id : Int64, primary: true
  column title : String?
  column body : String?
  column views : Int32?
end

F01Post.migrator.drop_and_create.or_panic


pub class F01Settings
  property theme : String = "light"
  property items : Array(String) = [] of String
  derive serializable
  def initialize(@theme : String = "light", @items : Array(String) = [] of String)
  end
end

pub class F01Tagged < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_taggeds
  column id : Int64, primary: true
  column title : String?
  column tags : Array(String)?
end

pub class F01Watched < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_watcheds
  column id : Int64, primary: true
  column title : String?
  column views : Int32?
  column tags : Array(String)?
  detect_mutation
end

pub class F01WatchedNamed < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_watched_nameds
  column id : Int64, primary: true
  column tags : Array(String)?
  column labels : Array(String)?
  detect_mutation :tags
end

pub class F01Prefs < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_prefs
  column id : Int64, primary: true
  column title : String?
  serialized_column :prefs, F01Settings, format: :json
  detect_mutation
end

pub class F01PlainPrefs < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table f01_plain_prefs
  column id : Int64, primary: true
  serialized_column :prefs, F01Settings, format: :json
end

F01Prefs.migrator.drop_and_create.or_panic
F01PlainPrefs.migrator.drop_and_create.or_panic
if CURRENT_ADAPTER == "pg"
  F01Tagged.migrator.drop_and_create.or_panic
  F01Watched.migrator.drop_and_create.or_panic
end
