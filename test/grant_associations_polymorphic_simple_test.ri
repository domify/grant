module test/grant_associations_polymorphic_simple_test
import grant/base::{Base}
import grant/polymorphic::{PolymorphicProxy}

pub class TestComment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table test_comments

  column id : Int64, primary: true
  column content : String

  # Polymorphic association
  belongs_to :commentable, polymorphic: true, optional: true
end

pub class TestPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table test_posts

  column id : Int64, primary: true
  column name : String
end

pub class TestBook < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table test_books

  column id : Int64, primary: true
  column name : String
end

# it: creates the necessary columns
assert TestComment.fields.includes?("commentable_id")
assert TestComment.fields.includes?("commentable_type")

# it: checks if types are registered
assert ::Grant::Polymorphic.registered_type?("#{TestPost}")
assert ::Grant::Polymorphic.registered_type?("#{TestBook}")
assert !::Grant::Polymorphic.registered_type?("NonExistent")

# it: creates a proxy for lazy loading
proxy = PolymorphicProxy.new("TestPost", 123_i64)
assert proxy.type == "TestPost"
assert proxy.id == 123_i64
assert proxy.present?

nil_proxy = PolymorphicProxy.new(nil, nil)
assert !nil_proxy.present?
