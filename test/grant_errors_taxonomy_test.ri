module test/grant_errors_taxonomy_test
import grant/errors
import grant/querying
import grant/locking
import grant/locking/optimistic
import grant/sti
import grant/value_objects
import grant/scale/index_hints
import grant/encryption/key_provider
import grant/encryption/cipher
import grant/async/errors
import grant/readonly
import grant/transaction
import std/io::{Memory}
import test/transaction_crud_models::{Parent, CallbackWithAbort}
import test/spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
CallbackWithAbort.migrator.drop_and_create.or_panic

# it: roots every Grant error in Grant::ErrorBase
{% for error_class in [::Grant::Errors::RecordNotSaved, ::Grant::Errors::RecordInvalid, ::Grant::Errors::RecordNotFound,
  ::Grant::Querying::NotFound, ::Grant::Errors::RecordNotDestroyed, ::Grant::ErrorTaxonomy::StatementInvalid,
  ::Grant::ErrorTaxonomy::RecordNotUnique, ::Grant::ErrorTaxonomy::InvalidForeignKey, ::Grant::ErrorTaxonomy::NotNullViolation,
  ::Grant::ErrorTaxonomy::ValueTooLong, ::Grant::ErrorTaxonomy::Deadlocked, ::Grant::ErrorTaxonomy::SerializationFailure,
  ::Grant::ErrorTaxonomy::LockWaitTimeout, ::Grant::ErrorTaxonomy::StatementTimeout, ::Grant::ErrorTaxonomy::QueryCanceled,
  ::Grant::ErrorTaxonomy::NoDatabaseError, ::Grant::ErrorTaxonomy::ConnectionNotEstablished,
  ::Grant::ErrorTaxonomy::ConnectionTimeoutError, ::Grant::ErrorTaxonomy::ConnectionFailed,
  ::Grant::ErrorTaxonomy::AdapterNotAvailableError, ::Grant::Transaction::ReadOnlyError,
  ::Grant::Readonly::ReadOnlyRecordError, ::Grant::Querying::NotUnique,
  ::Grant::Locking::Optimistic::StaleObjectError, ::Grant::Sti::SubclassNotFound,
  ::Grant::Sti::ImmutableTypeError, ::Grant::Sti::TypeCastingError,
  ::Grant::ValueObjects::ValueObjectError, ::Grant::Scale::IndexHints::UnsupportedIndexHintError,
  ::Grant::Encryption::KeyProvider::KeyError, ::Grant::Encryption::Cipher::EncryptionError,
  ::Grant::Encryption::Cipher::DecryptionError, ::Grant::Async::Errors::AsyncError,] %}
assert {{ error_class.resolve <= ::Grant::Errors::ErrorBase }}
{% end %}

# it: nests the record errors
assert {{ ::Grant::Errors::RecordInvalid < ::Grant::Errors::RecordNotSaved }}
assert {{ ::Grant::Querying::NotFound < ::Grant::Errors::RecordNotFound }}

# it: nests the statement errors under StatementInvalid
{% for error_class in [::Grant::ErrorTaxonomy::RecordNotUnique, ::Grant::ErrorTaxonomy::InvalidForeignKey, ::Grant::ErrorTaxonomy::NotNullViolation,
  ::Grant::ErrorTaxonomy::ValueTooLong, ::Grant::ErrorTaxonomy::TransactionRollbackError, ::Grant::ErrorTaxonomy::LockWaitTimeout,
  ::Grant::ErrorTaxonomy::StatementTimeout, ::Grant::ErrorTaxonomy::QueryCanceled, ::Grant::ErrorTaxonomy::NoDatabaseError,] %}
assert {{ error_class.resolve < ::Grant::ErrorTaxonomy::StatementInvalid }}
{% end %}
assert {{ ::Grant::ErrorTaxonomy::Deadlocked < ::Grant::ErrorTaxonomy::TransactionRollbackError }}
assert {{ ::Grant::ErrorTaxonomy::SerializationFailure < ::Grant::ErrorTaxonomy::TransactionRollbackError }}

# it: nests the connection errors under ConnectionNotEstablished
assert {{ ::Grant::ErrorTaxonomy::ConnectionTimeoutError < ::Grant::ErrorTaxonomy::ConnectionNotEstablished }}
assert {{ ::Grant::ErrorTaxonomy::ConnectionFailed < ::Grant::ErrorTaxonomy::ConnectionNotEstablished }}
assert {{ ::Grant::ErrorTaxonomy::AdapterNotAvailableError < ::Grant::ErrorTaxonomy::ConnectionNotEstablished }}

# it: keeps the historical names as the same classes
assert ::Grant::Locking::DeadlockError.to_s == ::Grant::ErrorTaxonomy::Deadlocked.to_s
assert ::Grant::Locking::LockWaitTimeoutError.to_s == ::Grant::ErrorTaxonomy::LockWaitTimeout.to_s
assert ::Grant::Transaction::SerializationError.to_s == ::Grant::ErrorTaxonomy::SerializationFailure.to_s
assert ::Grant::ErrorTaxonomy::ReadOnlyError.to_s == ::Grant::Transaction::ReadOnlyError.to_s
assert ::Grant::ErrorTaxonomy::ConnectionNotDefined.to_s == ::Grant::ErrorTaxonomy::AdapterNotAvailableError.to_s


# it: lets one rescue clause catch any Grant error
Parent.clear.or_panic
CallbackWithAbort.clear.or_panic
raised = Parent.find_strict(0)
assert raised.is_a?(::Grant::Errors::ErrorBase)
assert raised.is_a?(::Grant::Querying::NotFound)
assert raised.is_a?(::Grant::Errors::RecordNotFound)

# it: is raised by save! with the record and every full message
Parent.clear.or_panic
parent = Parent.new
error = parent.save_strict
assert error.is_a?(::Grant::Errors::RecordInvalid)
invalid = error.as(::Grant::Errors::RecordInvalid)
assert invalid.record.as(Parent).object_id == parent.object_id
assert invalid.model.as(Parent).object_id == parent.object_id
assert invalid.record.as(Parent).errors.full_messages == ["Name Name cannot be blank"]
assert invalid.message == "Validation failed: Name Name cannot be blank"

# it: joins several failures into one message
Parent.clear.or_panic
parent = Parent.new
parent.errors.add(:name, "is too short")
parent.errors.add(:base, "Record is invalid")
assert ::Grant::Errors::RecordInvalid.new(parent).message == "Validation failed: Name is too short, Record is invalid"

# it: is raised by create!
Parent.clear.or_panic
error = Parent.create_strict(name: "")
assert error.is_a?(::Grant::Errors::RecordInvalid)
invalid = error.as(::Grant::Errors::RecordInvalid)
assert invalid.message == "Validation failed: Name Name cannot be blank"
assert invalid.record.is_a?(Parent)
assert Parent.count.or_panic == 0

# it: is raised by update!
Parent.clear.or_panic
parent = Parent.create_strict(name: "Ada").or_panic
error = parent.update_strict(name: "")
assert error.is_a?(::Grant::Errors::RecordInvalid)
assert error.as(::Grant::Errors::RecordInvalid).message == "Validation failed: Name Name cannot be blank"
assert Parent.find_strict(parent.id).or_panic.name == "Ada"

# it: can still be rescued as RecordNotSaved
Parent.clear.or_panic
assert Parent.new.save_strict.is_a?(::Grant::Errors::RecordNotSaved)

# it: does not fail when no errors were recorded
Parent.clear.or_panic
assert ::Grant::Errors::RecordInvalid.new(Parent.new).message == "Validation failed"

# it: is raised, not RecordInvalid, when a callback aborts the save
CallbackWithAbort.clear.or_panic
record = CallbackWithAbort.new(abort_at: "before_save", do_abort: true)
record.history = Memory.new
error = record.save_strict
assert error.is_a?(::Grant::Errors::RecordNotSaved)
assert !error.is_a?(::Grant::Errors::RecordInvalid)
assert error.as(::Grant::Errors::RecordNotSaved).model.as(CallbackWithAbort).object_id == record.object_id

# it: builds a safe message when a callback halted the save without an error
Parent.clear.or_panic
halted = Parent.new
assert halted.errors.empty?
message = ::Grant::Errors::RecordNotSaved.new("Parent", halted).message
assert message == "Could not process Parent: the save was halted before the record was persisted"

# it: keeps the existing message when an error was recorded
Parent.clear.or_panic
parent = Parent.new
parent.save.or_panic
assert ::Grant::Errors::RecordNotSaved.new("Parent", parent).message == "Could not process Parent: Name cannot be blank"

stale = ::Grant::Locking::Optimistic::StaleObjectError.new(parent)
assert stale.record_class == Parent.to_s
assert stale.record_id == parent.id.to_s
assert stale.message == "Attempted to update a stale #{Parent} (id: #{parent.id})"

Parent.adapter.close.or_panic
CallbackWithAbort.adapter.close.or_panic
