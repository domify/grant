module test/grant_query_w6_reorder_sql_test
import grant
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError}
import std/text
import test/spec_helper::{register_spec_connections}

pub class W6roRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6ro_rows

  column id : Int64, primary: true
  column name : String?
  column kind : String?
  column rank : Int32 = 0
  column seq : Int32 = 0
end

def seqs(relation : Builder(W6roRow)) : Array(Int32)
  relation.select.or_panic.map(&.seq)
end

register_spec_connections
W6roRow.migrator.drop_and_create.or_panic

def seed_rows : Nil
  W6roRow.clear.or_panic
  W6roRow.create_strict(name: "b", kind: "x", rank: 1, seq: 1).or_panic
  W6roRow.create_strict(name: "a", kind: "x", rank: 2, seq: 2).or_panic
  W6roRow.create_strict(name: "c", kind: "y", rank: 3, seq: 3).or_panic
  W6roRow.create_strict(name: "a", kind: "y", rank: 4, seq: 4).or_panic
  nil
end

# it: replaces the order with parsed SQL terms
seed_rows
relation = W6roRow.order(:name).reorder("rank DESC")
assert relation.order_fields.map { |term| term[:field] } == ["rank"]
assert seqs(relation) == [4, 3, 2, 1]

# it: takes several terms and directions
seed_rows
assert seqs(W6roRow.order(:seq).reorder("name ASC, rank DESC")) == [4, 2, 1, 3]

# it: accepts a function of columns and a trusted expression
seed_rows
assert seqs(W6roRow.reorder("lower(name) DESC, seq")) == [3, 1, 2, 4]
assert seqs(W6roRow.order(:name).reorder(::Grant.sql("CASE WHEN kind = 'y' THEN 0 ELSE 1 END, seq"))) == [3, 4, 1, 2]

# it: rejects SQL that is not a column or function of columns, like order
seed_rows
assert W6roRow.reorder("rank; DROP TABLE w6ro_rows").select.is_a?(ArgumentError)
assert W6roRow.reorder("(SELECT 1)").select.is_a?(ArgumentError)

# it: takes a direction and a NULL placement
seed_rows
assert seqs(W6roRow.order(:name).reorder(:rank, :desc)) == [4, 3, 2, 1]
# rank is reserved on MySQL, so Grant quotes it on every adapter.
assert W6roRow.order(:name).reorder("rank", :desc).to_sql.includes?("ORDER BY #{W6roRow.quote("rank")} DESC")
assert W6roRow.order(:name).reorder(:rank, nulls: :last).order_fields.size == 1

# it: works at the class level, in place of the model's order
seed_rows
assert seqs(W6roRow.reorder("seq DESC")) == [4, 3, 2, 1]

# it: marks the relation as reordered and keeps the receiver intact
seed_rows
base = W6roRow.order(:name)
reordered = base.reorder("rank")
assert reordered.reordering?
assert !base.reordering?
assert base.order_fields.map { |term| term[:field] } == ["name"]

# it: reverse_order flips the reordered terms
seed_rows
assert seqs(W6roRow.order(:name).reorder("rank DESC").reverse_order) == [1, 2, 3, 4]

# it: replaces the projection with strings, arrays and mixes
seed_rows
assert W6roRow.select(:id).reselect("name", "kind").to_sql.includes?("SELECT name, kind FROM")
assert W6roRow.select(:id).reselect(["name", :kind]).to_sql.includes?("SELECT name, kind FROM")
assert W6roRow.select(:id).reselect(:name, "kind").to_sql.includes?("SELECT name, kind FROM")

# it: loads the reselected columns, expressions included
seed_rows
row = W6roRow.select(:id).reselect(:name, "seq * 10 AS scaled").where(seq: 2).first_strict.or_panic
assert row.name == "a"
assert row.extra_attribute("scaled").to_s.to_i == 20

# it: validates string expressions
seed_rows
assert W6roRow.reselect("name; DROP TABLE w6ro_rows").select.is_a?(ArgumentError)

# it: replaces the grouping with strings, arrays and mixes
seed_rows
assert W6roRow.group_records(:kind).regroup("lower(name)").to_sql.includes?("GROUP BY lower(name)")
assert W6roRow.group_records(:kind).regroup(["name", :kind]).to_sql.includes?("GROUP BY name, kind")
assert W6roRow.group_records(:kind).regroup(:name, "kind").to_sql.includes?("GROUP BY name, kind")
assert !W6roRow.group_records(:kind).regroup(:name).to_sql.includes?("kind\"")

# it: groups by the new expression when counting
seed_rows
counts = W6roRow.group_records(:kind).regroup(:name).count.or_panic
assert counts.is_a?(Hash(Value, Int64))
assert counts.as(Hash(Value, Int64))["a"] == 2

# it: leaves the receiver untouched
seed_rows
base = W6roRow.group_records(:kind)
base.regroup(:name)
assert base.group_fields.map { |field| field[:field] } == ["kind"]

W6roRow.adapter.close.or_panic
