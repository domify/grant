module test/grant_validation_helpers_choice_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class ChoiceTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true

  column number_symbol : Int32?
  column type_array_symbol : String?

  column number_string : Int32?
  column type_array_string : String?

  validate_is_valid_choice :number_symbol, [1, 2, 3]
  validate_is_valid_choice :type_array_symbol, [:internal, :external, :third_party]
  validate_is_valid_choice "number_string", [4, 5, 6]
  validate_is_valid_choice "type_array_string", ["internal", "external", "third_party"]
end

register_spec_connections
ChoiceTest.migrator.drop_and_create.or_panic

# it: should work for is_valid_choice
choice_test = ChoiceTest.new
choice_test.number_symbol = 4
choice_test.type_array_symbol = "foo"
choice_test.number_string = 2
choice_test.type_array_string = "bar"
choice_test.save
assert choice_test.errors.size == 4
assert choice_test.errors[0].message == "number_symbol has an invalid choice. Valid choices are: 1,2,3"
assert choice_test.errors[1].message == "type_array_symbol has an invalid choice. Valid choices are: internal,external,third_party"
assert choice_test.errors[2].message == "number_string has an invalid choice. Valid choices are: 4,5,6"
assert choice_test.errors[3].message == "type_array_string has an invalid choice. Valid choices are: internal,external,third_party"
ChoiceTest.adapter.close.or_panic
