module test/grant_persistence_touch_options_test
import grant/base::{Base}
import grant/error::{ArgumentError}
import std/time::{Time, Span}
import test/spec_helper::{register_spec_connections}
import test/write_sql_capture
pub class TouchTicket < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table touch_tickets

  column id : Int64, primary: true
  column title : String?
  column views : Int32?
  column last_seen_at : Time?
  timestamps
end

register_spec_connections
TouchTicket.migrator.drop_and_create.or_panic
pub FIXED_TIME = Time.utc(2020, 1, 2, 3, 4, 5)
pub def updates_in(statements : Array(String)) : Array(String)
  statements.select { |sql| sql.starts_with?("UPDATE") }
end

# it: stamps updated_at with the given time
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
assert ticket.touch(time: FIXED_TIME).or_panic

assert ticket.updated_at.as(Time) == FIXED_TIME
assert TouchTicket.find_strict(ticket.id).or_panic.updated_at.as(Time) == FIXED_TIME

# it: stamps extra columns with the same time in one UPDATE
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
statements = Test::WriteSqlCapture.statements(TouchTicket.adapter) { ticket.touch(:last_seen_at, time: FIXED_TIME).or_panic }
assert updates_in(statements).size == 1

reloaded = TouchTicket.find_strict(ticket.id).or_panic
assert reloaded.updated_at.as(Time) == FIXED_TIME
assert reloaded.last_seen_at.as(Time) == FIXED_TIME

# it: defaults to now
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
before = Time.utc - Span.seconds(1)
ticket.touch.or_panic
assert ticket.updated_at.as(Time) > before

# it: leaves other pending changes dirty and unwritten
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
ticket.title = "unsaved"
ticket.touch(time: FIXED_TIME).or_panic
assert ticket.title_changed?
assert TouchTicket.find_strict(ticket.id).or_panic.title == "t"

# it: does not touch by default
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t", views: 1).or_panic
ticket.touch(time: FIXED_TIME).or_panic
ticket.increment_strict(:views).or_panic
assert TouchTicket.find_strict(ticket.id).or_panic.updated_at.as(Time) == FIXED_TIME

# it: folds updated_at into the same UPDATE with touch: true
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t", views: 1).or_panic
ticket.touch(time: FIXED_TIME).or_panic

statements = Test::WriteSqlCapture.statements(TouchTicket.adapter) { ticket.increment_strict(:views, by: 2, touch: true).or_panic }
updates = updates_in(statements)
assert updates.size == 1
assert updates.first.includes?("views")
assert updates.first.includes?("updated_at")

reloaded = TouchTicket.find_strict(ticket.id).or_panic
assert reloaded.views == 3
assert reloaded.updated_at.as(Time) > FIXED_TIME
assert !ticket.changed?
assert ticket.updated_at == reloaded.updated_at

# it: touches a named column as well as updated_at
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t", views: 0).or_panic
ticket.touch(time: FIXED_TIME).or_panic

statements = Test::WriteSqlCapture.statements(TouchTicket.adapter) { ticket.increment_strict(:views, touch: :last_seen_at).or_panic }
assert updates_in(statements).size == 1

reloaded = TouchTicket.find_strict(ticket.id).or_panic
assert !reloaded.last_seen_at.nil?
assert reloaded.updated_at.as(Time) > FIXED_TIME

# it: supports decrement! with touch:
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t", views: 5).or_panic
ticket.touch(time: FIXED_TIME).or_panic
ticket.decrement_strict(:views, by: 2, touch: true).or_panic
reloaded = TouchTicket.find_strict(ticket.id).or_panic
assert reloaded.views == 3
assert reloaded.updated_at.as(Time) > FIXED_TIME

# it: treats a NULL counter as zero
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
ticket.increment_strict(:views).or_panic
assert TouchTicket.find_strict(ticket.id).or_panic.views == 1

# it: rejects a touch column the model does not have
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t", views: 1).or_panic
error = ticket.increment_strict(:views, touch: :nope)
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("nope")

# it: stamps updated_at through the save it performs
TouchTicket.clear.or_panic
ticket = TouchTicket.create_strict(title: "t").or_panic
ticket.touch(time: FIXED_TIME).or_panic
ticket.update_column(:title, "before").or_panic
ticket.title = "after"
ticket.save_strict.or_panic
assert TouchTicket.find_strict(ticket.id).or_panic.updated_at.as(Time) > FIXED_TIME
TouchTicket.adapter.close.or_panic
