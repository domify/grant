module test/grant_transactions_save_test
import test/transaction_crud_models::{Parent, School, ReservedWord, Comment}
import test/nation
import grant/errors::{RecordInvalid}
import std/time::{Time}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
School.migrator.drop_and_create.or_panic
Nation::County.migrator.drop_and_create.or_panic
ReservedWord.migrator.drop_and_create.or_panic
Comment.migrator.drop_and_create.or_panic


# it: creates a new object
parent = Parent.new
parent.name = "Test Parent"
parent.save.or_panic
assert parent.persisted?

# it: does not create an invalid object
parent = Parent.new
parent.name = ""
parent.save.or_panic
assert !parent.persisted?

# it: create an invalid object with validation disabled
parent = Parent.new
parent.name = ""
parent.save(validate: false).or_panic
assert parent.persisted?

# it: does not create an invalid object with validation explicitly enabled
parent = Parent.new
parent.name = ""
parent.save(validate: true).or_panic
assert !parent.persisted?

# it: does not save a model with type conversion errors
model = Comment.new(articleid: "foo")
assert model.errors.size == 1
assert !model.save.or_panic

# it: does not update timestamps is skip_timestamps is true
time = Time.utc(2023, 9, 1)
parent = Parent.new
parent.name = "Test Parent"
parent.created_at = time
parent.updated_at = time
parent.save(skip_timestamps: true).or_panic
assert parent.created_at == time
assert parent.updated_at == time

# it: updates an existing object
Parent.clear.or_panic
parent = Parent.new
parent.name = "Test Parent"
parent.save.or_panic
parent.name = "Test Parent 2"
parent.save.or_panic
parents = Parent.all.select.or_panic
assert parents.size == 1
found = Parent.first_strict.or_panic
assert found.name == parent.name

# it: does not update an invalid object
parent = Parent.new
parent.name = "Test Parent"
parent.save.or_panic
parent.name = ""
parent.save.or_panic
parent = Parent.find_strict(parent.id).or_panic
assert parent.name == "Test Parent"

# it: update an invalid object with validation disabled
Parent.clear.or_panic
parent = Parent.new
parent.name = "Test Parent"
parent.save.or_panic
parent.name = ""
parent.save(validate: false).or_panic
parents = Parent.all.select.or_panic
assert parents.size == 1
found = Parent.first_strict.or_panic
assert found.name == parent.name

# it: does not update an invalid object with validation explicitly enabled
parent = Parent.new
parent.name = "Test Parent"
parent.save.or_panic
parent.name = ""
parent.save(validate: true).or_panic
parent = Parent.find_strict(parent.id).or_panic
assert parent.name == "Test Parent"

# it: does not update when the conflicted primary key is given to the new record
parent1 = Parent.new
parent1.name = "Test Parent"
assert parent1.save.or_panic
parent2 = Parent.new
parent2.id = parent1.id
parent2.name = "Test Parent2"
assert !parent2.save.or_panic

# it: creates a new object
school = School.new
school.name = "Test School"
school.save.or_panic
assert !school.custom_id.nil?

# it: updates an existing object
old_name = "Test School 1"
new_name = "Test School 2"
school = School.new
school.name = old_name
school.save.or_panic
primary_key = school.custom_id
school.name = new_name
school.save.or_panic
found_school = School.find_strict(primary_key).or_panic
assert found_school.custom_id == primary_key
assert found_school.name == new_name

# it: updates states of new_record and persisted
parent = Parent.new
assert parent.new_record?
assert !parent.persisted?
parent.name = "Test Parent"
parent.save.or_panic
assert !parent.new_record?
assert parent.persisted?

# it: creates a new object
county = Nation::County.new
county.name = "Test School"
county.save.or_panic
assert county.persisted?

# it: updates an existing object
old_name = "Test County 1"
new_name = "Test County 2"
county = Nation::County.new
county.name = old_name
county.save.or_panic
primary_key = county.id
county.name = new_name
county.save.or_panic
found_county = Nation::County.find_strict(primary_key).or_panic
assert found_county.name == new_name
# `all` is a reserved word in almost RDB like MySQL, PostgreSQL

# it: creates and updates
reserved_word = ReservedWord.new
reserved_word.all = "foo"
reserved_word.save.or_panic
assert reserved_word.errors.empty?
reserved_word.all = "bar"
reserved_word.save.or_panic
assert reserved_word.errors.empty?
assert reserved_word.all == "bar"

# it: creates a new object
parent = Parent.new
parent.name = "Test Parent"
parent.save_strict.or_panic
assert parent.persisted?

# it: does not create but raise an exception
parent = Parent.new
error = parent.save_strict
assert error.is_a?(RecordInvalid)
assert error.as(RecordInvalid).message.includes?("Validation failed")

Parent.adapter.close.or_panic
