module test/grant_associations_dependent_delete_all_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class DeleteAllParent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table delete_all_parents

  column id : Int64, primary: true
  column name : String?

  has_many :delete_all_children, class_name: DeleteAllChild, foreign_key: :delete_all_parent_id, dependent: :delete_all
  has_one :delete_all_one_child, class_name: DeleteAllOneChild, foreign_key: :delete_all_parent_id, dependent: :delete
end

pub class DeleteAllChild < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table delete_all_children

  column id : Int64, primary: true
  column name : String?
  column delete_all_parent_id : Int64?

  belongs_to :delete_all_parent, class_name: DeleteAllParent, foreign_key: :delete_all_parent_id, optional: true
end

pub class DeleteAllOneChild < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table delete_all_one_children

  column id : Int64, primary: true
  column label : String?
  column delete_all_parent_id : Int64?

  belongs_to :delete_all_parent, class_name: DeleteAllParent, foreign_key: :delete_all_parent_id, optional: true
end

register_spec_connections
DeleteAllParent.migrator.drop_and_create.or_panic
DeleteAllChild.migrator.drop_and_create.or_panic
DeleteAllOneChild.migrator.drop_and_create.or_panic

# it: deletes all children with SQL DELETE when parent is destroyed
DeleteAllChild.clear.or_panic
DeleteAllOneChild.clear.or_panic
DeleteAllParent.clear.or_panic
parent = DeleteAllParent.new
parent.name = "parent1"
assert parent.save

# Create children
3.times do |i|
  child = DeleteAllChild.new
  child.name = "child_#{i}"
  child.delete_all_parent_id = parent.id
  assert child.save
end

assert DeleteAllChild.where(delete_all_parent_id: parent.id).count.or_panic == 3

# Destroy parent
assert parent.destroy

# Children should be deleted
assert DeleteAllChild.where(delete_all_parent_id: parent.id).count.or_panic == 0

# it: does not trigger callbacks on children
DeleteAllChild.clear.or_panic
DeleteAllOneChild.clear.or_panic
DeleteAllParent.clear.or_panic
parent = DeleteAllParent.new
parent.name = "parent2"
assert parent.save

child = DeleteAllChild.new
child.name = "child_with_callback"
child.delete_all_parent_id = parent.id
assert child.save

# Destroy parent - children are SQL deleted (no callbacks)
assert parent.destroy

# If callbacks were triggered, the child's before_destroy
# would have set a flag. Since we used delete_all, the child
# was never instantiated, so no callbacks ran.
assert DeleteAllChild.where(delete_all_parent_id: parent.id).count.or_panic == 0

# it: deletes the child with SQL DELETE when parent is destroyed
DeleteAllChild.clear.or_panic
DeleteAllOneChild.clear.or_panic
DeleteAllParent.clear.or_panic
parent = DeleteAllParent.new
parent.name = "parent3"
assert parent.save

child = DeleteAllOneChild.new
child.label = "only_child"
child.delete_all_parent_id = parent.id
assert child.save

assert DeleteAllOneChild.where(delete_all_parent_id: parent.id).count.or_panic == 1

assert parent.destroy

assert DeleteAllOneChild.where(delete_all_parent_id: parent.id).count.or_panic == 0

DeleteAllParent.adapter.close.or_panic
