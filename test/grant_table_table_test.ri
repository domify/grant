module test/grant_table_table_test
import grant/base::{Base}
import test/table_namespace_model

pub class SongThread < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  column id : Int64, primary: true
  column name : String?
end

pub class CustomSongThread < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table custom_table_name
  column custom_primary_key : Int64, primary: true
  column name : String?
end

# it: sets the table name to name specified
assert CustomSongThread.table_name == "custom_table_name"

# it: sets the table name based on class name if not specified
assert SongThread.table_name == "song_thread"

# it: strips the namespace when defining the default table now
assert MyApp::Namespace::Model.table_name == "model"

# it: sets the primary key name to name specified
assert CustomSongThread.primary_name == "custom_primary_key"

# it: sets the primary key name to id if not specified
assert SongThread.primary_name == "id"
