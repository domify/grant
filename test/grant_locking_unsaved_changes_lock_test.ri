module test/grant_locking_unsaved_changes_lock_test
import grant/base::{Base}
import grant/error::{ErrorBase}
import grant/locking::{LockMode}
import grant/locking/clause::{clause}
import grant/locking/pessimistic::{UnsavedChangesLockError, UnsavedChangesError}
import test/spec_helper::{register_spec_connections}
register_spec_connections

pub class UnsavedLockSpecNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table unsaved_lock_spec_notes
  column id : Int64, primary: true
  column title : String
  column body : String?
end
UnsavedLockSpecNote.migrator.drop_and_create.or_panic

# it: raises UnsavedChangesLockError from lock! and leaves the changes alone
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.title = "Edited"
UnsavedLockSpecNote.transaction do
  error = note.lock_strict
  assert error.is_a?(UnsavedChangesLockError)
  assert error.as(UnsavedChangesLockError).message.includes?("unsaved changes")
end.or_panic
assert note.title == "Edited"
assert note.changed?

# it: is the same error under the Locking namespace
# Native metaclass equality compares identity incorrectly; compare the class names.
assert UnsavedChangesError.to_s == UnsavedChangesLockError.to_s
assert UnsavedChangesLockError.new.is_a?(ErrorBase)

# it: raises from reload_with_lock and from every lock mode
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.body = "draft"
UnsavedLockSpecNote.transaction do
  assert note.reload_with_lock.is_a?(UnsavedChangesLockError)
  assert note.lock_strict(LockMode::Share).is_a?(UnsavedChangesLockError)
  assert note.lock_strict(clause("FOR UPDATE")).is_a?(UnsavedChangesLockError)
end.or_panic

# it: raises from with_lock without opening a transaction's worth of work
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.title = "Edited"
ran = false
error = note.with_lock { |_locked| ran = true }
assert error.is_a?(UnsavedChangesLockError)
assert !ran
assert UnsavedLockSpecNote.find_strict(note.id).or_panic.title == "Original"

# it: discards the changes and locks the fresh row with force: true
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.title = "Edited"
UnsavedLockSpecNote.transaction do
  assert note.lock_strict(force: true).or_panic.object_id == note.object_id
end.or_panic
assert note.title == "Original"
assert !note.changed?

# it: supports force: true on with_lock
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.title = "Edited"
title = note.with_lock(force: true, &.title).or_panic
assert title == "Original"
assert !note.changed?

# it: locks a clean record without complaint
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
UnsavedLockSpecNote.transaction do
  assert note.lock_strict.or_panic.object_id == note.object_id
end.or_panic
assert note.with_lock(&.title).or_panic == "Original"

# it: treats a record whose change was undone as clean
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.title = "Edited"
note.title = "Original"
UnsavedLockSpecNote.transaction { note.lock_strict }.or_panic

# it: counts a saved change as clean and an unsaved one after it as dirty
UnsavedLockSpecNote.clear.or_panic
note = UnsavedLockSpecNote.create_strict(title: "Original").or_panic
note.update_strict(title: "Saved").or_panic
UnsavedLockSpecNote.transaction { note.lock_strict }.or_panic
note.body = "Not saved"
UnsavedLockSpecNote.transaction do
  assert note.lock_strict.is_a?(UnsavedChangesLockError)
end.or_panic
