module test/grant_schema_verify_model_test
import grant/base::{Base}
import std/time::{Time}
import grant/schema/verify::{Drift, DriftError}
import test/schema_fixture
import test/spec_helper::{register_spec_connections, restore_default_spec_connections}

pub class M01Author < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_authors

  column id : Int64, primary: true
  column email : String
  column bio : String?
  column active : Bool
  column created_at : Time?
end

pub class M01DriftedAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_authors

  column id : Int64, primary: true
  column email : Int32
  column nickname : String?
end

pub class M01PartialAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_authors

  column id : Int64, primary: true
  column email : String
  column bio : String
end

pub class M01Ghost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_ghosts

  column id : Int64, primary: true
end

pub class M01Membership < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table m01_memberships

  column author_id : Int64, primary: true
  column group_id : Int64
  column role : String?
end

register_spec_connections
restore_default_spec_connections
::Test::SchemaFixture.create_in_place

# it: finds no drift in a model that matches its table
assert M01Author.verify_schema.or_panic.empty?
M01Author.verify_schema_strict.or_panic
assert M01Author.verify_schema(strict: true).or_panic.empty?

# it: reports a missing table
drift = M01Ghost.verify_schema.or_panic
assert drift.map { |entry| entry.kind } == [Drift::Kind::MissingTable]
assert !M01Ghost.table_exists?.or_panic

# it: reports missing columns and type mismatches
drift = M01DriftedAuthor.verify_schema.or_panic
kinds = drift.map { |entry| {entry.kind, entry.column_name} }
assert kinds.includes?({Drift::Kind::MissingColumn, "nickname"})
assert kinds.includes?({Drift::Kind::TypeMismatch, "email"})
assert kinds.size == 2

# it: raises DriftError naming every difference
error = M01DriftedAuthor.verify_schema_strict
assert error.is_a?(DriftError)
message = error.as(DriftError).message.to_s
assert message.includes?("nickname") && message.includes?("email")
assert error.as(DriftError).model_name == M01DriftedAuthor.to_s
assert error.as(DriftError).drift.size == 2

# it: reports a primary key that differs from the table
drift = M01Membership.verify_schema.or_panic
assert drift.map { |entry| entry.kind } == [Drift::Kind::PrimaryKeyMismatch]

# it: reports undeclared and nullable columns only when strict
assert M01PartialAuthor.verify_schema.or_panic.empty?
drift = M01PartialAuthor.verify_schema(strict: true).or_panic
assert drift.select { |entry| entry.kind == Drift::Kind::UndeclaredColumn }.map { |entry| entry.column_name } == ["active", "created_at"]
assert drift.select { |entry| entry.kind == Drift::Kind::NullableColumn }.map { |entry| entry.column_name } == ["bio"]

# it: exposes the table's columns, indexes and keys on the model
assert M01Author.column_exists?(:email).or_panic
assert !M01Author.column_exists?(:nope).or_panic
assert M01Author.database_columns.or_panic.map { |info| info.name }.includes?("bio")
assert !M01Author.database_indexes.or_panic.nil?
assert M01Membership.database_foreign_keys.or_panic.first.to_table == "m01_authors"
::Test::SchemaFixture.drop_in_place
