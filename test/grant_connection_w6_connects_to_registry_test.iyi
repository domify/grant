module test/grant_connection_w6_connects_to_registry_test

import grant/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/connection_handling::{ConnectionHandling, UnestablishedConnectionError}
import test/w6_c04_support::{W6C04}

pub class W6RegistryThing < Base
  table w6_registry_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: {writing: "w6_reg_writer", reading: "w6_reg_reader"}
end

pub class W6RegistryOtherThing < Base
  table w6_registry_things
  column id : Int64, primary: true
  column label : String?
  connects_to database: "w6_reg_missing_other"
end

W6_REG_DDL = -> { ["CREATE TABLE w6_registry_things (#{W6C04.id_column}, label TEXT)"] }

# it: declares connections without consulting the registry
assert !ConnectionRegistry.connection_exists?("w6_reg_writer", :writing)
assert ConnectionHandling.declared_models.includes?(W6RegistryThing.to_s)
assert W6RegistryThing.connection_names.map(&.first) == ["w6_reg_writer", "w6_reg_reader"]

# it: verifies one model against the registry on request and names what is missing
error = ConnectionRegistry.verify_strict(W6RegistryThing)
assert error.is_a?(UnestablishedConnectionError)
assert error.as(UnestablishedConnectionError).message.includes?("W6RegistryThing")
assert error.as(UnestablishedConnectionError).message.includes?("w6_reg_writer")
assert error.as(UnestablishedConnectionError).message.includes?("w6_reg_reader")

# it: verifies every declaring model at once and lists each
error = ConnectionRegistry.verify_all_strict
assert error.is_a?(UnestablishedConnectionError)
assert error.as(UnestablishedConnectionError).message.includes?("W6RegistryThing")
assert error.as(UnestablishedConnectionError).message.includes?("W6RegistryOtherThing")
assert error.as(UnestablishedConnectionError).message.includes?("w6_reg_missing_other")

# it: passes once the connections exist, without opening a pool
W6C04.provision("w6_reg_writer", W6_REG_DDL.call)
W6C04.provision("w6_reg_reader", W6_REG_DDL.call)
writer = W6C04.establish("w6_reg_writer", "w6_reg_writer", :writing)
reader = W6C04.establish("w6_reg_reader", "w6_reg_reader", :reading)
ConnectionRegistry.verify_strict(W6RegistryThing).or_panic
assert !writer.connected?
assert !reader.connected?

# it: routes the declared roles to their own databases
W6C04.exec("w6_reg_writer", "INSERT INTO w6_registry_things (label) VALUES ('writer row')")
W6C04.exec("w6_reg_reader", "INSERT INTO w6_registry_things (label) VALUES ('reader row')")
assert W6RegistryThing.connected_to(role: :writing) { W6RegistryThing.first_strict.or_panic.label } == "writer row"
assert W6RegistryThing.connected_to(role: :reading) { W6RegistryThing.first_strict.or_panic.label } == "reader row"

["w6_reg_writer", "w6_reg_reader"].each do |name|
  W6C04.remove(name, :writing)
  W6C04.remove(name, :reading)
end
W6C04.cleanup
