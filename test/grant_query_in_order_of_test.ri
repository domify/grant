module test/grant_query_in_order_of_test

import grant/base::{Base}
import grant/query/ordering::{OrderSupport}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections, CURRENT_ADAPTER}

pub class IoTicket < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table io_tickets
  column id : Int64, primary: true
  column status : String?
  column priority : Int64
end

private def reset : Nil
  IoTicket.clear.or_panic
  IoTicket.create_strict(status: "done", priority: 1_i64).or_panic
  IoTicket.create_strict(status: "open", priority: 2_i64).or_panic
  IoTicket.create_strict(status: "blocked", priority: 3_i64).or_panic
  IoTicket.create_strict(status: "open", priority: 4_i64).or_panic
  IoTicket.create_strict(status: nil, priority: 5_i64).or_panic
  nil
end

register_spec_connections
IoTicket.migrator.drop_and_create.or_panic

# it: orders by the position in the list and filters to the listed values
reset
result = IoTicket.in_order_of(:status, ["open", "done"]).order(:priority).select.or_panic
assert result.map(&.status) == ["open", "open", "done"]
assert result.map(&.priority) == [2_i64, 4_i64, 1_i64]

# it: filters by default (filter: true) with a bound IN list
reset
relation = IoTicket.in_order_of(:status, ["open", "done"])
assert relation.select.or_panic.size == 3
assert relation.raw_sql.includes?("IN (")
assert relation.raw_sql.includes?("CASE WHEN")

# it: keeps the other rows after the listed ones with filter: false
reset
result = IoTicket.in_order_of(:status, ["blocked", "done"], filter: false).order(:priority).select.or_panic
assert result.map(&.status).first(2) == ["blocked", "done"]
assert result.size == 5

# it: matches NULL for a nil member
reset
result = IoTicket.in_order_of(:status, [nil, "done"]).select.or_panic
assert result.map(&.status) == [nil, "done"]

# it: orders integers too, and takes the column as a string
reset
assert IoTicket.in_order_of("priority", [4_i64, 1_i64, 2_i64]).select.or_panic.map(&.priority) == [4_i64, 1_i64, 2_i64]

# it: composes with other ordering, in call order
reset
assert IoTicket.order(:priority).in_order_of(:status, ["open", "done"]).select.or_panic.map(&.priority) == [1_i64, 2_i64, 4_i64]
assert IoTicket.in_order_of(:status, ["open", "done"]).order(priority: :desc).select.or_panic.map(&.priority) == [4_i64, 2_i64, 1_i64]

# it: returns no rows for an empty list
reset
assert IoTicket.in_order_of(:status, [] of String).select.or_panic.empty?

# it: escapes quote characters in string values
reset
IoTicket.create_strict(status: "it's ; DROP TABLE io_tickets --", priority: 6_i64).or_panic
result = IoTicket.in_order_of(:status, ["it's ; DROP TABLE io_tickets --", "done"]).select.or_panic
assert result.map(&.priority) == [6_i64, 1_i64]
assert IoTicket.count.or_panic == 6_i64

# it: escapes a backslash in string values
reset
IoTicket.create_strict(status: "back\\slash", priority: 7_i64).or_panic
assert IoTicket.in_order_of(:status, ["back\\slash"]).select.or_panic.map(&.priority) == [7_i64]

# it: matches a backslash and quote value in the ORDER BY literal itself
reset
IoTicket.create_strict(status: "a\\'b", priority: 8_i64).or_panic
ordered = IoTicket.in_order_of(:status, ["a\\'b"], filter: false).order(:priority).select.or_panic
assert ordered.first.priority == 8_i64

# it: writes PostgreSQL string literals as E'' so backslashes never depend on server settings
reset
if CURRENT_ADAPTER == "pg"
  assert IoTicket.in_order_of(:status, ["x\\y"]).raw_sql.includes?("E'x\\\\y'")
else
  assert !IoTicket.in_order_of(:status, ["x\\y"]).raw_sql.includes?("E'")
end

# it: caps the list size
reset
values = Array.new(OrderSupport::IN_ORDER_OF_LIMIT + 1) { |index| "v#{index}" }
error = IoTicket.in_order_of(:status, values).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("at most 1000 values")
assert IoTicket.in_order_of(:status, values.first(OrderSupport::IN_ORDER_OF_LIMIT)).select.or_panic.empty?

# it: rejects a column that is not a name
reset
error = IoTicket.in_order_of("status; --", ["open"]).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("takes a column name")

# it: reverses with the rest of the order
reset
assert IoTicket.in_order_of(:status, ["open", "done"]).order(:priority).reverse_order.select.or_panic.map(&.priority) == [1_i64, 4_i64, 2_i64]

# it: does not change the receiver
reset
base = IoTicket.where(priority: 2_i64)
base.in_order_of(:status, ["open"])
assert base.order_fields.empty?
assert base.where_fields.size == 1

# it: has a bang form
reset
relation = IoTicket.all
relation.in_order_of_in_place(:status, ["open"])
assert relation.order_fields.size == 1

IoTicket.adapter.close.or_panic
