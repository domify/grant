module test/grant_perf_w6_primary_key_lookup_test
import grant/base::{Base}
import grant/query_cache
import grant/query_logs
import test/spec_helper::{register_spec_connections}

pub class W6LookupPlain < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_plains
  column id : Int64, primary: true
  column label : String
end

register_spec_connections
W6LookupPlain.migrator.drop_and_create.or_panic

# it: is served from the query cache like any relation read
W6LookupPlain.clear.or_panic
plain = W6LookupPlain.create_strict(label: "cached").or_panic
::Grant::QueryCache.cache do
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "cached"
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "cached"
  assert ::Grant::QueryCache.current?.as(::Grant::QueryCache::State).hits == 1
end

# it: tags the statement when query logs are on, as the relation does
W6LookupPlain.clear.or_panic
plain = W6LookupPlain.create_strict(label: "tagged").or_panic
W6LookupPlain.find(plain.id).or_panic
previously_enabled = ::Grant::QueryLogs.enabled?
::Grant::QueryLogs.enabled = true
::Grant::QueryLogs.with_context(request: "find") do
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "tagged"
end
::Grant::QueryLogs.enabled = previously_enabled

# Observe the SQL at the real driver boundary as well as its returned row.
statements = [] of String
connection = W6LookupPlain.__connection
previous_observer = connection.query_observer
connection.query_observer = ->(sql : String) { statements << sql; nil }
::Grant::QueryLogs.enabled = true
::Grant::QueryLogs.with_context(request: "find") do
  W6LookupPlain.find(plain.id).or_panic
end
::Grant::QueryLogs.enabled = previously_enabled
connection.query_observer = previous_observer
assert statements.size == 1
assert statements.first.ends_with?("/*request:find*/")
assert ::Grant::QueryLogs.context.empty?
assert ::Grant::QueryCache.current?.nil?
# Bind values distinguish reads, and a write invalidates earlier snapshots.
other = W6LookupPlain.create_strict(label: "other").or_panic
::Grant::QueryCache.cache do
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "tagged"
  assert W6LookupPlain.find(other.id).or_panic.as(W6LookupPlain).label == "other"
  loaded = W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain)
  loaded.label = "local only"
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "tagged"
  plain.label = "updated"
  plain.save_strict.or_panic
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "updated"
  before = ::Grant::QueryCache.current?.as(::Grant::QueryCache::State).hits
  ::Grant::QueryCache.uncached { W6LookupPlain.find(plain.id).or_panic }
  assert ::Grant::QueryCache.current?.as(::Grant::QueryCache::State).hits == before
  ::Grant::QueryCache.cache { W6LookupPlain.find(plain.id).or_panic }
  assert ::Grant::QueryCache.enabled?
end
assert ::Grant::QueryCache.current?.nil?
W6LookupPlain.migrator.drop.or_panic
