module test/grant_associations_has_many_foreign_key_forms_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

pub class FkFormOwner < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table fk_form_owners
  column id : Int64, primary: true
  column label : String
  has_many :symbol_children, class_name: FkFormChild, foreign_key: :fk_form_owner_id
  has_many :bare_children, class_name: FkFormChild, foreign_key: fk_form_owner_id
end

pub class FkFormChild < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table fk_form_children
  column id : Int64, primary: true
  column fk_form_owner_id : Int64?
  column label : String
end

register_spec_connections
FkFormOwner.migrator.drop_and_create.or_panic
FkFormChild.migrator.drop_and_create.or_panic
FkFormChild.clear.or_panic
FkFormOwner.clear.or_panic

# it: reads and writes through a Symbol and a bare foreign key alike
owner = FkFormOwner.create_strict(label: "owner").or_panic
other = FkFormOwner.create_strict(label: "other").or_panic
FkFormChild.create_strict(label: "theirs", fk_form_owner_id: other.id).or_panic

owner.symbol_children.create_strict(label: "by symbol").or_panic
owner.bare_children.create_strict(label: "by bare name").or_panic

assert owner.symbol_children.map { |child| child.label.as(String) }.or_panic.sorted == ["by bare name", "by symbol"]
assert owner.bare_children.map { |child| child.label.as(String) }.or_panic.sorted == ["by bare name", "by symbol"]

FkFormOwner.adapter.close.or_panic
