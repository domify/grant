module test/grant_associations_has_many_through_test
import grant/base::{Base}
import grant/querying::{NotFound}
import test/spec_helper::{register_spec_connections}

pub class ThroughStudent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_students

  column id : Int64, primary: true
  column name : String?

  has_many :through_enrollments, class_name: ThroughEnrollment, foreign_key: :through_student_id
  has_many :through_klasses, class_name: ThroughKlass, through: :through_enrollments, foreign_key: :through_student_id
end

pub class ThroughKlass < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_klasses

  column id : Int64, primary: true
  column name : String?

  has_many :through_enrollments, class_name: ThroughEnrollment, foreign_key: :through_klass_id
  has_many :through_students, class_name: ThroughStudent, through: :through_enrollments, foreign_key: :through_klass_id
end

pub class ThroughEnrollment < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table through_enrollments

  column id : Int64, primary: true
  column through_student_id : Int64?
  column through_klass_id : Int64?

  belongs_to :through_student, optional: true
  belongs_to :through_klass, optional: true
end

register_spec_connections
ThroughStudent.migrator.drop_and_create.or_panic
ThroughKlass.migrator.drop_and_create.or_panic
ThroughEnrollment.migrator.drop_and_create.or_panic

# it: provides a method to retrieve associated objects through another table
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

unrelated_student = ThroughStudent.new
unrelated_student.name = "other student"
assert unrelated_student.save

klass1 = ThroughKlass.new
klass1.name = "Test class"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass2.id
enrollment3.through_student_id = unrelated_student.id
assert enrollment3.save

assert student.through_klasses.compact_map { |record| record.id }.or_panic.sorted == [klass1.id, klass2.id].compact.sorted

assert klass2.through_students.compact_map { |record| record.id }.or_panic.sorted == [student.id, unrelated_student.id].compact.sorted

# it: #all
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

klass1 = ThroughKlass.new
klass1.name = "Test class X"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class X"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class with different name"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass3.id
enrollment3.through_student_id = student.id
assert enrollment3.save

klasses = student.through_klasses.all("AND through_klasses.name = ? ORDER BY through_klasses.id DESC", ["Test class X"]).or_panic
assert klasses.map(&.id) == [klass2.id, klass1.id]

# it: #find_by
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

klass1 = ThroughKlass.new
klass1.name = "Test class X"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class X"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class with different name"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass3.id
enrollment3.through_student_id = student.id
assert enrollment3.save

klass = student.through_klasses.find_by(name: "Test class with different name").or_panic
if klass
  assert klass.id == klass3.id
  assert klass.name == "Test class with different name"
else
  assert !klass.nil?
end

# it: #find_by!
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

klass1 = ThroughKlass.new
klass1.name = "Test class X"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class X"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class with different name"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass3.id
enrollment3.through_student_id = student.id
assert enrollment3.save

klass = student.through_klasses.find_by_strict(name: "Test class with different name").or_panic
assert klass.id == klass3.id
assert klass.name == "Test class with different name"

error = student.through_klasses.find_by_strict(name: "not_found")
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{ThroughKlass} found where name = not_found"

# it: #find
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

klass1 = ThroughKlass.new
klass1.name = "Test class X"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class X"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class with different name"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass3.id
enrollment3.through_student_id = student.id
assert enrollment3.save

klass = student.through_klasses.find(klass1.id).or_panic
if klass
  assert klass.id == klass1.id
  assert klass.name == "Test class X"
else
  assert !klass.nil?
end

# it: #find!
ThroughEnrollment.clear.or_panic
ThroughKlass.clear.or_panic
ThroughStudent.clear.or_panic
student = ThroughStudent.new
student.name = "test student"
assert student.save

klass1 = ThroughKlass.new
klass1.name = "Test class X"
assert klass1.save

klass2 = ThroughKlass.new
klass2.name = "Test class X"
assert klass2.save

klass3 = ThroughKlass.new
klass3.name = "Test class with different name"
assert klass3.save

enrollment1 = ThroughEnrollment.new
enrollment1.through_student_id = student.id
enrollment1.through_klass_id = klass1.id
assert enrollment1.save

enrollment2 = ThroughEnrollment.new
enrollment2.through_student_id = student.id
enrollment2.through_klass_id = klass2.id
assert enrollment2.save

enrollment3 = ThroughEnrollment.new
enrollment3.through_klass_id = klass3.id
enrollment3.through_student_id = student.id
assert enrollment3.save

klass = student.through_klasses.find_strict(klass1.id).or_panic
assert klass.id == klass1.id
assert klass.name == "Test class X"

id = klass3.id.as(Int64) + 42

error = student.through_klasses.find_strict(id)
assert error.is_a?(NotFound)
assert error.as(NotFound).message == "No #{ThroughKlass} found where id = #{id}"

ThroughStudent.adapter.close.or_panic
