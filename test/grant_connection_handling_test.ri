module test/grant_connection_handling_test
import grant/base::{Base}
import grant/adapter/base
import std/time
import test/spec_helper::{register_spec_connections}
register_spec_connections

# Test models defined at top level
pub class TestConnectionModel < Base
  table test_models
  column id : Int64, primary: true
  column name : String

  connects_to(
    database: "test_db",
    config: {
      writing: "postgres://writer@localhost/test_db",
      reading: "postgres://reader@localhost/test_db",
    }
  )
end

pub class ShardedModel < Base
  table sharded_models
  column id : Int64, primary: true
  column name : String

  connects_to(
    shards: {
      shard_one: {
        writing: "postgres://shard1_writer@localhost/db1",
        reading: "postgres://shard1_reader@localhost/db1",
      },
      shard_two: {
        writing: "postgres://shard2_writer@localhost/db2",
        reading: "postgres://shard2_reader@localhost/db2",
      },
    }
  )
end

pub class ContextModel < Base
  table context_models
  column id : Int64, primary: true

  connects_to(
    database: "main_db",
    config: {
      writing: "postgres://writer@localhost/main",
      reading: "postgres://reader@localhost/main",
    }
  )
end

pub class WriteProtectedModel < Base
  table protected_models
  column id : Int64, primary: true
  column name : String
end

pub class MultiDbModel < Base
  table multi_db_models
  column id : Int64, primary: true

  connects_to(database: "primary")
end

pub class ReadWriteModel < Base
  table rw_models
  column id : Int64, primary: true
  column name : String

  connects_to(
    config: {
      writing: "postgres://writer@localhost/test",
      reading: "postgres://reader@localhost/test",
    }
  )
end

# Now define the actual tests
# it: configures database connections with roles
assert TestConnectionModel.database_name == "test_db"
assert TestConnectionModel.connection_config[:writing] == "postgres://writer@localhost/test_db"
assert TestConnectionModel.connection_config[:reading] == "postgres://reader@localhost/test_db"

# it: supports sharded configurations
assert !ShardedModel.shard_config.nil?
assert ShardedModel.shard_config[:shard_one][:writing] == "postgres://shard1_writer@localhost/db1"
assert ShardedModel.shard_config[:shard_two][:reading] == "postgres://shard2_reader@localhost/db2"

# it: switches connection context for a block
# With no recent writes, automatic read/write splitting selects the
# reader. The temporary context should still be isolated and restored.
assert ContextModel.connection_context.nil?
assert ContextModel.current_role == :reading

# Switch to reading role
ContextModel.connected_to(role: :reading) do
  assert ContextModel.current_role == :reading
  assert ContextModel.connection_context.as(::Grant::ConnectionContext::ConnectionContext).role == :reading
end

assert ContextModel.connection_context.nil?
assert ContextModel.current_role == :reading

# it: prevents writes when specified
assert !WriteProtectedModel.preventing_writes?

WriteProtectedModel.while_preventing_writes do
  assert WriteProtectedModel.preventing_writes?
end

assert !WriteProtectedModel.preventing_writes?

# it: switches to different database
assert MultiDbModel.current_database == "primary"

MultiDbModel.connected_to(database: "secondary") do
  assert MultiDbModel.current_database == "secondary"
end

assert MultiDbModel.current_database == "primary"

# it: uses the reader for queries after the post-write delay
original_wait_period = ::Grant::Connections::Connections.connection_switch_wait_period
ReadWriteModel.connection_switch_wait_period = 100

  # After a write, should use writer
  ReadWriteModel.mark_write_operation
  assert ReadWriteModel.current_role == :primary

  # Wait for delay
  sleep(200).or_panic

  # The model has a reading role configured, so reads may use it after the
  # quiet period has elapsed.
  assert ReadWriteModel.current_role == :reading
  ReadWriteModel.connection_switch_wait_period = original_wait_period
