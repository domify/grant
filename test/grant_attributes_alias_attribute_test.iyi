module test/grant_attributes_alias_attribute_test
import test/attribute_spec_models::{AttrPost}
import test/spec_helper::{register_spec_connections}
import grant/base::{Base}
import grant/sti

pub class AttrAliasRoot < Base
  ::Grant::Sti.enable
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table attr_alias_roots
  column id : Int64, primary: true
  column type : String
  column title : String?
  column views : Int32?
  alias_attribute :headline, :title
  alias_attribute :hits, :views
end

pub class AttrAliasChild < AttrAliasRoot
end

# Native Hash inherits identity equality; compare every key and value instead.
pub def same_aliases?(actual : Hash(String, String), expected : Hash(String, String)) : Bool
  return false unless actual.size == expected.size
  expected.each { |key, value| return false unless actual[key]? == value }
  true
end

register_spec_connections
AttrPost.migrator.drop_and_create.or_panic
AttrAliasRoot.migrator.drop_and_create.or_panic

# it: generates the getter, setter and helpers
AttrPost.clear.or_panic
post = AttrPost.create_strict(title: "Original").or_panic
assert post.name == "Original"
assert post.name? == "Original"
post.name = "Renamed"
assert post.title == "Renamed"
assert post.name_changed?
assert post.name_was == "Original"
assert post.name_change == {"Original", "Renamed"}
assert post.name_before_type_cast == "Renamed"

# it: is accepted by new and resolved by [] / has_attribute?
AttrPost.clear.or_panic
post = AttrPost.new(name: "Via new")
assert post.title == "Via new"
assert post["name"] == "Via new"
assert AttrPost.has_column?("name")
assert same_aliases?(AttrPost.attribute_aliases, {"name" => "title"})

# it: is resolved in where(**args) and hash conditions
AttrPost.clear.or_panic
AttrPost.create_strict(title: "a").or_panic
AttrPost.create_strict(title: "b").or_panic
assert AttrPost.where(name: "a").select.or_panic.map(&.title) == ["a"]
assert AttrPost.where({name: "b"}).select.or_panic.map(&.title) == ["b"]
assert AttrPost.where(name: ["a", "b"]).count.or_panic == 2
assert AttrPost.where(title: "a").where(name: "b").count.or_panic == 0

# it: is resolved in the hash forms of and and or
AttrPost.clear.or_panic
AttrPost.create_strict(title: "a").or_panic
AttrPost.create_strict(title: "b").or_panic
assert AttrPost.where(title: "a").or_where(name: "b").count.or_panic == 2
assert AttrPost.where(title: "a").and_where(name: "b").count.or_panic == 0

# it: keeps several aliases and resolves them on STI subclasses
AttrPost.clear.or_panic
AttrAliasRoot.clear.or_panic
assert same_aliases?(AttrAliasRoot.attribute_aliases, {"headline" => "title", "hits" => "views"})
child = AttrAliasChild.create_strict(headline: "x", hits: 3).or_panic
assert child.title == "x"
assert child.views == 3
assert AttrAliasChild.where(headline: "x", hits: 3).count.or_panic == 1
assert AttrAliasChild.has_column?("hits")

AttrPost.adapter.close.or_panic
