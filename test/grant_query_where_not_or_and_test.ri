module test/grant_query_where_not_or_and_test
import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/error::{ArgumentError}
import test/spec_helper::{register_spec_connections}

pub class WfAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_authors
  column id : Int64, primary: true
  column name : String?
  column active : Bool?
  has_many :posts, class_name: WfPost, foreign_key: author_id
end

pub class WfPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table wf_posts
  column id : Int64, primary: true
  column title : String?
  column published : Bool?
  column score : Int32?
  belongs_to author : WfAuthor, foreign_key: author_id : Int64?, optional: true
end

def titles(relation : Builder(WfPost)) : Array(String)
  relation.order(:id).select.or_panic.map(&.title.to_s)
end

def reset : Nil
  WfPost.clear.or_panic
  WfAuthor.clear.or_panic
  WfPost.create_strict(title: "a", published: true, score: 1).or_panic
  WfPost.create_strict(title: "b", published: false, score: 2).or_panic
  WfPost.create_strict(title: "c", published: true, score: 3).or_panic
  WfPost.create_strict(title: "d", published: true, score: nil).or_panic
  nil
end

register_spec_connections
WfAuthor.migrator.drop_and_create.or_panic
WfPost.migrator.drop_and_create.or_panic

# it: qualifies own columns so a later joins cannot make them ambiguous
reset
ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
first = WfPost.create_strict(title: "e", author_id: ann.id).or_panic
second = WfPost.create_strict(title: "f", author_id: ann.id).or_panic
assert titles(WfPost.where(id: first.id).or_where(WfPost.where(id: second.id)).joins(:author)) == ["e", "f"]
assert titles(WfPost.where(id: first.id).invert_where.joins(:author)) == ["f"]

# it: accepts a joined table's columns before the joins call
reset
ann = WfAuthor.create_strict(name: "ann", active: true).or_panic
bob = WfAuthor.create_strict(name: "bob", active: false).or_panic
WfPost.create_strict(title: "e", author_id: ann.id).or_panic
WfPost.create_strict(title: "f", author_id: bob.id).or_panic
assert titles(WfPost.where.not(wf_authors: {name: "bob"}).joins(:author)) == ["e"]
assert titles(WfPost.where(author: {name: "ann"}).or_where(WfPost.where(author: {name: "bob"})).joins(:author)) == ["e", "f"]

# it: still rejects an unknown column on a joined table
reset
error = WfPost.where.not(wf_authors: {secret: "x"}).joins(:author).select
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("Unknown query field")

WfPost.adapter.close.or_panic
