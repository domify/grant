module test/grant_columns_w6b_bigdecimal_column_test

import grant/base::{Base}
import std/big::{BigDecimal}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class W6bPriceRow < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_price_rows
  column id : Int64, primary: true
  column label : String?
  column price : BigDecimal, precision: 12, scale: 2
  column discount : BigDecimal?, precision: 5, scale: 2
  column ratio : BigDecimal?
end

private def prepare_records : Nil
  W6bPriceRow.migrator.drop_and_create.or_panic
  nil
end

register_spec_connections

# it: maps precision and scale to the decimal type of the dialect
prepare_records
sql = W6bPriceRow.migrator.create_sql
if CURRENT_ADAPTER == "mysql"
  assert sql.includes?("`price` DECIMAL(12, 2) NOT NULL")
  assert sql.includes?("`discount` DECIMAL(5, 2)")
  assert sql.includes?("`ratio` DECIMAL")
else
  assert sql.includes?("\"price\" NUMERIC(12, 2) NOT NULL")
  assert sql.includes?("\"discount\" NUMERIC(5, 2)\n")
  assert sql.includes?("\"ratio\" NUMERIC\n")
end

# it: round trips values without losing digits
prepare_records
row = W6bPriceRow.create_strict(label: "a", price: BigDecimal.new("12345678.91"), discount: BigDecimal.new("0.50")).or_panic
found = W6bPriceRow.find_strict(row.id).or_panic
assert found.price == BigDecimal.new("12345678.91")
assert found.price.is_a?(BigDecimal)
assert found.discount == BigDecimal.new("0.5")
assert found.ratio.nil?

# it: rounds to the declared scale on assignment, as on every adapter
prepare_records
row = W6bPriceRow.new(price: BigDecimal.new("1.005"))
assert row.price == BigDecimal.new("1.01")
row.price = BigDecimal.new("2.994")
assert row.price == BigDecimal.new("2.99")
row.save_strict.or_panic
assert W6bPriceRow.find_strict(row.id).or_panic.price == BigDecimal.new("2.99")

# it: accepts a numeric string in mass assignment
prepare_records
row = W6bPriceRow.new(price: "19.99")
assert row.price == BigDecimal.new("19.99")

# it: is queryable by equality, comparison, IN, find_by and sum
prepare_records
W6bPriceRow.create_strict(label: "a", price: BigDecimal.new("10.10")).or_panic
W6bPriceRow.create_strict(label: "b", price: BigDecimal.new("19.99")).or_panic
W6bPriceRow.create_strict(label: "c", price: BigDecimal.new("30.00")).or_panic
assert W6bPriceRow.where(price: BigDecimal.new("19.99")).map(&.label).or_panic == ["b"]
assert W6bPriceRow.where(price: [BigDecimal.new("10.10"), BigDecimal.new("30.00")]).order(:label).map(&.label).or_panic == ["a", "c"]
assert W6bPriceRow.where("price > ?", BigDecimal.new("15.5")).order(:label).map(&.label).or_panic == ["b", "c"]
assert W6bPriceRow.where(:price, :gt, BigDecimal.new("15.5")).count.or_panic == 2
assert W6bPriceRow.order(price: :desc).first_strict.or_panic.label == "c"
assert W6bPriceRow.sum(:price).or_panic == BigDecimal.new("60.09")
assert W6bPriceRow.where(price: BigDecimal.new("19.99")).exists?.or_panic
assert !W6bPriceRow.where(price: BigDecimal.new("19.98")).exists?.or_panic
assert W6bPriceRow.find_by(price: BigDecimal.new("30")).or_panic.as(W6bPriceRow).label == "c"

# it: tracks changes and updates
prepare_records
row = W6bPriceRow.create_strict(price: BigDecimal.new("1.00")).or_panic
assert !row.price_changed?
row.price = BigDecimal.new("1.50")
assert row.price_changed?
row.save_strict.or_panic
assert W6bPriceRow.find_strict(row.id).or_panic.price == BigDecimal.new("1.5")
row.update_strict(price: BigDecimal.new("3.25")).or_panic
assert row.reload.or_panic.price == BigDecimal.new("3.25")

# it: stores nil in a nilable column
prepare_records
ratio = BigDecimal.new(CURRENT_ADAPTER == "mysql" ? "42" : "0.333333333333")
row = W6bPriceRow.create_strict(price: BigDecimal.new("1"), ratio: ratio).or_panic
assert W6bPriceRow.find_strict(row.id).or_panic.ratio == ratio
row.update_strict(ratio: nil).or_panic
assert W6bPriceRow.find_strict(row.id).or_panic.ratio.nil?
W6bPriceRow.migrator.drop.or_panic
