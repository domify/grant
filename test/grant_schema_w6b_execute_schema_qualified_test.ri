module test/grant_schema_w6b_execute_schema_qualified_test
import grant/schema/migration::{Migration}
import grant/schema/migration_context::{MigrationContext}
import grant/error::{ErrorBase}
import test/m03_fixture
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections, restore_default_spec_connections}
pub NS = "w6b_qual_ns"
private def scalar(sql : String) : Int64 | ErrorBase | Cancelled
  ::Test::M03Fixture.adapter.open { |db| db.scalar(sql)!.as(Int64) }
end
private def index_count(name : String) : String
  if CURRENT_ADAPTER == "pg"
    "SELECT COUNT(*) FROM pg_indexes WHERE schemaname = '#{NS}' AND indexname = '#{name}'"
  else
    "SELECT COUNT(*) FROM #{NS}.sqlite_master WHERE type = 'index' AND name = '#{name}'"
  end
end
private def reset : Nil
  ::Test::M03Fixture.reset_in_place
  adapter = ::Test::M03Fixture.adapter
  if CURRENT_ADAPTER == "pg"
    adapter.open { |db| db.exec("DROP SCHEMA IF EXISTS #{NS} CASCADE").or_panic; db.exec("CREATE SCHEMA #{NS}") }.or_panic
  end
  adapter.reset_schema_caches_in_place
end
private def scoped(&block : -> T) : T forall T
  ::Test::M03Fixture.adapter.with_connection do |connection|
    connection.exec("ATTACH DATABASE ':memory:' AS #{NS}").or_panic if CURRENT_ADAPTER == "sqlite"
    defer detach(connection)
    yield
  end.or_panic
end
private def detach(connection) : Nil
  connection.exec("DETACH DATABASE #{NS}").or_panic if CURRENT_ADAPTER == "sqlite"
end
pub class W6bQualifiedCreate < Migration
  migration_version 20250101000001

  def up : Nil | ErrorBase | Cancelled
    create_table("#{NS}.w6b_items") do |t|
      t.string(:label, null: false, default: "none")!
      t.integer(:qty, default: 0)!
      t.index(:label)!
    end!
    add_column("#{NS}.w6b_items", :note, :string)!
    add_index("#{NS}.w6b_items", :qty, name: "w6b_items_qty_idx")!
    add_timestamps("#{NS}.w6b_items", null: true)!
    execute("INSERT INTO #{NS}.w6b_items (label, qty) VALUES ('first', 1)")!
  end

  def down : Nil | ErrorBase | Cancelled
    drop_table("#{NS}.w6b_items")!
  end
end

pub class W6bQualifiedAlter < Migration
  migration_version 20250101000002

  def up : Nil | ErrorBase | Cancelled
    rename_column("#{NS}.w6b_items", :note, :remark)!
    remove_index("#{NS}.w6b_items", name: "w6b_items_qty_idx")!
    remove_timestamps("#{NS}.w6b_items")!
    remove_column("#{NS}.w6b_items", :remark)!
    rename_table("#{NS}.w6b_items", "#{NS}.w6b_things")!
  end

  def down : Nil | ErrorBase | Cancelled
    drop_table("#{NS}.w6b_things")!
  end
end

pub class W6bQualifiedJoin < Migration
  migration_version 20250101000003

  def up : Nil | ErrorBase | Cancelled
    create_join_table("#{NS}.w6b_left", "#{NS}.w6b_right",
      table_name: "#{NS}.w6b_left_w6b_right")!
  end

  def down : Nil | ErrorBase | Cancelled
    drop_table("#{NS}.w6b_left_w6b_right")!
  end
end


register_spec_connections
restore_default_spec_connections
adapter = ::Test::M03Fixture.adapter
# it: creates, extends, indexes and fills a qualified table through the runner
reset
scoped do
  MigrationContext.for(adapter, W6bQualifiedCreate, verbose: false).migrate.or_panic
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_items").or_panic == 1
  assert scalar("SELECT qty FROM #{NS}.w6b_items WHERE label = 'first'").or_panic == 1
  adapter.open { |db| db.exec("UPDATE #{NS}.w6b_items SET note = 'n', created_at = NULL, updated_at = NULL") }.or_panic
  adapter.open { |db| db.exec("INSERT INTO #{NS}.w6b_items DEFAULT VALUES") }.or_panic
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_items WHERE label = 'none'").or_panic == 1
  assert scalar(index_count("w6b_items_qty_idx")).or_panic == 1
end
# it: renames, drops columns and indexes, renames the table and drops it
reset
scoped do
  context = MigrationContext.for(adapter, W6bQualifiedCreate, W6bQualifiedAlter, verbose: false)
  context.migrate(20250101000001_i64).or_panic
  context.migrate(20250101000002_i64).or_panic
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_things").or_panic == 1
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_items").is_a?(ErrorBase)
  assert scalar("SELECT COUNT(remark) FROM #{NS}.w6b_things").is_a?(ErrorBase)
  assert scalar(index_count("w6b_items_qty_idx")).or_panic == 0
  context.rollback.or_panic
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_things").is_a?(ErrorBase)
end
# it: creates a qualified join table
reset
scoped do
  MigrationContext.for(adapter, W6bQualifiedJoin, verbose: false).migrate.or_panic
  assert scalar("SELECT COUNT(*) FROM #{NS}.w6b_left_w6b_right").or_panic == 0
  MigrationContext.for(adapter, W6bQualifiedJoin, verbose: false).rollback.or_panic
end
# it: keeps the unqualified table of the same name apart from the qualified one
reset
scoped do
  MigrationContext.for(adapter, W6bQualifiedCreate, verbose: false).migrate.or_panic
  assert !::Test::M03Fixture.table?("w6b_items")
end
::Test::M03Fixture.reset_in_place
if CURRENT_ADAPTER == "pg"
  adapter.open { |db| db.exec("DROP SCHEMA IF EXISTS #{NS} CASCADE") }.or_panic
end
