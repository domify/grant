module test/grant_test_fixtures_test

import grant/base::{Base}
import grant/test_fixtures
import grant/test_fixtures::{identify, identify_uuid, load}
import grant/spec::{within_transaction}
import grant/errors::{RecordNotFound}
import grant/events::{SQL}
import grant/notifications
import std/digest::{CRC32}
import std/regex
import std/text
import std/dir::{Dir}
import std/file
import test/spec_helper::{register_spec_connections}

pub class FxAuthor < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table fx_authors
  column id : Int64, primary: true
  column email : String
  column admin : Bool?
  timestamps
end

pub class FxPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table fx_posts
  column id : Int64, primary: true
  column title : String
  belongs_to author : FxAuthor
  timestamps
end

::Grant::TestFixtures.fixtures fx_authors: ::Test::GrantTestFixturesTest::FxAuthor, fx_posts: ::Test::GrantTestFixturesTest::FxPost

FIXTURE_DIR = "build/tmp/grant_fixtures_spec"

private def write_fixtures : Nil
  Dir.mkdir_p(FIXTURE_DIR)
  File.write("#{FIXTURE_DIR}/fx_authors.yml", "DEFAULTS: &defaults\n  admin: false\nalice:\n  <<: *defaults\n  email: alice@example.com\n  admin: true\nbob:\n  <<: *defaults\n  email: bob@example.com\ncara:\n  email: cara@example.com\n  id: 4242\n")
  File.write("#{FIXTURE_DIR}/fx_posts.yml", "hello:\n  title: Hello\n  author: alice\nsecond:\n  title: Second\n  author: bob\n")
  nil
end

private def clear_fixtures : Nil
  FxPost.clear.or_panic
  FxAuthor.clear.or_panic
  nil
end

private def statements(&block : -> T) : Array(String) forall T
  captured = [] of String
  subscription = ::Grant::Notifications.subscribe(SQL) do |event|
    captured << event.sql
    nil
  end
  yield
  subscription.unsubscribe
  captured
end

private def statement_count(statements : Array(String), prefix : String, table : String) : Int32
  statements.count { |sql| sql.starts_with?(prefix) && sql.includes?(table) }
end

register_spec_connections
FxAuthor.migrator.drop_and_create.or_panic
FxPost.migrator.drop_and_create.or_panic
write_fixtures

# it: hashes the label to a stable id below MAX_ID
clear_fixtures
assert identify(:alice) == CRC32.checksum("alice").to_i64 % ::Grant::TestFixtures::MAX_ID
assert identify("alice") == identify(:alice)
assert identify(:alice) != identify(:bob)
assert identify("anything at all") < ::Grant::TestFixtures::MAX_ID

# it: derives a stable v5 UUID
clear_fixtures
assert identify_uuid(:alice) == identify_uuid("alice")
assert identify_uuid(:alice).version == 5
assert identify_uuid(:alice).to_s == "60385b21-3a16-5fa2-9175-5af2b4adafa7"

# it: inserts the labeled rows with hashed ids and fills the timestamps
clear_fixtures
load(FIXTURE_DIR).or_panic
assert FxAuthor.count.or_panic == 3
alice = FxAuthor.find_strict(identify(:alice)).or_panic
assert alice.email == "alice@example.com"
assert alice.admin == true
assert !alice.created_at.nil?
assert !alice.updated_at.nil?
assert FxAuthor.find_strict(identify(:bob)).or_panic.admin == false

# it: keeps an explicit id
clear_fixtures
load(FIXTURE_DIR).or_panic
assert FxAuthor.find_strict(4242).or_panic.email == "cara@example.com"
assert FxAuthor.find(identify(:cara)).or_panic.nil?

# it: resolves a belongs_to label to the foreign key
clear_fixtures
load(FIXTURE_DIR).or_panic
assert FxPost.find_strict(identify(:hello)).or_panic.author_id == identify(:alice)
assert FxPost.find_strict(identify(:second)).or_panic.author_id == identify(:bob)

# it: runs one bulk INSERT per table
clear_fixtures
captured = statements { load(FIXTURE_DIR).or_panic }
assert statement_count(captured, "INSERT INTO", "fx_authors") == 1
assert statement_count(captured, "INSERT INTO", "fx_posts") == 1
authors_insert = captured.find { |sql| sql.starts_with?("INSERT INTO") && sql.includes?("fx_authors") }.as(String)
assert /\(\s*[$?]/.scan(authors_insert).size == 3

# it: replaces existing rows so a second load leaves the same data
clear_fixtures
FxAuthor.create_strict(email: "stale@example.com").or_panic
load(FIXTURE_DIR).or_panic
load(FIXTURE_DIR).or_panic
assert FxAuthor.count.or_panic == 3
assert FxAuthor.where(email: "stale@example.com").count.or_panic == 0

# it: loads only the named sets
clear_fixtures
load(FIXTURE_DIR, only: ["fx_authors"]).or_panic
assert FxAuthor.count.or_panic == 3
assert FxPost.count.or_panic == 0

# it: raises Error for a set without a file
clear_fixtures
error = load("#{FIXTURE_DIR}/nowhere")
assert error.is_a?(::Grant::TestFixtures::Error)
assert error.as(::Grant::TestFixtures::Error).message.includes?("not found")

# it: return the record for a symbol or string label
clear_fixtures
load(FIXTURE_DIR).or_panic
assert fx_authors(:alice).or_panic.email == "alice@example.com"
assert fx_authors("bob").or_panic.email == "bob@example.com"
assert fx_posts(:hello).or_panic.author.or_panic.as(FxAuthor).email == "alice@example.com"

# it: raise RecordNotFound for an undefined label
clear_fixtures
load(FIXTURE_DIR).or_panic
assert fx_authors(:nobody).is_a?(RecordNotFound)

# it: leaves no rows behind when loaded inside the wrapper
clear_fixtures
within_transaction do
  load(FIXTURE_DIR).or_panic
  assert FxAuthor.count.or_panic == 3
  assert fx_authors(:alice).or_panic.email == "alice@example.com"
end.or_panic
assert FxAuthor.count.or_panic == 0
assert FxPost.count.or_panic == 0

# it: lets an example change loaded rows without affecting the next one
clear_fixtures
load(FIXTURE_DIR).or_panic
within_transaction do
  fx_authors(:alice).or_panic.update_strict(email: "changed@example.com").or_panic
  assert FxAuthor.find_strict(identify(:alice)).or_panic.email == "changed@example.com"
end.or_panic
assert fx_authors(:alice).or_panic.email == "alice@example.com"

FxPost.migrator.drop.or_panic
FxAuthor.migrator.drop.or_panic
File.delete("#{FIXTURE_DIR}/fx_authors.yml")
File.delete("#{FIXTURE_DIR}/fx_posts.yml")
Dir.delete(FIXTURE_DIR)
