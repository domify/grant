module test/grant_callbacks_run_callbacks_test
import grant/base::{Base}
import test/spec_helper::{register_spec_connections}

  pub class RunCallbacksModel < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table run_callbacks_models

    column id : Int64, primary: true
    column name : String?

    property log : Array(String) = [] of String
    property gate : Bool = true

    before_save { log << "before_save" }
    after_save { log << "after_save" }
    after_touch { log << "after_touch" }
    before_destroy { log << "before_destroy" }
    after_destroy { log << "after_destroy" }

    around_save :maybe_gate

    def wrap_save(&block : -> Int32 | ::Grant::Error::ErrorBase) : Int32 | Nil | ::Grant::Error::ErrorBase
      run_callbacks(:save) { block.call }
    end

    def wrap_destroy(&block : -> Nil)
      run_callbacks(:destroy) { block.call }
    end

    def bare_touch : Bool | ::Grant::Error::ErrorBase
      run_callbacks(:touch)
    end

    def bare_save : Bool | ::Grant::Error::ErrorBase
      run_callbacks(:save)
    end

    def wrap_event(event : Symbol, &block : -> String) : String | Nil | ::Grant::Error::ErrorBase
      run_callbacks(event) { block.call }
    end

    private def maybe_gate(block : Proc(Nil))
      log << "around_in"
      block.call if gate
      log << "around_out"
    end
  end

register_spec_connections
RunCallbacksModel.migrator.drop_and_create.or_panic

# it: runs the block between the before and after chains inside the around chain
record = RunCallbacksModel.new(name: "a")
result = record.wrap_save do
  record.log << "block"
  42
end

assert result == 42
assert record.log == ["around_in", "before_save", "block", "after_save", "around_out"]

# it: returns nil and skips the block and after chain when an around callback halts
record = RunCallbacksModel.new(name: "a")
record.gate = false
ran = false
result = record.wrap_save do
  ran = true
  42
end

assert result.nil?
assert !ran
assert record.around_halted?
assert record.log == ["around_in", "around_out"]

# it: runs events that have no around chain around the block
record = RunCallbacksModel.new(name: "a")
record.wrap_destroy { record.log << "block" }
assert record.log == ["before_destroy", "block", "after_destroy"]

# it: runs a bare event chain with no block
record = RunCallbacksModel.new(name: "a")
assert record.bare_touch.or_panic
assert record.log == ["after_touch"]

# it: propagates abort! raised in a callback
record = RunCallbacksModel.new(name: "a")
result = record.wrap_save do
  error = record.abort_strict("stop")
  error.is_a?(::Error) ? error : 1
end
assert result.is_a?(::Grant::Callbacks::Abort)

# it: dispatches a runtime symbol through a case statement
record = RunCallbacksModel.new(name: "a")
event = :save
assert record.run_callbacks(event).or_panic
assert record.log == ["around_in", "before_save", "after_save", "around_out"]

record.log.clear
record.gate = false
assert !record.run_callbacks(event).or_panic

result = record.run_callbacks(:bogus)
assert result.is_a?(::Grant::Callbacks::UnknownEventError)
if result.is_a?(::Grant::Callbacks::UnknownEventError)
  assert result.message.includes?("Unknown callback event :bogus")
end

# it: runs a block through the receiver form
record = RunCallbacksModel.new(name: "a")
result = record.run_callbacks(:save) do
  record.log << "block"
  "done"
end

assert result == "done"
assert record.log == ["around_in", "before_save", "block", "after_save", "around_out"]

# it: returns nil from the receiver form when an around callback halts
record = RunCallbacksModel.new(name: "a")
record.gate = false
assert record.run_callbacks(:save) { "done" }.nil?

# it: returns false from the literal form with no block when an around callback halts
record = RunCallbacksModel.new(name: "a")
record.gate = false
assert !record.bare_save.or_panic

# it: dispatches a variable event with a block from inside the model
record = RunCallbacksModel.new(name: "a")
assert record.wrap_event(:destroy) { record.log << "block"; "done" } == "done"
assert record.log == ["before_destroy", "block", "after_destroy"]
