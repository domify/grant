module test/grant_attributes_w6_alias_query_test

import test/attribute_spec_models::{AttrPost}
import test/spec_helper::{register_spec_connections}

private def prepare_records : Nil
  AttrPost.clear.or_panic
  AttrPost.create_strict(title: "b", views: 2).or_panic
  AttrPost.create_strict(title: "a", views: 1).or_panic
  nil
end

register_spec_connections
AttrPost.migrator.drop_and_create.or_panic

# it: resolves the alias in Model.find_by and the relation find_by
prepare_records
post = AttrPost.find_by(name: "a").or_panic
assert (post.nil? ? nil : post.views) == 1
post = AttrPost.find_by({"name" => "b"}).or_panic
assert (post.nil? ? nil : post.views) == 2
assert AttrPost.find_by_strict(name: "a").or_panic.title == "a"
post = AttrPost.where(views: [1, 2]).find_by(name: "b").or_panic
assert (post.nil? ? nil : post.views) == 2
assert AttrPost.find_by(name: "missing").or_panic.nil?

# it: resolves the alias in order
prepare_records
assert AttrPost.order(:name).select.or_panic.map(&.title) == ["a", "b"]
assert AttrPost.order(name: :desc).select.or_panic.map(&.title) == ["b", "a"]
assert AttrPost.order(:name, :desc).select.or_panic.map(&.title) == ["b", "a"]

# it: resolves the alias in pluck
prepare_records
assert AttrPost.order(:title).pluck(:name).or_panic == [["a"], ["b"]]
assert AttrPost.order(:title).pluck(:name, :views).or_panic == [["a", 1], ["b", 2]]

# it: resolves the alias in select
prepare_records
rows = AttrPost.select(:name).order(:name).select.or_panic
assert rows.map(&.title) == ["a", "b"]

# it: resolves the alias in where(field, operator, value)
prepare_records
assert AttrPost.where(:name, :eq, "a").select.or_panic.map(&.views) == [1]
assert AttrPost.where(:name, :like, "%b").count.or_panic == 1
assert AttrPost.where(:name, :in, ["a", "b"]).count.or_panic == 2

# it: delegates the dirty-control helpers
prepare_records
post = AttrPost.create_strict(title: "before").or_panic
post.name = "after"
assert post.name_came_from_user?
assert post.will_save_change_to_name?
post.save_strict.or_panic
assert post.saved_change_to_name?
assert post.saved_change_to_name?(from: "before", to: "after")
assert post.saved_change_to_name == {"before", "after"}
assert post.name_previously_was == "before"
assert post.name_previously_changed?
assert post.name_before_last_save == "before"
post.name = "again"
post.restore_name_in_place
assert post.name == "after"
assert !post.name_changed?
