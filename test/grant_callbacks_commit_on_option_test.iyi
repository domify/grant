module test/grant_callbacks_commit_on_option_test
import grant/base::{Base}
import grant/errors::{Rollback}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

pub class CommitOnModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table commit_on_models

  column id : Int64, primary: true
  column name : String?

  @@event_log = [] of String
  def self.event_log : Array(String)
    @@event_log
  end
  def self.event_log=(value : Array(String)) : Array(String)
    @@event_log = value
  end

  after_commit(on: [:create, :update]) { CommitOnModel.event_log << "cu" }
  after_commit(on: :destroy) { CommitOnModel.event_log << "d" }
  after_commit { CommitOnModel.event_log << "any" }
  after_rollback(on: :create) { CommitOnModel.event_log << "rb_create" }
  after_rollback(on: [:update, :destroy]) { CommitOnModel.event_log << "rb_ud" }
  after_rollback { CommitOnModel.event_log << "rb_any" }
end
register_spec_connections
CommitOnModel.migrator.drop_and_create.or_panic

# it: runs an on: array callback for create and update but not destroy
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
record = CommitOnModel.create(name: "a")
assert CommitOnModel.event_log == ["cu", "any"]

CommitOnModel.event_log.clear
record.name = "b"
record.save
assert CommitOnModel.event_log == ["cu", "any"]

CommitOnModel.event_log.clear
record.destroy
assert CommitOnModel.event_log == ["d", "any"]

# it: filters after_rollback by the rolled back operation
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  CommitOnModel.create(name: "a")
  Rollback.new
end.or_panic
assert CommitOnModel.event_log == ["rb_create", "rb_any"]

# it: keeps the update operation for a rolled back update
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
record = CommitOnModel.create(name: "a")
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  record.name = "b"
  record.save
  Rollback.new
end.or_panic
assert CommitOnModel.event_log == ["rb_ud", "rb_any"]

# it: runs commit callbacks once per record for repeated saves in one transaction
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  record = CommitOnModel.create(name: "a")
  record.name = "b"
  record.save
  record.name = "c"
  record.save
  assert CommitOnModel.event_log.empty?
end.or_panic
assert CommitOnModel.event_log == ["cu", "any"]

# it: matches on: :create for a record created then updated in one transaction
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  record = CommitOnModel.create(name: "a")
  record.name = "b"
  record.save
end.or_panic
assert CommitOnModel.event_log.count { |event| event == "cu" } == 1

# it: dedupes per record, not per class
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  CommitOnModel.create(name: "a")
  CommitOnModel.create(name: "b")
end.or_panic
assert CommitOnModel.event_log == ["cu", "any", "cu", "any"]

# it: fires again for a later transaction
CommitOnModel.clear.or_panic
CommitOnModel.event_log.clear
record = CommitOnModel.create(name: "a")
CommitOnModel.event_log.clear
CommitOnModel.transaction do
  record.name = "b"
  record.save
end.or_panic
assert CommitOnModel.event_log == ["cu", "any"]
CommitOnModel.adapter.close.or_panic
