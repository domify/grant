module test/grant_dirty_dirty_tracking_test
import test/transaction_crud_models::{Parent}
import test/spec_helper::{register_spec_connections}
import std/time::{Time}
register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: tracks when an attribute changes
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
assert parent.name_changed?
assert parent.changed?
assert parent.changed == ["name"]

# it: returns false when attribute hasn't changed
parent = Parent.new(name: "Original")
parent.save

assert !parent.name_changed?
assert !parent.changed?

# it: tracks the original value
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
assert parent.name_was == "Original"

# it: tracks the change tuple
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
change = parent.name_change
assert !change.nil?
assert change.as(Tuple(Parent::SavedValue, Parent::SavedValue))[0] == "Original"
assert change.as(Tuple(Parent::SavedValue, Parent::SavedValue))[1] == "Updated"

# it: tracks multiple attribute changes
parent = Parent.new(name: "John")
parent.save

parent.name = "Jane"
parent.created_at = Time.utc(2023, 1, 1)

assert parent.changed?
assert parent.changed.includes?("name")
assert parent.changed.includes?("created_at")

changes = parent.changes
assert changes["name"] == {"John", "Jane"}
# Note: created_at comparison would be complex due to Time equality

# it: can restore a single attribute
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
parent.restore_attributes(["name"])

assert parent.name == "Original"
assert !parent.name_changed?

# it: can restore all changed attributes
parent = Parent.new(name: "John")
parent.save

original_created_at = parent.created_at
parent.name = "Jane"
parent.created_at = Time.utc(2023, 1, 1)

parent.restore_attributes

assert parent.name == "John"
assert parent.created_at == original_created_at
assert !parent.changed?

# it: clears dirty state after successful save
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
assert parent.changed?

parent.save

assert !parent.changed?
assert !parent.name_changed?

# it: tracks previous changes after save
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
parent.save

assert parent.previous_changes["name"] == {"Original", "Updated"}
assert parent.saved_changes["name"] == {"Original", "Updated"}
assert parent.saved_change_to_attribute?("name")
assert parent.name_before_last_save == "Original"

# it: doesn't mark new records as changed on initialization
parent = Parent.new(name: "New")
assert !parent.changed?
assert !parent.name_changed?

# it: tracks changes after initial save
parent = Parent.new(name: "New")
parent.save

parent.name = "Updated"
assert parent.name_changed?
assert parent.name_was == "New"

# it: doesn't mark as changed when setting same value
parent = Parent.new(name: "Same")
parent.save

parent.name = "Same"
assert !parent.name_changed?
assert !parent.changed?

# it: removes from changed when reverting to original value
parent = Parent.new(name: "Original")
parent.save

parent.name = "Updated"
assert parent.name_changed?

parent.name = "Original"
assert !parent.name_changed?
assert !parent.changed?
