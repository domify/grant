module test/grant_connection_reconnect_refusal_test
import test/pool_spec_support::{C02Support}
import std/time::{Span}
import grant/adapter/sqlite::{Sqlite}
import grant/database::{Database, ConnectionRefused}
import grant/errors::{DatabaseError}
import grant/error_taxonomy::{ConnectionFailed}

pub class C02RefusingAdapter < Sqlite
  property refusals : Int32 = 0
  getter attempts : Int32 = 0

  def database : Database | DatabaseError | ConnectionRefused
    @attempts += 1
    if @refusals > 0
      @refusals -= 1
      return ConnectionRefused.new
    end
    super
  end
end

# it: retries a refused connection up to retry_attempts and then succeeds
adapter = C02RefusingAdapter.new("c02_refusing", C02Support.url("c02_refusing"))
adapter.retry_attempts = 2
adapter.retry_delay = Span.milliseconds(1_i64)
adapter.refusals = 2
assert adapter.open("INSERT INTO t VALUES (1)") { |connection| connection.scalar("SELECT 1") }.or_panic == 1
assert adapter.attempts == 3
adapter.disconnect_strict.or_panic

# it: raises Grant::ConnectionFailed when the database stays down
adapter = C02RefusingAdapter.new("c02_refusing", C02Support.url("c02_refusing"))
adapter.retry_attempts = 2
adapter.retry_delay = Span.milliseconds(1_i64)
adapter.refusals = 10
error = adapter.open { |connection| connection.scalar("SELECT 1") }
assert error.is_a?(ConnectionFailed)
assert error.as(ConnectionFailed).cause.is_a?(ConnectionRefused)
assert adapter.attempts == 3
adapter.disconnect_strict.or_panic

# it: counts a fiber backing off between attempts as waiting
adapter = C02RefusingAdapter.new("c02_refusing", C02Support.url("c02_refusing"))
adapter.retry_attempts = 3
adapter.retry_delay = Span.milliseconds(30_i64)
adapter.refusals = 2
finished = Channel(Nil).new
group do |tasks|
  tasks.spawn do
    adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic
    finished.send(nil).or_panic
  end
  sleep(0).or_panic
  assert adapter.pool_stat.waiting == 1
  finished.receive.or_panic
  assert adapter.pool_stat.waiting == 0
end
adapter.disconnect_strict.or_panic
C02Support.cleanup
