module test/grant_attributes_before_type_cast_test
import test/attribute_spec_models::{AttrPost, Level}
import test/spec_helper::{register_spec_connections}
import grant/attributes::{UnknownAttributeError}
register_spec_connections
AttrPost.migrator.drop_and_create.or_panic

# it: keeps the raw input when mass assignment converted it
post = AttrPost.new(views: "42", published: "1")
assert post.views == 42
assert post.attribute_before_type_cast("views").or_panic == "42"
assert post.views_before_type_cast.or_panic == "42"
assert post.attribute_before_type_cast(:published).or_panic == "1"

# it: keeps the raw input for assign_attributes
post = AttrPost.new
post.assign_attributes(views: "7")
assert post.views_before_type_cast.or_panic == "7"

# it: is not captured when the input already has the column type
post = AttrPost.new(views: 42, title: "same")
assert post.views_before_type_cast.or_panic == 42
assert post.instance_variable_get_for_spec.nil?

# it: forgets the raw input once the typed setter runs
post = AttrPost.new(views: "42")
post.views = 43
assert post.views_before_type_cast.or_panic == 43

# it: is never captured while loading rows
post = AttrPost.create_strict(title: "Loaded", views: 5).or_panic
loaded = AttrPost.find_strict(post.id).or_panic
assert loaded.views_before_type_cast.or_panic == 5
assert loaded.instance_variable_get_for_spec.nil?

# it: forgets the raw input on reload
post = AttrPost.create_strict(title: "Reloaded", views: 5).or_panic
post.assign_attributes(views: "7")
assert post.views_before_type_cast.or_panic == "7"
post.reload.or_panic
assert post.views == 5
assert post.views_before_type_cast.or_panic == 5

# it: returns the converted database value for converter columns
post = AttrPost.new(level: Level::Low)
assert post.attribute_before_type_cast("level").or_panic == "Low"

# it: raises for an unknown attribute
assert AttrPost.new.attribute_before_type_cast("nope").is_a?(UnknownAttributeError)
AttrPost.adapter.close.or_panic
