module test/encryption_codec_regression_test
import grant/base::{Base}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider, KeyError}
import grant/encryption/encrypted_attribute::{EncryptedAttribute}
import std/base64::{Base64}
import test/spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Fixed vector computed independently with Python's HMAC-SHA256 and
# cryptography's AES-CBC/PKCS7, using the upstream payload construction.
key = "01234567890123456789012345678901"
encoded_key = Base64.encode(key)
sealed = Cipher.encrypt("hush", key, true).or_panic
assert Base64.encode(sealed) == "gQq9VSJ8crysLax2JVflGQzN9QdP6TJq2FvbpUlZAgiAI6xqJ8VpANwh6SrByVgLm2THO7Mq7x92/UfwhqtwIbU="
assert Cipher.encrypted_payload?(sealed)
assert Cipher.deterministic_payload?(sealed)
assert Cipher.decrypt(sealed, key).or_panic == "hush"
assert Cipher.encrypt("hush", key, true).or_panic == sealed
first = Cipher.encrypt("hush", key).or_panic
second = Cipher.encrypt("hush", key).or_panic
assert first != second
assert !Cipher.deterministic_payload?(first)
assert Cipher.decrypt(first, key).or_panic == "hush"
assert Cipher.decrypt(sealed, "wrong key").is_a?(DecryptionError)
assert Cipher.decrypt("too short", key).is_a?(DecryptionError)
assert Cipher.encrypt("", key).or_panic == ""
assert Cipher.decrypt("", key).or_panic == ""
corrupted = Cipher.bytes(sealed, 0, sealed.bytesize)
corrupted.to_unsafe[corrupted.bytesize - 1] ^= 1_u8
assert Cipher.decrypt(corrupted, key).is_a?(DecryptionError)

(KeyProvider.primary_key = encoded_key).or_panic
(KeyProvider.deterministic_key = encoded_key).or_panic
assert KeyProvider.primary_key == key
assert (KeyProvider.primary_key = "@@").is_a?(KeyError)
assert (KeyProvider.primary_key = Base64.encode("short")).is_a?(KeyError)
assert KeyProvider.primary_key == key
KeyProvider.key_derivation_salt = "lazy-salt"
email = EncryptedAttribute.new("CodecUser", "email", true, "email")
secret = EncryptedAttribute.new("CodecUser", "secret", false, "secret")
email_stored = email.seal("ada@example.com").or_panic
assert email.seal("ada@example.com").or_panic == email_stored
assert email.open(email_stored).or_panic == "ada@example.com"
assert secret.open(email_stored).is_a?(DecryptionError)
assert secret.open("@@").is_a?(DecryptionError)
KeyProvider.key_derivation_salt = "new-salt"
assert email.open(email_stored).is_a?(DecryptionError)
KeyProvider.key_derivation_salt = "lazy-salt"
assert email.open(email_stored).or_panic == "ada@example.com"

pub class CodecUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table codec_users
  column id : Int64, primary: true
  encrypts secret : String, lazy: true
end
register_spec_connections
CodecUser.migrator.drop_and_create.or_panic
user = CodecUser.create_strict(secret: "hush").or_panic
stored = CodecUser.__connection.query("SELECT secret FROM codec_users WHERE id = ?", [user.id] of ::Grant::Adapter::Sqlite::Value).or_panic.first["secret"].as(String)
assert stored != "hush"
assert Cipher.encrypted_payload?(Base64.decode(stored))
assert CodecUser.secret_encrypted_attribute.open(stored).or_panic == "hush"
KeyProvider.primary_key = nil
error = CodecUser.create_strict(secret: "cannot seal")
assert error.is_a?(KeyError)
assert CodecUser.count.or_panic == 1
assert !CodecUser.__connection.in_transaction?
assert CodecUser.import_records([CodecUser.new(secret: "cannot seal")]).is_a?(KeyError)
assert CodecUser.count.or_panic == 1
(KeyProvider.primary_key = encoded_key).or_panic
CodecUser.import_records([CodecUser.new(secret: "imported")]).or_panic
imported = CodecUser.__connection.query("SELECT secret FROM codec_users ORDER BY id DESC LIMIT 1").or_panic.first["secret"].as(String)
assert imported != "imported"
assert CodecUser.secret_encrypted_attribute.open(imported).or_panic == "imported"
KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
CodecUser.__connection.close.or_panic
