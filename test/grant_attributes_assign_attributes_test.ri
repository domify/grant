module test/grant_attributes_assign_attributes_test
import test/attribute_spec_models::{AttrPost}
import test/spec_helper::{register_spec_connections}

register_spec_connections
AttrPost.migrator.drop_and_create.or_panic

# it: assigns from keyword arguments and returns the record
post = AttrPost.new
assert post.assign_attributes(title: "Hello", views: 2).object_id == post.object_id
assert post.title == "Hello"
assert post.views == 2

# it: assigns from string- and symbol-keyed hashes, converting values
post = AttrPost.new
post.assign_attributes({"title" => "Hash", "views" => "9"}).or_panic
assert post.title == "Hash"
assert post.views == 9
post.assign_attributes({:views => "10"}).or_panic
assert post.views == 10

# it: assigns through attributes=
post = AttrPost.new
post.attributes = {"title" => "Writer", "published" => "true"}
assert post.title == "Writer"
assert post.published == true

# it: records conversion errors and tracks changes
post = AttrPost.create_strict(title: "Before").or_panic
post.assign_attributes(title: "After", views: "many")
assert post.title_changed?
assert post.errors.map(&.field.to_s).includes?("views")

# it: resolves aliases
post = AttrPost.new
post.assign_attributes(name: "Aliased")
assert post.title == "Aliased"
AttrPost.adapter.close.or_panic
