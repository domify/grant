import std/text
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import transaction_crud_models::{Parent}
import spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
pg = Pg.new("pg_placeholder", "postgres://localhost/unused")
sqlite = Sqlite.new("sqlite_placeholder", "sqlite3::memory:")

def legacy_numbered(clause : String, starting_index : Int32 = 0) : String
if clause.includes?("?")
clause.count("?").times do |i|
  clause = clause.sub("?", "$#{starting_index + i + 1}")
end
end
clause
end


# it: numbers placeholders from 1
  assert pg.ensure_clause_template("a = ? AND b = ? AND c = ?") == "a = $1 AND b = $2 AND c = $3"


# it: honors a starting index
  assert pg.ensure_clause_template("a = ? AND b = ?", 4) == "a = $5 AND b = $6"


# it: returns a clause without placeholders unchanged
  clause = "SELECT * FROM users WHERE id = $1"
  assert pg.ensure_clause_template(clause).object_id == clause.object_id


# it: matches the previous String#sub rewrite on plain fragments
  [
    "id = ?",
    "name = ? AND age = ? AND active = ?",
    "UPDATE users SET name = ?, age = ? WHERE id = ?",
    "name IS NULL AND age = ?",
    "café = ? AND ☃ = ?",
  ].each do |clause|
    assert pg.ensure_clause_template(clause) == legacy_numbered(clause)
    assert pg.ensure_clause_template(clause, 3) == legacy_numbered(clause, 3)
  end


# it: leaves a ? inside a single quoted literal alone and keeps numbering
  assert pg.ensure_clause_template("title = 'why?' AND id = ? AND slug = ?") == "title = 'why?' AND id = $1 AND slug = $2"


# it: treats a doubled quote as part of the literal
  assert pg.ensure_clause_template("note = 'it''s ok?' AND id = ?") == "note = 'it''s ok?' AND id = $1"


# it: leaves a ? inside a quoted identifier alone
  assert pg.ensure_clause_template(%(SELECT "what?" FROM t WHERE id = ?)) == %(SELECT "what?" FROM t WHERE id = $1)


# it: honors backslash escapes only in E strings
  assert pg.ensure_clause_template(%q(a = E'it\'s ?' AND b = ?)) == %q(a = E'it\'s ?' AND b = $1)
  assert pg.ensure_clause_template(%q(a = 'x\' AND b = ?)) == %q(a = 'x\' AND b = $1)


# it: leaves a ? inside comments alone
  assert pg.ensure_clause_template("a = ? -- really?\nAND b = ?") == "a = $1 -- really?\nAND b = $2"
  assert pg.ensure_clause_template("a = ? /* why? /* nested? */ still? */ AND b = ?") == "a = $1 /* why? /* nested? */ still? */ AND b = $2"


# it: leaves a ? inside dollar quoted bodies alone
  assert pg.ensure_clause_template("SELECT $$is it?$$, ?") == "SELECT $$is it?$$, $1"
  assert pg.ensure_clause_template("SELECT $body$is it?$body$, ?") == "SELECT $body$is it?$body$, $1"


# it: does not mistake $1 for a dollar quote
  assert pg.ensure_clause_template("a = $1 AND b = ? AND c = 'x?'") == "a = $1 AND b = $1 AND c = 'x?'"


# it: handles an unterminated literal without failing
  assert pg.ensure_clause_template("a = ? AND b = 'oops ?") == "a = $1 AND b = 'oops ?"


# it: keeps :: casts and numbers the placeholders around them
  assert pg.ensure_clause_template("id::text = ? AND created_at::date > ?::date") == "id::text = $1 AND created_at::date > $2::date"


# it: keeps casts of quoted literals
  assert pg.ensure_clause_template("'2020-01-01'::date < ? AND '?'::text = ?") == "'2020-01-01'::date < $1 AND '?'::text = $2"


# it: turns ?? into a literal ? without consuming a parameter (PostgreSQL)
  assert pg.ensure_clause_template("data ?? 'key' AND id = ? AND kind = ?") == "data ? 'key' AND id = $1 AND kind = $2"


# it: supports the JSONB any-key and all-keys operators
  assert pg.ensure_clause_template("tags ??| array[?] AND tags ??& array[?]") == "tags ?| array[$1] AND tags ?& array[$2]"


# it: leaves ?? alone inside a quoted literal
  assert pg.ensure_clause_template("a = '??' AND b = ?") == "a = '??' AND b = $1"


# it: collapses ?? on adapters with native ? placeholders
  assert sqlite.ensure_clause_template("a ?? b AND id = ?") == "a ? b AND id = ?"


# it: escapes ? in raw where fragments built by the query builder
  sql = Parent.where("name ?? 'x' AND id = ?", 7_i64).raw_sql
  assert sql.includes?("name ? 'x' AND id = ")


# it: runs a JSONB ?? operator through the query builder on PostgreSQL
if Parent.adapter.postgres?
  Parent.clear
  parent = Parent.create_strict(name: "x").or_panic
  Parent.create_strict(name: "y").or_panic

  found = Parent.where("to_jsonb(name) ?? 'x' AND id = ?", parent.id).to_a.or_panic
  assert found.map { |record| record.id } == [parent.id]


end

# it: leaves native placeholder clauses without ?? untouched
  clause = "id = ? AND name = 'x?'"
  assert sqlite.ensure_clause_template(clause).object_id == clause.object_id
Parent.adapter.close.or_panic
