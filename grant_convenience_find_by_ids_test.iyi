import convenience_models::{ConvItem, reset_items, statements}
import grant/querying::{NotFound}
import grant/errors::{RecordNotFound}

reset_items

# it: returns records in the order of the ids with one IN query
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
b = ConvItem.create_strict(name: "b").or_panic
c = ConvItem.create_strict(name: "c").or_panic
ids = [(c.id || raise "missing id"), (a.id || raise "missing id"), (b.id || raise "missing id")]
found = [] of ConvItem
sql = statements { found = ConvItem.find(ids).or_panic }
assert found.map { |r| r.id } == ids
assert sql.size == 1
assert sql.first.includes?(" IN ")

# it: accepts several positional ids
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
b = ConvItem.create_strict(name: "b").or_panic
assert ConvItem.find((b.id || raise "missing id"), (a.id || raise "missing id")).or_panic.map { |r| r.name } == ["b", "a"]
assert ConvItem.find_strict((b.id || raise "missing id"), (a.id || raise "missing id")).or_panic.map { |r| r.name } == ["b", "a"]

# it: skips missing ids in find and returns an empty array for none
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
assert ConvItem.find([(a.id || raise "missing id"), 999_999_i64]).or_panic.map { |r| r.id } == [a.id]
assert ConvItem.find([] of Int64).or_panic.empty?

# it: raises NotFound naming every missing id from find!
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
error = ConvItem.find_strict([(a.id || raise "missing id"), 888_888_i64, 999_999_i64])
assert error.is_a?(NotFound)
if error.is_a?(NotFound)
  assert error.message.includes?("888888")
  assert error.message.includes?("999999")
  assert error.is_a?(RecordNotFound)
end

# it: keeps the single-id behavior
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
assert !ConvItem.find(a.id).or_panic.nil?
assert ConvItem.find(999_999).or_panic.nil?
assert ConvItem.find_strict(999_999).is_a?(NotFound)

# it: applies relation conditions
ConvItem.clear
a = ConvItem.create_strict(name: "a", status: "x").or_panic
b = ConvItem.create_strict(name: "b", status: "y").or_panic
assert ConvItem.where(status: "x").find([(a.id || raise "missing id"), (b.id || raise "missing id")]).or_panic.map { |r| r.id } == [a.id]
assert ConvItem.where(status: "x").find_strict([(a.id || raise "missing id"), (b.id || raise "missing id")]).is_a?(NotFound)

# it: returns duplicates as many times as they were asked for
ConvItem.clear
a = ConvItem.create_strict(name: "a").or_panic
id = (a.id || raise "missing id")
assert ConvItem.find([id, id]).or_panic.size == 2
ConvItem.adapter.close.or_panic
