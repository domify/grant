import grant/base::{Base}
import grant/adapter/pg::{Pg}
import grant/adapter/pg_connection::{PQError}
import grant/adapter/driver::{Value}
import grant/database::{PoolTimeout, ConnectionRefused}
import grant/errors::{Rollback, ErrorBase}
import grant/error_taxonomy::{TransactionRollbackError, ReadOnlyError, ValueTooLong, ConnectionTimeoutError, ConnectionFailed}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Native counterpart of the upstream PQ::PQError built from frames.
private def pg_error(sqlstate : String, message : String = "ERROR: something failed") : PQError
  PQError.new(sqlstate, message)
end

class G01Account < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table g01_accounts
  column id : Int64, primary: true
  column email : String
  column code : String?
end

private def create_g01_tables
  adapter = G01Account.adapter
  statements = if adapter.postgres?
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id BIGSERIAL PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id BIGSERIAL PRIMARY KEY, account_id BIGINT REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               else
                 # The MySQL branch is adapter-out-of-scope.
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id INTEGER PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id INTEGER PRIMARY KEY, account_id INTEGER REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               end
  statements.each { |statement| adapter.open { |db| db.exec(statement) }.or_panic }
end

register_spec_connections

pg = Pg.new(name: "g01_pg_translate", url: "postgres://localhost/unused")
# The MySQL adapter of this describe block is adapter-out-of-scope.

# it: groups deadlocks and serialization failures under TransactionRollbackError
assert pg.translate_exception(pg_error("40P01")).is_a?(TransactionRollbackError)
assert pg.translate_exception(pg_error("40001")).is_a?(TransactionRollbackError)

# it: turns a read-only transaction into ReadOnlyError
assert pg.translate_exception(pg_error("25006")).is_a?(ReadOnlyError)

# it: returns exceptions it does not recognize unchanged
rollback = Rollback.new
assert pg.translate_exception(rollback).is_a?(Rollback)
# The MySQL assertion is adapter-out-of-scope.
plain = ErrorBase.new("plain")
assert pg.translate_exception(plain).object_id == plain.object_id

# it: maps crystal-db pool failures for every adapter
assert pg.translate_exception(PoolTimeout.new("checkout")).is_a?(ConnectionTimeoutError)
assert pg.translate_exception(ConnectionRefused.new).is_a?(ConnectionFailed)
# The MySQL assertion is adapter-out-of-scope.

# it: raises ValueTooLong for a value over the column length
create_g01_tables
# SQLite does not enforce VARCHAR length; its TOOBIG code is covered by the
# classification examples.
unless G01Account.adapter.sqlite?
  error = G01Account.adapter.insert("g01_accounts", ["email", "code"], ["long@example.com", "far too long"] of Value, lastval: nil)
  assert error.is_a?(ValueTooLong)
end
