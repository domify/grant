import grant/base::{Base}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{in_explicit_transaction?}
import transaction_sql_recorder::{record}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: rolls back only the savepoint when a non-Rollback exception escapes it
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Kept").or_panic
  error = Parent.transaction(requires_new: true) do
    Parent.create_strict(name: "Discarded").or_panic
    ErrorBase.new("inner failure")
  end
  assert error.is_a?(ErrorBase)
  assert error.as(ErrorBase).message == "inner failure"
  Parent.create_strict(name: "After").or_panic
end.or_panic
assert Parent.all.or_panic.map { |parent| parent.name.to_s }.sorted == ["After", "Kept"]

# it: prunes callbacks registered inside a rolled-back savepoint
events = [] of Symbol
Parent.transaction do
  Parent.current_transaction.after_commit { events << :outer_commit; nil }
  Parent.transaction(requires_new: true) do
    Parent.current_transaction.after_commit { events << :inner_commit; nil }
    Parent.current_transaction.after_rollback { events << :inner_rollback; nil }
    Rollback.new
  end.or_panic
  assert events == [:inner_rollback]
end.or_panic
assert events == [:inner_rollback, :outer_commit]

# it: keeps callbacks from a released savepoint pending until the outer commit
events = [] of Symbol
Parent.transaction do
  Parent.transaction(requires_new: true) do
    Parent.current_transaction.after_commit { events << :inner_commit; nil }
  end.or_panic
  assert events.empty?
end.or_panic
assert events == [:inner_commit]

# it: fires the released savepoint's rollback callback when the outer transaction rolls back
events = [] of Symbol
error = Parent.transaction do
  Parent.transaction(requires_new: true) do
    Parent.current_transaction.after_commit { events << :inner_commit; nil }
    Parent.current_transaction.after_rollback { events << :inner_rollback; nil }
  end.or_panic
  ErrorBase.new("outer")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "outer"
assert events == [:inner_rollback]

# it: restores in-memory record state written inside a rolled-back savepoint
Parent.clear.or_panic
parent = Parent.new(name: "Fresh")
Parent.transaction do
  Parent.transaction(requires_new: true) do
    parent.save_strict.or_panic
    assert parent.persisted?
    Rollback.new
  end.or_panic
end.or_panic
assert parent.new_record?
assert Parent.count.or_panic == 0

# it: leaves no transaction open after a failed savepoint
error = Parent.transaction do
  Parent.transaction(requires_new: true) { ErrorBase.new("boom") }
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert !Parent.transaction_open?
assert !in_explicit_transaction?

# it: keeps savepoint names unique after a rollback
statements = record do
  Parent.transaction do
    Parent.transaction(requires_new: true) { Rollback.new }.or_panic
    Parent.transaction(requires_new: true) { nil }.or_panic
  end.or_panic
end
assert statements.select { |sql| sql.starts_with?("SAVEPOINT") } == ["SAVEPOINT sp_1", "SAVEPOINT sp_2"]
Parent.adapter.close.or_panic
