import std/text
import grant/base::{Base}
import grant/adapter/pg::{Pg}
import grant/adapter/pg_connection::{PQError}
import grant/adapter/error_translator::{Kind}
import grant/locking::{LockMode, LockWaitTimeoutError}
import grant/errors::{ErrorBase}
import grant/error_taxonomy::{StatementInvalid, RecordNotUnique, InvalidForeignKey, NotNullViolation, ValueTooLong, Deadlocked, SerializationFailure, LockWaitTimeout, StatementTimeout, QueryCanceled, NoDatabaseError, ReadOnlyError}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

alias G01Kind = ::Grant::Adapter::ErrorTranslator::Kind

# Native counterpart of the upstream PQ::PQError built from frames.
private def pg_error(sqlstate : String, message : String = "ERROR: something failed") : PQError
  PQError.new(sqlstate, message)
end

class G01Account < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table g01_accounts
  column id : Int64, primary: true
  column email : String
  column code : String?
end

private def create_g01_tables
  adapter = G01Account.adapter
  statements = if adapter.postgres?
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id BIGSERIAL PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id BIGSERIAL PRIMARY KEY, account_id BIGINT REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               else
                 # The MySQL branch is adapter-out-of-scope.
                 [
                   "DROP TABLE IF EXISTS g01_notes", "DROP TABLE IF EXISTS g01_accounts",
                   "CREATE TABLE g01_accounts (id INTEGER PRIMARY KEY, email VARCHAR(40) NOT NULL UNIQUE, code VARCHAR(5))",
                   "CREATE TABLE g01_notes (id INTEGER PRIMARY KEY, account_id INTEGER REFERENCES g01_accounts(id), body TEXT NOT NULL DEFAULT '')",
                 ]
               end
  statements.each { |statement| adapter.open { |db| db.exec(statement) }.or_panic }
end

register_spec_connections

# it: "maps #
{
  "23505" => G01Kind::Unique,
  "23503" => G01Kind::ForeignKey,
  "23502" => G01Kind::NotNull,
  "22001" => G01Kind::ValueTooLong,
  "40P01" => G01Kind::Deadlock,
  "40001" => G01Kind::SerializationFailure,
  "55P03" => G01Kind::LockWaitTimeout,
  "57014" => G01Kind::QueryCanceled,
  "25006" => G01Kind::ReadOnly,
  "3D000" => G01Kind::NoDatabase,
}.each do |state, kind|
  assert Pg.error_kind(state) == kind
end

# it: separates a statement timeout from a user cancel on 57014
assert Pg.error_kind("57014", "canceling statement due to statement timeout") == G01Kind::StatementTimeout
assert Pg.error_kind("57014", "canceling statement due to user request") == G01Kind::QueryCanceled

# it: does not translate other codes
assert Pg.error_kind("42P01").nil?
assert Pg.error_kind(nil).nil?

pg = Pg.new(name: "g01_pg_translate", url: "postgres://localhost/unused")

# Each pair is a state and a check that the translated error is (a subclass
# of) the upstream error class.
translations = [
  {"23505", ->(error : ErrorBase) { error.is_a?(RecordNotUnique) }},
  {"23503", ->(error : ErrorBase) { error.is_a?(InvalidForeignKey) }},
  {"23502", ->(error : ErrorBase) { error.is_a?(NotNullViolation) }},
  {"22001", ->(error : ErrorBase) { error.is_a?(ValueTooLong) }},
  {"40P01", ->(error : ErrorBase) { error.is_a?(Deadlocked) }},
  {"40001", ->(error : ErrorBase) { error.is_a?(SerializationFailure) }},
  {"55P03", ->(error : ErrorBase) { error.is_a?(LockWaitTimeout) }},
  {"57014", ->(error : ErrorBase) { error.is_a?(QueryCanceled) }},
  {"3D000", ->(error : ErrorBase) { error.is_a?(NoDatabaseError) }},
]
# it: "turns PostgreSQL #
translations.each do |pair|
  state = pair[0]
  driver_error = pg_error(state)
  translated = pg.translate_exception(driver_error, "SELECT 1", [1_i64] of ::Grant::Adapter::Driver::Value)

  assert pair[1].call(translated)
  assert translated.is_a?(StatementInvalid)
  assert translated.message == driver_error.message
  assert translated.as(StatementInvalid).cause.as(ErrorBase).object_id == driver_error.object_id
  assert translated.as(StatementInvalid).sql == "SELECT 1"
end

# it: wraps an unclassified PostgreSQL error as StatementInvalid
translated = pg.translate_exception(pg_error("42P01"))
# iyi metaclass `==` is identity-blind, so the classes are compared by name.
assert translated.class.to_s == StatementInvalid.to_s

if G01Account.adapter.postgres?
  # it: maps deadlock, serialization, lock, cancel and read-only failures raised by the server
  adapter = G01Account.adapter
  [
    {"40P01", ->(error : ErrorBase) { error.is_a?(Deadlocked) }},
    {"40001", ->(error : ErrorBase) { error.is_a?(SerializationFailure) }},
    {"55P03", ->(error : ErrorBase) { error.is_a?(LockWaitTimeout) }},
    {"57014", ->(error : ErrorBase) { error.is_a?(QueryCanceled) }},
    {"25006", ->(error : ErrorBase) { error.is_a?(ReadOnlyError) }},
  ].each do |pair|
    statement = "DO $$ BEGIN RAISE EXCEPTION 'g01 test' USING ERRCODE = '#{pair[0]}'; END $$"
    raised = adapter.open(statement) { |db| db.exec(statement) }

    assert raised.is_a?(ErrorBase)
    assert pair[1].call(raised.as(ErrorBase))
  end

  # it: maps a real deadlock between two connections outside Model.transaction
  create_g01_tables
  adapter = G01Account.adapter
  first_id = G01Account.create_strict(email: "d1@example.com").or_panic.id
  second_id = G01Account.create_strict(email: "d2@example.com").or_panic.id

  outcomes = [] of ErrorBase?
  ready = Channel(Nil).new(2)
  proceed = Channel(Nil).new(2)
  group do |tasks|
    [{first_id, second_id, "a"}, {second_id, first_id, "b"}].each do |ids|
      tasks.spawn do
        outcome = adapter.open_pool_connection("UPDATE g01_accounts") do |conn|
          conn.exec("BEGIN").or_panic
          conn.exec("UPDATE g01_accounts SET code = '#{ids[2]}' WHERE id = #{ids[0]}").or_panic
          ready.send(nil).or_panic
          proceed.receive.or_panic
          updated = conn.exec("UPDATE g01_accounts SET code = '#{ids[2]}' WHERE id = #{ids[1]}")
          if updated.is_a?(::Error)
            conn.exec("ROLLBACK").or_panic
            updated
          else
            conn.exec("COMMIT")
          end
        end
        outcomes << (outcome.is_a?(ErrorBase) ? outcome : nil)
      end
    end
    2.times { ready.receive.or_panic }
    2.times { proceed.send(nil).or_panic }
  end

  assert outcomes.compact.any? { |outcome| outcome.is_a?(Deadlocked) }

  # it: raises StatementTimeout when the server's statement_timeout expires
  error = G01Account.adapter.open_pool_connection("SELECT pg_sleep(2)") do |conn|
    conn.exec("SET statement_timeout = 50").or_panic
    slept = conn.exec("SELECT pg_sleep(2)")
    conn.exec("RESET statement_timeout").or_panic
    slept
  end
  assert error.is_a?(StatementTimeout)
  assert error.as(StatementTimeout).cause.is_a?(PQError)

  # it: raises QueryCanceled when another session cancels the statement
  adapter = G01Account.adapter
  error = nil.as(ErrorBase | ::Grant::Adapter::Driver::Mutation | Cancelled | Nil)
  group do |tasks|
    error = adapter.open_pool_connection("SELECT pg_sleep(5)") do |conn|
      backend_pid = conn.scalar("SELECT pg_backend_pid()").or_panic.as(Int64)
      tasks.spawn do
        sleep 200
        adapter.database.or_panic.using_connection do |other|
          other.exec("SELECT pg_cancel_backend($1)", [backend_pid] of ::Grant::Adapter::Driver::Value)
        end.or_panic
      end
      conn.exec("SELECT pg_sleep(5)")
    end
  end
  assert error.is_a?(QueryCanceled)
  assert !error.is_a?(StatementTimeout)

  # it: raises LockWaitTimeout for a NOWAIT lock on a row another session holds
  create_g01_tables
  adapter = G01Account.adapter
  account_id = G01Account.create_strict(email: "locked@example.com").or_panic.id

  locked = Channel(Nil).new
  release = Channel(Nil).new
  group do |tasks|
    tasks.spawn do
      adapter.database.or_panic.using_connection do |conn|
        conn.exec("BEGIN").or_panic
        conn.exec("SELECT id FROM g01_accounts WHERE id = #{account_id} FOR UPDATE").or_panic
        locked.send(nil).or_panic
        release.receive.or_panic
        conn.exec("ROLLBACK").or_panic
      end.or_panic
    end

    locked.receive.or_panic
    error = G01Account.where(id: account_id).lock(LockMode::UpdateNoWait).to_a
    release.send(nil).or_panic
    assert error.is_a?(LockWaitTimeout)
    assert error.is_a?(LockWaitTimeoutError)
  end
end
