import std/enumerable
import grant/base::{Base}
import grant/errors::{Rollback, ErrorBase}
import transaction_sql_recorder::{record, begins}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: joins the parent for a plain nested block without a SAVEPOINT round trip
statements = record do
  Parent.transaction do
    Parent.transaction { Parent.transaction { nil }.or_panic }.or_panic
  end.or_panic
end
assert begins(statements).size == 1
assert statements.none? { |sql| sql.starts_with?("SAVEPOINT") }

# it: swallows Rollback in a joined block without undoing anything
Parent.clear.or_panic
inner_value : Symbol | Nil = :unset
Parent.transaction do
  Parent.create_strict(name: "Outer").or_panic
  inner_value = Parent.transaction do
    Parent.create_strict(name: "Inner").or_panic
    Rollback.new
  end.or_panic
  assert Parent.count.or_panic == 2
end.or_panic
assert inner_value.nil?
assert Parent.count.or_panic == 2

# it: propagates a non-Rollback exception from a joined block and rolls the outer back
Parent.clear.or_panic
error = Parent.transaction do
  Parent.create_strict(name: "Outer").or_panic
  Parent.transaction { ErrorBase.new("boom") }
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert Parent.count.or_panic == 0

# it: opens a savepoint for a plain nested block under a joinable: false parent
Parent.clear.or_panic
statements = record do
  Parent.transaction(joinable: false) do
    Parent.create_strict(name: "Outer").or_panic
    Parent.transaction do
      Parent.create_strict(name: "Inner").or_panic
      Rollback.new
    end.or_panic
  end.or_panic
end
assert statements.includes?("SAVEPOINT sp_1")
assert statements.any? { |sql| sql.starts_with?("ROLLBACK TO SAVEPOINT") }
assert Parent.all.or_panic.map { |parent| parent.name } == ["Outer"]

# it: applies joinable: false to a savepoint level
Parent.clear.or_panic
Parent.transaction do
  Parent.transaction(requires_new: true, joinable: false) do
    Parent.transaction do
      Parent.create_strict(name: "Discarded").or_panic
      Rollback.new
    end.or_panic
    assert Parent.count.or_panic == 0
  end.or_panic
  # Back at the joinable outer level: plain blocks join again.
  Parent.transaction do
    Parent.create_strict(name: "Kept").or_panic
    Rollback.new
  end.or_panic
end.or_panic
assert Parent.all.or_panic.map { |parent| parent.name } == ["Kept"]
Parent.adapter.close.or_panic
