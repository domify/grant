import query_spec_helper::{Model, pg_builder, query_fields, with_legacy_implicit_order, ignore_whitespace?}
import grant/adapter/driver::{Value}

with_legacy_implicit_order do
  # count

  # it: counts for where/count queries
  sql = "select count(*) from table where \"name\" = $1"
  assert ignore_whitespace?(pg_builder.where(name: "bob").assembler.count.raw_sql, sql)

  # it: simple counts
  sql = "select count(*) from table"
  assert ignore_whitespace?(pg_builder.assembler.count.raw_sql, sql)

  # it: adds group_by fields for where/count queries
  sql = "select count(*) from table where \"name\" = $1 group by name"
  assert ignore_whitespace?(pg_builder.where(name: "bob").group_by(:name).assembler.count.raw_sql, sql)

  # group_by

  # it: adds group_by for select query
  sql = "select #{query_fields} from table group by name"
  assert ignore_whitespace?(pg_builder.group_by(:name).raw_sql, sql)

  # it: adds multiple group_by for select query
  sql = "select #{query_fields} from table group by name, age"
  assert ignore_whitespace?(pg_builder.group_by([:name, :age]).raw_sql, sql)

  # it: adds chain of group_by for select query
  sql = "select #{query_fields} from table group by id, name, age order by id desc"
  assert ignore_whitespace?(pg_builder.group_by(:id).group_by([:name, :age]).raw_sql, sql)

  # where

  # it: properly numbers fields
  sql = "select #{query_fields} from table where \"name\" = $1 and \"age\" = $2 order by id desc"
  query = pg_builder.where(name: "bob", age: "23")
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == ["bob", "23"] of Value

  # it: property defines IN query
  sql = "SELECT #{query_fields} FROM table WHERE \"date_completed\" IS NULL AND \"status\" IN ($1,$2) ORDER BY id DESC"
  query = pg_builder.where(date_completed: nil, status: ["outstanding", "in_progress"])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == ["outstanding", "in_progress"] of Value

  # it: property defines IN query with numbers
  sql = "SELECT #{query_fields} FROM table WHERE \"date_completed\" IS NULL AND \"id\" IN ($1,$2) ORDER BY id DESC"
  query = pg_builder.where(date_completed: nil, id: [1, 2])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [1_i64, 2_i64] of Value

  # it: property defines IN query with booleans
  sql = "SELECT #{query_fields} FROM table WHERE \"published\" IN ($1,$2) ORDER BY id DESC"
  query = pg_builder.where(published: [true, false])
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [true, false] of Value

  # it: handles raw SQL with ? placeholders
  sql = "select #{query_fields} from table where name = 'bob' and age = $1 and color = $2 order by id desc"
  query = pg_builder.where("name = 'bob'").where("age = ?", 23).where("color = ?", "red")
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [23_i64, "red"] of Value

  # it: converts ? to $N in raw SQL for PG compatibility
  # This is the core fix: querying.cr passes "id = ?" through
  # query.where(), and the PG assembler must convert ? to $1
  sql = "select #{query_fields} from table where id = $1 order by id desc"
  query = pg_builder.where("id = ?", 42)
  assert ignore_whitespace?(query.raw_sql, sql)

  assembler = query.assembler
  assembler.where
  assert assembler.numbered_parameters == [42_i64] of Value

  # order

  # it: uses default sort when no sort is provided
  assert ignore_whitespace?(pg_builder.raw_sql, "select #{query_fields} from table order by id desc")

  # it: uses specified sort when provided
  sql = "select #{query_fields} from table order by id asc"
  assert ignore_whitespace?(pg_builder.order(id: :asc).raw_sql, sql)

  # offset

  # it: adds offset for select query
  sql = "select #{query_fields} from table order by id desc offset 8"
  assert ignore_whitespace?(pg_builder.offset(8).raw_sql, sql)

  # it: adds offset for first query
  sql = "select #{query_fields} from table order by id desc limit 1 offset 3"
  assert ignore_whitespace?(pg_builder.offset(3).assembler.first.raw_sql, sql)

  # limit

  # it: adds limit for select query
  sql = "select #{query_fields} from table order by id desc limit 5"
  assert ignore_whitespace?(pg_builder.limit(5).raw_sql, sql)

  nil
end
