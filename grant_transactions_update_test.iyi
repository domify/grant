import transaction_crud_models::{Parent, Teacher}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/errors::{RecordInvalid}
import std/time::{Time}

Connections.register("sqlite", Connection.open(":memory:").or_panic)
Parent.migrator.drop_and_create.or_panic
Teacher.migrator.drop_and_create.or_panic

# it: updates an object
parent = Parent.new(name: "New Parent")
parent.save_strict.or_panic
assert parent.update(name: "Other parent")
assert parent.name == "Other parent"
assert Parent.find_strict(parent.id).or_panic.name == "Other parent"

# it: allows setting a value to nil
model = Teacher.create_strict(name: "New Parent").or_panic
model.update(name: nil)
assert model.name.nil?
assert Teacher.find_strict(model.id).or_panic.name.nil?

# it: does not update an invalid object
parent = Parent.new(name: "New Parent")
parent.save_strict.or_panic
assert !parent.update(name: "")
assert parent.name == ""
assert Parent.find_strict(parent.id).or_panic.name == "New Parent"

# it: does not update created_at
parent = Parent.new(name: "New Parent")
parent.save_strict.or_panic
created_at = parent.created_at.as(Time)
# Simulating instantiating a new object with same ID.
# Attributes assigned after the record is flagged persisted count as changes.
new_parent = Parent.new
new_parent.id = parent.id
new_parent.new_record = false
new_parent.name = "New New Parent"
new_parent.updated_at = parent.updated_at
new_parent.save_strict.or_panic
saved_parent = Parent.find_strict(parent.id).or_panic
assert saved_parent.name == "New New Parent"
assert saved_parent.created_at == created_at
assert saved_parent.updated_at.as(Time) > created_at

# it: does not update the updated_at field
time = Time.utc(2023, 9, 1)
parent = Parent.create(name: "New Parent")
parent.updated_at = time
parent.update({name: "Other Parent"}, skip_timestamps: true)
assert Parent.find_strict(parent.id).or_panic.updated_at == time

# it: updates an object
parent = Parent.new(name: "New Parent")
parent.save_strict.or_panic
parent.update_strict(name: "Other parent").or_panic
assert parent.name == "Other parent"
assert Parent.find_strict(parent.id).or_panic.name == "Other parent"

# it: does not update but raises an exception
parent = Parent.new(name: "New Parent")
parent.save_strict.or_panic
error = parent.update_strict(name: "")
assert error.is_a?(RecordInvalid)
assert error.as(RecordInvalid).message.includes?("Validation failed")
assert Parent.find_strict(parent.id).or_panic.name == "New Parent"

# it: does not update the updated_at field
time = Time.utc(2023, 9, 1)
parent = Parent.create(name: "New Parent")
parent.updated_at = time
parent.update_strict({name: "Other Parent"}, skip_timestamps: true).or_panic
assert Parent.find_strict(parent.id).or_panic.updated_at == time

Parent.adapter.close.or_panic
