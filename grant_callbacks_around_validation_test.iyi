import grant/base::{Base}
import spec_helper::{register_spec_connections}

class AroundValidationModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table around_validation_models

  column id : Int64, primary: true
  column name : String?

  property log = [] of String

  validates_presence_of :name

  around_validation :wrap_validation

  before_validation do
    log << "before_validation"
  end

  after_validation do
    log << "after_validation"
  end

  private def wrap_validation(block : Proc(Nil))
    log << "around_validation:before"
    block.call
    log << "around_validation:after"
  end
end

# Block-form around_validation
class AroundValidationBlockModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table around_validation_block_models

  column id : Int64, primary: true
  column name : String?

  property log = [] of String

  validates_presence_of :name

  around_validation do |block|
    log << "block:before"
    block.call
    log << "block:after"
  end
end

# Halting around_validation: never call the continuation
class HaltingAroundValidationModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table halting_around_validation_models

  column id : Int64, primary: true
  column name : String?

  property validators_ran = false

  validate :record_ran

  around_validation do |_|
    # intentionally never call block -> validators must not run
  end

  private def record_ran
    @validators_ran = true
    errors << ::Grant::Error::Error.new(:base, "should not appear")
  end
end

register_spec_connections

# it: wraps the validation phase in order
m = AroundValidationModel.new
m.name = "set"
assert m.valid?.or_panic
assert m.log == ["around_validation:before", "before_validation", "after_validation", "around_validation:after"]

# it: still runs validators inside the wrapper (fails when invalid)
m = AroundValidationModel.new
m.name = nil
assert !m.valid?.or_panic
assert m.errors.map { |error| error.field.to_s }.includes?("name")
assert m.log.includes?("around_validation:after")

# it: supports the block form
m = AroundValidationBlockModel.new
m.name = "x"
assert m.valid?.or_panic
assert m.log == ["block:before", "block:after"]

# it: halts validation when the continuation is not called
m = HaltingAroundValidationModel.new
m.valid?.or_panic
assert !m.validators_ran
assert m.errors.empty?
