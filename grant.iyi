module grant

pub import grant/base
pub import grant/settings
import grant/settings::{Settings}
pub import grant/transaction
import grant/connections::{Connections}
import grant/connection_registry::{ConnectionRegistry}
import grant/connection::{Connection}
import grant/transaction::{Options, run}
import grant/errors::{DatabaseError, TransactionIsolationError}

pub def settings : ::Grant::Settings::Settings
  ::Grant::Settings.settings
end

pub def connection(name : String = "sqlite") : ::Grant::Connection::Connection
  selected = ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter?(name, :reading)
  return ::Grant::Connection::Connection.new(->(role : Symbol) { ::Grant::Connections::Connections[name] }) if selected.nil?
  ::Grant::Connection::Connection.new(->(role : Symbol) { ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter(name, role) })
end

pub def transaction(options : Options = Options.new, &block : -> T) : T | Nil | ::Grant::Errors::ErrorBase forall T
  connection.transaction(options) { yield }
end

pub def transaction(name : String, options : Options = Options.new, &block : -> T) : T | Nil | ::Grant::Errors::ErrorBase forall T
  connection(name).transaction(options) { yield }
end


pub def transaction(name : String, isolation : ::Grant::Transaction::IsolationLevel? = nil, readonly : Bool = false, requires_new : Bool = false, joinable : Bool = true, independent : Bool = false, &block : -> T) : T | Nil | ::Grant::Errors::ErrorBase forall T
  connection(name).transaction(Options.new(isolation: isolation, readonly: readonly, requires_new: requires_new, joinable: joinable, independent: independent)) { yield }
end


pub def after_all_transactions_commit(&block : -> Nil) : Nil
  ::Grant::Transaction.after_all_transactions_commit(&block)
end

pub import grant/advisory_lock

pub def with_advisory_lock(key : String, adapter : ::Grant::Adapter::Base::Base? = nil,
                          timeout : ::Std::Time::Span = ::Std::Time::Span.seconds(5_i64),
                          &block : -> T) : T | ::Grant::Error::ErrorBase | Cancelled forall T
  selected = adapter || ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter(::Grant::ConnectionRegistry::ConnectionRegistry.default_database)
  ::Grant::AdvisoryLock.synchronize(selected, key, timeout) { yield }
end
