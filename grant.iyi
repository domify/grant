module grant

pub import grant/base
pub import grant/settings
import grant/settings::{Settings}
pub import grant/transaction
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/transaction::{Options, run}
import grant/errors::{DatabaseError, TransactionIsolationError}

pub def settings : ::Grant::Settings::Settings
  ::Grant::Settings.settings
end

pub def connection(name : String = "sqlite") : Connection
  ::Grant::Connections::Connections[name]
end

pub def transaction(options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
  run(connection, options) { yield }
end

pub def transaction(name : String, options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
  run(connection(name), options) { yield }
end


pub def transaction(name : String, isolation : ::Grant::Transaction::IsolationLevel? = nil, readonly : Bool = false, requires_new : Bool = false, joinable : Bool = true, independent : Bool = false, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
  run(connection(name), Options.new(isolation: isolation, readonly: readonly, requires_new: requires_new, joinable: joinable, independent: independent)) { yield }
end


pub def after_all_transactions_commit(&block : -> Nil) : Nil
  ::Grant::Transaction.after_all_transactions_commit(&block)
end
