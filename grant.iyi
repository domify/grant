module grant

pub import grant/base
pub import grant/transaction
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/transaction::{Options, run}
import grant/errors::{DatabaseError, TransactionIsolationError}

pub def connection(name : String = "sqlite") : Connection
  ::Grant::Connections::Connections[name]
end

pub def transaction(options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
  run(connection, options) { yield }
end

pub def transaction(name : String, options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
  run(connection(name), options) { yield }
end
