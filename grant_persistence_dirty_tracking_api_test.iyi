import grant/base::{Base}
import spec_helper::{register_spec_connections}

class T6PersistenceRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_persistence_records
  column id : Int64, primary: true
  column name : String?
  column note : String?
  column counter : Int32?
  timestamps
end

register_spec_connections

# it: tracks post-initialization assignments on new records with filters
record = T6PersistenceRecord.new(name: "initial")
assert !record.changed?
record.name = "changed"
assert record.changed?
assert record.will_save_change_to_attribute?("name")
assert record.will_save_change_to_name?
assert record.will_save_change_to_name?(from: "initial", to: "changed")
assert !record.will_save_change_to_name?(from: "other")
assert !record.will_save_change_to_name?(to: "other")

T6PersistenceRecord.adapter.close.or_panic
