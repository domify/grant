import grant/base::{Base}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/adapter/sqlite::{Connection, Value}
import std/base64::{Base64}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class W6bLazyUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# Capture the same decrypt log messages at the actual codec boundary. Returned
# errors let the scoped backend and verbosity restore before the result returns.
private def w6b_decrypts(&block : -> T) : Array(String) forall T
  messages = [] of String
  observer = ->(message : String) { messages << message; nil }
  previous = Config.verbose_logging
  Config.verbose_logging = true
  Config.with_operation_observer(observer) { yield }
  Config.verbose_logging = previous
  messages.select { |message| message.starts_with?("decrypt ") }
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "lazy-salt"
register_spec_connections
W6bLazyUser.migrator.drop_and_create.or_panic

# it: does not decrypt String attributes while rows are hydrated
W6bLazyUser.clear.or_panic
5.times { |i| W6bLazyUser.create_strict(name: "n#{i}", email: "u#{i}@example.com", secret: "s#{i}", nickname: "Nick#{i}").or_panic }
rows = [] of W6bLazyUser
decrypts = w6b_decrypts { rows = W6bLazyUser.order(:name).select.or_panic }
assert rows.size == 5
assert decrypts.empty?

# Native ordering regressions cover the structural relation used above.
relation = W6bLazyUser.order(:name)
assert relation.first.or_panic.as(W6bLazyUser).name == "n0"
assert relation.last.or_panic.as(W6bLazyUser).name == "n4"
copied = relation.order(:id)
assert relation.order_fields.size == 1
assert copied.order_fields.size == 2
assert relation.select.or_panic.map { |row| row.name } == ["n0", "n1", "n2", "n3", "n4"]

# it: decrypts on first read and then keeps the value
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(email: "ada@example.com", secret: "hush").or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
first = w6b_decrypts { assert loaded.email.or_panic == "ada@example.com" }
assert first.size == 1
assert first.first.includes?("W6bLazyUser.email")
assert w6b_decrypts { assert loaded.email.or_panic == "ada@example.com" }.empty?
assert w6b_decrypts { assert loaded.email?.or_panic == "ada@example.com"; assert loaded.email_strict.or_panic == "ada@example.com" }.empty?
# Reading one attribute leaves the others sealed.
assert w6b_decrypts { assert loaded.secret.or_panic == "hush" }.size == 1

# it: loads a row whose ciphertext cannot be opened and fails only on read
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(name: "a", secret: "hush").or_panic
# A random 64-byte string is shorter than the minimum authenticated payload.
corrupt = Base64.encode(Cipher.random_bytes(64).or_panic)
W6bLazyUser.__connection.execute("UPDATE w6b_lazy_users SET secret = ? WHERE id = ?", [corrupt, user.id] of Value).or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
assert loaded.name == "a"
assert loaded.secret.is_a?(DecryptionError)
assert loaded.secret.is_a?(DecryptionError)

# Native regressions: a nil strict read is a returned error, and error block
# results restore a nested log backend and verbosity just like ordinary blocks.
assert W6bLazyUser.new.email_strict.is_a?(::Grant::Encryption::Sealed::NilAssertionError)
previous = Config.verbose_logging
assert w6b_decrypts { loaded.secret }.empty?
assert Config.verbose_logging == previous
outer = [] of String
observer = ->(message : String) { outer << message; nil }
Config.verbose_logging = true
Config.with_operation_observer(observer) do
  w6b_decrypts { loaded.secret }
  W6bLazyUser.email_encrypted_attribute.open(W6bLazyUser.email_encrypted_attribute.seal("restored").or_panic).or_panic
end
assert outer.any? { |message| message.starts_with?("decrypt W6bLazyUser.email") }
Config.verbose_logging = previous

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
W6bLazyUser.__connection.close.or_panic
