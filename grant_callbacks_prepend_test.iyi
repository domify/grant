import grant/base::{Base}
import spec_helper::{register_spec_connections}

class PrependCallbackModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table prepend_callback_models

  column id : Int64, primary: true
  column name : String?

  property log : Array(String) = [] of String

  before_save { log << "first" }
  before_save :second
  before_save :prepended_a, :prepended_b, prepend: true
  before_save(prepend: true) { log << "block_prepended" }
  around_save :around_inner
  around_save :around_outer, prepend: true

  private def second
    log << "second"
  end

  private def prepended_a
    log << "prepended_a"
  end

  private def prepended_b
    log << "prepended_b"
  end

  private def around_inner(block : Proc(Nil))
    log << "inner_in"
    block.call
  end

  private def around_outer(block : Proc(Nil))
    log << "outer_in"
    block.call
  end
end

register_spec_connections
PrependCallbackModel.migrator.drop_and_create.or_panic

# it: runs prepended before callbacks first, keeping their given order
record = PrependCallbackModel.new(name: "a")
record.before_save.or_panic
assert record.log == ["block_prepended", "prepended_a", "prepended_b", "first", "second"]

# it: makes a prepended around callback outermost
record = PrependCallbackModel.new(name: "a")
assert record.save
assert record.log.select { |entry| entry.ends_with?("_in") } == ["outer_in", "inner_in"]
