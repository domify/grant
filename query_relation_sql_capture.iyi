module query_relation_sql_capture

import transaction_crud_models::{Parent}

# Native statement observer corresponding to support/relation_sql_capture.cr.
pub def capture_sql(&block : -> T) : Array(String) forall T
  statements = [] of String
  Parent.adapter.with_connection do |db|
    previous = db.query_observer
    db.query_observer = ->(sql : String) { statements << sql; nil }
    yield
    db.query_observer = previous
    nil
  end.or_panic
  statements
end

pub def seed_parents(names : Array(String)) : Array(Parent)
  Parent.clear.or_panic
  names.map { |name| Parent.create_strict(name: name).or_panic }
end
