import grant
import grant/base::{Base}
import w6_c04_support::{W6C04}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

W6C04.provision("w6_sql", ["CREATE TABLE w6_sql_things (#{W6C04.id_column}, label TEXT, amount BIGINT)"])
W6C04.establish("w6_sql", "w6_sql", :primary)
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
W6C04.exec("w6_sql", "INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)")
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of the connection facade
w6_failure("missing_col") { Grant.connection("w6_sql").select_all("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { Grant.connection("w6_sql").select_value("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { Grant.connection("w6_sql").select_rows("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { Grant.connection("w6_sql").exec_query("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { Grant.connection("w6_sql").with_result_set("SELECT missing_col FROM w6_sql_things") { |_| nil } }

# Native success checks exercise buffered and live statement paths as well.
facade = Grant.connection("w6_sql")
result = facade.exec_query("SELECT label, amount FROM w6_sql_things").or_panic
assert result.columns == ["label", "amount"]
assert result.rows == [["a", 1_i64] of ::Grant::Adapter::Driver::Value]
assert result.to_a.first["label"] == "a"
assert facade.select_rows("SELECT label, amount FROM w6_sql_things").or_panic == result.rows
assert facade.select_value("SELECT amount FROM w6_sql_things").or_panic == 1_i64
assert facade.select_values("SELECT label FROM w6_sql_things").or_panic == ["a"]
assert facade.select_one("SELECT label FROM w6_sql_things").or_panic.as(Hash(String, ::Grant::Adapter::Driver::Value))["label"] == "a"
assert facade.select_value("SELECT amount FROM w6_sql_things WHERE amount = ?", [9_i64] of ::Grant::Adapter::Driver::Value).or_panic.nil?
seen = [] of String
facade.with_result_set("SELECT label FROM w6_sql_things") do |rs|
  rs.each { seen << rs.read.or_panic.as(String); nil }
end.or_panic
assert seen == ["a"]
failure = facade.with_result_set("SELECT label FROM w6_sql_things") { |_| ::Grant::Error::ErrorBase.new("stop") }
assert failure.is_a?(::Grant::Error::ErrorBase)
assert failure.as(::Grant::Error::ErrorBase).message == "stop"
assert facade.select_value("SELECT COUNT(*) FROM w6_sql_things").or_panic == 1_i64


W6C04.remove("w6_sql", :primary)
W6C04.cleanup
