import grant/base::{Base}
import grant/encryption/sealed::{ArgumentError}
import grant/encryption/sealed

class W6bLazyUser < Base
  connection sqlite
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# it: rejects plaintext that collides with the internal sealed marker
error = (W6bLazyUser.new.secret = ::Grant::Encryption::Sealed::PREFIX + "x")
assert error.is_a?(ArgumentError)
assert error.as(ArgumentError).message.includes?("reserved")
assert W6bLazyUser.new(secret: ::Grant::Encryption::Sealed::PREFIX + "x").errors.map { |e| e.message.to_s }.first.includes?("reserved")

# Native guard regressions: byte-preserving marker handling and rejected
# assignment leave the existing value intact; ordinary assignment clears errors.
sealed = ::Grant::Encryption::Sealed.wrap("café\u0000ciphertext")
assert ::Grant::Encryption::Sealed.sealed?(sealed)
assert ::Grant::Encryption::Sealed.stored(sealed) == "café\u0000ciphertext"
assert !::Grant::Encryption::Sealed.sealed?("grant-sealed:x")
assert ::Grant::Encryption::Sealed.guard_plaintext_strict("secret", nil).nil?
user = W6bLazyUser.new(secret: "hush")
assert (user.secret = ::Grant::Encryption::Sealed::PREFIX + "bad").is_a?(ArgumentError)
assert user.secret == "hush"
user = W6bLazyUser.new(secret: ::Grant::Encryption::Sealed::PREFIX + "bad")
assert user.errors.first.is_a?(::Grant::Error::ConversionError)
assert user.errors.first.field == :secret
assert user.secret.nil?
(user.secret = "valid").or_panic
assert user.errors.empty?
assert user.secret == "valid"

# The same refused setter is captured on the attributes-hash path.
user = W6bLazyUser.new
user.assign_attributes({"secret" => ::Grant::Encryption::Sealed::PREFIX + "bad"})
assert user.errors.first.is_a?(::Grant::Error::ConversionError)
assert user.errors.first.message.includes?("reserved")
assert user.secret.nil?
user.assign_attributes({"secret" => "valid"})
assert user.errors.empty?
assert user.secret == "valid"
