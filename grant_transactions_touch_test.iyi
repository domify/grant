import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/error::{ErrorBase}
import std/time::{Time, Span}

class TimeTest < Base
  connection sqlite
  table times
  column id : Int64, primary: true
  column test : Time?
  column name : String?
  timestamps
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
TimeTest.migrator.drop_and_create.or_panic

# it: should raise on new record
error = TimeTest.new.touch
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "Cannot touch on a new record object"

# it: should raise on non existent field
model = TimeTest.create(name: "foo")
error = model.touch(:foo)
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "Field 'foo' does not exist on type 'TimeTest'."

# it: should raise on non `Time` field
model = TimeTest.create(name: "foo")
error = model.touch(:name)
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "TimeTest.name cannot be touched.  It is not of type `Time`."

# it: updates updated_at on an object
old_time = Time.utc(2000, 1, 1) + Span.nanoseconds(123_456_000_i64)
object = TimeTest.create(test: old_time)
object.created_at = old_time
object.updated_at = old_time
object.save_strict(skip_timestamps: true).or_panic
object.touch.or_panic
assert object.updated_at.as(Time) > old_time
assert object.test == old_time
assert object.created_at == old_time

# it: updates updated_at + custom fields on an object
old_time = Time.utc(2000, 1, 1) + Span.nanoseconds(123_456_000_i64)
object = TimeTest.create(test: old_time)
object.created_at = old_time
object.updated_at = old_time
object.save_strict(skip_timestamps: true).or_panic
object.touch("test").or_panic
assert object.updated_at.as(Time) > old_time
assert object.test.as(Time) > old_time
assert object.created_at == old_time
TimeTest.adapter.close.or_panic
