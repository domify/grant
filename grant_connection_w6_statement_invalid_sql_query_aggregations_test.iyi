import grant
import std/file::{File}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

path = File.tempfile("w6_sql", ".sqlite3")
ConnectionRegistry.establish_connection(database: "w6_sql", adapter: Sqlite, url: "sqlite3:#{path}", role: :primary).or_panic
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
adapter.open { |db| db.exec("CREATE TABLE w6_sql_things (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT, amount BIGINT)") }.or_panic
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)") }.or_panic
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of the aggregations
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").sum(:amount) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").avg(:amount) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").min(:amount) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").max(:amount) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").group_records(:label).count }

# Native success checks cover bound relations, integer precision, NULLs and
# copied grouping state using real SQLite aggregates.
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('a', 3), ('b', 9), (NULL, NULL)") }.or_panic
relation = W6SqlThing.where("label = ?", "a")
assert relation.sum(:amount).or_panic == 4_i64
assert relation.avg(:amount).or_panic == 2.0
assert relation.min(:amount).or_panic == 1_i64
assert relation.max(:amount).or_panic == 3_i64
assert relation.average(:amount).or_panic == 2.0
assert relation.minimum(:amount).or_panic == 1_i64
assert relation.maximum(:amount).or_panic == 3_i64
empty = relation.where("amount > ?", 10_i64)
assert empty.sum(:amount).or_panic == 0_i64
assert empty.avg(:amount).or_panic.nil?
assert empty.min(:amount).or_panic.nil?
assert empty.max(:amount).or_panic.nil?
grouped = W6SqlThing.where("1 = 1").group_records(:label)
counts = grouped.count.or_panic.as(Hash(::Grant::Adapter::Sqlite::Value, Int64))
assert counts["a"] == 2_i64
assert counts["b"] == 1_i64
assert counts[nil] == 1_i64
sums = grouped.sum(:amount).or_panic.as(Hash(::Grant::Adapter::Sqlite::Value, ::Grant::Adapter::Sqlite::Value))
assert sums["a"] == 4_i64
assert sums["b"] == 9_i64
assert sums[nil] == 0_i64
assert relation.count.or_panic == 2_i64
assert relation.group_records(:label, :amount).count.or_panic.as(Hash(Array(::Grant::Adapter::Sqlite::Value), Int64))[(["a", 1_i64] of ::Grant::Adapter::Sqlite::Value)] == 1_i64
assert relation.count.or_panic == 2_i64
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('exact', 9007199254740993)") }.or_panic
assert W6SqlThing.where("label = ?", "exact").sum(:amount).or_panic == 9007199254740993_i64

ConnectionRegistry.remove_connection("w6_sql", :primary).or_panic
File.delete(path)
