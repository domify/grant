import transaction_crud_models::{Parent}
import spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: creates on find_or_create when not found
Parent.clear
Parent.find_or_create_by(name: "name").or_panic
assert     Parent.first_strict.or_panic.name == "name"
assert !    Parent.first_strict.or_panic.new_record?

# it: uses find on find_or_create_by when it exists
Parent.clear
Parent.create(name: "name")
Parent.find_or_create_by(name: "name").or_panic
assert     Parent.count == 1

# it: uses find on find_or_initialize_by when it exists
Parent.clear
Parent.create(name: "name")
parent = Parent.find_or_initialize_by(name: "name").or_panic
assert !    parent.new_record?

# it: initializes with find_or_initialize when not found
Parent.clear
parent = Parent.find_or_initialize_by(name: "gnome").or_panic
assert     parent.new_record?

Parent.adapter.close.or_panic
