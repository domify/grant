import std/file::{File}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/sqlite_connection::{SQLiteError}
import grant/connection_registry::{ConnectionRegistry}
import grant/database::{PoolTimeout}
import grant/error_taxonomy::{ConnectionTimeoutError, ConnectionNotEstablished, LockWaitTimeout, StatementInvalid}
import grant/adapter/pool_support::{ticks}
import grant/error::{ErrorBase}

class G01Account < Base
  connection sqlite
  connects_to database: "g01"
  table g01_accounts
  column id : Int64, primary: true
  column email : String
  column code : String?
end

ConnectionRegistry.establish_connection(database: "g01", adapter: Sqlite, url: "sqlite3::memory:").or_panic

# it: raises ConnectionTimeoutError when no connection frees up in time
adapter_url = "sqlite3::memory:"
separator = adapter_url.includes?("?") ? '&' : '?'
url = "#{adapter_url}#{separator}max_pool_size=1&checkout_timeout=0.2"
adapter = G01Account.adapter.class.new(name: "g01_pool_timeout", url: url)
database = adapter.database.or_panic
started = ticks
database.using_connection do |_held|
  error = adapter.open("SELECT 1") { |db| db.scalar("SELECT 1") }
  assert error.is_a?(ConnectionTimeoutError)
  assert error.is_a?(ConnectionNotEstablished)
  assert error.as(ConnectionTimeoutError).cause.is_a?(PoolTimeout)
end.or_panic
assert ticks - started >= 200
assert adapter.pool_stat.busy == 0
assert adapter.pool_stat.waiting == 0
assert adapter.open("SELECT 1") { |db| db.scalar("SELECT 1") }.or_panic == 1
database.close.or_panic

# it: raises LockWaitTimeout when another connection holds the write lock
path = File.tempfile("g01_busy", ".sqlite3")
adapter = Sqlite.new(name: "g01_busy", url: "sqlite3:#{path}?busy_timeout=0")
adapter.open { |db| db.exec("CREATE TABLE busy_rows (id INTEGER PRIMARY KEY)") }.or_panic
database = adapter.database.or_panic
database.using_connection do |holder|
  holder.exec("BEGIN IMMEDIATE").or_panic
  statement = "INSERT INTO busy_rows (id) VALUES (1)"
  error = adapter.open_pool_connection(statement) do |db|
    assert db.object_id != holder.object_id
    assert db.scalar("PRAGMA busy_timeout").or_panic == 0
    db.exec(statement)
  end
  assert error.is_a?(LockWaitTimeout)
  assert error.as(LockWaitTimeout).cause.is_a?(SQLiteError)
  assert error.is_a?(StatementInvalid)
  assert error.as(LockWaitTimeout).sql == statement
  assert error.as(LockWaitTimeout).code == 5
  holder.exec("ROLLBACK").or_panic
end.or_panic
# Statement failure leaves both the pool and the database usable.
assert adapter.pool_stat.busy == 0
assert adapter.pool_stat.waiting == 0
assert adapter.open { |db| db.scalar("SELECT COUNT(*) FROM busy_rows") }.or_panic == 0
adapter.open_pool_connection { |db| db.exec("INSERT INTO busy_rows VALUES (1)") }.or_panic
assert adapter.open { |db| db.scalar("SELECT COUNT(*) FROM busy_rows") }.or_panic == 1
assert adapter.busy_timeout_ms == 0
database.close.or_panic
File.delete(path)
File.delete("#{path}-wal") if File.exists?("#{path}-wal")
File.delete("#{path}-shm") if File.exists?("#{path}-shm")

# Raw pool ownership releases reservations when a block returns an error.
adapter = Sqlite.new(name: "g01_release", url: "sqlite3::memory:?max_pool_size=1")
database = adapter.database.or_panic
returned = database.using_connection { |_| ErrorBase.new("block error") }
assert returned.is_a?(ErrorBase)
assert returned.as(ErrorBase).message == "block error"
assert adapter.pool_stat.busy == 0
assert adapter.open { |db| db.scalar("SELECT 1") }.or_panic == 1
database.close.or_panic
