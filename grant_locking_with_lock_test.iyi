import grant/base::{Base}
import grant/locking::{LockMode}
import grant/errors::{RecordNotFound, TransactionIsolationError, Rollback}
import grant/error::{ErrorBase}
import transaction_sql_recorder
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class WithLockSpecAccount < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table with_lock_spec_accounts
  column id : Int64, primary: true
  column owner : String
  column balance : Int32 = 0
end

register_spec_connections
WithLockSpecAccount.migrator.drop_and_create.or_panic

# it: returns a non-nil value with its type
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 10).or_panic
balance = account.with_lock { |locked| locked.balance }.or_panic
assert balance == 10
assert typeof(balance).to_s == Int32.to_s

# it: returns nil when the block's value is nil
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 10).or_panic
value = account.with_lock do |locked|
  locked.update_strict(balance: 11).or_panic
  nil
end.or_panic
assert value.nil?
assert typeof(value).to_s == Nil.to_s
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 11

# it: returns a falsy value without treating it as missing
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
assert account.with_lock { |_locked| false }.or_panic == false

# it: gives the class-level forms the same generic return
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 3).or_panic
assert WithLockSpecAccount.with_lock(account.id) { |locked| locked.owner }.or_panic == "Ada"
assert WithLockSpecAccount.with_lock(account.id) { |_locked| nil }.or_panic.nil?
assert WithLockSpecAccount.with_lock { |locked| locked.balance }.or_panic == 3

# it: yields the current row, not the stale in-memory copy
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 10).or_panic
WithLockSpecAccount.where(id: account.id).update_all(balance: 99).or_panic
assert account.balance == 10
seen = account.with_lock { |locked| locked.balance }.or_panic
assert seen == 99
assert account.balance == 99
assert !account.changed?

# it: yields the receiver itself
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
assert account.with_lock { |locked| locked.object_id == account.object_id }.or_panic

# it: takes the lock with one SELECT round trip
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
queries = [] of String
connection = WithLockSpecAccount.__connection
previous = connection.query_observer
connection.query_observer = ->(sql : String) { queries << sql; nil }
account.with_lock { |locked| locked.balance }.or_panic
connection.query_observer = previous
selects = queries.select { |sql| sql.starts_with?("SELECT") }
assert selects.size == 1
if WithLockSpecAccount.adapter.supports_lock_mode?(LockMode::Update)
  assert selects.first.includes?("FOR UPDATE")
end

# it: commits the block's writes and rolls them back on an exception
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
account.with_lock { |locked| locked.update_strict(balance: 2).or_panic }.or_panic
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 2
error = account.with_lock do |locked|
  locked.update_strict(balance: 3).or_panic
  ErrorBase.new("boom")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "boom"
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 2

# it: raises RecordNotFound for a row that is gone
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
WithLockSpecAccount.where(id: account.id).delete_all.or_panic
assert account.with_lock { |_locked| 1 }.is_a?(RecordNotFound)

# it: joins the open transaction by default
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
statements = TransactionSqlRecorder.record do
  WithLockSpecAccount.transaction do
    account.with_lock { |locked| locked.balance }
  end.or_panic
end
assert TransactionSqlRecorder.begins(statements).size == 1
assert statements.none? { |sql| sql.starts_with?("SAVEPOINT") }

# it: opens a savepoint inside an open transaction
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
statements = TransactionSqlRecorder.record do
  WithLockSpecAccount.transaction do
    account.with_lock(requires_new: true) { |locked| locked.balance }
  end.or_panic
end
assert TransactionSqlRecorder.begins(statements).size == 1
assert statements.any? { |sql| sql.starts_with?("SAVEPOINT") }

# it: undoes only the inner work when the savepoint block fails
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
WithLockSpecAccount.transaction do
  WithLockSpecAccount.create_strict(owner: "Outer", balance: 5).or_panic
  error = account.with_lock(requires_new: true) do |locked|
    locked.update_strict(balance: 100).or_panic
    ErrorBase.new("inner failure")
  end
  if error.is_a?(ErrorBase)
    assert error.message == "inner failure"
  end
end.or_panic
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 1
assert WithLockSpecAccount.where(owner: "Outer").count.or_panic == 1

# it: opens the outermost transaction at the requested level
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
statements = TransactionSqlRecorder.record do
  account.with_lock(isolation: Grant::Transaction::IsolationLevel::Serializable) { |locked| locked.balance }.or_panic
end
begin_statement = TransactionSqlRecorder.begins(statements).first
if WithLockSpecAccount.adapter.postgres?
  assert begin_statement.includes?("ISOLATION LEVEL SERIALIZABLE")
elsif WithLockSpecAccount.adapter.sqlite?
  assert begin_statement == "BEGIN EXCLUSIVE"
else
  assert statements.any?(&.includes?("ISOLATION LEVEL SERIALIZABLE"))
end

# it: refuses an isolation level inside a transaction that is already open
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
error = WithLockSpecAccount.transaction do
  account.with_lock(isolation: Grant::Transaction::IsolationLevel::Serializable) { |_locked| 1 }
end
assert error.is_a?(TransactionIsolationError)

# it: takes the isolation level on the class-level forms too
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
error = WithLockSpecAccount.transaction do
  WithLockSpecAccount.with_lock(account.id, isolation: Grant::Transaction::IsolationLevel::ReadCommitted) { |_locked| 1 }
end
assert error.is_a?(TransactionIsolationError)

# it: undoes the work and raises Rollback again, since there is no value to return
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
error = account.with_lock do |locked|
  locked.update_strict(balance: 50).or_panic
  Rollback.new
end
assert error.is_a?(Rollback)
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 1

# it: are refused by lock! where the adapter takes real locks, so the lock is never silently dropped
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic

if WithLockSpecAccount.adapter.supports_lock_mode?(LockMode::Update)
  assert account.lock_strict.is_a?(Grant::Locking::Pessimistic::TransactionRequiredError)
else
  assert account.lock_strict.or_panic == account
end

# it: are allowed inside a transaction
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada").or_panic
assert WithLockSpecAccount.transaction { account.lock_strict.or_panic.object_id == account.object_id }.or_panic == true

# Native error-result checks also verify transaction cleanup and force guards.
WithLockSpecAccount.clear.or_panic
account = WithLockSpecAccount.create_strict(owner: "Ada", balance: 1).or_panic
account.balance = 20
error = account.with_lock { |_locked| 1 }
assert error.is_a?(Grant::Locking::Pessimistic::UnsavedChangesLockError)
assert account.balance == 20
assert account.changed?
assert !WithLockSpecAccount.__connection.in_transaction?
assert account.with_lock(force: true) { |locked| locked.balance }.or_panic == 1
assert !account.changed?
rollback = Rollback.new
error = WithLockSpecAccount.with_lock(account.id) do |locked|
  locked.update_strict(balance: 12).or_panic
  rollback
end
assert error.is_a?(Rollback)
assert WithLockSpecAccount.find_strict(account.id).or_panic.balance == 1
assert WithLockSpecAccount.with_lock { |_locked| false }.or_panic == false
WithLockSpecAccount.where(id: account.id).delete_all.or_panic
assert account.with_lock { |_locked| 1 }.is_a?(RecordNotFound)
assert WithLockSpecAccount.with_lock(account.id) { |_locked| 1 }.is_a?(RecordNotFound)
assert WithLockSpecAccount.with_lock { |_locked| 1 }.is_a?(RecordNotFound)
assert !WithLockSpecAccount.__connection.in_transaction?
assert WithLockSpecAccount.create_strict(owner: "Recovered").or_panic.balance == 0
