import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/errors::{ErrorBase, TransactionIsolationError}
import grant/transaction::{Options, IsolationLevel, begin_statements}
import transaction_sql_recorder::{record}

class Parent < Base
  connection sqlite
  table parents
  column id : Int64, primary: true
  column name : String?
end

def statements_for(adapter : Connection, isolation : IsolationLevel? = nil) : Array(String)
  begin_statements(adapter, Options.new(isolation: isolation))
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
Parent.migrator.drop_and_create.or_panic
sqlite = Connection.open(":memory:").or_panic

# it: maps levels onto BEGIN variants
assert statements_for(sqlite) == ["BEGIN"]
assert statements_for(sqlite, isolation: IsolationLevel::ReadUncommitted) == ["BEGIN DEFERRED"]
assert statements_for(sqlite, isolation: IsolationLevel::ReadCommitted) == ["BEGIN IMMEDIATE"]
assert statements_for(sqlite, isolation: IsolationLevel::RepeatableRead) == ["BEGIN IMMEDIATE"]
assert statements_for(sqlite, isolation: IsolationLevel::Serializable) == ["BEGIN EXCLUSIVE"]

# it: sends the statements built for the active adapter when a transaction opens
adapter = Parent.adapter
expected = begin_statements(adapter, Options.new(isolation: IsolationLevel::Serializable))
statements = record do
  Parent.transaction(isolation: IsolationLevel::Serializable) { nil }.or_panic
end
assert statements == expected + ["COMMIT"]

# it: raises TransactionIsolationError for a joined block
error = Parent.transaction do
  Parent.transaction(isolation: IsolationLevel::Serializable) { nil }
end
assert error.is_a?(TransactionIsolationError)

# it: raises TransactionIsolationError for a savepoint block
error = Parent.transaction do
  Parent.transaction(isolation: IsolationLevel::ReadCommitted, requires_new: true) { nil }
end
assert error.is_a?(TransactionIsolationError)

# it: leaves the outer transaction usable when the caller rescues the error
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Outer").or_panic
  error = Parent.transaction(isolation: IsolationLevel::Serializable) { nil }
  if error.is_a?(TransactionIsolationError)
    nil
  else
    error
  end
end.or_panic
assert Parent.count.or_panic == 1

# it: allows an isolation level on an independent transaction
Parent.transaction do
  assert Parent.transaction(isolation: IsolationLevel::ReadCommitted, independent: true) { 1 }.or_panic == 1
end.or_panic

# it: is an ErrorBase
assert TransactionIsolationError.new.is_a?(ErrorBase)
sqlite.close.or_panic
Parent.adapter.close.or_panic
