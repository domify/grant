import grant/base::{Base}
import grant/locking::{LockMode}
import grant/errors::{RecordNotFound}
import spec_helper::{register_spec_connections}

class LockWaitSpecJob < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table lock_wait_spec_jobs

  column id : Int64, primary: true
  column state : String
end

register_spec_connections
LockWaitSpecJob.migrator.drop_and_create.or_panic

private def lock_wait_spec_real_locks? : Bool
  LockWaitSpecJob.adapter.supports_lock_mode?(LockMode::Update)
end

# it: renders each lock mode for the adapter, and nothing on SQLite
LockWaitSpecJob.clear.or_panic
{
  LockMode::UpdateNoWait => "FOR UPDATE NOWAIT",
  LockMode::UpdateSkipLocked => "FOR UPDATE SKIP LOCKED",
}.each do |mode, expected|
  sql = LockWaitSpecJob.where(id: 1_i64).lock(mode).to_sql
  if lock_wait_spec_real_locks?
    assert sql.ends_with?(expected)
  else
    assert !sql.includes?("FOR ")
    assert !sql.includes?("NOWAIT")
    assert !sql.includes?("SKIP LOCKED")
  end
end

# it: returns the row on the same connection: a lock never blocks its own transaction
LockWaitSpecJob.clear.or_panic
job = LockWaitSpecJob.create_strict(state: "queued").or_panic
LockWaitSpecJob.transaction do
  assert LockWaitSpecJob.where(id: job.id).lock.first_strict.or_panic.state == "queued"
  assert LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateNoWait).first_strict.or_panic.state == "queued"
  assert LockWaitSpecJob.where(id: job.id).lock(LockMode::UpdateSkipLocked).first_strict.or_panic.state == "queued"
end.or_panic

# Additional native checks verify chain isolation and strict missing-row errors.
relation = LockWaitSpecJob.where(id: job.id)
locked = relation.lock(LockMode::Share)
assert relation.lock_mode.nil?
assert locked.lock_mode == LockMode::Share
assert locked.where("state = ?", "queued").lock_mode == LockMode::Share
assert locked.lock_in_place(LockMode::Update).object_id == locked.object_id
assert locked.lock_mode == LockMode::Update
if lock_wait_spec_real_locks?
  assert locked.to_sql == "#{relation.to_sql} FOR UPDATE"
else
  assert locked.to_sql == relation.to_sql
end
assert LockWaitSpecJob.where(id: -1_i64).lock.first_strict.is_a?(RecordNotFound)
assert lock_wait_spec_real_locks? == LockWaitSpecJob.adapter.postgres?
