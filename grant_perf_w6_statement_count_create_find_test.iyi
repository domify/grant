import grant/base::{Base}
import grant/errors::{RecordNotFound, ErrorBase}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Native counterpart of the upstream db log backend: observe statements at
# the driver's actual prepare boundary, including transaction control.
class W6PerfStatementLog
  getter list_of_statements = [] of String
end
W6_PERF_STATEMENT_LOG = W6PerfStatementLog.new
W6_PERF_BEGIN = "BEGIN"

private def w6_perf_statements(&block : -> T) : Array(String) forall T
  W6_PERF_STATEMENT_LOG.list_of_statements.clear
  connection = W6PerfPerson.__connection
  previous = connection.query_observer
  connection.query_observer = ->(sql : String) { W6_PERF_STATEMENT_LOG.list_of_statements << sql; nil }
  yield
  connection.query_observer = previous
  W6_PERF_STATEMENT_LOG.list_of_statements.dup
end

class W6PerfPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_people
  column id : Int64, primary: true
  column name : String
  column score : Int32?
  timestamps
end

class W6PerfAuditedPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_audited_people
  column id : Int64, primary: true
  column name : String
  column touches : Int32 = 0
  before_save :write_audit_row

  private def write_audit_row
    W6PerfPerson.create_strict(name: "audit of #{name}").or_panic
  end
end

private def reset
  W6PerfPerson.clear.or_panic
  W6PerfAuditedPerson.clear.or_panic
end

register_spec_connections
W6PerfPerson.migrator.drop_and_create.or_panic
W6PerfAuditedPerson.migrator.drop_and_create.or_panic

# it: runs BEGIN, INSERT and COMMIT and nothing else
reset
person = nil.as(W6PerfPerson?)
statements = w6_perf_statements do
  person = W6PerfPerson.create_strict(name: "Ada", score: 3).or_panic
end
assert statements.size == 3
assert statements[0].starts_with?(W6_PERF_BEGIN)
assert statements[1].starts_with?("INSERT INTO")
assert statements[2] == "COMMIT"
assert !person.as(W6PerfPerson).id.nil?
assert W6PerfPerson.find_strict(person.as(W6PerfPerson).id).or_panic.name == "Ada"

# it: reports the generated id without a second query
reset
first = W6PerfPerson.create_strict(name: "one").or_panic
second = W6PerfPerson.create_strict(name: "two").or_panic
assert second.id.as(Int64) > first.id.as(Int64)
assert W6PerfPerson.find_strict(second.id).or_panic.name == "two"

# it: runs one INSERT for a build-then-save as well
reset
person = W6PerfPerson.new(name: "built")
statements = w6_perf_statements { assert person.save }
assert statements.map { |sql| sql.split(' ').first } == [W6_PERF_BEGIN.split(' ').first, "INSERT", "COMMIT"]

# it: runs one SELECT
reset
person = W6PerfPerson.create_strict(name: "Grace").or_panic
found = nil.as(W6PerfPerson?)
statements = w6_perf_statements { found = W6PerfPerson.find(person.id).or_panic }
assert statements.size == 1
assert statements[0].starts_with?("SELECT")
assert found.as(W6PerfPerson).name == "Grace"

# it: find! runs one SELECT and find returns nil for a missing key
reset
person = W6PerfPerson.create_strict(name: "Hopper").or_panic
statements = w6_perf_statements { assert W6PerfPerson.find_strict(person.id).or_panic.name == "Hopper" }
assert statements.size == 1
assert W6PerfPerson.find(-1_i64).or_panic.nil?
assert W6PerfPerson.find_strict(-1_i64).is_a?(RecordNotFound)

# it: builds the same statement as the relation it replaces
reset
person = W6PerfPerson.create_strict(name: "Lovelace").or_panic
kept = w6_perf_statements { W6PerfPerson.find(person.id).or_panic }
relation = w6_perf_statements { W6PerfPerson.where(:id, :eq, person.id).or_panic.first.or_panic }
assert kept == relation

# Native checks verify bound operator calls and returned unsupported-operator
# errors without mutating the original relation.
base = W6PerfPerson.where("name = ?", "Lovelace")
assert base.where(:score, :gt, 10_i64).or_panic.select.or_panic.empty?
assert base.first.or_panic.as(W6PerfPerson).name == "Lovelace"
assert W6PerfPerson.where(:name, :unsupported, "Lovelace").is_a?(ErrorBase)
assert base.where(:name, :like, "Love%").or_panic.first.or_panic.as(W6PerfPerson).name == "Lovelace"
W6PerfPerson.__connection.close.or_panic
