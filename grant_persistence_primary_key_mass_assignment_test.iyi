import grant/base::{Base}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class T6MassAssignmentPrimaryKeyRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_mass_assignment_primary_key_records
  column id : Int64, primary: true
  column name : String
end

register_spec_connections
T6MassAssignmentPrimaryKeyRecord.migrator.drop_and_create.or_panic
T6MassAssignmentPrimaryKeyRecord.clear.or_panic

# it: preserves an explicitly assigned auto-generated primary key
record = T6MassAssignmentPrimaryKeyRecord.create_strict(id: 501_i64, name: "explicit").or_panic
assert record.id == 501_i64
assert T6MassAssignmentPrimaryKeyRecord.find_strict(501_i64).or_panic.name == "explicit"

T6MassAssignmentPrimaryKeyRecord.adapter.close.or_panic
