import grant/base::{Base}
import grant/errors::{RecordNotFound}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class W6LookupPlain < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_plains

  column id : Int64, primary: true
  column label : String
end

class W6LookupSlug < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_slugs

  column slug : String, primary: true, auto: false
  column label : String
end

private def reset
  W6LookupPlain.clear.or_panic
  W6LookupSlug.clear.or_panic
end

register_spec_connections
W6LookupPlain.migrator.drop_and_create.or_panic
W6LookupSlug.migrator.drop_and_create.or_panic

# it: finds a record of a model with no scope, again and again
reset
plain = W6LookupPlain.create_strict(label: "p").or_panic
3.times { assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "p" }
assert W6LookupPlain.find_strict(plain.id).or_panic.label == "p"

# it: accepts Int32 and String keys for an integer column like the relation does
reset
plain = W6LookupPlain.create_strict(label: "k").or_panic
assert W6LookupPlain.find(plain.id.as(Int64).to_i32).or_panic.as(W6LookupPlain).label == "k"
assert W6LookupPlain.find(plain.id.to_s).or_panic.as(W6LookupPlain).label == "k"

# it: finds a record by a String primary key
reset
W6LookupSlug.create_strict(slug: "alpha", label: "first").or_panic
assert W6LookupSlug.find("alpha").or_panic.as(W6LookupSlug).label == "first"
assert W6LookupSlug.find("missing").or_panic.nil?

# it: reads inside an open transaction
reset
plain = W6LookupPlain.create_strict(label: "tx").or_panic
W6LookupPlain.transaction do
  assert W6LookupPlain.find(plain.id).or_panic.as(W6LookupPlain).label == "tx"
end.or_panic

# Native checks cover the strict Int32 variant, missing keys and the actual
# SQL/bind route shared by key lookups and relation reads.
plain = W6LookupPlain.create_strict(label: "bound").or_panic
key = plain.id.as(Int64).to_i32
assert W6LookupPlain.find_strict(key).or_panic.label == "bound"
assert W6LookupPlain.find(-1_i32).or_panic.nil?
assert W6LookupPlain.find_strict(-1_i32).is_a?(RecordNotFound)
statements = [] of String
driver = W6LookupPlain.__connection
driver.query_observer = ->(sql : String) { statements << sql; nil }
assert W6LookupPlain.find(key).or_panic.as(W6LookupPlain).label == "bound"
assert W6LookupPlain.where(:id, :eq, key.to_i64).or_panic.first.or_panic.as(W6LookupPlain).label == "bound"
assert statements.size == 2
assert statements[0] == statements[1]
driver.query_observer = nil
driver.close.or_panic
