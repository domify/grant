import grant/base::{Base}
import spec_helper::{register_spec_connections}

class ExclusionTest < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  column id : Int64, primary: true
  column name : String?

  validate_exclusion :name, ["test_name"]
end

register_spec_connections
ExclusionTest.migrator.drop_and_create.or_panic

# it: should allow non reserved words
exclusion = ExclusionTest.new
exclusion.name = "none_conflicting"
exclusion.save

assert exclusion.errors.size == 0

# it: should disallow reservered words
exclusion = ExclusionTest.new
exclusion.name = "test_name"
exclusion.save

assert exclusion.errors.size == 1
assert exclusion.errors[0].message == "Name got reserved values. Reserved values are test_name"
ExclusionTest.adapter.close.or_panic
