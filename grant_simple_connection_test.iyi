import grant/connection_registry::{ConnectionRegistry}
import grant/adapter/sqlite::{Sqlite}

# it: can register connections with ConnectionRegistry
ConnectionRegistry.establish_connection(
  database: "test_db", adapter: Sqlite, url: "sqlite3::memory:"
).or_panic
assert ConnectionRegistry.connection_exists?("test_db")
adapter = ConnectionRegistry.get_adapter("test_db")
assert adapter.is_a?(Sqlite)
ConnectionRegistry.clear_all.or_panic

# it: supports multiple roles
ConnectionRegistry.establish_connection(
  database: "multi_role", adapter: Sqlite, url: "sqlite3::memory:", role: :writing
).or_panic
ConnectionRegistry.establish_connection(
  database: "multi_role", adapter: Sqlite, url: "sqlite3::memory:", role: :reading
).or_panic
assert ConnectionRegistry.connection_exists?("multi_role", :writing)
assert ConnectionRegistry.connection_exists?("multi_role", :reading)
ConnectionRegistry.clear_all.or_panic
