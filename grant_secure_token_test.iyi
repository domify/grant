import std/regex::{Regex}
import grant/base::{Base}
import spec_helper::{register_spec_connections}

  class SecureTokenTestModel < Base
    connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
    table secure_token_test_models


    has_secure_token :auth_token
    has_secure_token :api_key, length: 36, alphabet: :hex
    has_secure_token :invite_code, length: 10, on: :initialize

    column id : Int64, primary: true
    column name : String?
    timestamps
  end

register_spec_connections
SecureTokenTestModel.migrator.drop_and_create.or_panic

# it: generates tokens automatically on create
model = SecureTokenTestModel.new
model.name = "Test User"

assert model.auth_token.nil?
assert model.api_key.nil?

model.save

assert !model.auth_token.nil?
assert (model.auth_token || raise "Expected token").size == 24
assert !model.api_key.nil?
assert (model.api_key || raise "Expected token").size == 36

# it: generates tokens with different alphabets
model = SecureTokenTestModel.create(name: "Test")

# Base58 token
assert /^[123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz]+$/.match?((model.auth_token || raise "Expected token"))

# Hex token
assert /^[0-9a-f]+$/.match?((model.api_key || raise "Expected token"))

# it: regenerates tokens
model = SecureTokenTestModel.create(name: "Test")

original_token = model.auth_token
original_api_key = model.api_key

model.regenerate_auth_token
model.regenerate_api_key

assert model.auth_token != original_token
assert model.api_key != original_api_key

# it: regenerate_<name> persists the new token
model = SecureTokenTestModel.create(name: "Test")
original = model.auth_token

assert model.regenerate_auth_token

assert model.auth_token != original
assert SecureTokenTestModel.find_strict(model.id).or_panic.auth_token == model.auth_token

# it: regenerate_<name>! persists and returns true
model = SecureTokenTestModel.create(name: "Test")
original = model.api_key

assert model.regenerate_api_key_strict.or_panic

reloaded = SecureTokenTestModel.find_strict(model.id).or_panic
assert reloaded.api_key == model.api_key
assert reloaded.api_key != original
assert (reloaded.api_key || raise "Expected token").size == 36

# it: assign_new_<name> changes the value in memory only
model = SecureTokenTestModel.create(name: "Test")
stored = model.auth_token

fresh = model.assign_new_auth_token.or_panic

assert model.auth_token == fresh
assert fresh != stored
assert SecureTokenTestModel.find_strict(model.id).or_panic.auth_token == stored

# it: on: :initialize fills the token as soon as the record is built
model = SecureTokenTestModel.new(name: "Test")
code = model.invite_code
assert !code.nil?
assert (code || raise "Expected token").size == 10

model.save
assert model.invite_code == code
assert SecureTokenTestModel.find_strict(model.id).or_panic.invite_code == code

# it: on: :initialize keeps an assigned value and does not touch loaded records
model = SecureTokenTestModel.create(name: "Test")
code = model.invite_code
assert SecureTokenTestModel.find_strict(model.id).or_panic.invite_code == code

assert SecureTokenTestModel.create(name: "Kept", invite_code: "mine").invite_code == "mine"

# it: doesn't regenerate existing tokens on create
model = SecureTokenTestModel.new
model.name = "Test"
model.auth_token = "existing_token"

model.save

assert model.auth_token == "existing_token"
