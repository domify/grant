import grant/base::{Base}
import spec_helper::{CURRENT_ADAPTER, restore_default_spec_connections}
import grant/connection_registry::{ConnectionRegistry}
import grant/errors::{Rollback}

class TransactionReplicaParent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
  timestamps
end

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
  timestamps
end

TransactionReplicaParent.connection_config = {
  :writing => CURRENT_ADAPTER,
  :reading => "#{CURRENT_ADAPTER}_with_replica",
}

private def with_immediate_replica_reads(&block : -> T) : T forall T
  previous_wait_period = TransactionReplicaParent.connection_switch_wait_period
  TransactionReplicaParent.connection_switch_wait_period = 0
  result = yield
  TransactionReplicaParent.connection_switch_wait_period = previous_wait_period
  result
end

restore_default_spec_connections
TransactionReplicaParent.migrator.drop_and_create.or_panic

# it: routes reads to the reader outside a transaction (control)
with_immediate_replica_reads do
  writer = ConnectionRegistry.get_adapter(CURRENT_ADAPTER, :writing)
  assert TransactionReplicaParent.adapter.object_id != writer.object_id
end

# it: keeps every statement inside the transaction on the writer
Parent.clear.or_panic
with_immediate_replica_reads do
  writer = ConnectionRegistry.get_adapter(CURRENT_ADAPTER, :writing)
  result = TransactionReplicaParent.transaction do
    assert TransactionReplicaParent.adapter.object_id == writer.object_id
    TransactionReplicaParent.create_strict(name: "In transaction").or_panic
    assert TransactionReplicaParent.where(name: "In transaction").count.or_panic == 1
    Rollback.new
  end
  assert result.nil?
end
assert Parent.count.or_panic == 0

# it: keeps a readonly transaction's reads on the writer
with_immediate_replica_reads do
  writer = ConnectionRegistry.get_adapter(CURRENT_ADAPTER, :writing)
  TransactionReplicaParent.transaction(readonly: true) do
    assert TransactionReplicaParent.adapter.object_id == writer.object_id
  end.or_panic
end

# Native routing checks verify physical checkout and quiet-period behavior.
writer = ConnectionRegistry.get_adapter(CURRENT_ADAPTER, :writing)
reader = ConnectionRegistry.get_adapter("#{CURRENT_ADAPTER}_with_replica", :reading)
with_immediate_replica_reads do
  assert TransactionReplicaParent.__connection.object_id == reader.checkout.or_panic.object_id
  TransactionReplicaParent.transaction do
    assert TransactionReplicaParent.__connection.object_id == writer.checkout.or_panic.object_id
  end.or_panic
  record = TransactionReplicaParent.create_strict(name: "Outside transaction").or_panic
  assert writer.open { |raw| raw.scalar("SELECT COUNT(*) FROM parents") }.or_panic == 1
  assert TransactionReplicaParent.find_strict(record.id).or_panic.name == "Outside transaction"
end
assert TransactionReplicaParent.connection_switch_wait_period == 2000
assert TransactionReplicaParent.adapter.object_id == writer.object_id
assert TransactionReplicaParent.__connection.object_id == writer.checkout.or_panic.object_id
with_immediate_replica_reads do
  TransactionReplicaParent.stick_to_primary
  assert TransactionReplicaParent.adapter.object_id == writer.object_id
  assert TransactionReplicaParent.connection.select_value("SELECT COUNT(*) FROM parents").or_panic == 1
end

ConnectionRegistry.remove_connection(CURRENT_ADAPTER, :primary).or_panic
ConnectionRegistry.remove_connection("#{CURRENT_ADAPTER}_with_replica", :writing).or_panic
