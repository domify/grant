import grant/base::{Base}
import grant/errors::{Rollback}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection, Value}
import std/base64::{Base64}

class W6bLazyUser < Base
  connection sqlite
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# Capture the same decrypt log messages at the actual codec boundary. Returned
# errors let the scoped backend and verbosity restore before the result returns.
private def w6b_decrypts(&block : -> T) : Array(String) forall T
  messages = [] of String
  observer = ->(message : String) { messages << message; nil }
  previous = Config.verbose_logging
  Config.verbose_logging = true
  Config.with_operation_observer(observer) { yield }
  Config.verbose_logging = previous
  messages.select { |message| message.starts_with?("decrypt ") }
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "lazy-salt"
Connections.register("sqlite", Connection.open(":memory:").or_panic)
W6bLazyUser.migrator.drop_and_create.or_panic

# it: never decrypts an attribute that is not read while the record is only read or changed in memory
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(name: "a", email: "ada@example.com", secret: "hush").or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
decrypts = w6b_decrypts do
  loaded.name = "b"
  assert loaded.name_changed?
  assert loaded.changed == ["name"]
  loaded.reload.or_panic
  loaded.dup
end
assert decrypts.empty?

# A save can read sealed columns; it must preserve their original plaintext.
loaded.name = "b"
loaded.save_strict.or_panic
reloaded = W6bLazyUser.find_strict(user.id).or_panic
assert reloaded.name == "b"
assert reloaded.email.or_panic == "ada@example.com"
assert reloaded.secret.or_panic == "hush"

# it: keeps a value through reload, dup and a transaction rollback
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(email: "ada@example.com", secret: "hush").or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
loaded.reload.or_panic
assert loaded.email.or_panic == "ada@example.com"

sealed = W6bLazyUser.find_strict(user.id).or_panic
copy = sealed.dup
copy.save_strict.or_panic
assert W6bLazyUser.find_strict(copy.id).or_panic.email.or_panic == "ada@example.com"
assert W6bLazyUser.find_strict(copy.id).or_panic.secret.or_panic == "hush"

again = W6bLazyUser.find_strict(user.id).or_panic
rollback = W6bLazyUser.transaction do
  again.secret = "changed"
  again.save_strict.or_panic
  Rollback.new
end
# Rollback is an error value; the transaction API consumes its sentinel.
assert rollback.nil?
assert W6bLazyUser.find_strict(user.id).or_panic.secret.or_panic == "hush"

# Native copy regressions check identity, dirty baselines and sealed state.
sealed = W6bLazyUser.find_strict(user.id).or_panic
sealed.name = "edited"
copy = sealed.dup
assert copy.object_id != sealed.object_id
assert copy.id.nil?
assert copy.new_record?
assert !copy.destroyed?
assert copy.name == "edited"
assert !copy.changed?
assert copy.errors.object_id != sealed.errors.object_id
assert w6b_decrypts { sealed.clone; sealed.dup }.empty?
cloned = sealed.clone
assert cloned.id == sealed.id
assert cloned.persisted?
assert cloned.changed == ["name"]
cloned.name = "copy"
assert sealed.name == "edited"
assert cloned.reload.or_panic.name.nil?
assert !cloned.changed?
assert sealed.name == "edited"

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
W6bLazyUser.__connection.close.or_panic
