import grant/base::{Base}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{Options, ConnectionTransactions}
import grant
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: returns the block value
Parent.clear.or_panic
parent = Parent.transaction { Parent.create_strict(name: "Ada").or_panic }.or_panic
assert parent.is_a?(Parent)
assert (parent.nil? ? nil : parent.name) == "Ada"

# it: types the result as the block type or nil
# Unwrap returned errors before comparing the original successful result types.
# Native union type objects compare by identity; compare their exact type names.
assert typeof(Parent.transaction { 1 }.or_panic).to_s == (Int32?).to_s
assert typeof(Parent.transaction { "x" }.or_panic).to_s == (String?).to_s
assert typeof(Parent.transaction(requires_new: true) { 1_i64 }.or_panic).to_s == (Int64?).to_s
assert typeof(Parent.new.transaction { :a }.or_panic).to_s == (Symbol?).to_s

# it: returns nil when the block raises Rollback
assert Parent.transaction { Rollback.new }.or_panic.nil?

# it: returns the value from joined, savepoint, and independent levels
Parent.transaction do
  assert Parent.transaction { 1 }.or_panic == 1
  assert Parent.transaction(requires_new: true) { 2 }.or_panic == 2
  assert Parent.transaction(independent: true) { 3 }.or_panic == 3
  assert Parent.transaction(Options.new) { 4 }.or_panic == 4
end.or_panic
value = Parent.transaction { Parent.transaction(requires_new: true) { 5 }.or_panic }.or_panic
assert value == 5

# it: allows a nil block value
assert Parent.transaction { nil }.or_panic.nil?

# it: returns the value from the instance form, Grant.transaction, and the connection
assert Parent.new.transaction { 7 }.or_panic == 7
assert Grant.transaction { 8 }.or_panic == 8
assert Grant.connection.transaction { 9 }.or_panic == 9

# it: does not return a value from a block that raised
error = Parent.transaction { ErrorBase.new("nope") }
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "nope"
Parent.adapter.close.or_panic
