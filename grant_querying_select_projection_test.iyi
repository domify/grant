import std/text
import querying_spec_models::{Review}
import spec_helper::{register_spec_connections}

register_spec_connections
Review.migrator.drop_and_create.or_panic


# it: includes only selected columns in SELECT clause when .select(*cols) is called
Review.clear.or_panic
sql = Review.where.select(:id, :name).raw_sql
select_clause = sql.downcase.split("from").first
assert select_clause.includes?("id")
assert select_clause.includes?("name")
assert !select_clause.includes?("downvotes")
assert !select_clause.includes?("upvotes")
assert !select_clause.includes?("sentiment")

# it: raw_sql reflects single-column projection
Review.clear.or_panic
sql = Review.where.select(:name).raw_sql
select_clause = sql.downcase.split("from").first
assert select_clause.includes?("name")
assert !select_clause.includes?("downvotes")
assert !select_clause.includes?("id")

# it: raw_sql uses all model fields when no .select(*cols) is called
Review.clear.or_panic
sql = Review.where.raw_sql
select_clause = sql.downcase.split("from").first
assert select_clause.includes?("id")
assert select_clause.includes?("name")
assert select_clause.includes?("downvotes")

# it: reselect replaces the column list in SQL
Review.clear.or_panic
sql = Review.where.select(:id, :name).reselect(:id, :downvotes).raw_sql
select_clause = sql.downcase.split("from").first
assert select_clause.includes?("id")
assert select_clause.includes?("downvotes")
assert !select_clause.includes?("name")

# it: hydrates selected columns and leaves unselected columns nil
Review.clear.or_panic
Review.create(name: "projection_test", downvotes: 42, upvotes: 7_i64)
rows = Review.where(name: "projection_test").select(:id, :name).select.or_panic
assert rows.size == 1
row = rows.first
assert !row.id.nil?
assert row.name == "projection_test"
assert row.downvotes.nil?
assert row.upvotes.nil?

# it: single-column projection returns correct value
Review.clear.or_panic
Review.create(name: "solo", downvotes: 99)
rows = Review.where(name: "solo").select(:downvotes).select.or_panic
assert rows.size == 1
assert rows.first.downvotes == 99
assert rows.first.name.nil?
assert rows.first.id.nil?

# it: reselect overrides an earlier select for hydration
Review.clear.or_panic
Review.create(name: "rr", downvotes: 11, upvotes: 22_i64)
rows = Review.where(name: "rr").select(:name).reselect(:downvotes).select.or_panic
assert rows.size == 1
row = rows.first
assert row.downvotes == 11
assert row.name.nil?

# it: chaining .select(*cols) with .where still projects correctly
Review.clear.or_panic
Review.create(name: "a", downvotes: 1)
Review.create(name: "b", downvotes: 2)
Review.create(name: "c", downvotes: 3)
rows = Review.where.select(:id, :downvotes).where.gteq(:downvotes, 2).select.or_panic
assert rows.size == 2
rows.each do |row|
  assert !row.id.nil?
  assert !row.downvotes.nil?
  assert row.name.nil?
end

Review.adapter.close.or_panic
