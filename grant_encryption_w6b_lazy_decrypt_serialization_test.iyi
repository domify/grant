import grant/base::{Base}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/adapter/sqlite::{Connection, Value}
import std/base64::{Base64}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class W6bLazyUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# Capture the same decrypt log messages at the actual codec boundary. Returned
# errors let the scoped backend and verbosity restore before the result returns.
private def w6b_decrypts(&block : -> T) : Array(String) forall T
  messages = [] of String
  observer = ->(message : String) { messages << message; nil }
  previous = Config.verbose_logging
  Config.verbose_logging = true
  Config.with_operation_observer(observer) { yield }
  Config.verbose_logging = previous
  messages.select { |message| message.starts_with?("decrypt ") }
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "lazy-salt"
register_spec_connections
W6bLazyUser.migrator.drop_and_create.or_panic

private def w6b_raw(user_id, column : String) : String? | ::Grant::Errors::DatabaseError
  rows = W6bLazyUser.__connection.query("SELECT #{column} FROM w6b_lazy_users WHERE id = #{user_id}")!
  rows.first[column].as(String?)
end

# it: decrypts before serializing to JSON and YAML
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(name: "a", email: "ada@example.com", secret: "hush").or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
assert loaded.to_json.or_panic.includes?("ada@example.com")
assert !loaded.to_json.or_panic.includes?("grant-sealed")
assert W6bLazyUser.find_strict(user.id).or_panic.to_yaml.or_panic.includes?("ada@example.com")
assert W6bLazyUser.find_strict(user.id).or_panic.to_h.or_panic["email"] == "ada@example.com"

# Parsed documents must carry model values rather than ciphertext, including
# escaped strings and typed eager attributes. Serialization caches lazy reads.
assert ::Std::Json::JSON.parse(loaded.to_json.or_panic)["email"].as_s == "ada@example.com"
assert ::Std::Yaml::YAML.parse(loaded.to_yaml.or_panic)["secret"].as_s == "hush"
builder = ::Std::Json::Builder.new
loaded.to_json(builder).or_panic
assert ::Std::Json::JSON.parse(builder.to_s)["email"].as_s == "ada@example.com"
assert w6b_decrypts { loaded.to_json.or_panic; loaded.to_yaml.or_panic; loaded.to_h.or_panic }.empty?
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(name: "a\"b\nc", email: "ada@example.com", eager_note: "note", balance: 7_i64).or_panic
loaded = W6bLazyUser.find_strict(user.id).or_panic
json = ::Std::Json::JSON.parse(loaded.to_json.or_panic)
yaml = ::Std::Yaml::YAML.parse(loaded.to_yaml.or_panic)
assert json["name"].as_s == "a\"b\nc"
assert yaml["name"].as_s == "a\"b\nc"
assert json["balance"].as_i64 == 7_i64
assert yaml["balance"].as_i == 7_i64
assert loaded.to_h.or_panic["secret"].nil?
corrupt = Base64.encode(Cipher.random_bytes(64).or_panic)
W6bLazyUser.__connection.execute("UPDATE w6b_lazy_users SET secret = ? WHERE id = ?", [corrupt, user.id] of Value).or_panic
bad = W6bLazyUser.find_strict(user.id).or_panic
assert bad.to_json.is_a?(DecryptionError)
assert bad.to_yaml.is_a?(DecryptionError)
assert bad.to_h.is_a?(DecryptionError)

class SerializationScalars < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table serialization_scalars
  column id : Int64, primary: true
  column at : ::Std::Time::Time?
  column flag : Bool?
  column ratio : Float32?
  column number : Int32?
end
scalars = SerializationScalars.new(at: ::Std::Time::Time.utc(2026, 10, 14, 12, 30, 5, nanosecond: 123456000), flag: true, ratio: 1.5_f32, number: 7)
assert scalars.to_h.or_panic["at"] == "2026-10-14 12:30:05.123456+0000"
assert ::Std::Json::JSON.parse(scalars.to_json.or_panic)["flag"].as_bool
assert ::Std::Yaml::YAML.parse(scalars.to_yaml.or_panic)["ratio"].as_f == 1.5
assert ::Std::Json::JSON.parse(scalars.to_json.or_panic)["number"].as_i64 == 7_i64

KeyProvider.primary_key = nil
assert W6bLazyUser.new(secret: "unsealed").attributes.is_a?(::Grant::Encryption::KeyProvider::KeyError)
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
W6bLazyUser.__connection.close.or_panic
