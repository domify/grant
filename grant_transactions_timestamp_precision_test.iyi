import grant::{settings}
import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import std/time::{Time, Span}

class TimestampPrecisionRecord < Base
  connection sqlite
  table timestamp_precision_records
  column id : Int64, primary: true
  column label : String
  timestamps
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
TimestampPrecisionRecord.migrator.drop_and_create.or_panic

# it: preserves microseconds when timestamps are saved and reloaded
settings.default_timezone = "UTC"
TimestampPrecisionRecord.clear.or_panic
timestamp = Time.utc(2020, 1, 1) + Span.nanoseconds(123_456_000_i64)
record = TimestampPrecisionRecord.new(label: "fixed")
record.set_timestamps(to: timestamp)
assert record.created_at == timestamp
assert record.updated_at == timestamp
record.save_strict(skip_timestamps: true).or_panic
reloaded = TimestampPrecisionRecord.find_strict(record.id.as(Int64)).or_panic
assert reloaded.created_at == timestamp
assert reloaded.updated_at == timestamp

# it: keeps subsecond precision when touching timestamps
settings.default_timezone = "UTC"
TimestampPrecisionRecord.clear.or_panic
old_timestamp = Time.utc(2020, 1, 1) + Span.nanoseconds(123_456_000_i64)
record = TimestampPrecisionRecord.new(label: "touch")
record.set_timestamps(to: old_timestamp)
record.save_strict(skip_timestamps: true).or_panic
assert record.touch.or_panic
updated_at = TimestampPrecisionRecord.find_strict(record.id.as(Int64)).or_panic.updated_at.as(Time)
assert updated_at > old_timestamp
assert updated_at.nanosecond > 0
TimestampPrecisionRecord.adapter.close.or_panic
