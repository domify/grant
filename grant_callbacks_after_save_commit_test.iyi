import grant/base::{Base}
import grant/errors::{Rollback}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class SaveCommitModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table save_commit_models
  column id : Int64, primary: true
  column name : String?
  @@event_log = [] of String
  def self.event_log : Array(String)
    @@event_log
  end
  def self.event_log=(value : Array(String)) : Array(String)
    @@event_log = value
  end
  after_save_commit { SaveCommitModel.event_log << "save_commit:#{name}" }
  after_commit { SaveCommitModel.event_log << "commit:#{name}" }
end

class SaveCommitBothModel < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table save_commit_both_models
  column id : Int64, primary: true
  column name : String?
  @@event_log = [] of String
  def self.event_log : Array(String)
    @@event_log
  end
  def self.event_log=(value : Array(String)) : Array(String)
    @@event_log = value
  end
  after_create_commit { SaveCommitBothModel.event_log << "create_commit" }
  after_update_commit { SaveCommitBothModel.event_log << "update_commit" }
  after_save_commit { SaveCommitBothModel.event_log << "save_commit" }
end

register_spec_connections
SaveCommitModel.migrator.drop_and_create.or_panic
SaveCommitBothModel.migrator.drop_and_create.or_panic

def reset : Nil
  SaveCommitModel.clear.or_panic
  SaveCommitBothModel.clear.or_panic
  SaveCommitModel.event_log.clear
  SaveCommitBothModel.event_log.clear
  nil
end

# it: fires once after a create and once after an update
reset
record = SaveCommitModel.create(name: "a")
assert SaveCommitModel.event_log == ["save_commit:a", "commit:a"]
SaveCommitModel.event_log.clear
record.name = "b"
record.save
assert SaveCommitModel.event_log == ["save_commit:b", "commit:b"]

# it: does not fire on destroy
reset
record = SaveCommitModel.create(name: "a")
SaveCommitModel.event_log.clear
record.destroy
assert SaveCommitModel.event_log == ["commit:a"]

# it: fires once even with after_create_commit registered too
reset
record = SaveCommitBothModel.create(name: "a")
assert SaveCommitBothModel.event_log == ["create_commit", "save_commit"]
SaveCommitBothModel.event_log.clear
record.name = "b"
record.save
assert SaveCommitBothModel.event_log == ["update_commit", "save_commit"]

# it: waits for the outer commit and fires once for create then update
reset
SaveCommitBothModel.transaction do
  record = SaveCommitBothModel.create(name: "a")
  record.name = "b"
  record.save
  assert SaveCommitBothModel.event_log.empty?
end.or_panic
assert SaveCommitBothModel.event_log == ["create_commit", "save_commit"]

# it: does not fire when the transaction rolls back
reset
SaveCommitBothModel.transaction do
  SaveCommitBothModel.create(name: "a")
  Rollback.new
end.or_panic
assert SaveCommitBothModel.event_log.empty?
SaveCommitModel.adapter.close.or_panic
