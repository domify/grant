import grant/base::{Base}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/errors::{RecordNotSaved, ErrorBase}

class T6HaltedRecord < Base
  connection sqlite
  table t6_halted_records
  column id : Int64, primary: true
  column name : String

  around_save :halt_save

  private def halt_save(continuation : Proc(Nil))
  end
end

class T6CommitFailureRecord < Base
  connection sqlite
  table t6_commit_failure_records
  column id : Int64, primary: true
  column name : String

  after_commit :raise_after_commit

  private def raise_after_commit
    ErrorBase.new("T6 after_commit failure")
  end
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
T6HaltedRecord.migrator.drop_and_create.or_panic
T6CommitFailureRecord.migrator.drop_and_create.or_panic

# it: raises RecordNotSaved when create is halted without validation errors
error = T6HaltedRecord.create_strict(name: "must not persist")
assert error.is_a?(RecordNotSaved)
assert T6HaltedRecord.count.or_panic == 0

# it: propagates after_commit exceptions after the row is committed
error = T6CommitFailureRecord.transaction do
  T6CommitFailureRecord.create_strict(name: "durable")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("T6 after_commit failure")
assert error.as(ErrorBase).message == "T6 after_commit failure"
assert T6CommitFailureRecord.count.or_panic == 1
assert !T6CommitFailureRecord.transaction_open?

T6HaltedRecord.adapter.close.or_panic
