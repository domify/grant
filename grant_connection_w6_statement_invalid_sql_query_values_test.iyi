import grant
import grant/base::{Base}
import w6_c04_support::{W6C04}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

W6C04.provision("w6_sql", ["CREATE TABLE w6_sql_things (#{W6C04.id_column}, label TEXT, amount BIGINT)"])
W6C04.establish("w6_sql", "w6_sql", :primary)
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
W6C04.exec("w6_sql", "INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)")
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of count, exists?, pluck, pick and ids
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").count }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").exists? }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").pluck(:label) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").pluck(:label, :amount) }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").pick(:label) }

# Native success checks exercise the actual projections and bound clauses.
relation = W6SqlThing.where("amount = ?", 1_i64)
assert relation.count.or_panic == 1_i64
assert relation.exists?.or_panic
assert relation.pluck(:label).or_panic == [["a"]]
assert relation.pluck(:label, :amount).or_panic == [["a", 1_i64]]
assert relation.pluck(:label, :label).or_panic == [["a", "a"]]
assert relation.pick(:label).or_panic == ["a"]
assert relation.ids.or_panic == [1_i64]
empty = relation.where("amount = ?", 2_i64)
assert empty.count.or_panic == 0_i64
assert !empty.exists?.or_panic
assert empty.pluck(:label).or_panic.empty?
assert empty.pick(:label).or_panic.nil?
assert empty.ids.or_panic.empty?
assert relation.count.or_panic == 1_i64
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").ids }
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES (NULL, 2)") }.or_panic
assert W6SqlThing.where("amount = ?", 2_i64).pluck(:label, :amount).or_panic == [[nil, 2_i64]]

W6C04.remove("w6_sql", :primary)
W6C04.cleanup
