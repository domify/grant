import grant/base::{Base}
import grant/querying::{NotFound}
import grant/error::{ErrorBase}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class W6LookupNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_notes
  column id : Int64, primary: true
  column body : String
  column visible : Bool = true
  default_scope { where(visible: true) }
end

class W6LookupPlain < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_plains
  column id : Int64, primary: true
  column label : String
end

class W6LookupSlug < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_lookup_slugs
  column slug : String, primary: true, auto: false
  column label : String
end

private def reset
  W6LookupNote.unscoped { |query| query.delete_all }.or_panic
  W6LookupPlain.clear.or_panic
  W6LookupSlug.clear.or_panic
end

register_spec_connections
W6LookupNote.migrator.drop_and_create.or_panic
W6LookupPlain.migrator.drop_and_create.or_panic
W6LookupSlug.migrator.drop_and_create.or_panic

# it: keeps honoring a default scope
reset
shown = W6LookupNote.create_strict(body: "shown", visible: true).or_panic
hidden = W6LookupNote.create_strict(body: "hidden", visible: false).or_panic
assert W6LookupNote.find(shown.id).or_panic.as(W6LookupNote).body == "shown"
assert W6LookupNote.find(hidden.id).or_panic.nil?
assert W6LookupNote.find_strict(hidden.id).is_a?(NotFound)
assert W6LookupNote.find_strict(hidden.id).as(NotFound).message == "No W6LookupNote found where id = #{hidden.id}"

# it: skips the default scope inside unscoped
reset
hidden = W6LookupNote.create_strict(body: "hidden", visible: false).or_panic
assert W6LookupNote.unscoped { W6LookupNote.find(hidden.id) }.or_panic.as(W6LookupNote).body == "hidden"
assert W6LookupNote.find(hidden.id).or_panic.nil?

# it: keeps honoring a scoping block
reset
first = W6LookupPlain.create_strict(label: "keep").or_panic
second = W6LookupPlain.create_strict(label: "other").or_panic
W6LookupPlain.scoping(W6LookupPlain.where(label: "keep")) do
  assert !W6LookupPlain.find(first.id).or_panic.nil?
  assert W6LookupPlain.find(second.id).or_panic.nil?
end
assert !W6LookupPlain.find(second.id).or_panic.nil?

# Native regression checks: nested blocks restore their parents, returned
# errors close scope state, and each query receives an independent copy.
W6LookupPlain.scoping(W6LookupPlain.where(label: "keep")) do
  assert W6LookupPlain.where(label: "keep").where_fields.size == 2
  assert W6LookupPlain.current_scope.where_fields.size == 1
  W6LookupPlain.scoping(W6LookupPlain.unscoped.where(label: "other")) do
    assert W6LookupPlain.find(first.id).or_panic.nil?
    assert !W6LookupPlain.find(second.id).or_panic.nil?
  end
  assert !W6LookupPlain.find(first.id).or_panic.nil?
  assert W6LookupPlain.find(second.id).or_panic.nil?
  W6LookupPlain.unscoped do
    assert !W6LookupPlain.find(second.id).or_panic.nil?
  end
  assert W6LookupPlain.find(second.id).or_panic.nil?
end
error = W6LookupPlain.scoping(W6LookupPlain.where(label: "keep")) { ErrorBase.new("scope error") }
assert error.is_a?(ErrorBase)
assert !W6LookupPlain.find(second.id).or_panic.nil?
hidden = W6LookupNote.create_strict(body: "hidden again", visible: false).or_panic
error = W6LookupNote.unscoped do
  W6LookupNote.unscoped { nil }
  assert !W6LookupNote.find(hidden.id).or_panic.nil?
  ErrorBase.new("unscoped error")
end
assert error.is_a?(ErrorBase)
assert W6LookupNote.find(hidden.id).or_panic.nil?
done = Channel(Nil).new
W6LookupPlain.scoping(W6LookupPlain.where(label: "keep")) do
  group do |tasks|
    tasks.spawn do
      assert !W6LookupPlain.find(second.id).or_panic.nil?
      W6LookupPlain.scoping(W6LookupPlain.where(label: "other")) do
        assert W6LookupPlain.find(first.id).or_panic.nil?
      end
      done.send(nil).or_panic
    end
    done.receive.or_panic
    assert W6LookupPlain.find(second.id).or_panic.nil?
  end
end
W6LookupNote.unscoped do
  group do |tasks|
    tasks.spawn do
      assert W6LookupNote.find(hidden.id).or_panic.nil?
      done.send(nil).or_panic
    end
    done.receive.or_panic
    assert !W6LookupNote.find(hidden.id).or_panic.nil?
  end
end
W6LookupPlain.__connection.close.or_panic
