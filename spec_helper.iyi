module spec_helper

# Native counterpart of crystal-upstream/spec/spec_helper.cr: the adapter
# comes from CURRENT_ADAPTER, its URL from <ADAPTER>_DATABASE_URL.
import std/env::{ENV}
import grant/connections::{Connections}
import grant/connection_registry::{ConnectionRegistry}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}

pub CURRENT_ADAPTER = ENV["CURRENT_ADAPTER"]? || "sqlite"
pub ADAPTER_URL = ENV["#{CURRENT_ADAPTER.upcase}_DATABASE_URL"]? || (CURRENT_ADAPTER == "sqlite" ? "sqlite3:./grant_green.db" : raise "Set #{CURRENT_ADAPTER.upcase}_DATABASE_URL to run the #{CURRENT_ADAPTER} specs")
pub ADAPTER_REPLICA_URL = ENV["#{CURRENT_ADAPTER.upcase}_REPLICA_URL"]? || ADAPTER_URL

# The top-level `Grant::Connections <<` registrations of the upstream helper.
pub def register_spec_connections : Nil
  case CURRENT_ADAPTER
  when "pg"
    Connections.register(CURRENT_ADAPTER, Pg.new(CURRENT_ADAPTER, ADAPTER_URL))
    Connections.register("pg_with_replica", Pg.new("pg_with_replica", ADAPTER_URL))
  when "sqlite"
    Connections.register(CURRENT_ADAPTER, Sqlite.new(CURRENT_ADAPTER, ADAPTER_URL))
    Connections.register("sqlite_with_replica", Sqlite.new("sqlite_with_replica", ADAPTER_URL))
  else
    raise "Unknown adapter #{CURRENT_ADAPTER}"
  end
  nil
end

# Upstream restore_default_spec_connections: adapter-backed registry defaults.
pub def restore_default_spec_connections : Nil
  replica_database = "#{CURRENT_ADAPTER}_with_replica"
  if CURRENT_ADAPTER == "pg"
    unless ConnectionRegistry.connection_exists?(CURRENT_ADAPTER, :primary)
      ConnectionRegistry.establish_connection(database: CURRENT_ADAPTER, adapter: Pg, url: ADAPTER_URL, role: :primary).or_panic
    end
    unless ConnectionRegistry.connection_exists?(replica_database, :writing)
      ConnectionRegistry.establish_connection(database: replica_database, adapter: Pg, url: ADAPTER_URL, role: :writing).or_panic
    end
    if ADAPTER_REPLICA_URL != ADAPTER_URL && !ConnectionRegistry.connection_exists?(replica_database, :reading)
      ConnectionRegistry.establish_connection(database: replica_database, adapter: Pg, url: ADAPTER_REPLICA_URL, role: :reading).or_panic
    end
  else
    unless ConnectionRegistry.connection_exists?(CURRENT_ADAPTER, :primary)
      ConnectionRegistry.establish_connection(database: CURRENT_ADAPTER, adapter: Sqlite, url: ADAPTER_URL, role: :primary).or_panic
    end
    unless ConnectionRegistry.connection_exists?(replica_database, :writing)
      ConnectionRegistry.establish_connection(database: replica_database, adapter: Sqlite, url: ADAPTER_URL, role: :writing).or_panic
    end
    if ADAPTER_REPLICA_URL != ADAPTER_URL && !ConnectionRegistry.connection_exists?(replica_database, :reading)
      ConnectionRegistry.establish_connection(database: replica_database, adapter: Sqlite, url: ADAPTER_REPLICA_URL, role: :reading).or_panic
    end
  end
  nil
end
