import grant
import std/file::{File}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

path = File.tempfile("w6_sql", ".sqlite3")
ConnectionRegistry.establish_connection(database: "w6_sql", adapter: Sqlite, url: "sqlite3:#{path}", role: :primary).or_panic
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
adapter.open { |db| db.exec("CREATE TABLE w6_sql_things (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT, amount BIGINT)") }.or_panic
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)") }.or_panic
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of update_all, delete_all and find_each
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").update_all(label: "x") }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").delete_all }
w6_failure("missing_col") { W6SqlThing.where("missing_col = 1").find_each { |_| } }

# Native success checks retain bind ordering and exercise real keyset pages.
relation = W6SqlThing.where("amount = ?", 1_i64)
assert relation.update_all(label: "updated", amount: 2_i64).or_panic == 1_i64
assert relation.count.or_panic == 0_i64
assert W6SqlThing.where("amount = ?", 2_i64).pick(:label).or_panic == ["updated"]
assert relation.delete_all.or_panic == 0_i64
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('b', 2), ('c', 2), ('d', 3)") }.or_panic
ids = [] of Int64
scan = W6SqlThing.where("amount = ?", 2_i64)
scan.find_each(batch_size: 1) do |record|
  ids << record.id.as(Int64)
  nil
end.or_panic
assert ids == [1_i64, 2_i64, 3_i64]
assert scan.count.or_panic == 3_i64
rollback = ::Grant::Errors::Rollback.new
visited = 0
result = scan.find_each(batch_size: 1) do |_| 
  visited += 1
  rollback
end
assert result.is_a?(::Grant::Errors::Rollback)
assert visited == 1
batches = [] of Int32
scan.find_in_batches(batch_size: 2) do |batch|
  batches << batch.size
  batch.each do |record|
    W6SqlThing.where("id = ?", record.id).delete_all.or_panic
  end
  nil
end.or_panic
assert batches == [2, 1]
assert scan.count.or_panic == 0_i64
assert W6SqlThing.where("amount = ?", 3_i64).count.or_panic == 1_i64
assert scan.find_in_batches(batch_size: 0) { |_| }.is_a?(::Grant::Errors::ErrorBase)
assert W6SqlThing.where("amount = ?", 3_i64).delete_all.or_panic == 1_i64
assert W6SqlThing.where("1 = 1").count.or_panic == 0_i64

ConnectionRegistry.remove_connection("w6_sql", :primary).or_panic
File.delete(path)
