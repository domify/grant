import std/regex::{Regex}
import transaction_crud_models::{Parent, School}
import nation
import grant/querying::{NotFound}
import spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
School.migrator.drop_and_create.or_panic
Nation::County.migrator.drop_and_create.or_panic

# it: finds an object by id
model = Parent.new
model.name = "Test Comment"
model.save
found = Parent.find(model.id).or_panic
assert !found.nil?
if found
  assert found.id == model.id
end
found = Parent.find_strict(model.id).or_panic
assert found.id == model.id

# it: updates states of new_record and persisted
model = Parent.new
model.name = "Test Comment"
model.save
model_id = model.id
model = Parent.find_strict(model_id).or_panic
assert !model.new_record?
assert model.persisted?

# it: finds the object
school = School.new
school.name = "Test School"
school.save
primary_key = school.custom_id
found_school = School.find(primary_key).or_panic
assert !found_school.nil?
found_school = School.find_strict(primary_key).or_panic
assert found_school.is_a?(School)

# it: finds the object
county = Nation::County.new
county.name = "Test County"
county.save
primary_key = county.id
found_county = Nation::County.find(primary_key).or_panic
assert !found_county.nil?
found_county = Nation::County.find_strict(primary_key).or_panic
assert found_county.is_a?(Nation::County)

# it: returns nil or raises if no result
found = Parent.find(0).or_panic
assert found.nil?
error = Parent.find_strict(0)
assert error.is_a?(NotFound)
assert error.as(NotFound).message.matches?(/No .*Parent.* found where id = 0/)

Parent.adapter.close.or_panic
