import pool_spec_support::{C02Support}
import spec_helper::{CURRENT_ADAPTER}
import grant/connection_registry::{ConnectionRegistry}
import grant/adapter/sqlite::{Sqlite}
import grant/error_taxonomy::{ConnectionTimeoutError}
import grant/database::{PoolTimeout}
import std/time::{Time, Span}

# it: raises Grant::ConnectionTimeoutError when a second fiber waits past the checkout timeout
group do |tasks|
  adapter = C02Support.establish("c02_exhaust", pool_size: 1,
    initial_pool_size: 1, checkout_timeout: Span.milliseconds(200_i64))
  holder_ready = Channel(Nil).new
  release_holder = Channel(Nil).new
  finished = Channel(Nil).new
  tasks.spawn do
    adapter.open do |_|
      holder_ready.send(nil).or_panic
      release_holder.receive.or_panic
    end.or_panic
    finished.send(nil).or_panic
  end
  holder_ready.receive.or_panic
  started = Time.monotonic
  error = adapter.open { |connection| connection.scalar("SELECT 1") }
  assert error.is_a?(ConnectionTimeoutError)
  assert Time.monotonic - started >= Span.milliseconds(150_i64)
  assert error.as(ConnectionTimeoutError).cause.is_a?(PoolTimeout)
  release_holder.send(nil).or_panic
  finished.receive.or_panic
  assert adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic == 1
end
ConnectionRegistry.remove_connection("c02_exhaust", :writing).or_panic
ConnectionRegistry.remove_connection("c02_memory", :writing).or_panic

# it: counts the blocked fiber as waiting while it waits
group do |tasks|
  adapter = C02Support.establish("c02_exhaust", pool_size: 1,
    initial_pool_size: 1, checkout_timeout: Span.seconds(2_i64))
  holder_ready = Channel(Nil).new
  release_holder = Channel(Nil).new
  waiter_done = Channel(Nil).new
  tasks.spawn do
    adapter.open do |_|
      holder_ready.send(nil).or_panic
      release_holder.receive.or_panic
    end.or_panic
  end
  holder_ready.receive.or_panic
  tasks.spawn do
    adapter.open { |connection| connection.scalar("SELECT 1") }.or_panic
    waiter_done.send(nil).or_panic
  end
  sleep(0).or_panic
  stat = adapter.pool_stat
  assert stat.waiting == 1
  assert stat.busy == 1
  assert stat.exhausted?
  release_holder.send(nil).or_panic
  waiter_done.receive.or_panic
  assert adapter.pool_stat.waiting == 0
end
ConnectionRegistry.remove_connection("c02_exhaust", :writing).or_panic
ConnectionRegistry.remove_connection("c02_memory", :writing).or_panic

# it: forces a single connection for an in-memory SQLite database whatever pool_size says
if CURRENT_ADAPTER == "sqlite"
  ConnectionRegistry.establish_connection(database: "c02_memory", adapter: Sqlite,
    url: "sqlite3::memory:", role: :writing, pool_size: 10, initial_pool_size: 5).or_panic
  adapter = ConnectionRegistry.get_adapter("c02_memory", :writing)
  adapter.open { |connection| connection.exec("CREATE TABLE memory_marker (id INTEGER)") }.or_panic
  adapter.open { |connection| connection.exec("INSERT INTO memory_marker VALUES (1)") }.or_panic
  assert adapter.open { |connection| connection.scalar("SELECT COUNT(*) FROM memory_marker") }.or_panic == 1
  assert adapter.pool_stat.size == 1
  assert adapter.pool_stat.connections == 1
end
ConnectionRegistry.remove_connection("c02_exhaust", :writing).or_panic
ConnectionRegistry.remove_connection("c02_memory", :writing).or_panic
C02Support.cleanup
