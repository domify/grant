module query_spec_helper

# Native counterpart of crystal-upstream/spec/grant/query/spec_helper.cr: a
# stub model with no database, builders for each adapter and the
# whitespace-insensitive SQL matcher.
import std/text
import grant/adapter/base::{Base}
import grant/query/builder::{Builder}
import grant/settings
import spec_helper::{CURRENT_ADAPTER}

pub class Model
  def self.table_name : String
    "table"
  end

  def self.fields : Array(String)
    ["id", "name", "age", "date_completed", "status", "published"]
  end

  def self.primary_name : String
    "id"
  end

  # Stub for assembler compile compatibility (lock mode needs adapter type)
  def self.adapter : Base
    raise "Model.adapter not available in query builder specs"
  end

  def self.quote(name : String) : String
    "\"#{name}\""
  end

  def self.custom_select_statement : String?
    nil
  end

  def self.implicit_order_columns : Array(String)
    [] of String
  end

  def self.mark_write_operation : Nil
    nil
  end

  def self.from_row(row : ::Grant::Adapter::Driver::Row) : Model
    Model.new
  end
end

# The stub-model assembler and builder specs pin the exact SQL of the legacy
# unordered-SELECT shape, which ends in ORDER BY id DESC. Upstream wraps each
# example with this (`around_each`); a native file calls it around its body.
pub def with_legacy_implicit_order(&block : -> T) : T forall T
  previous = ::Grant::Settings.settings.implicit_order
  ::Grant::Settings.settings.implicit_order = true
  result = yield
  ::Grant::Settings.settings.implicit_order = previous
  result
end

pub def query_fields : String
  Model.fields.join(", ")
end

pub def builder : Builder(Model)
  case CURRENT_ADAPTER
  when "pg" then Builder(Model).new(Builder::DbType::Pg)
  else           Builder(Model).new(Builder::DbType::Sqlite)
  end
end

pub def pg_builder : Builder(Model)
  Builder(Model).new(Builder::DbType::Pg)
end

pub def sqlite_builder : Builder(Model)
  Builder(Model).new(Builder::DbType::Sqlite)
end

# Upstream's `should match ignore_whitespace sql`: the same words in the same
# order, any run of whitespace between them, ignoring case.
pub def ignore_whitespace?(actual : String, expected : String) : Bool
  words(actual) == words(expected)
end

private def words(text : String) : Array(String)
  text.downcase.split(' ').flat_map { |part| part.split('\n') }.flat_map { |part| part.split('\t') }.reject { |part| part.empty? }
end

# iyi's NamedTuple `==` answers false for equal tuples, so clause lists are
# compared through their printed form.
pub def same_entries?(actual : Array(A), expected : Array(B)) : Bool forall A, B
  actual.map { |entry| entry.to_s } == expected.map { |entry| entry.to_s }
end
