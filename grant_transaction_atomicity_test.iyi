import grant/base::{Base}
import grant/adapter/sqlite::{Connection}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{current_connection?}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Relevant columns from spec_models.cr; both models use the same adapter.
class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

class Teacher < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table teachers
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic
Teacher.migrator.drop_and_create.or_panic

# it: rolls back all records when an exception is raised inside the block
Parent.clear.or_panic
error = Parent.transaction do
  Parent.create_strict(name: "Alice").or_panic
  Parent.create_strict(name: "Bob").or_panic
  ErrorBase.new("force rollback")
end
assert error.is_a?(ErrorBase)
assert Parent.count.or_panic == 0

# it: rolls back all records when Grant::Transaction::Rollback is raised
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Charlie").or_panic
  Parent.create_strict(name: "Dave").or_panic
  Rollback.new
end.or_panic
assert Parent.count.or_panic == 0

# it: persists all records after a clean transaction block
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Eve").or_panic
  Parent.create_strict(name: "Frank").or_panic
end.or_panic
assert Parent.count.or_panic == 2
names = Parent.all.or_panic.map { |parent| parent.name.to_s }.sorted
assert names == ["Eve", "Frank"]

# it: rolls back records from different model classes inside one transaction
Parent.clear.or_panic
Teacher.clear.or_panic
error = Parent.transaction do
  Parent.create_strict(name: "CrossParent").or_panic
  Teacher.create_strict(name: "CrossTeacher").or_panic
  ErrorBase.new("cross rollback")
end
assert error.is_a?(ErrorBase)
assert Parent.count.or_panic == 0
assert Teacher.count.or_panic == 0

# it: only routes DML to the transaction connection for the adapter that opened it
Parent.transaction do
  assert !current_connection?(Parent.adapter).nil?
  other = Connection.open(":memory:").or_panic
  assert current_connection?(other).nil?
  other.close.or_panic
end.or_panic

# it: returns nil for any adapter when no transaction is open
assert current_connection?(Parent.adapter).nil?
Parent.adapter.close.or_panic
