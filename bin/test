#!/usr/bin/env ruby
# Runs every test/*_test.ri (or the FILEs given) under SQLite and PostgreSQL in parallel slots.
require "open3"
require "json"
require "digest"
require "etc"
require "fileutils"

Dir.chdir(File.expand_path("..", __dir__))
ENV["IYI_CACHE_DIR"] = File.join(Dir.pwd, ".ris-cache")
ris = ENV.fetch("RIS", "/home/priit/contribute/ris/bin/ris")
adapters = ENV.fetch("TEST_ADAPTERS", "sqlite pg").split
pg_server = ENV.fetch("PG_SERVER_URL", "postgres://grant:password@127.0.0.1:5433")
pg_database = "grant_#{Digest::SHA1.hexdigest(Dir.pwd)[0, 10]}"
errors = []
tests = ARGV.empty? ? Dir.glob("test/**/*_test.ri").sort : ARGV
if adapters.include?("pg") && !ENV.key?("PG_DATABASE_URL")
  _, status = Open3.capture2e("psql", "#{pg_server}/postgres", "-qtc", "SELECT 1")
  errors << "PostgreSQL is unreachable at #{pg_server} (docker start grant-pg)" unless status.success?
  exists, _ = Open3.capture2e("psql", "#{pg_server}/postgres", "-qtAc", "SELECT 1 FROM pg_database WHERE datname = '#{pg_database}'")
  Open3.capture2e("psql", "#{pg_server}/postgres", "-qc", "CREATE DATABASE #{pg_database}") if status.success? && exists.strip != "1"
end
errors << "no tests selected" if tests.empty?
# Tests run in PORT_JOBS parallel slots. Each slot has its own SQLite file, PostgreSQL database
# and TMPDIR, so concurrent tests never share rows.
jobs = ENV.fetch("TEST_JOBS", [Etc.nprocessors / 2, 1].max.to_s).to_i.clamp(1, 64)
slot_env = (0...jobs).map do |slot|
  db = slot.zero? ? pg_database : "#{pg_database}_j#{slot}"
  tmp = File.join(Dir.pwd, "build", "jobs", slot.to_s)
  FileUtils.mkdir_p(tmp)
  if slot.positive? && adapters.include?("pg") && !ENV.key?("PG_DATABASE_URL")
    exists, _ = Open3.capture2e("psql", "#{pg_server}/postgres", "-qtAc", "SELECT 1 FROM pg_database WHERE datname = '#{db}'")
    Open3.capture2e("psql", "#{pg_server}/postgres", "-qc", "CREATE DATABASE #{db}") if exists.strip != "1"
  end
  {
    "PG_DATABASE_URL" => ENV.fetch("PG_DATABASE_URL", "#{pg_server}/#{db}"),
    "SQLITE_DATABASE_URL" => ENV.fetch("SQLITE_DATABASE_URL", slot.zero? ? "sqlite3:./grant_green.db" : "sqlite3:#{tmp}/grant_green.db"),
    "TMPDIR" => slot.zero? ? ENV.fetch("TMPDIR", tmp) : tmp,
  }
end
queue = Queue.new
tests.each { |file| queue << file }
lock = Mutex.new
started = Time.now
workers = slot_env.map do |slot|
  Thread.new do
    while (file = (queue.pop(true) rescue nil))
      unless File.file?(file) && file.end_with?("_test.ri")
        lock.synchronize { errors << "missing or invalid test: #{file}" }
        next
      end
      adapters.each do |adapter|
        env = ENV.to_h.merge(slot).merge("CURRENT_ADAPTER" => adapter)
        output, status = Open3.capture2e(env, ris, "test", "--json", file)
        # Parallel compilers share .ris-cache; a codegen I/O race fails the build, not the test.
        if output.include?("a codegen thread failed")
          output, status = Open3.capture2e(env, ris, "test", "--json", file)
        end
        begin
          result = JSON.parse(output)
          passed = status.success? && result["failed"] == 0 && result["skipped"] == 0 && result["passed"].to_i > 0 &&
            result.fetch("tests").all? { |t| t["status"] == "pass" }
          error = "test failed on #{adapter}: #{file}" unless passed
        rescue JSON::ParserError, KeyError
          error = "invalid test JSON on #{adapter}: #{file}"
        end
        lock.synchronize do
          puts "[#{adapter}] #{output}"
          errors << error if error
        end
      end
    end
  end
end
workers.each(&:join)
puts "RAN #{tests.size} tests x #{adapters.size} adapters in #{(Time.now - started).round}s with #{jobs} jobs"
errors.each { |error| warn error }
exit(errors.empty? ? 0 : 1)
