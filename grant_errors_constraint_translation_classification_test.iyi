import grant/adapter/sqlite::{Sqlite}
import grant/adapter/error_translator::{Kind}

alias G01Kind = Kind

# it: classifies constraints by their message
assert Sqlite.error_kind(19, "UNIQUE constraint failed: t.email") == G01Kind::Unique
assert Sqlite.error_kind(19, "FOREIGN KEY constraint failed") == G01Kind::ForeignKey
assert Sqlite.error_kind(19, "NOT NULL constraint failed: t.email") == G01Kind::NotNull
assert Sqlite.error_kind(19, "CHECK constraint failed: positive").nil?

# it: classifies extended constraint codes without the message
assert Sqlite.error_kind(2067) == G01Kind::Unique
assert Sqlite.error_kind(1555) == G01Kind::Unique
assert Sqlite.error_kind(787) == G01Kind::ForeignKey
assert Sqlite.error_kind(1299) == G01Kind::NotNull

# it: classifies the non-constraint result codes
assert Sqlite.error_kind(5, "database is locked") == G01Kind::LockWaitTimeout
assert Sqlite.error_kind(6, "database table is locked") == G01Kind::LockWaitTimeout
assert Sqlite.error_kind(517) == G01Kind::LockWaitTimeout
assert Sqlite.error_kind(8, "attempt to write a readonly database") == G01Kind::ReadOnly
assert Sqlite.error_kind(9, "interrupted") == G01Kind::QueryCanceled
assert Sqlite.error_kind(14, "unable to open database file") == G01Kind::NoDatabase
assert Sqlite.error_kind(18, "string or blob too big") == G01Kind::ValueTooLong
assert Sqlite.error_kind(1, "SQL logic error").nil?
assert Sqlite.error_kind(nil).nil?

# Additional native checks cover the upstream legacy message and the low-byte
# rule without introducing markers for examples that do not exist upstream.
assert Sqlite.error_kind(19, "PRIMARY KEY must be unique") == G01Kind::Unique
assert Sqlite.error_kind(19).nil?
assert Sqlite.error_kind(275, "CHECK constraint failed: positive").nil?
assert Sqlite.error_kind(1032) == G01Kind::ReadOnly
assert Sqlite.error_kind(2067, "unrelated message") == G01Kind::Unique
