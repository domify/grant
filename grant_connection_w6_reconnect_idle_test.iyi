import std/time::{Span}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite, Connection}
import grant/adapter/pg::{Pg}
import grant/adapter/drivers::{open_connection}
import grant/connection_registry::{ConnectionRegistry}
import grant/database::{ConnectionLost}
import grant/errors::{ErrorBase}
import w6_c04_support::{W6C04}

# SQLite has no server to restart, so its adapter here fails the idle probe the
# way a dead socket does. PostgreSQL gets the real thing: its backends are
# terminated, as a restart or a failover would.
class W6ProbeSqlite < Sqlite
  property probes : Int32 = 0
  property dead_probes : Int32 = 0

  protected def verify_idle_connection(connection : Connection) : Nil | ErrorBase
    @probes += 1
    if @dead_probes > 0
      @dead_probes -= 1
      return ConnectionLost.new(connection)
    end
    super
  end
end

class W6IdleThing < Base
  connection "w6_idle"
  table w6_idle_things
  column id : Int64, primary: true
  column label : String?
end

private def w6_idle_adapter(verify_idle_after : Span?) : ::Grant::Adapter::Base::Base
  if W6C04.pg?
    ConnectionRegistry.establish_connection(database: "w6_idle", adapter: Pg, url: W6C04.url("w6_idle"),
      role: :primary, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
  else
    ConnectionRegistry.establish_connection(database: "w6_idle", adapter: W6ProbeSqlite, url: W6C04.url("w6_idle"),
      role: :primary, pool_size: 3, initial_pool_size: 1, verify_idle_after: verify_idle_after).or_panic
  end
  ConnectionRegistry.get_adapter("w6_idle", :primary)
end

# Makes every idle connection of *adapter* dead: terminates the PostgreSQL
# backends, or arms the SQLite probe to fail once.
private def w6_kill_idle_connections(adapter : ::Grant::Adapter::Base::Base) : Nil
  if W6C04.pg?
    killer = open_connection(W6C04.pg_url("postgres")).or_panic
    killer.exec("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '#{W6C04.database_name("w6_idle")}' AND pid <> pg_backend_pid()").or_panic
    killer.close.or_panic
  else
    adapter.as(W6ProbeSqlite).dead_probes = 1
  end
  nil
end

private def w6_probes(adapter : ::Grant::Adapter::Base::Base) : Int32
  W6C04.pg? ? 0 : adapter.as(W6ProbeSqlite).probes
end

W6C04.provision("w6_idle", ["CREATE TABLE w6_idle_things (#{W6C04.id_column}, label TEXT)"])

# it: replaces a dead idle connection with one probe instead of failing the write
adapter = w6_idle_adapter(Span.milliseconds(20_i64))
W6IdleThing.create_strict(label: "before").or_panic
sleep(40).or_panic
w6_kill_idle_connections(adapter)
assert W6IdleThing.create_strict(label: "after the restart").or_panic.persisted?
assert W6IdleThing.where(label: "after the restart").select.or_panic.size == 1
W6C04.remove("w6_idle", :primary)

# it: starts a transaction on a connection that went stale while idle
adapter = w6_idle_adapter(Span.milliseconds(20_i64))
W6IdleThing.create_strict(label: "warm").or_panic
sleep(40).or_panic
w6_kill_idle_connections(adapter)
W6IdleThing.transaction { W6IdleThing.create_strict(label: "inside a transaction") }.or_panic
assert W6IdleThing.where(label: "inside a transaction").select.or_panic.size == 1
W6C04.remove("w6_idle", :primary)

# it: reads through a dead idle connection
adapter = w6_idle_adapter(Span.milliseconds(20_i64))
W6IdleThing.create_strict(label: "readable").or_panic
sleep(40).or_panic
w6_kill_idle_connections(adapter)
assert W6IdleThing.where(label: "readable").select.or_panic.size == 1
W6C04.remove("w6_idle", :primary)

# it: keeps the pool within its size when it discards a dead connection
adapter = w6_idle_adapter(Span.milliseconds(20_i64))
W6IdleThing.create_strict(label: "pool").or_panic
sleep(40).or_panic
w6_kill_idle_connections(adapter)
W6IdleThing.count.or_panic
assert adapter.pool_stat.connections <= 3
assert adapter.pool_stat.busy == 0
W6C04.remove("w6_idle", :primary)

# it: never probes connections that are in use
adapter = w6_idle_adapter(Span.seconds(10_i64))
statements = [] of String
adapter.database.or_panic.checkout.or_panic.query_observer = ->(sql : String) { statements << sql; nil }
200.times { W6IdleThing.count.or_panic }
assert w6_probes(adapter) == 0
assert statements.select { |sql| sql.strip.upcase.starts_with?("SELECT 1") }.size == 0
W6C04.remove("w6_idle", :primary)

# it: probes once after the idle threshold, not on every checkout
adapter = w6_idle_adapter(Span.milliseconds(30_i64))
W6IdleThing.count.or_panic
sleep(60).or_panic
statements = [] of String
adapter.database.or_panic.checkout.or_panic.query_observer = ->(sql : String) { statements << sql; nil }
50.times { W6IdleThing.count.or_panic }
probes = statements.select { |sql| sql.strip.upcase.starts_with?("SELECT 1") }.size
assert (W6C04.pg? ? probes : w6_probes(adapter)) == 1
W6C04.remove("w6_idle", :primary)

# it: rebuilds the pool on reconnect!
adapter = w6_idle_adapter(Span.milliseconds(20_i64))
W6IdleThing.create_strict(label: "first").or_panic
adapter.reconnect_strict.or_panic
assert adapter.connected?
assert W6IdleThing.where(label: "first").select.or_panic.size == 1
W6C04.remove("w6_idle", :primary)
W6C04.cleanup
