module grant/polymorphic

import grant/base
import grant/columns
import grant/querying

pub import grant/polymorphic_types

# Upstream's final dispatch table over the registered types.

macro finished
  pub def registered_type?(type_name : String) : Bool
    case type_name
    {% for name, klass in ::Grant::PolymorphicTypes::REGISTERED_TYPES %}
    when {{ name }}
      {{ !klass.resolve.abstract? }}
    {% end %}
    else
      false
    end
  end

  pub def load_polymorphic(type_name : String, id : ::Grant::Columns::Type) : ::Grant::Base::Base | Nil | ::Grant::Error::ErrorBase
    bound_id = ::Grant::Base.sqlite_value(id)
    return ::Grant::Error::ArgumentError.new("Polymorphic id must be a scalar") if bound_id.is_a?(Array)
    case type_name
    {% for name, klass in ::Grant::PolymorphicTypes::REGISTERED_TYPES %}
    when {{ name }}
      {% unless klass.resolve.abstract? %}
        {{ klass }}.find(bound_id)
      {% else %}
        nil
      {% end %}
    {% end %}
    else
      nil
    end
  end
end

pub def load_polymorphic_strict(type_name : String, id : ::Grant::Columns::Type) : ::Grant::Base::Base | ::Grant::Error::ErrorBase
  record = load_polymorphic(type_name, id)!
  return record unless record.nil?
  ::Grant::Querying::NotFound.new("No #{type_name} found with id #{id}")
end

pub struct PolymorphicProxy
  getter type : String?
  getter id : ::Grant::Columns::Type

  def initialize(@type : String?, @id : ::Grant::Columns::Type)
  end

  def present? : Bool
    !@type.nil? && !@id.nil?
  end

  def load : ::Grant::Base::Base | Nil | ::Grant::Error::ErrorBase
    type_name = @type
    key = @id
    return nil if type_name.nil? || key.nil?
    ::Grant::Polymorphic.load_polymorphic(type_name, key)
  end

  def load_strict : ::Grant::Base::Base | ::Grant::Error::ErrorBase
    type_name = @type
    key = @id
    return ::Grant::Querying::NotFound.new("Polymorphic association not set") if type_name.nil? || key.nil?
    ::Grant::Polymorphic.load_polymorphic_strict(type_name, key)
  end

  def reload : ::Grant::Base::Base | Nil | ::Grant::Error::ErrorBase
    load
  end
end

pub macro belongs_to_polymorphic(name, **options)
  {% foreign_key = options[:foreign_key] || name.id.stringify + "_id" %}
  {% type_column = options[:type_column] || name.id.stringify + "_type" %}
  column {{ foreign_key.id }} : Int64?
  column {{ type_column.id }} : String?

  def {{ name.id }}_proxy : ::Grant::Polymorphic::PolymorphicProxy
    ::Grant::Polymorphic::PolymorphicProxy.new(@{{ type_column.id }}, @{{ foreign_key.id }})
  end

  @[::Grant::Associations::Relationship(target: ::Grant::Base::Base, type: :belongs_to,
    polymorphic: true, foreign_key: {{ foreign_key.id.stringify }},
    type_column: {{ type_column.id.stringify }}, primary_key: "id")]
  def {{ name.id }} : ::Grant::Base::Base | Nil | ::Grant::Error::ErrorBase
    loaded = get_loaded_association({{ name.id.stringify }})
    return loaded.first? unless loaded.nil?
    {{ name.id }}_proxy.load
  end

  def {{ name.id }}_strict : ::Grant::Base::Base | ::Grant::Error::ErrorBase
    record = {{ name.id }}!
    return record unless record.nil?
    ::Grant::Querying::NotFound.new("Polymorphic association not found")
  end

  def {{ name.id }}=(record : ::Grant::Base::Base?) : Nil | ::Grant::Error::ErrorBase
    key = record.nil? ? nil : record.__primary_value
    self.{{ foreign_key.id }} = key.nil? ? nil : key.as(Int64)
    self.{{ type_column.id }} = record.nil? ? nil : record.class.to_s
    records = [] of ::Grant::Base::Base
    records << record unless record.nil?
    set_loaded_association({{ name.id.stringify }}, records)
    nil
  end
end
