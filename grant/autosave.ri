module grant/autosave

# The belongs_to slice saves an assigned new parent before its owner's insert.
pub macro setup_belongs_to(name, target, foreign_key, primary_key, autosave)
  def _autosave_before_save_{{ name }} : Nil | ::Grant::Error::ErrorBase
    {% unless autosave == false %}
      loaded = get_loaded_association({{ name.id.stringify }})
      parent = loaded.nil? ? nil : loaded.first?.as({{ target }}?)
      if !parent.nil? && (parent.new_record? || ({{ autosave == true }} && parent.changed?))
        parent.save_strict!
        self.{{ foreign_key }} = parent.{{ primary_key.id }}
      end
    {% end %}
    nil
  end
end
