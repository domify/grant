module grant/tasks/database

import grant/adapter/base::{Base}
import grant/adapter/pg::{Pg}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/schema::{Dialect}
import grant/adapter/test_helpers
import grant/schema/introspection
import grant/schema/migration::{Migration, MigrationEntry}
import grant/schema/migration_context::{MigrationContext}
import grant/schema/schema_migration::{Tracking}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError}
import grant/error::{ErrorBase}
import std/file::{File}
import std/dir::{Dir}
import std/text
import std/io

pub class DatabaseTaskError < ErrorBase
end

# Database lifecycle and truncation slice of src/grant/tasks/database.cr.
pub class Database
  getter url : String
  getter environment : String
  getter name : String
  getter db_dir : String
  getter migration_paths : Array(String)
  getter protected_environments : Array(String)
  getter tracking : Tracking
  @adapter : Base?
  @migrations : Array(MigrationEntry)?
  @output : IO?
  @database_tasks : Bool

  def initialize(@url : String, @environment : String, @name : String = "primary",
                 adapter : Base? = nil, @migrations : Array(MigrationEntry)? = nil,
                 @migration_paths : Array(String) = [] of String, @db_dir : String = "db",
                 @protected_environments : Array(String) = InternalMetadata::DEFAULT_PROTECTED,
                 @tracking : Tracking = Tracking::Grant, @output : IO? = nil,
                 @database_tasks : Bool = true)
    @adapter = adapter
  end
  def database_tasks? : Bool
    @database_tasks
  end
  private def postgres? : Bool
    url.starts_with?("postgres:") || url.starts_with?("postgresql:")
  end
  private def sqlite_path : String
    url.sub("sqlite3:", "").sub("sqlite:", "")
  end
  private def database_name : String
    url.split('?').first.split('/').last
  end
  private def maintenance : Pg
    slash = url.rindex('/').as(Int32)
    Pg.new("grant_tasks_maintenance", "#{url[0...slash]}/postgres")
  end
  def adapter : Base
    if current = @adapter
      current
    else
      current = postgres? ? Pg.new(name, url).as(Base) : Sqlite.new(name, url).as(Base)
      @adapter = current
      current
    end
  end
  def exists? : Bool | ErrorBase | Cancelled
    return File.exists?(sqlite_path) || sqlite_path == ":memory:" unless postgres?
    server = maintenance
    result = server.open { |db| db.scalar("SELECT COUNT(*) FROM pg_database WHERE datname = #{Dialect::Pg.quote_literal(database_name)}")!.as(Int64) > 0 }
    server.disconnect_strict
    result
  end
  def create(encoding : String? = nil, template : String? = nil,
             charset : String? = nil, collation : String? = nil) : Bool | ErrorBase | Cancelled
    return false unless database_tasks?
    return false if exists?!
    if postgres?
      sql = "CREATE DATABASE #{Dialect::Pg.quote(database_name)}"
      sql += " ENCODING #{Dialect::Pg.quote_literal(encoding)}" if encoding
      sql += " TEMPLATE #{Dialect::Pg.quote(template)}" if template
      server = maintenance
      result = server.open { |db| db.exec(sql) }
      server.disconnect_strict
      result!
    else
      Dir.mkdir_p(File.dirname(sqlite_path))
      File.write(sqlite_path, "")
    end
    true
  end
  def guard_strict(force : Bool = false) : Nil | ErrorBase | Cancelled
    return nil if force
    return ProtectedEnvironmentError.new(environment) if protected_environments.includes?(environment)
    return nil unless exists?!
    InternalMetadata.new(adapter).check_protected_environments_strict(environment, protected_environments, false)
  end
  def drop(force : Bool = false) : Bool | ErrorBase | Cancelled
    return false unless database_tasks?
    guard_strict(force)!
    return false unless exists?!
    if current = @adapter
      current.disconnect_strict!
      @adapter = nil
    end
    if postgres?
      server = maintenance
      result = server.open { |db| db.exec("DROP DATABASE #{Dialect::Pg.quote(database_name)} WITH (FORCE)") }
      server.disconnect_strict
      result!
    else
      [sqlite_path, "#{sqlite_path}-wal", "#{sqlite_path}-shm"].each do |path|
        File.delete(path) if File.exists?(path)
      end
    end
    true
  end
  def migration_context : MigrationContext
    MigrationContext.new(adapter, @migrations || Migration.registry.dup, paths: migration_paths,
      tracking: tracking, output: @output, environment: environment)
  end
  def migrate : Array(Int64) | ErrorBase | Cancelled
    return [] of Int64 unless database_tasks?
    migration_context.migrate
  end
  def version : Int64 | ErrorBase | Cancelled
    migration_context.current_version
  end
  def truncate_all(except : Array(String) = [] of String, force : Bool = false) : Array(String) | ErrorBase | Cancelled
    return [] of String unless database_tasks?
    guard_strict(force)!
    keep = ["schema_migrations", "micrate_db_version", "ar_internal_metadata"]
    adapter.reset_schema_caches_in_place
    tables = adapter.schema.tables!.reject { |table| keep.includes?(table) || except.includes?(table) }
    adapter.truncate_tables(tables)!
    tables
  end
end
