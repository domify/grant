module grant/callbacks
import grant/error

pub class Abort < ::Grant::Error::ErrorBase
end

impl ::Error for Abort
  def message : String
    @message
  end
end

pub annotation Callback
end

# One record's resolved operation at a transaction boundary. Savepoints keep
# their own entry until release, so a rollback cannot overwrite the outer work.
pub class CommitCallback
  getter operation : Symbol
  property active : Bool = true
  getter on_commit : Proc(Symbol, Nil | ::Grant::Error::ErrorBase)
  getter on_rollback : Proc(Symbol, Nil)

  def initialize(@operation : Symbol, @on_commit : Proc(Symbol, Nil | ::Grant::Error::ErrorBase), @on_rollback : Proc(Symbol, Nil))
  end

  def merge(operation : Symbol) : Nil
    @operation = operation if operation == :destroy || @operation != :create
    nil
  end

  def commit : Nil | ::Grant::Error::ErrorBase
    @active ? @on_commit.call(@operation) : nil
  end

  def rollback : Nil
    @on_rollback.call(@operation) if @active
    nil
  end
end
