module grant/result

import grant/adapter/driver::{Value, ResultSet}
import grant/errors::{DatabaseError}
import grant/error::{ArgumentError}
import std/text

pub class Result
  def self.integer_count(value : T) : Int64 | ArgumentError forall T
    return 0_i64 if value.nil?
    if value.is_a?(Int8) || value.is_a?(Int16) || value.is_a?(Int32) || value.is_a?(Int64) || value.is_a?(UInt8) || value.is_a?(UInt16) || value.is_a?(UInt32) || value.is_a?(UInt64) || value.is_a?(Float32) || value.is_a?(Float64)
      value.to_i64
    else
      text = value.to_s
      integer = text.to_i64?
      return integer unless integer.nil?
      decimal = text.to_f?
      return decimal.to_i64 unless decimal.nil?
      ArgumentError.new("count_by_sql did not return a numeric value")
    end
  end

  pub alias Row = Array(Value)
  pub alias HashRow = Hash(String, Value)

  getter columns : Array(String)
  getter rows : Array(Row)

  def initialize(@columns : Array(String), @rows : Array(Row))
  end

  def self.from(result_set : ResultSet) : Result | DatabaseError
    columns = result_set.column_names
    rows = [] of Row
    result_set.each do
      row = [] of Value
      result_set.column_count.times { row << result_set.read! }
      rows << row
      nil
    end!
    new(columns, rows)
  end

  def each(&block : HashRow -> T) : Nil forall T
    rows.each { |row| yield hash_row(row) }
    nil
  end

  def to_a : Array(HashRow)
    rows.map { |row| hash_row(row) }
  end

  def size : Int32
    rows.size
  end

  def empty? : Bool
    rows.empty?
  end

  private def hash_row(row : Row) : HashRow
    values = {} of String => Value
    columns.each_with_index { |column, index| values[column] = row[index] }
    values
  end
end
