module grant/dependent

# SQL deletion deliberately bypasses target instantiation and callbacks.
pub macro setup_dependent_delete_all(association_name, association_type, target_class, foreign_key, primary_key)
  def __dependent_delete_all_{{ association_name.id }} : Nil | ::Grant::Error::ErrorBase
    key = self.read_attribute({{ primary_key }})!
    {{ target_class }}.where({{ foreign_key }}, :eq, key).delete_all!
    nil
  end
end

pub macro model_methods(model)
  def __destroy_dependents : Nil | ::Grant::Error::ErrorBase
    \{% for method in @type.methods.select { |method| method.name.starts_with?("__dependent_delete_all_") } %}
      \{{ method.name }}!
    \{% end %}
    nil
  end
end
