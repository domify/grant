module grant/validation_helpers/uniqueness

pub macro model_methods(model)
  macro validate_uniqueness(field)
    def __validate_uniqueness_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
      value = \{{ field.id }}
      return nil if value.nil?
      instance = self.class.find_by(\{{ field.id }}: value)!
      if !instance.nil? && instance.id != id
        errors << ::Grant::Error::Error.new(\{{ field }}, "#{\{{ field }}} should be unique")
      end
      nil
    end
  end
end
