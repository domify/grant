module grant/validation_helpers/blank

pub macro model_methods(model)
  macro validate_not_blank(field)
    validate \{{ field }}, "#{\{{ field }}} must not be blank" do |model|
      !model.\{{ field.id }}.to_s.strip.empty?
    end
  end

  macro validate_is_blank(field)
    validate \{{ field }}, "#{\{{ field }}} must be blank" do |model|
      model.\{{ field.id }}.to_s.strip.empty?
    end
  end

end
