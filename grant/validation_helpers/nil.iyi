module grant/validation_helpers/nil

pub macro model_methods(model)
  macro validate_not_nil(field)
    validate \{{ field }}, "#{\{{ field }}} must not be nil" do |model|
      !model.\{{ field.id }}.nil?
    end
  end

  macro validate_is_nil(field)
    validate \{{ field }}, "#{\{{ field }}} must be nil" do |model|
      model.\{{ field.id }}.nil?
    end
  end

end
