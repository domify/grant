module grant/validation_helpers/inequality

pub macro model_methods(model)
  macro validate_greater_than(field, amount, or_equal_to = false)
    def __validate_greater_than_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
      value = \{{ field.id }}
      return ::Grant::Encryption::Sealed::NilAssertionError.new("Nil assertion failed") if value.nil?
      valid = \{% if or_equal_to %} value >= \{{ amount }} \{% else %} value > \{{ amount }} \{% end %}
      unless valid
        errors << ::Grant::Error::Error.new(\{{ field }},
          "#{\{{ field }}} must be greater than#{\{{ or_equal_to }} ? " or equal to" : ""} #{\{{ amount }}}")
      end
      nil
    end
  end

  macro validate_less_than(field, amount, or_equal_to = false)
    def __validate_less_than_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
      value = \{{ field.id }}
      return ::Grant::Encryption::Sealed::NilAssertionError.new("Nil assertion failed") if value.nil?
      valid = \{% if or_equal_to %} value <= \{{ amount }} \{% else %} value < \{{ amount }} \{% end %}
      unless valid
        errors << ::Grant::Error::Error.new(\{{ field }},
          "#{\{{ field }}} must be less than#{\{{ or_equal_to }} ? " or equal to" : ""} #{\{{ amount }}}")
      end
      nil
    end
  end
end
