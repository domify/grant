module grant/validation_helpers/length

pub macro model_methods(model)
  macro validate_min_length(field, length)
    def __validate_min_length_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
      value = \{{ field.id }}
      return ::Grant::Encryption::Sealed::NilAssertionError.new("Nil assertion failed") if value.nil?
      if value.size < \{{ length }}
        errors << ::Grant::Error::Error.new(\{{ field }},
          "#{\{{ field }}} is too short. It must be at least #{\{{ length }}}")
      end
      nil
    end
  end

  macro validate_max_length(field, length)
    def __validate_max_length_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
      value = \{{ field.id }}
      return ::Grant::Encryption::Sealed::NilAssertionError.new("Nil assertion failed") if value.nil?
      if value.size > \{{ length }}
        errors << ::Grant::Error::Error.new(\{{ field }},
          "#{\{{ field }}} is too long. It must be at most #{\{{ length }}}")
      end
      nil
    end
  end
end
