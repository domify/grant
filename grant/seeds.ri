module grant/seeds
import std/text
import std/file::{File}
import grant/adapter/base::{Base}
import grant/errors::{ErrorBase}
import grant/transaction
import grant/connections::{Connections}

pub TABLE = "grant_seeds"
pub DEFAULT_PATH = "db/seeds.cr"
pub class SeedFileMissing < ErrorBase
  getter path : String
  def initialize(@path : String)
    super("Seeds file #{@path} does not exist")
  end
end
impl ::Error for SeedFileMissing
  def message : String
    @message
  end
end
pub class SeedsNotCompiled < ErrorBase
  getter path : String
  def initialize(@path : String)
    super("#{@path} is not loaded: require it (it calls Grant::Seeds.define) before running the seeds")
  end
end
impl ::Error for SeedsNotCompiled
  def message : String
    @message
  end
end
pub struct Block
  getter source : String
  getter body : Proc(Nil | ErrorBase)
  def initialize(@source : String, @body : Proc(Nil | ErrorBase))
  end
end
@@blocks = [] of Block
@@scoped_adapters = {} of UInt64 => Base
private def normalize(value : T) : Nil | ErrorBase forall T
  value.is_a?(ErrorBase) ? value : nil
end
pub def define(source : String = DEFAULT_PATH, &body : -> T) : Nil forall T
  @@blocks << Block.new(source, -> { normalize(body.call) })
  nil
end
pub def clear_definitions_in_place : Nil
  @@blocks.clear
  nil
end
private def blocks_for(path : String) : Array(Block)
  suffix = "/" + path
  @@blocks.select { |block| block.source == path || block.source.ends_with?(suffix) }
end
pub def defined?(path : String = DEFAULT_PATH) : Bool
  !blocks_for(path).empty?
end
pub def with_adapter(adapter : Base?, &block : -> T) : T forall T
  return yield if adapter.nil?
  fiber = IyiScheduler.current.object_id
  previous = @@scoped_adapters[fiber]?
  @@scoped_adapters[fiber] = adapter
  result = yield
  if previous
    @@scoped_adapters[fiber] = previous
  else
    @@scoped_adapters.delete(fiber)
  end
  result
end
pub def default_adapter : Base
  @@scoped_adapters[IyiScheduler.current.object_id]? || Connections["default"]
end
pub def run(path : String = DEFAULT_PATH, adapter : Base? = nil) : Int32 | ErrorBase
  blocks = blocks_for(path)
  if blocks.empty?
    return SeedFileMissing.new(path) unless File.exists?(path)
    return SeedsNotCompiled.new(path)
  end
  with_adapter(adapter) do
    blocks.each { |block| block.body.call! }
    blocks.size
  end
end
private def literal(text : String) : String
  "'#{text.gsub("'", "''")}'"
end
pub def table_exists?(adapter : Base) : Bool | ErrorBase | Cancelled
  sql = adapter.postgres? ? "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = current_schema() AND table_name = 'grant_seeds'" : "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = 'grant_seeds'"
  adapter.open { |db| db.scalar(sql)!.as(Int64) > 0 }
end
private def ensure_table(adapter : Base) : Nil | ErrorBase | Cancelled
  return nil if table_exists?(adapter)!
  adapter.open { |db| db.exec("CREATE TABLE IF NOT EXISTS grant_seeds (name VARCHAR(255) NOT NULL PRIMARY KEY, applied_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)")!; nil }
end
pub def load_once(name : String, adapter : Base = default_adapter, &block : -> T) : Bool | ErrorBase | Cancelled forall T
  ensure_table(adapter)!
  ran = false
  result = ::Grant::Transaction.run(adapter, ::Grant::Transaction::Options.new) do
    claimed = adapter.open { |db| db.exec("INSERT INTO grant_seeds (name) VALUES (#{literal(name)}) ON CONFLICT (name) DO NOTHING")!.changes > 0 }
    if claimed.is_a?(ErrorBase) || claimed.is_a?(Cancelled)
      claimed
    elsif claimed
      value = yield
      if value.is_a?(ErrorBase)
        value
      else
        ran = true
        nil
      end
    else
      nil
    end
  end
  return result if result.is_a?(ErrorBase)
  ran
end
pub def applied(adapter : Base = default_adapter) : Array(String) | ErrorBase | Cancelled
  ensure_table(adapter)!
  adapter.open { |db| db.query("SELECT name FROM grant_seeds ORDER BY applied_at, name")!.map { |row| row["name"].as(String) } }
end
pub def applied?(name : String, adapter : Base = default_adapter) : Bool | ErrorBase | Cancelled
  applied(adapter)!.includes?(name)
end
pub def forget(name : String, adapter : Base = default_adapter) : Nil | ErrorBase | Cancelled
  ensure_table(adapter)!
  adapter.open { |db| db.exec("DELETE FROM grant_seeds WHERE name = #{literal(name)}")!; nil }
end
pub def any_applied?(adapter : Base = default_adapter) : Bool | ErrorBase | Cancelled
  return false unless table_exists?(adapter)!
  adapter.open { |db| db.scalar("SELECT COUNT(*) FROM grant_seeds")!.as(Int64) > 0 }
end
