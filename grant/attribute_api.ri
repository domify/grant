module grant/attribute_api
import std/text
import std/time::{Time}

pub annotation VirtualAttribute
end
pub annotation Definition
end
pub alias AttributeDefinition = NamedTuple(name: String, type: String, virtual: Bool, has_default: Bool, has_converter: Bool)

pub macro attribute(decl, **options)
  @[::Grant::AttributeApi::Definition(name: {{ decl.var.stringify }}, type: {{ decl.type.stringify }},
    virtual: {{ options[:virtual] || false }}, has_default: {{ options[:default] != nil }},
    has_converter: {{ options[:converter] != nil }})]
  def __attribute_definition_{{ decl.var }} : Nil
    nil
  end
  {% if options[:virtual] %}
    @[::Grant::AttributeApi::VirtualAttribute]
    @{{ decl.var }} : {{ decl.type }} | Nil = nil
    @__persisted_{{ decl.var }} : {{ decl.type }} | Nil = nil
    ::Grant::Columns.dirty_column_methods({{ decl }})

    def {{ decl.var }} : {{ decl.type }} | Nil
      {% if options[:default] != nil %}
        if @{{ decl.var }}.nil?
          @{{ decl.var }} = {% if options[:default].is_a?(ProcLiteral) %}{{ options[:default] }}.call(self){% else %}{{ options[:default] }}{% end %}
        end
      {% end %}
      @{{ decl.var }}
    end

    def {{ decl.var }}=(value : {{ decl.type }} | Nil) : Nil
      @{{ decl.var }} = value
      nil
    end

    def {{ decl.var }}_changed? : Bool
      return true if __forced_dirty_attribute?({{ decl.var.stringify }})
      !new_record? && @{{ decl.var }} != @__persisted_{{ decl.var }}
    end

    def __raw_{{ decl.var }} : {{ decl.type }} | Nil
      @{{ decl.var }}
    end
  {% else %}
    column({{ decl.var }} : {{ decl.type }}{% if options[:default] != nil && !options[:default].is_a?(ProcLiteral) %} = {{ options[:default] }}{% end %}, {% for key, value in options %}{{ key.id }}: {{ value }}, {% end %})
    {% if options[:default] != nil %}
      def {{ decl.var }} : {{ decl.type }} | Nil
        value = @{{ decl.var }}
        return value unless value.nil?
        {% if options[:default].is_a?(ProcLiteral) %}{{ options[:default] }}.call(self){% else %}{{ options[:default] }}{% end %}
      end
    {% end %}
  {% end %}
end

pub macro attributes(**attrs)
  {% for name, options in attrs %}
    {% if options.is_a?(HashLiteral) %}
      attribute({{ name }} : {{ options[:type] }}, {% for key, value in options %}{{ key.id }}: {{ value }}, {% end %})
    {% else %}
      attribute {{ name }} : {{ options }}
    {% end %}
  {% end %}
end

pub macro model_methods(model)
  @@attribute_definitions_native : Hash(String, ::Grant::AttributeApi::AttributeDefinition)? = nil
  def self.attribute_definitions : Hash(String, ::Grant::AttributeApi::AttributeDefinition)
    cached = @@attribute_definitions_native
    return cached unless cached.nil?
    definitions = {} of String => ::Grant::AttributeApi::AttributeDefinition
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::AttributeApi::Definition) %}
        definitions[\{{ ann[:name] }}] = {name: \{{ ann[:name] }}, type: \{{ ann[:type] }},
          virtual: \{{ ann[:virtual] }}, has_default: \{{ ann[:has_default] }}, has_converter: \{{ ann[:has_converter] }}}
      \{% end %}
    \{% end %}
    @@attribute_definitions_native = definitions
    definitions
  end
  def self.attribute_definitions=(definitions : Hash(String, ::Grant::AttributeApi::AttributeDefinition)) : Hash(String, ::Grant::AttributeApi::AttributeDefinition)
    @@attribute_definitions_native = definitions
  end
  def custom_attribute_names : Array(String)
    self.class.attribute_definitions.keys
  end
  def virtual_attribute_names : Array(String)
    names = [] of String
    self.class.attribute_definitions.each { |name, definition| names << name if definition[:virtual] }
    names
  end
  def virtual_attribute?(name : String) : Bool
    definition = self.class.attribute_definitions[name]?
    definition.nil? ? false : definition[:virtual]
  end
end

# A static class retains the public namespace: native nested modules cannot be exported.
pub class TypeCasters
  def self.to_string(value : T) : String? forall T
    value.nil? ? nil : value.to_s
  end
  def self.to_int32(value : T) : Int32? forall T
    case value
    when String then value.to_i?
    when Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, Float32, Float64 then value.to_i32
    else nil
    end
  end
  def self.to_float64(value : T) : Float64? forall T
    case value
    when String then value.to_f?
    when Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, Float32, Float64 then value.to_f64
    else nil
    end
  end
  def self.to_bool(value : T) : Bool? forall T
    case value
    when Bool then value
    when String
      case value.downcase
      when "true", "1", "yes", "on" then true
      when "false", "0", "no", "off" then false
      else nil
      end
    when Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, Float32, Float64 then value != 0
    else nil
    end
  end
  def self.to_time(value : T) : Time | Nil | ::Grant::Error::ArgumentError forall T
    case value
    when Time then value
    when String then ::Grant::ColumnsHelpers.time_from_db_strict(value)
    else nil
    end
  end

end
