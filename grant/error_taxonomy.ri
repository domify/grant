module grant/error_taxonomy

import grant/error::{ErrorBase}
import grant/settings::{settings}

pub class StatementInvalid < ErrorBase
  MAX_BINDS = 20
  MAX_BIND_LENGTH = 64
  REDACTED = "[FILTERED]"

  property binds : Array(String) = [] of String
  # Set by a driver that classified this failure as a read-only violation;
  # adapters surface it as ReadOnlyError, which is not a StatementInvalid.
  property read_only : Bool = false
  # Set by a driver whose server dropped the connection under the statement.
  property connection_lost : Bool = false

  def self.describe_binds(values : Array(T)) : Array(String) forall T
    described = [] of String
    capture = settings.capture_statement_bind_values?
    values.each do |value|
      break if described.size >= MAX_BINDS
      described << (capture ? truncate(value.to_s) : REDACTED)
    end
    described
  end

  private def self.truncate(text : String) : String
    text.size > MAX_BIND_LENGTH ? "#{text[0, MAX_BIND_LENGTH]}..." : text
  end

  getter code : Int32
  getter operation : String
  getter detail : String
  property sql : String?
  getter cause : ErrorBase?

  # Upstream keeps the driver's message as the error message; the operation
  # and driver code stay reachable as fields.
  def initialize(message : String = "", @sql : String? = nil, *, @cause : ErrorBase? = nil)
    @code = 0
    @operation = "execute"
    @detail = message
    super(message)
  end

  def initialize(message : String, @sql : String?, binds : Array(T), *, @cause : ErrorBase? = nil) forall T
    @code = 0
    @operation = "execute"
    @detail = message
    @binds = StatementInvalid.describe_binds(binds)
    super(message)
  end

  def initialize(@code : Int32, @operation : String, @detail : String, @sql : String? = nil, @cause : ErrorBase? = nil)
    super(detail)
  end
end

impl ::Error for StatementInvalid
  def message : String
    @message
  end
end

pub class InvalidForeignKey < StatementInvalid
end

pub class RecordNotUnique < StatementInvalid
end

impl ::Error for RecordNotUnique
  def message : String
    @message
  end
end

pub class NotNullViolation < StatementInvalid
end

impl ::Error for NotNullViolation
  def message : String
    @message
  end
end

impl ::Error for InvalidForeignKey
  def message : String
    @message
  end
end

pub class ConnectionNotEstablished < ErrorBase
end

pub class ConnectionTimeoutError < ConnectionNotEstablished
  getter cause : ErrorBase?

  def initialize(message : String, @cause : ErrorBase? = nil)
    super(message)
  end
end

pub class LockWaitTimeout < StatementInvalid
end

impl ::Error for LockWaitTimeout
  def message : String
    @message
  end
end

impl ::Error for ConnectionTimeoutError
  def message : String
    @message
  end
end

impl ::Error for ConnectionNotEstablished
  def message : String
    @message
  end
end

pub class ConnectionFailed < ConnectionNotEstablished
  getter cause : ErrorBase

  def initialize(message : String, @cause : ErrorBase)
    super(message)
  end
end

impl ::Error for ConnectionFailed
  def message : String
    @message
  end
end

pub class NoDatabaseError < StatementInvalid
end

impl ::Error for NoDatabaseError
  def message : String
    @message
  end
end

pub class ValueTooLong < StatementInvalid
end

impl ::Error for ValueTooLong
  def message : String
    @message
  end
end

# The database rolled the transaction back; retrying it is the usual remedy.
pub class TransactionRollbackError < StatementInvalid
end

impl ::Error for TransactionRollbackError
  def message : String
    @message
  end
end

pub class SerializationFailure < TransactionRollbackError
end

impl ::Error for SerializationFailure
  def message : String
    @message
  end
end

pub class Deadlocked < TransactionRollbackError
end

impl ::Error for Deadlocked
  def message : String
    @message
  end
end

pub class StatementTimeout < StatementInvalid
end

impl ::Error for StatementTimeout
  def message : String
    @message
  end
end

pub class QueryCanceled < StatementInvalid
end

impl ::Error for QueryCanceled
  def message : String
    @message
  end
end

# Upstream Grant::Transaction::ReadOnlyError (aliased as Grant::ReadOnlyError).
# It lives here so the adapter translator can build it without importing the
# transaction module; grant/transaction re-exports it.
pub class ReadOnlyError < ErrorBase
  getter cause : ErrorBase?

  def initialize(message : String = "Cannot modify data in read-only transaction", @cause : ErrorBase? = nil)
    super(message)
  end
end

impl ::Error for ReadOnlyError
  def message : String
    @message
  end
end

# No connection was defined for a model.
pub class AdapterNotAvailableError < ConnectionNotEstablished
end

pub alias ConnectionNotDefined = AdapterNotAvailableError
