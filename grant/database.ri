module grant/database

import grant/adapter/driver::{Connection}
import grant/adapter/drivers::{open_connection}
import grant/errors::{DatabaseError}
import std/time::{Span}
import grant/adapter/pool_support::{ticks}
import grant/error::{ErrorBase}
import grant/error_taxonomy::{ConnectionTimeoutError}

pub class PoolResourceRefused < ErrorBase
  def initialize
    super("Connection refused")
  end
end

impl ::Error for PoolResourceRefused
  def message : String
    @message
  end
end

pub class ConnectionRefused < PoolResourceRefused
end

impl ::Error for ConnectionRefused
  def message : String
    @message
  end
end

pub class ConnectionLost < ErrorBase
  getter connection : Connection

  def initialize(@connection : Connection)
    super("Connection lost")
  end
end

pub class PoolTimeout < ErrorBase
end

impl ::Error for PoolTimeout
  def message : String
    @message
  end
end

impl ::Error for ConnectionLost
  def message : String
    @message
  end
end

# Native replacement for the crystal-db database owner. The SQLite driver
# remains separate from Grant's adapter inheritance and owns its C handle.
pub struct PoolStats
  getter max_connections : Int32
  getter open_connections : Int32
  getter idle_connections : Int32

  def initialize(@max_connections : Int32, @open_connections : Int32, @idle_connections : Int32)
  end
end

pub class Pool
  property statement_limit : Int32 = 1000
  property prepared_statements : Bool = true
  property max_age : Span? = nil
  @connections = [] of Connection
  @reserved = [] of Connection
  @opening_connections : Int32 = 0
  @path : String
  @max_connections : Int32
  @busy_timeout_ms : Int32

  def initialize(connection : Connection, @path : String, @max_connections : Int32 = 1, @busy_timeout_ms : Int32 = 5000)
    @connections << connection
  end

  def stats : PoolStats
    count = 0
    @connections.each { |connection| count += 1 unless connection.closed? }
    PoolStats.new(@max_connections, count, count - @reserved.size)
  end

  def checkout : Connection | ErrorBase
    @connections.each do |connection|
      connection.statement_cache_limit = @statement_limit
      connection.prepared_statements = @prepared_statements
    end
    # A connection whose server dropped it is closed; the pool forgets it.
    @connections = @connections.reject { |connection| connection.lost && !@reserved.includes?(connection) }
    @connections.each do |connection|
      return connection unless @reserved.includes?(connection)
    end
    if @connections.size + @opening_connections >= @max_connections
      cause = PoolTimeout.new("Connection pool exhausted")
      return ConnectionTimeoutError.new(cause.message, cause)
    end
    @opening_connections += 1
    defer (@opening_connections -= 1)
    connection = open_connection(@path, @busy_timeout_ms)!
    connection.statement_cache_limit = @statement_limit
    connection.prepared_statements = @prepared_statements
    @connections << connection
    connection
  end

  def reserve(connection : Connection) : Nil
    @reserved << connection unless @reserved.includes?(connection)
    nil
  end

  def release(connection : Connection) : Nil
    @reserved.delete(connection)
    age = @max_age
    retire(connection) if age && ticks - connection.grant_created_ticks >= age.total_milliseconds
    nil
  end

  private def retire(connection : Connection) : Bool
    return false if connection.close.is_a?(::Error)
    @connections.delete(connection)
    true
  end

  def close_idle_connections(keep : Int32 = 0) : Int32
    closed = 0
    @connections.dup.each do |connection|
      next if @reserved.includes?(connection) || @connections.size <= keep
      closed += 1 if retire(connection)
    end
    closed
  end

  def close_aged_connections : Int32
    age = @max_age
    return 0 unless age
    closed = 0
    now = ticks
    @connections.dup.each do |connection|
      next if @reserved.includes?(connection)
      if now - connection.grant_created_ticks >= age.total_milliseconds
        closed += 1 if retire(connection)
      end
    end
    closed
  end

  def keepalive_idle_connections : Int32
    checked = 0
    @connections.dup.each do |connection|
      next if @reserved.includes?(connection)
      reserve(connection)
      result = connection.scalar("SELECT 1")
      release(connection)
      if result.is_a?(::Error)
        retire(connection)
      else
        checked += 1
      end
    end
    checked
  end

  def discard(connection : Connection, path : String) : Nil | DatabaseError
    connection.close!
    @connections.delete(connection)
    @reserved.delete(connection)
    replacement = open_connection(path, @busy_timeout_ms)!
    replacement.query_observer = connection.query_observer
    @connections << replacement
    nil
  end

  def close : Nil | DatabaseError
    @connections.each { |connection| connection.close! }
    nil
  end
end

pub class Database
  def prepared_statements? : Bool
    @pool.prepared_statements
  end

  def prepared_statements_cache? : Bool
    @pool.statement_limit != 0
  end
  getter pool : Pool

  def initialize(connection : Connection, path : String, pool_size : Int32 = 1, busy_timeout_ms : Int32 = 5000)
    @pool = Pool.new(connection, path, pool_size, busy_timeout_ms)
  end

  def self.open(path : String, pool_size : Int32 = 1, busy_timeout_ms : Int32 = 5000) : Database | DatabaseError
    connection = open_connection(path, busy_timeout_ms)!
    new(connection, path, pool_size, busy_timeout_ms)
  end

  def checkout : Connection | ErrorBase
    @pool.checkout
  end

  def using_connection(&block : Connection -> T) : T | ErrorBase forall T
    connection = checkout!
    @pool.reserve(connection)
    result = yield connection
    @pool.release(connection)
    result
  end

  def close : Nil | DatabaseError
    @pool.close
  end
end
