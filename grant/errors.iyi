module grant/errors

import std/indexable

# Crystal Grant raises these; native iyi returns them as union members.

pub import grant/error
pub alias ErrorBase = ::Grant::Error::ErrorBase
pub import grant/error_taxonomy
import grant/error_taxonomy::{StatementInvalid}

# Compatibility name used by the initial SQLite binding.
pub alias DatabaseError = StatementInvalid

pub struct RecordNotFound
  getter model : String
  getter id : String

  def initialize(@model : String, @id : String)
  end
end

impl ::Error for RecordNotFound
  def message : String
    "Couldn't find #{@model} with id=#{@id}"
  end
end

pub class RecordNotSaved < ErrorBase
  getter model : String
  getter cause : StatementInvalid?

  def initialize(@model : String, @cause : StatementInvalid? = nil)
    super("#{@model} was not saved")
  end

  def statement_error : StatementInvalid?
    @cause
  end
end

impl ::Error for RecordNotSaved
  def message : String
    @message
  end
end

# Grant::Transaction::Rollback: returned from a transaction block to roll back silently.
pub struct Rollback
  def initialize
  end
end

impl ::Error for Rollback
  def message : String
    "rollback"
  end
end

pub class TransactionIsolationError < ErrorBase
  def initialize(message : String = "Cannot set the isolation level of a nested transaction; it is fixed by the outermost transaction")
    super(message)
  end
end

impl ::Error for TransactionIsolationError
  def message : String
    @message
  end
end


pub class NotOpenError < ErrorBase
  def initialize(message : String = "No open transaction")
    super(message)
  end
end

impl ::Error for NotOpenError
  def message : String
    @message
  end
end

pub class InvalidSavepointNameError < ErrorBase
end

impl ::Error for InvalidSavepointNameError
  def message : String
    @message
  end
end

# Structural slice of Grant::Errors used by persistence validations.
pub class Errors
  @errors = [] of ::Grant::Error::Error

  def <<(error : ::Grant::Error::Error) : self
    @errors << error
    self
  end

  def map(&block : ::Grant::Error::Error -> T) : Array(T) forall T
    @errors.map { |error| yield error }
  end

  def first : ::Grant::Error::Error
    @errors.first
  end

  def first? : ::Grant::Error::Error?
    @errors.first?
  end

  def empty? : Bool
    @errors.empty?
  end

  def size : Int32
    @errors.size
  end

  def full_messages : Array(String)
    @errors.map { |error| error.message }
  end

  def conversion_errors? : Bool
    @errors.any? { |error| error.is_a?(::Grant::Error::ConversionError) }
  end

  def clear_validations : Nil
    @errors = @errors.select { |error| error.is_a?(::Grant::Error::ConversionError) }
    nil
  end

  def clear_conversion_error(field : String | Symbol) : Nil
    @errors = @errors.reject { |error| error.is_a?(::Grant::Error::ConversionError) && error.field == field }
    nil
  end

  def clear : Nil
    @errors.clear
    nil
  end
end

# Shared record interface avoids an errors -> Base -> adapter import cycle.
pub trait ValidationRecord
  abstract def errors : Errors
  abstract def __table_name : String
end

# Validation-specific persistence failure retains the rejected model.
pub class RecordInvalid < RecordNotSaved
  getter record : ValidationRecord

  def initialize(@record : ValidationRecord)
    super(@record.__table_name)
    messages = @record.errors.full_messages
    @message = messages.empty? ? "Validation failed" : "Validation failed: #{messages.join(", ")}"
  end
end

impl ::Error for RecordInvalid
  def message : String
    @message
  end
end


pub class RecordNotDestroyed < ErrorBase
  getter model : ValidationRecord

  def initialize(class_name : String, @model : ValidationRecord)
    reason = @model.errors.first?
    super("Could not destroy #{class_name}: #{reason.nil? ? "the destroy was halted" : reason.message}")
  end
end

impl ::Error for RecordNotDestroyed
  def message : String
    @message
  end
end
