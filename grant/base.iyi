    def self.migrator : ::Grant::Migrator::Migrator
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      migrator = ::Grant::Migrator::Migrator.new(__connection, table_name, [
        \{% for v in columns %}
          \{% ann = v.annotation(::Grant::Base::Column) %}
          \{% key = v.type.union_types.find { |type| type != Nil } %}
          \{% if key < ::Enum %}
            \{% converter = ann[:converter] %}
            \{% storage_type = converter.is_a?(Generic) && converter.type_vars.size == 2 ? converter.type_vars.last.resolve.stringify : "String" %}
            \{% storage_type = storage_type + "?" if ann[:type].includes?("?") || ann[:type].includes?("Nil") %}
          \{% else %}
            \{% storage_type = ann[:type] %}
          \{% end %}
          ::Grant::Migrator::MigratorColumn.new(\{{ v.name.stringify }}, \{{ storage_type }}, \{{ ann[:column_type] }}, \{{ ann[:primary] ? true : false }}, \{{ ann[:auto] ? true : false }}, literal_default: \{% if ann[:has_literal_default] %} ::Grant::Migrator.default_clause_for(\{{ ann[:literal_default] }}) \{% else %} "" \{% end %}, limit: \{{ ann[:limit] }}, precision: \{{ ann[:precision] }}, scale: \{{ ann[:scale] }}, null: \{{ ann[:null] }}, collation: \{{ ann[:collation] }}, comment: \{{ ann[:comment] }}, default_sql: \{{ ann[:default_sql] }}),
        \{% end %}
      ] of ::Grant::Migrator::MigratorColumn)
      migrator.schema_adapter = self.adapter
      \{% for method in @type.class.methods.select(&.name.starts_with?("__grant_index_")) %}
        migrator.index_definitions << ->(table : String) { self.\{{method.name.id}}(table) }
      \{% end %}
      migrator
      \{% end %}
    end

    def self.clear : Nil | ::Grant::Errors::DatabaseError
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      %result = current_scope.delete_all
      return %result if %result.is_a?(::Grant::Errors::DatabaseError)
      return ::Grant::Errors::DatabaseError.new(%result.message) if %result.is_a?(::Grant::Error::ErrorBase)
      nil
      \{% end %}
