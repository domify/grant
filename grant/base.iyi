    def self.current_scope : ::Grant::Query::Builder::Builder({{ @type }})
      scoped = ::Grant::Scoping.current_relation(self)
      return scoped unless scoped.nil?
      query = ::Grant::Query::Builder::Builder({{ @type }}).new(::Grant::Query::Builder::Builder({{ @type }}).db_type_for(adapter))
      query = apply_sti_scope(query)
      !_unscoped? && _has_default_scope? ? apply_default_scope(query).promote_where_to_default_scope : query
    end

    def self.scoping(relation : ::Grant::Query::Builder::Builder({{ @type }}), &block : -> T) : T forall T
