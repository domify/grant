    end

    def self.unscoped(&block : ::Grant::Query::Builder::Builder({{ @type }}) -> T) : T forall T
      old_unscoped = _unscoped?
      self._unscoped = true
      result = ::Grant::Scoping.without_relation(self.to_s) { yield ::Grant::Query::Builder::Builder({{ @type }}).new(::Grant::Query::Builder::Builder({{ @type }}).db_type_for(adapter)) }
      self._unscoped = old_unscoped
      result
    end

