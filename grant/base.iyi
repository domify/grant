# Snapshot taken when a record first takes part in a transaction.
pub struct TransactionState
  getter new_record : Bool
  getter destroyed : Bool

  def initialize(@new_record : Bool, @destroyed : Bool)
  end
end

pub abstract class Base
  getter extra_attributes = {} of String => ::Grant::Adapter::Driver::Value

  def extra_attribute(name : String) : ::Grant::Adapter::Driver::Value
    extra_attributes[name]?
  end

  def self.connected_to(database : String? = nil, role : Symbol? = nil,
                        shard : Symbol? = nil, prevent_writes : Bool = false,
                        &block : -> T) : T forall T
    ::Grant::ConnectionContext.connected_to(database, role, shard, prevent_writes) { yield }
  end

  @new_record : Bool = true
  @destroyed : Bool = false
  @_current_callback : String? = nil
  @errors = ::Grant::Errors::Errors.new

  def errors : ::Grant::Errors::Errors
    @errors.base = self
    @errors
  end

  @readonly : Bool = false

  def readonly? : Bool
    @readonly
  end

  def readonly_in_place : Nil
    mark_readonly
  end

  def mark_readonly(value : Bool = true) : Nil
    @readonly = value
    nil
  end

  def ==(other : Base) : Bool
    return true if object_id == other.object_id
    key = __primary_value
    !key.nil? && self.class.to_s == other.class.to_s && key == other.__primary_value
  end

  # Equal persisted records must occupy the same Hash and Set bucket.
  # Native iyi hashes return Int32 rather than taking Crystal's hasher.
  def hash : Int32
    key = __primary_value
    key.nil? ? object_id.hash : {self.class.to_s, key}.hash
  end

  def initialize(**args)
    assign_attributes(args)
    establish_initial_dirty_baseline
    self.after_initialize.or_panic
  end

  def initialize(**args, &block : self -> T) forall T
    assign_attributes(args)
    establish_initial_dirty_baseline
    yield self
    self.after_initialize.or_panic
  end

  def initialize(attributes : Hash(K, V), &block : self -> T) forall K, V, T
    assign_attributes(attributes)
    establish_initial_dirty_baseline
    yield self
    self.after_initialize.or_panic
  end

  macro inherited
    ::Grant::PolymorphicTypes.register_polymorphic_type({{ @type.stringify }}, {{ @type }})
    ::Grant::ValidationHelpers::Uniqueness.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Length.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Inequality.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Choice.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Exclusion.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Nil.model_methods({{ @type }})
    ::Grant::ValidationHelpers::Blank.model_methods({{ @type }})
    ::Grant::Validators.model_methods({{ @type }})
    @@table_name : String = {{ @type.name.split("::").last.underscore }}
    @@connection_name : String = "sqlite"
    @@own_default_database_name : String? = nil
    @@abstract_class : Bool = false
    @@implicit_order_columns : Array(String) = [] of String
    @@own_connection_config : Hash(Symbol, String)? = nil
    @@own_shard_config : Hash(Symbol, Hash(Symbol, String))? = nil

    macro finished
      \{% if @type.abstract? %}
        ::Grant::ConnectionPooling.model_methods(\{{ @type }})
        ::Grant::ConnectionHandling.model_methods(\{{ @type }})
        ::Grant::ConnectionManagement.model_methods(\{{ @type }})
        ::Grant::DatabaseConfigurations.model_methods(\{{ @type }})
        ::Grant::ReplicaLoadBalancer.model_methods(\{{ @type }})
      \{% else %}
        __process_columns
      \{% end %}
    end
  end

  def self._has_default_scope? : Bool
    false
  end

  # Defaults for `Base` and abstract classes; models with columns override them.
  def self.attribute_aliases : Hash(String, String)
    {} of String => String
  end

  def self.record_timestamps? : Bool
    true
  end

  def self.apply_default_scope(query : ::Grant::Query::Builder::Builder(Model)) forall Model
    query
  end

  macro scope(name, body)
    ::Grant::Scoping.scope({{ name }}, {{ body }})
  end

  macro default_scope(&block)
    def self._has_default_scope? : Bool
      true
    end

    def self.apply_default_scope(query : ::Grant::Query::Builder::Builder(Model)) forall Model
      query.{{block.body}}
    end
  end

  macro attr_readonly(*fields, **options)
    ::Grant::Readonly.attr_readonly({{ fields.splat }}, {{ options.double_splat }})
  end

  macro normalizes(*attributes, **options, &block)
    ::Grant::Normalization.normalizes({{ attributes.splat }}, {{ options.double_splat }}) {{ block }}
  end

  macro to_param(attribute)
    ::Grant::Integration.to_param({{ attribute }})
  end

  macro enum_attribute(decl, **options)
    ::Grant::EnumAttributes.enum_attribute({{ @type }}, {{ decl }}, {{ options.double_splat }})
  end

  macro enum_attributes(**mappings)
    ::Grant::EnumAttributes.enum_attributes({{ @type }}, {{ mappings.double_splat }})
  end

  macro alias_attribute(new_name, old_name)
    ::Grant::Attributes.alias_helpers({{ new_name }}, {{ old_name }})
    @[::Grant::Attributes::AttributeAlias(name: {{ new_name.id.stringify }}, column: {{ old_name.id.stringify }})]
    def {{ new_name.id }}
      {{ old_name.id }}
    end

    def {{ new_name.id }}=(value)
      self.{{ old_name.id }} = value
    end
  end

  def assignable_attribute?(name : String | Symbol) : Bool
    return true if self.class.attribute_aliases.has_key?(name.to_s)
    return true if name.to_s == __primary_name
    return true if __column_names.includes?(name.to_s)
    {% for method in @type.methods %}
      {% if ann = method.annotation(::Grant::Attributes::AttributeAlias) %}
        return true if name.to_s == {{ ann[:name] }}
      {% end %}
    {% end %}
    {% for attribute in @type.instance_vars.select { |v| v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      return true if name.to_s == {{ attribute.name.stringify }}
    {% end %}
    false
  end

  def attributes=(args : Hash(K, V)) forall K, V
    assign_attributes(args)
  end

  macro implicit_order_column(*columns)
    @@implicit_order_columns = [{% for column in columns %}{{ column.id.stringify }}, {% end %}] of String
  end

  def self.custom_select_statement : String?
    nil
  end

  macro select_statement(text)
    ::Grant::Select.select_statement({{ text }})
