# Snapshot taken when a record first takes part in a transaction.
pub struct TransactionState
  getter new_record : Bool
  getter destroyed : Bool

  def initialize(@new_record : Bool, @destroyed : Bool)
  end
end

pub class Migrator
  getter table : String
  getter columns : Array(String)
  getter connection : Connection

  def initialize(@connection : Connection, @table : String, @columns : Array(String))
  end

  def drop_and_create : Nil | DatabaseError
    @connection.execute("DROP TABLE IF EXISTS #{::Grant::Base.quote_identifier(@table)}")!
    @connection.execute("CREATE TABLE #{::Grant::Base.quote_identifier(@table)} (#{@columns.join(", ")})")!
    nil
  end
end

pub abstract class Base
  @new_record : Bool = true
  @destroyed : Bool = false
  @_current_callback : String? = nil
  getter errors = ::Grant::Errors::Errors.new

  def initialize(**args)
    assign_attributes(args)
    establish_initial_dirty_baseline
    self.after_initialize.or_panic
  end

  def initialize(**args, &block : self -> T) forall T
    assign_attributes(args)
    establish_initial_dirty_baseline
    yield self
    self.after_initialize.or_panic
  end

  def initialize(attributes : Hash(K, V), &block : self -> T) forall K, V, T
    assign_attributes(attributes)
    establish_initial_dirty_baseline
    yield self
    self.after_initialize.or_panic
  end

  macro inherited
    @@table_name : String = {{ @type.name.split("::").last.underscore.stringify }} + "s"
    @@connection_name : String = "sqlite"

    macro finished
      __process_columns
    end
  end

  macro table(name)
    @@table_name = {{ name.is_a?(StringLiteral) ? name : name.id.stringify }}
  end

  macro connection(name)
    @@connection_name = {{ name.id.stringify }}
  end

  macro connects_to(database)
    @[::Grant::ConnectionManagement::ConnectsTo(database: {{ database }})]
    def __connection_declaration
      nil
