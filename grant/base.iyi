    ::Grant::SerializedColumn.serialized_column({{ name }}, {{ klass }}, {{ format }})
  end

  macro store_accessor(store, *keys, **options)
    ::Grant::StoreAccessor.store_accessor({{ store }}, {% for key in keys %}{{ key }}, {% end %}{% for key, value in options %}{{ key.id }}: {{ value }}, {% end %})
  end

  def _mark_serialized_column_changed(attribute_name : String) : Nil
    nil
  end

  macro attribute(decl, **options)
