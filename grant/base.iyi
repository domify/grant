    def __callback_before_save_{{ @type.methods.size }} : Nil | ::Grant::Callbacks::Abort
      {% if block %}
        {{ block.body }}
      {% else %}
        %result = {{ method.id }}
        return %result if %result.is_a?(::Grant::Callbacks::Abort)
