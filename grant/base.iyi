  macro validate(field, message = nil, &block)
    def __validate_{{ @type.methods.size }} : Nil
      {% if block %}
        {{ block.args[0] }} = self
        unless begin
          {{ block.body }}
        end
          {% if message %}
            errors << ::Grant::Error::Error.new({{ field }}, {{ message }})
          {% else %}
            errors << ::Grant::Error::Error.new(:base, {{ field }})
          {% end %}
        end
      {% else %}
        {{ field.id }}
      {% end %}
      nil
