    end
  end

  macro after_validation(method = nil, &block)
    def __callback_after_validation_{{ @type.methods.size }} : Nil | ::Grant::Callbacks::Abort
      {% if block %}
        {{ block.body }}
      {% else %}
        %result = {{ method.id }}
        return %result if %result.is_a?(::Grant::Callbacks::Abort)
      {% end %}
