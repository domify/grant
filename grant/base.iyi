  macro table(name)
    @@table_name = {{ name.is_a?(StringLiteral) ? name : name.id.stringify }}
  end

  macro connection(name)
    @@connection_name = {{ name.id.stringify }}
    @@own_default_database_name = {{ name.id.stringify }}
  end

  macro abstract_class
    @@abstract_class = true
  end

  macro primary_abstract_class
    @@abstract_class = true
    ::Grant::ConnectionHandling::ConnectionHandling.primary_abstract_class_name = {{ @type.stringify }}
  end

  macro configure_connection(**options)
    {% if strategy = options[:load_balancing_strategy] %}
      @[::Grant::ReplicaLoadBalancer::StrategyConfig]
      def __replica_strategy_marker : Nil
        nil
      end
      def self.__configured_replica_strategy : ::Grant::ReplicaLoadBalancer::LoadBalancingStrategy
        {{ strategy }}
      end
    {% end %}
  end

  macro connects_to(database = nil, config = nil, shards = nil)
    {% config = database if !config && database.is_a?(NamedTupleLiteral) %}
    @[::Grant::ConnectionManagement::ConnectsTo(database: {{ database || "primary" }}, config: {{ config }}, shards: {{ shards }})]
    def __connection_declaration
      nil
    end
    ::Grant::ConnectionHandling::ConnectionHandling.declare({{ @type.stringify }},
      -> { self.connection_names })
    {% if database && database.is_a?(NamedTupleLiteral) %}
      @@connection_name = {{ database[:writing] || database.values.first }}
      @@own_default_database_name = @@connection_name
    {% end %}
    {% if database && !database.is_a?(NamedTupleLiteral) %}
      @@connection_name = {{ database }}.to_s
      @@own_default_database_name = @@connection_name
    {% end %}
    {% if config %}
      @@own_connection_config = {
        {% for role, name in config %}
          {{ role.symbolize }} => {{ name }},
        {% end %}
      } of Symbol => String
      @@replica_strategy_registered : Bool = self.__register_replica_strategy
      def self.connection_config : Hash(Symbol, String)
        @@own_connection_config ||= {
          {% for role, name in config %}
            {{ role.symbolize }} => {{ name }},
          {% end %}
        } of Symbol => String
      end
    {% end %}
    @@own_shard_config = {} of Symbol => Hash(Symbol, String)
    {% if shards %}
      @@own_shard_config = {
        {% for shard, roles in shards %}
          {{ shard.symbolize }} => {
            {% for role, name in roles %}
              {{ role.symbolize }} => {{ name }},
            {% end %}
          } of Symbol => String,
        {% end %}
      } of Symbol => Hash(Symbol, String)
      def self.shard_config : Hash(Symbol, Hash(Symbol, String))
        {
          {% for shard, roles in shards %}
            {{ shard.symbolize }} => {
              {% for role, name in roles %}
                {{ role.symbolize }} => {{ name }},
              {% end %}
            } of Symbol => String,
          {% end %}
        } of Symbol => Hash(Symbol, String)
      end
    {% end %}
  end

