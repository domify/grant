  macro column(decl, **options)
    @[::Grant::Base::Column(primary: {{ options[:primary] || false }}, type: {{ decl.type.stringify }}, auto: {{ options[:auto] == nil ? decl.type.stringify.includes?("Int") : options[:auto] }})]
    @{{decl.var}} : {{decl.type}} | Nil = {{ decl.value || nil }}
    @__persisted_{{decl.var}} : {{decl.type}} | Nil = nil

    {% if decl.value %}
      def {{decl.var}} : {{decl.type}}
        @{{decl.var}}.as({{decl.type}})
      end
    {% else %}
      def {{decl.var}} : {{decl.type}} | Nil
        @{{decl.var}}
      end
    {% end %}

    def {{decl.var}}_changed? : Bool
      @{{decl.var}} != @__persisted_{{decl.var}}
    end

    def {{decl.var}}=(value : {{decl.type}} | Nil) : Nil
      errors.clear_conversion_error({{ decl.var.symbolize }})
      @{{decl.var}} = value
    end
  end

