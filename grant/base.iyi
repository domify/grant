    def after_validation : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_validation"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_validation_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_save : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "before_save"
      \{% begin %}
      \{% callbacks = @type.methods.select { |m| m.name.starts_with?("__callback_before_save_") } %}
      \{% prepended = callbacks.select { |m| m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:prepend] == true } %}
      \{% ordered = [] of ASTNode %}
      \{% for i in (0...prepended.size) %}
        \{% ordered << prepended[prepended.size - 1 - i] %}
      \{% end %}
      \{% for m in callbacks %}
        \{% unless m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:prepend] == true %}
          \{% ordered << m %}
        \{% end %}
      \{% end %}
      \{% callbacks = ordered %}
      \{% for m in callbacks %}
        \{{ m.name }}!
      \{% end %}
      nil
      \{% end %}
    end

    def after_save : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_save"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_save_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_create : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "before_create"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_create_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_create : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_create"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_create_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_update : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "before_update"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_update_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_update : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_update"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_update_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_destroy : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "before_destroy"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_destroy_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_destroy : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_destroy"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_destroy_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_touch : Nil | ::Grant::Callbacks::Abort
      @_current_callback = "after_touch"
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_touch_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def __transaction_adapter : ::Grant::Adapter::Driver::Connection | ::Grant::Adapter::Base::Base
      self.class.transaction_adapter
    end

    def __adapter : ::Grant::Adapter::Driver::Connection
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ @type }}.mark_write_operation
      original = \{{ @type }}.__transaction_connection
      ::Grant::Base::Base.current_transaction_connection(original) || original
      \{% end %}
    end

    def __table_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ @type }}.table_name
      \{% end %}
    end
  end

  def assign_attributes(**args)
    assign_attributes(args)
  end

  def assign_attributes(args : T) forall T
    {% for key in T.keys %}
      unless assignable_attribute?({{ key.stringify }})
        return ::Grant::Attributes::UnknownAttributeError.new(self.class.to_s, {{ key.stringify }})
      end
    {% end %}
    {% for key in T.keys %}
      {% if @type.has_method?((key.stringify + "=").id) %}
      {% original_key = key %}
      {% for owner in [@type] + @type.ancestors %}
      {% for method in owner.methods %}
        {% if ann = method.annotation(::Grant::Attributes::AttributeAlias) %}
          {% if ann[:name] == key.stringify %}
            {% key = ann[:column].id %}
          {% end %}
        {% end %}
      {% end %}
      {% end %}
      {% column = @type.instance_vars.find { |v| v.name.stringify == key.stringify && v.annotation(::Grant::Base::Column) } %}
      {% if column && column.annotation(::Grant::Base::Column)[:type].includes?("Int") %}
        value = args[{{ original_key.symbolize }}]
        if value.is_a?(String)
          converted = value.to_i64?
          if converted.nil?
            errors.clear_conversion_error({{ key.symbolize }})
            capture_before_type_cast({{ key.stringify }}, value)
            errors << ::Grant::Error::ConversionError.new({{ key.symbolize }}, "Expected {{ key.id }} to be {{ column.annotation(::Grant::Base::Column)[:type].id }}")
          else
            {% if column.annotation(::Grant::Base::Column)[:type].includes?("Int32") %}
              self.{{ key.id }} = converted.to_i32
            {% else %}
              self.{{ key.id }} = converted
            {% end %}
            capture_before_type_cast({{ key.stringify }}, value)
          end
        else
          self.{{ key.id }} = value
        end
      {% elsif column && column.annotation(::Grant::Base::Column)[:type].includes?("BigDecimal") %}
        value = args[{{ original_key.symbolize }}]
        self.{{ key.id }} = value.is_a?(String) ? ::Std::Big::BigDecimal.new(value) : value
      {% elsif column && column.annotation(::Grant::Base::Column)[:type].includes?("Bool") %}
        value = args[{{ original_key.symbolize }}]
        if value.is_a?(String)
          self.{{ key.id }} = value == "true" || value == "1"
          capture_before_type_cast({{ key.stringify }}, value)
        else
          self.{{ key.id }} = value
        end
      {% else %}
        {% if column && column.annotation(::Grant::Base::Column)[:guarded] %}
          result = (self.{{ key.id }} = args[{{ original_key.symbolize }}])
          if result.is_a?(::Grant::Encryption::Sealed::ArgumentError)
            errors.clear_conversion_error({{ key.symbolize }})
            errors << ::Grant::Error::ConversionError.new({{ key.symbolize }}, result.message)
          end
        {% else %}
          self.{{ key.id }} = args[{{ original_key.symbolize }}]
        {% end %}
      {% end %}
      {% end %}
    {% end %}
    self
  end

  def assign_attributes(args : Hash(K, V)) forall K, V
    args.each do |key, value|
      unless assignable_attribute?(key)
        return ::Grant::Attributes::UnknownAttributeError.new(self.class.to_s, key.to_s)
      end
    end
    {% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      args.each do |key, value|
        if self.class.resolve_attribute_alias(key.to_s) == {{ column.name.stringify }}
          {% type = column.annotation(::Grant::Base::Column)[:type] %}
          {% if column.annotation(::Grant::Base::Column)[:converter] && !column.annotation(::Grant::Base::Column)[:encrypted] %}
            from_db = self.class.__converter_from_db_{{ column.name }}(value)
            return from_db if from_db.is_a?(::Error)
            self.{{ column.name }} = from_db
          {% elsif type.includes?("Int32") %}
            converted = value.is_a?(String) ? value.to_i64? : (value.is_a?(Int) ? value.to_i64 : nil)
            if value.nil?
              self.{{ column.name }} = nil
            elsif converted.nil?
              errors.clear_conversion_error({{ column.name.symbolize }})
              capture_before_type_cast({{ column.name.stringify }}, value) if value.is_a?(String)
              errors << ::Grant::Error::ConversionError.new({{ column.name.symbolize }}, "Expected integer")
            else
              self.{{ column.name }} = converted.to_i32
              capture_before_type_cast({{ column.name.stringify }}, value) if value.is_a?(String)
            end
          {% elsif type.includes?("Int64") %}
            converted = value.is_a?(String) ? value.to_i64? : (value.is_a?(Int) ? value.to_i64 : nil)
            if value.nil?
              self.{{ column.name }} = nil
            elsif converted.nil?
              errors.clear_conversion_error({{ column.name.symbolize }})
              capture_before_type_cast({{ column.name.stringify }}, value) if value.is_a?(String)
              errors << ::Grant::Error::ConversionError.new({{ column.name.symbolize }}, "Expected integer")
            else
              self.{{ column.name }} = converted
              capture_before_type_cast({{ column.name.stringify }}, value) if value.is_a?(String)
            end
          {% elsif type.includes?("BigDecimal") %}
            self.{{ column.name }} = value.nil? ? nil : ::Std::Big::BigDecimal.new(value.to_s)
          {% elsif type.includes?("Bool") %}
            self.{{ column.name }} = value.is_a?(Bool) ? value : (value.is_a?(String) ? (value == "true" || value == "1") : nil)
            capture_before_type_cast({{ column.name.stringify }}, value) if value.is_a?(String)
          {% else %}
            {% if column.annotation(::Grant::Base::Column)[:guarded] %}
              result = (self.{{ column.name }} = value.as?({{ column.type }}))
              if result.is_a?(::Grant::Encryption::Sealed::ArgumentError)
                errors.clear_conversion_error({{ column.name.symbolize }})
                errors << ::Grant::Error::ConversionError.new({{ column.name.symbolize }}, result.message)
              end
            {% else %}
              self.{{ column.name }} = value.as?({{ column.type }})
            {% end %}
          {% end %}
        end
      end
    {% end %}
    self
  end

  abstract def __primary_name : String
  abstract def __primary_value : ::Grant::Adapter::Driver::Value
  abstract def __generate_primary_uuid : Nil
  abstract def __primary_auto? : Bool
  abstract def __set_primary_value(value : Int64) : Nil
  abstract def __column_names : Array(String)
  abstract def __changed_column_names : Array(String)
  abstract def __column_values : Array(Value) | ::Grant::Error::ErrorBase
  abstract def __run_commit_callbacks(operation : Symbol) : Nil | ::Grant::Error::ErrorBase
  abstract def __run_rollback_callbacks(operation : Symbol) : Nil
  abstract def __transaction_adapter : Connection | ::Grant::Adapter::Base::Base
  abstract def __adapter : Connection
  abstract def __table_name : String

  def self.run_transaction(adapter : Connection | ::Grant::Adapter::Base::Base, options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase forall T
    ::Grant::Transaction.run(adapter, options) { yield }
  end

  def self.current_transaction_connection(adapter : Connection) : Connection?
    ::Grant::Transaction.current_connection?(adapter)
  end

  def self.in_explicit_transaction? : Bool
    ::Grant::Transaction.in_explicit_transaction?
  end

  def transaction(options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase forall T
    Base.run_transaction(__transaction_adapter, options) { yield }
  end

  def __remember_record_flags : Nil
    return if ::Grant::Transaction::TransactionState.current_state_for_connection?(__adapter).nil?
    state = TransactionState.new(@new_record, @destroyed)
    ::Grant::Transaction.enlist_record_rollback_action(__adapter) { __restore_transaction_state(state) }
  end

  def __restore_transaction_state(state : TransactionState) : Nil
    @new_record = state.new_record
    @destroyed = state.destroyed
  end

  def __mark_persisted : Nil
    @new_record = false
    @destroyed = false
  end

  def new_record=(value : Bool) : Bool
    @new_record = value
  end

  def new_record? : Bool
    @new_record
  end

  def frozen? : Bool
    destroyed?
  end

  protected def guard_not_destroyed_strict(action : String) : Nil | ::Grant::Errors::RecordDestroyedError
    return ::Grant::Errors::RecordDestroyedError.new(self.class.to_s, action) if destroyed?
    nil
  end

  def destroyed? : Bool
    @destroyed
  end

  def persisted? : Bool
    !(@new_record || @destroyed)
  end

  def save(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool | ::Grant::Errors::RecordDestroyedError
    guard_not_destroyed_strict("save")!
    !save_strict(validate: validate, skip_timestamps: skip_timestamps).is_a?(::Error)
  end

  # Crystal `save!`.
  def save_strict(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase
    guard_not_destroyed_strict("save")!
    __guard_context_writes!
    result = __run_save_transaction(validate: validate, skip_timestamps: skip_timestamps)
    return result.cause if result.is_a?(::Grant::Callbacks::Failure)
    if result.is_a?(::Grant::Callbacks::Abort)
      errors << ::Grant::Error::Error.new(:base, result.message)
      return RecordNotSaved.new(self.class.to_s, self)
    end
    return false if result.nil?
    result
  end

  def valid? : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    errors.clear_validations
    __run_around_validation { __validation_phase }
  end

  def __validation_phase : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    __association_defaults!
    self.before_validation!
    __association_validations!
    __run_validations!
    self.after_validation!
    errors.empty?
  end

  def abort_strict(message : String = "Aborted at #{@_current_callback}.") : ::Grant::Callbacks::Abort
    ::Grant::Callbacks::Abort.new(message)
  end

  def __save(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    return RecordNotSaved.new(__table_name) if @destroyed
    return RecordNotSaved.new(__table_name) if errors.conversion_errors?
    errors.clear
    return ::Grant::Errors::RecordInvalid.new(self) if validate && !valid?!
    __remember_transaction_state
    operation = @new_record ? :create : :update
    __association_before_save!
    self.before_save!
    saved = __persist_with_around(skip_timestamps: skip_timestamps)
    return saved if saved.is_a?(::Error)
    self.after_save!
    queue_commit_callbacks(operation)!
    true
  end

  def __persist(*, skip_timestamps : Bool) : Bool | RecordNotSaved | DatabaseError | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    operation = @new_record ? :create : :update
    if @new_record
      self.before_create!
    else
      self.before_update!
    end
    set_timestamps(mode: @new_record ? :create : :update) if !skip_timestamps && self.class.record_timestamps? && (@new_record || !__changed_column_names.empty?)
    names = __column_names
    values = __column_values!
    if @new_record
      __generate_primary_uuid
      if !__primary_auto? && __primary_value.nil?
        errors << ::Grant::Error::Error.new(__primary_name, "Primary key('#{__primary_name}') cannot be null")
        return RecordNotSaved.new(__table_name)
      end
      primary_value = __primary_value
      unless primary_value.nil?
        names << __primary_name
        values << primary_value
      end
      placeholders = names.map { "?" }.join(", ")
      result = __adapter.insert("INSERT INTO #{::Grant::Base.quote_identifier(__table_name)} (#{names.map { |name| ::Grant::Base.quote_identifier(name) }.join(", ")}) VALUES (#{placeholders})", values, __primary_auto? && __primary_value.nil? ? __primary_name : nil)
      if result.is_a?(DatabaseError)
        return ::Grant::ErrorTaxonomy::ReadOnlyError.new(result.message, result) if result.read_only
        return ::Grant::ErrorTaxonomy::ConnectionFailed.new("Connection was lost: #{result.message}", ::Grant::Database::ConnectionLost.new(__adapter)) if result.connection_lost
        errors << ::Grant::Error::Error.new(:base, result.message)
        return RecordNotSaved.new(__table_name, result)
      end
      __set_primary_value(result.last_insert_id) if __primary_auto? && __primary_value.nil?
    else
      changed = __changed_column_names
      changed_values = [] of Value
      names.each_with_index do |name, index|
        changed_values << values[index] if changed.includes?(name)
      end
      unless changed.empty?
        assignments = changed.map { |name| "#{::Grant::Base.quote_identifier(name)} = ?" }.join(", ")
        changed_values << __primary_value
        result = __adapter.execute("UPDATE #{::Grant::Base.quote_identifier(__table_name)} SET #{assignments} WHERE #{::Grant::Base.quote_identifier(__primary_name)} = ?", changed_values)
        if result.is_a?(DatabaseError)
          return ::Grant::ErrorTaxonomy::ReadOnlyError.new(result.message, result) if result.read_only
          return ::Grant::ErrorTaxonomy::ConnectionFailed.new("Connection was lost: #{result.message}", ::Grant::Database::ConnectionLost.new(__adapter)) if result.connection_lost
          errors << ::Grant::Error::Error.new(:base, result.message)
          return RecordNotSaved.new(__table_name, result)
        end
      end
    end
    __capture_saved_changes
    __mark_persisted
    if operation == :create
      self.after_create!
    else
      self.after_update!
    end
    true
  end

  def queue_commit_callbacks(operation : Symbol) : Nil | ::Grant::Error::ErrorBase
    ::Grant::Transaction.queue_record_callbacks(__adapter, object_id, operation, ->(op : Symbol) { __run_commit_callbacks(op) }, ->(op : Symbol) { __run_rollback_callbacks(op) })
  end

  # Deletes the row without callbacks.
  def delete : self
    __remember_transaction_state
    if id = __primary_value
      __adapter.execute("DELETE FROM #{::Grant::Base.quote_identifier(__table_name)} WHERE #{::Grant::Base.quote_identifier(__primary_name)} = ?", [id] of Value)
    end
    @destroyed = true
    self
  end

  def destroy : Bool | ::Grant::Errors::RecordDestroyedError
    guard_not_destroyed_strict("destroy")!
    result = __destroy_with_around
    if result.is_a?(::Error)
      errors << ::Grant::Error::Error.new(:base, result.message)
      __run_rollback_callbacks(:destroy)
      return false
    end
    true
  end

  def __destroy_with_callbacks : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    self.before_destroy!
    delete
    self.after_destroy!
    self.__destroy_dependents!
    queue_commit_callbacks(:destroy)!
    true
  end

  # Crystal `destroy!`.
  def destroy_strict : Bool | ::Grant::Errors::RecordNotDestroyed | ::Grant::Errors::RecordDestroyedError
    return true if destroy!
    ::Grant::Errors::RecordNotDestroyed.new(self.class.to_s, self)
  end
end

impl SelectExtras for Base
end

pub def sqlite_value(value : Array(T)) : Value forall T
  values = [] of Value
  value.each { |item| values << sqlite_value(item) }
  values
end

pub def sqlite_value(value : Value) : Value
  ::Db::Value.to_db_value(value)
end

pub def sqlite_value(value : Int32) : Value
  value.to_i64
end

pub def sqlite_value(value : Float32) : Value
  value.to_f64
end

pub def sqlite_value(value : ::Std::Time::Time) : Value
  value.to_rfc3339(9)
end

# SQLite's identifier quoting applies to table and column names alike.
pub def quote_identifier(name : String) : String
  "\"#{name.gsub("\"", "\"\"")}\""
end

impl ::Grant::Errors::ValidationRecord for Base
  def errors : ::Grant::Errors::Errors
    @errors.base = self
    @errors
  end

  def __table_name : String
    self.__table_name
  end
end

# Driver values retain UUIDs and PostgreSQL arrays as their native text form.
pub def sqlite_value(value : UUID) : Value
  value.to_s
end

pub def sqlite_value(value : Array(T)) : Value forall T
  "{" + value.map { |item| postgres_array_item(item) }.join(",") + "}"
end

pub def postgres_array_item(value : T) : String forall T
  case value
  when Nil then "NULL"
  when Bool then value ? "t" : "f"
  when String then "\"#{value.gsub("\\", "\\\\").gsub("\"", "\\\"")}\""
  else value.to_s
  end
end

impl ::Grant::Error::ErrorRecord for Base
  def __error_model_name : String
    self.class.to_s
  end
end

pub def sqlite_value(value : ::Std::Big::BigDecimal) : Value
  value.to_s
end
