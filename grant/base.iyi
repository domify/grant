    def __column_values : Array(::Grant::Adapter::Driver::Value) | ::Grant::Error::ErrorBase
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      values = [] of ::Grant::Adapter::Driver::Value
      \{% for v in columns %}
        \{% unless v == primary %}
          \{% if v.annotation(::Grant::Base::Column)[:lazy] %}
            %value = self.\{{ v.name }}!
          \{% else %}
            %value = self.\{{ v.name }}
          \{% end %}
          \{% if v.annotation(::Grant::Base::Column)[:converter] %}
            %converted = \{{ v.annotation(::Grant::Base::Column)[:converter] }}.to_db(%value)
            return %converted if %converted.is_a?(::Error)
            values << %converted
          \{% else %}
            values << ::Grant::Base.sqlite_value(%value)
          \{% end %}
        \{% end %}
      \{% end %}
      values
      \{% end %}
    end

