    def self.from_row(row : ::Grant::Adapter::Driver::Row) : {{ @type }} | ::Grant::Error::ErrorBase
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      %sti = __sti_rehome_row(row)
      return %sti unless %sti.nil?
      record = \{{ @type }}.allocate_record
      row.each { |name, value| record.extra_attributes[name] = value unless fields.includes?(name) }
      \{% for v in columns %}
        \{% type = v.annotation(::Grant::Base::Column)[:type] %}
        %raw = row[\{{ v.name.stringify }}]?
        \{% if v.annotation(::Grant::Base::Column)[:lazy] %}
          record.__load_\{{ v.name }}(%raw.is_a?(String) ? %raw : nil)
        \{% elsif type.includes?("BigDecimal") %}
          %converted = ::Grant::Converters::Decimal.from_db(%raw)
          return %converted if %converted.is_a?(::Error)
          record.__raw_\{{ v.name }} = %converted
        \{% elsif v.annotation(::Grant::Base::Column)[:converter] %}
          \{% key = v.type.union_types.find { |type| type != Nil } %}
          \{% if key < ::Enum %}
            %converted = \{{ v.annotation(::Grant::Base::Column)[:converter].id }}.from_db(%raw)
          \{% else %}
            %converted = \{{ v.annotation(::Grant::Base::Column)[:converter].id }}.from_db(%raw.is_a?(String) ? %raw : nil)
          \{% end %}
          return %converted if %converted.is_a?(::Error)
          record.__raw_\{{ v.name }} = %converted
        \{% elsif type.includes?("Array(String)") %}
          %array = %raw.is_a?(Array) ? ::Grant::ColumnsHelpers.string_array_from_db(%raw) : nil
          return %array if %array.is_a?(::Error)
          record.__raw_\{{ v.name }} = %array
        \{% elsif type.includes?("UUID") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(String) ? ::Std::Uuid::UUID.parse(%raw) : nil
        \{% elsif type.includes?("Int32") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(Int64) ? %raw.to_i32 : nil
        \{% elsif type.includes?("Int64") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(Int64) ? %raw : nil
        \{% elsif type.includes?("Bool") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(Bool) ? %raw : (%raw.is_a?(Int64) ? %raw != 0 : nil)
        \{% elsif type.includes?("Float32") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(Float64) ? %raw.to_f32 : nil
        \{% elsif type.includes?("Time") %}
          %parsed_time = %raw.is_a?(String) ? adapter.read_time(%raw) : nil
          return %parsed_time if %parsed_time.is_a?(::Error)
          record.__raw_\{{ v.name }} = %parsed_time
        \{% elsif type.includes?("Float") %}
          record.__raw_\{{ v.name }} = %raw.is_a?(Float64) ? %raw : nil
        \{% else %}
          record.__raw_\{{ v.name }} = %raw.is_a?(String) ? %raw : nil
        \{% end %}
      \{% end %}
      record.__mark_persisted
      record.after_find.or_panic
      record
      \{% end %}
    end

    def self.allocate_record : {{ @type }}
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      new
