  abstract def __primary_value : ::Grant::Adapter::Sqlite::Value
  abstract def __primary_auto? : Bool
  abstract def __set_primary_value(value : Int64) : Nil
  abstract def __column_names : Array(String)
  abstract def __changed_column_names : Array(String)
  abstract def __column_values : Array(Value)
  abstract def __run_commit_callbacks(operation : Symbol) : Nil | ::Grant::Error::ErrorBase
  abstract def __run_rollback_callbacks(operation : Symbol) : Nil
  abstract def __transaction_adapter : Connection | ::Grant::Adapter::Base::Base
  abstract def __adapter : Connection
  abstract def __table_name : String

  def self.run_transaction(adapter : Connection | ::Grant::Adapter::Base::Base, options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase forall T
    ::Grant::Transaction.run(adapter, options) { yield }
  end

  def self.current_transaction_connection(adapter : Connection) : Connection?
    ::Grant::Transaction.current_connection?(adapter)
  end

  def self.in_explicit_transaction? : Bool
    ::Grant::Transaction.in_explicit_transaction?
  end

  def transaction(options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase forall T
    Base.run_transaction(__transaction_adapter, options) { yield }
  end

  def __remember_record_flags : Nil
    return unless __adapter.in_transaction?
    state = TransactionState.new(@new_record, @destroyed)
    ::Grant::Transaction.enlist_record_rollback_action(__adapter) { __restore_transaction_state(state) }
  end

  def __restore_transaction_state(state : TransactionState) : Nil
    @new_record = state.new_record
    @destroyed = state.destroyed
  end

  def __mark_persisted : Nil
    @new_record = false
    @destroyed = false
  end

  def new_record=(value : Bool) : Bool
    @new_record = value
  end

  def new_record? : Bool
    @new_record
  end

  def destroyed? : Bool
    @destroyed
  end

  def persisted? : Bool
    !(@new_record || @destroyed)
  end

  def save(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool
    !save_strict(validate: validate, skip_timestamps: skip_timestamps).is_a?(::Error)
  end

  # Crystal `save!`.
  def save_strict(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | TransactionIsolationError | ::Grant::Error::ErrorBase
    result = __run_save_transaction(validate: validate, skip_timestamps: skip_timestamps)
    if result.is_a?(::Grant::Callbacks::Abort)
      errors << ::Grant::Error::Error.new(:base, result.message)
      return RecordNotSaved.new(__table_name)
    end
    return false if result.nil?
    result
  end

  def valid? : Bool | ::Grant::Callbacks::Abort
    errors.clear_validations
    self.before_validation!
    __run_validations
    self.after_validation!
    errors.empty?
  end

  def abort_strict(message : String = "Aborted at #{@_current_callback}.") : ::Grant::Callbacks::Abort
    ::Grant::Callbacks::Abort.new(message)
  end

  def __save(*, validate : Bool = true, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | ::Grant::Callbacks::Abort
    return RecordNotSaved.new(__table_name) if @destroyed
    return RecordNotSaved.new(__table_name) if errors.conversion_errors?
    errors.clear
    if @new_record && !__primary_auto? && __primary_value.nil?
      errors << ::Grant::Error::Error.new(__primary_name, "Primary key('#{__primary_name}') cannot be null")
      return RecordNotSaved.new(__table_name)
    end
    return ::Grant::Errors::RecordInvalid.new(self) if validate && !valid?!
    __remember_transaction_state
    operation = @new_record ? :create : :update
    self.before_save!
    if @new_record
      self.before_create!
    else
      self.before_update!
    end
    set_timestamps(mode: @new_record ? :create : :update) unless skip_timestamps
    names = __column_names
    values = __column_values
    if @new_record
      primary_value = __primary_value
      unless primary_value.nil?
        names << __primary_name
        values << primary_value
      end
      placeholders = names.map { "?" }.join(", ")
      result = __adapter.execute("INSERT INTO #{::Grant::Base.quote_identifier(__table_name)} (#{names.map { |name| ::Grant::Base.quote_identifier(name) }.join(", ")}) VALUES (#{placeholders})", values)
      if result.is_a?(DatabaseError)
        errors << ::Grant::Error::Error.new(:base, result.message)
        return RecordNotSaved.new(__table_name, result)
      end
      __set_primary_value(result.last_insert_id) if __primary_auto? && __primary_value.nil?
    else
      changed = __changed_column_names
      changed_values = [] of Value
      names.each_with_index do |name, index|
        changed_values << values[index] if changed.includes?(name)
      end
      unless changed.empty?
        assignments = changed.map { |name| "#{::Grant::Base.quote_identifier(name)} = ?" }.join(", ")
        changed_values << __primary_value
        result = __adapter.execute("UPDATE #{::Grant::Base.quote_identifier(__table_name)} SET #{assignments} WHERE #{::Grant::Base.quote_identifier(__primary_name)} = ?", changed_values)
        if result.is_a?(DatabaseError)
          errors << ::Grant::Error::Error.new(:base, result.message)
          return RecordNotSaved.new(__table_name, result)
        end
      end
    end
    __mark_persisted
    if operation == :create
      self.after_create!
    else
      self.after_update!
    end
    self.after_save!
    queue_commit_callbacks(operation)!
    true
  end

  def queue_commit_callbacks(operation : Symbol) : Nil | ::Grant::Error::ErrorBase
    ::Grant::Transaction.queue_record_callbacks(__adapter, object_id, operation, ->(op : Symbol) { __run_commit_callbacks(op) }, ->(op : Symbol) { __run_rollback_callbacks(op) })
  end

  # Deletes the row without callbacks.
  def delete : self
    __remember_transaction_state
    if id = __primary_value
      __adapter.execute("DELETE FROM #{::Grant::Base.quote_identifier(__table_name)} WHERE #{::Grant::Base.quote_identifier(__primary_name)} = ?", [id] of Value)
    end
    @destroyed = true
    self
  end

  def destroy : Bool
    result = __destroy_with_callbacks
    if result.is_a?(::Error)
      errors << ::Grant::Error::Error.new(:base, result.message)
      __run_rollback_callbacks(:destroy)
      return false
    end
    true
  end

  def __destroy_with_callbacks : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    self.before_destroy!
    delete
    self.after_destroy!
    queue_commit_callbacks(:destroy)!
    true
  end

  # Crystal `destroy!`.
  def destroy_strict : Bool | ::Grant::Errors::RecordNotDestroyed
    return true if destroy
    ::Grant::Errors::RecordNotDestroyed.new(self.class.to_s, self)
  end
end

pub def sqlite_value(value : Value) : Value
  value
end

pub def sqlite_value(value : Int32) : Value
  value.to_i64
end

pub def sqlite_value(value : Float32) : Value
  value.to_f64
end

pub def sqlite_value(value : ::Std::Time::Time) : Value
  value.to_rfc3339(9)
end

# SQLite's identifier quoting applies to table and column names alike.
pub def quote_identifier(name : String) : String
  "\"#{name.gsub("\"", "\"\"")}\""
end

impl ::Grant::Errors::ValidationRecord for Base
  def errors : ::Grant::Errors::Errors
    @errors
  end

  def __table_name : String
    self.__table_name
  end
end
