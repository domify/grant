  macro after_commit(method = nil, on = nil, &block)
    @[::Grant::Callbacks::Callback(event: :commit, on: {{ on }})]
    def __callback_commit_{{ @type.methods.size }} : Nil | ::Grant::Error::ErrorBase
      {% if block %}
        %result = begin
          {{ block.body }}
        end
        return %result if %result.is_a?(::Error)
      {% else %}
        %result = {{ method.id }}
        return %result if %result.is_a?(::Error)
      {% end %}
      nil
    end
  end

