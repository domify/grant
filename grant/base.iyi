  def assign_attributes(args : T) forall T
    {% for key in T.keys %}
      {% column = @type.instance_vars.find { |v| v.name.stringify == key.stringify && v.annotation(::Grant::Base::Column) } %}
      {% if column && column.annotation(::Grant::Base::Column)[:type].includes?("Int") %}
        value = args[{{ key.symbolize }}]
        if value.is_a?(String)
          converted = value.to_i64?
          if converted.nil?
            errors.clear_conversion_error({{ key.symbolize }})
            errors << ::Grant::Error::ConversionError.new({{ key.symbolize }}, "Expected {{ key.id }} to be {{ column.annotation(::Grant::Base::Column)[:type].id }}")
          else
            {% if column.annotation(::Grant::Base::Column)[:type].includes?("Int32") %}
              self.{{ key.id }} = converted.to_i32
            {% else %}
              self.{{ key.id }} = converted
            {% end %}
          end
        else
          self.{{ key.id }} = value
        end
      {% else %}
        self.{{ key.id }} = args[{{ key.symbolize }}]
      {% end %}
    {% end %}
  end

  def assign_attributes(args : Hash(K, V)) forall K, V
    {% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      args.each do |key, value|
        if key.to_s == {{ column.name.stringify }}
          {% type = column.annotation(::Grant::Base::Column)[:type] %}
          {% if type.includes?("Int32") %}
            self.{{ column.name }} = value.is_a?(Int) ? value.to_i32 : nil
          {% elsif type.includes?("Int64") %}
            self.{{ column.name }} = value.is_a?(Int) ? value.to_i64 : nil
          {% else %}
            self.{{ column.name }} = value.is_a?(String) ? value : nil
          {% end %}
        end
      end
    {% end %}
  end

