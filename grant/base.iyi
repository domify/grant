  macro __process_columns
    def __mark_persisted : Nil
      super
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        @__persisted_\{{ v.name }} = @\{{ v.name }}
      \{% end %}
      nil
    end

    def __remember_transaction_state : Nil
      return unless __adapter.in_transaction?
      __remember_record_flags
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        snapshot_\{{ v.name }} = new_record? ? @\{{ v.name }} : @__persisted_\{{ v.name }}
      \{% end %}
      ::Grant::Transaction.enlist_record_rollback_action(__adapter) do
        \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
          @\{{ v.name }} = snapshot_\{{ v.name }}
          @__persisted_\{{ v.name }} = snapshot_\{{ v.name }}
        \{% end %}
        nil
      end
    end

    def update(**args) : Bool
      assign_attributes(args)
      save
    end

    def update_strict(**args) : Bool | ::Grant::Errors::RecordNotSaved | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError
      assign_attributes(args)
      save_strict
    end

    def __run_commit_callbacks(operation : Symbol) : Nil
      \{% begin %}
      \{% for priority in [true, false] %}
      \{% for m in @type.methods.select { |m| m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:event] == :commit && (m.annotation(::Grant::Callbacks::Callback)[:priority] == true) == priority } %}
        \{% on = m.annotation(::Grant::Callbacks::Callback)[:on] %}
        \{% if on == nil %}
          \{{ m.name }}
        \{% elsif on.is_a?(ArrayLiteral) %}
          \{{ m.name }} if \{{ on }}.includes?(operation)
        \{% else %}
          \{{ m.name }} if operation == \{{ on }}
        \{% end %}
      \{% end %}
      \{% end %}
      nil
      \{% end %}
    end

    def __run_rollback_callbacks(operation : Symbol) : Nil
      \{% begin %}
      \{% for m in @type.methods.select { |m| m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:event] == :rollback } %}
        \{% on = m.annotation(::Grant::Callbacks::Callback)[:on] %}
        \{% if on == nil %}
          \{{ m.name }}
        \{% elsif on.is_a?(ArrayLiteral) %}
          \{{ m.name }} if \{{ on }}.includes?(operation)
        \{% else %}
          \{{ m.name }} if operation == \{{ on }}
        \{% end %}
      \{% end %}
      nil
      \{% end %}
    end




    def self.timestamp_precision : Int32?
      nil
    end

    def set_timestamps(*, to : ::Std::Time::Time = ::Grant::Timestamps.current_time, mode : Symbol = :create) : Nil
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:type].includes?("Time") } %}
        \{% if ["created_at", "created_on"].includes?(v.name.stringify) %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, to, self.class.timestamp_precision) if mode == :create
        \{% elsif ["updated_at", "updated_on"].includes?(v.name.stringify) %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, to, self.class.timestamp_precision)
        \{% end %}
      \{% end %}
      nil
    end

    def touch(*fields, time : ::Std::Time::Time = ::Grant::Timestamps.current_time) : Bool | ::Grant::Error::ErrorBase | ::Grant::Errors::DatabaseError | ::Grant::Callbacks::Abort
      \{% begin %}
      return ::Grant::Error::ErrorBase.new("Cannot touch on a new record object") unless persisted?
      __remember_transaction_state
      touch_fields = [] of String
      touch_values = [] of ::Grant::Adapter::Sqlite::Value
      \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      \{% for v in columns %}
        \{% if ["updated_at", "updated_on"].includes?(v.name.stringify) && v.annotation(::Grant::Base::Column)[:type].includes?("Time") %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, time, self.class.timestamp_precision)
          touch_fields << \{{ v.name.stringify }}
          touch_values << ::Grant::Base.sqlite_value(self.\{{ v.name }})
        \{% end %}
      \{% end %}
      fields.each do |field|
        case field.to_s
        \{% for v in columns.select { |v| v.annotation(::Grant::Base::Column)[:type].includes?("Time") } %}
        when \{{ v.name.stringify }}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, time, self.class.timestamp_precision)
          unless touch_fields.includes?(field.to_s)
            touch_fields << field.to_s
            touch_values << ::Grant::Base.sqlite_value(self.\{{ v.name }})
          end
        \{% end %}
        else
          if __column_names.includes?(field.to_s) || __primary_name == field.to_s
            return ::Grant::Error::ErrorBase.new("\{{ @type.name }}.#{field} cannot be touched.  It is not of type `Time`.")
          end
          return ::Grant::Error::ErrorBase.new("Field '#{field}' does not exist on type '\{{ @type.name }}'.")
        end
      end
      return ::Grant::Error::ErrorBase.new("No timestamp columns are available to touch") if touch_fields.empty?
      assignments = touch_fields.map { |field| "#{field} = ?" }.join(", ")
      touch_values << __primary_value
      __adapter.execute("UPDATE #{__table_name} SET #{assignments} WHERE #{__primary_name} = ?", touch_values)!
      self.after_touch!
      true
      \{% end %}
    end

    def self.table_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      @@table_name
      \{% end %}
    end

    def self.transaction_adapter : ::Grant::Adapter::Sqlite::Connection
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      ::Grant::Connections::Connections[@@connection_name]
      \{% end %}
    end

    def self.adapter : ::Grant::Adapter::Sqlite::Connection
      ::Grant::Base::Base.current_transaction_connection(transaction_adapter) || transaction_adapter
    end

    def self.connection : ::Grant::Adapter::Sqlite::Connection
      adapter
    end

    def self.primary_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ primary.name.stringify }}
      \{% end %}
    end

    def self.migrator : ::Grant::Base::Migrator
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      ::Grant::Base::Migrator.new(adapter, table_name, [
        \{% for v in columns %}
          \{% type = v.annotation(::Grant::Base::Column)[:type] %}
          \{% sql = type.includes?("Int") ? "INTEGER" : (type.includes?("Bool") ? "BOOLEAN" : (type.includes?("Float") ? "REAL" : "TEXT")) %}
          \{% if v == primary %}
            "\{{ v.name }} \{{ sql.id }} PRIMARY KEY\{{ v.annotation(::Grant::Base::Column)[:auto] ? "".id : " NOT NULL".id }}",
          \{% else %}
            "\{{ v.name }} \{{ sql.id }}\{{ type.includes?("?") || type.includes?("Nil") ? "".id : " NOT NULL".id }}",
          \{% end %}
        \{% end %}
      ] of String)
      \{% end %}
    end

    def self.clear : Nil | ::Grant::Errors::DatabaseError
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      adapter.execute("DELETE FROM #{table_name}")!
      nil
      \{% end %}
    end

    def self.from_row(row : ::Grant::Adapter::Sqlite::Row) : {{ @type }}
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      record = \{{ @type }}.allocate_record
      \{% for v in columns %}
        \{% type = v.annotation(::Grant::Base::Column)[:type] %}
        %raw = row[\{{ v.name.stringify }}]?
        \{% if type.includes?("Int32") %}
          record.\{{ v.name }} = %raw.is_a?(Int64) ? %raw.to_i32 : nil
        \{% elsif type.includes?("Int64") %}
          record.\{{ v.name }} = %raw.is_a?(Int64) ? %raw : nil
        \{% elsif type.includes?("Bool") %}
          record.\{{ v.name }} = %raw.is_a?(Int64) ? %raw != 0 : nil
        \{% elsif type.includes?("Float32") %}
          record.\{{ v.name }} = %raw.is_a?(Float64) ? %raw.to_f32 : nil
        \{% elsif type.includes?("Time") %}
          record.\{{ v.name }} = %raw.is_a?(String) ? ::Std::Time::Time.parse_rfc3339(%raw) : nil
        \{% elsif type.includes?("Float") %}
          record.\{{ v.name }} = %raw.is_a?(Float64) ? %raw : nil
        \{% else %}
          record.\{{ v.name }} = %raw.is_a?(String) ? %raw : nil
        \{% end %}
      \{% end %}
      record.__mark_persisted
      record.after_find.or_panic
      record
      \{% end %}
    end

    def self.allocate_record : {{ @type }}
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      new
      \{% end %}
    end

    def self.create(**args) : {{ @type }}
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      record = new
      record.assign_attributes(args)
      record.save
      record
      \{% end %}
    end

    # Crystal `create!`: returns the error instead of raising it.
    def self.create_strict(**args) : {{ @type }} | ::Grant::Errors::RecordNotSaved | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      record = new
      record.assign_attributes(args)
      record.save_strict!
      record
      \{% end %}
    end

    def self.find(id : ::Grant::Adapter::Sqlite::Value) : {{ @type }} | Nil
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      return nil if id.nil?
      rows = adapter.query("SELECT * FROM #{table_name} WHERE \{{ primary.name }} = ? LIMIT 1", [id] of ::Grant::Adapter::Sqlite::Value)
      return nil if rows.is_a?(::Grant::Errors::DatabaseError) || rows.empty?
      from_row(rows[0])
      \{% end %}
    end

    # Crystal `find!`.
    def self.find_strict(id : ::Grant::Adapter::Sqlite::Value) : {{ @type }} | ::Grant::Errors::RecordNotFound
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      found = find(id)
      return ::Grant::Errors::RecordNotFound.new(\{{ @type.name.stringify }}, id.to_s) if found.nil?
      found
      \{% end %}
    end

    def self.where(**args) : Array({{ @type }}) | ::Grant::Errors::DatabaseError
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      clauses = [] of String
      values = [] of ::Grant::Adapter::Sqlite::Value
      args.each do |key, value|
        clauses << "#{key} = ?"
        values << value
      end
      sql = "SELECT * FROM #{table_name}"
      sql += " WHERE #{clauses.join(" AND ")}" unless clauses.empty?
      adapter.query(sql, values)!.map { |row| from_row(row) }
      \{% end %}
    end

    def self.transaction(options : ::Grant::Transaction::Options = ::Grant::Transaction::Options.new, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError forall T
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      ::Grant::Base::Base.run_transaction(transaction_adapter, options) { yield }
      \{% end %}
    end

    def self.transaction(isolation : ::Grant::Transaction::IsolationLevel? = nil, readonly : Bool = false, requires_new : Bool = false, independent : Bool = false, joinable : Bool = true, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError forall T
      transaction(::Grant::Transaction::Options.new(isolation: isolation, readonly: readonly, requires_new: requires_new, independent: independent, joinable: joinable)) { yield }
    end

    def self.transaction_open? : Bool
      ::Grant::Base::Base.in_explicit_transaction?
    end

    def self.after_all_transactions_commit(&block : -> Nil) : Nil
      ::Grant::Transaction.after_all_transactions_commit(&block)
    end

    def self.current_transaction : ::Grant::Transaction::Handle
      ::Grant::Transaction.current_transaction(transaction_adapter)
    end

    def self.all : Array({{ @type }}) | ::Grant::Errors::DatabaseError
      adapter.query("SELECT * FROM #{table_name}")!.map { |row| from_row(row) }
    end

    def self.all(clause : String, values : Array(V)) : Array({{ @type }}) | ::Grant::Errors::DatabaseError forall V
      params = values.map { |value| ::Grant::Base.sqlite_value(value) }
      adapter.query("SELECT * FROM #{table_name} #{clause}", params)!.map { |row| from_row(row) }
    end

    def self.import_records(model_array : Array({{ @type }}), batch_size : Int32 = model_array.size, update_on_duplicate : Bool = false, columns : Array(String) = [] of String, ignore_on_duplicate : Bool = false) : Nil | ::Grant::Errors::DatabaseError
      ::Grant::Transactions.import_records(adapter, table_name, primary_name, model_array, batch_size, update_on_duplicate, columns, ignore_on_duplicate)
    end

    def self.first : {{ @type }} | Nil | ::Grant::Errors::DatabaseError
      rows = adapter.query("SELECT * FROM #{table_name} ORDER BY #{primary_name} ASC LIMIT 1")!
      row = rows.empty? ? nil : rows[0]
      row.nil? ? nil : from_row(row)
    end

    def self.first_strict : {{ @type }} | ::Grant::Errors::RecordNotFound | ::Grant::Errors::DatabaseError
      record = first!
      return ::Grant::Errors::RecordNotFound.new({{ @type.name.stringify }}, "first") if record.nil?
      record
    end

    def self.count : Int64 | ::Grant::Errors::DatabaseError
      adapter.query("SELECT COUNT(*) AS count FROM #{table_name}")![0]["count"].as(Int64)
    end

    def __primary_name : String
      self.class.primary_name
    end

    def __primary_value : ::Grant::Adapter::Sqlite::Value
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      self.\{{ primary.name }}
      \{% end %}
    end

    def __set_primary_value(value : Int64) : Nil
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{% if primary.annotation(::Grant::Base::Column)[:auto] %}
      self.\{{ primary.name }} = value
      \{% end %}
      \{% end %}
    end

    def __primary_auto? : Bool
      \{% begin %}
      \{% primary = @type.instance_vars.find { |v| v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ primary.annotation(::Grant::Base::Column)[:auto] }}
      \{% end %}
    end

    def __column_names : Array(String)
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      [\{% for v in columns %}\{% unless v == primary %}\{{ v.name.stringify }},\{% end %}\{% end %}] of String
      \{% end %}
    end

    def __column_values : Array(::Grant::Adapter::Sqlite::Value)
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      values = [] of ::Grant::Adapter::Sqlite::Value
      \{% for v in columns %}
        \{% unless v == primary %}
          %value = self.\{{ v.name }}
          values << ::Grant::Base.sqlite_value(%value)
        \{% end %}
      \{% end %}
      values
      \{% end %}
    end

    def after_initialize : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_initialize_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_find : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_find_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_validation : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_validation_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_validation : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_validation_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_save : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_save_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_save : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_save_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_create : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_create_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_create : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_create_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_update : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_update_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_update : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_update_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def before_destroy : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_before_destroy_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_destroy : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_destroy_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def after_touch : Nil | ::Grant::Callbacks::Abort
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__callback_after_touch_") } %}
        \{{ m.name }}!
      \{% end %}
      nil
    end

    def __transaction_adapter : ::Grant::Adapter::Sqlite::Connection
      self.class.transaction_adapter
    end

    def __adapter : ::Grant::Adapter::Sqlite::Connection
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ @type }}.adapter
      \{% end %}
    end

    def __table_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ @type }}.table_name
      \{% end %}
    end
  end

  def assign_attributes(args : T) forall T
    {% for key in T.keys %}
      self.{{ key.id }} = args[{{ key.symbolize }}]
    {% end %}
  end

  abstract def __primary_name : String
  abstract def __primary_value : ::Grant::Adapter::Sqlite::Value
  abstract def __primary_auto? : Bool
  abstract def __set_primary_value(value : Int64) : Nil
  abstract def __column_names : Array(String)
  abstract def __column_values : Array(Value)
  abstract def __run_commit_callbacks(operation : Symbol) : Nil
  abstract def __run_rollback_callbacks(operation : Symbol) : Nil
  abstract def __transaction_adapter : Connection
  abstract def __adapter : Connection
  abstract def __table_name : String

  def self.run_transaction(adapter : Connection, options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
    ::Grant::Transaction.run(adapter, options) { yield }
  end

  def self.current_transaction_connection(adapter : Connection) : Connection?
    ::Grant::Transaction.current_connection?(adapter)
  end

  def self.in_explicit_transaction? : Bool
    ::Grant::Transaction.in_explicit_transaction?
  end

  def transaction(options : Options = Options.new, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError forall T
    Base.run_transaction(__transaction_adapter, options) { yield }
  end

  def __remember_record_flags : Nil
    return unless __adapter.in_transaction?
    state = TransactionState.new(@new_record, @destroyed)
    ::Grant::Transaction.enlist_record_rollback_action(__adapter) { __restore_transaction_state(state) }
  end

  def __restore_transaction_state(state : TransactionState) : Nil
    @new_record = state.new_record
    @destroyed = state.destroyed
  end

  def __mark_persisted : Nil
    @new_record = false
    @destroyed = false
  end

  def new_record? : Bool
    @new_record
  end

  def destroyed? : Bool
    @destroyed
  end

  def persisted? : Bool
    !(@new_record || @destroyed)
  end

  def save(*, skip_timestamps : Bool = false) : Bool
    !save_strict(skip_timestamps: skip_timestamps).is_a?(::Error)
  end

  # Crystal `save!`.
  def save_strict(*, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | TransactionIsolationError
    operation = @new_record ? :create : :update
    result = Base.run_transaction(__transaction_adapter, Options.new(requires_new: true)) do
      saved = __save(skip_timestamps: skip_timestamps)
      if saved.is_a?(::Error)
        ::Grant::Transaction.enqueue_pending_callback(-> { nil }, -> { __run_rollback_callbacks(operation) })
      end
      saved
    end
    if result.is_a?(::Grant::Callbacks::Abort)
      errors << ::Grant::Error::Error.new(:base, result.message)
      return RecordNotSaved.new(__table_name)
    end
    return false if result.nil?
    result
  end

  def valid? : Bool | ::Grant::Callbacks::Abort
    self.before_validation!
    self.after_validation!
    true
  end

  def abort_strict(message : String = "Aborted") : ::Grant::Callbacks::Abort
    ::Grant::Callbacks::Abort.new(message)
  end

  def __save(*, skip_timestamps : Bool = false) : Bool | RecordNotSaved | DatabaseError | ::Grant::Callbacks::Abort
    return RecordNotSaved.new(__table_name) if @destroyed
    errors.clear
    if @new_record && !__primary_auto? && __primary_value.nil?
      errors << ::Grant::Error::Error.new(__primary_name, "Primary key('#{__primary_name}') cannot be null")
      return RecordNotSaved.new(__table_name)
    end
    __remember_transaction_state
    operation = @new_record ? :create : :update
    valid?!
    self.before_save!
    if @new_record
      self.before_create!
    else
      self.before_update!
    end
    set_timestamps(mode: @new_record ? :create : :update) unless skip_timestamps
    names = __column_names
    values = __column_values
    if @new_record
      primary_value = __primary_value
      unless primary_value.nil?
        names << __primary_name
        values << primary_value
      end
      placeholders = names.map { "?" }.join(", ")
      result = __adapter.execute("INSERT INTO #{__table_name} (#{names.join(", ")}) VALUES (#{placeholders})", values)
      return RecordNotSaved.new(__table_name, result) if result.is_a?(DatabaseError)
      __set_primary_value(result.last_insert_id) if __primary_auto? && __primary_value.nil?
    else
      assignments = names.map { |name| "#{name} = ?" }.join(", ")
      values << __primary_value
      result = __adapter.execute("UPDATE #{__table_name} SET #{assignments} WHERE #{__primary_name} = ?", values)
      return RecordNotSaved.new(__table_name, result) if result.is_a?(DatabaseError)
    end
    __mark_persisted
    if operation == :create
      self.after_create!
    else
      self.after_update!
    end
    self.after_save!
    queue_commit_callbacks(operation)
    true
  end

  def queue_commit_callbacks(operation : Symbol) : Nil
    ::Grant::Transaction.queue_record_callbacks(__adapter, object_id, operation, ->(op : Symbol) { __run_commit_callbacks(op) }, ->(op : Symbol) { __run_rollback_callbacks(op) })
  end

  # Deletes the row without callbacks.
  def delete : self
    __remember_transaction_state
    if id = __primary_value
      __adapter.execute("DELETE FROM #{__table_name} WHERE #{__primary_name} = ?", [id] of Value)
    end
    @destroyed = true
    self
  end

  def destroy : Bool
    self.before_destroy.or_panic
    delete
    self.after_destroy.or_panic
    queue_commit_callbacks(:destroy)
    true
  end
end

pub def sqlite_value(value : Value) : Value
  value
end

pub def sqlite_value(value : Int32) : Value
  value.to_i64
end

pub def sqlite_value(value : Float32) : Value
  value.to_f64
end

pub def sqlite_value(value : ::Std::Time::Time) : Value
  value.to_rfc3339(9)
end
