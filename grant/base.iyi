module grant/base
import std/named_tuple
pub import std/time
pub import grant/timestamps
pub import grant/callbacks
pub import grant/transactions

pub import grant/adapter/sqlite
import grant/adapter/sqlite::{Connection, Value, Row}
pub import grant/connections
import grant/connections::{Connections}
pub import grant/transaction
import grant/transaction::{Options}
import grant/errors::{TransactionIsolationError}
pub import grant/errors
import grant/errors::{DatabaseError, RecordNotFound, RecordNotSaved, Rollback}

pub annotation Column
end

# Snapshot taken when a record first takes part in a transaction.
pub struct TransactionState
  getter new_record : Bool
  getter destroyed : Bool

  def initialize(@new_record : Bool, @destroyed : Bool)
  end
end

pub class Migrator
  getter table : String
  getter columns : Array(String)
  getter connection : Connection

  def initialize(@connection : Connection, @table : String, @columns : Array(String))
  end

  def drop_and_create : Nil | DatabaseError
    @connection.execute("DROP TABLE IF EXISTS #{@table}")!
    @connection.execute("CREATE TABLE #{@table} (#{@columns.join(", ")})")!
    nil
  end
end

pub abstract class Base
  @new_record : Bool = true
  @destroyed : Bool = false
  getter errors = ::Grant::Errors::Errors.new

  def initialize(**args)
    assign_attributes(args)
    self.after_initialize.or_panic
  end

  macro inherited
    @@table_name : String = {{ @type.name.split("::").last.underscore.stringify }} + "s"
    @@connection_name : String = "sqlite"

    macro finished
      __process_columns
    end
  end

  macro table(name)
    @@table_name = {{ name.id.stringify }}
  end

  macro connection(name)
    @@connection_name = {{ name.id.stringify }}
  end

  macro column(decl, **options)
    @[::Grant::Base::Column(primary: {{ options[:primary] || false }}, type: {{ decl.type.stringify }}, auto: {{ options[:auto] == nil ? decl.type.stringify.includes?("Int") : options[:auto] }})]
    @{{decl.var}} : {{decl.type}} | Nil = nil
    @__persisted_{{decl.var}} : {{decl.type}} | Nil = nil

    def {{decl.var}} : {{decl.type}} | Nil
      @{{decl.var}}
    end

    def {{decl.var}}_changed? : Bool
      @{{decl.var}} != @__persisted_{{decl.var}}
    end

    def {{decl.var}}=(value : {{decl.type}} | Nil) : Nil
      @{{decl.var}} = value
    end
  end

  macro timestamps(precision = nil, null = true)
    column created_at : ::Std::Time::Time?, precision: {{ precision }}, null: {{ null }}
    column updated_at : ::Std::Time::Time?, precision: {{ precision }}, null: {{ null }}
    {% if precision %}
      def self.timestamp_precision : Int32?
        {{ precision }}
      end
    {% end %}
  end

  macro after_commit(method = nil, on = nil, &block)
    @[::Grant::Callbacks::Callback(event: :commit, on: {{ on }})]
    def __callback_commit_{{ @type.methods.size }} : Nil
      {% if block %}
        {{ block.body }}
      {% else %}
        {{ method.id }}
      {% end %}
      nil
    end
  end

  macro after_rollback(method = nil, on = nil, &block)
    @[::Grant::Callbacks::Callback(event: :rollback, on: {{ on }})]
    def __callback_rollback_{{ @type.methods.size }} : Nil
      {% if block %}
        {{ block.body }}
      {% else %}
        {{ method.id }}
      {% end %}
      nil
    end
  end

  macro after_create_commit(method = nil, on = :create, &block)
    @[::Grant::Callbacks::Callback(event: :commit, priority: true, on: {{ on }})]
    def __callback_commit_{{ @type.methods.size }} : Nil
      {% if block %}
        {{ block.body }}
      {% else %}
        {{ method.id }}
      {% end %}
