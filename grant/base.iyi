      \{% end %}
    end

    def self.transaction_adapter
      unless connection_config.empty?
        return resolve_adapter_for_role(::Grant::Settings.settings.writing_role)
      end
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        resolve_adapter_for_role(::Grant::Settings.settings.writing_role)
      \{% else %}
        ::Grant::Connections::Connections[@@connection_name]
      \{% end %}
      \{% end %}
    end

    def self.resolve_adapter_for_role(role : Symbol) : ::Grant::Adapter::Base::Base
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        \{% database = declaration.annotation(::Grant::ConnectionManagement::ConnectsTo)[:database] %}
        \{% if database.is_a?(NamedTupleLiteral) %}
          name = case role
          \{% for key, value in database %}
          when \{{ key.symbolize }} then \{{ value }}
          \{% end %}
          else \{{ database.values.first }}
          end
        \{% else %}
          name = \{{ database }}.to_s
        \{% end %}
      \{% else %}
        name = @@connection_name
      \{% end %}
      configured_role = role == :primary ? ::Grant::Settings.settings.writing_role : role
      name = connection_config[configured_role]? || connection_config[role]? || name
      shard = current_shard
      unless shard.nil?
        shard_roles = shard_config[shard]?
        name = shard_roles[configured_role]? || name unless shard_roles.nil?
      end
      name = connection_context_database || name
      ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter?(name, ::Grant::ConnectionManagement.registry_role(role)) || ::Grant::Connections::Connections[name]
      \{% end %}
    end

    def self.adapter
      context_database = connection_context_database
      unless context_database.nil?
        contextual = ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter?(context_database, ::Grant::ConnectionManagement.registry_role(current_role))
        return contextual unless contextual.nil?
      end
      unless connection_config.empty?
        role = current_role
        return resolve_adapter_for_role(role)
      end
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        transaction_adapter
      \{% else %}
        ::Grant::Connections::Connections[@@connection_name]
      \{% end %}
      \{% end %}
    end

    def self.__transaction_connection : ::Grant::Adapter::Driver::Connection
      transaction_adapter.checkout.or_panic
    end

    def self.__connection : ::Grant::Adapter::Driver::Connection
      original = __transaction_connection
      current = ::Grant::Base::Base.current_transaction_connection(original)
      return current unless current.nil?
      return adapter.checkout.or_panic unless connection_context.nil?
      if should_use_reader?
        return resolve_adapter_for_role(::Grant::Settings.settings.reading_role).checkout.or_panic
      end
      original
    end

    def self.connection
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        ::Grant::Connection::Connection.new(->(role : Symbol) { resolve_adapter_for_role(role) })
      \{% else %}
        ::Grant::Connection::Connection.new(->(role : Symbol) { adapter }, -> { mark_write_operation; nil })
      \{% end %}
      \{% end %}
    end

