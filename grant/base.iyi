  macro after_save_commit(method = nil, on = [:create, :update], &block)
    @[::Grant::Callbacks::Callback(event: :commit, priority: true, on: {{ on }})]
    def __callback_commit_{{ @type.methods.size }} : Nil
      {% if block %}
        {{ block.body }}
      {% else %}
