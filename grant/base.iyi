  macro column(decl, **options)
    {% converter = options[:converter] || (decl.type.stringify.includes?("BigDecimal") ? "::Grant::Converters::Decimal".id : nil) %}
    ::Grant::Columns.dirty_column_methods({{ decl }})
    @[::Grant::Base::Column(primary: {{ options[:primary] || false }}, type: {{ decl.type.stringify }}, auto: {{ options[:auto] == nil ? (decl.type.stringify.includes?("Int") || decl.type.stringify.includes?("UUID")) : options[:auto] }}, converter: {{ converter }}, column_type: {{ options[:column_type] }}, literal_default: {% if decl.value.is_a?(StringLiteral) || decl.value.is_a?(NumberLiteral) || decl.value.is_a?(BoolLiteral) || decl.value.is_a?(NilLiteral) %} {{ decl.value }} {% else %} nil {% end %}, has_literal_default: {{ decl.value.is_a?(StringLiteral) || decl.value.is_a?(NumberLiteral) || decl.value.is_a?(BoolLiteral) || decl.value.is_a?(NilLiteral) }}, limit: {{ options[:limit] }}, precision: {{ options[:precision] }}, scale: {{ options[:scale] }}, null: {{ options[:null] }}, collation: {{ options[:collation] }}, comment: {{ options[:comment] }}, default_sql: {{ options[:default_sql] }}, guarded: {{ options[:guarded] || false }}, lazy: {{ options[:lazy] || false }}, encrypted: {{ options[:encrypted] || false }})]
    @{{decl.var}} : {{decl.type}} | Nil = {% if decl.value.is_a?(BoolLiteral) %}{{ decl.value }}{% else %}{{ decl.value || nil }}{% end %}
    @__persisted_{{decl.var}} : {{decl.type}} | Nil = nil

    {% if options[:lazy] %}
      def __unseal_{{decl.var}} : String? | ::Grant::Error::ErrorBase
        current = @{{decl.var}}
        return current unless current && ::Grant::Encryption::Sealed.sealed?(current)
        plain = self.class.{{decl.var}}_encrypted_attribute.open_with_index(::Grant::Encryption::Sealed.stored(current))![0]
        # Unsealing is a read: retain the clean baseline when this was the
        # stored value, without opening any unrelated encrypted attribute.
        @__persisted_{{decl.var}} = plain if @__persisted_{{decl.var}} == current
        @{{decl.var}} = plain
      end

      def {{decl.var}} : String? | ::Grant::Error::ErrorBase
        {% if options[:original] %}
          original = self.{{options[:original].id}}!
          return original unless original.nil?
        {% end %}
        __unseal_{{decl.var}}
      end

      def {{decl.var}}? : String? | ::Grant::Error::ErrorBase
        __unseal_{{decl.var}}
      end

      def {{decl.var}}_strict : String | ::Grant::Error::ErrorBase
        value = __unseal_{{decl.var}}!
        value.nil? ? ::Grant::Encryption::Sealed::NilAssertionError.new({{ @type.stringify }} + "#" + {{ decl.var.stringify }} + " cannot be nil") : value
      end

      # Hydration assigns the internal marker without treating it as plaintext.
      def __load_{{decl.var}}(stored : String?) : Nil
        @{{decl.var}} = stored.nil? || ::Grant::Encryption::Context.current_context.encryption_disabled? ? stored : ::Grant::Encryption::Sealed.wrap(stored)
        nil
      end
    {% elsif decl.value %}
      def {{decl.var}} : {{decl.type}}
        @{{decl.var}}.as({{decl.type}})
      end
    {% else %}
      def {{decl.var}} : {{decl.type}} | Nil
        {% if options[:original] %}
          @{{options[:original].id}} || @{{decl.var}}
        {% else %}
          @{{decl.var}}
        {% end %}
      end
    {% end %}

    {% unless options[:lazy] %}
      def {{decl.var}}_strict : {{decl.type}} | ::Grant::Encryption::Sealed::NilAssertionError
        value = @{{decl.var}}
        value.nil? ? ::Grant::Encryption::Sealed::NilAssertionError.new({{ @type.stringify }} + "#" + {{ decl.var.stringify }} + " cannot be nil") : value
      end
    {% end %}

    # Internal copies preserve sealed values without invoking public readers.
    def __raw_{{decl.var}} : {{decl.type}} | Nil
      @{{decl.var}}
    end

    def __raw_{{decl.var}}=(value : {{decl.type}} | Nil) : Nil
      @{{decl.var}} = value
      nil
    end

    def __baseline_{{decl.var}} : {{decl.type}} | Nil
      @__persisted_{{decl.var}}
    end

    def __baseline_{{decl.var}}=(value : {{decl.type}} | Nil) : Nil
      @__persisted_{{decl.var}} = value
      nil
    end

    {% if converter %}
      # Converter lookup from the model's scope, for Base methods that loop over columns.
      def self.__converter_from_db_{{decl.var}}(value : V) forall V
        return value if value.is_a?({{ decl.type }}?)
        {{ converter }}.from_db(value)
      end
    {% end %}

    def {{decl.var}}_changed? : Bool
      __refresh_mutation_tracking
      return true if __forced_dirty_attribute?({{ decl.var.stringify }})
      return false if @{{decl.var}} == @__persisted_{{decl.var}}
      {% if options[:encrypted] %}
        # The Symbol/database reader in the upstream setter compares stored
        # values. A deterministic assignment can equal a sealed baseline.
        current = {{ converter }}.to_db(@{{decl.var}})
        baseline = {{ converter }}.to_db(@__persisted_{{decl.var}})
        return true if current.is_a?(::Error) || baseline.is_a?(::Error)
        current != baseline
      {% else %}
        true
      {% end %}
    end

    def {{decl.var}}=(value : {{decl.type}} | Nil) : Nil {% if options[:guarded] %}| ::Grant::Encryption::Sealed::ArgumentError{% end %}
      {% if options[:guarded] %}
        ::Grant::Encryption::Sealed.guard_plaintext_strict({{ decl.var.stringify }}, value)!
      {% end %}
      {% if options[:enum_attribute] %}
        __after_assign_{{ decl.var }}(value)
      {% end %}
      __mark_attribute_assigned({{ decl.var.stringify }})
      errors.clear_conversion_error({{ decl.var.symbolize }})
      discard_before_type_cast({{ decl.var.stringify }})
      normalized = self.class.normalize_value_for({{ decl.var.symbolize }}, value).as({{ decl.type }} | Nil)
      {% if decl.type.stringify.includes?("BigDecimal") && options[:scale] %}
        normalized = normalized.nil? ? nil : ::Grant::Columns.decimal_at_scale(normalized, {{ options[:scale] }})
      {% end %}
      {% if options[:downcase] %}
        @{{decl.var}} = normalized.nil? ? nil : normalized.downcase
      {% else %}
        @{{decl.var}} = normalized
      {% end %}
      {% if options[:original] %}
        {% if options[:guarded] %}
          (self.{{options[:original].id}} = value)!
        {% else %}
          self.{{options[:original].id}} = value
        {% end %}
      {% end %}
      nil
    end
  end

  macro encrypts(attribute, deterministic = false, downcase = false, ignore_case = false, compress = false, compress_threshold = nil, previous = nil, support_unencrypted_data = nil, lazy = nil)
    ::Grant::Encryption.typed_attribute({{ @type }}, {{ attribute }}, {{ deterministic }}, {{ downcase }}, {{ ignore_case }}, {{ compress }}, {{ compress_threshold }}, {{ previous }}, {{ support_unencrypted_data }}, {{ lazy }})
  end

