          %result = \{{ m.name }}
        \{% elsif on.is_a?(ArrayLiteral) %}
          %result = \{{ m.name }} if \{{ on }}.includes?(operation)
        \{% else %}
          %result = \{{ m.name }} if operation == \{{ on }}
        \{% end %}
        return %result if %result.is_a?(::Error)
      \{% end %}
      \{% end %}
      nil
      \{% end %}
    end

