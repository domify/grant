    def self.all(clause : String, values : Array(V)) : Array({{ @type }}) | ::Grant::Collection::Collection({{ @type }}) | ::Grant::Errors::DatabaseError | ::Grant::Error::ErrorBase forall V
      params = values.map { |value| ::Grant::Base.sqlite_value(value) }
      clean_clause = clause.strip
      if clean_clause.includes?("JOIN ") || params.size > 1 || clean_clause.upcase.starts_with?("ORDER BY ")
        ::Grant::Collection::Collection({{ @type }}).new(-> { raw_all(clause, params).or_panic })
      else
        raw_all(clause, params)
      end
    end

