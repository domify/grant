  macro __process_columns
    ::Grant::Integrators.create_methods({{ @type }})
    ::Grant::Locking::Pessimistic.model_methods({{ @type }})
    def establish_initial_dirty_baseline : Nil
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        @__persisted_\{{ v.name }} = @\{{ v.name }}
      \{% end %}
      nil
    end

    def changed? : Bool
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        return true if @\{{ v.name }} != @__persisted_\{{ v.name }}
      \{% end %}
      false
    end

    def __run_save_transaction(*, validate : Bool, skip_timestamps : Bool) : Bool | Nil | ::Grant::Errors::RecordNotSaved | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        pending_\{{ v.name }} = @\{{ v.name }}
      \{% end %}
      operation = new_record? ? :create : :update
      failed = false
      result = ::Grant::Base::Base.run_transaction(__transaction_adapter, ::Grant::Transaction::Options.new(requires_new: true)) do
        saved = __run_around_save { __save(validate: validate, skip_timestamps: skip_timestamps) }
        failed = saved.is_a?(::Error)
        if failed
          ::Grant::Transaction.enqueue_pending_callback(-> { nil }, -> { __run_rollback_callbacks(operation) })
        end
        saved
      end
      if failed
        \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
          @\{{ v.name }} = pending_\{{ v.name }}
        \{% end %}
      end
      result
    end

    def __mark_persisted : Nil
      super
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        @__persisted_\{{ v.name }} = @\{{ v.name }}
      \{% end %}
      nil
    end

    def __remember_transaction_state : Nil
      return unless __adapter.in_transaction?
      __remember_record_flags
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        snapshot_\{{ v.name }} = new_record? ? @\{{ v.name }} : @__persisted_\{{ v.name }}
      \{% end %}
      ::Grant::Transaction.enlist_record_rollback_action(__adapter) do
        \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
          @\{{ v.name }} = snapshot_\{{ v.name }}
          @__persisted_\{{ v.name }} = snapshot_\{{ v.name }}
        \{% end %}
        nil
      end
    end

    def update(**args) : Bool
      assign_attributes(args)
      save
    end

    def update(attributes : T, *, skip_timestamps : Bool = false) : Bool forall T
      assign_attributes(attributes)
      save(skip_timestamps: skip_timestamps)
    end

    def update_strict(attributes : T, *, skip_timestamps : Bool = false) : Bool | ::Grant::Errors::RecordNotSaved | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase forall T
      assign_attributes(attributes)
      save_strict(skip_timestamps: skip_timestamps)
    end

    def update_strict(**args) : Bool | ::Grant::Errors::RecordNotSaved | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase
      assign_attributes(args)
      save_strict
    end

    def __run_validations : Nil
      \{% for m in @type.methods.select { |m| m.name.starts_with?("__validate_") } %}
        \{{ m.name }}
      \{% end %}
      nil
    end

    def __run_around_save(&action : -> T) : T | ::Grant::Errors::RecordNotSaved forall T
      result = ::Grant::Errors::RecordNotSaved.new(__table_name).as(T | ::Grant::Errors::RecordNotSaved)
      continuation = -> { result = action.call; nil }
      \{% begin %}
      \{% callbacks = @type.methods.select { |m| m.name.starts_with?("__callback_around_save_") } %}
      \{% for i in (0...callbacks.size) %}
        \{% m = callbacks[callbacks.size - 1 - i] %}
        previous_\{{ m.name }} = continuation
        continuation = -> { \{{ m.name }}(previous_\{{ m.name }}) }
      \{% end %}
      \{% end %}
      continuation.call
      result
    end

    def __run_commit_callbacks(operation : Symbol) : Nil | ::Grant::Error::ErrorBase
      \{% begin %}
      \{% for priority in [true, false] %}
      \{% for m in @type.methods.select { |m| m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:event] == :commit && (m.annotation(::Grant::Callbacks::Callback)[:priority] == true) == priority } %}
        \{% on = m.annotation(::Grant::Callbacks::Callback)[:on] %}
        \{% if on == nil %}
          %result = \{{ m.name }}
        \{% elsif on.is_a?(ArrayLiteral) %}
          %result = \{{ m.name }} if \{{ on }}.includes?(operation)
        \{% else %}
          %result = \{{ m.name }} if operation == \{{ on }}
        \{% end %}
        return %result if %result.is_a?(::Error)
      \{% end %}
      \{% end %}
      nil
      \{% end %}
    end

    def __run_rollback_callbacks(operation : Symbol) : Nil
      \{% begin %}
      \{% for m in @type.methods.select { |m| m.annotation(::Grant::Callbacks::Callback) && m.annotation(::Grant::Callbacks::Callback)[:event] == :rollback } %}
        \{% on = m.annotation(::Grant::Callbacks::Callback)[:on] %}
        \{% if on == nil %}
          \{{ m.name }}
        \{% elsif on.is_a?(ArrayLiteral) %}
          \{{ m.name }} if \{{ on }}.includes?(operation)
        \{% else %}
          \{{ m.name }} if operation == \{{ on }}
        \{% end %}
      \{% end %}
      nil
      \{% end %}
    end




    def self.timestamp_precision : Int32?
      nil
    end

    def set_timestamps(*, to : ::Std::Time::Time = ::Grant::Timestamps.current_time, mode : Symbol = :create) : Nil
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:type].includes?("Time") } %}
        \{% if ["created_at", "created_on"].includes?(v.name.stringify) %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, to, self.class.timestamp_precision) if mode == :create
        \{% elsif ["updated_at", "updated_on"].includes?(v.name.stringify) %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, to, self.class.timestamp_precision)
        \{% end %}
      \{% end %}
      nil
    end

    def touch(*fields, time : ::Std::Time::Time = ::Grant::Timestamps.current_time) : Bool | ::Grant::Error::ErrorBase | ::Grant::Errors::DatabaseError | ::Grant::Callbacks::Abort
      \{% begin %}
      return ::Grant::Error::ErrorBase.new("Cannot touch on a new record object") unless persisted?
      __remember_transaction_state
      touch_fields = [] of String
      touch_values = [] of ::Grant::Adapter::Sqlite::Value
      \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      \{% for v in columns %}
        \{% if ["updated_at", "updated_on"].includes?(v.name.stringify) && v.annotation(::Grant::Base::Column)[:type].includes?("Time") %}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, time, self.class.timestamp_precision)
          touch_fields << \{{ v.name.stringify }}
          touch_values << ::Grant::Base.sqlite_value(self.\{{ v.name }})
        \{% end %}
      \{% end %}
      fields.each do |field|
        case field.to_s
        \{% for v in columns.select { |v| v.annotation(::Grant::Base::Column)[:type].includes?("Time") } %}
        when \{{ v.name.stringify }}
          self.\{{ v.name }} = ::Grant::Timestamps.stamp(\{{ v.name.stringify }}, time, self.class.timestamp_precision)
          unless touch_fields.includes?(field.to_s)
            touch_fields << field.to_s
            touch_values << ::Grant::Base.sqlite_value(self.\{{ v.name }})
          end
        \{% end %}
        else
          if __column_names.includes?(field.to_s) || __primary_name == field.to_s
            return ::Grant::Error::ErrorBase.new("\{{ @type.name }}.#{field} cannot be touched.  It is not of type `Time`.")
          end
          return ::Grant::Error::ErrorBase.new("Field '#{field}' does not exist on type '\{{ @type.name }}'.")
        end
      end
      return ::Grant::Error::ErrorBase.new("No timestamp columns are available to touch") if touch_fields.empty?
      assignments = touch_fields.map { |field| "#{::Grant::Base.quote_identifier(field)} = ?" }.join(", ")
      touch_values << __primary_value
      __adapter.execute("UPDATE #{::Grant::Base.quote_identifier(__table_name)} SET #{assignments} WHERE #{::Grant::Base.quote_identifier(__primary_name)} = ?", touch_values)!
      self.after_touch!
      true
      \{% end %}
    end

    def self.table_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      @@table_name
      \{% end %}
    end

    def self.transaction_adapter
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        resolve_adapter_for_role(::Grant::Settings.settings.writing_role)
      \{% else %}
        ::Grant::Connections::Connections[@@connection_name]
      \{% end %}
      \{% end %}
    end

    def self.resolve_adapter_for_role(role : Symbol) : ::Grant::Adapter::Base::Base
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        \{% database = declaration.annotation(::Grant::ConnectionManagement::ConnectsTo)[:database] %}
        \{% if database.is_a?(NamedTupleLiteral) %}
          name = case role
          \{% for key, value in database %}
          when \{{ key.symbolize }} then \{{ value }}
          \{% end %}
          else \{{ database.values.first }}
          end
        \{% else %}
          name = \{{ database }}
        \{% end %}
      \{% else %}
        name = @@connection_name
      \{% end %}
      ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter(name, ::Grant::ConnectionManagement.registry_role(role))
      \{% end %}
    end

    def self.adapter
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        transaction_adapter
      \{% else %}
        __connection
      \{% end %}
      \{% end %}
    end

    def self.__transaction_connection : ::Grant::Adapter::Sqlite::Connection
      selected = transaction_adapter
      if selected.is_a?(::Grant::Adapter::Base::Base)
        selected.checkout.or_panic
      else
        selected
      end
    end

    def self.__connection : ::Grant::Adapter::Sqlite::Connection
      original = __transaction_connection
      ::Grant::Base::Base.current_transaction_connection(original) || original
    end

    def self.connection
      \{% begin %}
      \{% declaration = @type.methods.find { |m| m.annotation(::Grant::ConnectionManagement::ConnectsTo) } %}
      \{% if declaration %}
        ::Grant::Connection::Connection.new(->(role : Symbol) { resolve_adapter_for_role(role) })
      \{% else %}
        __connection
      \{% end %}
      \{% end %}
    end

    def self.with_connection(&block : ::Grant::Adapter::Sqlite::Connection -> T) forall T
      selected = transaction_adapter
      if selected.is_a?(::Grant::Adapter::Base::Base)
        selected.with_connection { |raw| yield raw }
      else
        yield __connection
      end
    end

    def self.connection_pool(role : Symbol = ::Grant::Settings.settings.writing_role) : ::Grant::ConnectionPool::ConnectionPool
      ::Grant::ConnectionPool::ConnectionPool.new(resolve_adapter_for_role(role))
    end

    def self.fields : Array(String)
      \{% begin %}
      [
        \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
          \{{ column.name.stringify }},
        \{% end %}
      ] of String
      \{% end %}
    end

    def self.select_fields_sql : String
      fields.map { |field| "#{::Grant::Base.quote_identifier(table_name)}.#{::Grant::Base.quote_identifier(field)}" }.join(", ")
    end

    def self.primary_name : String
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      \{{ primary.name.stringify }}
      \{% end %}
    end

    def self.migrator : ::Grant::Base::Migrator
      \{% begin %}
    \{% columns = @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
    \{% primary = columns.find { |v| v.annotation(::Grant::Base::Column)[:primary] } %}
      ::Grant::Base::Migrator.new(__connection, table_name, [
        \{% for v in columns %}
          \{% type = v.annotation(::Grant::Base::Column)[:type] %}
          \{% sql = type.includes?("Int") ? "INTEGER" : (type.includes?("Bool") ? "BOOLEAN" : (type.includes?("Float") ? "REAL" : "TEXT")) %}
          \{% if v == primary %}
            "#{::Grant::Base.quote_identifier(\{{ v.name.stringify }})} \{{ sql.id }} PRIMARY KEY\{{ v.annotation(::Grant::Base::Column)[:auto] ? "".id : " NOT NULL".id }}",
          \{% else %}
            "#{::Grant::Base.quote_identifier(\{{ v.name.stringify }})} \{{ sql.id }}\{{ type.includes?("?") || type.includes?("Nil") ? "".id : " NOT NULL".id }}",
          \{% end %}
        \{% end %}
      ] of String)
      \{% end %}
    end

