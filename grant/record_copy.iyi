module grant/record_copy

# Native models cannot include a reopening from another module. Expand the
# upstream RecordCopy API through Base's finished hook, copying stored fields
# directly so lazy readers never run while duplicating a record.
pub macro model_methods(model)
  def dup
    __copy(fresh_identity: true)
  end

  def clone
    __copy(fresh_identity: false)
  end

  private def __copy(*, fresh_identity : Bool)
    copy = {{ model }}.allocate
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      \{% if v.type.union_types.any? { |t| t.name.starts_with?("Array(") } %}
        copy.__raw_\{{ v.name }} = @\{{ v.name }}.try { |value| value.dup }
      \{% else %}
        copy.__raw_\{{ v.name }} = @\{{ v.name }}
      \{% end %}
      copy.__baseline_\{{ v.name }} = @__persisted_\{{ v.name }}
    \{% end %}
    copy.__restore_transaction_state(::Grant::Base::TransactionState.new(new_record?, destroyed?))
    copy.__reset_for_copy(fresh_identity)
    copy
  end

  def __reset_for_copy(fresh_identity : Bool) : Nil
    if fresh_identity
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        \{% if v.annotation(::Grant::Base::Column)[:primary] || (v.annotation(::Grant::Base::Column)[:type].includes?("Time") && ["created_at", "created_on", "updated_at", "updated_on"].includes?(v.name.stringify)) %}
          @\{{ v.name }} = nil
        \{% end %}
      \{% end %}
      __restore_transaction_state(::Grant::Base::TransactionState.new(true, false))
      establish_initial_dirty_baseline
      after_initialize.or_panic
    end
    nil
  end
end
