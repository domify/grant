module grant/query/executor

import grant/error::{ErrorBase}
import grant/adapter/driver
import grant/adapter/base

# Native counterpart of crystal-upstream/src/grant/query/executors/*.cr: each
# holds a statement and its bind values and runs it through the model's
# adapter. Failures are returned, not raised.
# The model adapter's `open`, with a cancelled fiber answered as an error so
# query results stay `T | ErrorBase` like the rest of the model API.
pub def open_statement(adapter : ::Grant::Adapter::Base::Base, sql : String, args : Array(::Grant::Adapter::Driver::Value), &block : ::Grant::Adapter::Driver::Connection -> T) : T | ErrorBase forall T
  result = adapter.open(sql, args) { |db| yield db }
  return ErrorBase.new("Query was cancelled") if result.is_a?(Cancelled)
  result
end

pub alias AggregateRow = Tuple(Array(::Grant::Adapter::Driver::Value), ::Grant::Adapter::Driver::Value)

pub class List(Model)
  def initialize(@sql : String, @args : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value)
  end

  def raw_sql : String
    @sql
  end

  def args : Array(::Grant::Adapter::Driver::Value)
    @args
  end

  def run : Array(Model) | ErrorBase
    rows = ::Grant::Query::Executor.open_statement(Model.adapter, @sql, @args) { |db| db.query(@sql, @args) }!
    records = [] of Model
    rows.each { |row| records << Model.from_row(row)! }
    records
  end
end

# The first column of the first row, or *default* when there is no row (or
# the value is NULL).
pub class Value(Model, Scalar)
  def initialize(@sql : String, @args : Array(::Grant::Adapter::Driver::Value), @default : Scalar)
  end

  def raw_sql : String
    @sql
  end

  def run : Scalar | ErrorBase
    rows = ::Grant::Query::Executor.open_statement(Model.adapter, @sql, @args) { |db| db.query(@sql, @args) }!
    row = rows.first?
    return @default if row.nil?
    value = row.values.first?
    return @default if value.nil?
    cast(value)
  end

  private def cast(value : ::Grant::Adapter::Driver::Value) : Scalar
    if @default.is_a?(Bool)
      # EXISTS answers an integer on SQLite and a boolean on PostgreSQL.
      (value.is_a?(Bool) ? value : value == 1_i64).as(Scalar)
    else
      value.as(Scalar)
    end
  end
end

# GROUP BY counts: the group key columns, then the count.
pub class Grouped(Model)
  def initialize(@sql : String, @group_count : Int32, @args : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value)
  end

  def raw_sql : String
    @sql
  end

  def run : Hash(Array(::Grant::Adapter::Driver::Value), Int64) | ErrorBase
    rows = ::Grant::Query::Executor.open_statement(Model.adapter, @sql, @args) { |db| db.query(@sql, @args) }!
    results = {} of Array(::Grant::Adapter::Driver::Value) => Int64
    rows.each do |row|
      cells = row.values
      key = [] of ::Grant::Adapter::Driver::Value
      @group_count.times { |index| key << cells[index] }
      results[key] = cells[@group_count].as(Int64)
    end
    results
  end
end

pub class Pluck(Model)
  def initialize(@sql : String, @args : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, @fields : Array(String) = [] of String)
  end

  def raw_sql : String
    @sql
  end

  def run : Array(Array(::Grant::Adapter::Driver::Value)) | ErrorBase
    width = @fields.size
    ::Grant::Query::Executor.open_statement(Model.adapter, @sql, @args) do |db|
      db.query(@sql, @args) do |result_set|
        rows = [] of Array(::Grant::Adapter::Driver::Value)
        result_set.each do
          row = [] of ::Grant::Adapter::Driver::Value
          width.times { row << result_set.read! }
          rows << row
          nil
        end!
        rows
      end
    end
  end
end

pub class Aggregate(Model)
  def initialize(@sql : String, @args : Array(::Grant::Adapter::Driver::Value), @group_count : Int32)
  end

  def raw_sql : String
    @sql
  end

  def run : Array(AggregateRow) | ErrorBase
    group_count = @group_count
    ::Grant::Query::Executor.open_statement(Model.adapter, @sql, @args) do |db|
      db.query(@sql, @args) do |result_set|
        rows = [] of AggregateRow
        result_set.each do
          key = [] of ::Grant::Adapter::Driver::Value
          group_count.times { key << result_set.read! }
          rows << {key, result_set.read!}
          nil
        end!
        rows
      end
    end
  end
end
