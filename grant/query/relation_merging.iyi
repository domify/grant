module grant/query/relation_merging

import grant/query/where_field::{WhereField, StructuredWhere, JoinClause}
import grant/query/predicate_renderer::{PredicateRenderer}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}
import std/set

# Immutable notes shared by relation copies, as in upstream relation_merging.cr.
pub class RelationNotes
  getter reordering : Bool
  getter unscoped_components : Array(Symbol)
  getter unscoped_columns : Array(String)
  getter eager_load_joins : Array(JoinClause)
  getter eager_load_distinct : Bool

  def initialize(@reordering : Bool = false,
      @unscoped_components : Array(Symbol) = [] of Symbol,
      @unscoped_columns : Array(String) = [] of String,
      @eager_load_joins : Array(JoinClause) = [] of JoinClause,
      @eager_load_distinct : Bool = false)
  end

  def with(reordering : Bool = @reordering,
      unscoped_components : Array(Symbol) = @unscoped_components,
      unscoped_columns : Array(String) = @unscoped_columns,
      eager_load_joins : Array(JoinClause) = @eager_load_joins,
      eager_load_distinct : Bool = @eager_load_distinct) : RelationNotes
    RelationNotes.new(reordering, unscoped_components, unscoped_columns,
      eager_load_joins, eager_load_distinct)
  end
end

# Structural merge slice of upstream query/builder.cr. Clause equality uses
# printed tuples because native NamedTuple equality currently returns false.
pub trait RelationMerging(Model)
  protected def record_unscope(components : Array(Symbol)) : Nil
    return nil if components.empty?
    self.relation_notes = relation_notes.with(
      unscoped_components: (relation_notes.unscoped_components + components).uniq)
    nil
  end

  protected def record_unscoped_columns(names : Array(String)) : Nil
    return nil if names.empty?
    self.relation_notes = relation_notes.with(
      unscoped_columns: (relation_notes.unscoped_columns + names).uniq)
    nil
  end

  protected def merge_unscopes_in_place(other : Other) : Nil forall Other
    notes = other.relation_notes
    unscope_components_in_place(notes.unscoped_components) unless notes.unscoped_components.empty?
    unscope_where_columns(notes.unscoped_columns) unless notes.unscoped_columns.empty?
    record_unscope(notes.unscoped_components)
    nil
  end

  def merge(&block : self -> self) : self
    merge(yield self.class.new(db_type))
  end

  def merge_in_place(&block : self -> self) : self
    merge_in_place(yield self.class.new(db_type))
  end

  def merge(**matches) : self
    merge(self.class.new(db_type).where(**matches))
  end

  def merge_in_place(**matches) : self
    merge_in_place(self.class.new(db_type).where(**matches))
  end

  private def merge_where_fields_in_place(other : self) : Nil
    merge_where_fields_from(other)
  end

  protected def merge_where_fields_from(other : Other) : Nil forall Other
    incoming = other.where_fields
    return nil if incoming.empty?
    if incoming.all? { |clause| clause[:join] == :and } && where_fields.all? { |clause| clause[:join] == :and }
      replaced = Set(String).new
      incoming.each do |clause|
        if clause.is_a?(StructuredWhere)
          replaced << clause[:field].split('.').last if clause[:operator] == :eq || clause[:operator] == :in
        else
          registered = other.raw_where_columns[clause[:stmt]]?
          replaced << registered[0] if registered && registered[1]
        end
      end
      unscope_where_columns(replaced.to_a) unless replaced.empty?
      own_where_fields.concat(incoming)
      incoming.each do |clause|
        unless clause.is_a?(StructuredWhere)
          registered = other.raw_where_columns[clause[:stmt]]?
          raw_where_columns[clause[:stmt]] = registered unless registered.nil?
        end
      end
    else
      if where_fields.any? { |clause| clause[:join] == :or }
        rendered = merged_where_group(where_fields)
        if rendered.is_a?(ErrorBase)
          self.defer(rendered)
          return nil
        end
        sql, values = rendered
        clear_where_fields
        own_where_fields << {join: :and, stmt: "(#{sql})", values: values}
      end
      rendered = merged_where_group(incoming)
      if rendered.is_a?(ErrorBase)
        self.defer(rendered)
      else
        sql, values = rendered
        own_where_fields << {join: :and, stmt: "(#{sql})", values: values}
      end
    end
    nil
  end

  private def merged_where_group(fields : Array(WhereField)) : Tuple(String, Array(Value)) | ErrorBase
    values = [] of Value
    renderer = PredicateRenderer.new(Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, join_clauses)
    renderer.rendering_where_group = true
    sql = renderer.render_where_fields(fields)!
    {sql, values}
  end

  protected def merge_order_from(other : Other) : Nil forall Other
    if other.reordering?
      clear_order_fields
      self.reordering = true
    end
    other.order_fields.each do |term|
      own_order_fields << term unless order_fields.any? { |existing| existing.to_s == term.to_s }
    end
    nil
  end

  def merge(other : self) : self
    chain_copy.merge_in_place(other)
  end

  def merge_in_place(other : self) : self
    merge_unscopes_in_place(other)
    merge_from_and_with_in_place(other)
    reset_load_state
    merge_where_fields_in_place(other)
    merge_order_from(other)
    other.group_fields.each do |field|
      own_group_fields << field unless group_fields.any? { |existing| existing.to_s == field.to_s }
    end
    columns = other.select_columns
    unless columns.nil?
      current = select_columns
      self.select_columns = current.nil? ? columns.dup : (current + columns).uniq
    end
    incoming_limit = other.limit
    limit_in_place(incoming_limit) unless incoming_limit.nil?
    incoming_offset = other.offset
    offset_in_place(incoming_offset) unless incoming_offset.nil?
    incoming_lock = other.lock_mode
    lock_in_place(incoming_lock) unless incoming_lock.nil?
    incoming_clause = other.lock_clause
    lock_in_place(incoming_clause) unless incoming_clause.nil?
    other.join_clauses.each do |clause|
      own_join_clauses << clause unless join_clauses.any? { |existing| existing.to_s == clause.to_s }
    end
    distinct_in_place if other.distinct?
    own_having_clauses.concat(other.having_clauses)
    none_in_place if other.is_none?
    readonly_in_place if other.readonly?
    strict_loading_in_place if other.strict_loading?
    self
  end
end
