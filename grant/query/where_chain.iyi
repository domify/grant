module grant/query/where_chain

import grant/query/builder
pub import grant/query/where_chain_methods

# The no-argument where reader keeps the upstream wrapper's public type.
# iyi closes method sets, so its declared methods forward explicitly.
pub class WhereChain(Model)
  def initialize(@query : ::Grant::Query::Builder::Builder(Model))
  end

  {% for name in [:not_in, :like, :not_like, :gt, :lt, :gteq, :lteq, :not, :between, :array_contains, :array_overlaps, :json_contains, :json_has_key] %}
    def {{ name.id }}(field : Symbol | String, value : T) : ::Grant::Query::Builder::Builder(Model) forall T
      @query.{{ name.id }}(field, value)
    end
  {% end %}

  {% for name in [:is_null, :is_not_null] %}
    def {{ name.id }}(field : Symbol | String) : ::Grant::Query::Builder::Builder(Model)
      @query.{{ name.id }}(field)
    end
  {% end %}

  {% for name in [:exists, :not_exists] %}
    def {{ name.id }}(query : ::Grant::Query::Builder::Builder(T)) : ::Grant::Query::Builder::Builder(Model) forall T
      @query.{{ name.id }}(query)
    end
  {% end %}

  def not(**matches) : ::Grant::Query::Builder::Builder(Model)
    @query.not(**matches)
  end

  def not(& : ::Grant::Query::Builder::Builder(Model) -> ::Grant::Query::Builder::Builder(Model)) : ::Grant::Query::Builder::Builder(Model)
    @query.not { |query| yield query }
  end

  def any(field : Symbol | String, value : T) : ::Grant::Query::Builder::Builder(Model) forall T
    @query.array_any(field, value)
  end

  def json_path(field : Symbol | String, path : String | Array(String), value : T) : ::Grant::Query::Builder::Builder(Model) forall T
    @query.json_path(field, path, value)
  end

  def associated(*names : Symbol) : ::Grant::Query::Builder::Builder(Model)
    @query.where_associated(names.to_a)
  end

  def missing(*names : Symbol) : ::Grant::Query::Builder::Builder(Model)
    @query.where_missing(names.to_a)
  end

  def has(*names : Symbol) : ::Grant::Query::Builder::Builder(Model)
    associated(*names)
  end

  def has(association : Symbol, *, table : String, foreign_key : String, primary_key : String = "id") : ::Grant::Query::Builder::Builder(Model)
    @query.joins(table, on: "#{table}.#{foreign_key} = #{Model.table_name}.#{primary_key}")
      .and_where("#{table}.#{foreign_key} IS NOT NULL")
  end

  def missing(association : Symbol, *, table : String, foreign_key : String, primary_key : String = "id") : ::Grant::Query::Builder::Builder(Model)
    @query.left_joins(table, on: "#{table}.#{foreign_key} = #{Model.table_name}.#{primary_key}")
      .and_where("#{table}.#{foreign_key} IS NULL")
  end

  def select(*columns : Symbol | String) : ::Grant::Query::Builder::Builder(Model)
    @query.select(*columns)
  end

  def select : Array(Model) | ::Grant::Error::ErrorBase
    @query.select
  end

  def raw_sql : String
    @query.raw_sql
  end
end
