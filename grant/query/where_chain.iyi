module grant/query/where_chain

# Native trait slice of upstream WhereChain(Model). The existing no-argument
# where surface returns Builder, so chain methods apply to that relation.
pub trait WhereChainMethods(Model)
  def not(field : Symbol | String, value : T) : self forall T
    and_where(field, :neq, value)
  end

  def not(**matches) : self
    where_not(matches)
  end

  def gteq(field : Symbol | String, value : T) : self forall T
    and_where(field, :gteq, value)
  end
end
