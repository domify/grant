module grant/query/aggregations

import grant/adapter/driver::{Value}
import std/big::{BigDecimal}
import std/text
import grant/errors::{DatabaseError, ErrorBase}

pub enum Calculation
  Count
  Sum
  Average
  Minimum
  Maximum

  def self.from_symbol(name : Symbol) : Calculation | ::Grant::Error::ArgumentError
    case name
    when :count then Count
    when :sum then Sum
    when :average, :avg then Average
    when :minimum, :min then Minimum
    when :maximum, :max then Maximum
    else
      ::Grant::Error::ArgumentError.new(
        "Unknown calculation :#{name}; use :count, :sum, :average, :minimum or :maximum")
    end
  end
end

pub alias CalculationResult = BigDecimal | Value | Hash(Value, Value) | Hash(Array(Value), Value) | Int64 | Hash(Value, Int64) | Hash(Array(Value), Int64)

# Structural SQLite slice of the upstream Builder reopening. Database values
# stay integers for integer SUMs; AVG is returned by SQLite as Float64.
pub trait Aggregations(Model)
  def calculate(operation : Calculation | Symbol, column : Symbol | String? = nil) : CalculationResult | ErrorBase
    calculation = operation.is_a?(Symbol) ? Calculation.from_symbol(operation)! : operation
    return column.nil? ? count : count(column) if calculation == Calculation::Count
    return ::Grant::Error::ArgumentError.new("calculate(#{calculation.to_s.downcase}) needs a column") if column.nil?
    case calculation
    when Calculation::Sum then sum(column)
    when Calculation::Average then avg(column)
    when Calculation::Minimum then min(column)
    else max(column)
    end
  end

  def sum(&block : Model -> T) : T | ErrorBase forall T
    records!.sum_by { |record| yield record }
  end

  def max_of(&block : Model -> T) : T | ErrorBase forall T
    values = records!.map { |record| yield record }
    raise "Empty enumerable" if values.empty?
    largest = values.first
    values.each { |value| largest = value if value > largest }
    largest
  end

  def count(&block : Model -> Bool) : Int32 | ErrorBase
    records!.count { |record| yield record }
  end

  def count(column : Symbol | String, distinct : Bool = false) : Int64 | Hash(Value, Int64) | Hash(Array(Value), Int64) | ErrorBase
    name = column.to_s
    return count if (name == "all" || name == "*") && !distinct
    name = "*" if name == "all"
    distinct = distinct || distinct?
    if name == "*" && distinct
      return ::Grant::Error::ArgumentError.new("count(distinct: true) needs a column")
    end
    return group_fields.empty? ? 0_i64 : empty_group_count if is_none?
    rows = aggregate_rows("COUNT", distinct ? "DISTINCT #{name}" : name)!
    return rows.first[1].as(Int64) if group_fields.empty?
    grouped_values(rows, Int64) { |value| value.is_a?(Int64) ? value : 0_i64 }
  end

  def sum(column : Symbol | String)
    rows = aggregate_rows("SUM", column.to_s)!
    if group_fields.empty?
      value = rows.first[1]
      {% if Model.instance_vars.any? { |v| v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:type].includes?("BigDecimal") } %}
        if (Model.type_for_attribute(column) || "").includes?("BigDecimal")
          return BigDecimal.new(value.nil? ? "0" : value.to_s)
        end
      {% end %}
      value.nil? ? 0_i64 : value
    else
      grouped_values(rows, Value) { |value| value.nil? ? 0_i64 : value }
    end
  end

  def sum(column : Symbol | String, as numeric_type : T.class) : T | ErrorBase forall T
    return ::Grant::Error::ArgumentError.new("sum(as:) returns one value; use sum(column) on a grouped relation") unless group_fields.empty?
    value = sum(column)!
    {% if T == Int64 %}
      text = value.to_s
      integer = text.to_i64?
      return integer unless integer.nil?
      decimal = BigDecimal.new(text)
      whole = decimal.to_big_i
      exact = whole.to_i64?
      return ::Grant::Error::ArgumentError.new("#{text} does not fit Int64 exactly") if exact.nil? || decimal != BigDecimal.new(whole)
      exact
    {% elsif T == Float64 %}
      value.to_s.to_f
    {% elsif T == BigDecimal %}
      BigDecimal.new(value.to_s)
    {% else %}
      {% raise "sum(as:) takes Int64, Float64 or BigDecimal, not #{T}" %}
    {% end %}
  end

  def avg(column : Symbol | String)
    rows = aggregate_rows("AVG", column.to_s)!
    if group_fields.empty?
      rows.first[1]
    else
      grouped_values(rows, Value) { |value| value }
    end
  end

  def average(column : Symbol | String)
    avg(column)
  end

  def min(column : Symbol | String)
    extremum("MIN", column.to_s)
  end

  def minimum(column : Symbol | String)
    min(column)
  end

  def max(column : Symbol | String)
    extremum("MAX", column.to_s)
  end

  def maximum(column : Symbol | String)
    max(column)
  end

  private def extremum(function : String, column : String)
    rows = aggregate_rows(function, column)!
    if group_fields.empty?
      rows.first[1]
    else
      grouped_values(rows, Value) { |value| value }
    end
  end

  private def grouped_values(rows : Array(Tuple(Array(Value), Value)), type : V.class, &block : Value -> V) forall V
    if group_fields.size == 1
      result = {} of Value => V
      rows.each { |row| result[row[0].first] = yield row[1] }
      result
    else
      result = {} of Array(Value) => V
      rows.each { |row| result[row[0]] = yield row[1] }
      result
    end
  end
end
