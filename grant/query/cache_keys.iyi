module grant/query/cache_keys

import std/digest::{MD5}
import grant/errors::{ErrorBase}
import grant/query/executor
import grant/columns_helpers
import grant/integration

# The cache-key section of upstream query/builder.cr and integration.cr.
pub trait CacheKeys(Model)
  def cache_key : String | ErrorBase
    statement = prepared { |query| query.select }!
    digest = MD5.hexdigest("#{statement.raw_sql}|#{statement.args.inspect}")
    "#{Model.table_name}/query-#{digest}"
  end

  def cache_version : String | ErrorBase
    memoized = cached_cache_version
    return memoized unless memoized.nil?
    if is_none?
      self.cached_cache_version = "0"
      return "0"
    end
    inner = chain_copy
    inner.clear_order_fields
    statement = inner.prepared { |query| query.select }!
    has_updated_at = Model.fields.includes?("updated_at")
    newest = has_updated_at ? ", MAX(#{Model.quote("updated_at")})" : ""
    sql = "SELECT COUNT(*)#{newest} FROM (#{statement.raw_sql}) AS grant_cache_version"
    rows = ::Grant::Query::Executor.open_statement(Model.adapter, sql, statement.args) do |db|
      db.query(sql, statement.args)
    end!
    values = rows.first.values
    count = values[0].as(Int64)
    newest_value = has_updated_at ? values[1] : nil
    stamp = case newest_value
    when ::Std::Time::Time
      ::Grant::Integration.version_stamp(newest_value)
    when String
      ::Grant::Integration.version_stamp(::Grant::ColumnsHelpers.time_from_db(newest_value))
    else
      ""
    end
    version = stamp.empty? ? count.to_s : "#{count}-#{stamp}"
    self.cached_cache_version = version
    version
  end

  def collection_cache_key : String | ErrorBase
    "#{cache_key!}-#{cache_version!}"
  end
end
