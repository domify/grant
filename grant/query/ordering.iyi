module grant/query/ordering

import std/text
import grant/query/sql_expression
import grant/query/join_support::{JoinSupport}
import grant/query/where_field::{OrderField, Sort}
import grant/sanitization
import grant/error::{ErrorBase, ArgumentError}

# Structural OrderSupport slice from query/ordering.cr.
pub class OrderSupport
  IN_ORDER_OF_LIMIT = 1000

  def self.sort_for(direction : String?, nulls : String?) : Sort
    descending = direction == "desc"
    case nulls
    when "first" then descending ? Sort::DescendingNullsFirst : Sort::AscendingNullsFirst
    when "last" then descending ? Sort::DescendingNullsLast : Sort::AscendingNullsLast
    else descending ? Sort::Descending : Sort::Ascending
    end
  end

  def self.reverse(term : OrderField) : OrderField
    return {field: term[:field], direction: term[:direction].reverse} unless term[:direction] == Sort::Raw
    sql = term[:field].strip
    words = sql.split(' ')
    placement = ""
    if words.size >= 3 && words[words.size - 2].downcase == "nulls"
      placement = words.last.downcase == "first" ? " NULLS LAST" : " NULLS FIRST"
      words.pop
      words.pop
    end
    direction = words.last.downcase
    if direction == "asc" || direction == "desc"
      words.pop
      sql = "#{words.join(" ")} #{direction == "asc" ? "DESC" : "ASC"}#{placement}"
    else
      sql = "#{sql} DESC"
    end
    {field: sql, direction: Sort::Raw}
  end
end

pub trait Ordering(Model)
  def order(field : Symbol | String, direction : Symbol, *, nulls : Symbol) : self
    chain_copy.order_in_place(field, direction, nulls: nulls)
  end

  def order_in_place(field : Symbol | String, direction : Symbol, *, nulls : Symbol) : self
    return self.defer(ArgumentError.new("nulls must be :first or :last")) unless nulls == :first || nulls == :last
    own_order_fields << {field: field.to_s, direction: OrderSupport.sort_for(direction.to_s, nulls.to_s)}
    self
  end

  private def append_order_terms(sql : String, trusted : Bool) : self
    ::Grant::Query::SqlExpression.split_terms(sql).each do |term|
      validated = ::Grant::Query::SqlExpression.validate_strict(term, "ORDER BY expression")
      return self.defer(validated) if validated.is_a?(ErrorBase)
      words = term.split(' ').reject(&.empty?)
      placement : String? = nil
      if words.size >= 3 && words[words.size - 2].downcase == "nulls"
        placement = words.pop.downcase
        words.pop
      end
      direction : String? = nil
      if words.size >= 2 && (words.last.downcase == "asc" || words.last.downcase == "desc")
        direction = words.pop.downcase
      end
      if words.size == 1 && ::Grant::Query::SqlExpression.identifier?(words.first)
        own_order_fields << {field: words.first, direction: OrderSupport.sort_for(direction, placement)}
      else
        unless trusted || ::Grant::Query::SqlExpression.column_function?(term)
          return self.defer(ArgumentError.new("ORDER BY #{term.inspect} is not a column or a function of columns; wrap SQL you wrote in Grant.sql(...)"))
        end
        own_order_fields << {field: term, direction: Sort::Raw}
      end
    end
    self
  end

  def in_order_of(column : Symbol | String, values : Array(T), filter : Bool = true) : self forall T
    chain_copy.in_order_of_in_place(column, values, filter)
  end

  def in_order_of_in_place(column : Symbol | String, values : Array(T), filter : Bool = true) : self forall T
    name = column.to_s
    parts = name.split('.')
    unless (parts.size == 1 || parts.size == 2) && parts.all? { |part| JoinSupport.identifier?(part) }
      return self.defer(ArgumentError.new("in_order_of takes a column name (got #{name.inspect})"))
    end
    if values.size > OrderSupport::IN_ORDER_OF_LIMIT
      return self.defer(ArgumentError.new("in_order_of takes at most 1000 values (got #{values.size})"))
    end
    return none_in_place if values.empty?
    and_in_in_place(name, values) if filter
    qualified = parts.size == 2 ? "#{Model.quote(parts[0])}.#{Model.quote(parts[1])}" : "#{Model.quote(Model.table_name)}.#{Model.quote(name)}"
    arms = [] of String
    values.each_with_index do |value, position|
      if value.nil?
        arms << " WHEN #{qualified} IS NULL THEN #{position}"
      else
        literal = order_literal(value)
        return self.defer(literal) if literal.is_a?(ErrorBase)
        arms << " WHEN #{qualified} = #{literal} THEN #{position}"
      end
    end
    own_order_fields << {field: "CASE#{arms.join} ELSE #{values.size} END", direction: Sort::Raw}
    self
  end

  private def order_literal(value : T) : String | ErrorBase forall T
    if value.is_a?(String)
      escaped = value.gsub("\0", "").gsub("'", "''")
      if Model.adapter.postgres?
        "E'#{escaped.gsub("\\", "\\\\")}'"
      else
        "'#{escaped}'"
      end
    else
      ::Grant::Sanitization.quote(value, Model.adapter)
    end
  end
end

pub macro model_methods(model)
  def self.in_order_of(column : Symbol | String, values : Array(T), filter : Bool = true) : ::Grant::Query::Builder::Builder({{ model }}) forall T
    current_scope.in_order_of(column, values, filter)
  end
end
