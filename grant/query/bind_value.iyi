module grant/query/bind_value

import std/time::{Time}
import grant/adapter/driver::{Value}
import grant/query/where_field::{Bind}

# Grant::Columns::Type values arrive in many Crystal types; the native
# drivers bind the five of Value. These overloads narrow a condition value
# the way the model's own writes do (grant/base sqlite_value).
pub def to_bind(value : Value) : Bind
  value
end

pub def to_bind(value : Int32) : Bind
  value.to_i64
end

pub def to_bind(value : Int8) : Bind
  value.to_i64
end

pub def to_bind(value : Int16) : Bind
  value.to_i64
end

pub def to_bind(value : UInt32) : Bind
  value.to_i64
end

pub def to_bind(value : Float32) : Bind
  value.to_f64
end

pub def to_bind(value : Symbol) : Bind
  value.to_s
end

pub def to_bind(value : Time) : Bind
  value.to_rfc3339(9)
end

pub def to_bind(value : Array(T)) : Bind forall T
  values = [] of Value
  value.each { |item| values << to_value(item) }
  values
end

pub def to_value(value : T) : Value forall T
  bound = to_bind(value)
  bound.is_a?(Array) ? nil : bound
end

pub def to_bind(value : ::Enum) : Bind
  value.to_s
end
