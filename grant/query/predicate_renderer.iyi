module grant/query/predicate_renderer

import std/text
import grant/adapter/driver::{Value}
import grant/error::{ArgumentError, ErrorBase}
import grant/encryption/encrypted_attribute::{EncryptedAttributeRegistry}
import grant/encryption/query_extensions::{QueryValue}
import grant/query/where_field::{Bind, WhereField, StructuredWhere, RawWhere, RawWhereValues, JoinClause}
import grant/query/join_support::{JoinSupport}

# Native counterpart of Grant::Query::Assembler::PredicateRenderer
# (crystal-upstream/src/grant/query/assembler/predicate_renderer.cr). Where
# upstream raises ArgumentError while rendering, the renderer returns it.
pub class PredicateRenderer
  OPERATORS = {"eq" => "=", "gteq" => ">=", "lteq" => "<=", "neq" => "!=", "ltgt" => "<>", "gt" => ">", "lt" => "<", "ngt" => "!>", "nlt" => "!<", "in" => "IN", "nin" => "NOT IN", "like" => "LIKE", "nlike" => "NOT LIKE"}

  ENCRYPTED_QUERY_OPERATORS = [:eq, :neq, :ltgt, :in, :nin]

  pub alias BindParameter = Proc(Value, String)
  pub alias RecordField = Proc(String, Nil)
  pub alias QuoteIdentifier = Proc(String, String)

  property rendering_where_group : Bool = false
  property join_clauses : Array(JoinClause)

  def initialize(@model_name : String, @table_name : String, @fields : Array(String),
                 @quote_identifier : QuoteIdentifier, @bind_parameter : BindParameter,
                 @record_field : RecordField, @join_clauses : Array(JoinClause))
  end

  def self.sql_operator(operator : Symbol) : String
    OPERATORS[operator.to_s]? || operator.to_s
  end

  def sql_operator(operator : Symbol) : String
    PredicateRenderer.sql_operator(operator)
  end

  def render_where_fields(fields : Array(WhereField)) : String | ErrorBase
    sql = String::Builder.new
    fields.each_with_index do |expression, index|
      sql << " #{expression[:join].to_s.upcase} " unless index == 0
      case expression
      when RawWhereValues
        sql << bind_raw_statement(expression[:stmt], expression[:values])!
      when RawWhere
        value = expression[:value]
        values = [] of Value
        if value.is_a?(Array)
          value.each { |item| values << item }
        elsif !value.nil?
          values << value
        end
        sql << bind_raw_statement(expression[:stmt], values)!
      when StructuredWhere
        field = structured_field_sql(expression[:field])!
        @record_field.call(field)
        operator = expression[:operator]
        value = encrypted_query_value(expression[:field], operator, expression[:value])!
        if value.nil?
          case operator
          when :eq
            sql << "#{field} IS NULL"
          when :neq, :ltgt
            sql << "#{field} IS NOT NULL"
          else
            return ArgumentError.new("Operator #{operator.inspect} does not support nil values")
          end
        elsif value.is_a?(Array)
          if value.empty?
            sql << (operator == :nin ? "1=1" : "1=0")
          else
            operator = :in if operator == :eq
            operator = :nin if operator == :neq || operator == :ltgt
            placeholders = value.map { |item| @bind_parameter.call(item) }
            sql << "#{field} #{sql_operator(operator)} (#{placeholders.join(",")})"
          end
        else
          sql << "#{field} #{sql_operator(operator)} #{@bind_parameter.call(value)}"
        end
      end
    end
    sql.to_s
  end

  private def encrypted_query_value(field : String, operator : Symbol, value : Bind) : Bind | ErrorBase
    parts = field.split('.')
    return value unless parts.size == 1 || parts.first == @table_name
    attribute_name = parts.last
    attribute = EncryptedAttributeRegistry.lookup(@model_name, attribute_name)
    return value unless attribute
    unless attribute.deterministic
      return ArgumentError.new("Cannot query non-deterministic encrypted field: #{attribute_name}")
    end
    unless ENCRYPTED_QUERY_OPERATORS.includes?(operator)
      return ArgumentError.new("Encrypted field #{attribute_name.inspect} supports only equality and IN comparisons, not #{operator.inspect}")
    end
    QueryValue.rewrite(attribute, value)
  end

  def structured_field_sql(field : String) : String | ArgumentError
    parts = field.split('.')
    unless (parts.size == 1 || parts.size == 2) && parts.all? { |part| JoinSupport.identifier?(part) }
      return ArgumentError.new("Invalid query field #{field.inspect}")
    end
    column = parts.last
    qualifier = parts.size == 2 ? parts.first : nil
    valid_column = if qualifier.nil? || qualifier == @table_name
                     @fields.includes?(column)
                   elsif JoinSupport.joins?(@join_clauses, qualifier)
                     true
                   else
                     @rendering_where_group
                   end
    unless valid_column
      return ArgumentError.new("Unknown query field #{field.inspect} for #{@model_name}")
    end
    if !qualifier.nil?
      "#{@quote_identifier.call(qualifier)}.#{@quote_identifier.call(column)}"
    elsif !@join_clauses.empty? || @rendering_where_group
      "#{@quote_identifier.call(@table_name)}.#{@quote_identifier.call(column)}"
    else
      @quote_identifier.call(column)
    end
  end

  # Replaces each `?` (or `$n`) of *statement* outside quotes and comments
  # with the adapter's parameter for the matching bind value.
  def bind_raw_statement(statement : String, values : Array(Value)) : String | ArgumentError
    output = String::Builder.new
    bytes = statement.bytes
    dollar_tokens = {} of Int32 => String
    dollar_indices = [] of Int32
    question_count = 0
    dollar_style = false
    index = 0
    quote = 0_u8
    while index < bytes.size
      byte = bytes[index]
      if quote != 0_u8
        output << byte.chr
        if byte == quote
          if index + 1 < bytes.size && bytes[index + 1] == quote
            output << bytes[index + 1].chr
            index += 1
          else
            quote = 0_u8
          end
        elsif byte == 92_u8 && index + 1 < bytes.size
          output << bytes[index + 1].chr
          index += 1
        end
      elsif byte == 39_u8 || byte == 34_u8
        quote = byte
        output << byte.chr
      elsif byte == 45_u8 && index + 1 < bytes.size && bytes[index + 1] == 45_u8
        output << "--"
        index += 1
        while index + 1 < bytes.size && bytes[index + 1] != 10_u8
          output << bytes[index + 1].chr
          index += 1
        end
      elsif byte == 47_u8 && index + 1 < bytes.size && bytes[index + 1] == 42_u8
        output << "/*"
        index += 1
        while index + 1 < bytes.size
          index += 1
          output << bytes[index].chr
          break if bytes[index - 1] == 42_u8 && bytes[index] == 47_u8
        end
      elsif byte == 63_u8 && index + 1 < bytes.size && bytes[index + 1] == 63_u8
        output << '?'
        index += 1
      elsif byte == 63_u8
        return ArgumentError.new("Do not mix ? and numbered placeholders in one query clause") if dollar_style
        return ArgumentError.new("Raw query placeholder count does not match bind values") if question_count >= values.size
        output << @bind_parameter.call(values[question_count])
        question_count += 1
      elsif byte == 36_u8 && index + 1 < bytes.size && digit?(bytes[index + 1])
        return ArgumentError.new("Do not mix ? and numbered placeholders in one query clause") if question_count > 0
        dollar_style = true
        number_end = index + 1
        while number_end < bytes.size && digit?(bytes[number_end])
          number_end += 1
        end
        parameter_index = statement[index + 1, number_end - index - 1].to_i
        unless parameter_index >= 1 && parameter_index <= values.size
          return ArgumentError.new("Raw query placeholder count does not match bind values")
        end
        dollar_indices << parameter_index unless dollar_indices.includes?(parameter_index)
        token = dollar_tokens[parameter_index]?
        if token.nil?
          token = @bind_parameter.call(values[parameter_index - 1])
          dollar_tokens[parameter_index] = token
        end
        output << token
        index = number_end - 1
      else
        # Multi-byte characters pass through byte by byte.
        output.write_byte(byte)
      end
      index += 1
    end
    if dollar_style
      unless dollar_indices.size == values.size
        return ArgumentError.new("Raw query placeholder count does not match bind values")
      end
    elsif question_count != values.size
      return ArgumentError.new("Raw query placeholder count does not match bind values")
    end
    output.to_s
  end

  private def digit?(byte : UInt8) : Bool
    byte >= 48_u8 && byte <= 57_u8
  end
end
