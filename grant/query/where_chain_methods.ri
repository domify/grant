module grant/query/where_chain_methods

import grant/adapter/driver
import grant/error
import grant/query/predicate_renderer

# Builder retains these methods for chaining after a WhereChain predicate.
# The structural WhereChain below delegates to the same predicate implementations.
pub trait WhereChainMethods(Model)
  {% for entry in [{:not_in, :nin}, {:like, :like}, {:not_like, :nlike}, {:gt, :gt}, {:lt, :lt}, {:lteq, :lteq}] %}
    def {{ entry[0].id }}(field : Symbol | String, value : T) : self forall T
      and_where(field, {{ entry[1] }}, value)
    end
  {% end %}

  def is_null(field : Symbol | String) : self
    and_where(field, :eq, nil)
  end

  def is_not_null(field : Symbol | String) : self
    and_where(field, :neq, nil)
  end

  def exists(query : T) : self forall T
    parts = query.subquery_parts
    copy = chain_copy
    return copy.defer_subquery_error(parts) if parts.is_a?(::Grant::Error::ErrorBase)
    statement, values = parts
    copy.own_where_fields << {join: :and, stmt: "EXISTS (#{statement})", values: values}
    copy
  end

  def not_exists(query : T) : self forall T
    parts = query.subquery_parts
    copy = chain_copy
    return copy.defer_subquery_error(parts) if parts.is_a?(::Grant::Error::ErrorBase)
    statement, values = parts
    copy.own_where_fields << {join: :and, stmt: "NOT EXISTS (#{statement})", values: values}
    copy
  end

  def between(field : Symbol | String, range : Range(B, E)) : self forall B, E
    copy = chain_copy
    copy = copy.and_where(field, :gteq, range.begin) unless range.begin.nil?
    copy = copy.and_where(field, range.exclusive? ? :lt : :lteq, range.end) unless range.end.nil?
    copy
  end

  def not(field : Symbol | String, value : T) : self forall T
    and_where(field, :neq, value)
  end

  def not(**matches) : self
    where_not(matches)
  end

  def not(&block : self -> self) : self
    chain_copy.not_in_place { |query| yield query }
  end

  def not_in_place(&block : self -> self) : self
    reset_load_state
    query = chain_copy
    query.clear_where_fields
    query.clear_default_scope_where_fields
    query = yield query
    unless query.where_fields.empty?
      values = [] of ::Grant::Adapter::Driver::Value
      renderer = ::Grant::Query::PredicateRenderer::PredicateRenderer.new(
        Model.to_s, Model.table_name, Model.fields,
        ->(name : String) { Model.quote(name) },
        ->(value : ::Grant::Adapter::Driver::Value) { values << value; "?" },
        ->(name : String) { nil }, query.join_clauses)
      renderer.rendering_where_group = true
      rendered = renderer.render_where_fields(query.where_fields)
      if rendered.is_a?(::Grant::Error::ErrorBase)
        self.defer(rendered)
      else
        own_where_fields << {join: :and, stmt: "NOT (#{rendered})", values: values}
      end
    end
    self
  end

  def gteq(field : Symbol | String, value : T) : self forall T
    and_where(field, :gteq, value)
  end
end
