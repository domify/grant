module grant/query/grouping

import grant/query/sql_expression::{validate_strict}

# Native trait retains the upstream Builder reopening without an import cycle.
pub trait Grouping(Model)
  def group_in_place(*fields : Symbol) : self
    fields.each { |field| group_by_in_place(field) }
    self
  end

  def group_in_place(*expressions : String) : self
    expressions.each { |expression| group_by_in_place(expression) }
    self
  end

  def group_records(*expressions : String) : self
    chain_copy.group_in_place(*expressions)
  end

  def group_records(*fields : Symbol) : self
    chain_copy.group_in_place(*fields)
  end

  def group_records(fields : Array(Symbol)) : self
    copied = chain_copy
    fields.each { |field| copied.group_by_in_place(field) }
    copied
  end
end

pub macro model_methods(model)
  def self.group_records(*expressions : String) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.group_records(*expressions)
  end

  def self.group_by(fields : Array(Symbol)) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.group_by(fields)
  end

  def self.group_records(*fields : Symbol) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.group_records(*fields)
  end
end
