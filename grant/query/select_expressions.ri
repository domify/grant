module grant/query/select_expressions
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}

pub class TypeCastError < ErrorBase
end

# Computed-column readers from src/grant/query/select_expressions.cr.
pub trait SelectExtras
  def extra_attribute(name : Symbol) : Value
    extra_attributes[name.to_s]?
  end

  def extra_attribute(name : String | Symbol, type : T.class) : T | TypeCastError forall T
    value = extra_attributes[name.to_s]?
    return value if value.is_a?(T)
    TypeCastError.new("Extra attribute #{name.to_s.inspect} is #{value.class}, not #{T}")
  end

  def store_extra_attribute(name : String, value : Value) : Nil
    extra_attributes[name] = value
    nil
  end
end
