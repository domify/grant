module grant/query/finders

import grant/query/builder::{Builder}
import grant/query/bind_value
import grant/error::{ErrorBase}
import grant/querying::{NotFound}
import grant/adapter/driver::{Value}

pub trait Finders(Model)
  def find_by(criteria : Hash(K, V)) : Model | Nil | ErrorBase forall K, V
    chain_copy.where_in_place(criteria).first
  end

  def find_by_strict(criteria : Hash(K, V)) : Model | ErrorBase forall K, V
    record = find_by(criteria)!
    if record.nil?
      parts = [] of String
      criteria.each do |key, value|
        parts << (value.nil? ? "#{key} is NULL" : "#{key} = #{value}")
      end
      return NotFound.new("No #{Model} found where #{parts.join(" and ")}")
    end
    record
  end

  def find_sole_by(**criteria) : Model | ErrorBase
    chain_copy.where_in_place(**criteria).sole
  end

  def find_sole_by(criteria : Hash(K, V)) : Model | ErrorBase forall K, V
    chain_copy.where_in_place(criteria).sole
  end

  def find(id : T) : Model | Nil | ErrorBase forall T
    chain_copy.where_in_place(Model.primary_name, :eq, id).first
  end

  def find(ids : Array(T)) : Array(Model) | ErrorBase forall T
    found_records_by_key(ids)![0]
  end

  def find(first : A, second : B, *rest) : Array(Model) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find(ids)
  end

  def find_strict(id : T) : Model | ErrorBase forall T
    found = find(id)!
    return NotFound.new("Couldn't find #{Model} with '#{Model.primary_name}'=#{id}") if found.nil?
    found
  end

  def find_strict(ids : Array(T)) : Array(Model) | ErrorBase forall T
    records, missing = found_records_by_key(ids)!
    unless missing.empty?
      return NotFound.new("Couldn't find all #{Model} with '#{Model.primary_name}': (#{ids.join(", ")}) (found #{records.size} results, but was looking for #{ids.size}; missing: #{missing.join(", ")})")
    end
    records
  end

  def find_strict(first : A, second : B, *rest) : Array(Model) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find_strict(ids)
  end

  private def found_records_by_key(ids : Array(T)) : Tuple(Array(Model), Array(String)) | ErrorBase forall T
    return {[] of Model, [] of String} if ids.empty?
    by_key = {} of String => Model
    chain_copy.where_in_place({Model.primary_name => ids}).select!.each do |record|
      by_key[record.__primary_value.to_s] = record
    end
    ordered = [] of Model
    missing = [] of String
    ids.each do |id|
      if record = by_key[id.to_s]?
        ordered << record
      else
        missing << id.to_s
      end
    end
    {ordered, missing}
  end
end

impl Finders(Model) for Builder(Model) forall Model

end
