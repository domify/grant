module grant/query/finders

import grant/query/builder::{Builder}
import grant/columns::{Type}
import grant/errors::{RecordNotSaved}
import grant/error_taxonomy::{RecordNotUnique}
import grant/query/where_field::{StructuredWhere}
import std/text
import grant/query/bind_value
import grant/error::{ErrorBase}
import grant/querying::{NotFound}
import grant/adapter/driver::{Value}

pub trait Finders(Model)
  def create_with(**attrs) : self
    create_with(attrs.to_h)
  end

  def create_with(attrs : Hash(K, V)) : self forall K, V
    chain_copy.create_with_in_place(attrs)
  end

  def create_with_in_place(attrs : Hash(K, V)) : self forall K, V
    if attrs.empty?
      clear_create_with_defaults
    else
      incoming = {} of String => Type
      attrs.each { |key, value| incoming[key.to_s] = value }
      adopt_create_with_defaults(incoming)
    end
    self
  end


  def scope_attributes : Hash(String, Type)
    attrs = {} of String => Type
    collect_equality_attributes(default_scope_where_fields, attrs)
    collect_equality_attributes(where_fields, attrs)
    attrs
  end

  private def collect_equality_attributes(fields, attrs : Hash(String, Type)) : Nil
    fields.each do |condition|
      next unless condition.is_a?(StructuredWhere)
      next unless condition[:join] == :and && condition[:operator] == :eq
      value = condition[:value]
      next if value.nil? || !value.is_a?(Type)
      field = condition[:field].gsub("\"", "").gsub("`", "")
      parts = field.split(".")
      next if parts.size > 1 && parts[0] != Model.table_name
      column = parts.last
      attrs[column] = value if Model.fields.includes?(column)
    end
    nil
  end

  private def attributes_for_new_record : Hash(String, Type)
    attrs = scope_attributes
    create_with_attributes.each { |key, value| attrs[key] = value }
    attrs
  end

  def build(**attrs) : Model | ErrorBase
    build(attrs.to_h)
  end

  def build(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    build(attrs.to_h) { |record| yield record }
  end

  def build(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    build(attrs) { |record| nil }
  end

  def build(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    merged = attributes_for_new_record
    attrs.each { |key, value| merged[key.to_s] = value }
    Model.new(merged) { |record| yield record }
  end

  def create(**attrs) : Model | ErrorBase
    create(attrs.to_h)
  end

  def create(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    create(attrs.to_h) { |record| yield record }
  end

  def create(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    create(attrs) { |record| nil }
  end

  def create(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    record = build(attrs) { |built| yield built }!
    record.save
    record
  end

  def create_strict(**attrs) : Model | ErrorBase
    create_strict(attrs.to_h)
  end

  def create_strict(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    create_strict(attrs.to_h) { |record| yield record }
  end

  def create_strict(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    create_strict(attrs) { |record| nil }
  end

  def create_strict(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    record = build(attrs) { |built| yield built }!
    record.save_strict!
    record
  end

  def find_or_create_by(**attrs) : Model | ErrorBase
    find_or_create_by(attrs.to_h)
  end

  def find_or_create_by(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    find_or_create_by(attrs.to_h) { |record| yield record }
  end

  def find_or_create_by(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    find_or_create_by(attrs) { |record| nil }
  end

  def find_or_create_by(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = find_by(attrs)!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record.save
    record
  end

  def find_or_create_by_strict(**attrs) : Model | ErrorBase
    find_or_create_by_strict(attrs.to_h)
  end

  def find_or_create_by_strict(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    find_or_create_by_strict(attrs.to_h) { |record| yield record }
  end

  def find_or_create_by_strict(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    find_or_create_by_strict(attrs) { |record| nil }
  end

  def find_or_create_by_strict(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = find_by(attrs)!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record.save_strict!
    record
  end

  def find_or_initialize_by(**attrs) : Model | ErrorBase
    find_or_initialize_by(attrs.to_h)
  end

  def find_or_initialize_by(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    find_or_initialize_by(attrs.to_h) { |record| yield record }
  end

  def find_or_initialize_by(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    find_or_initialize_by(attrs) { |record| nil }
  end

  def find_or_initialize_by(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = find_by(attrs)!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record
  end

  def first_or_create(**attrs) : Model | ErrorBase
    first_or_create(attrs.to_h)
  end

  def first_or_create(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    first_or_create(attrs.to_h) { |record| yield record }
  end

  def first_or_create(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    first_or_create(attrs) { |record| nil }
  end

  def first_or_create(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = first!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record.save
    record
  end

  def first_or_create_strict(**attrs) : Model | ErrorBase
    first_or_create_strict(attrs.to_h)
  end

  def first_or_create_strict(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    first_or_create_strict(attrs.to_h) { |record| yield record }
  end

  def first_or_create_strict(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    first_or_create_strict(attrs) { |record| nil }
  end

  def first_or_create_strict(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = first!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record.save_strict!
    record
  end

  def first_or_initialize(**attrs) : Model | ErrorBase
    first_or_initialize(attrs.to_h)
  end

  def first_or_initialize(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    first_or_initialize(attrs.to_h) { |record| yield record }
  end

  def first_or_initialize(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    first_or_initialize(attrs) { |record| nil }
  end

  def first_or_initialize(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    found = first!
    return found unless found.nil?
    record = build(attrs) { |built| yield built }!
    record
  end

  def new(**attrs) : Model | ErrorBase
    new(attrs.to_h)
  end

  def new(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    new(attrs.to_h) { |record| yield record }
  end

  def new(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    new(attrs) { |record| nil }
  end

  def new(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    merged = attributes_for_new_record
    attrs.each { |key, value| merged[key.to_s] = value }
    Model.new(merged) { |record| yield record }
  end

  def create_or_find_by(**attrs) : Model | ErrorBase
    create_or_find_by(attrs.to_h)
  end

  def create_or_find_by(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    create_or_find_by(attrs.to_h) { |record| yield record }
  end

  def create_or_find_by(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    create_or_find_by(attrs) { |record| nil }
  end

  def create_or_find_by(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    record = build(attrs) { |built| yield built }!
    saved = Model.transaction(requires_new: true) { record.save_strict }
    return record if saved == true
    if saved.is_a?(RecordNotSaved) && saved.statement_error.is_a?(RecordNotUnique)
      find_by(attrs)! || record
    else
      record
    end
  end

  def create_or_find_by_strict(**attrs) : Model | ErrorBase
    create_or_find_by_strict(attrs.to_h)
  end

  def create_or_find_by_strict(**attrs, &block : Model -> R) : Model | ErrorBase forall R
    create_or_find_by_strict(attrs.to_h) { |record| yield record }
  end

  def create_or_find_by_strict(attrs : Hash(K, V)) : Model | ErrorBase forall K, V
    create_or_find_by_strict(attrs) { |record| nil }
  end

  def create_or_find_by_strict(attrs : Hash(K, V), &block : Model -> R) : Model | ErrorBase forall K, V, R
    record = build(attrs) { |built| yield built }!
    saved = Model.transaction(requires_new: true) { record.save_strict }
    return record if saved == true
    if saved.is_a?(RecordNotSaved) && saved.statement_error.is_a?(RecordNotUnique)
      find_by_strict(attrs)
    else
      saved.is_a?(ErrorBase) ? saved : record
    end
  end

  def find_by(criteria : Hash(K, V)) : Model | Nil | ErrorBase forall K, V
    chain_copy.where_in_place(criteria).first
  end

  def find_by_strict(criteria : Hash(K, V)) : Model | ErrorBase forall K, V
    record = find_by(criteria)!
    if record.nil?
      parts = [] of String
      criteria.each do |key, value|
        parts << (value.nil? ? "#{key} is NULL" : "#{key} = #{value}")
      end
      return NotFound.new("No #{Model} found where #{parts.join(" and ")}")
    end
    record
  end

  def find_sole_by(**criteria) : Model | ErrorBase
    chain_copy.where_in_place(**criteria).sole
  end

  def find_sole_by(criteria : Hash(K, V)) : Model | ErrorBase forall K, V
    chain_copy.where_in_place(criteria).sole
  end

  def find(id : T) : Model | Nil | ErrorBase forall T
    chain_copy.where_in_place(Model.primary_name, :eq, id).first
  end

  def find(ids : Array(T)) : Array(Model) | ErrorBase forall T
    found_records_by_key(ids)![0]
  end

  def find(first : A, second : B, *rest) : Array(Model) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find(ids)
  end

  def find_strict(id : T) : Model | ErrorBase forall T
    found = find(id)!
    return NotFound.new("Couldn't find #{Model} with '#{Model.primary_name}'=#{id}") if found.nil?
    found
  end

  def find_strict(ids : Array(T)) : Array(Model) | ErrorBase forall T
    records, missing = found_records_by_key(ids)!
    unless missing.empty?
      return NotFound.new("Couldn't find all #{Model} with '#{Model.primary_name}': (#{ids.join(", ")}) (found #{records.size} results, but was looking for #{ids.size}; missing: #{missing.join(", ")})")
    end
    records
  end

  def find_strict(first : A, second : B, *rest) : Array(Model) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find_strict(ids)
  end

  private def found_records_by_key(ids : Array(T)) : Tuple(Array(Model), Array(String)) | ErrorBase forall T
    return {[] of Model, [] of String} if ids.empty?
    by_key = {} of String => Model
    chain_copy.where_in_place({Model.primary_name => ids}).select!.each do |record|
      by_key[record.__primary_value.to_s] = record
    end
    ordered = [] of Model
    missing = [] of String
    ids.each do |id|
      if record = by_key[id.to_s]?
        ordered << record
      else
        missing << id.to_s
      end
    end
    {ordered, missing}
  end
end

impl Finders(Model) for Builder(Model) forall Model

end
