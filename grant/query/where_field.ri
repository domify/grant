module grant/query/where_field

import grant/adapter/driver::{Value}

# Native counterpart of the clause types at the top of
# crystal-upstream/src/grant/query/builder.cr.
#
# Grant::Columns::Type in a WHERE clause: a scalar, or the list of an IN.
pub alias Bind = Value | Array(Value)

pub alias WhereField = NamedTuple(join: Symbol, field: String, operator: Symbol, value: Bind) |
                       NamedTuple(join: Symbol, stmt: String, value: Bind) |
                       NamedTuple(join: Symbol, stmt: String, values: Array(Value))

pub alias StructuredWhere = NamedTuple(join: Symbol, field: String, operator: Symbol, value: Bind)
pub alias RawWhere = NamedTuple(join: Symbol, stmt: String, value: Bind)
pub alias RawWhereValues = NamedTuple(join: Symbol, stmt: String, values: Array(Value))

pub alias JoinClause = NamedTuple(type: Symbol, table: String, on: String)
pub alias HavingClause = NamedTuple(stmt: String, value: Bind)

# Direction of one ORDER BY term. `Raw` marks a term whose `field` is a
# complete SQL expression (direction included) that is emitted as written.
pub enum Sort
  Ascending
  Descending
  AscendingNullsFirst
  AscendingNullsLast
  DescendingNullsFirst
  DescendingNullsLast
  Raw

  # `true` for every descending member, whatever its NULL placement.
  def sorts_descending? : Bool
    self == Descending || self == DescendingNullsFirst || self == DescendingNullsLast
  end

  # Where NULLs sort, `:first` or `:last`, or `nil` for the adapter default.
  def nulls_placement : Symbol?
    if self == AscendingNullsFirst || self == DescendingNullsFirst
      :first
    elsif self == AscendingNullsLast || self == DescendingNullsLast
      :last
    end
  end

  # The opposite direction, with NULL placement flipped the way
  # ActiveRecord's `reverse_order` does. A `Raw` term stays `Raw`.
  def reverse : Sort
    case self
    when Ascending            then Descending
    when Descending           then Ascending
    when AscendingNullsFirst  then DescendingNullsLast
    when AscendingNullsLast   then DescendingNullsFirst
    when DescendingNullsFirst then AscendingNullsLast
    when DescendingNullsLast  then AscendingNullsFirst
    else                           self
    end
  end
end

pub alias OrderField = NamedTuple(field: String, direction: Sort)
pub alias GroupField = NamedTuple(field: String)
