module grant/query/assembler

import std/text
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase, ArgumentError}
import grant/settings
import grant/query/where_field::{Bind, WhereField, JoinClause, OrderField, Sort}
import grant/query/predicate_renderer::{PredicateRenderer}
import grant/query/join_support::{JoinSupport}
import grant/query/executor

# Native counterpart of Grant::Query::Assembler::Base and its PostgreSQL and
# SQLite subclasses (crystal-upstream/src/grant/query/assemblers/*.cr). The
# assembler turns one relation into SQL plus its numbered bind values.
#
# *Query* is the relation's class: iyi modules cannot import each other in a
# cycle, so the assembler reaches the builder through its type parameter.
# A clause that upstream would raise ArgumentError for is kept in `error`
# and returned by the terminal that asked for the SQL.
pub abstract class Base(Model, Query)
  getter numbered_parameters : Array(Value)
  getter error : ErrorBase? = nil
  @placeholder : String = "?"
  @where : String? = nil
  @where_rendered : Bool = false
  @order : String? = nil
  @order_rendered : Bool = false
  @group_by : String? = nil
  @having : String? = nil
  @joins : String? = nil
  @aggregate_fields : Array(String)

  getter query : Query

  def initialize(@query : Query)
    @numbered_parameters = [] of Value
    @aggregate_fields = [] of String
  end

  abstract def add_parameter(value : Value) : String

  def add_aggregate_field(name : String) : Nil
    @aggregate_fields << name
    nil
  end

  def table_name : String
    Model.table_name
  end

  # Remembers the first clause error; the terminal returns it.
  protected def fail(failure : ErrorBase) : Nil
    @error = failure if @error.nil?
    nil
  end

  def field_list : String
    fields = @query.select_columns || Model.fields
    fields.map { |field| select_field_sql(field) }.join(", ")
  end

  protected def select_field_sql(field : String) : String
    if @query.join_clauses.empty?
      quote_reserved_field(field)
    else
      qualify_join_field(field, Model.quote(Model.table_name))
    end
  end

  def pluck_field_sql(field : String) : String
    qualify_join_field(field, Model.quote(Model.table_name))
  end

  protected def qualify_join_field(field : String, quoted_table_name : String) : String
    if !@query.join_clauses.empty? && JoinSupport.identifier?(field)
      "#{quoted_table_name}.#{Model.quote(field)}"
    else
      quote_reserved_field(field)
    end
  end

  RESERVED_FIELD_NAMES = [
    "all", "and", "as", "asc", "between", "blob", "both", "by", "case", "check",
    "column", "constraint", "create", "cross", "current_date", "current_time",
    "current_timestamp", "current_user", "default", "delete", "desc", "distinct",
    "drop", "else", "end", "except", "exists", "false", "fetch", "for", "foreign",
    "from", "full", "grant", "group", "having", "in", "index", "inner", "insert",
    "interval", "intersect", "into", "is", "join", "key", "keys", "leading", "left",
    "like", "limit", "lock", "natural", "not", "null", "offset", "on", "or", "order",
    "outer", "primary", "range", "rank", "references", "right", "row", "rows",
    "select", "set", "table", "then", "to", "trailing", "true", "union", "unique",
    "update", "user", "using", "values", "when", "where", "window", "with",
  ]

  protected def quote_reserved_field(field : String) : String
    RESERVED_FIELD_NAMES.includes?(field.downcase) ? Model.quote(field) : field
  end

  def select_keyword : String
    @query.distinct? ? "#{select_prefix} DISTINCT" : select_prefix
  end

  def select_prefix : String
    hints = @query.optimizer_hint_list
    hints.empty? ? "SELECT" : "SELECT /*+ #{hints.join(" ")} */"
  end

  def joins : String?
    cached = @joins
    return cached unless cached.nil?
    join_clauses = @query.join_clauses
    return nil if join_clauses.empty?
    parts = join_clauses.map do |clause|
      if clause[:type] == :raw
        clause[:on]
      else
        join_type = case clause[:type]
                    when :inner then "INNER JOIN"
                    when :left  then "LEFT JOIN"
                    else             "JOIN"
                    end
        "#{join_type} #{clause[:table]} ON #{clause[:on]}"
      end
    end
    joined = parts.join(" ")
    @joins = joined
    joined
  end

  def having : String?
    cached = @having
    return cached unless cached.nil?
    having_clauses = @query.having_clauses
    return nil if having_clauses.empty?
    parts = having_clauses.map do |clause|
      value = clause[:value]
      if value.nil?
        clause[:stmt]
      elsif value.is_a?(Array)
        statement = clause[:stmt]
        value.each { |item| statement = statement.sub(@placeholder, add_parameter(item)) }
        statement
      else
        clause[:stmt].gsub(@placeholder, add_parameter(value))
      end
    end
    rendered = "HAVING #{parts.join(" AND ")}"
    @having = rendered
    rendered
  end

  # Joins the non-nil clauses with spaces, as upstream's build_sql does.
  def build_sql(clauses : Array(String?)) : String
    sql = clauses.compact.join(" ")
    comment = @query.annotation_comment
    comment.nil? ? sql : "#{comment} #{sql}"
  end

  def with_clause : String?
    @query.with_sql_for(self)
  end

  def from_source_sql : String?
    @query.from_sql_for(self)
  end

  def from_clause : String
    source = from_source_sql
    return "FROM #{source}" unless source.nil?
    quoted_table = table_name.downcase == "select" ? Model.quote(table_name) : table_name
    hint = @query.index_hint_sql
    hint.nil? ? "FROM #{quoted_table}" : "FROM #{quoted_table} #{hint}"
  end

  def where : String?
    return @where if @where_rendered
    @where_rendered = true
    default_scope = render_where_fields(@query.default_scope_where_fields)
    conditions = render_where_fields(@query.where_fields)
    return nil if default_scope.empty? && conditions.empty?
    rendered = if !default_scope.empty? && !conditions.empty?
                 "WHERE (#{default_scope}) AND (#{conditions})"
               elsif !default_scope.empty?
                 "WHERE (#{default_scope})"
               else
                 "WHERE #{conditions}"
               end
    @where = rendered
    rendered
  end

  @predicate_renderer : PredicateRenderer? = nil

  def predicate_renderer : PredicateRenderer
    renderer = @predicate_renderer
    if renderer.nil?
      renderer = PredicateRenderer.new(Model.to_s, Model.table_name, Model.fields,
        ->(name : String) { Model.quote(name) },
        ->(value : Value) { add_parameter(value) },
        ->(name : String) { add_aggregate_field(name); nil },
        @query.join_clauses)
      @predicate_renderer = renderer
    end
    renderer.join_clauses = @query.join_clauses
    renderer
  end

  def render_where_fields(fields : Array(WhereField)) : String
    return "" if fields.empty?
    rendered = predicate_renderer.render_where_fields(fields)
    if rendered.is_a?(ErrorBase)
      fail(rendered)
      return "1=0"
    end
    rendered
  end

  def bind_raw_statement(statement : String, values : Array(Value)) : String
    rendered = predicate_renderer.bind_raw_statement(statement, values)
    if rendered.is_a?(ErrorBase)
      fail(rendered)
      return statement
    end
    rendered
  end

  def bind_fragment(sql : String, binds : Array(Value)) : String
    bind_raw_statement(sql, binds)
  end

  def share_parameters(params : Array(Value)) : Nil
    @numbered_parameters = params
    nil
  end

  def order(use_default_order : Bool = true) : String?
    return @order if @order_rendered
    order_fields = @query.order_fields
    if order_fields.empty?
      return nil unless use_default_order && ::Grant::Settings.settings.implicit_order
      if !@query.group_fields.empty? && @query.group_fields.none? { |expression| expression[:field] == Model.primary_name }
        return nil
      end
      columns = @query.select_columns
      if @query.distinct? && !columns.nil? && !columns.includes?(Model.primary_name)
        return nil
      end
      order_fields = default_order
    end
    @order_rendered = true
    rendered = "ORDER BY #{order_fields.map { |expression| render_order_term(expression) }.join(", ")}"
    @order = rendered
    rendered
  end

  def render_order_term(expression : OrderField) : String
    direction = expression[:direction]
    return expression[:field] if direction == Sort::Raw
    field = order_field_sql(expression[:field])
    add_aggregate_field(field)
    keyword = direction.sorts_descending? ? "DESC" : "ASC"
    case direction.nulls_placement
    when :first then nulls_ordering_sql(field, keyword, true)
    when :last  then nulls_ordering_sql(field, keyword, false)
    else             "#{field} #{keyword}"
    end
  end

  protected def order_field_sql(field : String) : String
    parts = field.split('.')
    unless parts.size == 2 && parts.all? { |part| JoinSupport.identifier?(part) }
      return qualify_join_field(field, Model.quote(Model.table_name))
    end
    unless parts[0] == Model.table_name || JoinSupport.joins?(@query.join_clauses, parts[0])
      fail(ArgumentError.new("Unknown query table #{parts[0].inspect} in ORDER BY for #{Model.to_s}"))
    end
    "#{Model.quote(parts[0])}.#{Model.quote(parts[1])}"
  end

  protected def nulls_ordering_sql(field : String, keyword : String, first : Bool) : String
    "#{field} #{keyword} NULLS #{first ? "FIRST" : "LAST"}"
  end

  def group_by : String?
    cached = @group_by
    return cached unless cached.nil?
    group_fields = @query.group_fields
    return nil if group_fields.empty?
    clauses = group_fields.map { |expression| qualify_join_field(expression[:field], Model.quote(Model.table_name)) }
    rendered = "GROUP BY #{clauses.join(", ")}"
    @group_by = rendered
    rendered
  end

  def limit : String?
    value = @query.limit
    value.nil? ? nil : "LIMIT #{value}"
  end

  def offset : String?
    value = @query.offset
    value.nil? ? nil : "OFFSET #{value}"
  end

  def lock : String?
    @query.locked? ? @query.lock_sql(Model.adapter) : nil
  end

  def default_order : Array(OrderField)
    field = qualify_join_field(Model.primary_name, Model.quote(Model.table_name))
    [{field: field, direction: Sort::Descending}]
  end

  def count : ::Grant::Query::Executor::Value(Model, Int64)
    with_sql = with_clause
    sql = if @query.distinct?
            distinct_rows_sql = build_sql([
              "SELECT DISTINCT #{field_list}", from_clause, joins, where, group_by, having,
              (!@query.limit.nil? || !@query.offset.nil?) ? order(false) : nil, limit, offset,
            ] of String?)
            [with_sql, "#{select_prefix} COUNT(*) FROM (#{distinct_rows_sql}) AS grant_distinct_rows"].compact.join(" ")
          elsif (!@query.limit.nil? || !@query.offset.nil?) && @query.group_fields.empty?
            limited_rows_sql = build_sql([
              "SELECT 1", from_clause, joins, where, having, order(false),
              limit || "LIMIT 9223372036854775807", offset,
            ] of String?)
            [with_sql, "#{select_prefix} COUNT(*) FROM (#{limited_rows_sql}) AS grant_limited_rows"].compact.join(" ")
          else
            build_sql([
              with_sql, "#{select_prefix} COUNT(*)", from_clause, joins, where, group_by, having,
              @query.group_fields.empty? ? nil : order(false), limit, offset,
            ] of String?)
          end
    ::Grant::Query::Executor::Value(Model, Int64).new(sql, numbered_parameters, 0_i64)
  end

  def grouped_count : ::Grant::Query::Executor::Grouped(Model)
    group_expressions = @query.group_fields.map { |expression| qualify_join_field(expression[:field], Model.quote(Model.table_name)) }
    sql = build_sql([
      with_clause, "#{select_prefix} #{group_expressions.join(", ")}, COUNT(*)", from_clause, joins, where,
      group_by, having, order(false), limit, offset,
    ] of String?)
    ::Grant::Query::Executor::Grouped(Model).new(sql, group_expressions.size, numbered_parameters)
  end

  def first(n : Int32 = 1) : ::Grant::Query::Executor::List(Model)
    sql = build_sql([
      with_clause, "#{select_keyword} #{field_list}", from_clause, joins, where, group_by, having,
      order, "LIMIT #{n}", offset, lock,
    ] of String?)
    ::Grant::Query::Executor::List(Model).new(sql, numbered_parameters)
  end

  def select : ::Grant::Query::Executor::List(Model)
    sql = build_sql([
      with_clause, "#{select_keyword} #{field_list}", from_clause, joins, where, group_by, having,
      order, limit, offset, lock,
    ] of String?)
    ::Grant::Query::Executor::List(Model).new(sql, numbered_parameters)
  end

  def explain_keyword(analyze : Bool = false) : String
    "EXPLAIN"
  end

  def explain_select_sql : String
    build_sql([
      with_clause, "#{select_keyword} #{field_list}", from_clause, joins, where, group_by, having,
      order, limit, offset,
    ] of String?)
  end

  def exists? : ::Grant::Query::Executor::Value(Model, Bool)
    sql = build_sql([
      with_clause, "SELECT EXISTS(SELECT 1 ",
      from_source_sql.nil? ? "FROM #{table_name} " : from_clause,
      joins, where, ")",
    ] of String?)
    ::Grant::Query::Executor::Value(Model, Bool).new(sql, numbered_parameters, false)
  end

  def delete_sql : String
    if limited_or_joined_write?
      "DELETE FROM #{table_name} WHERE #{Model.quote(Model.primary_name)} IN (#{write_target_subquery})"
    else
      build_sql(["DELETE FROM #{table_name}", where] of String?)
    end
  end

  def update_all_sql(assignments : Array(Tuple(String, Value))) : String
    set_parts = assignments.map { |pair| "#{Model.quote(pair[0])} = #{add_parameter(pair[1])}" }
    build_sql(["UPDATE #{table_name}", "SET #{set_parts.join(", ")}", write_where_clause] of String?)
  end

  def update_all_fragment_sql(assignments : String) : String
    build_sql(["UPDATE #{table_name} SET #{assignments}", write_where_clause] of String?)
  end

  private def write_where_clause : String?
    limited_or_joined_write? ? "WHERE #{Model.quote(Model.primary_name)} IN (#{write_target_subquery})" : where
  end

  protected def limited_or_joined_write? : Bool
    !@query.limit.nil? || !@query.offset.nil? || !@query.join_clauses.empty?
  end

  protected def write_target_subquery : String
    build_sql([
      "SELECT #{Model.quote(Model.primary_name)} FROM #{table_name}", joins, where, order(false), limit, offset,
    ] of String?)
  end

  def pluck_sql(fields : Array(String)) : String
    select_fields = fields.map do |field|
      sql_field = pluck_field_sql(field)
      add_aggregate_field(sql_field)
      sql_field
    end.join(", ")
    build_sql([
      with_clause, "#{select_keyword} #{select_fields}", from_clause, joins, where, group_by, having,
      order, limit, offset,
    ] of String?)
  end

  def sql_operator(operator : Symbol) : String
    PredicateRenderer.sql_operator(operator)
  end
end

pub class Sqlite(Model, Query) < Base(Model, Query)
  def add_parameter(value : Value) : String
    @numbered_parameters << value
    "?"
  end

  def double_cast_sql(expression : String) : String
    "CAST(#{expression} AS REAL)"
  end

  def explain_keyword(analyze : Bool = false) : String
    "EXPLAIN QUERY PLAN"
  end
end

pub class Pg(Model, Query) < Base(Model, Query)
  def add_parameter(value : Value) : String
    @numbered_parameters << value
    "$#{@numbered_parameters.size}"
  end

  protected def select_field_sql(field : String) : String
    sql_field = super(field)
    column_name = field.split('.').last
    column_name.starts_with?("_serialized_") ? "#{sql_field}::TEXT AS #{Model.quote(column_name)}" : sql_field
  end

  def explain_keyword(analyze : Bool = false) : String
    analyze ? "EXPLAIN ANALYZE" : "EXPLAIN"
  end
end
