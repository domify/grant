module grant/query/scoped_relation
import grant/query/builder::{Builder}

# Clause adoption used by named scopes returning a plain builder.
pub trait ScopedRelation(Model)
  def merge_builder(other : Builder(Model)) : self
    own_default_scope_where_fields.concat(other.default_scope_where_fields)
    own_where_fields.concat(other.where_fields)
    own_order_fields.concat(other.order_fields)
    own_group_fields.concat(other.group_fields)
    own_join_clauses.concat(other.join_clauses)
    own_having_clauses.concat(other.having_clauses)
    query_limit = other.limit
    limit_in_place(query_limit) unless query_limit.nil?
    query_offset = other.offset
    offset_in_place(query_offset) unless query_offset.nil?
    adopt_create_with_defaults(other.create_with_attributes)
    self
  end

end

impl ScopedRelation(Model) for Builder(Model) forall Model
end
