module grant/query/from_and_with

import grant/adapter/base
import grant/query/assembler
import grant/query/join_support::{JoinSupport}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase, ArgumentError}
import std/text

pub class UnsupportedCommonTableExpressionError < ErrorBase
end

pub class CommonTableExpressions
  DEPTH_COLUMN = "grant_depth"
  DEFAULT_MAX_DEPTH = 1000
  FORBIDDEN_STEP_WORDS = ["GROUP", "ORDER", "LIMIT", "OFFSET", "FETCH", "HAVING", "WINDOW", "UNION", "INTERSECT", "EXCEPT", "FOR"]

  def self.ensure_supported_strict(adapter : ::Grant::Adapter::Base::Base) : Nil | ErrorBase
    return nil if adapter.supports_common_table_expressions?
    UnsupportedCommonTableExpressionError.new("#{adapter.class} #{adapter.database_version} does not support common table expressions (WITH)")
  end

  def self.guard_step(step : String, max_depth : Int32) : String | ArgumentError
    return ArgumentError.new("with_recursive: max_depth must be positive") unless max_depth > 0

    from_at = nil
    where_at = nil
    depth = 0
    quote : Char? = nil
    index = 0
    chars = step.chars

    while index < chars.size
      char = chars[index]
      if current = quote
        quote = nil if char == current
      elsif char == '\'' || char == '"' || char == '`'
        quote = char
      elsif char == '('
        depth += 1
      elsif char == ')'
        depth -= 1
      elsif depth == 0 && word_start?(chars, index)
        word = word_at(chars, index)
        upper = word.upcase
        if upper == "FROM" && from_at.nil?
          from_at = index
        elsif upper == "WHERE" && from_at && where_at.nil?
          where_at = index
        elsif from_at && FORBIDDEN_STEP_WORDS.includes?(upper)
          return ArgumentError.new("with_recursive: the recursive term cannot contain #{upper} at its top level")
        end
        index += word.size - 1
      end
      index += 1
    end

    start = from_at
    return ArgumentError.new("with_recursive: the recursive term must be SELECT ... FROM <cte> ...") if start.nil?

    counter = "#{DEPTH_COLUMN} + 1"
    limit = "#{DEPTH_COLUMN} < #{max_depth}"
    head = step[0, start].rstrip
    if where = where_at
      from_part = step[start, where - start]
      condition = step[(where + 5)...step.size].strip
      "#{head}, #{counter} #{from_part}WHERE #{limit} AND (#{condition})"
    else
      "#{head}, #{counter} #{step[start...step.size].rstrip} WHERE #{limit}"
    end
  end

  private def self.word_start?(chars : Array(Char), index : Int32) : Bool
    return false unless letter?(chars[index])
    index == 0 || !(alphanumeric?(chars[index - 1]) || chars[index - 1] == '_')
  end

  private def self.word_at(chars : Array(Char), index : Int32) : String
    finish = index
    while finish < chars.size && (alphanumeric?(chars[finish]) || chars[finish] == '_')
      finish += 1
    end
    word = ""
    while index < finish
      word += chars[index].to_s
      index += 1
    end
    word
  end
  private def self.letter?(char : Char) : Bool
    (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
  end

  private def self.alphanumeric?(char : Char) : Bool
    letter?(char) || (char >= '0' && char <= '9')
  end
end

pub struct CommonTable(Model, Query)
  getter name : String
  getter recursive : Bool
  getter render : Proc(::Grant::Query::Assembler::Base(Model, Query), String)

  def initialize(@name : String, @recursive : Bool, @render : Proc(::Grant::Query::Assembler::Base(Model, Query), String))
  end
end

pub trait FromAndWith(Model, Query)
  def from_source? : Bool
    !from_render.nil? || !from_source.nil?
  end

  protected def clear_from_source_in_place : Nil
    reset_load_state
    self.from_kind = :none
    self.from_alias = nil
    self.from_render = nil
    nil
  end

  protected def clear_common_tables_in_place : Nil
    reset_load_state
    self.common_tables = [] of CommonTable(Model, Query)
    nil
  end

  private def validate_identifier_strict(name : String?, context : String) : Nil | ArgumentError
    return nil if name.nil? || JoinSupport.identifier?(name)
    ArgumentError.new("#{context}: #{name.inspect} is not a valid identifier")
  end

  private def string_renderer(sql : String, binds : Array(Value)) : Proc(::Grant::Query::Assembler::Base(Model, Query), String)
    ->(outer : ::Grant::Query::Assembler::Base(Model, Query)) { outer.bind_fragment(sql, binds) }
  end

  private def subquery_renderer(source : Other) : Proc(::Grant::Query::Assembler::Base(Model, Query), String) forall Other
    snapshot = source.chain_copy
    ->(outer : ::Grant::Query::Assembler::Base(Model, Query)) do
      failure = snapshot.deferred_error
      unless failure.nil?
        outer.record_error(failure)
      end
      inner = snapshot.assembler
      inner.share_parameters(outer.numbered_parameters)
      statement = inner.select.raw_sql
      failure = inner.error
      outer.record_error(failure) unless failure.nil?
      statement
    end
  end

  def from_in_place(source : Other, as name : String? = nil) : self forall Other
    alias_name = name || Model.table_name
    failure = validate_identifier_strict(alias_name, "from")
    return self.defer(failure) unless failure.nil?
    reset_load_state
    self.from_kind = :subquery
    self.from_alias = alias_name
    self.from_render = subquery_renderer(source)
    self
  end

  def from_in_place(sql : String, as name : String? = nil, binds : Array(Value) = [] of Value) : self
    failure = validate_identifier_strict(name, "from")
    return self.defer(failure) unless failure.nil?
    reset_load_state
    self.from_kind = :sql
    self.from_alias = name
    self.from_render = string_renderer(sql, binds)
    self
  end

  def from_in_place(table : Symbol, as name : String? = nil) : self
    failure = validate_identifier_strict(table.to_s, "from") || validate_identifier_strict(name, "from")
    return self.defer(failure) unless failure.nil?
    reset_load_state
    quoted = Model.quote(table.to_s)
    self.from_kind = :table
    self.from_alias = name
    self.from_render = ->(_outer : ::Grant::Query::Assembler::Base(Model, Query)) { quoted }
    self
  end

  def from(source : Other, as name : String? = nil) : self forall Other
    chain_copy.from_in_place(source, as: name)
  end

  def from(sql : String, as name : String? = nil, binds : Array(Value) = [] of Value) : self
    chain_copy.from_in_place(sql, as: name, binds: binds)
  end

  def from(table : Symbol, as name : String? = nil) : self
    chain_copy.from_in_place(table, as: name)
  end

  private def add_common_table_in_place(name : Symbol | String, recursive : Bool,
                                      render : Proc(::Grant::Query::Assembler::Base(Model, Query), String)) : self
    label = name.to_s
    failure = validate_identifier_strict(label, "with")
    return self.defer(failure) unless failure.nil?
    reset_load_state
    kept = common_tables.reject { |table| table.name == label }
    self.common_tables = kept + [CommonTable(Model, Query).new(label, recursive, render)]
    self
  end

  def with_in_place(name : Symbol | String, query : Other) : self forall Other
    add_common_table_in_place(name, false, subquery_renderer(query))
  end

  def with_in_place(name : Symbol | String, sql : String, binds : Array(Value) = [] of Value) : self
    add_common_table_in_place(name, false, string_renderer(sql, binds))
  end

  def with(name : Symbol | String, query : Other) : self forall Other
    chain_copy.with_in_place(name, query)
  end

  def with(name : Symbol | String, sql : String, binds : Array(Value) = [] of Value) : self
    chain_copy.with_in_place(name, sql, binds)
  end

  private def add_recursive_common_table_in_place(name : Symbol | String,
      anchor_render : Proc(::Grant::Query::Assembler::Base(Model, Query), String),
      step : String, max_depth : Int32, union_all : Bool, step_binds : Array(Value)) : self
    guarded = CommonTableExpressions.guard_step(step, max_depth)
    return self.defer(guarded) if guarded.is_a?(ErrorBase)
    guarded_sql = guarded.as(String)
    connector = union_all ? "UNION ALL" : "UNION"
    depth = CommonTableExpressions::DEPTH_COLUMN
    render = ->(outer : ::Grant::Query::Assembler::Base(Model, Query)) do
      anchor_sql = anchor_render.call(outer)
      step_sql = outer.bind_fragment(guarded_sql, step_binds)
      "SELECT grant_anchor.*, 1 AS #{depth} FROM (#{anchor_sql}) AS grant_anchor #{connector} #{step_sql}"
    end
    add_common_table_in_place(name, true, render)
  end

  def with_recursive_in_place(name : Symbol | String, anchor : Other, step : String, *,
      max_depth : Int32 = CommonTableExpressions::DEFAULT_MAX_DEPTH, union_all : Bool = true,
      anchor_binds : Array(Value) = [] of Value, step_binds : Array(Value) = [] of Value) : self forall Other
    add_recursive_common_table_in_place(name, subquery_renderer(anchor), step, max_depth, union_all, step_binds)
  end

  def with_recursive_in_place(name : Symbol | String, anchor : String, step : String, *,
      max_depth : Int32 = CommonTableExpressions::DEFAULT_MAX_DEPTH, union_all : Bool = true,
      anchor_binds : Array(Value) = [] of Value, step_binds : Array(Value) = [] of Value) : self
    add_recursive_common_table_in_place(name, string_renderer(anchor, anchor_binds), step, max_depth, union_all, step_binds)
  end

  def with_recursive_in_place(name : Symbol | String, body : Other, *, unguarded : Bool,
      binds : Array(Value) = [] of Value) : self forall Other
    return self.defer(ArgumentError.new("with_recursive: pass unguarded: true to use a recursive CTE without the depth guard")) unless unguarded
    add_common_table_in_place(name, true, subquery_renderer(body))
  end

  def with_recursive_in_place(name : Symbol | String, body : String, *, unguarded : Bool,
      binds : Array(Value) = [] of Value) : self
    return self.defer(ArgumentError.new("with_recursive: pass unguarded: true to use a recursive CTE without the depth guard")) unless unguarded
    add_common_table_in_place(name, true, string_renderer(body, binds))
  end

  def with_recursive(name : Symbol | String, anchor : T, step : String, **options) : self forall T
    chain_copy.with_recursive_in_place(name, anchor, step, **options)
  end

  def with_recursive(name : Symbol | String, body : T, *, unguarded : Bool, binds : Array(Value) = [] of Value) : self forall T
    chain_copy.with_recursive_in_place(name, body, unguarded: unguarded, binds: binds)
  end

  protected def merge_from_and_with_in_place(other : self) : Nil
    render = other.from_render
    if render
      self.from_kind = other.from_kind
      self.from_alias = other.from_alias
      self.from_render = render
    end
    other.common_tables.each { |table| add_common_table_in_place(table.name, table.recursive, table.render) }
    nil
  end
end

pub macro model_methods(model)
  {% for operation in [:from, :with, :with_recursive] %}
    def self.{{ operation.id }}(*args, **options) : ::Grant::Query::Builder::Builder({{ model }})
      current_scope.{{ operation.id }}(*args, **options)
    end
  {% end %}
end
