module grant/query/builder

import grant/adapter/sqlite_connection::{Value}
import grant/errors::{DatabaseError, RecordNotFound, ErrorBase}
import grant/locking::{LockMode}
import grant/query/batches::{Batches}
import grant/query_extensions::{QueryExtensions}
import grant/query/aggregations::{Aggregations}
import grant/query/grouping::{Grouping}

# Structural slice of Grant::Query::Builder(Model): lazy clauses and terminal
# reads. The model remains responsible for its connection and row hydration.
pub class Builder(Model)
  getter lock_mode : LockMode? = nil

  getter where_fields = [] of String
  @where_values = [] of Value
  getter group_fields = [] of NamedTuple(field: String)

  def initialize
  end

  def chain_copy : self
    copied = Builder(Model).new
    copied.copy_conditions(@where_fields, @where_values)
    copied.copy_groups(@group_fields)
    copied.lock_in_place(@lock_mode)
    copied
  end

  protected def copy_groups(fields : Array(NamedTuple(field: String))) : Nil
    @group_fields = fields.dup
    nil
  end

  def group_by_in_place(field : Symbol | String) : self
    @group_fields << {field: field.to_s}
    self
  end

  def group_by(field : Symbol | String) : self
    chain_copy.group_by_in_place(field)
  end

  protected def copy_conditions(fields : Array(String), values : Array(Value)) : Nil
    @where_fields = fields.dup
    @where_values = values.dup
    nil
  end

  def where(stmt : String) : self
    chain_copy.where_in_place(stmt)
  end

  def where(stmt : String, values : Array(V)) : self forall V
    chain_copy.where_in_place(stmt, values)
  end

  def where(stmt : String, value : Value) : self
    chain_copy.where_in_place(stmt, value)
  end

  def where(field : Symbol | String, operator : Symbol, value : Value) : self | ErrorBase
    chain_copy.where_in_place(field, operator, value)
  end

  def where_in_place(field : Symbol | String, operator : Symbol, value : Value) : self | ErrorBase
    sql_operator = case operator
                   when :eq then "="
                   when :neq then "!="
                   when :gt then ">"
                   when :lt then "<"
                   when :gteq then ">="
                   when :lteq then "<="
                   when :like then "LIKE"
                   when :nlike then "NOT LIKE"
                   else
                     return ErrorBase.new("Unsupported comparison operator: #{operator}")
                   end
    where_in_place("\"#{field}\" #{sql_operator} ?", value)
  end

  def where_in_place(stmt : String) : self
    @where_fields << stmt
    self
  end

  def where_in_place(stmt : String, values : Array(V)) : self forall V
    @where_fields << stmt
    values.each { |value| @where_values << value }
    self
  end

  def where_in_place(stmt : String, value : Value) : self
    where_in_place(stmt, [value] of Value)
  end

  def where_in_place(**matches) : self
    matches.each do |field, value|
      where_in_place("\"#{field}\" = ?", value)
    end
    self
  end

  def lock(mode : LockMode = LockMode::Update) : self
    chain_copy.lock_in_place(mode)
  end

  def lock_in_place(mode : LockMode?) : self
    @lock_mode = mode
    self
  end

  def to_sql : String
    projection_sql(Model.select_fields_sql)
  end

  private def projection_sql(fields : String) : String
    sql = "SELECT #{fields} FROM \"#{Model.table_name}\""
    sql += where_sql
    sql += " GROUP BY #{@group_fields.map { |field| field[:field] }.join(", ")}" unless @group_fields.empty?
    mode = @lock_mode
    unless mode.nil?
      clause = mode.to_sql(Model.adapter)
      sql += " #{clause}" unless clause.empty?
    end
    sql
  end

  private def where_sql : String
    @where_fields.empty? ? "" : " WHERE #{@where_fields.map { |stmt| "(#{stmt})" }.join(" AND ")}"
  end

  def delete_all : Int64 | DatabaseError
    delete_all_single
  end

  protected def delete_all_single : Int64 | DatabaseError
    Model.__connection.execute("DELETE FROM \"#{Model.table_name}\"#{where_sql}", @where_values)!.changes
  end

  protected def next_batch_rows(last_value : Value, batch_size : Int32)
    relation = chain_copy
    relation.where_in_place("\"#{Model.primary_name}\" > ?", last_value) unless last_value.nil?
    Model.__connection.query("#{relation.to_sql} ORDER BY \"#{Model.primary_name}\" ASC LIMIT #{batch_size}", relation.batch_values)
  end

  protected def batch_values : Array(Value)
    @where_values
  end

  def count : Int64 | Hash(Value, Int64) | Hash(Array(Value), Int64) | DatabaseError
    return count_single if @group_fields.empty?
    grouped_values(aggregate_rows("COUNT", "*")!, Int64) { |value| value.as(Int64) }
  end

  protected def count_single : Int64 | DatabaseError
    rows = Model.__connection.query(projection_sql("COUNT(*)"), @where_values)!
    rows.first.values.first.as(Int64)
  end

  def exists? : Bool | DatabaseError
    rows = Model.__connection.query("#{projection_sql("1")} LIMIT 1", @where_values)!
    !rows.empty?
  end

  # Grant::Query::Builder convenience methods project values without model
  # hydration. Keep positional results, including nil values and repeated fields.
  def pluck(*fields : Symbol | String) : Array(Array(Value)) | DatabaseError
    pluck_single(fields.to_a.map { |field| field.to_s })
  end

  protected def pluck_single(field_names : Array(String)) : Array(Array(Value)) | DatabaseError
    projected_values(field_names)
  end

  private def projected_values(field_names : Array(String), first_only : Bool = false) : Array(Array(Value)) | DatabaseError
    # Unique aliases retain positional values even when a field is repeated.
    projections = [] of String
    field_names.each_with_index do |field, index|
      projections << "\"#{Model.table_name}\".\"#{field}\" AS \"grant_pluck_#{index}\""
    end
    sql = projection_sql(projections.join(", "))
    sql += " LIMIT 1" if first_only
    rows = Model.__connection.query(sql, @where_values)!
    rows.map do |row|
      values = [] of Value
      field_names.each_with_index { |field, index| values << row["grant_pluck_#{index}"] }
      values
    end
  end

  def pick(*fields : Symbol | String) : Array(Value) | Nil | DatabaseError
    projected_values(fields.to_a.map { |field| field.to_s }, true)!.first?
  end

  def ids : Array(Value) | DatabaseError
    ids_single
  end

  protected def ids_single : Array(Value) | DatabaseError
    pluck_single([Model.primary_name])!.map { |row| row.first }
  end

  def select : Array(Model) | DatabaseError
    Model.__connection.query(to_sql, @where_values)!.map { |row| Model.from_row(row) }
  end

  def first : Model | Nil | DatabaseError
    rows = Model.__connection.query("#{to_sql} ORDER BY \"#{Model.primary_name}\" ASC LIMIT 1", @where_values)!
    row = rows.first?
    row.nil? ? nil : Model.from_row(row)
  end

  def first_strict : Model | DatabaseError | RecordNotFound
    record = first!
    return RecordNotFound.new(Model.to_s, "first") if record.nil?
    record
  end

  def last : Model | Nil | DatabaseError
    rows = Model.__connection.query("#{to_sql} ORDER BY \"#{Model.primary_name}\" DESC LIMIT 1", @where_values)!
    row = rows.first?
    row.nil? ? nil : Model.from_row(row)
  end

  def find_by(**criteria) : Model | Nil | DatabaseError
    chain_copy.where_in_place(**criteria).first
  end
end

impl Batches(Model) for Builder(Model) forall Model
end

impl QueryExtensions(Model) for Builder(Model) forall Model
end

impl Aggregations(Model) for Builder(Model) forall Model
end

impl Grouping(Model) for Builder(Model) forall Model
end
