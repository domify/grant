module grant/query/builder

import std/text
pub import grant/adapter/driver
import grant/adapter/driver::{Value, Mutation}
import grant/errors::{DatabaseError, RecordNotFound, ErrorBase}
import grant/error::{ArgumentError}
import grant/locking::{LockMode}
import grant/query/where_field::{Bind, WhereField, StructuredWhere, JoinClause, HavingClause, OrderField, GroupField}
pub import grant/query/where_field
import grant/query/bind_value::{to_bind, to_value}
import grant/query/join_support::{JoinSupport}
import grant/query/assembler
import grant/query/predicate_renderer
import grant/query/empty_clauses::{EmptyClauses}
import grant/query/executor
import grant/query/batches::{Batches}
import grant/query_extensions::{QueryExtensions}
import grant/query/aggregations::{Aggregations}
import grant/query/grouping::{Grouping}
import grant/query/sql_expression
import grant/query/relation_merging::{RelationMerging}
import grant/query/existence_enumerable::{ExistenceEnumerable}
import grant/querying::{NotFound, NotUnique}
import grant/query/where_chain::{WhereChainMethods}
import grant/query/where_composition::{WhereComposition}

# Native counterpart of Grant::Query::Builder(Model)
# (crystal-upstream/src/grant/query/builder.cr).
#
# A `Builder` accumulates query components (WHERE/ORDER/GROUP BY/LIMIT/…)
# and does not touch the database until a terminal method is called. Chain
# methods never change the receiver: each returns a new relation, so a
# stored relation can be reused safely. Upstream's `name!` in-place
# variants are `name_in_place` (doc/NAMING.md).
#
# Upstream reopens Builder from other files (finders, where chains,
# aggregations, …); iyi has no open classes, so those parts are traits in
# their own modules with `impl Trait(Model) for Builder(Model)` beside them.
pub class Builder(Model)
  pub enum DbType
    Mysql
    Sqlite
    Pg
  end

  pub alias Sort = ::Grant::Query::WhereField::Sort
  pub alias CountResult = Int64 | Hash(Value, Int64) | Hash(Array(Value), Int64)

  getter where_fields = EmptyClauses::WHERE_FIELDS
  getter default_scope_where_fields = EmptyClauses::DEFAULT_SCOPE_WHERE_FIELDS
  getter order_fields = EmptyClauses::ORDER_FIELDS
  getter group_fields = EmptyClauses::GROUP_FIELDS
  getter offset : Int64? = nil
  getter limit : Int64? = nil
  getter lock_mode : LockMode? = nil
  property select_columns : Array(String)? = nil
  getter join_clauses = EmptyClauses::JOIN_CLAUSES
  getter having_clauses = EmptyClauses::HAVING_CLAUSES
  getter optimizer_hint_list = EmptyClauses::OPTIMIZER_HINTS
  property annotation_comment : String? = nil
  property index_hint_sql : String? = nil
  @distinct : Bool = false
  @is_none : Bool = false
  @strict_loading : Bool = false
  @readonly : Bool = false
  @boolean_operator : Symbol = :and
  # Raw FROM / WITH sources set by the from_and_with module.
  property from_source : String? = nil
  property with_source : String? = nil
  # A chain step upstream would raise ArgumentError for; terminals return it.
  property deferred_error : ErrorBase? = nil
  # Memoized result of `load`. Cleared by every mutation and by `reset`.
  @records : Array(Model)? = nil

  def initialize(@db_type : DbType = DbType::Sqlite, @boolean_operator : Symbol = :and)
  end

  getter db_type : DbType

  # The DbType of *adapter*, as the model passes it to new relations.
  def self.db_type_for(adapter : ::Grant::Adapter::Base::Base) : DbType
    adapter.postgres? ? DbType::Pg : DbType::Sqlite
  end

  def distinct? : Bool
    @distinct
  end

  def is_none? : Bool
    @is_none
  end

  def strict_loading? : Bool
    @strict_loading
  end

  def readonly? : Bool
    @readonly
  end

  def locked? : Bool
    !@lock_mode.nil?
  end

  def lock_sql(adapter : ::Grant::Adapter::Base::Base) : String?
    mode = @lock_mode
    return nil if mode.nil?
    clause = mode.to_sql(adapter)
    clause.empty? ? nil : clause
  end

  # Upstream's copy-on-write `own_<list>` and `clear_<list>`: every in-place
  # write goes through them so a loaded relation forgets its records.
  def own_where_fields : Array(WhereField)
    reset_load_state
    @where_fields = @where_fields.dup if @where_fields.object_id == EmptyClauses::WHERE_FIELDS.object_id
    @where_fields
  end

  def clear_where_fields : Nil
    reset_load_state
    @where_fields = EmptyClauses::WHERE_FIELDS
    nil
  end

  def own_default_scope_where_fields : Array(WhereField)
    reset_load_state
    @default_scope_where_fields = @default_scope_where_fields.dup if @default_scope_where_fields.object_id == EmptyClauses::DEFAULT_SCOPE_WHERE_FIELDS.object_id
    @default_scope_where_fields
  end

  def clear_default_scope_where_fields : Nil
    reset_load_state
    @default_scope_where_fields = EmptyClauses::DEFAULT_SCOPE_WHERE_FIELDS
    nil
  end

  def own_order_fields : Array(OrderField)
    reset_load_state
    @order_fields = @order_fields.dup if @order_fields.object_id == EmptyClauses::ORDER_FIELDS.object_id
    @order_fields
  end

  def clear_order_fields : Nil
    reset_load_state
    @order_fields = EmptyClauses::ORDER_FIELDS
    nil
  end

  def own_group_fields : Array(GroupField)
    reset_load_state
    @group_fields = @group_fields.dup if @group_fields.object_id == EmptyClauses::GROUP_FIELDS.object_id
    @group_fields
  end

  def clear_group_fields : Nil
    reset_load_state
    @group_fields = EmptyClauses::GROUP_FIELDS
    nil
  end

  def own_join_clauses : Array(JoinClause)
    reset_load_state
    @join_clauses = @join_clauses.dup if @join_clauses.object_id == EmptyClauses::JOIN_CLAUSES.object_id
    @join_clauses
  end

  def clear_join_clauses : Nil
    reset_load_state
    @join_clauses = EmptyClauses::JOIN_CLAUSES
    nil
  end

  def own_having_clauses : Array(HavingClause)
    reset_load_state
    @having_clauses = @having_clauses.dup if @having_clauses.object_id == EmptyClauses::HAVING_CLAUSES.object_id
    @having_clauses
  end

  def clear_having_clauses : Nil
    reset_load_state
    @having_clauses = EmptyClauses::HAVING_CLAUSES
    nil
  end

  private def reset_load_state : Nil
    @records = nil
    nil
  end

  def dup : self
    chain_copy
  end

  # A copy of this relation; every non-mutating chain method starts here.
  def chain_copy : self
    copy = Builder(Model).new(@db_type, @boolean_operator)
    copy.copy_state_from(self)
    copy
  end

  protected def copy_state_from(source : Builder(Model)) : Nil
    @where_fields = source.where_fields.empty? ? EmptyClauses::WHERE_FIELDS : source.where_fields.dup
    @default_scope_where_fields = source.default_scope_where_fields.empty? ? EmptyClauses::DEFAULT_SCOPE_WHERE_FIELDS : source.default_scope_where_fields.dup
    @order_fields = source.order_fields.empty? ? EmptyClauses::ORDER_FIELDS : source.order_fields.dup
    @group_fields = source.group_fields.empty? ? EmptyClauses::GROUP_FIELDS : source.group_fields.dup
    @join_clauses = source.join_clauses.empty? ? EmptyClauses::JOIN_CLAUSES : source.join_clauses.dup
    @having_clauses = source.having_clauses.empty? ? EmptyClauses::HAVING_CLAUSES : source.having_clauses.dup
    @optimizer_hint_list = source.optimizer_hint_list.empty? ? EmptyClauses::OPTIMIZER_HINTS : source.optimizer_hint_list.dup
    @offset = source.offset
    @limit = source.limit
    @lock_mode = source.lock_mode
    columns = source.select_columns
    @select_columns = columns.nil? ? nil : columns.dup
    @distinct = source.distinct?
    @is_none = source.is_none?
    @strict_loading = source.strict_loading?
    @readonly = source.readonly?
    @annotation_comment = source.annotation_comment
    @index_hint_sql = source.index_hint_sql
    @from_source = source.from_source
    @with_source = source.with_source
    @deferred_error = source.deferred_error
    nil
  end

  # A copy whose WHERE clauses are recorded as default-scope clauses (the
  # ones `unscope(:where)` leaves alone).
  def promote_where_to_default_scope : self
    copy = chain_copy
    copy.own_default_scope_where_fields.concat(copy.where_fields)
    copy.clear_where_fields
    copy
  end

  def strict_loading(value : Bool = true) : self
    chain_copy.strict_loading_in_place(value)
  end

  def strict_loading_in_place(value : Bool = true) : self
    reset_load_state
    @strict_loading = value
    self
  end

  def readonly(value : Bool = true) : self
    chain_copy.readonly_in_place(value)
  end

  def readonly_in_place(value : Bool = true) : self
    reset_load_state
    @readonly = value
    self
  end

  def assembler : ::Grant::Query::Assembler::Base(Model, Builder(Model))
    if @db_type == DbType::Pg
      ::Grant::Query::Assembler::Pg(Model, Builder(Model)).new(self).as(::Grant::Query::Assembler::Base(Model, Builder(Model)))
    else
      ::Grant::Query::Assembler::Sqlite(Model, Builder(Model)).new(self).as(::Grant::Query::Assembler::Base(Model, Builder(Model)))
    end
  end

  # Hooks the assembler calls for FROM and WITH sources.
  def from_sql_for(assembler : A) : String? forall A
    @from_source
  end

  def with_sql_for(assembler : A) : String? forall A
    @with_source
  end

  private def defer(failure : ErrorBase) : self
    @deferred_error = failure if @deferred_error.nil?
    self
  end

  # ---- WHERE -------------------------------------------------------------

  # Adds equality (or set) conditions from keyword arguments, ANDed together.
  # A scalar becomes `column = value`, an Array `column IN (...)` (a nil
  # member also matches NULL).
  def where_in_place(**matches) : self
    matches.each { |field, value| add_condition(:and, field.to_s, value) }
    self
  end

  def where_in_place(matches : Hash(K, V)) : self forall K, V
    matches.each { |field, value| add_condition(:and, field.to_s, value) }
    self
  end

  def where_in_place(field : Symbol | String, operator : Symbol, value : T) : self forall T
    and_in_place(field, operator, value)
  end

  def where_in_place(stmt : String) : self
    and_in_place(stmt)
  end

  def where_in_place(stmt : String, value : Nil) : self
    and_in_place(stmt, value)
  end

  def where_in_place(stmt : String, values : Array(T)) : self forall T
    and_in_place(stmt, values)
  end

  def where_in_place(stmt : String, value : T) : self forall T
    and_in_place(stmt, value)
  end

  def where_in_place(stmt : String, first : A, second : B, *rest) : self forall A, B
    values = [to_value(first), to_value(second)] of Value
    rest.each { |value| values << to_value(value) }
    and_in_place(stmt, values)
  end

  def where(**matches) : self
    chain_copy.where_in_place(**matches)
  end

  def where(matches : Hash(K, V)) : self forall K, V
    chain_copy.where_in_place(matches)
  end

  def where(field : Symbol | String, operator : Symbol, value : T) : self forall T
    chain_copy.where_in_place(field, operator, value)
  end

  def where(stmt : String) : self
    chain_copy.where_in_place(stmt)
  end

  def where(stmt : String, value : Nil) : self
    chain_copy.where_in_place(stmt, value)
  end

  def where(stmt : String, values : Array(T)) : self forall T
    chain_copy.where_in_place(stmt, values)
  end

  def where(stmt : String, value : T) : self forall T
    chain_copy.where_in_place(stmt, value)
  end

  def where(stmt : String, first : A, second : B, *rest) : self forall A, B
    copy = chain_copy
    values = [to_value(first), to_value(second)] of Value
    rest.each { |value| values << to_value(value) }
    copy.and_in_place(stmt, values)
  end

  def and_in_place(field : Symbol | String, operator : Symbol, value : T) : self forall T
    own_where_fields << {join: :and, field: field.to_s, operator: operator, value: to_bind(value)}
    self
  end

  def and_in_place(stmt : String) : self
    own_where_fields << {join: :and, stmt: stmt, value: nil.as(Bind)}
    self
  end

  def and_in_place(stmt : String, value : Nil) : self
    own_where_fields << {join: :and, stmt: stmt, values: [nil] of Value}
    self
  end

  def and_in_place(stmt : String, values : Array(T)) : self forall T
    binds = [] of Value
    values.each { |item| binds << to_value(item) }
    own_where_fields << {join: :and, stmt: stmt, values: binds}
    self
  end

  def and_in_place(stmt : String, value : T) : self forall T
    bound = to_bind(value)
    if bound.is_a?(Array)
      own_where_fields << {join: :and, stmt: stmt, values: bound.as(Array(Value))}
    else
      own_where_fields << {join: :and, stmt: stmt, value: bound.as(Bind)}
    end
    self
  end

  def and_in_place(**matches) : self
    matches.each { |field, value| add_condition(:and, field.to_s, value) }
    self
  end

  def and_in_in_place(field : Symbol | String, values : Array(T), negated : Bool = false) : self forall T
    add_array_condition(:and, field.to_s, negated ? :nin : :in, values)
  end

  def or_in_place(field : Symbol | String, operator : Symbol, value : T) : self forall T
    own_where_fields << {join: :or, field: field.to_s, operator: operator, value: to_bind(value)}
    self
  end

  def or_in_place(stmt : String) : self
    own_where_fields << {join: :or, stmt: stmt, value: nil.as(Bind)}
    self
  end

  def or_in_place(stmt : String, value : Nil) : self
    own_where_fields << {join: :or, stmt: stmt, values: [nil] of Value}
    self
  end

  def or_in_place(stmt : String, values : Array(T)) : self forall T
    binds = [] of Value
    values.each { |item| binds << to_value(item) }
    own_where_fields << {join: :or, stmt: stmt, values: binds}
    self
  end

  def or_in_place(stmt : String, value : T) : self forall T
    bound = to_bind(value)
    if bound.is_a?(Array)
      own_where_fields << {join: :or, stmt: stmt, values: bound.as(Array(Value))}
    else
      own_where_fields << {join: :or, stmt: stmt, value: bound.as(Bind)}
    end
    self
  end

  def or_in_place(**matches) : self
    matches.each { |field, value| add_condition(:or, field.to_s, value) }
    self
  end

  def or_in_in_place(field : Symbol | String, values : Array(T), negated : Bool = false) : self forall T
    add_array_condition(:or, field.to_s, negated ? :nin : :in, values)
  end

  def and_where(field : Symbol | String, operator : Symbol, value : T) : self forall T
    chain_copy.and_in_place(field, operator, value)
  end

  def and_where(stmt : String) : self
    chain_copy.and_in_place(stmt)
  end

  def and_where(stmt : String, value : T) : self forall T
    chain_copy.and_in_place(stmt, value)
  end

  def and_where(**matches) : self
    chain_copy.and_in_place(**matches)
  end

  def or_where(field : Symbol | String, operator : Symbol, value : T) : self forall T
    chain_copy.or_in_place(field, operator, value)
  end

  def or_where(stmt : String) : self
    chain_copy.or_in_place(stmt)
  end

  def or_where(stmt : String, value : T) : self forall T
    chain_copy.or_in_place(stmt, value)
  end

  def or_where(**matches) : self
    chain_copy.or_in_place(**matches)
  end

  def or_where(&block : self -> T) : self forall T
    chain_copy.or_in_place { |query| yield query }
  end

  def or_in_place(&block : self -> T) : self forall T
    reset_load_state
    query = Builder(Model).new(@db_type, :or)
    built = yield query
    query = built if built.is_a?(Builder(Model))
    unless query.where_fields.empty?
      # Render with anonymous placeholders so the enclosing assembler owns
      # numbering and bound values, including PostgreSQL's $n parameters.
      values = [] of Value
      renderer = ::Grant::Query::PredicateRenderer::PredicateRenderer.new(
        Model.to_s, Model.table_name, Model.fields,
        ->(name : String) { Model.quote(name) },
        ->(value : Value) { values << value; "?" },
        ->(name : String) { nil }, query.join_clauses)
      rendered = renderer.render_where_fields(query.where_fields)
      if rendered.is_a?(ErrorBase)
        self.defer(rendered)
      else
        own_where_fields << {join: :or, stmt: "(#{rendered})", values: values}
      end
    end
    self
  end

  # One keyword condition: an Array becomes IN, anything else equality.
  protected def add_condition(join : Symbol, field : String, value : T) : self forall T
    if value.is_a?(Range)
      add_range_condition(join, field, value)
    elsif value.is_a?(Array)
      add_value_array_condition(join, field, value)
    else
      own_where_fields << {join: join, field: field, operator: :eq, value: to_bind(value)}
      self
    end
  end

  private def add_array_condition(join : Symbol, field : String, operator : Symbol, values : Array(T)) : self forall T
    bound = [] of Value
    values.each { |item| bound << to_value(item) }
    has_nil = bound.any? { |item| item.nil? }
    without_nil = bound.reject { |item| item.nil? }

    if without_nil.empty?
      if has_nil
        safe_field = structured_field_sql(field)
        return self if safe_field.nil?
        own_where_fields << {join: join, stmt: "#{safe_field} IS #{operator == :nin ? "NOT " : ""}NULL", value: nil.as(Bind)}
      else
        own_where_fields << {join: join, stmt: operator == :nin ? "1=1" : "1=0", value: nil.as(Bind)}
      end
      return self
    end

    unless has_nil
      own_where_fields << {join: join, field: field, operator: operator, value: without_nil.as(Bind)}
      return self
    end

    safe_field = structured_field_sql(field)
    return self if safe_field.nil?
    placeholders = without_nil.map { "?" }.join(", ")
    predicate = if operator == :nin
                  "(#{safe_field} NOT IN (#{placeholders}) AND #{safe_field} IS NOT NULL)"
                else
                  "(#{safe_field} IN (#{placeholders}) OR #{safe_field} IS NULL)"
                end
    own_where_fields << {join: join, stmt: predicate, values: without_nil}
    self
  end

  # The quoted column of a structured condition, or nil (with the error
  # deferred) for a field this model does not have.
  private def structured_field_sql(field : String) : String?
    parts = field.split('.')
    unless (parts.size == 1 || parts.size == 2) && parts.all? { |part| JoinSupport.identifier?(part) }
      self.defer(ArgumentError.new("Invalid query field #{field.inspect}"))
      return nil
    end
    column = parts.last
    qualifier = parts.size == 2 ? parts.first : nil
    if qualifier.nil? || qualifier == Model.table_name
      unless Model.fields.includes?(column)
        self.defer(ArgumentError.new("Unknown query field #{column.inspect} for #{Model.to_s}"))
        return nil
      end
    end
    if !qualifier.nil?
      "#{Model.quote(qualifier)}.#{Model.quote(column)}"
    elsif !@join_clauses.empty?
      "#{Model.quote(Model.table_name)}.#{Model.quote(column)}"
    else
      Model.quote(column)
    end
  end

  # ---- ORDER / GROUP -----------------------------------------------------

  def order_in_place(field : Symbol | String) : self
    own_order_fields << {field: field.to_s, direction: Sort::Ascending}
    self
  end

  def order_in_place(fields : Array(Symbol)) : self
    fields.each { |field| order_in_place(field) }
    self
  end

  def order_in_place(**dsl) : self
    dsl.each { |field, direction| add_order(field.to_s, direction) }
    self
  end

  def order_in_place(dsl : Hash(K, V)) : self forall K, V
    dsl.each { |field, direction| add_order(field.to_s, direction) }
    self
  end

  private def add_order(field : String, direction : T) : Nil forall T
    sort = direction.to_s.downcase == "desc" ? Sort::Descending : Sort::Ascending
    own_order_fields << {field: field, direction: sort}
    nil
  end

  def order(field : Symbol | String) : self
    chain_copy.order_in_place(field)
  end

  def order(fields : Array(Symbol)) : self
    chain_copy.order_in_place(fields)
  end

  def order(**dsl) : self
    chain_copy.order_in_place(**dsl)
  end

  def order(dsl : Hash(K, V)) : self forall K, V
    chain_copy.order_in_place(dsl)
  end

  def group_by_in_place(field : Symbol | String) : self
    if field.is_a?(String)
      stripped = ::Grant::Query::SqlExpression.validate_strict(field, "GROUP BY expression")
      if stripped.is_a?(ErrorBase)
        self.defer(stripped)
        return self
      end
      own_group_fields << {field: stripped.as(String)}
    else
      own_group_fields << {field: field.to_s}
    end
    self
  end

  def group_by_in_place(fields : Array(Symbol)) : self
    fields.each { |field| group_by_in_place(field) }
    self
  end

  def group_by(field : Symbol | String) : self
    chain_copy.group_by_in_place(field)
  end

  def group_by(fields : Array(Symbol)) : self
    chain_copy.group_by_in_place(fields)
  end

  def reorder_in_place(field : Symbol) : self
    clear_order_fields
    order_in_place(field)
  end

  def reorder_in_place(fields : Array(Symbol)) : self
    clear_order_fields
    order_in_place(fields)
  end

  def reorder_in_place(**dsl) : self
    clear_order_fields
    order_in_place(**dsl)
  end

  def reorder_in_place(none : Nil) : self
    clear_order_fields
    self
  end

  def reorder(field : Symbol) : self
    chain_copy.reorder_in_place(field)
  end

  def reorder(fields : Array(Symbol)) : self
    chain_copy.reorder_in_place(fields)
  end

  def reorder(**dsl) : self
    chain_copy.reorder_in_place(**dsl)
  end

  def reorder(none : Nil) : self
    chain_copy.reorder_in_place(none)
  end

  def reverse_order_in_place : self
    reset_load_state
    if @order_fields.empty?
      implicit_order_columns.each { |column| own_order_fields << {field: column, direction: Sort::Descending} }
      return self
    end
    @order_fields = @order_fields.map { |field| {field: field[:field], direction: field[:direction].reverse} }
    self
  end

  def reverse_order : self
    chain_copy.reverse_order_in_place
  end

  def regroup_in_place(*fields : Symbol) : self
    clear_group_fields
    fields.each { |field| group_by_in_place(field) }
    self
  end

  def regroup(*fields : Symbol) : self
    copy = chain_copy
    copy.clear_group_fields
    fields.each { |field| copy.group_by_in_place(field) }
    copy
  end

  def reselect_in_place(*columns : Symbol) : self
    reset_load_state
    @select_columns = columns.to_a.map { |column| column.to_s }
    self
  end

  def reselect(*columns : Symbol) : self
    copy = chain_copy
    copy.select_columns = columns.to_a.map { |column| column.to_s }
    copy
  end

  # Replaces the conditions on the named columns with the given ones.
  def rewhere_in_place(**matches) : self
    names = [] of String
    matches.each { |field, _| names << field.to_s }
    unscope_where_columns(names)
    where_in_place(**matches)
  end

  def rewhere(**matches) : self
    chain_copy.rewhere_in_place(**matches)
  end

  protected def unscope_where_columns(names : Array(String)) : Nil
    kept = @where_fields.reject do |field|
      case field
      when StructuredWhere
        names.includes?(field[:field]) || names.includes?(field[:field].split('.').last)
      else
        false
      end
    end
    clear_where_fields
    own_where_fields.concat(kept)
    nil
  end

  # ---- LOCK / JOINS / DISTINCT / HAVING / NONE ----------------------------

  def lock_in_place(mode : LockMode? = LockMode::Update) : self
    reset_load_state
    @lock_mode = mode
    self
  end

  def lock(mode : LockMode = LockMode::Update) : self
    chain_copy.lock_in_place(mode)
  end

  def joins_in_place(table : String, *, on : String) : self
    own_join_clauses << {type: :inner, table: table, on: on}
    self
  end

  def joins(table : String, *, on : String) : self
    chain_copy.joins_in_place(table, on: on)
  end

  def left_joins_in_place(table : String, *, on : String) : self
    own_join_clauses << {type: :left, table: table, on: on}
    self
  end

  def left_joins(table : String, *, on : String) : self
    chain_copy.left_joins_in_place(table, on: on)
  end

  # A raw JOIN fragment, emitted as written.
  def joins_in_place(fragment : String) : self
    own_join_clauses << {type: :raw, table: "", on: fragment}
    self
  end

  def joins(fragment : String) : self
    chain_copy.joins_in_place(fragment)
  end

  def distinct_in_place(value : Bool = true) : self
    reset_load_state
    @distinct = value
    self
  end

  def distinct(value : Bool = true) : self
    chain_copy.distinct_in_place(value)
  end

  def having_in_place(stmt : String) : self
    own_having_clauses << {stmt: stmt, value: nil.as(Bind)}
    self
  end

  def having_in_place(stmt : String, value : T) : self forall T
    own_having_clauses << {stmt: stmt, value: to_bind(value)}
    self
  end

  def having(stmt : String) : self
    chain_copy.having_in_place(stmt)
  end

  def having(stmt : String, value : T) : self forall T
    chain_copy.having_in_place(stmt, value)
  end

  def none_in_place : self
    reset_load_state
    @is_none = true
    self
  end

  def none : self
    chain_copy.none_in_place
  end

  def offset_in_place(num : Int32 | Int64 | Nil) : self
    reset_load_state
    @offset = num.nil? ? nil : num.to_i64
    self
  end

  def offset(num : Int32 | Int64 | Nil) : self
    chain_copy.offset_in_place(num)
  end

  def limit_in_place(num : Int32 | Int64 | Nil) : self
    reset_load_state
    @limit = num.nil? ? nil : num.to_i64
    self
  end

  def limit(num : Int32 | Int64 | Nil) : self
    chain_copy.limit_in_place(num)
  end

  # ---- UNSCOPE / ONLY / EXCEPT --------------------------------------------

  RELATION_COMPONENTS = [:where, :order, :limit, :offset, :group, :having, :joins, :left_joins, :select, :distinct, :lock, :from, :with,
                         :includes, :preload, :eager_load, :strict_loading, :readonly, :optimizer_hints, :annotate, :create_with, :reordering, :extending]

  def unscope_in_place(*components : Symbol) : self
    unscope_components_in_place(components.to_a)
  end

  def unscope(*components : Symbol) : self
    chain_copy.unscope_components_in_place(components.to_a)
  end

  protected def unscope_components_in_place(components : Array(Symbol)) : self
    reset_load_state
    components.each do |component|
      case component
      when :where              then clear_where_fields
      when :order              then clear_order_fields
      when :limit              then @limit = nil
      when :offset             then @offset = nil
      when :group, :group_by   then clear_group_fields
      when :having             then clear_having_clauses
      when :joins              then @join_clauses = @join_clauses.select { |clause| clause[:type] == :left }
      when :left_joins, :left_outer_joins then @join_clauses = @join_clauses.reject { |clause| clause[:type] == :left }
      when :select             then @select_columns = nil
      when :distinct           then @distinct = false
      when :lock               then @lock_mode = nil
      when :readonly           then @readonly = false
      when :strict_loading     then @strict_loading = false
      when :optimizer_hints    then @optimizer_hint_list = EmptyClauses::OPTIMIZER_HINTS
      when :annotate           then @annotation_comment = nil
      when :from               then @from_source = nil
      when :with               then @with_source = nil
      when :includes, :preload, :eager_load, :create_with, :reordering, :extending
        nil
      else
        return self.defer(ArgumentError.new("unscope: unknown component #{component.inspect}"))
      end
    end
    self
  end

  def only(*components : Symbol) : self
    normalized = components.to_a.map do |component|
      case component
      when :group_by         then :group
      when :left_outer_joins then :left_joins
      else                        component
      end
    end
    unknown = normalized.reject { |component| RELATION_COMPONENTS.includes?(component) }
    return chain_copy.defer(ArgumentError.new("only: unknown component #{unknown.first.inspect}")) unless unknown.empty?
    dropped = RELATION_COMPONENTS.reject { |component| normalized.includes?(component) }
    chain_copy.unscope_components_in_place(dropped)
  end

  def except(*components : Symbol) : self
    chain_copy.unscope_components_in_place(components.to_a)
  end

  # ---- TERMINALS ----------------------------------------------------------

  # The assembler's executor for *build*, or the error a chain step or the
  # assembler deferred.
  protected def prepared(&block : ::Grant::Query::Assembler::Base(Model, Builder(Model)) -> E) : E | ErrorBase forall E
    failure = @deferred_error
    return failure unless failure.nil?
    query_assembler = assembler
    executor = yield query_assembler
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    executor
  end

  # SELECT projection: only these columns (upstream `select(*columns)`).
  def select(*columns : Symbol | String) : self
    copy = chain_copy
    copy.select_columns = columns.to_a.map { |column| column.to_s }
    copy
  end

  def select : Array(Model) | ErrorBase
    return [] of Model if is_none?
    prepared { |query_assembler| query_assembler.select }!.run
  end

  def all : self
    chain_copy
  end

  def load : self | ErrorBase
    records!
    self
  end

  def loaded? : Bool
    !@records.nil?
  end

  def records : Array(Model) | ErrorBase
    memoized = @records
    return memoized unless memoized.nil?
    loaded = self.select!
    @records = loaded
    loaded
  end

  def reset : self
    reset_load_state
    self
  end

  def reload : self | ErrorBase
    reset
    load
  end

  def to_a : Array(Model) | ErrorBase
    records
  end

  def raw_sql : String
    assembler.select.raw_sql
  end

  def to_sql : String
    raw_sql
  end

  def explain(analyze : Bool = false) : String | ErrorBase
    query_assembler = assembler
    sql = "#{query_assembler.explain_keyword(analyze)} #{query_assembler.explain_select_sql}"
    params = query_assembler.numbered_parameters
    rows = ::Grant::Query::Executor.open_statement(Model.adapter, sql, params) { |db| db.query(sql, params) }!
    rows.map { |row| row.values.map { |value| value.nil? ? "" : value.to_s }.join(" | ") }.join("\n")
  end

  def first : Model | Nil | ErrorBase
    memoized = @records
    return memoized.first? unless memoized.nil?
    first_records_from(0, 1)!.first?
  end

  def first(n : Int32) : Array(Model) | ErrorBase
    memoized = @records
    return memoized.first(n) unless memoized.nil?
    first_records_from(0, n)
  end

  def first_strict : Model | RecordNotFound | ErrorBase
    record = first!
    return RecordNotFound.new(Model.to_s, "first") if record.nil?
    record
  end

  def take : Model | Nil | ErrorBase
    memoized = @records
    return memoized.first? unless memoized.nil?
    chain_copy.limit_in_place(1).select!.first?
  end

  def take(n : Int32) : Array(Model) | ErrorBase
    memoized = @records
    return memoized.first(n) unless memoized.nil?
    chain_copy.limit_in_place(n).select
  end

  def take_strict : Model | RecordNotFound | ErrorBase
    record = take!
    return RecordNotFound.new("No record found") if record.nil?
    record
  end

  def last : Model | Nil | ErrorBase
    memoized = @records
    return memoized.last? unless memoized.nil?
    return ordered_copy(false).select!.last? if limit_or_offset?
    ordered_copy(true).limit_in_place(1).select!.first?
  end

  def last(n : Int32) : Array(Model) | ErrorBase
    memoized = @records
    return memoized.reversed.first(n).reversed unless memoized.nil?
    return ordered_copy(false).select!.reversed.first(n).reversed if limit_or_offset?
    ordered_copy(true).limit_in_place(n).select!.reversed
  end

  def last_strict : Model | RecordNotFound | ErrorBase
    record = last!
    return RecordNotFound.new(Model.to_s, "last") if record.nil?
    record
  end

  def second : Model | Nil | ErrorBase
    nth_record(1)
  end

  def third : Model | Nil | ErrorBase
    nth_record(2)
  end

  def fourth : Model | Nil | ErrorBase
    nth_record(3)
  end

  def fifth : Model | Nil | ErrorBase
    nth_record(4)
  end

  def forty_two : Model | Nil | ErrorBase
    nth_record(41)
  end

  def second_to_last : Model | Nil | ErrorBase
    nth_record_from_end(1)
  end

  def third_to_last : Model | Nil | ErrorBase
    nth_record_from_end(2)
  end

  private def nth_record(index : Int32) : Model | Nil | ErrorBase
    memoized = @records
    return memoized[index]? unless memoized.nil?
    first_records_from(index, 1)!.first?
  end

  private def nth_record_from_end(index : Int32) : Model | Nil | ErrorBase
    memoized = @records
    unless memoized.nil?
      position = memoized.size - 1 - index
      return position >= 0 ? memoized[position] : nil
    end
    if limit_or_offset?
      window = ordered_copy(false).select!
      position = window.size - 1 - index
      return position >= 0 ? window[position] : nil
    end
    ordered_copy(true).offset_in_place(index).limit_in_place(1).select!.first?
  end

  private def first_records_from(index : Int32, count : Int32) : Array(Model) | ErrorBase
    effective = count.to_i64
    window = @limit
    effective = window - index if !window.nil? && window - index < effective
    return [] of Model if effective <= 0
    copy = ordered_copy(false)
    copy.offset_in_place((@offset || 0_i64) + index) unless index == 0
    copy.limit_in_place(effective).select
  end

  private def limit_or_offset? : Bool
    !@limit.nil? || !@offset.nil?
  end

  private def ordered_copy(reverse : Bool) : self
    copy = chain_copy
    copy.apply_ordered_finder_order(reverse)
    copy
  end

  protected def apply_ordered_finder_order(reverse : Bool) : Nil
    if @order_fields.empty?
      direction = reverse ? Sort::Descending : Sort::Ascending
      implicit_order_columns.each { |column| own_order_fields << {field: column, direction: direction} }
    elsif reverse
      reverse_order_in_place
    end
    nil
  end

  def implicit_order_columns : Array(String)
    columns = Model.implicit_order_columns.dup
    columns << Model.primary_name unless columns.includes?(Model.primary_name)
    columns
  end

  private def probe_row_count(limit : Int32) : Int32 | ErrorBase
    return 0 if is_none?
    memoized = @records
    return (memoized.size < limit ? memoized.size : limit) unless memoized.nil?
    probe = chain_copy
    probe.clear_order_fields
    probe_limit = @limit || limit.to_i64
    probe.limit_in_place(probe_limit < limit.to_i64 ? probe_limit : limit.to_i64)
    probe.ids!.size
  end

  def empty? : Bool | ErrorBase
    probe_row_count(1)! == 0
  end

  def any? : Bool | ErrorBase
    probe_row_count(1)! > 0
  end

  def none? : Bool | ErrorBase
    empty?
  end

  def many? : Bool | ErrorBase
    probe_row_count(2)! > 1
  end

  def one? : Bool | ErrorBase
    probe_row_count(2)! == 1
  end

  def sole : Model | RecordNotFound | ErrorBase
    memoized = @records
    results = memoized.nil? ? chain_copy.limit_in_place(2).select! : memoized
    return NotFound.new("No record found") if results.empty?
    return NotUnique.new("Multiple records found (expected exactly one)") if results.size > 1
    results.first
  end

  def delete : Mutation | ErrorBase
    return Mutation.new(0_i64, 0_i64) if is_none?
    Model.mark_write_operation
    query_assembler = prepared { |built| built }!
    sql = query_assembler.delete_sql
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    params = query_assembler.numbered_parameters
    ::Grant::Query::Executor.open_statement(Model.adapter, sql, params) { |db| db.exec(sql, params) }
  end

  def delete_all : Int64 | ErrorBase
    delete!.changes
  end

  def count : CountResult | ErrorBase
    unless @group_fields.empty?
      return empty_group_count if is_none?
      return shape_group_count(prepared { |query_assembler| query_assembler.grouped_count }!.run!)
    end
    return 0_i64 if is_none?
    prepared { |query_assembler| query_assembler.count }!.run
  end

  private def shape_group_count(results : Hash(Array(Value), Int64)) : CountResult
    if @group_fields.size == 1
      counts = {} of Value => Int64
      results.each { |key, count| counts[key.first] = count }
      counts
    else
      results
    end
  end

  private def empty_group_count : CountResult
    if @group_fields.size == 1
      {} of Value => Int64
    else
      {} of Array(Value) => Int64
    end
  end

  def exists? : Bool | ErrorBase
    return false if is_none?
    prepared { |query_assembler| query_assembler.exists? }!.run
  end

  def size : Int64 | ErrorBase
    memoized = @records
    return memoized.size.to_i64 unless memoized.nil?
    result = count!
    result.is_a?(Int64) ? result : result.values.sum
  end

  def each(&block : Model -> T) : Nil | ErrorBase forall T
    records!.each { |record| yield record }
    nil
  end

  # Enumerable projection over the memoized relation records.
  def map(&block : Model -> T) : Array(T) | ErrorBase forall T
    records!.map { |record| yield record }
  end

  def ids : Array(Value) | ErrorBase
    return [] of Value if is_none?
    pluck_columns([Model.primary_name])!.map { |row| row.first }
  end

  # Grant::Query::Builder convenience methods project values without model
  # hydration. Keep positional results, including nil values and repeated
  # fields.
  def pluck(*fields : Symbol | String) : Array(Array(Value)) | ErrorBase
    pluck_columns(fields.to_a.map { |field| field.to_s })
  end

  def pluck_columns(field_names : Array(String)) : Array(Array(Value)) | ErrorBase
    return [] of Array(Value) if is_none?
    query_assembler = prepared { |built| built }!
    sql = query_assembler.pluck_sql(field_names)
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    ::Grant::Query::Executor::Pluck(Model).new(sql, query_assembler.numbered_parameters, field_names).run
  end

  def pick(*fields : Symbol | String) : Array(Value) | Nil | ErrorBase
    chain_copy.limit_in_place(1).pluck_columns(fields.to_a.map { |field| field.to_s })!.first?
  end

  def find_by(**criteria) : Model | Nil | ErrorBase
    chain_copy.where_in_place(**criteria).first
  end

  def find_by_strict(**criteria) : Model | RecordNotFound | ErrorBase
    record = find_by(**criteria)!
    if record.nil?
      parts = [] of String
      criteria.each do |key, value|
        parts << (value.nil? ? "#{key} is NULL" : "#{key} = #{value}")
      end
      return NotFound.new("No #{Model} found where #{parts.join(" and ")}")
    end
    record
  end

  # ---- helpers used by the aggregation, batch and update traits ----------

  # Runs an aggregate projection: the GROUP BY keys, then *function*.
  protected def aggregate_rows(function : String, column : String) : Array(Tuple(Array(Value), Value)) | ErrorBase
    query_assembler = prepared { |built| built }!
    fields = [] of String
    @group_fields.each_with_index do |field, index|
      fields << "#{field[:field]} AS \"grant_group_#{index}\""
    end
    aggregate = "#{function}(#{column})"
    aggregate = "CAST(#{aggregate} AS DOUBLE PRECISION)" if function == "AVG" && Model.adapter.postgres?
    fields << "#{aggregate} AS \"grant_aggregate\""
    sql = query_assembler.build_sql([
      query_assembler.with_clause, "#{query_assembler.select_prefix} #{fields.join(", ")}", query_assembler.from_clause,
      query_assembler.joins, query_assembler.where, query_assembler.group_by, query_assembler.having,
      @group_fields.empty? ? nil : query_assembler.order(false), query_assembler.limit, query_assembler.offset,
    ] of String?)
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    ::Grant::Query::Executor::Aggregate(Model).new(sql, query_assembler.numbered_parameters, @group_fields.size).run
  end

  protected def next_batch_rows(last_value : Value, batch_size : Int32) : Array(::Grant::Adapter::Driver::Row) | ErrorBase
    relation = chain_copy
    relation.where_in_place("#{Model.quote(Model.primary_name)} > ?", last_value) unless last_value.nil?
    relation.offset_in_place(nil) unless last_value.nil?
    relation.clear_order_fields
    relation.order_in_place(Model.primary_name)
    relation.limit_in_place(batch_size)
    query_assembler = relation.prepared { |built| built }!
    sql = query_assembler.select.raw_sql
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    params = query_assembler.numbered_parameters
    ::Grant::Query::Executor.open_statement(Model.adapter, sql, params) { |db| db.query(sql, params) }
  end

  # UPDATE ... SET for the relation's rows.
  def update_all(assignments : Array(Tuple(String, Value))) : Int64 | ErrorBase
    return 0_i64 if is_none?
    Model.mark_write_operation
    query_assembler = prepared { |built| built }!
    sql = query_assembler.update_all_sql(assignments)
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    params = query_assembler.numbered_parameters
    ::Grant::Query::Executor.open_statement(Model.adapter, sql, params) { |db| db.exec(sql, params) }!.changes
  end

  def update_all(fragment : String) : Int64 | ErrorBase
    return 0_i64 if is_none?
    Model.mark_write_operation
    query_assembler = prepared { |built| built }!
    sql = query_assembler.update_all_fragment_sql(fragment)
    assembled_error = query_assembler.error
    return assembled_error unless assembled_error.nil?
    params = query_assembler.numbered_parameters
    ::Grant::Query::Executor.open_statement(Model.adapter, sql, params) { |db| db.exec(sql, params) }!.changes
  end
end

impl Batches(Model) for Builder(Model) forall Model
end

impl QueryExtensions(Model) for Builder(Model) forall Model
end

impl Aggregations(Model) for Builder(Model) forall Model
end

impl Grouping(Model) for Builder(Model) forall Model
end

impl RelationMerging(Model) for Builder(Model) forall Model
end

impl ExistenceEnumerable(Model) for Builder(Model) forall Model
end

impl WhereChainMethods(Model) for Builder(Model) forall Model
end

impl WhereComposition(Model) for Builder(Model) forall Model
end
