module grant/query/extract_associated

import grant/base::{Base}
import grant/query/builder::{Builder}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase, ArgumentError}
import std/set

pub trait ExtractAssociated(Model)
  def extract_associated(association : Symbol) : Array(Base) | ErrorBase
    loaded = preload(association).select!
    seen = Set(Tuple(String, Value)).new
    extracted = [] of Base
    loaded.each do |record|
      members = record.get_loaded_association(association.to_s)
      next if members.nil?
      members.each do |member|
        key = {member.class.to_s, member.__primary_value}
        next if seen.includes?(key)
        seen << key
        extracted << member
      end
    end
    extracted
  end

  def extract_associated(association : Symbol, as type : T.class) : Array(T) | ErrorBase forall T
    extracted = [] of T
    extract_associated(association)!.each do |record|
      typed = record.as?(T)
      return ArgumentError.new("extract_associated(#{association.inspect}) found a #{record.class}, not #{T}") if typed.nil?
      extracted << typed
    end
    extracted
  end
end

impl ExtractAssociated(Model) for Builder(Model) forall Model
end
