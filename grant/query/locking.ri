module grant/query/locking
import grant/locking/clause::{Clause}
import grant/locking::{LockMode}

pub trait Locking(Model)
  def lock_in_place(clause : Clause) : self
    lock_in_place(nil)
    self.lock_clause = clause
    self
  end

  def lock_in_place(enabled : Bool) : self
    enabled ? lock_in_place : unlock_in_place
  end

  def unlock_in_place : self
    lock_in_place(nil)
    self
  end

  def lock(clause : Clause) : self
    chain_copy.lock_in_place(clause)
  end

  def lock(enabled : Bool) : self
    chain_copy.lock_in_place(enabled)
  end

  def unlock : self
    chain_copy.unlock_in_place
  end
end

