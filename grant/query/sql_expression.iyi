module grant/query/sql_expression

import std/text
import std/regex
import grant/query/join_support
import grant/error::{ArgumentError}

pub def validate_strict(sql : String, kind : String = "SQL expression") : String | ArgumentError
  stripped = sql.strip
  return ArgumentError.new("#{kind} cannot be blank") if stripped.empty?

  chars = stripped.chars
  quote : Char? = nil
  depth = 0
  index = 0
  while index < chars.size
    char = chars[index]
    following = chars[index + 1]?
    if current = quote
      # A doubled quote character stays inside the literal.
      if char == current
        if following == current
          index += 1
        else
          quote = nil
        end
      end
    elsif char == '\'' || char == '"' || char == '`'
      quote = char
    elsif char == ';'
      return ArgumentError.new("#{kind} cannot contain a statement separator: #{stripped.inspect}")
    elsif (char == '-' && following == '-') || (char == '/' && following == '*') || (char == '*' && following == '/')
      return ArgumentError.new("#{kind} cannot contain a comment marker: #{stripped.inspect}")
    elsif char == '('
      depth += 1
    elsif char == ')'
      depth -= 1
      return ArgumentError.new("#{kind} has unbalanced parentheses: #{stripped.inspect}") if depth < 0
    end
    index += 1
  end

  return ArgumentError.new("#{kind} has an unterminated quote: #{stripped.inspect}") unless quote.nil?
  return ArgumentError.new("#{kind} has unbalanced parentheses: #{stripped.inspect}") unless depth == 0

  stripped
end

pub struct Trusted
  getter sql : String
  def initialize(@sql : String)
  end
end

pub def split_terms(sql : String) : Array(String)
  terms = [] of String
  current = ""
  depth = 0
  quote : Char? = nil
  sql.each_char do |char|
    if current_quote = quote
      quote = nil if char == current_quote
      current += char.to_s
    elsif char == '\'' || char == '"' || char == '`'
      quote = char
      current += char.to_s
    elsif char == '('
      depth += 1
      current += char.to_s
    elsif char == ')'
      depth -= 1
      current += char.to_s
    elsif char == ',' && depth == 0
      terms << current.strip
      current = ""
    else
      current += char.to_s
    end
  end
  terms << current.strip
  terms.reject(&.empty?)
end

pub def identifier?(text : String) : Bool
  parts = text.split('.')
  (parts.size == 1 || parts.size == 2) && parts.all? { |part| ::Grant::Query::JoinSupport::JoinSupport.identifier?(part) }
end

pub def column_function?(text : String) : Bool
  !/^[a-z_][a-z0-9_]*\(\s*([a-z_][a-z0-9_.]*(\s*,\s*[a-z_][a-z0-9_.]*)*)?\s*\)(\s+(asc|desc))?(\s+nulls\s+(first|last))?$/.find(text.strip.downcase).nil?
end
