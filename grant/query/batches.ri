module grant/query/batches

import std/iterator::{Iterator, Stop}
import grant/adapter/driver::{Value}
import grant/query/bind_value
import grant/errors::{DatabaseError, ErrorBase}

import grant/error::{ArgumentError}
import grant/query/where_field::{Sort}

# State for the upstream keyset batch scan. Each page follows all cursor columns.
pub class BatchOptionIgnoredError < ErrorBase
end

pub class BatchPlan
  property start : Value = nil
  property finish : Value = nil
  property bound_index : Int32 = 0
  getter size : Int32
  getter fields : Array(String)
  getter ascending : Array(Bool)
  getter limit : Int64?
  getter offset : Int64?

  def initialize(@size : Int32, @fields : Array(String), @ascending : Array(Bool),
                 @limit : Int64?, @offset : Int64?)
  end
end

pub class BatchPosition
  property last_values : Array(Value)? = nil
  property remaining : Int64?
  property started : Bool = false
  property finished : Bool = false

  def initialize(plan : BatchPlan)
    @remaining = plan.limit
  end
end

# Native Iterator has an infallible next protocol; options are checked before construction.
pub class RecordBatchIterator(Model, Query)
  @position : BatchPosition
  def initialize(@relation : Query, @plan : BatchPlan)
    @position = BatchPosition.new(@plan)
  end
  def next : Array(Model) | Stop
    records = @relation.next_batch_records(@plan, @position).or_panic
    records.nil? ? Stop.new : records
  end
  def rewind : self
    @position = BatchPosition.new(@plan)
    self
  end
end
impl Iterator for RecordBatchIterator(Model, Query) forall Model, Query
  type Elem = Array(Model)
end

pub class RecordIterator(Model, Query)
  @batch = [] of Model
  @index : Int32 = 0
  def initialize(@batches : RecordBatchIterator(Model, Query))
  end
  def next : Model | Stop
    if @index >= @batch.size
      batch = @batches.next
      return batch if batch.is_a?(Stop)
      @batch = batch
      @index = 0
    end
    record = @batch[@index]
    @index += 1
    record
  end
  def rewind : self
    @batches.rewind
    @batch.clear
    @index = 0
    self
  end
end
impl Iterator for RecordIterator(Model, Query) forall Model, Query
  type Elem = Model
end

pub class RelationBatchIterator(Model, Query)
  @position : BatchPosition
  def initialize(@relation : Query, @plan : BatchPlan, @load : Bool)
    @position = BatchPosition.new(@plan)
  end
  def next : Query | Stop
    relation = @relation.next_batch_relation(@plan, @position, @load).or_panic
    relation.nil? ? Stop.new : relation
  end
  def rewind : self
    @position = BatchPosition.new(@plan)
    self
  end
end
impl Iterator for RelationBatchIterator(Model, Query) forall Model, Query
  type Elem = Query
end

pub trait Batches(Model)
  DEFAULT_BATCH_SIZE = 1000

  def each_streamed(&block : Model -> T) : Nil | ErrorBase forall T
    rows = self.select!
    rows.each { |record| yield record }
    nil
  end

  def find_in_batches(batch_size : Int32 = DEFAULT_BATCH_SIZE, &block : Array(Model) -> T) : Nil | T | ErrorBase forall T
    plan = batch_plan(batch_size)!
    position = BatchPosition.new(plan)
    loop do
      records = next_batch_records(plan, position)!
      break if records.nil?
      result = yield records
      return result if result.is_a?(::Error)
    end
    nil
  end

  def find_each(batch_size : Int32 = DEFAULT_BATCH_SIZE, &block : Model -> T) : Nil | T | ErrorBase forall T
    find_in_batches(batch_size) do |batch|
      batch.each do |record|
        result = yield record
        return result if result.is_a?(::Error)
      end
      nil
    end
  end
  def find_in_batches(batch_size : Int32 = DEFAULT_BATCH_SIZE, start : Value = nil,
      finish : Value = nil, cursor : Array(Symbol)? = nil, order : Symbol = :asc,
      error_on_ignore : Bool = false) : RecordBatchIterator(Model, self) | ErrorBase
    plan = batch_plan_with_options(batch_size, start, finish, cursor, order, error_on_ignore)!
    RecordBatchIterator(Model, self).new(chain_copy, plan)
  end

  def find_each(batch_size : Int32 = DEFAULT_BATCH_SIZE, start : Value = nil,
      finish : Value = nil, cursor : Array(Symbol)? = nil, order : Symbol = :asc,
      error_on_ignore : Bool = false) : RecordIterator(Model, self) | ErrorBase
    batches = find_in_batches(batch_size, start, finish, cursor, order, error_on_ignore)!
    RecordIterator(Model, self).new(batches)
  end

  def find_in_batches(batch_size : Int32 = DEFAULT_BATCH_SIZE, **options,
      &block : Array(Model) -> T) : Nil | T | ErrorBase forall T
    plan = batch_plan_with_options(batch_size, **options)!
    position = BatchPosition.new(plan)
    loop do
      records = next_batch_records(plan, position)!
      break if records.nil?
      result = yield records
      return result if result.is_a?(::Error)
    end
    nil
  end

  def find_each(batch_size : Int32 = DEFAULT_BATCH_SIZE, **options,
      &block : Model -> T) : Nil | T | ErrorBase forall T
    find_in_batches(batch_size, **options) do |batch|
      batch.each do |record|
        result = yield record
        return result if result.is_a?(::Error)
      end
      nil
    end
  end

  private def batch_plan_with_options(batch_size : Int32, start : Value = nil, finish : Value = nil,
      cursor : Array(Symbol)? = nil, order : Symbol = :asc,
      error_on_ignore : Bool = false) : BatchPlan | ErrorBase
    return ArgumentError.new("batch_size must be >= 1") if batch_size < 1
    return ArgumentError.new("order must be :asc or :desc") unless order == :asc || order == :desc
    fields = [] of String
    ascending = [] of Bool
    if requested = cursor
      return ArgumentError.new("cursor must name at least one column") if requested.empty?
      if error_on_ignore && !order_fields.empty?
        return BatchOptionIgnoredError.new("cursor: overrides the ORDER BY of this #{Model} relation")
      end
      requested.each { |field| fields << field.to_s; ascending << (order == :asc) }
    elsif !order_fields.empty?
      plan = batch_plan(batch_size)!
      plan.start = start
      plan.finish = finish
      plan.bound_index = plan.fields.index { |field| field.split('.').last == Model.primary_name } || 0
      return plan
    else
      implicit_order_columns.each { |field| fields << field; ascending << (order == :asc) }
    end
    plan = BatchPlan.new(batch_size, fields, ascending, limit, offset)
    plan.start = start
    plan.finish = finish
    plan.bound_index = fields.index { |field| field.split('.').last == Model.primary_name } || 0
    plan
  end

  private def batch_plan(batch_size : Int32) : BatchPlan | ErrorBase
    return ArgumentError.new("batch_size must be >= 1") if batch_size < 1
    fields = [] of String
    ascending = [] of Bool
    if order_fields.empty?
      implicit_order_columns.each { |column| fields << column; ascending << true }
    else
      order_fields.each do |field|
        direction = field[:direction]
        return ArgumentError.new("Cannot batch #{Model} by a raw ORDER BY term") if direction == Sort::Raw
        fields << field[:field]
        ascending << !direction.sorts_descending?
      end
      unless fields.any? { |field| field.split('.').last == Model.primary_name }
        fields << Model.primary_name
        ascending << true
      end
    end
    BatchPlan.new(batch_size, fields, ascending, limit, offset)
  end

  def next_batch_records(plan : BatchPlan, position : BatchPosition) : Array(Model)? | ErrorBase
    return nil if position.finished || is_none?
    remaining = position.remaining
    return nil if !remaining.nil? && remaining <= 0
    page_size = !remaining.nil? && remaining < plan.size ? remaining.to_i32 : plan.size
    records = batch_page(plan, position, page_size).select!
    position.started = true
    unless records.empty?
      last = records.last
      values = [] of Value
      plan.fields.each do |field|
        value = last.read_attribute(field.split('.').last)!
        return ArgumentError.new("Cannot batch #{Model} by #{field}: a row has NULL there") if value.nil?
        values << ::Grant::Query::BindValue.to_value(value)
      end
      position.last_values = values
    end
    position.remaining = remaining - records.size unless remaining.nil?
    position.finished = records.size < page_size || records.empty?
    records.empty? ? nil : records
  end

  private def batch_page(plan : BatchPlan, position : BatchPosition, page_size : Int32) : self
    page = chain_copy
    page.clear_order_fields
    plan.fields.each_with_index do |field, index|
      direction = plan.ascending[index] ? Sort::Ascending : Sort::Descending
      page.own_order_fields << {field: field, direction: direction}
    end
    page.limit_in_place(page_size)
    page.offset_in_place(nil) if position.started
    bound = plan.fields[plan.bound_index]
    ascending = plan.ascending[plan.bound_index]
    page.where_in_place(bound, ascending ? :gteq : :lteq, plan.start) unless plan.start.nil?
    page.where_in_place(bound, ascending ? :lteq : :gteq, plan.finish) unless plan.finish.nil?
    last = position.last_values
    unless last.nil?
      statement, values = keyset_condition(plan, last)
      page.and_in_place(statement, values)
    end
    page
  end

  private def keyset_condition(plan : BatchPlan, last : Array(Value)) : Tuple(String, Array(Value))
    alternatives = [] of String
    values = [] of Value
    plan.fields.each_with_index do |field, index|
      terms = [] of String
      index.times do |earlier|
        terms << "#{Model.quote(plan.fields[earlier])} = ?"
        values << last[earlier]
      end
      terms << "#{Model.quote(field)} #{plan.ascending[index] ? ">" : "<"} ?"
      values << last[index]
      alternatives << "(#{terms.join(" AND ")})"
    end
    {"(#{alternatives.join(" OR ")})", values}
  end

  # Relation-yielding batches retain a separate immutable base relation.
  def in_batches(of batch_size : Int32 = 1000, start : Value = nil, finish : Value = nil, load : Bool = false, order : Symbol = :asc, &block : self -> T) : Nil | ErrorBase forall T
    each_relation_batch(batch_size, start, finish, load, order) { |batch| yield batch }
  end

  def in_batches(of batch_size : Int32 = DEFAULT_BATCH_SIZE, start : Value = nil,
      finish : Value = nil, load : Bool = false, order : Symbol = :asc,
      cursor : Array(Symbol)? = nil, error_on_ignore : Bool = false) : RelationBatchIterator(Model, self) | ErrorBase
    plan = batch_plan_with_options(batch_size, start, finish, cursor, order, error_on_ignore)!
    RelationBatchIterator(Model, self).new(self, plan, load)
  end

  def in_batches(of batch_size : Int32 = DEFAULT_BATCH_SIZE, **options,
      &block : self -> T) : Nil | ErrorBase forall T
    each_relation_batch(batch_size, **options) { |batch| yield batch }
  end

  private def each_relation_batch(batch_size : Int32, start : Value = nil,
      finish : Value = nil, load : Bool = false, order : Symbol = :asc,
      cursor : Array(Symbol)? = nil, error_on_ignore : Bool = false,
      &block : self -> T) : Nil | ErrorBase forall T
    plan = batch_plan_with_options(batch_size, start, finish, cursor, order, error_on_ignore)!
    position = BatchPosition.new(plan)
    loop do
      batch = next_batch_relation(plan, position, load)!
      break if batch.nil?
      result = yield batch
      return result if result.is_a?(ErrorBase)
    end
    nil
  end

  protected def memoized_records=(records : Array(Model)) : Array(Model)
    @records = records
  end

  def next_batch_relation(plan : BatchPlan, position : BatchPosition, load : Bool) : self? | ErrorBase
    if load
      records = next_batch_records(plan, position)!
      return nil if records.nil?
      identities = [] of Value
      records.each do |record|
        identities << ::Grant::Query::BindValue.to_value(record.read_attribute(Model.primary_name)!)
      end
      relation = batch_relation(plan, identities)
      relation.memoized_records = records
      return relation
    end
    return nil if position.finished || is_none?
    remaining = position.remaining
    return nil if !remaining.nil? && remaining <= 0
    page_size = !remaining.nil? && remaining < plan.size ? remaining.to_i32 : plan.size
    columns = plan.fields.map { |field| field.split('.').last }
    names = (columns + [Model.primary_name]).uniq
    rows = batch_page(plan, position, page_size).pluck_columns(names)!
    position.started = true
    unless rows.empty?
      last = rows.last
      values = [] of Value
      columns.each do |column|
        value = last[names.index(column).as(Int32)]
        return ArgumentError.new("Cannot batch #{Model} by #{column}: a row has NULL there") if value.nil?
        values << value
      end
      position.last_values = values
    end
    position.remaining = remaining - rows.size unless remaining.nil?
    position.finished = rows.size < page_size || rows.empty?
    return nil if rows.empty?
    key_index = names.index(Model.primary_name).as(Int32)
    batch_relation(plan, rows.map { |row| row[key_index] })
  end

  private def batch_relation(plan : BatchPlan, identities : Array(Value)) : self
    relation = chain_copy
    relation.clear_order_fields
    plan.fields.each_with_index do |field, index|
      relation.own_order_fields << {field: field, direction: plan.ascending[index] ? Sort::Ascending : Sort::Descending}
    end
    relation.limit_in_place(nil)
    relation.offset_in_place(nil)
    relation.and_in_in_place(Model.primary_name, identities)
    relation
  end

  def destroy_all_records : Array(Model) | ErrorBase
    destroyed = [] of Model
    find_in_batches do |batch|
      Model.transaction do
        batch.each { |record| destroyed << record if record.destroy! }
        nil
      end
    end!
    destroyed
  end

  def destroy_all : Int32 | ErrorBase
    destroy_all_records!.size.to_i32
  end

end
