module grant/query/empty_clauses

import grant/query/where_field::{WhereField, OrderField, GroupField, JoinClause, HavingClause}

# Shared empty lists from upstream query/builder.cr. Writers acquire their own
# list before mutation; untouched? detects accidental writes to the sentinels.
pub class EmptyClauses
  WHERE_FIELDS = [] of WhereField
  DEFAULT_SCOPE_WHERE_FIELDS = [] of WhereField
  ORDER_FIELDS = [] of OrderField
  GROUP_FIELDS = [] of GroupField
  JOIN_CLAUSES = [] of JoinClause
  HAVING_CLAUSES = [] of HavingClause
  OPTIMIZER_HINTS = [] of String

  def self.untouched? : Bool
    WHERE_FIELDS.empty? && DEFAULT_SCOPE_WHERE_FIELDS.empty? && ORDER_FIELDS.empty? &&
      GROUP_FIELDS.empty? && JOIN_CLAUSES.empty? && HAVING_CLAUSES.empty? &&
      OPTIMIZER_HINTS.empty?
  end
end
