module grant/query/relation_rewrites

import grant/query/sql_expression
import grant/query/ordering
import grant/query/where_field::{Sort}
import grant/error::{ErrorBase, ArgumentError}

pub alias ColumnList = Array(Symbol) | Array(String) | Array(Symbol | String)

# The upstream Builder reopening is a native trait.
pub trait RelationRewrites(Model)
  protected def start_reordering_in_place : Nil
    self.reordering = true
    clear_order_fields
    nil
  end

  def reorder_in_place(sql : String | ::Grant::Query::SqlExpression::Trusted) : self
    start_reordering_in_place
    trusted = sql.is_a?(::Grant::Query::SqlExpression::Trusted)
    text = sql.is_a?(::Grant::Query::SqlExpression::Trusted) ? sql.sql : sql
    append_order_terms(text, trusted)
  end

  def reorder_in_place(field : Symbol | String, direction : Symbol, *, nulls : Symbol? = nil) : self
    start_reordering_in_place
    if nulls.nil? && field.is_a?(Symbol) && direction != :asc && direction != :desc
      order_in_place(field)
      order_in_place(direction)
    else
      return self.defer(ArgumentError.new("order direction must be :asc or :desc")) unless direction == :asc || direction == :desc
      name = field.to_s
      unless ::Grant::Query::SqlExpression.identifier?(name)
        return self.defer(ArgumentError.new("order with a direction takes a column name")) unless nulls.nil?
        return append_order_terms("#{name} #{direction.to_s.upcase}", false)
      end
      own_order_fields << {field: name, direction: ::Grant::Query::Ordering::OrderSupport.sort_for(direction.to_s, nulls.nil? ? nil : nulls.to_s)}
    end
    self
  end

  def reorder_in_place(field : Symbol | String, *, nulls : Symbol) : self
    reorder_in_place(field, :asc, nulls: nulls)
  end

  def reorder(sql : String | ::Grant::Query::SqlExpression::Trusted) : self
    chain_copy.reorder_in_place(sql)
  end

  def reorder(field : Symbol | String, direction : Symbol, *, nulls : Symbol? = nil) : self
    chain_copy.reorder_in_place(field, direction, nulls: nulls)
  end

  def reorder(field : Symbol | String, *, nulls : Symbol) : self
    chain_copy.reorder_in_place(field, nulls: nulls)
  end

  def reselect_in_place(columns : ColumnList) : self
    reset_load_state
    selected = [] of String
    columns.each do |column|
      if column.is_a?(String)
        value = ::Grant::Query::SqlExpression.validate_strict(column, "SELECT expression")
        return self.defer(value) if value.is_a?(ErrorBase)
        selected << value
      else
        selected << column.to_s
      end
    end
    self.select_columns = selected
    self
  end

  def reselect_in_place(*columns : Symbol | String) : self
    reselect_in_place(columns.to_a)
  end

  def reselect(*columns : Symbol | String) : self
    chain_copy.reselect_in_place(columns.to_a)
  end

  def reselect(columns : ColumnList) : self
    chain_copy.reselect_in_place(columns)
  end

  def regroup_in_place(fields : ColumnList) : self
    clear_group_fields
    fields.each { |field| group_by_in_place(field) }
    self
  end

  def regroup_in_place(*fields : Symbol | String) : self
    regroup_in_place(fields.to_a)
  end

  def regroup(*fields : Symbol | String) : self
    chain_copy.regroup_in_place(fields.to_a)
  end

  def regroup(fields : ColumnList) : self
    chain_copy.regroup_in_place(fields)
  end
end

pub macro model_methods(model)
  def self.reorder(*args, **options) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.reorder(*args, **options)
  end

  def self.reselect(*args) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.reselect(*args)
  end

  def self.regroup(*args) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.regroup(*args)
  end
end
