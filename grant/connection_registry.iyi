module grant/connection_registry

import std/time::{Span}
import grant/adapter/base::{Base}
import grant/adapter/registry::{Registry, UnknownAdapterError}
import grant/health_monitor::{HealthMonitorRegistry, HealthMonitor}
import grant/pool_reaper::{PoolReaper}
import grant/error_taxonomy::{ConnectionFailed}
import grant/settings
import grant/connections::{Connections}
import grant/errors::{ErrorBase}

# The eager registration slice of Grant::ConnectionRegistry.
pub class ConnectionRegistry
  pub struct ConnectionSpec
    property prepared_statements : Bool = true
    property statement_limit : Int32 = 1000
    property health_check_interval : Span = Span.seconds(30_i64)
    property health_check_timeout : Span = Span.seconds(5_i64)
    property pool_size : Int32 = 25
    property adapter_class : Base.class = Base
    property database : String
    property role : Symbol
    property url : String
    property verify_idle_after : Span? = Span.seconds(30_i64)

    def initialize(@database : String, @url : String, @role : Symbol, @verify_idle_after : Span? = Span.seconds(30_i64))
    end

    def initialize(@database : String, @adapter_class : Base.class, @url : String, @role : Symbol,
                   @health_check_interval : Span = Span.seconds(30_i64),
                   @health_check_timeout : Span = Span.seconds(5_i64),
                   @prepared_statements : Bool = true, @statement_limit : Int32 = 1000)
    end
    def build_pool_url : String
      params = [] of String
      params << "prepared_statements=false" if !@prepared_statements && @adapter_class.supports_unprepared_statements?
      params << "prepared_statements_cache=false" if @statement_limit == 0
      return @url if params.empty?
      @url + (@url.includes?("?") ? "&" : "?") + params.join("&")
    end
  end

  @@reapers = {} of String => PoolReaper
  @@default_database : String? = nil

  def self.default_database : String
    @@default_database || raise "No default database configured"
  end

  def self.default_database=(name : String) : String
    @@default_database = name
  end

  @@specifications = {} of String => ConnectionSpec
  @@adapters = {} of String => Base

  def self.normalize_role(role : Symbol) : Symbol
    return :writing if role == ::Grant::Settings.settings.writing_role
    return :reading if role == ::Grant::Settings.settings.reading_role
    role
  end

  def self.key_for(database : String, role : Symbol, shard : Symbol? = nil, replica_index : Int32 = 0) : String
    key = replica_index > 0 ? "#{database}:#{role}##{replica_index}" : "#{database}:#{role}"
    shard.nil? ? key : "#{key}:#{shard}"
  end

  def self.establish_connection(database : String, url : String,
                                role : Symbol = :primary) : Nil | ErrorBase
    adapter = Registry.for_url(url)!
    establish_connection(database: database, adapter: adapter, url: url, role: role)
  end

  def self.establish_connection(database : String, adapter : T.class, url : String, role : Symbol = :primary, pool_size : Int32 = 25, initial_pool_size : Int32 = 2, max_idle_pool_size : Int32 = 25, checkout_timeout : Span = Span.seconds(5_i64), verify_idle_after : Span? = Span.seconds(30_i64)) : Nil | ErrorBase forall T
    role = normalize_role(role)
    key = key_for(database, role)
    previous = @@adapters[key]?
    instance = adapter.new(key, url)
    instance.verify_idle_after = verify_idle_after
    instance.pool_size = adapter.single_connection_url?(url) ? 1 : pool_size
    instance.checkout_timeout = checkout_timeout
    @@default_database ||= database
    specification = ConnectionSpec.new(database, url, role, verify_idle_after)
    specification.adapter_class = adapter
    specification.pool_size = pool_size
    @@specifications[key] = specification
    @@adapters[key] = instance
    HealthMonitorRegistry.register(key, instance, specification)
    Connections.register(database, instance) if role == :primary
    Connections.register_role(database, instance, role)
    previous.disconnect_strict! unless previous.nil?
    nil
  end

  def self.establish_connection(database : String, adapter : T.class, url : String, *, retry_attempts : Int32, role : Symbol = :primary, pool_size : Int32 = 25, initial_pool_size : Int32 = 2, max_idle_pool_size : Int32 = 25, checkout_timeout : Span = Span.seconds(5_i64), verify_idle_after : Span? = Span.seconds(30_i64)) : Nil | ErrorBase forall T
    establish_connection(database: database, adapter: adapter, url: url, role: role,
      pool_size: pool_size, initial_pool_size: initial_pool_size, max_idle_pool_size: max_idle_pool_size,
      checkout_timeout: checkout_timeout, verify_idle_after: verify_idle_after)!
    get_adapter(database, role).retry_attempts = retry_attempts
    nil
  end

  def self.establish_connection(database : String, adapter : T.class, url : String,
                                role : Symbol = :primary, **options) : Nil | ErrorBase forall T
    establish_connection(database: database, adapter: adapter, url: url, role: role,
      pool_size: options[:pool_size]? || 25,
      initial_pool_size: options[:initial_pool_size]? || 2,
      max_idle_pool_size: options[:max_idle_pool_size]? || 25)!
    instance = get_adapter(database, role)
    instance.statement_limit = options[:statement_limit]? || 1000
    instance.prepared_statements = options[:prepared_statements]? != false
    instance.idle_timeout = options[:idle_timeout]? || nil
    instance.min_connections = options[:min_connections]? || 0
    instance.max_age = options[:max_age]? || nil
    instance.keepalive = options[:keepalive]? || nil
    if frequency = options[:reaping_frequency]?
      unless HealthMonitor.test_mode
        reaper = PoolReaper.new(instance, frequency)
        @@reapers[key_for(database, normalize_role(role))] = reaper
        reaper.start
      end
    end
    nil
  end

  def self.get_adapter?(database : String, role : Symbol = :primary) : Base?
    role = normalize_role(role)
    requested = @@adapters[key_for(database, role)]?
    monitor = HealthMonitorRegistry.get(key_for(database, role))
    return requested if requested && (monitor.nil? || monitor.healthy?)
    if role == :reading
      writer = @@adapters[key_for(database, :writing)]?
      return writer unless writer.nil?
    end
    role == :primary ? nil : @@adapters[key_for(database, :primary)]?
  end

  def self.connection_exists?(database : String, role : Symbol = :primary, shard : Symbol? = nil) : Bool
    key = key_for(database, normalize_role(role), shard)
    @@adapters.has_key?(key) || @@specifications.has_key?(key)
  end

  def self.get_adapter(database : String, role : Symbol = :primary) : Base
    get_adapter?(database, role).as(Base)
  end

  def self.connection_spec(database : String, role : Symbol = :writing, shard : Symbol? = nil, replica_index : Int32 = 0) : ConnectionSpec?
    @@specifications[key_for(database, role, shard, replica_index)]?
  end

  def self.remove_connection(database : String, role : Symbol = :writing, shard : Symbol? = nil, replica_index : Int32 = 0) : Bool | ErrorBase
    role = normalize_role(role)
    key = key_for(database, role, shard, replica_index)
    reaper = @@reapers.delete(key)
    reaper.stop if reaper
    HealthMonitorRegistry.unregister(key)
    spec = @@specifications.delete(key)
    removed = @@adapters.delete(key)
    return false if spec.nil? && removed.nil?
    Connections.unregister(database) if role == :primary
    Connections.unregister_role(database, role)
    removed.disconnect_strict! unless removed.nil?
    true
  end

  def self.clear_all : Nil | ErrorBase
    reapers = @@reapers.values
    @@reapers = {} of String => PoolReaper
    reapers.each(&.stop)
    HealthMonitorRegistry.clear
    retired = @@adapters.values
    @@specifications.values.each do |spec|
      Connections.unregister(spec.database)
      Connections.unregister_role(spec.database, spec.role)
    end
    @@adapters = {} of String => Base
    @@default_database = nil
    @@specifications = {} of String => ConnectionSpec
    retired.each do |adapter|
      adapter.disconnect_strict!
    end
    nil
  end

  def self.verify_strict(database : String, role : Symbol = :primary) : Nil | ConnectionFailed
    monitor = HealthMonitorRegistry.get(key_for(database, normalize_role(role)))
    return ConnectionFailed.new("No connection #{database}:#{role}", ErrorBase.new("Connection not established")) unless monitor
    monitor.verify_strict
  end

  def self.connected?(database : String, role : Symbol = :primary) : Bool
    verify_strict(database, role).nil?
  end

  def self.health_status : Array(NamedTuple(key: String, healthy: Bool, last_check: ::Std::Time::Time))
    HealthMonitorRegistry.status
  end
end
