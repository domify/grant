module grant/error_taxonomy

import grant/error::{ErrorBase}
import grant/settings::{settings}

pub class StatementInvalid < ErrorBase
  MAX_BINDS = 20
  MAX_BIND_LENGTH = 64
  REDACTED = "[FILTERED]"

  property binds : Array(String) = [] of String

  def self.describe_binds(values : Array(T)) : Array(String) forall T
    described = [] of String
    capture = settings.capture_statement_bind_values?
    values.each do |value|
      break if described.size >= MAX_BINDS
      described << (capture ? truncate(value.to_s) : REDACTED)
    end
    described
  end

  private def self.truncate(text : String) : String
    text.size > MAX_BIND_LENGTH ? "#{text[0, MAX_BIND_LENGTH]}..." : text
  end

  getter code : Int32
  getter operation : String
  getter detail : String
  property sql : String?
  getter cause : ErrorBase?

  def initialize(@code : Int32, @operation : String, @detail : String, @sql : String? = nil, @cause : ErrorBase? = nil)
    super("#{operation}: #{detail} (#{code})")
  end
end

impl ::Error for StatementInvalid
  def message : String
    @message
  end
end

pub class InvalidForeignKey < StatementInvalid
end

pub class RecordNotUnique < StatementInvalid
end

impl ::Error for RecordNotUnique
  def message : String
    @message
  end
end

pub class NotNullViolation < StatementInvalid
end

impl ::Error for NotNullViolation
  def message : String
    @message
  end
end

impl ::Error for InvalidForeignKey
  def message : String
    @message
  end
end

pub class ConnectionNotEstablished < ErrorBase
end

pub class ConnectionTimeoutError < ErrorBase
end

impl ::Error for ConnectionTimeoutError
  def message : String
    @message
  end
end

impl ::Error for ConnectionNotEstablished
  def message : String
    @message
  end
end

pub class ConnectionFailed < ConnectionNotEstablished
  getter cause : ErrorBase

  def initialize(message : String, @cause : ErrorBase)
    super(message)
  end
end

impl ::Error for ConnectionFailed
  def message : String
    @message
  end
end

pub class NoDatabaseError < StatementInvalid
end

impl ::Error for NoDatabaseError
  def message : String
    @message
  end
end
