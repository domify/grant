module grant/test_fixtures

import std/yaml::{YAML, Any}
import std/json
import std/digest::{CRC32, SHA1}
pub import std/uuid
import std/uuid::{UUID}
import std/file
import std/text
import grant/adapter/base::{Base}
import grant/adapter/driver::{Value}
import grant/adapter/test_helpers::{AdapterTestHelpers}
import grant/columns
import grant/query/bind_value::{to_value}
import grant/timestamps
import grant/transaction::{Options, run}
import grant/errors::{ErrorBase}

pub class Error < ErrorBase
end

pub MAX_ID = 1073741823_i64
pub UUID_NAMESPACE = UUID.parse("3e2f9a4c-58a8-5f4e-b3f0-0c9f0b7d1e11")
pub alias BelongsToMeta = NamedTuple(foreign_key: String, target_class: String)

pub struct Registration
  getter name : String
  getter model_name : String
  getter table : String
  getter primary_key : String
  getter uuid_key : Bool
  getter columns : Array(String)
  getter adapter : Proc(Base)
  getter associations : Hash(String, BelongsToMeta)

  def initialize(@name : String, @model_name : String, @table : String,
                 @primary_key : String, @uuid_key : Bool, @columns : Array(String),
                 @adapter : Proc(Base), @associations = {} of String => BelongsToMeta)
  end
end

pub struct Row
  getter label : String
  getter values : Hash(String, ::Grant::Columns::Type)
  def initialize(@label : String, @values : Hash(String, ::Grant::Columns::Type))
  end
end

@@registrations = {} of String => Registration

pub macro fixtures(**sets)
  {% for name, model in sets %}
    associations = {} of String => ::Grant::TestFixtures::BelongsToMeta
    {% for method in model.resolve.methods %}
      {% meta = method.annotation(::Grant::Associations::Relationship) %}
      {% if meta && meta[:type] == :belongs_to %}
        associations[{{ method.name.stringify }}] = {
          foreign_key: {{ meta[:foreign_key].id.stringify }},
          target_class: {{ meta[:target] }}.to_s}
      {% end %}
    {% end %}
    ::Grant::TestFixtures.register(
      name: {{ name.stringify }}, model_name: {{ model }}.to_s,
      table: {{ model }}.table_name, primary_key: {{ model }}.primary_name,
      uuid_key: {{ model }}.__fixture_uuid_key?,
      columns: {{ model }}.fields,
      adapter: -> { {{ model }}.adapter.as(::Grant::Adapter::Base::Base) },
      associations: associations)

    def {{ name.id }}(label : Symbol | String) : {{ model }} | ::Grant::Error::ErrorBase
      id = ::Grant::TestFixtures.id_for({{ name.stringify }}, label)!
      if id.is_a?(::Std::Uuid::UUID)
        {{ model }}.find_strict(id.to_s)
      else
        {{ model }}.find_strict(id)
      end
    end
  {% end %}
end

pub def register(name : String, model_name : String, table : String, primary_key : String,
                 uuid_key : Bool, columns : Array(String), adapter : Proc(Base),
                 associations : Hash(String, BelongsToMeta) = {} of String => BelongsToMeta) : Nil
  @@registrations[name] = Registration.new(name, model_name, table, primary_key,
    uuid_key, columns, adapter, associations)
  nil
end

pub def identify(label : Symbol | String) : Int64
  CRC32.checksum(label.to_s).to_i64 % MAX_ID
end

pub def identify_uuid(label : Symbol | String) : UUID
  namespace = UUID_NAMESPACE.bytes
  data = String.new(16) { |pointer| 16.times { |index| pointer[index] = namespace[index] } }
  digest = SHA1.hash_bytes(data + label.to_s)
  bytes = Array(UInt8).new(16) { |index| digest[index] }
  bytes[6] = (bytes[6] & 0x0f_u8) | 0x50_u8
  bytes[8] = (bytes[8] & 0x3f_u8) | 0x80_u8
  UUID.new(bytes)
end

pub def id_for(name : String, label : Symbol | String) : Int64 | UUID | Error
  registration = @@registrations[name]?
  return Error.new("No fixture set named #{name}; declare it with Grant::TestFixtures.fixtures") if registration.nil?
  registration.uuid_key ? identify_uuid(label) : identify(label)
end

pub def load(directory : String, only : Array(String)? = nil) : Nil | ErrorBase
  selected = @@registrations.values
  selected = selected.select { |registration| only.includes?(registration.name) } unless only.nil?
  return Error.new("No fixture sets declared; call Grant::TestFixtures.fixtures first") if selected.empty?
  loaded = [] of Tuple(Registration, Array(Row))
  selected.each { |registration| loaded << {registration, read_rows(registration, directory)!} }
  groups = {} of UInt64 => Array(Tuple(Registration, Array(Row)))
  loaded.each do |pair|
    key = pair[0].adapter.call.object_id
    group_rows = groups[key]? || [] of Tuple(Registration, Array(Row))
    group_rows << pair
    groups[key] = group_rows
  end
  groups.values.each do |group_rows|
    adapter = group_rows.first[0].adapter.call
    within_adapter(adapter) do
      group_rows.each { |pair| delete_all(adapter, pair[0])! }
      group_rows.each { |pair| insert_rows(adapter, pair[0], pair[1])! }
      nil
    end!
  end
  nil
end

pub def read_rows(registration : Registration, directory : String) : Array(Row) | Error
  path = ["yml", "yaml"].map { |ext| "#{directory}/#{registration.name}.#{ext}" }.find { |candidate| File.exists?(candidate) }
  return Error.new("Fixture file for #{registration.name} not found in #{directory}") if path.nil?
  document = YAML.parse?(File.read(path))
  return Error.new("#{path} is not valid YAML") if document.nil?
  return [] of Row if document.raw.nil?
  entries = document.as_h?
  return Error.new("#{path} must map labels to rows") if entries.nil?
  rows = [] of Row
  seen_ids = {} of String => String
  entries.each do |label_node, row_node|
    label = label_node.as_s? || label_node.raw.to_s
    next if label == "DEFAULTS"
    attributes = row_node.as_h?
    return Error.new("#{path}: fixture #{label} must be a mapping") if attributes.nil?
    values = {} of String => ::Grant::Columns::Type
    attributes.each do |key, value|
      key_text = key.as_s?
      return Error.new("#{path}: fixture #{label} has a non-string column") if key_text.nil?
      assign(registration, values, key_text, value)
    end
    unless values.has_key?(registration.primary_key)
      values[registration.primary_key] = registration.uuid_key ? identify_uuid(label).to_s : identify(label)
    end
    id = values[registration.primary_key].to_s
    other = seen_ids[id]?
    return Error.new("#{path}: fixtures #{other} and #{label} hash to the same id #{id}") unless other.nil?
    seen_ids[id] = label
    rows << Row.new(label, values)
  end
  rows
end

private def assign(registration : Registration, values : Hash(String, ::Grant::Columns::Type), key : String, node : Any) : Nil
  meta = registration.columns.includes?(key) ? nil : registration.associations[key]?
  if node.raw.is_a?(String) && !meta.nil?
    uuid = @@registrations.values.any? { |other| other.model_name == meta[:target_class] && other.uuid_key }
    values[meta[:foreign_key]] = uuid ? identify_uuid(node.as_s).to_s : identify(node.as_s)
  else
    values[key] = typed(node)
  end
  nil
end

private def typed(node : Any) : ::Grant::Columns::Type
  raw = node.raw
  case raw
  when Nil, Bool, Int64, Float64, String
    raw
  else
    json_value(node).to_json
  end
end

private def json_value(node : Any) : ::Std::Json::Any
  raw = node.raw
  case raw
  when Array(Any)
    ::Std::Json::Any.new(raw.map { |value| json_value(value) })
  when Hash(Any, Any)
    values = {} of String => ::Std::Json::Any
    raw.each { |key, value| values[key.as_s] = json_value(value) }
    ::Std::Json::Any.new(values)
  else
    ::Std::Json::Any.new(raw)
  end
end

private def within_adapter(adapter : Base, &block : -> T) : T | Nil | ErrorBase forall T
  # Both in-scope adapters provide the upstream referential-integrity helper.
  run(adapter, Options.new) do
    adapter.disable_referential_integrity { yield }
  end
end

private def delete_all(adapter : Base, registration : Registration) : Nil | ErrorBase
  statement = "DELETE FROM #{adapter.quote(registration.table)}"
  result = adapter.open(statement) { |db| db.exec(statement) }
  return ErrorBase.new("Fixture delete was cancelled") if result.is_a?(Cancelled)
  result!
  nil
end

private def insert_rows(adapter : Base, registration : Registration, rows : Array(Row)) : Nil | ErrorBase
  return nil if rows.empty?
  now = ::Grant::Timestamps.to_microseconds(::Std::Time::Time.utc)
  columns = [] of String
  rows.each { |row| row.values.keys.each { |key| columns << key unless columns.includes?(key) } }
  ["created_at", "updated_at"].each do |stamp|
    columns << stamp if registration.columns.includes?(stamp) && !columns.includes?(stamp)
  end
  quoted_columns = columns.map { |column| adapter.quote(column) }.join(", ")
  cap = adapter.postgres? ? 65535 : 999
  return Error.new("Fixture row exceeds the adapter bind-parameter cap") if columns.size > cap
  chunk_size = cap // columns.size
  offset = 0
  while offset < rows.size
    params = [] of Value
    tuples = [] of String
    index = offset
    while index < rows.size && index < offset + chunk_size
      row = rows[index]
      placeholders = columns.map do |column|
        value = row.values.has_key?(column) ? row.values[column] : ((column == "created_at" || column == "updated_at") ? now : nil)
        bound = value.is_a?(::Std::Time::Time) ? ::Grant::Columns.datetime_text(value) : value
        params << to_value(bound)
        adapter.postgres? ? "$#{params.size}" : "?"
      end
      tuples << "(#{placeholders.join(", ")})"
      index += 1
    end
    statement = "INSERT INTO #{adapter.quote(registration.table)} (#{quoted_columns}) VALUES #{tuples.join(", ")}"
    result = adapter.open(statement, params) { |db| db.exec(statement, params) }
    return ErrorBase.new("Fixture insert was cancelled") if result.is_a?(Cancelled)
    result!
    offset = index
  end
  nil
end
