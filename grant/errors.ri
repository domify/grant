module grant/errors

import std/indexable
import std/json
import grant/i18n

# Crystal Grant raises these; native ris returns them as union members.

pub import grant/error
pub alias ErrorBase = ::Grant::Error::ErrorBase
pub import grant/error_taxonomy
import grant/error_taxonomy::{StatementInvalid}

# Compatibility name used by the initial SQLite binding.
pub alias DatabaseError = StatementInvalid

pub class RecordDestroyedError < ErrorBase
  def initialize(model_name : String, action : String)
    super("Cannot #{action} a destroyed #{model_name}")
  end
end

impl ::Error for RecordDestroyedError
  def message : String
    @message
  end
end

pub class RecordNotFound < ErrorBase
  getter model : String
  getter id : String

  def initialize(@model : String, @id : String)
    super("Couldn't find #{@model} with id=#{@id}")
  end

  def initialize(message : String)
    @model = ""
    @id = ""
    super(message)
  end
end

impl ::Error for RecordNotFound
  def message : String
    @message
  end
end

pub class RecordNotSaved < ErrorBase
  getter model : String | ValidationRecord
  getter cause : StatementInvalid?

  def initialize(@model : String, @cause : StatementInvalid? = nil)
    super("#{@model} was not saved")
  end

  def initialize(class_name : String, model : ValidationRecord, @cause : StatementInvalid? = nil)
    @model = model
    super("Could not process #{class_name}: #{RecordNotSaved.reason_for(model)}")
  end

  def self.reason_for(model : ValidationRecord) : String
    first_error = model.errors.first?
    first_error.nil? ? "the save was halted before the record was persisted" : first_error.message
  end

  def statement_error : StatementInvalid?
    @cause
  end
end

impl ::Error for RecordNotSaved
  def message : String
    @message
  end
end

# Grant::Transaction::Rollback: returned from a transaction block to roll back silently.
pub struct Rollback
  def initialize
  end
end

impl ::Error for Rollback
  def message : String
    "rollback"
  end
end

pub class TransactionIsolationError < ErrorBase
  def initialize(message : String = "Cannot set the isolation level of a nested transaction; it is fixed by the outermost transaction")
    super(message)
  end
end

impl ::Error for TransactionIsolationError
  def message : String
    @message
  end
end


pub class NotOpenError < ErrorBase
  def initialize(message : String = "No open transaction")
    super(message)
  end
end

impl ::Error for NotOpenError
  def message : String
    @message
  end
end

pub class InvalidSavepointNameError < ErrorBase
end

impl ::Error for InvalidSavepointNameError
  def message : String
    @message
  end
end

# Structural slice of Grant::Errors used by persistence validations.
pub class Errors
  property base : ::Grant::Error::ErrorRecord? = nil
  @errors = [] of ::Grant::Error::Error

  def add(field : String | Symbol, message : String = "", type : Symbol? = nil, **options) : ::Grant::Error::Error
    error = ::Grant::Error::Error.new(field, message, type,
      options: ::Grant::Error.options_from(options))
    self << error
    error
  end

  def add(field : String | Symbol, type : Symbol, *, message : String | Symbol | Nil = nil, **options) : ::Grant::Error::Error
    error = ::Grant::Error::Error.new(field, type, message: message,
      options: ::Grant::Error.options_from(options))
    self << error
    error
  end

  def details : Hash(String, Array(::Grant::Error::Options))
    result = {} of String => Array(::Grant::Error::Options)
    @errors.each do |error|
      key = error.attribute
      result[key] = [] of ::Grant::Error::Options unless result.has_key?(key)
      result[key] << error.detail
    end
    result
  end

  def <<(error : ::Grant::Error::Error) : self
    error.base = @base if error.base.nil?
    @errors << error
    self
  end

  def map(&block : ::Grant::Error::Error -> T) : Array(T) forall T
    @errors.map { |error| yield error }
  end

  def [](index : Int32) : ::Grant::Error::Error
    @errors[index]
  end

  def first : ::Grant::Error::Error
    @errors.first
  end

  def first? : ::Grant::Error::Error?
    @errors.first?
  end

  def empty? : Bool
    @errors.empty?
  end

  def size : Int32
    @errors.size
  end

  def full_messages : Array(String)
    @errors.map { |error| error.full_message }
  end

  def any?(error_type : E.class) : Bool forall E
    @errors.any? { |error| error.is_a?(E) }
  end

  def conversion_errors? : Bool
    @errors.any? { |error| error.is_a?(::Grant::Error::ConversionError) }
  end

  def [](field : String | Symbol) : Array(String)
    where(field).map { |error| error.message }
  end

  def where(field : String | Symbol, type : Symbol | String | Nil = nil, **options) : Array(::Grant::Error::Error)
    @errors.select { |error| error.match?(field, type, **options) }
  end

  def of_type(field : String | Symbol, message : String) : Bool
    where(field).any? { |error| error.message == message }
  end

  def include?(field : String | Symbol) : Bool
    !where(field).empty?
  end

  def full_messages_for(field : String | Symbol) : Array(String)
    where(field).map { |error| error.full_message }
  end

  def group_by_attribute : Hash(String, Array(::Grant::Error::Error))
    result = {} of String => Array(::Grant::Error::Error)
    @errors.each do |error|
      key = error.field.to_s
      result[key] = [] of ::Grant::Error::Error unless result.has_key?(key)
      result[key] << error
    end
    result
  end

  def attribute_names : Array(String)
    group_by_attribute.keys
  end

  def any? : Bool
    !empty?
  end

  def count : Int32
    size
  end

  def last : ::Grant::Error::Error
    @errors.last
  end

  def last? : ::Grant::Error::Error?
    @errors.last?
  end

  def to_a : Array(::Grant::Error::Error)
    @errors.dup
  end

  def each(&block : ::Grant::Error::Error -> T) : Nil forall T
    @errors.each { |error| yield error }
    nil
  end

  def select(&block : ::Grant::Error::Error -> Bool) : Array(::Grant::Error::Error)
    @errors.select { |error| yield error }
  end

  def to_hash(full_messages : Bool = false) : Hash(String, Array(String))
    result = {} of String => Array(String)
    @errors.each do |error|
      key = error.attribute
      result[key] = [] of String unless result.has_key?(key)
      result[key] << (full_messages ? error.full_message : error.message)
    end
    result
  end

  def merge_in_place(other : Errors) : self
    other.to_a.each { |error| import_records(error) }
    self
  end

  def messages_for(field : String | Symbol) : Array(String)
    self[field]
  end

  def has_message?(field : String | Symbol, message : String) : Bool
    where(field).any? { |error| error.message == message }
  end

  def of_type(field : String | Symbol, type : Symbol, **options) : Bool
    !where(field, type, **options).empty?
  end

  def of_type?(field : String | Symbol, type : Symbol, **options) : Bool
    of_type(field, type, **options)
  end

  def added?(field : String | Symbol, type : Symbol = :invalid, **options) : Bool
    where(field).any? { |error| error.strict_match?(field, type, **options) }
  end

  def added?(field : String | Symbol, message : String) : Bool
    has_message?(field, message)
  end

  def delete(field : String | Symbol, type : Symbol | String | Nil = nil, **options) : Array(String)
    removed = where(field, type, **options)
    messages = removed.map { |error| error.message }
    @errors = @errors.reject { |error| removed.any? { |item| item.object_id == error.object_id } }
    messages
  end

  def count(field : String | Symbol) : Int32
    where(field).size
  end

  def objects : Array(::Grant::Error::Error)
    @errors
  end

  def full_message(field : String | Symbol, message : String) : String
    return message if field.to_s == "base"
    record = @base
    human = record.nil? ? ::Grant::I18n.humanize(field.to_s) :
      ::Grant::I18n.human_attribute_name(record.__error_model_name, field.to_s)
    ::Grant::I18n.full_message(human, message)
  end

  def messages : Hash(String, Array(String))
    to_hash
  end

  def as_json(full_messages : Bool = false) : Hash(String, Array(String))
    to_hash(full_messages)
  end

  def uniq_in_place : self
    kept = [] of ::Grant::Error::Error
    @errors.each do |error|
      duplicate = kept.any? do |other|
        matches = other.attribute == error.attribute && other.type == error.type &&
          other.message == error.message && other.options.size == error.options.size
        if matches
          error.options.each do |key, value|
            matches = false unless other.options.has_key?(key) && other.options[key] == value
          end
        end
        matches
      end
      kept << error unless duplicate
    end
    @errors = kept
    self
  end

  def import_records(error : ::Grant::Error::Error, attribute : String | Symbol | Nil = nil) : ::Grant::Error::Error
    copy = error.copy(attribute)
    self << copy
    copy
  end

  def copy_in_place(other : Errors) : self
    copies = other.to_a.map { |error| error.copy }
    clear
    copies.each { |error| import_records(error) }
    self
  end


  def to_json : String
    fields = {} of String => ::Std::Json::Any
    to_hash.each do |key, messages|
      fields[key] = ::Std::Json::Any.new(messages.map { |message| ::Std::Json::Any.new(message) })
    end
    ::Std::Json::Any.new(fields).to_json
  end

  def to_json_list : String
    "[" + @errors.map { |error| error.to_json }.join(",") + "]"
  end

  def to_s : String
    full_messages.join(", ")
  end

  def clear_validations : Nil
    @errors = @errors.select { |error| error.is_a?(::Grant::Error::ConversionError) }
    nil
  end

  def clear_conversion_error(field : String | Symbol) : Nil
    @errors = @errors.reject { |error| error.is_a?(::Grant::Error::ConversionError) && error.field == field }
    nil
  end

  def clear : Nil
    @errors.clear
    nil
  end
end

# Shared record interface avoids an errors -> Base -> adapter import cycle.
pub trait ValidationRecord
  abstract def errors : Errors
  abstract def __table_name : String
end

# Validation-specific persistence failure retains the rejected model.
pub class RecordInvalid < RecordNotSaved
  getter record : ValidationRecord

  def initialize(@record : ValidationRecord)
    super(@record.__table_name, @record)
    messages = @record.errors.full_messages
    @message = messages.empty? ? "Validation failed" : "Validation failed: #{messages.join(", ")}"
  end
end

impl ::Error for RecordInvalid
  def message : String
    @message
  end
end


pub class RecordNotDestroyed < ErrorBase
  getter model : ValidationRecord

  def initialize(class_name : String, @model : ValidationRecord)
    reason = @model.errors.first?
    super("Could not destroy #{class_name}: #{reason.nil? ? "the destroy was halted" : reason.message}")
  end
end

impl ::Error for RecordNotDestroyed
  def message : String
    @message
  end
end
