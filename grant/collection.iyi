module grant/collection

import std/enumerable::{Enumerable}

# The legacy raw-query collection loads on its first forwarded Array operation.
pub class Collection(M)
  @loaded : Bool = false
  @collection : Array(M) = [] of M

  def initialize(@loader : -> Array(M))
  end

  def loaded? : Bool
    @loaded
  end

  private def collection : Array(M)
    return @collection if loaded?
    @collection = @loader.call
    @loaded = true
    @collection
  end

  def each(& : M -> Nil) : Nil
    collection.each { |record| yield record }
    nil
  end

  def [](index : Int32) : M
    collection[index]
  end

  def to_a : Array(M)
    collection
  end
end

impl Enumerable for Collection(M) forall M
  type Elem = M
end
