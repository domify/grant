module grant/query_extensions

import grant/adapter/driver::{Value}
import grant/errors::{ErrorBase}
import grant/query/bind_value::{to_value}

# Native trait supplies the upstream Builder reopening without an import cycle.
pub trait QueryExtensions(Model)
  def update_all(**assignments) : Int64 | ErrorBase
    pairs = [] of Tuple(String, Value)
    assignments.each { |key, value| pairs << {key.to_s, to_value(value)} }
    return 0_i64 if pairs.empty?
    update_all(pairs)
  end
end
