module grant/composite_primary_key

import grant/error::{ErrorBase}

# Configuration slice needed by the structural table-creation migrator.
pub struct CompositeKey
  getter columns : Array(Symbol)
  private def initialize(@columns : Array(Symbol))
  end
  def self.build(columns : Array(Symbol)) : CompositeKey | ErrorBase
    return ErrorBase.new("Composite key must have at least 2 columns") if columns.size < 2
    new(columns)
  end
  def where_clause : String
    columns.map { |column| "#{column} = ?" }.join(" AND ")
  end
end

pub macro composite_primary_key(*columns)
  def self.composite_key : ::Grant::CompositePrimaryKey::CompositeKey
    ::Grant::CompositePrimaryKey::CompositeKey.build([
      {% for column in columns %} :{{column.id}}, {% end %}
    ] of Symbol).or_panic
  end
  def self.composite_primary_key? : Bool
    true
  end
  def self.composite_primary_key_columns : Array(Symbol)
    composite_key.columns
  end
end
