module grant/pool_reaper
import grant/adapter/base::{Base}
import grant/adapter/pool_support::{ticks}
import std/time::{Span}

pub class PoolReaper
  @running : Bool = false
  @stop_signal = Channel(Nil).new(1)
  @last_keepalive_ticks : Int64 = ticks
  @tasks : IyiGroup

  def initialize(@adapter : Base, @frequency : Span)
    @tasks = IyiGroup.new
    IyiScheduler.current.open_group = @tasks.outer
  end

  def start : Nil
    return nil if @running
    @running = true
    @tasks.spawn do
      loop do
        select
        when @stop_signal.receive
          break
        when timeout(@frequency.total_milliseconds.to_i32)
          break unless @running
          sweep
        end
      end
      nil
    end
    nil
  end

  def stop : Nil
    return nil unless @running
    @running = false
    @stop_signal.send(nil).or_panic
    previous = IyiScheduler.current.open_group
    @tasks.join
    IyiScheduler.current.open_group = previous
    nil
  end

  def sweep : Int32
    closed = 0
    now = ticks
    if idle_timeout = @adapter.idle_timeout
      if now - @adapter.last_used_ticks >= idle_timeout.total_milliseconds
        closed = @adapter.close_idle_connections(keep: @adapter.min_connections)
      end
    end
    closed += @adapter.close_aged_connections
    if keepalive = @adapter.keepalive
      if now - @last_keepalive_ticks >= keepalive.total_milliseconds
        @last_keepalive_ticks = now
        @adapter.keepalive_idle_connections
      end
    end
    closed
  end
end
