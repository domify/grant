module grant/i18n

import std/text

pub abstract class Translator
  abstract def translate(locale : String, key : String) : String?
end

pub class DefaultTranslator < Translator
    MESSAGES = {
      "errors.format"                            => "%{attribute} %{message}",
      "errors.messages.blank"                    => "can't be blank",
      "errors.messages.present"                  => "must be blank",
      "errors.messages.taken"                    => "has already been taken",
      "errors.messages.invalid"                  => "is invalid",
      "errors.messages.inclusion"                => "is not included in the list",
      "errors.messages.exclusion"                => "is reserved",
      "errors.messages.confirmation"             => "doesn't match confirmation",
      "errors.messages.accepted"                 => "must be accepted",
      "errors.messages.empty"                    => "can't be empty",
      "errors.messages.too_short"                => "is too short (minimum is %{count} characters)",
      "errors.messages.too_long"                 => "is too long (maximum is %{count} characters)",
      "errors.messages.wrong_length"             => "is the wrong length (should be %{count} characters)",
      "errors.messages.not_a_number"             => "is not a number",
      "errors.messages.not_an_integer"           => "must be an integer",
      "errors.messages.greater_than"             => "must be greater than %{count}",
      "errors.messages.greater_than_or_equal_to" => "must be greater than or equal to %{count}",
      "errors.messages.equal_to"                 => "must be equal to %{count}",
      "errors.messages.less_than"                => "must be less than %{count}",
      "errors.messages.less_than_or_equal_to"    => "must be less than or equal to %{count}",
      "errors.messages.other_than"               => "must be other than %{count}",
      "errors.messages.odd"                      => "must be odd",
      "errors.messages.even"                     => "must be even",
      "errors.messages.comparison"               => "failed comparison",
      "errors.messages.required"                 => "must exist",
      "errors.messages.invalid_email"            => "is not a valid email",
      "errors.messages.invalid_url"              => "is not a valid URL",
      "errors.messages.out_of_range"             => "is out of range",
    }

  @store = {} of String => String

  def store(key : String, template : String, locale : String = "en") : Nil
    @store["#{locale}.#{key}"] = template
    nil
  end

  def translate(locale : String, key : String) : String?
    @store["#{locale}.#{key}"]? || (locale == "en" ? MESSAGES[key]? : nil)
  end
end

class State
  property translator : Translator = DefaultTranslator.new
  property locale : String = "en"
  property message_cache = {} of {String, String, String, Symbol} => String
end

STATE = State.new

@@scoped_locales = {} of UInt64 => String

pub def translator : Translator
  STATE.translator
end

pub def translator=(replacement : Translator) : Translator
  STATE.translator = replacement
  clear_cache
  replacement
end

pub def locale : String
  @@scoped_locales[IyiScheduler.current.object_id]? || STATE.locale
end

pub def locale=(replacement : String) : String
  STATE.locale = replacement
end

pub def clear_cache : Nil
  STATE.message_cache = {} of {String, String, String, Symbol} => String
  nil
end

pub def store(key : String, template : String, locale : String = "en") : Nil
  active = translator
  if active.is_a?(DefaultTranslator)
    active.store(key, template, locale)
    clear_cache
  end
  nil
end

pub def humanize(name : String) : String
  text = name.size > 3 && name.ends_with?("_id") ? name[0, name.size - 3] : name
  text.gsub("_", " ").gsub(".", " ").capitalize
end

pub def generate_message(model : String, attribute : String, type : Symbol, options : T) : String forall T
  key = {locale, model, attribute, type}
  template = STATE.message_cache[key]?
  if template.nil?
    active = translator
    if !model.empty?
      model = model_key(model)
      template = active.translate(locale, "errors.models.#{model}.attributes.#{attribute}.#{type}") ||
                 active.translate(locale, "errors.models.#{model}.#{type}")
    end
    template = template || active.translate(locale, "errors.attributes.#{attribute}.#{type}") ||
               active.translate(locale, "errors.messages.#{type}") ||
               active.translate(locale, "errors.messages.invalid") || "is invalid"
    STATE.message_cache[key] = template
  end
  result = template
  unless options.nil?
    options.each { |name, item| result = result.gsub("%{#{name}}", item.to_s) }
  end
  result.gsub("%{attribute}", humanize(attribute))
end

pub def model_key(model : String) : String
  name = model.gsub("::", "/")
  result = ""
  index = 0
  name.each_char do |char|
    upper = char >= 'A' && char <= 'Z'
    if upper && index > 0
      previous = name[index - 1]
      following = name[index + 1]?
      previous_lower = (previous >= 'a' && previous <= 'z') || (previous >= '0' && previous <= '9')
      next_lower = !following.nil? && following >= 'a' && following <= 'z'
      previous_upper = previous >= 'A' && previous <= 'Z'
      result += "_" if previous_lower || (previous_upper && next_lower)
    end
    result += char.to_s.downcase
    index += 1
  end
  result
end

pub def human_attribute_name(model : String, attribute : String) : String
  translator.translate(locale, "attributes.#{model_key(model)}.#{attribute}") ||
    translator.translate(locale, "attributes.#{attribute}") || humanize(attribute)
end

pub def full_message(attribute : String, message : String) : String
  format = translator.translate(locale, "errors.format") || "%{attribute} %{message}"
  format.gsub("%{attribute}", attribute).gsub("%{message}", message)
end

pub def with_locale(locale : String, &block : -> T) : T forall T
  key = IyiScheduler.current.object_id
  previous = @@scoped_locales[key]?
  @@scoped_locales[key] = locale
  result = yield
  if previous.nil?
    @@scoped_locales.delete(key)
  else
    @@scoped_locales[key] = previous
  end
  result
end

pub def demodulize(model : String) : String
  model.split("::").last
end

pub def human_model_name(model : String, count : Int? = nil) : String
  active = translator
  key = "models.#{model_key(model)}"
  if count
    found = active.translate(locale, "#{key}.#{count == 1 ? "one" : "other"}")
    return found unless found.nil?
  end
  active.translate(locale, key) || humanize(model_key(demodulize(model)))
end
