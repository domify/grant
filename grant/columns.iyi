module grant/columns

pub import grant/error
pub import std/time
pub import std/json
pub import std/yaml
pub import std/big

# Scalar column values retain their model types at the reflective boundary.
pub alias Type = Array(String) | ::Std::Big::BigDecimal | Nil | String | Int32 | Int64 | Float32 | Float64 | Bool | ::Std::Time::Time

# Grant::DATETIME_FORMAT under the native UTC settings implementation.
pub def datetime_text(value : ::Std::Time::Time) : String
  text = value.to_rfc3339(6)
  text[0, 10] + " " + text[11, 15] + "+0000"
end

pub macro model_methods(model)
  # Upstream Columns#to_h reads typed getters, which unseal lazy values.
  private def __typed_column_values : Hash(String, ::Grant::Columns::Type) | ::Grant::Error::ErrorBase
    fields = {} of String => ::Grant::Columns::Type
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      value = \{{ v.name }}
      \{% if v.annotation(::Grant::Base::Column)[:lazy] %}
        value = value!
      \{% end %}
      fields[\{{ v.name.stringify }}] = value
    \{% end %}
    fields
  end

  def to_h : Hash(String, ::Grant::Columns::Type) | ::Grant::Error::ErrorBase
    fields = __typed_column_values!
    fields.each do |name, value|
      fields[name] = ::Grant::Columns.datetime_text(value) if value.is_a?(::Std::Time::Time)
    end
    fields
  end

  def to_json : String | ::Grant::Error::ErrorBase
    json = ::Std::Json::Builder.new
    to_json(json)!
    json.to_s
  end

  def to_json(json : ::Std::Json::Builder) : Nil | ::Grant::Error::ErrorBase
    fields = __typed_column_values!
    values = {} of String => ::Std::Json::Any
    fields.each do |name, value|
      normalized = case value
                   when ::Std::Time::Time then value.to_rfc3339(6)
                   when Int32 then value.to_i64
                   when Float32 then value.to_f64
                   when ::Std::Big::BigDecimal then value.to_s
                   else value
                   end
      values[name] = ::Std::Json::Any.new(normalized)
    end
    ::Std::Json::Any.new(values).to_json(json)
    nil
  end

  def to_yaml : String | ::Grant::Error::ErrorBase
    fields = __typed_column_values!
    values = {} of ::Std::Yaml::Any => ::Std::Yaml::Any
    fields.each do |name, value|
      normalized = case value
                   when ::Std::Time::Time then value.to_rfc3339(6)
                   when Int32 then value.to_i64
                   when Float32 then value.to_f64
                   when ::Std::Big::BigDecimal then value.to_s
                   else value
                   end
      values[::Std::Yaml::Any.new(name)] = ::Std::Yaml::Any.new(normalized)
    end
    ::Std::Yaml::YAML.dump(::Std::Yaml::Any.new(values))
  end

  def read_attribute(attribute_name : Symbol) : ::Grant::Columns::Type | ::Grant::Error::ErrorBase
    \{% begin %}
      case attribute_name.to_s
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      when \{{ v.name.stringify }}
        \{% if v.annotation(::Grant::Base::Column)[:converter] %}
          \{{ v.annotation(::Grant::Base::Column)[:converter] }}.to_db(@\{{ v.name }})!
        \{% else %}
          @\{{ v.name }}
        \{% end %}
      \{% end %}
      else
        ::Grant::Error::ErrorBase.new("Cannot read attribute #{attribute_name}, invalid attribute")
      end
    \{% end %}
  end
end

# Per-column delegators from upstream Columns' pre-save dirty API.
pub macro dirty_column_methods(decl)
  def {{ decl.var }}_came_from_user? : Bool
    attribute_came_from_user?({{ decl.var.stringify }})
  end
  def saved_change_to_{{ decl.var }}?(*, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    saved_change_to_attribute?({{ decl.var.stringify }}, from: from, to: to)
  end
  def saved_change_to_{{ decl.var }} : Tuple(SavedValue, SavedValue)?
    saved_change_to_attribute({{ decl.var.stringify }})
  end
  def {{ decl.var }}_previously_changed?(*, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    saved_change_to_{{ decl.var }}?(from: from, to: to)
  end
  def {{ decl.var }}_previously_was : {{ decl.type }} | Nil
    change = saved_change_to_{{ decl.var }}
    change ? change[0].as({{ decl.type }} | Nil) : @{{ decl.var }}
  end
  def {{ decl.var }}_before_last_save : {{ decl.type }} | Nil
    {{ decl.var }}_previously_was
  end
  def restore_{{ decl.var }}_in_place : Nil
    self.{{ decl.var }} = @__persisted_{{ decl.var }}
    nil
  end

  def {{ decl.var }}_was : {{ decl.type }} | Nil
    {{ decl.var }}_changed? ? @__persisted_{{ decl.var }} : @{{ decl.var }}
  end

  def {{ decl.var }}_change : Tuple({{ decl.type }} | Nil, {{ decl.type }} | Nil)?
    {{ decl.var }}_changed? ? {@__persisted_{{ decl.var }}, @{{ decl.var }}} : nil
  end

  def {{ decl.var }}_before_type_cast : ::Grant::Columns::Type | ::Grant::Error::ErrorBase
    attribute_before_type_cast({{ decl.var.stringify }})
  end

  def will_save_change_to_{{ decl.var }}?(*, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    return false unless {{ decl.var }}_changed?
    (from.is_a?(::Grant::Dirty::Unfiltered) || @__persisted_{{ decl.var }} == from) &&
      (to.is_a?(::Grant::Dirty::Unfiltered) || @{{ decl.var }} == to)
  end
end

# All adapters round decimal columns at the assignment boundary.
pub def decimal_at_scale(value : ::Std::Big::BigDecimal, scale : Int32) : ::Std::Big::BigDecimal
  value.div(::Std::Big::BigDecimal.new(1), scale)
end
