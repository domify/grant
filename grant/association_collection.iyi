module grant/association_collection

import grant/query/builder::{Builder}
import grant/associations/collection_finders::{CollectionFinders}
import grant/error::{ErrorBase}
import grant/querying::{NotFound}
import grant/associations/through::{OwnerNotSaved}

# The direct association slice of upstream AssociationCollection(Owner, Target).
pub class AssociationCollection(Owner, Target)
  @loaded_records : Array(Target)?

  def initialize(@owner : Owner, @foreign_key : Symbol | String,
                 @through : Symbol | String | Nil = nil,
                 @primary_key : Symbol | String | Nil = nil,
                 @inverse_of : Symbol | String | Nil = nil,
                 @scope : Proc(Builder(Target), Builder(Target))? = nil,
                 @association_name : String? = nil,
                 @loaded_records : Array(Target)? = nil,
                 @relation_scope : Proc(Builder(Target), Builder(Target))? = nil,
                 @through_condition : String? = nil)
  end

  private def memory_records : Array(Target)?
    @loaded_records
  end

  private def set_inverse(record : Target) : Target
    inverse = @inverse_of
    record.set_loaded_association(inverse.to_s, [@owner]) unless inverse.nil?
    record
  end

  private def adopt(record : Target?) : Target?
    set_inverse(record) unless record.nil?
    record
  end

  private def adopt(records : Array(Target)) : Array(Target)
    records.each { |record| set_inverse(record) }
    records
  end

  def loaded? : Bool
    !@loaded_records.nil?
  end

  def association_relation : Builder(Target)
    relation = Target.current_scope
    association_scope = @scope
    relation = association_scope.call(relation) unless association_scope.nil?
    through_scope = @relation_scope
    return through_scope.call(relation) unless through_scope.nil?
    relation.where(@foreign_key.to_s, :eq, owner_key)
  end

  private def owner_key : ::Grant::Columns::Type
    @owner.read_attribute((@primary_key || Owner.primary_name).to_s).or_panic
  end

  def all : Array(Target) | ErrorBase
    records = @loaded_records
    return records unless records.nil?
    records = association_relation.select!
    @loaded_records = records.dup
    association_name = @association_name
    @owner.set_loaded_association(association_name, records) unless association_name.nil?
    records
  end

  def all(clause : String, params : Array(V)) : Array(Target) | ErrorBase forall V
    values = [owner_key] of ::Grant::Adapter::Driver::Value
    params.each { |value| values << value }
    condition = @through_condition || "#{Target.table_name}.#{@foreign_key} = ?"
    Target.find_by_sql("SELECT #{Target.table_name}.* FROM #{Target.table_name} WHERE #{condition} #{clause}", values)
  end

  def find_by(**args) : Target | Nil | ErrorBase
    association_relation.find_by(**args)
  end

  def find_by_strict(**args) : Target | ErrorBase
    record = find_by(**args)!
    return record unless record.nil?
    parts = [] of String
    args.to_h.each { |key, value| parts << "#{key} = #{value}" }
    description = parts.join(" and ")
    ::Grant::Querying::NotFound.new("No #{Target} found where #{description}")
  end

  def to_a : Array(Target) | ErrorBase
    all
  end

  def map(&block : Target -> T) : Array(T) | ErrorBase forall T
    all!.map { |record| yield record }
  end

  def compact_map(&block : Target -> T?) : Array(T) | ErrorBase forall T
    all!.compact_map { |record| yield record }
  end

  def count : Int64 | ErrorBase
    result = association_relation.count!
    result.is_a?(Int64) ? result : result.values.sum
  end

  def size : Int64 | ErrorBase
    records = @loaded_records
    records.nil? ? count : records.size.to_i64
  end

  def length : Int32 | ErrorBase
    all!.size
  end

  def empty? : Bool | ErrorBase
    records = @loaded_records
    records.nil? ? !association_relation.exists?! : records.empty?
  end

  def any? : Bool | ErrorBase
    !empty?!
  end

  def none? : Bool | ErrorBase
    !any?!
  end

  def build(**attrs) : Target
    record = Target.new(**attrs)
    prepare_built(record)
  end

  private def prepare_built(record : Target) : Target
    record.assign_attributes({@foreign_key.to_s => owner_key})
    inverse = @inverse_of
    record.set_loaded_association(inverse.to_s, [@owner]) unless inverse.nil?
    records = @loaded_records
    records << record unless records.nil?
    name = @association_name
    @owner.set_loaded_association(name, records) if !name.nil? && !records.nil?
    record
  end

  def create(**attrs) : Target | ErrorBase
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create") unless @owner.persisted?
    record = build(**attrs)
    record.save
    record
  end

  def create_strict(**attrs) : Target | ErrorBase
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create!") unless @owner.persisted?
    record = build(**attrs)
    record.save_strict!
    record
  end

  def load_target : Array(Target) | ErrorBase
    all
  end

  def build(**attrs, &block : Target -> T) : Target forall T
    record = Target.new(**attrs)
    record.assign_attributes({@foreign_key.to_s => owner_key})
    yield record
    prepare_built(record)
  end

  def build(attrs : Hash(K, V)) : Target forall K, V
    record = Target.new
    record.assign_attributes(attrs)
    prepare_built(record)
  end

  def build(attrs : NamedTuple) : Target
    build(**attrs)
  end

  def build(records : Array(T)) : Array(Target) forall T
    records.map { |attrs| build(attrs) }
  end

  def create(**attrs, &block : Target -> T) : Target | ErrorBase forall T
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create") unless @owner.persisted?
    record = build(**attrs) { |built| yield built }
    record.save
    record
  end

  def create(attrs : Hash(K, V)) : Target | ErrorBase forall K, V
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create") unless @owner.persisted?
    record = build(attrs)
    record.save
    record
  end

  def create(attrs : NamedTuple) : Target | ErrorBase
    create(**attrs)
  end

  def create(records : Array(T)) : Array(Target) | ErrorBase forall T
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create") unless @owner.persisted?
    created = [] of Target
    Owner.transaction do
      records.each { |attrs| created << create(attrs)! }
      nil
    end!
    created
  end

  def create_strict(**attrs, &block : Target -> T) : Target | ErrorBase forall T
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create!") unless @owner.persisted?
    record = build(**attrs) { |built| yield built }
    record.save_strict!
    record
  end

  def create_strict(attrs : Hash(K, V)) : Target | ErrorBase forall K, V
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create!") unless @owner.persisted?
    record = build(attrs)
    record.save_strict!
    record
  end

  def create_strict(attrs : NamedTuple) : Target | ErrorBase
    create_strict(**attrs)
  end

  def create_strict(records : Array(T)) : Array(Target) | ErrorBase forall T
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name || Target.to_s, "create!") unless @owner.persisted?
    created = [] of Target
    Owner.transaction do
      records.each { |attrs| created << create_strict(attrs)! }
      nil
    end!
    created
  end

  def delete_all(dependent : Symbol? = nil) : Int64 | ErrorBase
    if !dependent.nil? && dependent != :nullify && dependent != :delete_all
      return ::Grant::Error::ArgumentError.new("Unknown dependent strategy #{dependent} for delete_all; use :nullify or :delete_all")
    end
    count = if dependent == :delete_all
      association_relation.delete_all!
    else
      association_relation.update_all([{ @foreign_key.to_s, nil.as(::Grant::Adapter::Driver::Value) }])!
    end
    records = @loaded_records
    records.clear unless records.nil?
    count
  end

  def destroy_all : Array(Target) | ErrorBase
    records = all!.dup
    records.each { |record| record.destroy_strict! }
    loaded = @loaded_records
    loaded.clear unless loaded.nil?
    records
  end
end

impl CollectionFinders(Owner, Target) for AssociationCollection(Owner, Target) forall Owner, Target
end
