module grant/schema/internal_metadata

import grant/adapter/base::{Base}
import grant/adapter/schema::{Dialect}
import grant/schema/introspection
import grant/error::{ErrorBase}

pub class ProtectedEnvironmentError < ErrorBase
  getter environment : String
  def initialize(@environment : String)
    super("You are attempting to run a destructive action against your '#{@environment}' database. Pass force: true if you are sure.")
  end
end
pub class EnvironmentMismatchError < ErrorBase
  def initialize(current : String, stored : String)
    super("You are attempting to modify a database that was last run in the '#{stored}' environment, from '#{current}'.")
  end
end

pub class InternalMetadata
  TABLE = "ar_internal_metadata"
  ENVIRONMENT_KEY = "environment"
  DEFAULT_PROTECTED = ["production"]
  getter adapter : Base
  getter dialect : Dialect
  @table_present = false

  def initialize(@adapter : Base)
    @dialect = Dialect.for(adapter)
  end
  def create_table : Nil | ErrorBase | Cancelled
    return nil if @table_present
    adapter.open do |db|
      db.exec("CREATE TABLE IF NOT EXISTS #{TABLE} (#{dialect.quote("key")} VARCHAR(255) NOT NULL PRIMARY KEY, value VARCHAR(255), created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)")!
      nil
    end!
    adapter.reset_schema_caches_in_place(TABLE)
    @table_present = true
    nil
  end
  def [](key : String) : String? | ErrorBase | Cancelled
    return nil unless @table_present || present?!
    adapter.open do |db|
      rows = db.query("SELECT value FROM #{TABLE} WHERE #{dialect.quote("key")} = #{dialect.quote_literal(key)}")!
      row = rows.first?
      row.nil? ? nil : row["value"].as(String?)
    end
  end
  def []=(key : String, value : String) : String | ErrorBase | Cancelled
    create_table!
    quoted_key = dialect.quote("key")
    key_literal = dialect.quote_literal(key)
    value_literal = dialect.quote_literal(value)
    adapter.open do |db|
      sql = if dialect == Dialect::Mysql
        "INSERT INTO #{TABLE} (#{quoted_key}, value) VALUES (#{key_literal}, #{value_literal}) ON DUPLICATE KEY UPDATE value = VALUES(value), updated_at = CURRENT_TIMESTAMP"
      else
        "INSERT INTO #{TABLE} (#{quoted_key}, value) VALUES (#{key_literal}, #{value_literal}) ON CONFLICT (#{quoted_key}) DO UPDATE SET value = excluded.value, updated_at = CURRENT_TIMESTAMP"
      end
      db.exec(sql)!
      value
    end
  end
  def environment : String? | ErrorBase | Cancelled
    self[ENVIRONMENT_KEY]
  end
  def record_environment(environment : String) : Nil | ErrorBase | Cancelled
    self.[]=(ENVIRONMENT_KEY, environment)!
    nil
  end
  def check_protected_environments_strict(current : String, protected_environments : Array(String) = DEFAULT_PROTECTED, force : Bool = false) : Nil | ErrorBase | Cancelled
    return nil if force
    stored = environment!
    return ProtectedEnvironmentError.new(stored) if stored && protected_environments.includes?(stored)
    return ProtectedEnvironmentError.new(current) if stored.nil? && protected_environments.includes?(current)
    return EnvironmentMismatchError.new(current, stored) if stored && stored != current
    nil
  end
  private def present? : Bool | ErrorBase | Cancelled
    found = adapter.schema.table_exists?(TABLE)!
    @table_present = found
    found
  end
end
