module grant/schema/constraint_catalog
import grant/schema/introspection::{Introspection, TableNotFound}
import grant/schema/table_rebuild::{TableRebuild}
import grant/adapter/schema::{Dialect}
import grant/errors::{ErrorBase}

# One `CHECK` constraint of a table.
pub struct CheckConstraintInfo

  getter table_name : String
  getter name : String?
  getter expression : String
  # False for a PostgreSQL constraint added `NOT VALID` and not yet validated.
  getter validated : Bool

  def initialize(@table_name : String, @name : String?, @expression : String, @validated : Bool = true)
  end

  def validated? : Bool
    @validated
  end
end

# One `UNIQUE` constraint (not a bare unique index) of a table.
pub struct UniqueConstraintInfo

  getter table_name : String
  getter name : String?
  getter columns : Array(String)
  getter deferrable : Bool

  def initialize(@table_name : String, @name : String?, @columns : Array(String), @deferrable : Bool = false)
  end

  def deferrable? : Bool
    @deferrable
  end
end

# One PostgreSQL exclusion constraint.
pub struct ExclusionConstraintInfo

  getter table_name : String
  getter name : String
  getter definition : String

  def initialize(@table_name : String, @name : String, @definition : String)
  end
end

pub trait ConstraintCatalog
  abstract def check_constraints(table : String | Symbol) : Array(CheckConstraintInfo) | ErrorBase | Cancelled
  abstract def unique_constraints(table : String | Symbol) : Array(UniqueConstraintInfo) | ErrorBase | Cancelled
  abstract def exclusion_constraints(table : String | Symbol) : Array(ExclusionConstraintInfo) | ErrorBase | Cancelled
end

pub def sqlite_items(schema : Introspection, table : String) : Array(TableRebuild::Item) | ErrorBase | Cancelled
  schema.adapter.open do |db|
    sql = db.scalar("SELECT sql FROM sqlite_master WHERE type = 'table' AND name = #{Dialect::Sqlite.quote_literal(table)}")!.as(String?)
    sql.nil? ? TableNotFound.new(table) : TableRebuild.new(table, sql).items
  end
end

impl ConstraintCatalog for Introspection
  def check_constraints(table : String | Symbol) : Array(::Grant::Schema::ConstraintCatalog::CheckConstraintInfo) | ErrorBase | Cancelled
    name = table.to_s
    if adapter.postgres?
      adapter.open do |db|
        sql = "SELECT c.conname AS name, pg_get_expr(c.conbin, c.conrelid) AS expression, c.convalidated AS validated FROM pg_constraint c WHERE c.contype = 'c' AND c.conrelid = to_regclass(#{Dialect::Pg.quote_literal(name)}) ORDER BY c.conname"
        db.query(sql)!.map { |row| ::Grant::Schema::ConstraintCatalog::CheckConstraintInfo.new(name, row["name"].as(String), row["expression"].as(String), row["validated"].as(Bool)) }
      end
    else
      ::Grant::Schema::ConstraintCatalog.sqlite_items(self, name)!.select { |item| item.kind == :check }.map { |item| ::Grant::Schema::ConstraintCatalog::CheckConstraintInfo.new(name, item.name, TableRebuild::Scanner.check_expression(item.text).strip) }
    end
  end
  def unique_constraints(table : String | Symbol) : Array(::Grant::Schema::ConstraintCatalog::UniqueConstraintInfo) | ErrorBase | Cancelled
    name = table.to_s
    if adapter.postgres?
      adapter.open do |db|
        sql = "SELECT c.conname AS name, c.condeferrable AS deferrable, a.attname AS column_name FROM pg_constraint c CROSS JOIN LATERAL unnest(c.conkey) WITH ORDINALITY AS k(attnum, ord) JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = k.attnum WHERE c.contype = 'u' AND c.conrelid = to_regclass(#{Dialect::Pg.quote_literal(name)}) ORDER BY c.conname, k.ord"
        grouped = {} of String => ::Grant::Schema::ConstraintCatalog::UniqueConstraintInfo
        db.query(sql)!.each do |row|
          key = row["name"].as(String)
          if info = grouped[key]?
            info.columns << row["column_name"].as(String)
          else
            grouped[key] = ::Grant::Schema::ConstraintCatalog::UniqueConstraintInfo.new(name, key, [row["column_name"].as(String)], row["deferrable"].as(Bool))
          end
        end
        grouped.values
      end
    else
      ::Grant::Schema::ConstraintCatalog.sqlite_items(self, name)!.select { |item| item.kind == :unique }.map { |item| ::Grant::Schema::ConstraintCatalog::UniqueConstraintInfo.new(name, item.name, TableRebuild::Scanner.fk_columns(item.text)) }
    end
  end
  def exclusion_constraints(table : String | Symbol) : Array(::Grant::Schema::ConstraintCatalog::ExclusionConstraintInfo) | ErrorBase | Cancelled
    return [] of ::Grant::Schema::ConstraintCatalog::ExclusionConstraintInfo unless adapter.postgres?
    name = table.to_s
    adapter.open do |db|
      sql = "SELECT conname AS name, pg_get_constraintdef(oid) AS definition FROM pg_constraint WHERE contype = 'x' AND conrelid = to_regclass(#{Dialect::Pg.quote_literal(name)}) ORDER BY conname"
      db.query(sql)!.map { |row| ::Grant::Schema::ConstraintCatalog::ExclusionConstraintInfo.new(name, row["name"].as(String), row["definition"].as(String)) }
    end
  end
end
