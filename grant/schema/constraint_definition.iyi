module grant/schema/constraint_definition
import grant/schema/index_definition::{Naming}
import grant/adapter/schema::{Dialect, UnsupportedOperation, InvalidDefinition}
import grant/error::{ErrorBase}

pub class ConstraintOptions
  def self.deferrable_sql(dialect : Dialect, deferrable : Bool | Symbol?, name : String) : String? | ErrorBase
    return nil if deferrable.nil? || deferrable == false
    return UnsupportedOperation.new("Only PostgreSQL supports deferrable constraints ('#{name}')") unless dialect == Dialect::Pg
    case deferrable
    when :deferred then "DEFERRABLE INITIALLY DEFERRED"
    when :immediate, true then "DEFERRABLE INITIALLY IMMEDIATE"
    else InvalidDefinition.new("Unknown deferrable: #{deferrable.inspect}; use true, :immediate or :deferred")
    end
  end
end

# `CHECK (expression)`.
pub class CheckConstraintDefinition
  getter table : String
  getter expression : String
  getter name : String
  getter validate : Bool

  def initialize(@table : String, @expression : String, name : String? = nil, @validate : Bool = true)
    @name = name || Naming.constraint_name("chk", @table, Naming.digest(@expression))
  end

  def constraint_sql(dialect : Dialect) : String | ErrorBase
    "CONSTRAINT #{dialect.quote(@name)} CHECK (#{@expression})"
  end
end

# `UNIQUE (columns)`, optionally deferrable or built on an existing index.
pub class UniqueConstraintDefinition
  getter table : String
  getter columns : Array(String)
  getter name : String
  getter deferrable : Bool | Symbol?
  getter using_index : String?

  def initialize(@table : String, @columns : Array(String), name : String? = nil,
                 @deferrable : Bool | Symbol? = nil, @using_index : String? = nil)
    @name = name || Naming.constraint_name("uniq", @table, @columns.join("_"))
  end

  def constraint_sql(dialect : Dialect) : String | ErrorBase
    if @using_index && dialect != Dialect::Pg
      return UnsupportedOperation.new("using_index: is only supported on PostgreSQL ('#{@name}')")
    end
    deferral = ConstraintOptions.deferrable_sql(dialect, @deferrable, @name)!
    String.build do |io|
      io << "CONSTRAINT " << dialect.quote(@name) << " UNIQUE "
      if index = @using_index
        io << "USING INDEX " << dialect.quote(index)
      else
        io << '(' << @columns.map { |column| dialect.quote(column) }.join(", ") << ')'
      end
      if clause = deferral
        io << ' ' << clause
      end
    end
  end
end

# `EXCLUDE USING method (expression WITH operator)`, PostgreSQL only.
pub class ExclusionConstraintDefinition
  getter table : String
  getter expression : String
  getter using : String?
  getter where : String?
  getter name : String
  getter deferrable : Bool | Symbol?

  def initialize(@table : String, @expression : String, @using : String? = nil, @where : String? = nil,
                 name : String? = nil, @deferrable : Bool | Symbol? = nil)
    @name = name || Naming.constraint_name("excl", @table, Naming.digest(@expression))
  end

  def constraint_sql(dialect : Dialect) : String | ErrorBase
    return UnsupportedOperation.new("Exclusion constraints are only supported on PostgreSQL ('#{@name}')") unless dialect == Dialect::Pg
    deferral = ConstraintOptions.deferrable_sql(dialect, @deferrable, @name)!
    String.build do |io|
      io << "CONSTRAINT " << dialect.quote(@name) << " EXCLUDE "
      io << "USING " << @using << ' ' if @using
      io << '(' << @expression << ')'
      io << " WHERE (" << @where << ')' if @where
      if clause = deferral
        io << ' ' << clause
      end
    end
  end
end
