module grant/schema/schema_statements
import grant/adapter/schema::{Dialect, UnsupportedOperation, InvalidDefinition}
import grant/schema/constraint_catalog
import grant/schema/constraint_definition::{CheckConstraintDefinition, UniqueConstraintDefinition, ExclusionConstraintDefinition}
import grant/schema/column_info::{ColumnInfo, IndexInfo}
import grant/schema/index_definition::{IndexDefinition, Naming}
import grant/schema/table_definition::{TableDefinition, ColumnDefinition, Unset, UNSET}
import grant/transaction
import grant/schema/introspection
import grant/schema/table_rebuild::{TableRebuild}
import grant/schema/alter_table::{AlterStep, AlterTableDefinition}
import grant/adapter/base::{Base}
import grant/errors::{ErrorBase}

pub macro methods
  ::Grant::Schema::AlterTable.methods
  def create_table_statements(table : String | Symbol, id : Bool | Symbol = true, force : Bool | Symbol = false, comment : String? = nil, if_not_exists : Bool = false, temporary : Bool = false, primary_key : String | Symbol = :id, &block : TableDefinition -> T) : Array(String) | ErrorBase forall T
    definition = TableDefinition.new(table.to_s, dialect, comment)
    result = yield definition
    return result if result.is_a?(ErrorBase)
    return definition.definition_error.as(ErrorBase) unless definition.definition_error.nil?
    columns = [] of String
    if id != false
      columns << auto_id_sql(dialect, primary_key.to_s, id.is_a?(Symbol) ? id : :bigint)!
    end
    definition.columns.each { |column| columns << column.to_sql(dialect)! }
    definition.unique_constraints.each { |constraint| columns << constraint.constraint_sql(dialect)! }
    definition.check_constraints.each { |constraint| columns << constraint.constraint_sql(dialect)! }
    sql = "CREATE #{temporary ? "TEMPORARY " : ""}TABLE #{if_not_exists ? "IF NOT EXISTS " : ""}#{dialect.quote(table)} (\n  #{columns.join(",\n  ")}\n)"
    sql += " COMMENT=#{dialect.quote_literal(comment)}" if dialect == Dialect::Mysql && comment
    statements = force != false ? ["DROP TABLE IF EXISTS #{dialect.quote(table)}#{force == :cascade && dialect == Dialect::Pg ? " CASCADE" : ""}", sql] : [sql]
    if dialect == Dialect::Pg
      statements.concat(change_table_comment_statements(table, comment)) if comment
      definition.columns.each do |column|
        statements.concat(change_column_comment_statements(table, column.name, column.comment)!) if column.comment
      end
    end
    definition.indexes.each { |index| statements.concat(index.statements(dialect)!) }
    statements
  end
  def create_table(table : String | Symbol, id : Bool | Symbol = true, force : Bool | Symbol = false, comment : String? = nil, if_not_exists : Bool = false, temporary : Bool = false, primary_key : String | Symbol = :id, &block : TableDefinition -> T) : Nil | ErrorBase | Cancelled forall T
    execute_batch(create_table_statements(table, id, force, comment, if_not_exists, temporary, primary_key) { |t| yield t }!)
  end
  def drop_table_statements(*tables, if_exists : Bool = false, cascade : Bool = false) : Array(String)
    statements = [] of String
    tables.each do |table|
      statements << "DROP TABLE #{if_exists ? "IF EXISTS " : ""}#{dialect.quote(table)}#{cascade && dialect == Dialect::Pg ? " CASCADE" : ""}"
    end
    statements
  end
  def drop_table(*tables, if_exists : Bool = false, cascade : Bool = false) : Nil | ErrorBase | Cancelled
    execute_batch(drop_table_statements(*tables, if_exists: if_exists, cascade: cascade))
  end
  private def auto_id_sql(dialect : Dialect, name : String, kind : Symbol) : String | ErrorBase
    quoted = dialect.quote(name)
    case kind
    when :bigint, :integer, :smallint
      if dialect == Dialect::Pg
        type = kind == :bigint ? "BIGSERIAL" : (kind == :integer ? "SERIAL" : "SMALLSERIAL")
        "#{quoted} #{type} PRIMARY KEY"
      elsif dialect == Dialect::Mysql
        type = kind == :bigint ? "BIGINT" : (kind == :integer ? "INT" : "SMALLINT")
        "#{quoted} #{type} NOT NULL AUTO_INCREMENT PRIMARY KEY"
      else
        "#{quoted} INTEGER PRIMARY KEY AUTOINCREMENT"
      end
    when :uuid
      type = dialect == Dialect::Pg ? "UUID PRIMARY KEY DEFAULT gen_random_uuid()" : (dialect == Dialect::Mysql ? "CHAR(36) PRIMARY KEY DEFAULT (UUID())" : "CHAR(36) PRIMARY KEY")
      "#{quoted} #{type}"
    when :string
      "#{quoted} #{dialect == Dialect::Pg ? "VARCHAR" : "VARCHAR(255)"} PRIMARY KEY"
    else
      InvalidDefinition.new("Unknown id type #{kind.inspect}; use :bigint, :integer, :smallint, :uuid, :string or false")
    end
  end
  def add_column(table : String | Symbol, name : String | Symbol, type : String | Symbol, **options) : Nil | ErrorBase | Cancelled
    execute_batch(add_column_statements(table, name, type, **options)!)
  end
  def remove_column(table : String | Symbol, column : String | Symbol, type : String | Symbol? = nil, **options) : Nil | ErrorBase | Cancelled
    execute_batch(remove_column_statements(table, column, type, **options)!)
  end
  def add_index_statements(table : String | Symbol, columns : C, **options) : Array(String) | ErrorBase forall C
    IndexDefinition.build(table, columns, **options)!.statements(dialect)
  end
  def add_index(table : String | Symbol, columns : C, **options) : Nil | ErrorBase | Cancelled forall C
    execute_batch(add_index_statements(table, columns, **options)!)
  end
  def remove_index_statements(table : String | Symbol, columns = nil, name : String | Symbol? = nil,
                              if_exists : Bool = false, algorithm : Symbol? = nil) : Array(String) | ErrorBase
    index_name = name.nil? ? nil : name.to_s
    if index_name.nil?
      return InvalidDefinition.new("remove_index on '#{table}' needs columns: or name:") if columns.nil?
      index_name = Naming.index_name(table, IndexDefinition.to_names(columns))
    end
    if dialect == Dialect::Mysql
      ["DROP INDEX #{dialect.quote(index_name)} ON #{dialect.quote(table)}"]
    else
      concurrently = dialect == Dialect::Pg && algorithm == :concurrently ? "CONCURRENTLY " : ""
      ["DROP INDEX #{concurrently}#{if_exists ? "IF EXISTS " : ""}#{dialect.quote(Naming.in_schema_of(table, index_name))}"]
    end
  end
  def remove_index(*args, **options) : Nil | ErrorBase | Cancelled
    execute_batch(remove_index_statements(*args, **options)!)
  end
  def rename_index_statements(table : String | Symbol, old : String | Symbol, new : String | Symbol) : Array(String) | ErrorBase | Cancelled
    case dialect
    when Dialect::Pg
      ["ALTER INDEX #{dialect.quote(Naming.in_schema_of(table, old))} RENAME TO #{dialect.quote(new)}"]
    when Dialect::Mysql
      ["ALTER TABLE #{dialect.quote(table)} RENAME INDEX #{dialect.quote(old)} TO #{dialect.quote(new)}"]
    else
      known = lookup_indexes(table.to_s)!
      info = known.nil? ? nil : known.find { |index| index.name == old.to_s }
      return UnsupportedOperation.new("Renaming index '#{old}' on SQLite needs a database connection to read it") if info.nil?
      ["DROP INDEX #{dialect.quote(Naming.in_schema_of(table, old))}"] + IndexDefinition.from_info(info, info.columns, new.to_s).statements(dialect)!
    end
  end
  def rename_index(*args) : Nil | ErrorBase | Cancelled
    execute_batch(rename_index_statements(*args)!)
  end
  def change_column_default_statements(table : String | Symbol, column : String | Symbol,
                                       to = UNSET, default_sql : String? = nil, from = UNSET) : Array(String) | ErrorBase | Cancelled
    if default_sql.nil? && to.is_a?(Unset)
      return InvalidDefinition.new("change_column_default needs to: or default_sql:")
    end
    if dialect == Dialect::Sqlite
      catalog = catalog_sqlite_table(table.to_s)!
      rebuild = TableRebuild.new(table.to_s, catalog[0], catalog[1])
      edited = rebuild.change_column(column.to_s) do |old|
        previous = TableRebuild::Scanner.default_clause(old)
        text = previous.nil? ? old : old.sub(previous, "")
        if default_sql
          "#{text} DEFAULT #{dialect.default_expression(default_sql)}"
        elsif to.nil?
          text
        else
          "#{text} DEFAULT #{dialect.quote_literal(to)}"
        end
      end
      edited!
      rebuild.statements
    else
      head = "ALTER TABLE #{dialect.quote(table)} ALTER COLUMN #{dialect.quote(column)}"
      if default_sql
        ["#{head} SET DEFAULT #{dialect.default_expression(default_sql)}"]
      elsif to.nil?
        ["#{head} DROP DEFAULT"]
      else
        ["#{head} SET DEFAULT #{dialect.quote_literal(to)}"]
      end
    end
  end
  def change_column_default(*args, **options) : Nil | ErrorBase | Cancelled
    execute_batch(change_column_default_statements(*args, **options)!)
  end
  def change_table(table : String | Symbol, bulk : Bool = false, &block : AlterTableDefinition(self) -> T) : Nil | ErrorBase | Cancelled forall T
    execute_batch(change_table_statements(table, bulk) { |definition| yield definition }!)
  end
end
pub class RecordingStatements
  getter dialect : Dialect
  getter statements = [] of String
  getter sqlite_tables = {} of String => Tuple(String, Array(String))
  getter known_columns = {} of String => Array(ColumnInfo)
  def initialize(@dialect : Dialect)
  end
  def lookup_column(table : String, column : String) : ColumnInfo? | ErrorBase | Cancelled
    columns = @known_columns[table]?
    columns.nil? ? nil : columns.find { |info| info.name == column }
  end
  def catalog_sqlite_table(table : String) : Tuple(String, Array(String)) | ErrorBase
    sqlite_tables[table]? || UnsupportedOperation.new("A SQLite table rebuild needs a database connection to read '#{table}'")
  end
  def lookup_indexes(table : String) : Array(IndexInfo)? | ErrorBase
    nil
  end
  def execute_batch(statements : Array(String)) : Nil
    @statements.concat(statements)
    nil
  end
  ::Grant::Schema::SchemaStatements.methods
end
pub class AdapterStatements
  @in_transaction : Bool = false
  @rebuilds_in_transaction : Bool = false

  def in_transaction? : Bool
    @in_transaction
  end

  def transaction(disable_ddl_transaction : Bool = false, rebuilds : Bool = false,
                  &block : AdapterStatements -> T) : T | Nil | ErrorBase | Cancelled forall T
    return yield self if disable_ddl_transaction || dialect == Dialect::Mysql
    if rebuilds && dialect == Dialect::Sqlite
      adapter.with_connection do |_|
        enforced = adapter.open { |db| db.scalar("PRAGMA foreign_keys")!.as(Int64) != 0 }!
        adapter.open { |db| db.exec("PRAGMA foreign_keys = OFF") }!
        defer restore_foreign_keys(enforced)
        run_in_transaction(true) { yield self }
      end
    else
      run_in_transaction(false) { yield self }
    end
  end

  private def restore_foreign_keys(enforced : Bool) : Nil | ErrorBase | Cancelled
    adapter.open { |db| db.exec("PRAGMA foreign_keys = #{enforced ? "ON" : "OFF"}")!; nil }
  end

  private def reset_transaction_flags : Nil
    @in_transaction = false
    @rebuilds_in_transaction = false
    nil
  end

  private def run_in_transaction(rebuilds : Bool, &block : -> T) : T | Nil | ErrorBase forall T
    ::Grant::Transaction.run(adapter, ::Grant::Transaction::Options.new) do
      @in_transaction = true
      @rebuilds_in_transaction = rebuilds
      defer reset_transaction_flags
      yield
    end
  end

  def catalog_sqlite_table(table : String) : Tuple(String, Array(String)) | ErrorBase | Cancelled
    literal = dialect.quote_literal(table)
    adapter.open do |db|
      create = db.scalar("SELECT sql FROM sqlite_master WHERE type = 'table' AND name = #{literal}")!.as(String)
      indexes = db.query("SELECT sql FROM sqlite_master WHERE type = 'index' AND tbl_name = #{literal} AND sql IS NOT NULL")!.map { |row| row["sql"].as(String) }
      {create, indexes}
    end
  end

  getter adapter : Base
  getter dialect : Dialect
  def initialize(@adapter : Base)
    @dialect = Dialect.for(adapter)
  end
  def lookup_column(table : String, column : String) : ColumnInfo? | ErrorBase | Cancelled
    return nil unless adapter.schema.table_exists?(table)!
    adapter.schema.columns(table)!.find { |info| info.name == column }
  end
  def lookup_indexes(table : String) : Array(IndexInfo)? | ErrorBase | Cancelled
    adapter.schema.indexes(table)
  end
  def execute_batch(statements : Array(String)) : Nil | ErrorBase | Cancelled
    return nil if statements.empty?
    if @in_transaction && statements.any? { |sql| sql.starts_with?("CREATE INDEX CONCURRENTLY") || sql.starts_with?("CREATE UNIQUE INDEX CONCURRENTLY") || sql.starts_with?("DROP INDEX CONCURRENTLY") }
      return InvalidDefinition.new("CONCURRENTLY cannot run inside a transaction; use transaction(disable_ddl_transaction: true)")
    end
    if @in_transaction && statements.includes?("BEGIN")
      return InvalidDefinition.new("A SQLite table rebuild cannot run inside a transaction: it must switch foreign key enforcement off first") unless @rebuilds_in_transaction
      statements = statements.reject { |sql| sql == "BEGIN" || sql == "COMMIT" || sql.starts_with?("PRAGMA foreign_keys") }
    end
    defer adapter.reset_schema_caches_in_place
    @adapter.open(statements.first) do |db|
      error = nil.as(ErrorBase?)
      statements.each do |sql|
        outcome = db.exec(sql)
        if outcome.is_a?(ErrorBase)
          error = outcome
          break
        end
      end
      if !error.nil? && dialect == Dialect::Sqlite && statements.includes?("BEGIN")
        db.exec("ROLLBACK")
        db.exec("PRAGMA foreign_keys = ON")
      end
      error
    end
  end
  ::Grant::Schema::SchemaStatements.methods
end
