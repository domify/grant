module grant/schema/introspection
import grant/adapter/base::{Base}
import grant/adapter/schema::{Dialect}
import grant/schema/table_rebuild::{TableRebuild}
import grant/schema/column_info::{ColumnInfo, IndexInfo, TypeFamily, ForeignKeyInfo, ReferentialAction}
import grant/errors::{ErrorBase}
import std/text
import std/enumerable
import std/json
import std/file::{File}
pub class TableNotFound < ErrorBase
  getter table_name : String
  def initialize(@table_name : String)
    super("Table '#{table_name}' does not exist")
  end
end

pub class Introspection
  FORMAT_VERSION = 1
  getter adapter : Base
  getter namespace : String?
  @tables : Array(String)? = nil
  @columns = Bucket(ColumnInfo).new
  @indexes = Bucket(IndexInfo).new
  @foreign_keys = Bucket(ForeignKeyInfo).new
  @mutex = Channel(Nil).new(1)
  def initialize(@adapter : Base, @namespace : String? = nil)
    @mutex.send(nil).or_panic
  end
  private def synchronize(&block : -> T) : T forall T
    @mutex.receive.or_panic
    defer @mutex.send(nil).or_panic
    yield
  end
  private def known_tables : Array(String) | ErrorBase | Cancelled
    cached = @tables
    return cached unless cached.nil?
    @tables = adapter.catalog_tables(namespace)!
  end
  def tables : Array(String) | ErrorBase | Cancelled
    synchronize { known_tables }
  end
  def table_exists?(table : String | Symbol) : Bool | ErrorBase | Cancelled
    if table.to_s.includes?(".")
      parts = table.to_s.split('.')
      return adapter.schema(parts.first).table_exists?(parts.last)
    end
    synchronize { known_tables!.includes?(table.to_s) }
  end
  def table_comment(table : String | Symbol) : String? | ErrorBase | Cancelled
    return nil unless @adapter.postgres?
    sql = "SELECT obj_description(to_regclass(#{Dialect::Pg.quote_literal(table.to_s)}), 'pg_class')"
    @adapter.open { |db| db.scalar(sql)!.as(String?) }
  end
  def columns(table : String | Symbol) : Array(ColumnInfo) | ErrorBase | Cancelled
    if table.to_s.includes?(".")
      parts = table.to_s.split('.')
      return adapter.schema(parts.first).columns(parts.last)
    end
    synchronize do
      return TableNotFound.new(table.to_s) unless known_tables!.includes?(table.to_s)
      @columns.fetch(table.to_s) { |only| adapter.catalog_columns(only, namespace) }
    end
  end
  def column_exists?(table : String | Symbol, column : String | Symbol, type : TypeFamily? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    columns(table)!.any? { |info| info.name == column.to_s && (type.nil? || info.type_family == type) }
  end
  def primary_key(table : String | Symbol) : Array(String) | ErrorBase | Cancelled
    columns(table)!.select { |info| info.primary_key? }.sorted_by { |info| info.primary_key_position }.map { |info| info.name }
  end
  def foreign_keys(table : String | Symbol) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
    if table.to_s.includes?(".")
      parts = table.to_s.split('.')
      return adapter.schema(parts.first).foreign_keys(parts.last)
    end
    synchronize do
      return TableNotFound.new(table.to_s) unless known_tables!.includes?(table.to_s)
      @foreign_keys.fetch(table.to_s) { |only| adapter.catalog_foreign_keys(only, namespace) }
    end
  end
  private def referential_action(text : String) : ReferentialAction
    case text
    when "c" then ReferentialAction::Cascade
    when "r" then ReferentialAction::Restrict
    when "n" then ReferentialAction::SetNull
    when "d" then ReferentialAction::SetDefault
    else ReferentialAction.parse(text)
    end
  end
  def foreign_key_exists?(table : String | Symbol, to_table : String | Symbol? = nil, column : String | Symbol? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    foreign_keys(table)!.any? { |key| (to_table.nil? || key.to_table == to_table.to_s) && (column.nil? || key.columns == [column.to_s]) }
  end
  def indexes(table : String | Symbol) : Array(IndexInfo) | ErrorBase | Cancelled
    if table.to_s.includes?(".")
      parts = table.to_s.split('.')
      return adapter.schema(parts.first).indexes(parts.last)
    end
    synchronize do
      return TableNotFound.new(table.to_s) unless known_tables!.includes?(table.to_s)
      @indexes.fetch(table.to_s) { |only| adapter.catalog_indexes(only, namespace) }
    end
  end
  def index_exists?(table : String | Symbol, columns = nil, name : String | Symbol? = nil, unique : Bool? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    wanted = columns.nil? ? nil : columns.map { |column| column.to_s }
    indexes(table)!.any? do |index|
      (wanted.nil? || index.columns == wanted) && (name.nil? || index.name == name.to_s) &&
        (unique.nil? || index.unique == unique)
    end
  end

  def reset_in_place(table : String | Symbol? = nil) : Nil
    synchronize do
      @tables = nil
      name = table.nil? ? nil : table.to_s
      @columns.reset_in_place(name)
      @indexes.reset_in_place(name)
      @foreign_keys.reset_in_place(name)
    end
    nil
  end
  def loaded? : Bool
    synchronize { !@tables.nil? && @columns.loaded? && @indexes.loaded? && @foreign_keys.loaded? }
  end
  private def warm : Nil | ErrorBase | Cancelled
    known_tables!
    @columns.ensure_loaded { adapter.catalog_columns(nil, namespace) }!
    @indexes.ensure_loaded { adapter.catalog_indexes(nil, namespace) }!
    @foreign_keys.ensure_loaded { adapter.catalog_foreign_keys(nil, namespace) }!
    nil
  end
  def load_all_in_place : Nil | ErrorBase | Cancelled
    synchronize { warm }
  end
  def dump(path : String) : Nil | ErrorBase | Cancelled
    file = synchronize do
      warm!
      CacheFile.new(FORMAT_VERSION, adapter.postgres? ? "Pg" : "Sqlite", known_tables!,
        @columns.rows, @indexes.rows, @foreign_keys.rows)
    end
    File.write(path, file.to_json)
    nil
  end
  def load(path : String) : Nil | ErrorBase
    return CacheFileError.new("Cannot read schema cache #{path}") unless File.exists?(path) && File.readable?(path)
    file = CacheFile.parse(File.read(path))!
    return CacheFileError.new("Schema cache #{path} has format version #{file.version}, expected #{FORMAT_VERSION}") unless file.version == FORMAT_VERSION
    kind = adapter.postgres? ? "Pg" : "Sqlite"
    return CacheFileError.new("Schema cache #{path} was dumped from #{file.adapter}, not #{kind}") unless file.adapter == kind
    synchronize do
      @tables = file.tables
      @columns.replace(file.columns)
      @indexes.replace(file.indexes)
      @foreign_keys.replace(file.foreign_keys)
    end
    nil
  end
  def load?(path : String) : Bool | ErrorBase
    return false unless File.exists?(path)
    load(path)!
    true
  end
  def enums : Hash(String, Array(String)) | ErrorBase | Cancelled
    return {} of String => Array(String) unless @adapter.postgres?
    @adapter.open do |db|
      result = {} of String => Array(String)
      db.query("SELECT t.typname AS name, e.enumlabel AS value FROM pg_type t JOIN pg_enum e ON t.oid = e.enumtypid JOIN pg_namespace n ON n.oid = t.typnamespace WHERE n.nspname = current_schema() ORDER BY t.typname, e.enumsortorder")!.each do |row|
        name = row["name"].as(String)
        result[name] = [] of String unless result.has_key?(name)
        result[name] << row["value"].as(String)
      end
      result
    end
  end
  def extensions : Array(String) | ErrorBase | Cancelled
    return [] of String unless @adapter.postgres?
    @adapter.open { |db| db.query("SELECT extname FROM pg_extension ORDER BY extname")!.map { |row| row["extname"].as(String) } }
  end
  def extension_enabled?(name : String | Symbol) : Bool | ErrorBase | Cancelled
    extensions!.includes?(name.to_s)
  end
end
@@schema_caches = {} of UInt64 => Hash(String, Introspection)

pub trait AdapterSchema
  abstract def schema(namespace : String? = nil) : Introspection
  abstract def reset_schema_caches_in_place(table : String? = nil) : Nil
  abstract def forget_schema_cache(namespace : String) : Nil
  abstract def catalog_tables(namespace : String? = nil) : Array(String) | ErrorBase | Cancelled
  abstract def catalog_columns(table : String? = nil, namespace : String? = nil) : Array(ColumnInfo) | ErrorBase | Cancelled
  abstract def catalog_indexes(table : String? = nil, namespace : String? = nil) : Array(IndexInfo) | ErrorBase | Cancelled
  abstract def catalog_foreign_keys(table : String? = nil, namespace : String? = nil) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
end
pub def caches_for(adapter : Base) : Hash(String, Introspection)
  key = adapter.object_id
  @@schema_caches[key] = {} of String => Introspection unless @@schema_caches.has_key?(key)
  @@schema_caches[key]
end
impl AdapterSchema for Base
  def schema(namespace : String? = nil) : ::Grant::Schema::Introspection::Introspection
    caches = ::Grant::Schema::Introspection.caches_for(self)
    key = namespace || ""
    caches[key] = ::Grant::Schema::Introspection::Introspection.new(self, namespace) unless caches.has_key?(key)
    caches[key]
  end
  def reset_schema_caches_in_place(table : String? = nil) : Nil
    ::Grant::Schema::Introspection.caches_for(self).values.each { |cache| cache.reset_in_place(table) }
    nil
  end
  def forget_schema_cache(namespace : String) : Nil
    ::Grant::Schema::Introspection.caches_for(self).delete(namespace)
    nil
  end
  def catalog_tables(namespace : String? = nil) : Array(String) | ::Grant::Errors::ErrorBase | Cancelled
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).tables
  end
  def catalog_columns(table : String? = nil, namespace : String? = nil) : Array(::Grant::Schema::ColumnInfo::ColumnInfo) | ::Grant::Errors::ErrorBase | Cancelled
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).columns(table)
  end
  def catalog_indexes(table : String? = nil, namespace : String? = nil) : Array(::Grant::Schema::ColumnInfo::IndexInfo) | ::Grant::Errors::ErrorBase | Cancelled
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).indexes(table)
  end
  def catalog_foreign_keys(table : String? = nil, namespace : String? = nil) : Array(::Grant::Schema::ColumnInfo::ForeignKeyInfo) | ::Grant::Errors::ErrorBase | Cancelled
    ::Grant::Schema::Introspection::Catalog.new(self, namespace).foreign_keys(table)
  end
end

pub class Bucket(T)
  @entries : Hash(String, Array(T))? = nil
  @stale = Set(String).new
  def loaded? : Bool
    !@entries.nil?
  end
  def fetch(table : String, &block : String? -> Array(T) | ErrorBase | Cancelled) : Array(T) | ErrorBase | Cancelled
    entries = @entries
    if entries.nil?
      entries = group_rows((yield nil)!)
      @entries = entries
      @stale = Set(String).new
    elsif @stale.includes?(table)
      rows = (yield table)!
      entries[table] = rows
      @stale.delete(table)
    end
    entries[table]? || [] of T
  end
  def ensure_loaded(&block : -> Array(T) | ErrorBase | Cancelled) : Nil | ErrorBase | Cancelled
    return nil unless @entries.nil?
    @entries = group_rows((yield)!)
    @stale = Set(String).new
    nil
  end
  def replace(rows : Array(T)) : Nil
    @entries = group_rows(rows)
    @stale = Set(String).new
    nil
  end
  def rows : Array(T)
    result = [] of T
    if entries = @entries
      entries.values.each { |list| result.concat(list) }
    end
    result
  end
  def reset_in_place(table : String? = nil) : Nil
    if table.nil?
      @entries = nil
      @stale = Set(String).new
    elsif entries = @entries
      entries.delete(table)
      @stale.add(table)
    end
    nil
  end
  private def group_rows(rows : Array(T)) : Hash(String, Array(T))
    grouped = {} of String => Array(T)
    rows.each do |row|
      grouped[row.table_name] = [] of T unless grouped.has_key?(row.table_name)
      grouped[row.table_name] << row
    end
    grouped
  end
end

# Catalog SQL from src/adapter/{sqlite,pg}.cr. Each method batches one kind.
pub class Catalog
  getter adapter : Base
  getter namespace : String?
  def initialize(@adapter : Base, @namespace : String? = nil)
  end
  private def namespace_sql : String
    (value = namespace) ? Dialect::Pg.quote_literal(value) : "current_schema()"
  end
  private def master : String
    (value = namespace) ? "#{Dialect::Sqlite.quote(value)}.sqlite_master" : "sqlite_master"
  end
  private def table_filter(name : String?, alias_name : String) : String
    name.nil? ? "" : " AND #{alias_name}.name = #{Dialect.for(adapter).quote_literal(name)}"
  end
  def tables : Array(String) | ErrorBase | Cancelled
    sql = adapter.postgres? ? "SELECT c.relname AS name FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = #{namespace_sql} AND c.relkind IN ('r', 'p') ORDER BY c.relname" : "SELECT name FROM #{master} WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name"
    adapter.open { |db| db.query(sql)!.map { |row| row["name"].as(String) } }
  end
  def columns(table : String? = nil) : Array(ColumnInfo) | ErrorBase | Cancelled
    sql = if adapter.postgres?
      filter = table.nil? ? "" : " AND c.relname = #{Dialect::Pg.quote_literal(table)}"
      "SELECT c.relname AS table_name, a.attname AS name, format_type(a.atttypid, a.atttypmod) AS type, a.attnotnull AS required, col_description(a.attrelid, a.attnum) AS comment, pg_get_expr(d.adbin, d.adrelid) AS default_value, COALESCE(array_position(i.indkey::int2[], a.attnum) + 1, 0)::int AS pk_position, (a.attidentity IN ('a', 'd') OR COALESCE(pg_get_expr(d.adbin, d.adrelid) LIKE 'nextval(%', false)) AS auto_increment, a.attnum::int AS position FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace LEFT JOIN pg_index i ON i.indrelid = a.attrelid AND i.indisprimary LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum WHERE n.nspname = #{namespace_sql} AND c.relkind IN ('r', 'p') AND a.attnum > 0 AND NOT a.attisdropped#{filter} ORDER BY c.relname, a.attnum"
    else
      "SELECT m.name AS table_name, p.name, p.type, p.\"notnull\", p.dflt_value, p.pk, p.cid FROM #{master} m JOIN pragma_table_xinfo(m.name) p WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%' AND p.hidden <> 1#{table_filter(table, "m")} ORDER BY m.name, p.cid"
    end
    adapter.open do |db|
      rows = db.query(sql)!
      key_sizes = {} of String => Int32
      unless adapter.postgres?
        rows.each do |row|
          name = row["table_name"].as(String)
          key_sizes[name] = (key_sizes[name]? || 0) + 1 if row["pk"].as(Int64) > 0
        end
      end
      rows.map do |row|
        name = row["table_name"].as(String)
        if adapter.postgres?
          ColumnInfo.new(name, row["name"].as(String), row["type"].as(String), !row["required"].as(Bool), default: row["default_value"].as(String?), primary_key_position: row["pk_position"].as(Int64).to_i32, auto_increment: row["auto_increment"].as(Bool), position: row["position"].as(Int64).to_i32, comment: row["comment"].as(String?))
        else
          position = row["pk"].as(Int64).to_i32
          rowid = position == 1 && key_sizes[name]? == 1 && row["type"].as(String).upcase == "INTEGER"
          ColumnInfo.new(name, row["name"].as(String), row["type"].as(String), row["notnull"].as(Int64) == 0 && !rowid, row["dflt_value"].as(String?), position, rowid, row["cid"].as(Int64).to_i32 + 1)
        end
      end
    end
  end
  def indexes(table : String? = nil) : Array(IndexInfo) | ErrorBase | Cancelled
    sql = if adapter.postgres?
      filter = table.nil? ? "" : " AND t.relname = #{Dialect::Pg.quote_literal(table)}"
      "SELECT t.relname AS table_name, i.relname AS name, x.indisunique AS unique_value, pg_get_expr(x.indpred, x.indrelid) AS predicate, COALESCE(a.attname::text, pg_get_indexdef(x.indexrelid, k.ord::int, true)) AS column_name, (k.attnum = 0) AS expression FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid JOIN pg_class t ON t.oid = x.indrelid JOIN pg_namespace n ON n.oid = t.relnamespace CROSS JOIN LATERAL unnest(x.indkey::int2[]) WITH ORDINALITY AS k(attnum, ord) LEFT JOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = k.attnum WHERE n.nspname = #{namespace_sql} AND NOT x.indisprimary AND k.ord <= x.indnkeyatts#{filter} ORDER BY t.relname, i.relname, k.ord"
    else
      "SELECT m.name AS table_name, il.name, il.\"unique\" AS unique_value, ii.name AS column_name, im.sql AS create_sql FROM #{master} m JOIN pragma_index_list(m.name) il JOIN pragma_index_xinfo(il.name) ii ON ii.key = 1 LEFT JOIN #{master} im ON im.type = 'index' AND im.name = il.name WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%' AND il.origin <> 'pk'#{table_filter(table, "m")} ORDER BY m.name, il.name, ii.seqno"
    end
    adapter.open do |db|
      grouped = {} of String => IndexInfo
      positions = {} of String => Int32
      db.query(sql)!.each do |row|
        table_name = row["table_name"].as(String)
        name = row["name"].as(String)
        key = "#{table_name}:#{name}"
        index = positions[key]? || 0
        column = row["column_name"].as(String?)
        expression = adapter.postgres? ? row["expression"].as(Bool) : column.nil?
        predicate = nil.as(String?)
        unless adapter.postgres?
          text = row["create_sql"].as(String?)
          if text
            at = text.index(" WHERE ")
            predicate = at.nil? ? nil : text[(at + 7)...text.size]
            if column.nil?
              open = text.index('(').as(Int32)
              close = TableRebuild::Scanner.matching_paren(text, open).as(Int32)
              column = TableRebuild::Scanner.split_items(text[(open + 1)...close])[index]
            end
          end
        end
        predicate = row["predicate"].as(String?) if adapter.postgres?
        if current = grouped[key]?
          current.columns << (column || "(expression)")
          if expression && !current.expression?
            grouped[key] = IndexInfo.new(table_name, name, current.columns, current.unique, current.where, true)
          end
        else
          unique = adapter.postgres? ? row["unique_value"].as(Bool) : row["unique_value"].as(Int64) != 0
          grouped[key] = IndexInfo.new(table_name, name, [column || "(expression)"], unique, predicate, expression)
        end
        positions[key] = index + 1
      end
      grouped.values
    end
  end
  def foreign_keys(table : String? = nil) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
    sql = if adapter.postgres?
      filter = table.nil? ? "" : " AND t.relname = #{Dialect::Pg.quote_literal(table)}"
      "SELECT t.relname AS table_name, c.conname AS name, ft.relname AS target, a.attname AS local_column, fa.attname AS foreign_column, c.confupdtype::text AS on_update, c.confdeltype::text AS on_delete FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid JOIN pg_namespace n ON n.oid = t.relnamespace JOIN pg_class ft ON ft.oid = c.confrelid CROSS JOIN LATERAL unnest(c.conkey, c.confkey) WITH ORDINALITY AS k(local_attnum, foreign_attnum, ord) JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = k.local_attnum JOIN pg_attribute fa ON fa.attrelid = c.confrelid AND fa.attnum = k.foreign_attnum WHERE c.contype = 'f' AND n.nspname = #{namespace_sql}#{filter} ORDER BY t.relname, c.conname, k.ord"
    else
      "SELECT m.name AS table_name, fk.id, fk.\"table\" AS target, fk.\"from\" AS local_column, fk.\"to\" AS foreign_column, fk.on_update, fk.on_delete FROM #{master} m JOIN pragma_foreign_key_list(m.name) fk WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite_%'#{table_filter(table, "m")} ORDER BY m.name, fk.id, fk.seq"
    end
    adapter.open do |db|
      grouped = {} of String => ForeignKeyInfo
      db.query(sql)!.each do |row|
        name = adapter.postgres? ? row["name"].as(String) : row["id"].as(Int64).to_s
        table_name = row["table_name"].as(String)
        key = "#{table_name}:#{name}"
        target = row["target"].as(String)
        referenced = row["foreign_column"].as(String?)
        if referenced.nil?
          index = grouped[key]?.nil? ? 0 : grouped[key].columns.size
          referenced = columns(target)!.select { |column| column.primary_key? }.sorted_by { |column| column.primary_key_position }[index].name
        end
        if current = grouped[key]?
          current.columns << row["local_column"].as(String)
          current.primary_key_columns << referenced
        else
          grouped[key] = ForeignKeyInfo.new(table_name, adapter.postgres? ? name : nil, [row["local_column"].as(String)], target, [referenced], action(row["on_update"].as(String)), action(row["on_delete"].as(String)))
        end
      end
      grouped.values
    end
  end
  private def action(text : String) : ReferentialAction
    case text
    when "c" then ReferentialAction::Cascade
    when "r" then ReferentialAction::Restrict
    when "n" then ReferentialAction::SetNull
    when "d" then ReferentialAction::SetDefault
    else ReferentialAction.parse(text)
    end
  end
end

pub class CacheFileError < ErrorBase
end

pub struct CacheFile
  getter version : Int32
  getter adapter : String
  getter tables : Array(String)
  getter columns : Array(ColumnInfo)
  getter indexes : Array(IndexInfo)
  getter foreign_keys : Array(ForeignKeyInfo)
  def initialize(@version : Int32, @adapter : String, @tables : Array(String),
                 @columns : Array(ColumnInfo), @indexes : Array(IndexInfo),
                 @foreign_keys : Array(ForeignKeyInfo))
  end
  def to_json : String
    ::Std::Json::JSON.build do |json|
      json.object do
        json.field("version", version)
        json.field("adapter", adapter)
        json.field("tables") { ::Std::Json::JSON.write_value(tables, json) }
        json.field("columns") do
          json.array do
            columns.each do |row|
              json.object do
                json.field("table_name") { ::Std::Json::JSON.write_value(row.table_name, json) }
                json.field("name") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.name), json) }
                json.field("sql_type") { ::Std::Json::JSON.write_value(row.sql_type, json) }
                json.field("null") { ::Std::Json::JSON.write_value(row.null, json) }
                json.field("default") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.default), json) }
                json.field("primary_key_position") { ::Std::Json::JSON.write_value(row.primary_key_position, json) }
                json.field("auto_increment") { ::Std::Json::JSON.write_value(row.auto_increment, json) }
                json.field("position") { ::Std::Json::JSON.write_value(row.position, json) }
                json.field("comment") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.comment), json) }
              end
            end
          end
        end
        json.field("indexes") do
          json.array do
            indexes.each do |row|
              json.object do
                json.field("table_name") { ::Std::Json::JSON.write_value(row.table_name, json) }
                json.field("name") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.name), json) }
                json.field("columns") { ::Std::Json::JSON.write_value(row.columns, json) }
                json.field("unique") { ::Std::Json::JSON.write_value(row.unique, json) }
                json.field("where") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.where), json) }
                json.field("expression") { ::Std::Json::JSON.write_value(row.expression, json) }
              end
            end
          end
        end
        json.field("foreign_keys") do
          json.array do
            foreign_keys.each do |row|
              json.object do
                json.field("table_name") { ::Std::Json::JSON.write_value(row.table_name, json) }
                json.field("name") { ::Std::Json::JSON.write_value(::Std::Json::Any.new(row.name), json) }
                json.field("columns") { ::Std::Json::JSON.write_value(row.columns, json) }
                json.field("to_table") { ::Std::Json::JSON.write_value(row.to_table, json) }
                json.field("primary_key_columns") { ::Std::Json::JSON.write_value(row.primary_key_columns, json) }
                json.field("on_update") { ::Std::Json::JSON.write_value(row.on_update.to_s, json) }
                json.field("on_delete") { ::Std::Json::JSON.write_value(row.on_delete.to_s, json) }
              end
            end
          end
        end
      end
    end
  end
  private def self.strings(value : ::Std::Json::Any) : Array(String) | CacheFileError
    rows = value.as_a?
    return CacheFileError.new("Invalid schema cache string array") if rows.nil?
    result = [] of String
    rows.each do |row|
      text = row.as_s?
      return CacheFileError.new("Invalid schema cache string") if text.nil?
      result << text
    end
    result
  end
  private def self.action(value : String) : ReferentialAction | CacheFileError
    case value
    when "NoAction" then ReferentialAction::NoAction
    when "Restrict" then ReferentialAction::Restrict
    when "Cascade" then ReferentialAction::Cascade
    when "SetNull" then ReferentialAction::SetNull
    when "SetDefault" then ReferentialAction::SetDefault
    else CacheFileError.new("Invalid schema cache referential action #{value}")
    end
  end
  def self.parse(text : String) : CacheFile | CacheFileError
    parsed = ::Std::Json::JSON.parse?(text)
    return CacheFileError.new("Invalid schema cache JSON") if parsed.nil?
    fields = parsed.as_h?
    return CacheFileError.new("Invalid schema cache object") if fields.nil?
    version = (fields["version"]? || ::Std::Json::Any.new(nil)).as_i?
    adapter = (fields["adapter"]? || ::Std::Json::Any.new(nil)).as_s?
    return CacheFileError.new("Invalid schema cache header") if version.nil? || adapter.nil?
    tables_node = fields["tables"]?
    return CacheFileError.new("Missing schema cache tables") if tables_node.nil?
    tables = strings(tables_node)!
    columns = [] of ColumnInfo
    columns_node = (fields["columns"]? || ::Std::Json::Any.new(nil)).as_a?
    return CacheFileError.new("Invalid schema cache columns") if columns_node.nil?
    columns_node.each do |entry|
      row = entry.as_h?
      return CacheFileError.new("Invalid schema cache columns row") if row.nil?
      field_table_name = (row["table_name"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache table_name") if field_table_name.nil?
      field_name = (row["name"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache name") if field_name.nil?
      field_sql_type = (row["sql_type"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache sql_type") if field_sql_type.nil?
      field_null = (row["null"]? || ::Std::Json::Any.new(nil)).as_bool?
      return CacheFileError.new("Invalid schema cache null") if field_null.nil?
      field_default = (row["default"]? || ::Std::Json::Any.new(nil)).as_s?
      if node = row["default"]?
        return CacheFileError.new("Invalid schema cache default") unless node.raw.nil? || !field_default.nil?
      end
      field_primary_key_position = (row["primary_key_position"]? || ::Std::Json::Any.new(nil)).as_i?
      return CacheFileError.new("Invalid schema cache primary_key_position") if field_primary_key_position.nil?
      field_auto_increment = (row["auto_increment"]? || ::Std::Json::Any.new(nil)).as_bool?
      return CacheFileError.new("Invalid schema cache auto_increment") if field_auto_increment.nil?
      field_position = (row["position"]? || ::Std::Json::Any.new(nil)).as_i?
      return CacheFileError.new("Invalid schema cache position") if field_position.nil?
      field_comment = (row["comment"]? || ::Std::Json::Any.new(nil)).as_s?
      if node = row["comment"]?
        return CacheFileError.new("Invalid schema cache comment") unless node.raw.nil? || !field_comment.nil?
      end
      columns << ColumnInfo.new(field_table_name, field_name, field_sql_type, field_null, field_default, field_primary_key_position, field_auto_increment, field_position, field_comment)
    end
    indexes = [] of IndexInfo
    indexes_node = (fields["indexes"]? || ::Std::Json::Any.new(nil)).as_a?
    return CacheFileError.new("Invalid schema cache indexes") if indexes_node.nil?
    indexes_node.each do |entry|
      row = entry.as_h?
      return CacheFileError.new("Invalid schema cache indexes row") if row.nil?
      field_table_name = (row["table_name"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache table_name") if field_table_name.nil?
      field_name = (row["name"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache name") if field_name.nil?
      node_columns = row["columns"]?
      return CacheFileError.new("Missing schema cache columns") if node_columns.nil?
      field_columns = strings(node_columns)!
      field_unique = (row["unique"]? || ::Std::Json::Any.new(nil)).as_bool?
      return CacheFileError.new("Invalid schema cache unique") if field_unique.nil?
      field_where = (row["where"]? || ::Std::Json::Any.new(nil)).as_s?
      if node = row["where"]?
        return CacheFileError.new("Invalid schema cache where") unless node.raw.nil? || !field_where.nil?
      end
      field_expression = (row["expression"]? || ::Std::Json::Any.new(nil)).as_bool?
      return CacheFileError.new("Invalid schema cache expression") if field_expression.nil?
      indexes << IndexInfo.new(field_table_name, field_name, field_columns, field_unique, field_where, field_expression)
    end
    foreign_keys = [] of ForeignKeyInfo
    foreign_keys_node = (fields["foreign_keys"]? || ::Std::Json::Any.new(nil)).as_a?
    return CacheFileError.new("Invalid schema cache foreign_keys") if foreign_keys_node.nil?
    foreign_keys_node.each do |entry|
      row = entry.as_h?
      return CacheFileError.new("Invalid schema cache foreign_keys row") if row.nil?
      field_table_name = (row["table_name"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache table_name") if field_table_name.nil?
      field_name = (row["name"]? || ::Std::Json::Any.new(nil)).as_s?
      if node = row["name"]?
        return CacheFileError.new("Invalid schema cache name") unless node.raw.nil? || !field_name.nil?
      end
      node_columns = row["columns"]?
      return CacheFileError.new("Missing schema cache columns") if node_columns.nil?
      field_columns = strings(node_columns)!
      field_to_table = (row["to_table"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache to_table") if field_to_table.nil?
      node_primary_key_columns = row["primary_key_columns"]?
      return CacheFileError.new("Missing schema cache primary_key_columns") if node_primary_key_columns.nil?
      field_primary_key_columns = strings(node_primary_key_columns)!
      field_on_update = (row["on_update"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache on_update") if field_on_update.nil?
      field_on_update = action(field_on_update)!
      field_on_delete = (row["on_delete"]? || ::Std::Json::Any.new(nil)).as_s?
      return CacheFileError.new("Invalid schema cache on_delete") if field_on_delete.nil?
      field_on_delete = action(field_on_delete)!
      foreign_keys << ForeignKeyInfo.new(field_table_name, field_name, field_columns, field_to_table, field_primary_key_columns, field_on_update, field_on_delete)
    end
    new(version, adapter, tables, columns, indexes, foreign_keys)
  end
end
