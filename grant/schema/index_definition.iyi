module grant/schema/index_definition

import std/text
import std/digest::{CRC32}
import grant/adapter/schema::{Dialect, InvalidDefinition, UnsupportedOperation}
import grant/schema/column_info::{IndexInfo}
import grant/error::{ErrorBase}

pub class Naming
  def self.digest(text : String) : String
    CRC32.hexdigest(text)
  end
  def self.constraint_name(prefix : String, table : String | Symbol, detail : String) : String
    name = "#{prefix}_#{table.to_s.split('.').last}_#{detail}"
    return name if name.size <= 60
    "#{name[0, 50]}_#{digest(name)}"
  end
  def self.schema_of(table : String | Symbol) : String?
    parts = table.to_s.split('.')
    return nil if parts.size <= 1
    parts.pop
    parts.join(".")
  end

  def self.in_schema_of(table : String | Symbol, name : String | Symbol) : String
    schema = schema_of(table)
    schema ? "#{schema}.#{name}" : name.to_s
  end

  def self.index_name(table : String | Symbol, columns : Array(String)) : String
    "index_#{table.to_s.split('.').last}_on_#{columns.join("_and_")}"
  end

  def self.identifier?(text : String) : Bool
    return false if text.empty?
    index = 0
    text.each_char do |char|
      letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || char == '_'
      return false unless letter || (index > 0 && char >= '0' && char <= '9')
      index += 1
    end
    true
  end
end

pub class IndexDefinition
  getter table : String
  getter columns : Array(String)
  getter unique : Bool
  getter where : String?
  getter using : String?
  getter order : Hash(String, String)
  getter opclass : Hash(String, String)
  getter covering : Array(String)
  getter length : Hash(String, Int32)
  getter algorithm : Symbol?
  getter if_not_exists : Bool
  getter comment : String?

  def initialize(@table : String, @columns : Array(String), name : String? = nil, @unique : Bool = false,
                 @where : String? = nil, @using : String? = nil,
                 @order : Hash(String, String) = {} of String => String,
                 @opclass : Hash(String, String) = {} of String => String,
                 @covering : Array(String) = [] of String,
                 @length : Hash(String, Int32) = {} of String => Int32,
                 @algorithm : Symbol? = nil, @if_not_exists : Bool = false, @comment : String? = nil)
    @name = name
  end

  def unique? : Bool
    @unique
  end

  def name : String
    @name || Naming.index_name(@table, @columns)
  end

  # Builds the definition from the common `add_index` arguments.
  def self.build(table : String | Symbol, columns : C, name : String | Symbol? = nil, unique : Bool = false,
                 where : String? = nil, using index_using : String | Symbol? = nil,
                 order = nil,
                 opclass = nil,
                 include covering = nil, length = nil,
                 algorithm : Symbol? = nil, if_not_exists : Bool = false, comment : String? = nil) : IndexDefinition | ErrorBase forall C
    names = to_names(columns)
    return InvalidDefinition.new("Index on '#{table}' needs at least one column") if names.empty?
    if name.nil? && names.any? { |column| !Naming.identifier?(column) }
      return InvalidDefinition.new("An expression index on '#{table}' needs an explicit name:")
    end
    orders = {} of String => String
    case order
    when Symbol           then names.each { |column| orders[column] = order.to_s.upcase }
    when Hash, NamedTuple then order.each { |column, direction| orders[column.to_s] = direction.to_s.upcase }
    end
    classes = {} of String => String
    case opclass
    when String         then names.each { |column| classes[column] = opclass }
    when Hash, NamedTuple then opclass.each { |column, klass| classes[column.to_s] = klass }
    end
    lengths = {} of String => Int32
    case length
    when Int32            then names.each { |column| lengths[column] = length }
    when Hash, NamedTuple then length.each { |column, size| lengths[column.to_s] = size }
    end
    new(table.to_s, names, name.nil? ? nil : name.to_s, unique, where, index_using.nil? ? nil : index_using.to_s, orders, classes,
      covering ? to_names(covering) : [] of String, lengths, algorithm, if_not_exists, comment)
  end

  # The definition that recreates *info* (for a rename on SQLite, which has
  # no `ALTER INDEX`).
  def self.from_info(info : IndexInfo, columns : Array(String) = info.columns, name : String = info.name) : IndexDefinition
    new(info.table_name, columns, name, info.unique?, info.where)
  end

  def self.to_names(columns : C) : Array(String) forall C
    case columns
    when String, Symbol then [columns.to_s]
    when Array            then columns.map(&.to_s)
    else [columns.to_s]
    end
  end

  # `CREATE INDEX` for *dialect*.
  #
  # Options a dialect cannot express raise `UnsupportedOperation`:
  # `where:` and `include:` on MySQL, `include:` and `opclass:` on SQLite,
  # `using:` other than btree on SQLite, `length:` off MySQL. `algorithm:
  # :concurrently` builds without blocking writes on PostgreSQL and is
  # ignored elsewhere; `:inplace`, `:copy` and `:default` set MySQL's
  # `ALGORITHM=`.
  def to_sql(dialect : Dialect) : String | ErrorBase
    validate_for(dialect)!
    String.build do |io|
      io << "CREATE "
      io << "UNIQUE " if unique?
      if dialect == Dialect::Mysql && (kind = @using) && ["fulltext", "spatial"].includes?(kind.downcase)
        io << kind.upcase << ' '
      end
      io << "INDEX "
      io << "CONCURRENTLY " if dialect == Dialect::Pg && @algorithm == :concurrently
      io << "IF NOT EXISTS " if @if_not_exists && dialect != Dialect::Mysql
      # SQLite names the schema on the index and not on the table.
      if dialect == Dialect::Sqlite
        io << dialect.quote(Naming.in_schema_of(@table, name)) << " ON " << dialect.quote(@table.split('.').last)
      else
        io << dialect.quote(name) << " ON " << dialect.quote(@table)
      end
      io << " USING " << @using if dialect == Dialect::Pg && @using
      io << " (" << @columns.map { |column| column_sql(dialect, column)! }.join(", ") << ')'
      if dialect == Dialect::Mysql && (index_using = @using) && !["fulltext", "spatial"].includes?(index_using.downcase)
        io << " USING " << index_using.upcase
      end
      io << " INCLUDE (" << @covering.map { |column| dialect.quote(column) }.join(", ") << ')' unless @covering.empty?
      io << " WHERE " << @where if @where
      if dialect == Dialect::Mysql && (algorithm = @algorithm) && [:inplace, :copy, :default].includes?(algorithm)
        io << " ALGORITHM=" << algorithm.to_s.upcase
      end
      if dialect == Dialect::Mysql && (text = @comment)
        io << " COMMENT " << dialect.quote_literal(text)
      end
    end
  end

  # All statements that create the index: the `CREATE INDEX`, and on
  # PostgreSQL a `COMMENT ON INDEX`.
  def statements(dialect : Dialect) : Array(String) | ErrorBase
    result = [to_sql(dialect)!]
    if dialect == Dialect::Pg && (text = @comment)
      result << "COMMENT ON INDEX #{dialect.quote(Naming.in_schema_of(@table, name))} IS #{dialect.quote_literal(text)}"
    end
    result
  end

  # True when the statement cannot run inside a transaction.
  def concurrent?(dialect : Dialect) : Bool
    dialect == Dialect::Pg && @algorithm == :concurrently
  end

  private def column_sql(dialect : Dialect, column : String) : String | ErrorBase
    sql = Naming.identifier?(column) ? dialect.quote(column) : "(#{column})"
    if size = @length[column]?
      sql += "(#{size})"
    end
    if klass = @opclass[column]?
      sql += " #{klass}"
    end
    if direction = @order[column]?
      return InvalidDefinition.new("Unknown index order #{direction.inspect} for '#{column}'") unless ["ASC", "DESC"].includes?(direction)
      sql += " #{direction}"
    end
    sql
  end

  private def validate_for(dialect : Dialect) : Nil | ErrorBase
    return InvalidDefinition.new("Index on '#{@table}' needs at least one column") if @columns.empty?
    if @name.nil? && @columns.any? { |column| !Naming.identifier?(column) }
      return InvalidDefinition.new("An expression index on '#{@table}' needs an explicit name:")
    end
    unless @algorithm.nil?
      unless [:concurrently, :inplace, :copy, :default].includes?(@algorithm.as(Symbol))
        return InvalidDefinition.new("Unknown index algorithm #{@algorithm.inspect}")
      end
    end
    if dialect == Dialect::Mysql
      return UnsupportedOperation.new("MySQL has no partial indexes (where: on '#{name}')") if @where
      return UnsupportedOperation.new("MySQL has no INCLUDE columns (index '#{name}')") unless @covering.empty?
      return UnsupportedOperation.new("MySQL has no IF NOT EXISTS for indexes ('#{name}')") if @if_not_exists
      return UnsupportedOperation.new("MySQL has no operator classes (index '#{name}')") unless @opclass.empty?
    else
      return UnsupportedOperation.new("Index prefix length: is only supported on MySQL ('#{name}')") unless @length.empty?
    end
    if dialect == Dialect::Sqlite
      return UnsupportedOperation.new("SQLite has no INCLUDE columns (index '#{name}')") unless @covering.empty?
      return UnsupportedOperation.new("SQLite has no operator classes (index '#{name}')") unless @opclass.empty?
      if (kind = @using) && kind.downcase != "btree"
        return UnsupportedOperation.new("SQLite only has btree indexes (using: #{kind.inspect} on '#{name}')")
      end
    end
    max = dialect == Dialect::Pg ? 63 : 64
    return InvalidDefinition.new("Index name '#{name}' is longer than #{max} characters") if name.size > max
    nil
  end
end
