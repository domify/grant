module grant/schema/alter_table
import grant/adapter/schema::{Dialect, UnsupportedOperation, InvalidDefinition}
import grant/schema/column_info::{ColumnInfo}
import grant/schema/constraint_definition::{ForeignKeyDefinition, CheckConstraintDefinition, UniqueConstraintDefinition, ExclusionConstraintDefinition}
import grant/schema/index_definition::{IndexDefinition, Naming}
import grant/errors::{ErrorBase}
import grant/schema/table_rebuild::{TableRebuild}
import grant/schema/table_definition::{TableDefinition, ColumnDefinition, Unset, UNSET}
import std/text

pub class AlterStep
  getter pre = [] of String
  getter clauses = [] of String
  getter post = [] of String
  getter native = [] of String
  property edit : Proc(TableRebuild, Nil | ErrorBase)? = nil
  property rebuild : Bool = false
  def rebuild? : Bool
    rebuild
  end
end

pub class AlterTableDefinition(S)
  getter table : String
  getter steps = [] of AlterStep
  def initialize(@table : String, @source : S)
  end
  def column(name : String | Symbol, type : String | Symbol, **options) : Nil | ErrorBase | Cancelled
    definition = TableDefinition.new(table, @source.dialect)
    definition.column(name, type, **options)!
    @steps << @source.step_add_column(table, definition.columns.first)!
    nil
  end
  {% for kind in ["string", "integer", "bigint", "text", "datetime", "boolean"] %}
    def {{kind.id}}(name : String | Symbol, **options) : Nil | ErrorBase | Cancelled
      column(name, :{{kind.id}}, **options)
    end
  {% end %}
  def remove(*names, if_exists : Bool = false) : Nil | ErrorBase | Cancelled
    names.each { |name| @steps << @source.step_remove_column(table, name.to_s, if_exists)! }
    nil
  end
  def change_null(name : String | Symbol, null : Bool, default = UNSET) : Nil | ErrorBase | Cancelled
    @steps << @source.step_change_column_null(table, name.to_s, null, default)!
    nil
  end
  def comment(text : String?) : Nil
    step = AlterStep.new
    step.post.concat(@source.change_table_comment_statements(table, text))
    @steps << step
    nil
  end
end

pub macro methods
  def add_foreign_key_statements(from_table : String | Symbol, to_table : String | Symbol, column = nil, primary_key = nil, name : String | Symbol? = nil, on_delete : Symbol? = nil, on_update : Symbol? = nil, deferrable : Bool | Symbol? = nil, validate : Bool = true, if_not_exists : Bool = false) : Array(String) | ErrorBase | Cancelled
    definition = ForeignKeyDefinition.build(from_table, to_table, column, primary_key, name, on_delete, on_update, deferrable, validate)
    if if_not_exists
      known = lookup_foreign_keys(definition.table)!
      return [] of String if !known.nil? && known.any? { |key| key.to_table == definition.to_table && key.columns == definition.columns }
    end
    render_steps(definition.table, [step_add_foreign_key(definition)!], false)
  end
  def validate_foreign_key_statements(from_table : String | Symbol, to_table : String | Symbol? = nil, column = nil, name : String | Symbol? = nil) : Array(String) | ErrorBase | Cancelled
    return [] of String unless dialect == Dialect::Pg
    key_name = name.nil? ? resolve_foreign_key_name(from_table.to_s, to_table, column)! : name.to_s
    ["ALTER TABLE #{dialect.quote(from_table)} VALIDATE CONSTRAINT #{dialect.quote(key_name)}"]
  end
  def remove_foreign_key_statements(from_table : String | Symbol, to_table : String | Symbol? = nil, column = nil, name : String | Symbol? = nil, if_exists : Bool = false) : Array(String) | ErrorBase | Cancelled
    if if_exists
      known = lookup_foreign_keys(from_table.to_s)!
      unless known.nil?
        wanted = column.nil? ? (to_table.nil? ? nil : [Naming.foreign_key_column(to_table)]) : IndexDefinition.to_names(column)
        found = known.any? do |key|
          (!name.nil? && key.name == name.to_s) || (!wanted.nil? && key.columns == wanted && (to_table.nil? || key.to_table == to_table.to_s))
        end
        return [] of String unless found
      end
    end
    render_steps(from_table.to_s, [step_remove_foreign_key(from_table.to_s, to_table, column, name, if_exists)!], false)
  end
  def step_add_foreign_key(definition : ForeignKeyDefinition) : AlterStep | ErrorBase
    step = AlterStep.new
    sql = definition.constraint_sql(dialect)!
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) { rebuild.add_constraint(sql) }
    else
      step.clauses << "ADD #{sql}#{dialect == Dialect::Pg && !definition.validate? ? " NOT VALID" : ""}"
    end
    step
  end
  def step_remove_foreign_key(table : String, to_table : String | Symbol?, column, name : String | Symbol?, if_exists : Bool) : AlterStep | ErrorBase | Cancelled
    step = AlterStep.new
    columns = column.nil? ? (to_table.nil? ? nil : [Naming.foreign_key_column(to_table)]) : IndexDefinition.to_names(column)
    if dialect == Dialect::Sqlite
      wanted_name = name.nil? ? nil : name.to_s
      return InvalidDefinition.new("remove_foreign_key on '#{table}' needs to_table:, column: or name:") if columns.nil? && wanted_name.nil?
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) do
        removed = rebuild.remove_foreign_key(wanted_name, columns)
        (removed == 0 && !if_exists ? InvalidDefinition.new("Table '#{table}' has no such foreign key") : nil).as(Nil | ErrorBase)
      end
    else
      key_name = name.nil? ? resolve_foreign_key_name(table, to_table, column)! : name.to_s
      step.clauses << (dialect == Dialect::Pg ? "DROP CONSTRAINT #{if_exists ? "IF EXISTS " : ""}#{dialect.quote(key_name)}" : "DROP FOREIGN KEY #{dialect.quote(key_name)}")
    end
    step
  end
  private def resolve_foreign_key_name(table : String, to_table : String | Symbol?, column) : String | ErrorBase | Cancelled
    columns = column.nil? ? (to_table.nil? ? nil : [Naming.foreign_key_column(to_table)]) : IndexDefinition.to_names(column)
    return InvalidDefinition.new("A foreign key of '#{table}' needs to_table:, column: or name:") if columns.nil?
    if known = lookup_foreign_keys(table)!
      key = known.find { |entry| (to_table.nil? || entry.to_table == to_table.to_s) && (columns.nil? || entry.columns == columns) }
      return key.name.as(String) if !key.nil? && !key.name.nil?
    end
    Naming.constraint_name("fk", table, columns.join("_"))
  end
  {% for method in ["add_foreign_key", "remove_foreign_key", "validate_foreign_key"] %}
    def {{method.id}}(*args, **options) : Nil | ErrorBase | Cancelled
      execute_batch({{method.id}}_statements(*args, **options)!)
    end
  {% end %}
  def add_check_constraint_statements(table : String | Symbol, expression : String, name : String? = nil, validate : Bool = true) : Array(String) | ErrorBase | Cancelled
    definition = CheckConstraintDefinition.new(table.to_s, expression, name, validate)
    step = AlterStep.new
    sql = definition.constraint_sql(dialect)!
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) { rebuild.add_constraint(sql) }
    else
      step.clauses << "ADD #{sql}#{!validate && dialect == Dialect::Pg ? " NOT VALID" : ""}"
    end
    render_steps(table.to_s, [step], false)
  end
  def validate_check_constraint_statements(table : String | Symbol, name : String) : Array(String)
    dialect == Dialect::Pg ? ["ALTER TABLE #{dialect.quote(table)} VALIDATE CONSTRAINT #{dialect.quote(name)}"] : [] of String
  end
  def remove_check_constraint_statements(table : String | Symbol, expression : String? = nil, name : String? = nil) : Array(String) | ErrorBase | Cancelled
    selected = name
    if selected.nil? && expression
      selected = CheckConstraintDefinition.new(table.to_s, expression).name
    end
    return InvalidDefinition.new("A check constraint needs name: or expression") if selected.nil?
    step = AlterStep.new
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) do
        (rebuild.remove_check(selected, expression) == 0 ? InvalidDefinition.new("Table '#{table}' has no such check constraint") : nil).as(Nil | ErrorBase)
      end
    else
      step.clauses << "DROP #{dialect == Dialect::Mysql ? "CHECK" : "CONSTRAINT"} #{dialect.quote(selected)}"
    end
    render_steps(table.to_s, [step], false)
  end
  def add_unique_constraint_statements(table : String | Symbol, columns : C, name : String? = nil, deferrable : Bool | Symbol? = nil, using_index : String? = nil) : Array(String) | ErrorBase | Cancelled forall C
    definition = UniqueConstraintDefinition.new(table.to_s, IndexDefinition.to_names(columns), name, deferrable, using_index)
    sql = definition.constraint_sql(dialect)!
    step = AlterStep.new
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) { rebuild.add_constraint(sql) }
    else
      step.clauses << "ADD #{sql}"
    end
    render_steps(table.to_s, [step], false)
  end
  def remove_unique_constraint_statements(table : String | Symbol, columns = nil, name : String? = nil) : Array(String) | ErrorBase | Cancelled
    names = columns.nil? ? nil : IndexDefinition.to_names(columns)
    selected = name || (names.nil? ? nil : Naming.constraint_name("uniq", table, names.join("_")))
    return InvalidDefinition.new("A unique constraint needs columns: or name:") if selected.nil?
    step = AlterStep.new
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) do
        (rebuild.remove_unique(selected, names) == 0 ? InvalidDefinition.new("Table '#{table}' has no such unique constraint") : nil).as(Nil | ErrorBase)
      end
    else
      step.clauses << "DROP #{dialect == Dialect::Mysql ? "INDEX" : "CONSTRAINT"} #{dialect.quote(selected)}"
    end
    render_steps(table.to_s, [step], false)
  end
  def add_exclusion_constraint_statements(table : String | Symbol, expression : String, using index_method : String | Symbol? = nil, name : String? = nil, where : String? = nil, deferrable : Bool | Symbol? = nil) : Array(String) | ErrorBase
    definition = ExclusionConstraintDefinition.new(table.to_s, expression, index_method.nil? ? nil : index_method.to_s, where, name, deferrable)
    ["ALTER TABLE #{dialect.quote(table)} ADD #{definition.constraint_sql(dialect)!}"]
  end
  def remove_exclusion_constraint_statements(table : String | Symbol, name : String) : Array(String) | ErrorBase
    return UnsupportedOperation.new("Exclusion constraints are only supported on PostgreSQL") unless dialect == Dialect::Pg
    ["ALTER TABLE #{dialect.quote(table)} DROP CONSTRAINT #{dialect.quote(name)}"]
  end
  def validate_check_constraint(*args, **options) : Nil | ErrorBase | Cancelled
    execute_batch(validate_check_constraint_statements(*args, **options))
  end
  {% for method in ["add_check_constraint", "remove_check_constraint", "add_unique_constraint", "remove_unique_constraint", "add_exclusion_constraint", "remove_exclusion_constraint"] %}
    def {{method.id}}(*args, **options) : Nil | ErrorBase | Cancelled
      execute_batch({{method.id}}_statements(*args, **options)!)
    end
  {% end %}
  def step_add_column(table : String, definition : ColumnDefinition, if_not_exists : Bool = false, inline_reference : ForeignKeyDefinition? = nil) : AlterStep | ErrorBase | Cancelled
    step = AlterStep.new
    if if_not_exists && dialect != Dialect::Pg
      return step unless lookup_column(table, definition.name)!.nil?
    end
    column_sql = definition.to_sql(dialect)!
    if dialect == Dialect::Pg
      step.clauses << "ADD COLUMN #{if_not_exists ? "IF NOT EXISTS " : ""}#{column_sql}"
      if text = definition.comment
        step.post << "COMMENT ON COLUMN #{dialect.quote(table)}.#{dialect.quote(definition.name)} IS #{dialect.quote_literal(text)}"
      end
    elsif dialect == Dialect::Mysql
      step.clauses << "ADD COLUMN #{column_sql}"
    else
      column_sql += " #{inline_reference.inline_sql(dialect)!}" unless inline_reference.nil?
      step.native << "ALTER TABLE #{dialect.quote(table)} ADD COLUMN #{column_sql}"
      step.rebuild = (!definition.null && definition.default_clause.empty?) || definition.expression_default
      step.edit = ->(rebuild : TableRebuild) { rebuild.add_column(column_sql) }
    end
    step
  end

  def step_remove_column(table : String, name : String, if_exists : Bool = false) : AlterStep | ErrorBase | Cancelled
    step = AlterStep.new
    if if_exists && dialect != Dialect::Pg
      return step if lookup_column(table, name)!.nil?
    end
    if dialect == Dialect::Sqlite
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) { rebuild.remove_column(name) }
    else
      step.clauses << "DROP COLUMN #{if_exists && dialect == Dialect::Pg ? "IF EXISTS " : ""}#{dialect.quote(name)}"
    end
    step
  end

  def step_change_column(table : String, name : String, type : String | Symbol, null : Bool? = nil,
                         default = UNSET, default_sql : String? = nil, using expression : String? = nil) : AlterStep | ErrorBase | Cancelled
    definition = TableDefinition.new(table, dialect)
    definition.column(name, type, null: null != false, default: default, default_sql: default_sql)!
    column = definition.columns.first
    step = AlterStep.new
    if dialect == Dialect::Pg
      clause = "ALTER COLUMN #{dialect.quote(name)} TYPE #{column.type}"
      clause += " USING #{expression}" if expression
      step.clauses << clause
      step.clauses << "ALTER COLUMN #{dialect.quote(name)} #{null ? "DROP" : "SET"} NOT NULL" unless null.nil?
      step.clauses << "ALTER COLUMN #{dialect.quote(name)} SET#{column.default_clause}" unless column.default_clause.empty?
    elsif dialect == Dialect::Mysql
      current = lookup_column(table, name)!
      column.null = current.null? if null.nil? && current
      text = column.to_sql(dialect)!
      text += " DEFAULT #{current.default}" if default.is_a?(Unset) && default_sql.nil? && current && current.default
      step.clauses << "MODIFY COLUMN #{text}"
    else
      step.rebuild = true
      column.null = true
      text = column.to_sql(dialect)!
      step.edit = ->(rebuild : TableRebuild) do
        rebuild.change_column(name) do |old|
          changed = text
          changed += " NOT NULL" if null.nil? ? old.upcase.includes?(" NOT NULL") : !null
          if default.is_a?(Unset) && default_sql.nil?
            previous = TableRebuild::Scanner.default_clause(old)
            changed += " #{previous}" if previous
          end
          if key_at = old.upcase.index(" PRIMARY KEY")
            changed += old[key_at...old.size]
          end
          changed
        end
      end
    end
    step
  end

  def step_change_column_null(table : String, name : String, null : Bool, default = UNSET) : AlterStep | ErrorBase | Cancelled
    step = AlterStep.new
    if !null && !default.is_a?(Unset)
      step.pre << "UPDATE #{dialect.quote(table)} SET #{dialect.quote(name)} = #{dialect.quote_literal(default)} WHERE #{dialect.quote(name)} IS NULL"
    end
    if dialect == Dialect::Pg
      step.clauses << "ALTER COLUMN #{dialect.quote(name)} #{null ? "DROP" : "SET"} NOT NULL"
    elsif dialect == Dialect::Mysql
      info = lookup_column(table, name)!
      return UnsupportedOperation.new("Changing NULL needs a database connection to read the column") if info.nil?
      step.clauses << "MODIFY COLUMN #{dialect.quote(name)} #{info.sql_type}#{null ? "" : " NOT NULL"}#{info.default.nil? ? "" : " DEFAULT #{info.default}"}"
    else
      step.rebuild = true
      step.edit = ->(rebuild : TableRebuild) do
        rebuild.change_column(name) do |old|
          # The catalog's keyword spelling is preserved outside this clause.
          text = old.gsub(" NOT NULL", "").gsub(" not null", "")
          null ? text : "#{text} NOT NULL"
        end
      end
    end
    step
  end

  def render_steps(table : String, steps : Array(AlterStep), bulk : Bool) : Array(String) | ErrorBase | Cancelled
    result = [] of String
    if dialect == Dialect::Sqlite
      if steps.any? { |step| step.rebuild? }
        steps.each { |step| result.concat(step.pre) }
        catalog = catalog_sqlite_table(table)!
        rebuild = TableRebuild.new(table, catalog[0], catalog[1])
        steps.each do |step|
          if edit = step.edit
            edit.call(rebuild)!
          elsif !step.native.empty?
            return UnsupportedOperation.new("This change to '#{table}' cannot be combined with a table rebuild on SQLite; run it separately")
          end
        end
        result.concat(rebuild.statements)
        steps.each { |step| result.concat(step.post) }
      else
        steps.each { |step| result.concat(step.pre); result.concat(step.native); result.concat(step.post) }
      end
      return result
    end
    head = "ALTER TABLE #{dialect.quote(table)}"
    pending = [] of String
    steps.each do |step|
      unless step.pre.empty?
        result << "#{head} #{pending.join(", ")}" unless pending.empty?
        pending.clear
        result.concat(step.pre)
      end
      pending.concat(step.clauses)
      if !bulk || !step.post.empty?
        result << "#{head} #{pending.join(", ")}" unless pending.empty?
        pending.clear
      end
      result.concat(step.post)
    end
    result << "#{head} #{pending.join(", ")}" unless pending.empty?
    result
  end

  def add_column_statements(table : String | Symbol, name : String | Symbol, type : String | Symbol,
                            if_not_exists : Bool = false, **options) : Array(String) | ErrorBase | Cancelled
    definition = TableDefinition.new(table.to_s, dialect)
    definition.column(name, type, **options)!
    render_steps(table.to_s, [step_add_column(table.to_s, definition.columns.first, if_not_exists)!], false)
  end
  def remove_column_statements(table : String | Symbol, name : String | Symbol, type : String | Symbol? = nil,
                               if_exists : Bool = false) : Array(String) | ErrorBase | Cancelled
    render_steps(table.to_s, [step_remove_column(table.to_s, name.to_s, if_exists)!], false)
  end
  def change_column_statements(table : String | Symbol, name : String | Symbol, type : String | Symbol, **options) : Array(String) | ErrorBase | Cancelled
    render_steps(table.to_s, [step_change_column(table.to_s, name.to_s, type, **options)!], false)
  end
  def change_column_null_statements(table : String | Symbol, name : String | Symbol, null : Bool, default = UNSET) : Array(String) | ErrorBase | Cancelled
    render_steps(table.to_s, [step_change_column_null(table.to_s, name.to_s, null, default)!], false)
  end
  def change_table_statements(table : String | Symbol, bulk : Bool = false, &block : AlterTableDefinition(self) -> T) : Array(String) | ErrorBase | Cancelled forall T
    definition = AlterTableDefinition.new(table.to_s, self)
    result = yield definition
    return result if result.is_a?(::Error)
    render_steps(table.to_s, definition.steps, bulk)
  end
  {% for method in ["change_column", "change_column_null"] %}
    def {{method.id}}(*args, **options) : Nil | ErrorBase | Cancelled
      execute_batch({{method.id}}_statements(*args, **options)!)
    end
  {% end %}
  def change_table_comment_statements(table : String | Symbol, text : String?) : Array(String)
    case dialect
    when Dialect::Pg then ["COMMENT ON TABLE #{dialect.quote(table)} IS #{dialect.quote_literal(text)}"]
    when Dialect::Mysql then ["ALTER TABLE #{dialect.quote(table)} COMMENT = #{dialect.quote_literal(text || "")}"]
    else [] of String
    end
  end
  def change_column_comment_statements(table : String | Symbol, column : String | Symbol, text : String?) : Array(String) | ErrorBase
    case dialect
    when Dialect::Pg then ["COMMENT ON COLUMN #{dialect.quote(table)}.#{dialect.quote(column)} IS #{dialect.quote_literal(text)}"]
    when Dialect::Mysql
      lookup = lookup_column(table.to_s, column.to_s)
      return ErrorBase.new("Column lookup was cancelled") if lookup.is_a?(Cancelled)
      info = lookup!
      return UnsupportedOperation.new("Changing the comment needs a database connection to read the column") if info.nil?
      default = info.default
      ["ALTER TABLE #{dialect.quote(table)} MODIFY COLUMN #{dialect.quote(column)} #{info.sql_type}#{info.null? ? "" : " NOT NULL"}#{default.nil? ? "" : " DEFAULT #{default}"} COMMENT #{dialect.quote_literal(text || "")}"]
    else [] of String
    end
  end
  def create_enum_statements(name : String | Symbol, values : Array(T), if_not_exists : Bool = false) : Array(String) | ErrorBase forall T
    return UnsupportedOperation.new("create_enum requires PostgreSQL") unless dialect == Dialect::Pg
    return InvalidDefinition.new("Enum needs at least one value") if values.empty?
    create = "CREATE TYPE #{dialect.quote(name)} AS ENUM (#{values.map { |v| dialect.quote_literal(v.to_s) }.join(", ")})"
    if_not_exists ? ["DO $grant$ BEGIN #{create}; EXCEPTION WHEN duplicate_object THEN NULL; END $grant$"] : [create]
  end
  def drop_enum_statements(name : String | Symbol, if_exists : Bool = false, cascade : Bool = false) : Array(String) | ErrorBase
    return UnsupportedOperation.new("drop_enum requires PostgreSQL") unless dialect == Dialect::Pg
    ["DROP TYPE #{if_exists ? "IF EXISTS " : ""}#{dialect.quote(name)}#{cascade ? " CASCADE" : ""}"]
  end
  def rename_enum_statements(name : String | Symbol, to : String | Symbol) : Array(String) | ErrorBase
    return UnsupportedOperation.new("rename_enum requires PostgreSQL") unless dialect == Dialect::Pg
    ["ALTER TYPE #{dialect.quote(name)} RENAME TO #{dialect.quote(to)}"]
  end
  def add_enum_value_statements(name : String | Symbol, value : String | Symbol, before : String | Symbol? = nil, after : String | Symbol? = nil, if_not_exists : Bool = false) : Array(String) | ErrorBase
    return UnsupportedOperation.new("add_enum_value requires PostgreSQL") unless dialect == Dialect::Pg
    return InvalidDefinition.new("Give before: or after:, not both") if before && after
    sql = "ALTER TYPE #{dialect.quote(name)} ADD VALUE #{if_not_exists ? "IF NOT EXISTS " : ""}#{dialect.quote_literal(value.to_s)}"
    sql += " BEFORE #{dialect.quote_literal(before.to_s)}" if before
    sql += " AFTER #{dialect.quote_literal(after.to_s)}" if after
    [sql]
  end
  def rename_enum_value_statements(name : String | Symbol, from : String | Symbol, to : String | Symbol) : Array(String) | ErrorBase
    return UnsupportedOperation.new("rename_enum_value requires PostgreSQL") unless dialect == Dialect::Pg
    ["ALTER TYPE #{dialect.quote(name)} RENAME VALUE #{dialect.quote_literal(from.to_s)} TO #{dialect.quote_literal(to.to_s)}"]
  end
  def enable_extension_statements(name : String | Symbol) : Array(String)
    dialect == Dialect::Pg ? ["CREATE EXTENSION IF NOT EXISTS #{dialect.quote(name)}"] : [] of String
  end
  def disable_extension_statements(name : String | Symbol, cascade : Bool = true) : Array(String)
    dialect == Dialect::Pg ? ["DROP EXTENSION IF EXISTS #{dialect.quote(name)}#{cascade ? " CASCADE" : ""}"] : [] of String
  end
  {% for name in ["change_table_comment", "change_column_comment", "create_enum", "drop_enum", "rename_enum", "add_enum_value", "rename_enum_value", "enable_extension", "disable_extension"] %}
    def {{name.id}}(*args, **options) : Nil | ErrorBase | Cancelled
      execute_batch({{name.id}}_statements(*args, **options){% unless ["change_table_comment", "enable_extension", "disable_extension"].includes?(name) %}!{% end %})
    end
  {% end %}
end
