module grant/schema/table_definition_constraints
pub import grant/schema/constraint_definition
pub import grant/schema/index_definition
pub import grant/counter_cache
import grant/errors::{ErrorBase}

pub macro methods
  def references(*names, polymorphic : Bool = false, null : Bool = true, index : Bool = true, foreign_key = false, type : Symbol = :bigint, default = ::Grant::Schema::TableDefinition::UNSET, comment : String? = nil, unique : Bool = false) : Nil | ErrorBase
    names.each do |name|
      column_name = "#{name}_id"
      column(column_name, type, null: null, default: default, comment: comment)!
      column("#{name}_type", :string, null: null)! if polymorphic
      if index
        index_columns = polymorphic ? ["#{name}_type", column_name] : [column_name]
        self.index(index_columns, unique: unique)!
      end
      add_reference_foreign_key(name.to_s, column_name, foreign_key) if foreign_key != false && !polymorphic
    end
    nil
  end
  def belongs_to(*names, **options) : Nil | ErrorBase
    references(*names, **options)
  end
  private def add_reference_foreign_key(name : String, column_name : String, options) : Nil
    to_table = ::Grant::CounterCache.pluralize(name)
    column = column_name
    primary_key = nil.as(String | Symbol?)
    key_name = nil.as(String | Symbol?)
    on_delete = nil.as(Symbol?)
    on_update = nil.as(Symbol?)
    deferrable = nil.as(Bool | Symbol?)
    unless options.is_a?(Bool)
      target = options[:to_table]?
      to_table = target.to_s unless target.nil?
      custom_column = options[:column]?
      column = custom_column.to_s unless custom_column.nil?
      primary_key = options[:primary_key]?
      key_name = options[:name]?
      on_delete = options[:on_delete]?
      on_update = options[:on_update]?
      deferrable = options[:deferrable]?
    end
    foreign_key(to_table, column: column, primary_key: primary_key, name: key_name, on_delete: on_delete, on_update: on_update, deferrable: deferrable)
    nil
  end
  getter foreign_keys = [] of ::Grant::Schema::ConstraintDefinition::ForeignKeyDefinition
  def foreign_key(to_table : String | Symbol, column = nil, primary_key = nil, name : String | Symbol? = nil, on_delete : Symbol? = nil, on_update : Symbol? = nil, deferrable : Bool | Symbol? = nil) : ::Grant::Schema::ConstraintDefinition::ForeignKeyDefinition
    definition = ::Grant::Schema::ConstraintDefinition::ForeignKeyDefinition.build(table, to_table, column, primary_key, name, on_delete, on_update, deferrable)
    @foreign_keys << definition
    definition
  end
  getter check_constraints = [] of ::Grant::Schema::ConstraintDefinition::CheckConstraintDefinition
  getter unique_constraints = [] of ::Grant::Schema::ConstraintDefinition::UniqueConstraintDefinition
  def check_constraint(expression : String, name : String? = nil, validate : Bool = true) : Nil
    @check_constraints << ::Grant::Schema::ConstraintDefinition::CheckConstraintDefinition.new(table, expression, name, validate)
    nil
  end
  def unique_constraint(columns : C, name : String? = nil, deferrable : Bool | Symbol? = nil) : Nil forall C
    @unique_constraints << ::Grant::Schema::ConstraintDefinition::UniqueConstraintDefinition.new(table, ::Grant::Schema::IndexDefinition::IndexDefinition.to_names(columns), name, deferrable)
    nil
  end
end
