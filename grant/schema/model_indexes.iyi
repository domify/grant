module grant/schema/model_indexes

pub import grant/schema/index_definition

# Keep the upstream per-declaration class methods, collected by Migrator.
pub macro index(columns, **options)
  {% names = columns.is_a?(ArrayLiteral) ? columns : [columns] %}
  {% suffix = names.map(&.id.stringify.gsub(/[^A-Za-z0-9_]/, "_")).join("_") %}
  def self.__grant_index_{{suffix.id}}(table : String) : ::Grant::Schema::IndexDefinition::IndexDefinition | ::Grant::Error::ErrorBase
    ::Grant::Schema::IndexDefinition::IndexDefinition.build(table, {{columns}}{{", ".id if options.size > 0}}{{options.double_splat}})
  end
end
