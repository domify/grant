module grant/schema/command_recorder
import grant/schema/schema_statements::{AdapterStatements, RecordingStatements}
import grant/schema/table_definition::{TableDefinition}
import grant/error::{ErrorBase}

pub alias SchemaStatements = AdapterStatements | RecordingStatements
pub class IrreversibleMigration < ErrorBase
  def initialize(message : String = "This migration cannot be reversed")
    super(message)
  end
end
pub class Command
  pub alias Action = Proc(SchemaStatements, Nil | ErrorBase | Cancelled)
  getter name : String
  getter inverse_name : String?
  def initialize(@name : String, @forward : Action, @inverse : Action?, @inverse_name : String? = nil)
  end
  def reversible? : Bool
    !@inverse.nil?
  end
  def apply(statements : SchemaStatements) : Nil | ErrorBase | Cancelled
    @forward.call(statements)
  end
  def undo(statements : SchemaStatements) : Nil | ErrorBase | Cancelled
    inverse = @inverse
    return IrreversibleMigration.new("#{name} is not reversible") if inverse.nil?
    inverse.call(statements)
  end
  def reversed : Command | ErrorBase
    inverse = @inverse
    return IrreversibleMigration.new("#{name} is not reversible") if inverse.nil?
    Command.new(inverse_name || "revert_#{name}", inverse, @forward, name)
  end
end
pub class CommandRecorder
  getter commands = [] of Command
  @recording = false
  def recording? : Bool
    @recording
  end
  private def restore(commands : Array(Command), recording : Bool) : Nil
    @commands = commands
    @recording = recording
    nil
  end
  def capture(&block : -> T) : Array(Command) | ErrorBase | Cancelled forall T
    outer = @commands
    was_recording = @recording
    @commands = [] of Command
    @recording = true
    defer restore(outer, was_recording)
    result = yield
    return result if result.is_a?(::Error) || result.is_a?(Cancelled)
    @commands
  end
  def add(command : Command) : Nil
    @commands << command
    nil
  end
  private def record(name : String, forward : Command::Action, inverse : Command::Action? = nil, inverse_name : String? = nil) : Nil
    add(Command.new(name, forward, inverse, inverse_name))
  end
  def create_table(name : String | Symbol, **options, &block : TableDefinition -> T) : Nil forall T
    record("create_table",
      ->(s : SchemaStatements) { s.create_table(name, **options) { |t| block.call(t) } },
      ->(s : SchemaStatements) { s.drop_table(name, if_exists: options[:if_not_exists]? == true) }, "drop_table")
  end
  def drop_table(*names, **options) : Nil
    record("drop_table", ->(s : SchemaStatements) { s.drop_table(*names, **options) })
  end
  def add_column(table : String | Symbol, name : String | Symbol, type : String | Symbol, **options) : Nil
    record("add_column", ->(s : SchemaStatements) { s.add_column(table, name, type, **options) },
      ->(s : SchemaStatements) { s.remove_column(table, name, type) }, "remove_column")
  end
  def remove_column(table : String | Symbol, name : String | Symbol, type : String | Symbol, if_exists : Bool = false, **options) : Nil
    record("remove_column", ->(s : SchemaStatements) { s.remove_column(table, name, type, if_exists: if_exists) },
      ->(s : SchemaStatements) { s.add_column(table, name, type, **options) }, "add_column")
  end
  def remove_column(table : String | Symbol, name : String | Symbol, if_exists : Bool = false) : Nil
    record("remove_column", ->(s : SchemaStatements) { s.remove_column(table, name, if_exists: if_exists) })
  end
  {% for method in ["rename_column", "rename_index"] %}
    def {{method.id}}(table : String | Symbol, old : String | Symbol, new : String | Symbol) : Nil
      record({{method}}, ->(s : SchemaStatements) { s.{{method.id}}(table, old, new) },
        ->(s : SchemaStatements) { s.{{method.id}}(table, new, old) }, {{method}})
    end
  {% end %}
  def rename_table(old : String | Symbol, new : String | Symbol) : Nil
    record("rename_table", ->(s : SchemaStatements) { s.rename_table(old, new) },
      ->(s : SchemaStatements) { s.rename_table(new, old) }, "rename_table")
  end
  def add_index(table : String | Symbol, columns : C, **options) : Nil forall C
    record("add_index", ->(s : SchemaStatements) { s.add_index(table, columns, **options) },
      ->(s : SchemaStatements) { s.remove_index(table, columns, name: options[:name]?) }, "remove_index")
  end
  def remove_index(table : String | Symbol, columns : C, if_exists : Bool = false, algorithm : Symbol? = nil, **options) : Nil forall C
    record("remove_index", ->(s : SchemaStatements) { s.remove_index(table, columns, name: options[:name]?, if_exists: if_exists, algorithm: algorithm) },
      ->(s : SchemaStatements) { s.add_index(table, columns, **options) }, "add_index")
  end
  def remove_index(table : String | Symbol, name : String | Symbol, if_exists : Bool = false, algorithm : Symbol? = nil) : Nil
    record("remove_index", ->(s : SchemaStatements) { s.remove_index(table, name: name, if_exists: if_exists, algorithm: algorithm) })
  end
  def remove_timestamps(table : String | Symbol) : Nil
    record("remove_timestamps", ->(s : SchemaStatements) { s.remove_timestamps(table) },
      ->(s : SchemaStatements) { s.add_timestamps(table, null: true) }, "add_timestamps")
  end
  def create_join_table(first : String | Symbol, second : String | Symbol, table_name : String | Symbol? = nil, column_options = nil) : Nil
    record("create_join_table", ->(s : SchemaStatements) { s.create_join_table(first, second, table_name, column_options) },
      ->(s : SchemaStatements) { s.drop_join_table(first, second, table_name) }, "drop_join_table")
  end
  def add_foreign_key(from_table : String | Symbol, to_table : String | Symbol, **options) : Nil
    record("add_foreign_key", ->(s : SchemaStatements) { s.add_foreign_key(from_table, to_table, **options) },
      ->(s : SchemaStatements) { s.remove_foreign_key(from_table, to_table, column: options[:column]?, name: options[:name]?) }, "remove_foreign_key")
  end
  def add_reference(table : String | Symbol, *names, **options) : Nil
    polymorphic = options[:polymorphic]? == true
    foreign_key = options[:foreign_key]? != nil && options[:foreign_key]? != false
    record("add_reference", ->(s : SchemaStatements) { s.add_reference(table, *names, **options) },
      ->(s : SchemaStatements) { s.remove_reference(table, *names, polymorphic: polymorphic, foreign_key: foreign_key) }, "remove_reference")
  end
  def add_timestamps(table : String | Symbol, **options) : Nil
    record("add_timestamps", ->(s : SchemaStatements) { s.add_timestamps(table, **options) },
      ->(s : SchemaStatements) { s.remove_timestamps(table) }, "remove_timestamps")
  end
  def enable_extension(name : String | Symbol) : Nil
    record("enable_extension", ->(s : SchemaStatements) { s.enable_extension(name) },
      ->(s : SchemaStatements) { s.disable_extension(name) }, "disable_extension")
  end
  def execute(sql : String) : Nil
    record("execute", ->(s : SchemaStatements) { s.execute_batch([sql]) })
  end
end
