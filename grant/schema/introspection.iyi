module grant/schema/introspection
import grant/adapter/base::{Base}
import grant/adapter/schema::{Dialect}
import grant/schema/table_rebuild::{TableRebuild}
import grant/schema/column_info::{ColumnInfo, IndexInfo, TypeFamily, ForeignKeyInfo, ReferentialAction}
import grant/errors::{ErrorBase}
import std/text
import std/enumerable
pub class TableNotFound < ErrorBase
  getter table_name : String
  def initialize(@table_name : String)
    super("Table '#{table_name}' does not exist")
  end
end

pub class Introspection
  getter adapter : Base
  def initialize(@adapter : Base)
  end
  def tables : Array(String) | ErrorBase | Cancelled
    sql = adapter.postgres? ? "SELECT c.relname AS name FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = current_schema() AND c.relkind IN ('r', 'p') ORDER BY c.relname" : "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name"
    adapter.open { |db| db.query(sql)!.map { |row| row["name"].as(String) } }
  end
  def table_exists?(table : String | Symbol) : Bool | ErrorBase | Cancelled
    literal = Dialect.for(@adapter).quote_literal(table.to_s)
    sql = @adapter.postgres? ? "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = current_schema() AND table_name = #{literal}" : "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = #{literal}"
    @adapter.open { |db| db.scalar(sql)!.as(Int64) > 0 }
  end
  def table_comment(table : String | Symbol) : String? | ErrorBase | Cancelled
    return nil unless @adapter.postgres?
    sql = "SELECT obj_description(to_regclass(#{Dialect::Pg.quote_literal(table.to_s)}), 'pg_class')"
    @adapter.open { |db| db.scalar(sql)!.as(String?) }
  end
  def columns(table : String | Symbol) : Array(ColumnInfo) | ErrorBase | Cancelled
    return TableNotFound.new(table.to_s) unless table_exists?(table)!
    dialect = Dialect.for(@adapter)
    sql = if @adapter.postgres?
      "SELECT a.attname AS name, format_type(a.atttypid, a.atttypmod) AS type, a.attnotnull AS required, col_description(a.attrelid, a.attnum) AS comment, pg_get_expr(d.adbin, d.adrelid) AS default_value, COALESCE(array_position(i.indkey::int2[], a.attnum) + 1, 0)::int AS pk_position, (a.attidentity IN ('a', 'd') OR COALESCE(pg_get_expr(d.adbin, d.adrelid) LIKE 'nextval(%', false)) AS auto_increment, a.attnum::int AS position FROM pg_attribute a LEFT JOIN pg_index i ON i.indrelid = a.attrelid AND i.indisprimary LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum WHERE a.attrelid = to_regclass(#{dialect.quote_literal(table.to_s)}) AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum"
    else
      "PRAGMA table_info(#{dialect.quote(table)})"
    end
    @adapter.open do |db|
      rows = db.query(sql)!
      key_size = adapter.postgres? ? 0 : rows.count { |row| row["pk"].as(Int64) > 0 }
      rows.map do |row|
        if @adapter.postgres?
          ColumnInfo.new(table.to_s, row["name"].as(String), row["type"].as(String), !row["required"].as(Bool), default: row["default_value"].as(String?), primary_key_position: row["pk_position"].as(Int64).to_i32, auto_increment: row["auto_increment"].as(Bool), position: row["position"].as(Int64).to_i32, comment: row["comment"].as(String?))
        else
          key_position = row["pk"].as(Int64).to_i32
          rowid = key_position == 1 && key_size == 1 && row["type"].as(String).upcase == "INTEGER"
          ColumnInfo.new(table.to_s, row["name"].as(String), row["type"].as(String), row["notnull"].as(Int64) == 0 && !rowid, row["dflt_value"].as(String?), key_position, rowid, row["cid"].as(Int64).to_i32 + 1)
        end
      end
    end
  end
  def column_exists?(table : String | Symbol, column : String | Symbol, type : TypeFamily? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    columns(table)!.any? { |info| info.name == column.to_s && (type.nil? || info.type_family == type) }
  end
  def primary_key(table : String | Symbol) : Array(String) | ErrorBase | Cancelled
    columns(table)!.select { |info| info.primary_key? }.sorted_by { |info| info.primary_key_position }.map { |info| info.name }
  end
  def foreign_keys(table : String | Symbol) : Array(ForeignKeyInfo) | ErrorBase | Cancelled
    return TableNotFound.new(table.to_s) unless table_exists?(table)!
    sql = if adapter.postgres?
      "SELECT c.conname AS name, ft.relname AS target, a.attname AS local_column, fa.attname AS foreign_column, c.confupdtype::text AS on_update, c.confdeltype::text AS on_delete FROM pg_constraint c JOIN pg_class ft ON ft.oid = c.confrelid CROSS JOIN LATERAL unnest(c.conkey, c.confkey) WITH ORDINALITY AS k(local_attnum, foreign_attnum, ord) JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = k.local_attnum JOIN pg_attribute fa ON fa.attrelid = c.confrelid AND fa.attnum = k.foreign_attnum WHERE c.contype = 'f' AND c.conrelid = to_regclass(#{Dialect::Pg.quote_literal(table.to_s)}) ORDER BY c.conname, k.ord"
    else
      "SELECT id, \"table\" AS target, \"from\" AS local_column, \"to\" AS foreign_column, on_update, on_delete FROM pragma_foreign_key_list(#{Dialect::Sqlite.quote_literal(table.to_s)}) ORDER BY id, seq"
    end
    adapter.open do |db|
      grouped = {} of String => ForeignKeyInfo
      db.query(sql)!.each do |row|
        id = adapter.postgres? ? row["name"].as(String) : row["id"].as(Int64).to_s
        target = row["target"].as(String)
        local = row["local_column"].as(String)
        foreign_column = row["foreign_column"].as(String?)
        referenced = foreign_column || primary_key(target)!.first
        if current = grouped[id]?
          current.columns << local
          current.primary_key_columns << referenced
        else
          update = referential_action(row["on_update"].as(String))
          delete = referential_action(row["on_delete"].as(String))
          grouped[id] = ForeignKeyInfo.new(table.to_s, adapter.postgres? ? id : nil, [local], target, [referenced], update, delete)
        end
      end
      grouped.values
    end
  end
  private def referential_action(text : String) : ReferentialAction
    case text
    when "c" then ReferentialAction::Cascade
    when "r" then ReferentialAction::Restrict
    when "n" then ReferentialAction::SetNull
    when "d" then ReferentialAction::SetDefault
    else ReferentialAction.parse(text)
    end
  end
  def foreign_key_exists?(table : String | Symbol, to_table : String | Symbol? = nil, column : String | Symbol? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    foreign_keys(table)!.any? { |key| (to_table.nil? || key.to_table == to_table.to_s) && (column.nil? || key.columns == [column.to_s]) }
  end
  def indexes(table : String | Symbol) : Array(IndexInfo) | ErrorBase | Cancelled
    dialect = Dialect.for(adapter)
    literal = dialect.quote_literal(table.to_s)
    adapter.open do |db|
      result = [] of IndexInfo
      if adapter.postgres?
        rows = db.query("SELECT i.relname AS name, pg_get_indexdef(i.oid) AS sql FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid WHERE x.indrelid = to_regclass(#{literal}) AND NOT x.indisprimary ORDER BY i.relname")!
        rows.each do |row|
          sql = row["sql"].as(String)
          name = row["name"].as(String)
          result << index_from_sql(table.to_s, name, sql, sql.starts_with?("CREATE UNIQUE"))
        end
      else
        db.query("PRAGMA index_list(#{dialect.quote(table)})")!.each do |row|
          next if row["origin"]? == "pk"
          name = row["name"].as(String)
          sql = db.scalar("SELECT sql FROM sqlite_master WHERE type = 'index' AND name = #{dialect.quote_literal(name)}")!.as(String?)
          if sql
            result << index_from_sql(table.to_s, name, sql, row["unique"].as(Int64) != 0)
          else
            columns = db.query("PRAGMA index_info(#{dialect.quote(name)})")!.map { |entry| entry["name"].as(String) }
            result << IndexInfo.new(table.to_s, name, columns, row["unique"].as(Int64) != 0)
          end
        end
      end
      result
    end
  end

  def index_exists?(table : String | Symbol, columns = nil, name : String | Symbol? = nil, unique : Bool? = nil) : Bool | ErrorBase | Cancelled
    return false unless table_exists?(table)!
    wanted = columns.nil? ? nil : columns.map { |column| column.to_s }
    indexes(table)!.any? do |index|
      (wanted.nil? || index.columns == wanted) && (name.nil? || index.name == name.to_s) &&
        (unique.nil? || index.unique == unique)
    end
  end
  private def index_from_sql(table : String, name : String, sql : String, unique : Bool) : IndexInfo
    open = sql.index('(').as(Int32)
    close = TableRebuild::Scanner.matching_paren(sql, open).as(Int32)
    columns = TableRebuild::Scanner.split_items(sql[(open + 1)...close]).map { |part| TableRebuild::Scanner.unquote(part.strip) }
    where_at = sql.index(" WHERE ")
    predicate = where_at.nil? ? nil : sql[(where_at + 7)...sql.size]
    IndexInfo.new(table, name, columns, unique, predicate, columns.any? { |column| column.includes?("(") })
  end
  def enums : Hash(String, Array(String)) | ErrorBase | Cancelled
    return {} of String => Array(String) unless @adapter.postgres?
    @adapter.open do |db|
      result = {} of String => Array(String)
      db.query("SELECT t.typname AS name, e.enumlabel AS value FROM pg_type t JOIN pg_enum e ON t.oid = e.enumtypid JOIN pg_namespace n ON n.oid = t.typnamespace WHERE n.nspname = current_schema() ORDER BY t.typname, e.enumsortorder")!.each do |row|
        name = row["name"].as(String)
        result[name] = [] of String unless result.has_key?(name)
        result[name] << row["value"].as(String)
      end
      result
    end
  end
  def extensions : Array(String) | ErrorBase | Cancelled
    return [] of String unless @adapter.postgres?
    @adapter.open { |db| db.query("SELECT extname FROM pg_extension ORDER BY extname")!.map { |row| row["extname"].as(String) } }
  end
  def extension_enabled?(name : String | Symbol) : Bool | ErrorBase | Cancelled
    extensions!.includes?(name.to_s)
  end
end
pub trait AdapterSchema
  abstract def schema : ::Grant::Schema::Introspection::Introspection
  abstract def reset_schema_caches_in_place : Nil
end
impl AdapterSchema for Base
  def schema : ::Grant::Schema::Introspection::Introspection
    ::Grant::Schema::Introspection::Introspection.new(self)
  end
  def reset_schema_caches_in_place : Nil
    nil
  end
end
