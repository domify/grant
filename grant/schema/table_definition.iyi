module grant/schema/table_definition
import grant/adapter/schema::{Dialect, UnsupportedOperation, InvalidDefinition, TypeCatalog}
import grant/schema/index_definition::{IndexDefinition}
import grant/errors::{ErrorBase}
import grant/counter_cache
import grant/schema/table_definition_constraints
import std/text
pub struct Unset
end
pub UNSET = Unset.new

pub class ColumnDefinition
  property collation : String? = nil
  property array : Bool = false
  property expression_default : Bool = false
  getter name : String
  getter type : String
  property null : Bool
  getter comment : String?
  getter default_clause : String
  getter pg_only : Bool
  def initialize(@name : String, @type : String, @null : Bool = true, @comment : String? = nil, @default_clause : String = "", @pg_only : Bool = false)
  end
  def to_sql(dialect : Dialect) : String | ErrorBase
    return UnsupportedOperation.new("The #{@type} type is only supported on PostgreSQL") if @pg_only && dialect != Dialect::Pg
    return UnsupportedOperation.new("array: true is only supported on PostgreSQL") if @array && dialect != Dialect::Pg
    type = @array ? "#{@type}[]" : @type
    if collation = @collation
      type += " COLLATE #{dialect == Dialect::Pg ? dialect.quote(collation) : collation}"
    end
    sql = "#{dialect.quote(@name)} #{type}#{@null ? "" : " NOT NULL"}#{@default_clause}"
    sql += " COMMENT #{dialect.quote_literal(@comment)}" if dialect == Dialect::Mysql && @comment
    sql
  end
end
pub class TableDefinition
  ::Grant::Schema::TableDefinitionConstraints.methods
  getter definition_error : ErrorBase? = nil
  getter indexes = [] of IndexDefinition
  getter columns = [] of ColumnDefinition
  getter table : String
  getter comment : String?
  getter dialect : Dialect
  def initialize(@table : String, @dialect : Dialect, @comment : String? = nil)
  end
  def index(columns : C, **options) : Nil | ErrorBase forall C
    definition = IndexDefinition.build(table, columns, **options)!
    definition.to_sql(dialect)!
    @indexes << definition
    nil
  end
  def column(name : String | Symbol, type : String | Symbol, null : Bool = true,
             comment : String? = nil, limit : Int32? = nil, collation : String? = nil,
             array : Bool = false, default = UNSET, default_sql : String? = nil, precision : Int32? = nil, scale : Int32? = nil) : Nil | ErrorBase
    if @columns.any? { |column| column.name == name.to_s }
      @definition_error = InvalidDefinition.new("Column '#{name}' is already defined in '#{table}'")
      return @definition_error
    end
    if !default.is_a?(Unset) && default_sql
      @definition_error = InvalidDefinition.new("Give default: or default_sql:, not both")
      return @definition_error
    end
    native = type.to_s
    if type.is_a?(Symbol)
      native = case type
      when :string then limit ? "VARCHAR(#{limit})" : (dialect == Dialect::Pg ? "VARCHAR" : "VARCHAR(255)")
      when :integer then TypeCatalog.integer_type(dialect, limit || 4)!
      when :smallint then TypeCatalog.integer_type(dialect, 2)!
      when :tinyint then TypeCatalog.integer_type(dialect, 1)!
      when :bigint then "BIGINT"
      when :text then dialect == Dialect::Mysql ? TypeCatalog.sized("TEXT", {255 => "TINYTEXT", 65535 => "TEXT", 16777215 => "MEDIUMTEXT"}, "LONGTEXT", limit) : "TEXT"
      when :float then dialect == Dialect::Pg ? "REAL" : "FLOAT"
      when :double then dialect == Dialect::Pg ? "DOUBLE PRECISION" : (dialect == Dialect::Mysql ? "DOUBLE" : "REAL")
      when :decimal
        if scale && precision.nil?
          @definition_error = InvalidDefinition.new("scale: #{scale} on '#{name}' needs a precision:")
          return @definition_error
        end
        word = dialect == Dialect::Mysql ? "DECIMAL" : "NUMERIC"
        precision ? "#{word}(#{precision}, #{scale || 0})" : word
      when :date then "DATE"
      when :time then dialect == Dialect::Sqlite ? "TIME" : "TIME(#{precision || 6})"
      when :binary then dialect == Dialect::Pg ? "BYTEA" : (dialect == Dialect::Mysql ? TypeCatalog.sized("BLOB", {255 => "TINYBLOB", 65535 => "BLOB", 16777215 => "MEDIUMBLOB"}, "LONGBLOB", limit) : "BLOB")
      when :json then "JSON"
      when :uuid then dialect == Dialect::Pg ? "UUID" : "CHAR(36)"
      when :boolean then dialect == Dialect::Mysql ? "TINYINT(1)" : "BOOLEAN"
      when :datetime then dialect == Dialect::Pg ? "TIMESTAMP(#{precision || 6})" : (dialect == Dialect::Mysql ? "DATETIME(#{precision || 6})" : "DATETIME")
      else type.to_s
      end
    end
    clause = if default_sql
      " DEFAULT #{dialect.default_expression(default_sql)}"
    elsif default.is_a?(Unset)
      ""
    else
      " DEFAULT #{dialect.quote_literal(default)}"
    end
    definition = ColumnDefinition.new(name.to_s, native, null, comment, clause)
    definition.expression_default = !default_sql.nil?
    definition.collation = collation
    definition.array = array
    @columns << definition
    nil
  end

  {% for kind in ["string", "integer", "smallint", "tinyint", "bigint", "text", "boolean", "datetime", "date", "time", "binary", "float", "double", "decimal", "json", "uuid"] %}
    def {{kind.id}}(name : String | Symbol, null : Bool = true, comment : String? = nil,
                   limit : Int32? = nil, collation : String? = nil, array : Bool = false,
                   default = UNSET, default_sql : String? = nil, precision : Int32? = nil, scale : Int32? = nil) : Nil | ErrorBase
      column(name, :{{kind.id}}, null: null, comment: comment, limit: limit, collation: collation,
        array: array, default: default, default_sql: default_sql, precision: precision, scale: scale)
    end
  {% end %}

  def timestamps(null : Bool = false, precision : Int32? = 6, default = UNSET, default_sql : String? = nil) : Nil | ErrorBase
    datetime(:created_at, null: null, precision: precision, default: default, default_sql: default_sql)!
    datetime(:updated_at, null: null, precision: precision, default: default, default_sql: default_sql)
  end
  {% for kind in ["hstore", "citext", "inet", "cidr", "macaddr", "ltree", "money", "jsonb"] %}
    def {{kind.id}}(name : String | Symbol, null : Bool = true) : Nil
      @columns << ColumnDefinition.new(name.to_s, {{kind == "jsonb" ? "JSONB" : kind}}, null, pg_only: true)
      nil
    end
  {% end %}
  def enum(name : String | Symbol, enum_type : String | Symbol, null : Bool = true, default : String? = nil) : Nil
    clause = default.nil? ? "" : " DEFAULT #{@dialect.quote_literal(default)}"
    @columns << ColumnDefinition.new(name.to_s, enum_type.to_s, null, default_clause: clause, pg_only: true)
    nil
  end
end
