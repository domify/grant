module grant/schema/schema_migration

import std/text
import grant/adapter/base::{Base}
import grant/adapter/schema::{Dialect}
import grant/schema/introspection
import grant/error::{ErrorBase}

pub enum Tracking
  Grant
  Micrate
end

pub class SchemaMigration
  TABLE = "schema_migrations"
  getter adapter : Base
  getter tracking : Tracking
  getter dialect : Dialect
  @table_present : Bool = false

  def initialize(@adapter : Base, @tracking : Tracking = Tracking::Grant)
    @dialect = Dialect.for(adapter)
  end

  def table_name : String
    tracking == Tracking::Micrate ? "micrate_db_version" : TABLE
  end

  def table_exists? : Bool | ErrorBase | Cancelled
    return true if @table_present
    @table_present = adapter.schema.table_exists?(table_name)!
  end

  def create_table : Nil | ErrorBase | Cancelled
    return nil if table_exists?!
    sql = if tracking == Tracking::Micrate
      dialect == Dialect::Sqlite ? "CREATE TABLE micrate_db_version (id INTEGER PRIMARY KEY AUTOINCREMENT, version_id INTEGER NOT NULL, is_applied INTEGER NOT NULL, tstamp TIMESTAMP DEFAULT (datetime('now')))" : "CREATE TABLE micrate_db_version (id serial NOT NULL, version_id bigint NOT NULL, is_applied boolean NOT NULL, tstamp timestamp NULL DEFAULT now(), PRIMARY KEY (id))"
    else
      "CREATE TABLE #{dialect.quote(table_name)} (version VARCHAR(255) NOT NULL PRIMARY KEY)"
    end
    adapter.open { |db| db.exec(sql)!; nil }!
    adapter.reset_schema_caches_in_place(table_name)
    nil
  end

  def versions : Set(Int64) | ErrorBase | Cancelled
    applied = Set(Int64).new
    return applied unless table_exists?!
    adapter.open do |db|
      if tracking == Tracking::Micrate
        seen = Set(Int64).new
        db.query("SELECT version_id, is_applied FROM micrate_db_version ORDER BY id DESC")!.each do |row|
          version = row["version_id"].as(Int64)
          next if seen.includes?(version)
          seen.add(version)
          flag = row["is_applied"]
          truthy = flag.is_a?(Bool) ? flag : (flag.is_a?(Int64) && flag != 0)
          applied.add(version) if version != 0 && truthy
        end
      else
        db.query("SELECT version FROM #{dialect.quote(table_name)}")!.each do |row|
          if version = row["version"].as(String).to_i64?
            applied.add(version)
          end
        end
      end
      applied
    end
  end

  def record(version : Int64) : Nil | ErrorBase | Cancelled
    create_table!
    sql = tracking == Tracking::Micrate ? "INSERT INTO micrate_db_version (version_id, is_applied) VALUES (#{version}, #{dialect.quote_literal(true)})" : "INSERT INTO #{dialect.quote(table_name)} (version) VALUES ('#{version}')"
    adapter.open { |db| db.exec(sql)!; nil }
  end

  def forget(version : Int64) : Nil | ErrorBase | Cancelled
    return nil unless table_exists?!
    sql = tracking == Tracking::Micrate ? "INSERT INTO micrate_db_version (version_id, is_applied) VALUES (#{version}, #{dialect.quote_literal(false)})" : "DELETE FROM #{dialect.quote(table_name)} WHERE version = '#{version}'"
    adapter.open { |db| db.exec(sql)!; nil }
  end
end
