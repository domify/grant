module grant/schema/migration_context

import grant/schema/migration::{Migration, MigrationEntry, InvalidMigration, SqlFileMigration}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError}
import grant/schema/schema_migration::{SchemaMigration, Tracking}
import grant/schema/schema_statements::{AdapterStatements, RecordingStatements}
import grant/adapter/base::{Base}
import grant/advisory_lock
import grant/error::{ErrorBase}
import std/time::{Span, Time}
import std/io
import grant/adapter/schema::{Dialect}
import std/enumerable
import std/dir::{Dir}
import std/file::{File}
import std/text

pub class UnknownMigrationVersion < ErrorBase
  def initialize(version : Int64)
    super("No migration with version number #{version}")
  end
end

pub class PendingMigrationError < ErrorBase
  getter versions : Array(Int64)
  def initialize(@versions : Array(Int64))
    super("Migrations are pending: #{versions.join(", ")}. Run the migrations before continuing.")
  end
end

pub struct MigrationStatus
  NO_FILE = "********** NO FILE **********"
  getter version : Int64
  getter name : String
  getter applied : Bool
  getter missing : Bool
  def initialize(@version : Int64, @name : String, @applied : Bool, @missing : Bool = false)
  end
  def applied? : Bool
    applied
  end
  def missing? : Bool
    missing
  end
  def state : String
    applied? ? "up" : "down"
  end
  def to_s : String
    "#{state.ljust(4)}  #{version}  #{name}"
  end
end

pub class MigrationContext
  getter adapter : Base
  getter schema_migration : SchemaMigration
  getter lock_timeout : Span
  @entries : Array(MigrationEntry)
  @executor : AdapterStatements
  @paths : Array(String)
  @loaded : Array(MigrationEntry)? = nil
  getter internal_metadata : InternalMetadata
  getter environment : String?
  getter protected_environments : Array(String)
  getter tracking : Tracking
  getter dry_run : Bool
  @output : IO?

  def initialize(@adapter : Base, migrations : Array(MigrationEntry) = [] of MigrationEntry,
                 @verbose : Bool = true, @lock_timeout : Span = Span.seconds(600_i64), paths : Array(String) = [] of String, @tracking : Tracking = Tracking::Grant, @environment : String? = nil,
                 @protected_environments : Array(String) = InternalMetadata::DEFAULT_PROTECTED,
                 @output : IO? = nil, @dry_run : Bool = false)
    @entries = migrations
    @schema_migration = SchemaMigration.new(adapter, tracking)
    @internal_metadata = InternalMetadata.new(adapter)
    @paths = paths
    @executor = AdapterStatements.new(adapter)
  end

  def self.for(adapter : Base, *classes, **options) : MigrationContext
    entries = [] of MigrationEntry
    classes.each { |klass| entries << require_entry(klass.entry) }
    new(adapter, entries, **options)
  end

  private def self.require_entry(entry : MigrationEntry | ErrorBase) : MigrationEntry
    if entry.is_a?(::Error)
      raise entry.message.to_s
    else
      entry
    end
  end

  def migrations : Array(MigrationEntry) | ErrorBase
    loaded = @loaded
    return loaded unless loaded.nil?
    all = @entries.dup
    @paths.each do |directory|
      Dir.glob(File.join(directory, "*.sql")).sorted.each { |path| all << sql_entry(path)! }
    end
    all = all.sorted_by { |entry| entry.version }
    index = 1
    while index < all.size
      if all[index - 1].version == all[index].version
        return InvalidMigration.new("Two migrations have version #{all[index].version}: #{all[index - 1].name} and #{all[index].name}")
      end
      index += 1
    end
    @loaded = all
    all
  end
  private def sql_entry(path : String) : MigrationEntry | ErrorBase
    file = File.basename(path)
    split = file.index('_')
    return InvalidMigration.new("#{path}: a migration file is named <version>_<name>.sql") if split.nil? || !file.ends_with?(".sql")
    version = file[0...split].to_i64?
    return InvalidMigration.new("#{path}: a migration file is named <version>_<name>.sql") if version.nil?
    name = file[(split + 1)...-4].split('_').map { |word| word.capitalize }.join
    return InvalidMigration.new("#{path}: a migration file is named <version>_<name>.sql") if name.empty?
    migration = SqlFileMigration.parse(version, name, File.read(path))!
    MigrationEntry.new(version, name, -> { migration.as(Migration) })
  end
  def current_version : Int64 | ErrorBase | Cancelled
    applied_versions!.to_a.sorted.last? || 0_i64
  end
  def applied_versions : Set(Int64) | ErrorBase | Cancelled
    schema_migration.versions
  end
  def pending : Array(MigrationEntry) | ErrorBase | Cancelled
    applied = applied_versions!
    migrations!.reject { |entry| applied.includes?(entry.version) }
  end
  def needs_migration? : Bool | ErrorBase | Cancelled
    !pending!.empty?
  end
  def check_pending_strict : Nil | ErrorBase | Cancelled
    versions = pending!.map { |entry| entry.version }
    versions.empty? ? nil : PendingMigrationError.new(versions)
  end
  def with_migration_lock(&block : -> T) : T | ErrorBase | Cancelled forall T
    return yield if @dry_run
    ::Grant::AdvisoryLock.synchronize(adapter, "grant-migrations:#{adapter.current_database}:#{schema_migration.table_name}", lock_timeout) do
      created = schema_migration.create_table
      return created if created.is_a?(::Error)
      if current = environment
        internal_metadata.record_environment(current)! if internal_metadata.environment!.nil?
      end
      yield
    end
  end

  def recorded_environment : String? | ErrorBase | Cancelled
    internal_metadata.environment
  end
  def check_protected_environments_strict(force : Bool = false) : Nil | ErrorBase | Cancelled
    return nil if force
    if current = environment
      internal_metadata.check_protected_environments_strict(current, protected_environments, false)!
    elsif stored = internal_metadata.environment!
      return ProtectedEnvironmentError.new(stored) if protected_environments.includes?(stored)
    end
    nil
  end
  def set_environment_strict : Nil | ErrorBase | Cancelled
    current = environment
    return InvalidMigration.new("set_environment! needs a context created with environment:") if current.nil?
    internal_metadata.record_environment(current)
  end

  def dry_run? : Bool
    @dry_run
  end
  def status : Array(MigrationStatus) | ErrorBase | Cancelled
    applied = applied_versions!
    entries = migrations!
    known = entries.map { |entry| MigrationStatus.new(entry.version, entry.name, applied.includes?(entry.version)) }
    applied.each do |version|
      unless entries.any? { |entry| entry.version == version }
        known << MigrationStatus.new(version, MigrationStatus::NO_FILE, true, true)
      end
    end
    known.sorted_by { |row| row.version }
  end
  def migrate : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock { migrate_locked(nil) }
  end
  def migrate(target : Int64) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock { migrate_locked(target) }
  end
  private def migrate_locked(target : Int64?) : Array(Int64) | ErrorBase | Cancelled
    applied = schema_migration.versions!
    entries = migrations!
    if target && target != 0 && !entries.any? { |entry| entry.version == target }
      return UnknownMigrationVersion.new(target)
    end
    limit = target || 9223372036854775807_i64
    ran = [] of Int64
    if target && target < (applied.to_a.sorted.last? || 0_i64)
      entries.reversed.each do |entry|
        next unless entry.version > limit && applied.includes?(entry.version)
        run_entry(entry, false, applied)!
        ran << entry.version
      end
    end
    entries.each do |entry|
      next if entry.version > limit || applied.includes?(entry.version)
      run_entry(entry, true, applied)!
      ran << entry.version
    end
    ran
  end
  def rollback(step : Int32 = 1) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock { rollback_locked(step) }
  end
  private def rollback_locked(step : Int32) : Array(Int64) | ErrorBase | Cancelled
    applied = schema_migration.versions!
    ran = [] of Int64
    applied.to_a.sorted.reversed.first(step).each do |version|
      entry = migrations!.find { |candidate| candidate.version == version }
      return UnknownMigrationVersion.new(version) if entry.nil?
      run_entry(entry, false, applied)!
      ran << version
    end
    ran
  end
  def forward(step : Int32 = 1) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock do
      applied = schema_migration.versions!
      ran = [] of Int64
      migrations!.reject { |entry| applied.includes?(entry.version) }.first(step).each do |entry|
        run_entry(entry, true, applied)!
        ran << entry.version
      end
      ran
    end
  end
  def redo(step : Int32 = 1) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock do
      before = current_version!
      rolled = rollback_locked(step)!
      rolled + migrate_locked(before)!
    end
  end
  def up(version : Int64) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock { run_version(version, true) }
  end
  def down(version : Int64) : Array(Int64) | ErrorBase | Cancelled
    with_migration_lock { run_version(version, false) }
  end
  private def run_version(version : Int64, direction_up : Bool) : Array(Int64) | ErrorBase | Cancelled
    entry = migrations!.find { |candidate| candidate.version == version }
    return UnknownMigrationVersion.new(version) if entry.nil?
    applied = schema_migration.versions!
    return [] of Int64 if applied.includes?(version) == direction_up
    run_entry(entry, direction_up, applied)!
    [version]
  end

  private def run_entry(entry : MigrationEntry, direction_up : Bool, applied : Set(Int64)) : Nil | ErrorBase | Cancelled
    migration = entry.build
    recording = @dry_run ? RecordingStatements.new(Dialect.for(adapter)) : nil
    statements = recording || @executor
    migration.attach(statements, adapter, @output, @verbose)
    migration.announce(direction_up ? "migrating" : "reverting")
    started = Time.monotonic_nanoseconds
    if recording
      result = direction_up ? migration.up : migration.down
      return result if result.is_a?(::Error) || result.is_a?(Cancelled)
      recording.statements.each { |sql| migration.write("   #{sql}") }
    else
      @executor.transaction(disable_ddl_transaction: migration.disable_ddl_transaction?, rebuilds: true) do |_|
        result = direction_up ? migration.up : migration.down
        if result.is_a?(::Error) || result.is_a?(Cancelled)
          result
        else
          direction_up ? schema_migration.record(entry.version) : schema_migration.forget(entry.version)
        end
      end!
    end
    migration.announce("#{direction_up ? "migrated" : "reverted"} (#{Migration.elapsed_text(Time.monotonic_nanoseconds - started)})")
    migration.write

    direction_up ? applied.add(entry.version) : applied.delete(entry.version)
    nil
  end
end

pub def check_pending_strict(context : MigrationContext) : Nil | ErrorBase | Cancelled
  context.check_pending_strict
end
pub def maintain_test_schema_strict(context : MigrationContext, &block : -> T) : Nil | ErrorBase | Cancelled forall T
  if context.needs_migration?!
    result = yield
    return result if result.is_a?(::Error)
  end
  context.check_pending_strict
end
pub def maintain_test_schema_strict(context : MigrationContext) : Nil | ErrorBase | Cancelled
  maintain_test_schema_strict(context) { context.migrate }
end
