module grant/schema/verify
pub import grant/schema/introspection
import grant/schema/introspection::{Introspection}
pub import grant/schema/column_info
import grant/schema/column_info::{ColumnInfo, IndexInfo, ForeignKeyInfo, TypeFamily}
import grant/error::{ErrorBase}
import std/text

pub struct Drift
  pub enum Kind
    MissingTable
    MissingColumn
    TypeMismatch
    PrimaryKeyMismatch
    # Strict only: a table column no `column` declares.
    UndeclaredColumn
    # Strict only: declared non-nilable, but the column allows NULL.
    NullableColumn
  end

  getter kind : Kind
  getter table_name : String
  getter column_name : String?
  getter message : String

  def initialize(@kind : Kind, @table_name : String, @column_name : String?, @message : String)
  end
end

# Raised by `Model.verify_schema!` when a model and its table disagree.
pub class DriftError < ErrorBase
  getter model_name : String
  getter drift : Array(Drift)

  def initialize(@model_name : String, @drift : Array(Drift))
    super("#{@model_name} does not match its table: #{@drift.map(&.message).join("; ")}")
  end
end

# What a `column` declaration says, captured at compile time.
# :nodoc:
pub struct DeclaredColumn
  getter name : String
  # The Crystal type without its `Nil` part.
  getter type_name : String
  getter nilable : Bool
  getter primary : Bool
  # Converters and explicit `column_type:` make the SQL type unknowable here.
  getter opaque : Bool

  def initialize(@name : String, @type_name : String, @nilable : Bool, @primary : Bool, @opaque : Bool)
  end

  # Whether a database column of *family* can hold this Crystal type.
  def compatible_with?(family : TypeFamily) : Bool
    return true if opaque || family.other?
    case type_name
    when "Int8", "Int16", "Int32", "Int64", "Int128", "UInt8", "UInt16", "UInt32", "UInt64", "UInt128"
      family.integer?
    when "Bool"
      family.boolean? || family.integer?
    when "Float32", "Float64", "BigDecimal"
      family.float? || family.decimal?
    when "String"
      family.string? || family.text? || family.uuid? || family.json?
    when "UUID", "Std::Uuid::UUID"
      family.uuid? || family.string?
    when "Time", "Std::Time::Time"
      family.date_time? || family.date? || family.time?
    when "Bytes", "Slice(UInt8)"
      family.binary?
    when "JSON::Any"
      family.json? || family.text? || family.string?
    else
      true
    end
  end
end

# :nodoc:
pub class Verifier
  def initialize(@schema : Introspection, @table : String, @declared : Array(DeclaredColumn), @strict : Bool)
  end

  def drift : Array(Drift) | ErrorBase | Cancelled
    found = Array(Drift).new
    unless @schema.table_exists?(@table)!
      found << Drift.new(Drift::Kind::MissingTable, @table, nil, "table #{@table} is missing")
      return found
    end

    actual = {} of String => ColumnInfo
    @schema.columns(@table)!.each { |info| actual[info.name] = info }
    @declared.each do |declared|
      unless info = actual[declared.name]?
        found << Drift.new(Drift::Kind::MissingColumn, @table, declared.name, "column #{@table}.#{declared.name} is missing")
        next
      end
      unless declared.compatible_with?(info.type_family)
        found << Drift.new(Drift::Kind::TypeMismatch, @table, declared.name,
          "#{@table}.#{declared.name} is #{info.sql_type} but declared #{declared.type_name}")
      end
      if @strict && info.null? && !declared.nilable && !declared.primary
        found << Drift.new(Drift::Kind::NullableColumn, @table, declared.name,
          "#{@table}.#{declared.name} allows NULL but is declared #{declared.type_name}")
      end
    end

    declared_keys = @declared.select(&.primary).map(&.name).sorted
    actual_keys = @schema.primary_key(@table)!.sorted
    if !declared_keys.empty? && declared_keys != actual_keys
      found << Drift.new(Drift::Kind::PrimaryKeyMismatch, @table, nil,
        "#{@table} primary key is [#{actual_keys.join(", ")}] but declared [#{declared_keys.join(", ")}]")
    end

    if @strict
      names = @declared.map(&.name)
      actual.keys.each do |name|
        next if names.includes?(name)
        found << Drift.new(Drift::Kind::UndeclaredColumn, @table, name, "column #{@table}.#{name} is not declared")
      end
    end
    found
  end
end

pub trait VerifyCatalog
  abstract def verify(model : T.class, strict : Bool = false) : Array(Drift) | ErrorBase | Cancelled forall T
  abstract def verify_strict(model : T.class, strict : Bool = false) : Nil | ErrorBase | Cancelled forall T
end
impl VerifyCatalog for Introspection
  def verify(model : T.class, strict : Bool = false) : Array(::Grant::Schema::Verify::Drift) | ErrorBase | Cancelled forall T
    table = model.table_name.split('.').last
    ::Grant::Schema::Verify::Verifier.new(self, table, model.declared_schema_columns, strict).drift
  end
  def verify_strict(model : T.class, strict : Bool = false) : Nil | ErrorBase | Cancelled forall T
    found = verify(model, strict)!
    return ::Grant::Schema::Verify::DriftError.new(model.to_s, found) unless found.empty?
    nil
  end
end

pub macro model_methods
  def self.declared_schema_columns : Array(::Grant::Schema::Verify::DeclaredColumn)
    \{% begin %}
      [
        \{% for ivar in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
          \{% ann = ivar.annotation(::Grant::Base::Column) %}
          ::Grant::Schema::Verify::DeclaredColumn.new(
            \{{ivar.name.stringify}},
            \{{ivar.type.union_types.reject { |t| t == Nil }.first.stringify}},
            \{{ann[:type].includes?("?") || ann[:type].includes?("Nil")}},
            \{{ann[:primary] ? true : false}},
            \{{(ann[:converter] || ann[:column_type]) ? true : false}}),
        \{% end %}
      ] of ::Grant::Schema::Verify::DeclaredColumn
    \{% end %}
  end
  def self.schema_catalog_target : Tuple(::Grant::Schema::Introspection::Introspection, String)
    {adapter.schema, table_name}
  end
  def self.table_exists? : Bool | ::Grant::Error::ErrorBase | Cancelled
    catalog, table = schema_catalog_target
    catalog.table_exists?(table)
  end
  def self.column_exists?(name : String | Symbol) : Bool | ::Grant::Error::ErrorBase | Cancelled
    catalog, table = schema_catalog_target
    catalog.column_exists?(table, name)
  end
  def self.database_columns : Array(::Grant::Schema::ColumnInfo::ColumnInfo) | ::Grant::Error::ErrorBase | Cancelled
    catalog, table = schema_catalog_target
    catalog.columns(table)
  end
  def self.database_indexes : Array(::Grant::Schema::ColumnInfo::IndexInfo) | ::Grant::Error::ErrorBase | Cancelled
    catalog, table = schema_catalog_target
    catalog.indexes(table)
  end
  def self.database_foreign_keys : Array(::Grant::Schema::ColumnInfo::ForeignKeyInfo) | ::Grant::Error::ErrorBase | Cancelled
    catalog, table = schema_catalog_target
    catalog.foreign_keys(table)
  end
  def self.verify_schema(strict : Bool = false) : Array(::Grant::Schema::Verify::Drift) | ::Grant::Error::ErrorBase | Cancelled
    schema_catalog_target[0].verify(self, strict)
  end
  def self.verify_schema_strict(strict : Bool = false) : Nil | ::Grant::Error::ErrorBase | Cancelled
    schema_catalog_target[0].verify_strict(self, strict)
  end
end
