module grant/schema/migration

import grant/adapter/base::{Base}
import grant/schema/schema_statements::{AdapterStatements, RecordingStatements}
import grant/schema/table_definition::{TableDefinition}
pub import grant/schema/command_recorder
import grant/schema/command_recorder::{IrreversibleMigration, CommandRecorder, Command, SchemaStatements}
import std/text
import std/io
import std/time::{Time}
import std/int
import grant/error::{ErrorBase}

pub class InvalidMigration < ErrorBase
end

pub class NoChangeDefined < ErrorBase
end

pub struct MigrationEntry
  getter version : Int64
  getter name : String
  getter factory : Proc(Migration)

  def initialize(@version : Int64, @name : String, @factory : Proc(Migration))
  end

  def build : Migration
    factory.call
  end
end

pub abstract class Migration
  @@registry = [] of MigrationEntry
  @statements : SchemaStatements? = nil
  @recorder = CommandRecorder.new
  @adapter : Base? = nil
  @output : IO? = nil
  @verbose : Bool = true

  def self.registry : Array(MigrationEntry)
    @@registry
  end

  def self.register(entry : MigrationEntry) : Nil
    @@registry << entry
    nil
  end

  def self.entry : MigrationEntry | ErrorBase
    InvalidMigration.new("#{self} declares no migration_version")
  end

  macro migration_version(version)
    def self.version : Int64
      {{version}}.to_i64
    end
    def self.entry : ::Grant::Schema::Migration::MigrationEntry
      ::Grant::Schema::Migration::MigrationEntry.new(version, {{@type.name.stringify}},
        -> { {{@type}}.new.as(::Grant::Schema::Migration::Migration) })
    end
    def version : Int64
      {{version}}.to_i64
    end
    def name : String
      {{@type.name.stringify}}
    end
    ::Grant::Schema::Migration::Migration.register(entry)
  end

  macro disable_ddl_transaction_in_place
    def disable_ddl_transaction? : Bool
      true
    end
  end

  abstract def version : Int64
  abstract def name : String

  def disable_ddl_transaction? : Bool
    false
  end

  def attach(statements : SchemaStatements, adapter : Base, output : IO? = nil, verbose : Bool = true) : self
    @statements = statements
    @adapter = adapter
    @output = output
    @verbose = verbose
    self
  end

  def statements : SchemaStatements
    @statements.as(SchemaStatements)
  end

  def adapter : Base
    @adapter.as(Base)
  end

  def change : Nil | ErrorBase | Cancelled
    NoChangeDefined.new("#{name} defines no change")
  end

  def up : Nil | ErrorBase | Cancelled
    result = change
    result.is_a?(NoChangeDefined) ? InvalidMigration.new("#{name} defines none of change, up and down") : result
  end

  def down : Nil | ErrorBase | Cancelled
    result = revert { change }
    result.is_a?(NoChangeDefined) ? IrreversibleMigration.new("#{name} defines up but no down or change") : result
  end

  pub class Direction
    @up : Proc(Nil | ErrorBase | Cancelled)? = nil
    @down : Proc(Nil | ErrorBase | Cancelled)? = nil
    def up(&block : -> Nil | ErrorBase | Cancelled) : Nil
      @up = block
      nil
    end
    def down(&block : -> Nil | ErrorBase | Cancelled) : Nil
      @down = block
      nil
    end
    def run_up : Nil | ErrorBase | Cancelled
      callback = @up
      callback.nil? ? nil : callback.call
    end
    def run_down : Nil | ErrorBase | Cancelled
      callback = @down
      callback.nil? ? nil : callback.call
    end
  end
  def replay(commands : Array(Command)) : Nil | ErrorBase | Cancelled
    commands.each { |command| say_with_time(command.name) { command.apply(statements) }! }
    nil
  end
  def revert(&block : -> T) : Nil | ErrorBase | Cancelled forall T
    commands = @recorder.capture { yield }!
    reversed = [] of Command
    commands.reversed.each { |command| reversed << command.reversed! }
    if @recorder.recording?
      reversed.each { |command| @recorder.add(command) }
      nil
    else
      replay(reversed)
    end
  end
  def reversible(&block : Direction -> T) : Nil | ErrorBase | Cancelled forall T
    direction = Direction.new
    result = yield direction
    return result if result.is_a?(::Error) || result.is_a?(Cancelled)
    if @recorder.recording?
      @recorder.add(Command.new("reversible", ->(_s : SchemaStatements) { direction.run_up },
        ->(_s : SchemaStatements) { direction.run_down }, "reversible"))
    else
      direction.run_up
    end
  end
  def up_only(&block : -> Nil | ErrorBase | Cancelled) : Nil | ErrorBase | Cancelled
    reversible { |direction| direction.up(&block) }
  end

  def execute(sql : String) : Nil | ErrorBase | Cancelled
    @recorder.recording? ? @recorder.execute(sql) : say_with_time("execute(#{sql.inspect})") { statements.execute_batch([sql]) }
  end

  def create_table(*args, **options, &block : TableDefinition -> T) : Nil | ErrorBase | Cancelled forall T
    if @recorder.recording?
      definition = TableDefinition.new(args[0].to_s, statements.dialect)
      result = yield definition
      return result if result.is_a?(ErrorBase) || result.is_a?(Cancelled)
      @recorder.create_table(*args, **options) { |table| table.absorb(definition) }
    else
      say_with_time("create_table(#{argument_text(args)})") do
        statements.create_table(*args, **options) { |table| yield table }
      end
    end
  end

  {% for method in ["create_join_table", "remove_timestamps", "drop_table", "add_column", "remove_column", "add_index", "remove_index", "rename_column", "rename_table", "add_foreign_key", "add_reference", "add_timestamps", "enable_extension"] %}
    def {{method.id}}(*args, **options) : Nil | ErrorBase | Cancelled
      if @recorder.recording?
        @recorder.{{method.id}}(*args, **options)
      else
        say_with_time("{{method.id}}(#{argument_text(args)})") { statements.{{method.id}}(*args, **options) }
      end
    end
  {% end %}
  private def argument_text(args) : String
    parts = [] of String
    args.each { |arg| parts << (arg.is_a?(Symbol) ? ":#{arg}" : arg.inspect) }
    parts.join(", ")
  end
  def say(message : String, subitem : Bool = false) : Nil
    write("#{subitem ? "   ->" : "--"} #{message}")
  end
  def announce(message : String) : Nil
    text = "#{name}: #{message}"
    padding = 75 - text.size
    write("== #{text} #{"=" * (padding > 0 ? padding : 0)}")
  end
  def self.elapsed_text(nanoseconds : UInt64) : String
    units = (nanoseconds + 50_000_u64) // 100_000_u64
    fraction = (units % 10_000_u64).to_s.rjust(4, '0')
    "#{units // 10_000_u64}.#{fraction}s"
  end
  def say_with_time(message : String, &block : -> T) : T forall T
    say(message)
    started = Time.monotonic_nanoseconds
    result = yield
    say(Migration.elapsed_text(Time.monotonic_nanoseconds - started), true)
    say("#{result} rows", true) if result.is_a?(Int32) || result.is_a?(Int64)
    result
  end
  def write(text : String = "") : Nil
    return nil unless @verbose
    if io = @output
      io.puts(text)
    else
      puts(text)
    end
    nil
  end
  private def restore_verbose(value : Bool) : Nil
    @verbose = value
    nil
  end
  def suppress_messages(&block : -> T) : T forall T
    previous = @verbose
    @verbose = false
    defer restore_verbose(previous)
    yield
  end

end

pub class SqlFileMigration < Migration
  getter version : Int64
  getter name : String
  getter up_statements : Array(String)
  getter down_statements : Array(String)
  getter no_transaction : Bool
  def initialize(@version : Int64, @name : String, @up_statements : Array(String),
                 @down_statements : Array(String), @no_transaction : Bool = false)
  end
  def no_transaction? : Bool
    no_transaction
  end
  def self.parse(version : Int64, name : String, text : String) : SqlFileMigration | ErrorBase
    sections = {up: [] of String, down: [] of String}
    section = nil.as(Symbol?)
    buffer = [] of String
    block = false
    no_transaction = false
    flush = ->(target : Array(String)) do
      sql = buffer.join("\n").strip
      target << sql unless sql.empty?
      buffer.clear
    end
    text.split('\n').each do |raw|
      line = raw.rstrip
      stripped = line.lstrip
      marker = stripped.starts_with?("--") ? stripped[2...stripped.size].lstrip : ""
      tokens = marker.split
      if tokens.size >= 2 && tokens[0].downcase == "+micrate"
        case tokens[1].downcase
        when "up"
          return InvalidMigration.new("#{name}: unterminated StatementBegin") if block
          section = :up
        when "down"
          return InvalidMigration.new("#{name}: unterminated StatementBegin") if block
          section = :down
        when "statementbegin" then block = true
        when "statementend"
          block = false
          flush.call(section == :down ? sections[:down] : sections[:up])
        when "notransaction" then no_transaction = true
        else return InvalidMigration.new("#{name}: unknown Micrate marker #{tokens[1].inspect}")
        end
        next
      end
      next if !block && (stripped.empty? || stripped.starts_with?("--"))
      return InvalidMigration.new("#{name}: SQL before the -- +micrate Up marker") if section.nil?
      buffer << line
      flush.call(section == :down ? sections[:down] : sections[:up]) if !block && stripped.ends_with?(";")
    end
    return InvalidMigration.new("#{name}: unterminated StatementBegin") if block
    return InvalidMigration.new("#{name}: the last statement is missing its semicolon") unless buffer.empty?
    new(version, name, sections[:up], sections[:down], no_transaction)
  end
  def disable_ddl_transaction? : Bool
    no_transaction
  end
  def up : Nil | ErrorBase | Cancelled
    up_statements.each { |sql| execute(sql)! }
    nil
  end
  def down : Nil | ErrorBase | Cancelled
    return IrreversibleMigration.new("#{name} has no -- +micrate Down section") if down_statements.empty?
    down_statements.each { |sql| execute(sql)! }
    nil
  end
end
