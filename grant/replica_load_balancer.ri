module grant/replica_load_balancer
import grant/adapter/base
import grant/health_monitor::{HealthMonitor}
import std/random::{Random}
import std/time::{Time}

# One read replica in a `ReplicaLoadBalancer`: its adapter, the registry key
# it was registered under, its health monitor and its weight.
pub class ReplicaEntry
  getter adapter : ::Grant::Adapter::Base::Base
  getter key : String
  getter monitor : HealthMonitor?
  getter weight : Int32

  def initialize(@adapter : ::Grant::Adapter::Base::Base, @key : String = adapter.name, @monitor : HealthMonitor? = nil, weight : Int32 = 1)
    @weight = weight > 0 ? weight : 1
  end

  # True when the replica has no monitor or its monitor reports healthy.
  def healthy? : Bool
    monitor = @monitor
    monitor.nil? || monitor.healthy?
  end
end

# Load balancing strategies for read replicas.
#
# A strategy chooses among the healthy entries of an immutable array in
# `#pick`, which allocates nothing. `#next_index` is the lower-level hook the
# index-based strategies implement.
pub abstract class LoadBalancingStrategy
  abstract def next_index(total : Int32) : Int32
  abstract def reset : Nil

  # Chooses one healthy entry, or nil when none is healthy.
  def pick(entries : Array(ReplicaEntry)) : ReplicaEntry?
    healthy = 0
    last_healthy = nil
    entries.each do |entry|
      next unless entry.healthy?
      healthy += 1
      last_healthy = entry
    end
    return nil if healthy == 0
    return last_healthy if healthy == 1

    wanted = next_index(healthy)
    seen = 0
    entries.each do |entry|
      next unless entry.healthy?
      return entry if seen == wanted
      seen += 1
    end
    last_healthy
  end
end

# Round-robin load balancing
pub class RoundRobinStrategy < LoadBalancingStrategy
  getter current_index : Atomic(Int32) = Atomic(Int32).new(-1)

  def next_index(total : Int32) : Int32
    return 0 if total == 1
    positive_index((@current_index.add(1) &+ 1).to_i64, total)
  end

  def reset : Nil
    @current_index.set(-1)
  end
end

# Random load balancing
pub class RandomStrategy < LoadBalancingStrategy
  def next_index(total : Int32) : Int32
    Random.new.rand(total)
  end

  def reset : Nil
    # No state to reset
  end
end

# Sends each read to the healthy replica with the fewest connections checked
# out right now. The count is the adapter's own `active_checkouts`, which
# `Adapter#open_pool_connection` raises when it takes a connection and lowers
# in an `ensure` when it gives it back, so it can neither drift nor grow
# without bound.
pub class LeastConnectionsStrategy < LoadBalancingStrategy
  getter tie_breaker : Atomic(Int32) = Atomic(Int32).new(0)
  @connection_counts : Hash(Int32, Int32) = {} of Int32 => Int32

  def pick(entries : Array(ReplicaEntry)) : ReplicaEntry?
    # Start from a rotating offset so equally idle replicas share the load.
    size = entries.size
    return nil if size == 0

    start = positive_index((@tie_breaker.add(1) &+ 1).to_i64, size)
    best = nil
    best_count = 2147483647
    size.times do |step|
      entry = entries[(start + step) % size]
      next unless entry.healthy?
      count = entry.adapter.active_checkouts
      if count < best_count
        best = entry
        best_count = count
      end
    end
    best
  end

  # Index-based selection over a caller-tracked count, kept for callers that
  # drive the strategy directly. `ReplicaLoadBalancer` uses `#pick`.
  def next_index(total : Int32) : Int32
    begin
      (0...total).each { |i| @connection_counts[i] ||= 0 }

      min_index = 0
      min_count = @connection_counts[0]
      (1...total).each do |i|
        count = @connection_counts[i]
        if count < min_count
          min_count = count
          min_index = i
        end
      end

      @connection_counts[min_index] += 1
      min_index
    end
  end

  # Gives back the connection `#next_index` counted for *index*.
  def release_connection(index : Int32) : Nil
    begin
      if count = @connection_counts[index]?
        @connection_counts[index] = count > 0 ? count - 1 : 0
      end
      nil
    end
  end

  def reset : Nil
    begin
      @connection_counts = {} of Int32 => Int32
      nil
    end
  end
end

# Weighted round-robin: a replica registered with `weight: 3` receives three
# reads for each one sent to a replica with weight 1.
pub class WeightedStrategy < LoadBalancingStrategy
  getter cursor : Atomic(Int64) = Atomic(Int64).new(-1)

  def next_index(total : Int32) : Int32
    positive_index(@cursor.add(1) &+ 1, total)
  end

  def pick(entries : Array(ReplicaEntry)) : ReplicaEntry?
    total_weight = 0
    entries.each { |entry| total_weight += entry.weight if entry.healthy? }
    return nil if total_weight == 0

    slot = positive_index(@cursor.add(1) &+ 1, total_weight)
    entries.each do |entry|
      next unless entry.healthy?
      return entry if slot < entry.weight
      slot -= entry.weight
    end
    nil
  end

  def reset : Nil
    @cursor.set(-1)
  end
end

# Manages load balancing across read replicas.
#
# The replica list is an immutable array that registration and removal swap
# for a new one, so choosing a replica reads it without a lock.
pub class ReplicaLoadBalancer


  @entries : Array(ReplicaEntry)
  @strategy : LoadBalancingStrategy

  def initialize(adapters : Array(::Grant::Adapter::Base::Base), @strategy : LoadBalancingStrategy = RoundRobinStrategy.new)
    @entries = adapters.map { |adapter| ReplicaEntry.new(adapter) }
  end

  # Adds a replica to the pool. Registering a replica under a key that is
  # already present replaces the earlier entry instead of adding a second one.
  def add_replica(adapter : ::Grant::Adapter::Base::Base, monitor : HealthMonitor? = nil, key : String = adapter.name, weight : Int32 = 1) : ::Grant::Adapter::Base::Base?
    replaced = nil
    begin
      updated = @entries.reject do |entry|
        matches = entry.key == key
        replaced = entry.adapter if matches
        matches
      end
      updated << ReplicaEntry.new(adapter, key, monitor, weight)
      @entries = updated
    end
    replaced
  end

  # Remove a replica from the pool
  def remove_replica(adapter : ::Grant::Adapter::Base::Base) : Nil
    removed = false
    begin
      updated = @entries.reject { |entry| entry.adapter.object_id == adapter.object_id }
      removed = updated.size != @entries.size
      @entries = updated if removed
    end
    if removed
      @strategy.reset
    end
  end

  # Removes the replica registered under *key*, returning its adapter.
  def remove_key(key : String) : ::Grant::Adapter::Base::Base?
    removed = nil
    begin
      updated = @entries.reject do |entry|
        matches = entry.key == key
        removed = entry.adapter if matches
        matches
      end
      @entries = updated if removed
    end
    @strategy.reset if removed
    removed
  end

  # Get next available replica using the strategy. Allocates nothing.
  def next_replica : ::Grant::Adapter::Base::Base?
    entries = @entries
    return nil if entries.empty?

    entry = @strategy.pick(entries)
    entry.nil? ? nil : entry.adapter
  end

  # Get next replica with fallback to any replica if all unhealthy
  def next_replica_with_fallback : ::Grant::Adapter::Base::Base?
    if replica = next_replica
      return replica
    end

    entries = @entries
    return nil if entries.empty?

    # All replicas unhealthy: use the one whose last health check was newest.
    best = entries.first
    best_time = Time.unix(0_i64)
    entries.each do |entry|
      next unless monitor = entry.monitor
      if monitor.last_check_time > best_time
        best_time = monitor.last_check_time
        best = entry
      end
    end

    best.adapter
  end

  # Get all healthy replicas
  def healthy_replicas : Array(::Grant::Adapter::Base::Base)
    @entries.select(&.healthy?).map(&.adapter)
  end

  # Check if any replicas are healthy
  def any_healthy? : Bool
    @entries.any?(&.healthy?)
  end

  # Check if all replicas are healthy
  def all_healthy? : Bool
    entries = @entries
    !entries.empty? && entries.all?(&.healthy?)
  end

  # Get replica count
  def size : Int32
    @entries.size
  end

  # Get healthy replica count
  def healthy_count : Int32
    @entries.count(&.healthy?)
  end

  # Every replica adapter, in registration order.
  def replicas : Array(::Grant::Adapter::Base::Base)
    @entries.map(&.adapter)
  end

  # Set health monitor for an adapter
  def set_health_monitor(adapter : ::Grant::Adapter::Base::Base, monitor : HealthMonitor) : Nil
    begin
      @entries = @entries.map do |entry|
        entry.adapter.object_id == adapter.object_id ? ReplicaEntry.new(entry.adapter, entry.key, monitor, entry.weight) : entry
      end
    end
    nil
  end

  # Get load balancing strategy
  def strategy : LoadBalancingStrategy
    @strategy
  end

  # Change load balancing strategy
  def strategy=(new_strategy : LoadBalancingStrategy) : LoadBalancingStrategy
    @strategy.reset
    @strategy = new_strategy
  end

  # Get status of all replicas
  def status : Array(NamedTuple(adapter: String, healthy: Bool, index: Int32))
    @entries.map_with_index do |entry, index|
      {
        adapter: entry.adapter.name,
        healthy: entry.healthy?,
        index:   index,
      }
    end
  end
end

# Registry for load balancers
pub class LoadBalancerRegistry
  @@load_balancers = {} of String => ReplicaLoadBalancer

  def self.register(key : String, load_balancer : ReplicaLoadBalancer) : Nil
    begin
      @@load_balancers[key] = load_balancer
      nil
    end
  end

  def self.get(key : String) : ReplicaLoadBalancer?
    @@load_balancers[key]?
  end

  def self.unregister(key : String) : ReplicaLoadBalancer?
    begin
      @@load_balancers.delete(key)
    end
  end

  def self.clear : Nil
    begin
      @@load_balancers = {} of String => ReplicaLoadBalancer
      nil
    end
  end
end

pub annotation StrategyConfig
end

@@model_strategies = {} of String => LoadBalancingStrategy
pub def model_strategy(name : String, &build : -> LoadBalancingStrategy) : LoadBalancingStrategy
  @@model_strategies[name] ||= build.call
end
pub def store_model_strategy(name : String, value : LoadBalancingStrategy) : LoadBalancingStrategy
  @@model_strategies[name] = value
end

pub macro model_methods(model)
  def self.load_balancing_strategy : ::Grant::ReplicaLoadBalancer::LoadBalancingStrategy?
    {% if model.resolve.methods.any? { |m| m.annotation(::Grant::ReplicaLoadBalancer::StrategyConfig) } %}
      ::Grant::ReplicaLoadBalancer.model_strategy({{ model.stringify }}) { __configured_replica_strategy }
    {% else %}
      ::Grant::ReplicaLoadBalancer.model_strategy?({{ model.stringify }})
    {% end %}
  end

  def self.load_balancing_strategy=(strategy : ::Grant::ReplicaLoadBalancer::LoadBalancingStrategy) : ::Grant::ReplicaLoadBalancer::LoadBalancingStrategy
    ::Grant::ReplicaLoadBalancer.store_model_strategy({{ model.stringify }}, strategy)
    connection_config.each do |role, name|
      if role == :reading
        ::Grant::ConnectionRegistry::ConnectionRegistry.load_balancing_strategy(name, strategy)
      end
    end
    strategy
  end

  def self.__register_replica_strategy : Bool
    strategy = load_balancing_strategy
    self.load_balancing_strategy = strategy unless strategy.nil?
    true
  end
end

pub def model_strategy?(name : String) : LoadBalancingStrategy?
  @@model_strategies[name]?
end

# Crystal % is nonnegative for positive divisors, including wrapped counters.
pub def positive_index(value : Int64, total : Int32) : Int32
  remainder = value % total.to_i64
  (remainder < 0 ? remainder + total : remainder).to_i32
end
