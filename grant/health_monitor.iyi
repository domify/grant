module grant/health_monitor
import std/time::{Time, Span}
import grant/adapter/base::{Base}
import grant/error_taxonomy::{ConnectionFailed}
import grant/error::{ErrorBase}

# Task ownership remains with the monitor until stop; probes may outlive their
# timeout, but a monitor never starts a second probe while one is outstanding.
pub class HealthMonitor
  @@test_mode : Bool = false
  @healthy : Bool = true
  @probing : Bool = false
  @running : Bool = false
  @last_check_time : Time = Time.utc
  @stop_signal = Channel(Nil).new(1)
  @interval : Span
  @timeout : Span
  @tasks : IyiGroup

  def self.test_mode : Bool
    @@test_mode
  end
  def self.test_mode=(value : Bool) : Bool
    @@test_mode = value
  end

  def initialize(@adapter : Base, config : C) forall C
    @interval = config.health_check_interval
    @timeout = config.health_check_timeout
    @tasks = IyiGroup.new
    IyiScheduler.current.open_group = @tasks.outer
  end

  def start : Nil
    return nil if @@test_mode || @running
    @running = true
    @tasks.spawn do
      loop do
        select
        when @stop_signal.receive
          break
        when timeout(@interval.total_milliseconds.to_i32)
          break unless @running
          check_health_now
        end
      end
      nil
    end
    nil
  end

  def stop : Nil
    if @running
      @running = false
      @stop_signal.send(nil).or_panic
    end
    previous = IyiScheduler.current.open_group
    @tasks.join
    IyiScheduler.current.open_group = previous
    nil
  end

  def healthy? : Bool
    @healthy
  end
  def last_check_time : Time
    @last_check_time
  end
  def status : NamedTuple(healthy: Bool, last_check: Time, adapter: String)
    {healthy: @healthy, last_check: @last_check_time, adapter: @adapter.name}
  end

  def check_health_now : Bool
    return record_result(false) if @probing
    @probing = true
    channel = Channel(Bool).new(1)
    @tasks.spawn do
      result = @adapter.verify_strict
      @probing = false
      channel.send(!result.is_a?(::Error)).or_panic
      nil
    end
    answered = false
    select
    when result = channel.receive
      answered = result.or_panic
    when timeout(@timeout.total_milliseconds.to_i32)
      answered = false
    end
    record_result(answered)
  end

  def verify_strict : Nil | ConnectionFailed
    return nil if check_health_now
    ConnectionFailed.new("Connection #{@adapter.name} failed its health check", ErrorBase.new("Health check failed"))
  end

  private def record_result(result : Bool) : Bool
    @last_check_time = Time.utc
    @healthy = result
  end
end

pub class HealthMonitorRegistry
  @@monitors = {} of String => HealthMonitor

  def self.register(key : String, adapter : Base, config : C) : Nil forall C
    previous = @@monitors[key]?
    previous.stop if previous
    monitor = HealthMonitor.new(adapter, config)
    @@monitors[key] = monitor
    monitor.start
  end

  def self.unregister(key : String) : Nil
    monitor = @@monitors.delete(key)
    monitor.stop if monitor
    nil
  end

  def self.get(key : String) : HealthMonitor?
    @@monitors[key]?
  end

  def self.status : Array(NamedTuple(key: String, healthy: Bool, last_check: Time))
    result = [] of NamedTuple(key: String, healthy: Bool, last_check: Time)
    @@monitors.each do |key, monitor|
      result << {key: key, healthy: monitor.healthy?, last_check: monitor.last_check_time}
    end
    result
  end

  def self.clear : Nil
    retired = @@monitors.values
    @@monitors = {} of String => HealthMonitor
    retired.each(&.stop)
    nil
  end
end
