module grant/associations/composite_collection

import grant/query/builder::{Builder}
import grant/eager_loading::{StrictLoadingViolationError}
import grant/columns
import grant/error::{ErrorBase}
import grant/associations/through::{OwnerNotSaved}
import grant/associations/collection_relation::{CollectionRelation}

# Structural owner-scoped collection for a composite foreign key.
pub class CompositeCollection(Owner, Target)
  getter owner : Owner
  def initialize(@owner : Owner, @association_name : String, @foreign_keys : Array(String),
                 @primary_keys : Array(String), @scope : Proc(Builder(Target), Builder(Target))? = nil,
                 @loaded_records : Array(Target)? = nil, @strict_loading_option : Bool? = nil,
                 @inverse_name : String? = nil)
  end

  def loaded? : Bool
    !@loaded_records.nil?
  end

  def owner_key : Array(::Grant::Columns::Type)? | ErrorBase
    values = [] of ::Grant::Columns::Type
    @primary_keys.each do |column|
      value = @owner.read_attribute(column)!
      return nil if value.nil?
      values << value
    end
    values
  end

  def relation : Builder(Target)
    query = Target.current_scope
    scope = @scope
    query = scope.call(query) unless scope.nil?
    values = owner_key.or_panic
    return query.none if values.nil?
    @foreign_keys.each_with_index do |column, index|
      query = query.where(column, :eq, values[index])
    end
    query
  end

  def association_relation : Builder(Target)
    relation
  end

  def all : Array(Target) | ErrorBase
    records = @loaded_records
    return records unless records.nil?
    guard_lazy_load_strict!
    records = relation.select!
    records.each { |record| adopt(record) }
    records
  end

  def to_a : Array(Target) | ErrorBase
    all
  end

  def each(& : Target -> Nil) : Nil | ErrorBase
    all!.each { |record| yield record }
    nil
  end

  def reset : self
    @loaded_records = nil
    @owner.reset_association(@association_name)
    self
  end

  def reload : self | ErrorBase
    reset
    all!
    self
  end

  def size : Int64 | ErrorBase
    records = @loaded_records
    records.nil? ? count : records.size.to_i64
  end

  def count : Int64 | ErrorBase
    guard_lazy_load_strict!
    result = relation.count!
    result.is_a?(Int64) ? result : result.values.sum
  end

  def empty? : Bool | ErrorBase
    records = @loaded_records
    return records.empty? unless records.nil?
    guard_lazy_load_strict!
    !relation.exists?!
  end

  def any? : Bool | ErrorBase
    !empty?!
  end

  def none? : Bool | ErrorBase
    empty?
  end

  def first : Target? | ErrorBase
    all!.first?
  end

  def last : Target? | ErrorBase
    all!.last?
  end

  def build(**attributes) : Target | ErrorBase
    build(attributes.to_h)
  end

  def build(attributes : Hash(K, V)) : Target | ErrorBase forall K, V
    record = Target.new
    record.assign_attributes(attributes)!
    values = owner_key!
    unless values.nil?
      @foreign_keys.each_with_index { |column, index| record.write_attribute(column, values[index])! }
    end
    records = @loaded_records
    records << record unless records.nil?
    adopt(record)
    record
  end

  def create(**attributes) : Target | ErrorBase
    create_record(attributes.to_h, false)
  end

  def create_strict(**attributes) : Target | ErrorBase
    create_record(attributes.to_h, true)
  end

  def <<(record : Target) : self | ErrorBase
    values = owner_key!
    unless values.nil?
      @foreign_keys.each_with_index { |column, index| record.write_attribute(column, values[index])! }
    end
    records = @loaded_records
    records << record if !records.nil? && !records.includes?(record)
    adopt(record)
    record.save! if @owner.persisted?
    self
  end

  private def create_record(attributes : Hash(K, V), bang : Bool) : Target | ErrorBase forall K, V
    return OwnerNotSaved.new(@owner, Owner.to_s, @association_name, bang ? "create!" : "create") unless @owner.persisted?
    record = build(attributes)!
    bang ? record.save_strict! : record.save!
    record
  end

  private def guard_lazy_load_strict : Nil | ErrorBase
    {% if Owner.has_method?(:assert_association_can_lazy_load_strict) %}
      @owner.assert_association_can_lazy_load_strict(@association_name, @strict_loading_option)
    {% else %}
      strict = @strict_loading_option || false
      return nil unless strict
      StrictLoadingViolationError.new("#{Owner}##{@association_name} was not preloaded and strict loading is enabled")
    {% end %}
  end

  private def adopt(record : Target) : Nil
    inverse = @inverse_name
    record.set_loaded_association(inverse, [@owner]) unless inverse.nil?
    nil
  end
end

impl CollectionRelation(Owner, Target) for CompositeCollection(Owner, Target) forall Owner, Target
end
