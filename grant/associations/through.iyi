module grant/associations/through

import grant/errors::{RecordNotSaved, ValidationRecord}

pub class OwnerNotSaved < RecordNotSaved
  getter owner : ValidationRecord

  def initialize(@owner : ValidationRecord, model_name : String, association_name : String, action : String)
    super(model_name)
    @message = "You cannot call #{action} unless the parent is saved (#{model_name}##{association_name})"
  end
end

impl ::Error for OwnerNotSaved
  def message : String
    @message
  end
end
