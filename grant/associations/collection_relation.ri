module grant/associations/collection_relation

import grant/query/builder::{Builder}
import grant/query/aggregations::{CalculationResult}
import grant/errors::{ErrorBase}
import grant/adapter/driver::{Value}
import std/enumerable

pub trait CollectionRelation(Owner, Target)
  def scope : ::Grant::Query::Builder::Builder(Target)
    association_relation
  end

  def dependent_scope : ::Grant::Query::Builder::Builder(Target)
    association_relation
  end

  {% for name in [:order, :reorder] %}
    def {{ name.id }}(**attrs) : ::Grant::Query::Builder::Builder(Target)
      scope.{{ name.id }}(**attrs)
    end
    def {{ name.id }}(field : Symbol) : ::Grant::Query::Builder::Builder(Target)
      scope.{{ name.id }}(field)
    end
  {% end %}

  {% for name in [:offset, :limit] %}
    def {{ name.id }}(value : Int32) : ::Grant::Query::Builder::Builder(Target)
      scope.{{ name.id }}(value)
    end
  {% end %}

  def reverse_order : ::Grant::Query::Builder::Builder(Target)
    scope.reverse_order
  end

  {% for name in [:joins, :includes, :preload, :eager_load] %}
    def {{ name.id }}(name : Symbol) : ::Grant::Query::Builder::Builder(Target)
      {% if name == :preload || name == :eager_load %}
        scope.includes(name)
      {% else %}
        scope.{{ name.id }}(name)
      {% end %}
    end
  {% end %}

  def distinct : ::Grant::Query::Builder::Builder(Target)
    scope.distinct
  end

  def group_records(*fields : Symbol) : ::Grant::Query::Builder::Builder(Target)
    scope.group_records(*fields)
  end

  def pluck(*columns : Symbol | String) : Array(Array(Value)) | ErrorBase
    scope.pluck(*columns)
  end

  {% for name in [:sum, :average, :minimum, :maximum] %}
    def {{ name.id }}(column : Symbol | String) : CalculationResult | ErrorBase
      scope.{{ name.id }}(column)
    end
  {% end %}

  def sum(column : Symbol | String, as numeric_type : T.class) : T | ErrorBase forall T
    scope.sum(column, as: numeric_type)
  end

  def sum(&block : Target -> T) : T | ErrorBase forall T
    all!.sum_by { |record| yield record }
  end

  def group_by(&block : Target -> K) : Hash(K, Array(Target)) | ErrorBase forall K
    all!.group_by { |record| yield record }
  end

  def select(*columns : Symbol | String) : ::Grant::Query::Builder::Builder(Target)
    scope.select(*columns)
  end

  def where(**matches) : ::Grant::Query::Builder::Builder(Target)
    scope.where(**matches)
  end

  def where(matches : Hash(K, V)) : ::Grant::Query::Builder::Builder(Target) forall K, V
    scope.where(matches)
  end

  def where(field : Symbol | String, operator : Symbol, value : V) : ::Grant::Query::Builder::Builder(Target) forall V
    scope.where(field, operator, value)
  end

  def where(stmt : String, value : V = nil) : ::Grant::Query::Builder::Builder(Target) forall V
    scope.where(stmt, value)
  end

  def where : ::Grant::Query::Builder::Builder(Target)
    scope.where
  end

  def find_each(batch_size : Int32 = 1000, &block : Target -> T) : Nil | T | ErrorBase forall T
    scope.find_each(batch_size: batch_size) { |record| yield record }
  end

  def find_in_batches(batch_size : Int32 = 1000, &block : Array(Target) -> T) : Nil | T | ErrorBase forall T
    scope.find_in_batches(batch_size: batch_size) { |records| yield records }
  end

  def in_batches(of batch_size : Int32 = 1000, load : Bool = false,
                 &block : ::Grant::Query::Builder::Builder(Target) -> T) : Nil | ErrorBase forall T
    scope.in_batches(of: batch_size, load: load) { |batch| yield batch }
  end
end
