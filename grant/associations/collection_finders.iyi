module grant/associations/collection_finders

import grant/error::{ErrorBase}
import grant/querying::{NotFound}
import grant/query/bind_value
import grant/adapter/driver::{Value}
import std/indexable
import std/text

pub trait CollectionFinders(Owner, Target)
  def where(**matches) : ::Grant::Query::Builder::Builder(Target)
    association_relation.where(**matches)
  end

  {% for name in [:first, :last, :take] %}
    def {{ name.id }} : Target | Nil | ErrorBase
      records = memory_records
      if records.nil?
        adopt(association_relation.{{ name.id }}!)
      else
        {% if name == :last %}
          records.last?
        {% else %}
          records.first?
        {% end %}
      end
    end

    def {{ name.id }}_strict : Target | ErrorBase
      record = {{ name.id }}!
      record.nil? ? NotFound.new("No #{Target} found") : record
    end

    def {{ name.id }}(n : Int32) : Array(Target) | ErrorBase
      records = memory_records
      if records.nil?
        adopt(association_relation.{{ name.id }}(n)!)
      else
        {% if name == :last %}
          records.reversed.first(n).reversed
        {% else %}
          records.first(n)
        {% end %}
      end
    end
  {% end %}

  {% for pair in [{"second", 1}, {"third", 2}, {"fourth", 3}, {"fifth", 4}, {"forty_two", 41}, {"second_to_last", -2}, {"third_to_last", -3}] %}
    def {{ pair[0].id }} : Target | Nil | ErrorBase
      records = memory_records
      if records.nil?
        adopt(association_relation.{{ pair[0].id }}!)
      else
        records[{{ pair[1] }}]?
      end
    end

    def {{ pair[0].id }}_strict : Target | ErrorBase
      record = {{ pair[0].id }}!
      record.nil? ? NotFound.new("No #{Target} found") : record
    end
  {% end %}

  def find(value : V) : Target | Nil | ErrorBase forall V
    records = memory_records
    record = if records.nil?
      adopt(association_relation.where(Target.primary_name, :eq, value).first!)
    else
      records.find { |item| item.read_attribute(Target.primary_name).or_panic.to_s == value.to_s }
    end
    set_inverse(record) unless record.nil?
    record
  end

  def find_strict(id : V) : Target | ErrorBase forall V
    record = find(id)!
    return record unless record.nil?
    NotFound.new("No #{Target} found where #{Target.primary_name} = #{id}")
  end

  def find(ids : Array(V)) : Array(Target) | ErrorBase forall V
    records = memory_records
    if records.nil?
      adopt(association_relation.find(ids)!)
    else
      ids.map(&.to_s).compact_map do |key|
        records.find { |item| item.read_attribute(Target.primary_name).or_panic.to_s == key }
      end
    end
  end

  def find(first : A, second : B, *rest) : Array(Target) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find(ids)
  end

  def find_strict(ids : Array(V)) : Array(Target) | ErrorBase forall V
    found = find(ids)!
    if found.size != ids.size
      known = found.map { |record| record.read_attribute(Target.primary_name).or_panic.to_s }
      missing = ids.reject { |key| known.includes?(key.to_s) }
      return NotFound.new("Couldn't find all #{Target} with '#{Target.primary_name}': (#{ids.join(", ")}) (found #{found.size} results, but was looking for #{ids.size}; missing: #{missing.join(", ")})")
    end
    found
  end

  def find_strict(first : A, second : B, *rest) : Array(Target) | ErrorBase forall A, B
    ids = [::Grant::Query::BindValue.to_value(first), ::Grant::Query::BindValue.to_value(second)] of Value
    rest.each { |id| ids << ::Grant::Query::BindValue.to_value(id) }
    find_strict(ids)
  end
end
