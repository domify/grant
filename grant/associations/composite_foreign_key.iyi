module grant/associations/composite_foreign_key

pub import grant/associations/composite_collection

pub macro composite_has_many(model, scope = nil, **options)
  {% for unsupported in [:through, :as, :polymorphic, :counter_cache, :touch, :autosave] %}
    {% if options[unsupported] %}
      {% raise "has_many with a composite foreign key does not support `#{unsupported.id}:`" %}
    {% end %}
  {% end %}
  {% method_name = model.id %}
  {% class_name = options[:class_name] %}
  {% foreign_keys = options[:foreign_key] || options[:query_constraints] %}
  {% primary_keys = options[:primary_key] %}
  @[::Grant::Associations::Relationship(target: {{ class_name }}, type: :has_many, composite: true,
    foreign_key: {{ foreign_keys.map(&.id.stringify).join(",") }},
    primary_key: {{ primary_keys ? primary_keys.map(&.id.stringify).join(",") : "" }}, scope: {{ scope }})]
  def {{ method_name }} : ::Grant::Associations::CompositeCollection::CompositeCollection(self, {{ class_name }})
    loaded = get_loaded_association({{ method_name.stringify }})
    records = loaded.nil? ? nil : loaded.map { |record| record.as({{ class_name }}) }
    {% if scope %}
      {% if scope.args.empty? %}
        scope_proc = ->(query : ::Grant::Query::Builder::Builder({{ class_name }})) { query.{{ scope.body }} }
      {% else %}
        scope_proc = {{ scope }}
      {% end %}
    {% else %}
      scope_proc = nil
    {% end %}
    ::Grant::Associations::CompositeCollection::CompositeCollection(self, {{ class_name }}).new(
      self, {{ method_name.stringify }}, [{% for key in foreign_keys %}{{ key.id.stringify }},{% end %}] of String,
      {% if primary_keys %}[{% for key in primary_keys %}{{ key.id.stringify }},{% end %}] of String{% else %}{{ options[:owner_type] }}.composite_primary_key_columns.map(&.to_s){% end %},
      scope_proc, records, {{ options[:strict_loading] }}, {{ options[:inverse_of] ? options[:inverse_of].id.stringify : nil }})
  end

  def {{ method_name }}=(records : Array({{ class_name }})) : Nil | ::Grant::Error::ErrorBase
    values = {{ method_name }}.owner_key!
    unless values.nil?
      records.each do |record|
        {% for key, index in foreign_keys %}
          record.write_attribute({{ key.id.stringify }}, values[{{ index }}])!
        {% end %}
      end
    end
    set_loaded_association({{ method_name.stringify }}, records)
  end

  def reset_{{ method_name }} : Nil
    reset_association({{ method_name.stringify }})
  end

  def reload_{{ method_name }} : ::Grant::Associations::CompositeCollection::CompositeCollection(self, {{ class_name }}) | ::Grant::Error::ErrorBase
    reload_association({{ method_name.stringify }})!
    {{ method_name }}
  end
end
