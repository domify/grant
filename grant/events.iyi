module grant/events

import std/time::{Span}
import db/db/value::{DBValue}
import grant/notifications
import grant/transaction_options::{Options}

pub enum TransactionOutcome
  Commit
  Rollback
end

pub struct TransactionStart
  ::Grant::Notifications.publishable(::Grant::Events::TransactionStart)
  getter connection : String
  getter options : Options
  getter savepoint_name : String?

  def initialize(@connection : String, @options : Options, @savepoint_name : String? = nil)
  end

  def savepoint? : Bool
    !@savepoint_name.nil?
  end
end

pub struct Transaction
  ::Grant::Notifications.publishable(::Grant::Events::Transaction)
  getter connection : String
  getter outcome : TransactionOutcome
  getter duration : Span
  getter options : Options
  getter savepoint_name : String?

  def initialize(@connection : String, @outcome : TransactionOutcome, @duration : Span, @options : Options, @savepoint_name : String? = nil)
  end

  def savepoint? : Bool
    !@savepoint_name.nil?
  end

  def committed? : Bool
    @outcome.commit?
  end

  def rolled_back? : Bool
    @outcome.rollback?
  end
end

pub alias BindValue = DBValue
pub struct SQL
  ::Grant::Notifications.publishable(::Grant::Events::SQL)
  getter sql : String
  getter binds : Array(BindValue)
  getter name : String
  getter duration : Span
  getter connection : String
  getter cached : Bool
  getter async : Bool
  def initialize(@sql : String, @binds : Array(BindValue), @name : String, @duration : Span,
                 @connection : String, @cached : Bool = false, @async : Bool = false)
  end
  def cached? : Bool
    cached
  end
  def async? : Bool
    async
  end
end
