module grant/validators

import std/regex::{Regex}
import std/text
import grant/error
pub import grant/validators/uniqueness
pub import grant/validators/numericality
pub import grant/validators/built_in

pub abstract class Validator
  @validator_options : ::Grant::Error::Options? = nil

  def initialize(**options)
    @validator_options = ::Grant::Error.options_from(options)
  end

  def options : ::Grant::Error::Options
    @validator_options ||= ::Grant::Error::Options.new
  end

  def __assign_options(options : ::Grant::Error::Options) : Nil
    @validator_options = options
    nil
  end

  abstract def validate(record) : Nil
end

pub abstract class EachValidator < Validator
  getter attributes : Array(String)

  def initialize
    @attributes = [] of String
  end

  def initialize(*attributes : String | Symbol)
    @attributes = attributes.map(&.to_s).to_a
  end

  def validate(record) : Nil
    @attributes.each { |attribute| validate_each(record, attribute, record.read_attribute(attribute)) }
    nil
  end

  abstract def validate_each(record, attribute, value) : Nil
end

pub def blank?(value : T) : Bool forall T
  if value.is_a?(Nil)
    true
  elsif value.is_a?(Bool)
    !value
  elsif value.is_a?(String)
    value.strip.empty?
  elsif value.responds_to?(:empty?)
    value.empty?
  else
    false
  end
end

pub macro model_methods(model)
  @validation_contexts : Array(Symbol)? = nil

  def __active_validation_contexts : Array(Symbol)
    @validation_contexts || [new_record? ? :create : :update]
  end

  def valid?(context : Symbol | Array(Symbol) | Nil) : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    previous = @validation_contexts
    @validation_contexts = context.is_a?(Array(Symbol)) ? context : (context.nil? ? nil : [context])
    result = valid?
    @validation_contexts = previous
    result
  end

  def validate(context : Symbol | Array(Symbol) | Nil = nil) : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    valid?(context)
  end

  def validate_strict(context : Symbol | Array(Symbol) | Nil = nil) : self | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase | ::Grant::Errors::RecordInvalid
    valid = valid?(context)!
    return ::Grant::Errors::RecordInvalid.new(self) unless valid
    self
  end


  def __unconvertible_input(attribute : String) : ::Grant::Columns::Type?
    return nil unless errors.objects.any? { |error| error.is_a?(::Grant::Error::ConversionError) && error.attribute == attribute }
    raw = attribute_before_type_cast(attribute)
    raw.is_a?(::Grant::Error::ErrorBase) ? nil : raw
  end

  def invalid?(context : Symbol | Array(Symbol) | Nil = nil) : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    !valid?(context)!
  end

  {% for event in ["before_validation", "after_validation"] %}
    macro {{ event.id }}(method, **options)
      def __callback_{{ event.id }}_\{{ @type.methods.size }} : Nil | ::Grant::Callbacks::Abort
        ::Grant::Callbacks.guard(\{{ options[:if] }}, \{{ options[:unless] }}, nil)
        result = self.\{{ method.id }}
        return result if result.is_a?(::Grant::Callbacks::Abort)
        nil
      end
    end
  {% end %}

  macro validate(method, **options, &block)
    def __validate_method_\{{ @type.methods.size }} : Nil
      __validation_rule_options(:base, nil, \{{ options.double_splat }})
      \{% if block %}
        \{% if block.args.size > 0 %}\{{ block.args[0].id }} = self\{% end %}
        unless begin
          \{{ block.body }}
        end
          errors.add(:base, \{{ method }})
        end
      \{% else %}
        self.\{{ method.id }}
      \{% end %}
      nil
    end
  end

  macro validates_with(validator_class, *args, **options)
    def __validate_with_\{{ @type.methods.size }} : Nil
      __validation_rule_options(:base, nil, \{{ options.double_splat }})
      validator = \{{ validator_class }}.new(\{% for arg in args %}\{{ arg }}, \{% end %}\{% for key in options.keys.reject { |key| ["on", "if", "unless", "strict"].includes?(key.stringify) } %}\{{ key.id }}: \{{ options[key] }}, \{% end %})
      validator.validate(self)
      nil
    end
  end

  macro validates_each(*attributes, **options, &block)
    \{% for attribute in attributes %}
      def __validate_each_\{{ @type.methods.size }}_\{{ attribute.id }} : Nil
        value = self.\{{ attribute.id }}
        __validation_rule_options(\{{ attribute }}, value, \{{ options.double_splat }})
        \{% if options[:with] %}
          \{{ options[:with] }}.new.validate_each(self, \{{ attribute.id.stringify }}, value)
        \{% else %}
          \{% if block.args.size > 0 %}\{{ block.args[0].id }} = self\{% end %}
          \{% if block.args.size > 1 %}\{{ block.args[1].id }} = \{{ attribute }}\{% end %}
          \{% if block.args.size > 2 %}\{{ block.args[2].id }} = value\{% end %}
          1.times do
            \{{ block.body }}
          end
        \{% end %}
        nil
      end
    \{% end %}
  end

  macro validate(field, message, predicate, context = :save)
    def __validate_proc_\{{ @type.methods.size }} : Nil
      contexts = \{{ context }}
      contexts = [contexts] unless contexts.is_a?(Array(Symbol))
      active = __active_validation_contexts
      return nil unless active.includes?(:save) || contexts.includes?(:save) || contexts.any? { |item| active.includes?(item) }
      unless (\{{ predicate }}).call(self)
        errors << ::Grant::Error::Error.new(\{{ field.id.stringify }}, \{{ message }})
      end
      nil
    end
  end

  macro __validation_rule_options(field, rule_value, **options)
    \{% if options[:if] %}
      \{% terms = options[:if].is_a?(ArrayLiteral) ? options[:if] : [options[:if]] %}
      \{% for term in terms %}
        \{% if term.is_a?(SymbolLiteral) %}
          return nil unless self.\{{ term.id }}
        \{% else %}
          return nil unless (\{{ term }}).call(self)
        \{% end %}
      \{% end %}
    \{% end %}
    \{% if options[:unless] %}
      \{% terms = options[:unless].is_a?(ArrayLiteral) ? options[:unless] : [options[:unless]] %}
      \{% for term in terms %}
        \{% if term.is_a?(SymbolLiteral) %}
          return nil if self.\{{ term.id }}
        \{% else %}
          return nil if (\{{ term }}).call(self)
        \{% end %}
      \{% end %}
    \{% end %}
    \{% if options[:on] %}
      contexts = \{{ options[:on] }}
      contexts = [contexts] unless contexts.is_a?(Array(Symbol))
      active = __active_validation_contexts
      return nil unless active.includes?(:save) || contexts.includes?(:save) || contexts.any? { |item| active.includes?(item) }
    \{% end %}
    \{% if options[:allow_nil] %}
      return nil if \{{ rule_value }}.nil?
    \{% end %}
    \{% if options[:allow_blank] %}
      return nil if ::Grant::Validators.blank?(\{{ rule_value }})
    \{% end %}
  end

  macro validates_inclusion_of(*fields, **options)
    \{% for field in fields %}
      def __validate_inclusion_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        unless (\{{ options[:in] || options[:within] }}).any? { |candidate| candidate == value }
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "is not included in the list" }}, :inclusion)
        end
        nil
      end
    \{% end %}
  end

  macro validates_presence_of(*fields, **options)
    \{% for field in fields %}
      def __validate_presence_\{{ field.id }} : Nil
        \{% if options[:if] %}
          \{% terms = options[:if].is_a?(ArrayLiteral) ? options[:if] : [options[:if]] %}
          \{% for term in terms %}
            \{% if term.is_a?(SymbolLiteral) %}
              return nil unless self.\{{ term.id }}
            \{% else %}
              return nil unless (\{{ term }}).call(self)
            \{% end %}
          \{% end %}
        \{% end %}
        \{% if options[:unless] %}
          \{% terms = options[:unless].is_a?(ArrayLiteral) ? options[:unless] : [options[:unless]] %}
          \{% for term in terms %}
            \{% if term.is_a?(SymbolLiteral) %}
              return nil if self.\{{ term.id }}
            \{% else %}
              return nil if (\{{ term }}).call(self)
            \{% end %}
          \{% end %}
        \{% end %}
        \{% if options[:on] %}
          contexts = \{{ options[:on] }}
          contexts = [contexts] unless contexts.is_a?(Array(Symbol))
          active = __active_validation_contexts
          return nil unless active.includes?(:save) || contexts.includes?(:save) || contexts.any? { |item| active.includes?(item) }
        \{% end %}
        value = \{{ field.id }}
        \{% if options[:allow_nil] %}
          return nil if value.nil?
        \{% end %}
        \{% if options[:allow_blank] %}
          return nil if ::Grant::Validators.blank?(value)
        \{% end %}
        if ::Grant::Validators.blank?(value)
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "can't be blank" }}, :blank)
        end
        nil
      end
    \{% end %}
  end
  macro validates_length_of(*fields, **options)
    \{% minimum = options[:minimum] || options[:min] %}
    \{% maximum = options[:maximum] || options[:max] %}
    \{% exact = options[:is] %}
    \{% range = options[:in] || options[:within] %}
    \{% for field in fields %}
      def __validate_length_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        length = value.responds_to?(:size) ? value.size : value.to_s.size
        \{% if minimum %}
          if length < \{{ minimum }}
            errors.add(\{{ field.id.stringify }}, :too_short,
              message: \{{ options[:too_short] || options[:message] || nil }}, count: \{{ minimum }})
          end
        \{% end %}
        \{% if maximum %}
          if length > \{{ maximum }}
            errors.add(\{{ field.id.stringify }}, :too_long,
              message: \{{ options[:too_long] || options[:message] || nil }}, count: \{{ maximum }})
          end
        \{% end %}
        \{% if exact %}
          unless length == \{{ exact }}
            errors.add(\{{ field.id.stringify }}, :wrong_length,
              message: \{{ options[:wrong_length] || options[:message] || nil }}, count: \{{ exact }})
          end
        \{% end %}
        \{% if range %}
          range = \{{ range }}
          lower = range.begin
          if !lower.nil? && length < lower
            errors.add(\{{ field.id.stringify }}, :too_short,
              message: \{{ options[:too_short] || options[:message] || nil }}, count: lower)
          end
          upper = range.end
          unless upper.nil?
            largest = range.exclusive? ? upper - 1 : upper
            if length > largest
              errors.add(\{{ field.id.stringify }}, :too_long,
                message: \{{ options[:too_long] || options[:message] || nil }}, count: largest)
            end
          end
        \{% end %}
        nil
      end
    \{% end %}
  end

  macro validates_size_of(*fields, **options)
    validates_length_of(\{{ fields.splat }}, \{{ options.double_splat }})
  end

  macro validates_format_of(*fields, **options)
    \{% for field in fields %}
      def __validate_format_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        invalid = false
        \{% if options[:with] %}
          invalid = !value.to_s.matches?(\{{ options[:with] }})
        \{% end %}
        \{% if options[:without] %}
          invalid = invalid || value.to_s.matches?(\{{ options[:without] }})
        \{% end %}
        if invalid
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "is invalid" }}, :invalid)
        end
        nil
      end
    \{% end %}
  end

  macro validates_email(*fields, **options)
    validates_format_of(\{{ fields.splat }},
      with: ::Grant::Validators::BuiltIn::CommonFormats::EMAIL_REGEX,
      message: \{{ options[:message] || "is not a valid email" }},
      \{% for key, value in options %}\{% unless key.stringify == "message" %}
        \{{ key.id }}: \{{ value }},
      \{% end %}\{% end %})
  end

  macro validates_url(*fields, **options)
    validates_format_of(\{{ fields.splat }},
      with: ::Grant::Validators::BuiltIn::CommonFormats::URL_REGEX,
      message: \{{ options[:message] || "is not a valid URL" }},
      \{% for key, value in options %}\{% unless key.stringify == "message" %}
        \{{ key.id }}: \{{ value }},
      \{% end %}\{% end %})
  end

  macro validates_absence_of(*fields, **options)
    \{% for field in fields %}
      def __validate_absence_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        unless ::Grant::Validators.blank?(value)
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "must be blank" }}, :present)
        end
        nil
      end
    \{% end %}
  end

  macro validates_exclusion_of(*fields, **options)
    \{% for field in fields %}
      def __validate_exclusion_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        if (\{{ options[:in] || options[:within] }}).any? { |candidate| candidate == value }
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "is reserved" }}, :exclusion)
        end
        nil
      end
    \{% end %}
  end

  macro validates_associated(*associations, **options)
    \{% for association in associations %}
      def __validate_associated_\{{ association.id }} : Nil | ::Grant::Error::ErrorBase
        associated = self.\{{ association.id }}
        __validation_rule_options(\{{ association }}, associated, \{{ options.double_splat }})
        valid = true
        unless associated.nil?
          if associated.responds_to?(:to_a)
            records = associated.to_a
            return records if records.is_a?(::Grant::Error::ErrorBase)
            records.each { |record| valid = false unless record.valid?! }
          else
            valid = associated.valid?!
          end
        end
        errors.add(\{{ association.id.stringify }}, :invalid, message: \{{ options[:message] || nil }}) unless valid
        nil
      end
    \{% end %}
  end

  macro validates_confirmation_of(*fields, **options)
    \{% for field in fields %}
      property \{{ field.id }}_confirmation : String? = nil
      def __validate_confirmation_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        confirmation = self.\{{ field.id }}_confirmation
        unless confirmation.nil? || value.to_s == confirmation
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "doesn't match confirmation" }}, :confirmation)
        end
        nil
      end
    \{% end %}
  end

  macro validates_acceptance_of(*fields, **options)
    \{% for field in fields %}
      \{% unless @type.has_method?(field.id.stringify) %}
        property \{{ field.id }} : String? = nil
      \{% end %}
      def __validate_acceptance_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        accepted = value.is_a?(Bool) ? value == true : (\{{ options[:accept] || ["1", "true", "yes", "on"] }}).includes?(value.to_s.downcase)
        unless accepted
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "must be accepted" }}, :accepted)
        end
        nil
      end
    \{% end %}
  end

  macro validates_comparison_of(*fields, **options)
    \{% for field in fields %}
      def __validate_comparison_\{{ field.id }} : Nil
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        if value.nil?
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "can't be blank" }}, :blank)
          return nil
        end
        \{% for comparison in [
          {key: :greater_than, op: ">", text: "greater than"},
          {key: :greater_than_or_equal_to, op: ">=", text: "greater than or equal to"},
          {key: :equal_to, op: "==", text: "equal to"},
          {key: :less_than, op: "<", text: "less than"},
          {key: :less_than_or_equal_to, op: "<=", text: "less than or equal to"},
          {key: :other_than, op: "!=", text: "other than"},
        ] %}
          \{% operand = options[comparison[:key]] %}
          \{% if operand != nil %}
            \{% if operand.is_a?(SymbolLiteral) %}
              bound = self.\{{ operand.id }}
            \{% elsif operand.is_a?(ProcLiteral) || operand.is_a?(ProcNotation) %}
              bound = (\{{ operand }}).call(self)
            \{% else %}
              bound = \{{ operand }}
            \{% end %}
            if bound.nil?
              errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
                \{{ options[:message] || "is invalid" }}, :comparison)
            elsif !(value \{{ comparison[:op].id }} bound)
              errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
                \{% if options[:message] %}\{{ options[:message] }}\{% else %}"must be \{{ comparison[:text].id }} #{bound}"\{% end %},
                \{{ comparison[:key] }}, options: {:count => ::Grant::Error.value(bound), :value => ::Grant::Error.value(value)} of Symbol => ::Grant::Error::Value)
            end
          \{% end %}
        \{% end %}
        nil
      end
    \{% end %}
  end

  ::Grant::Validators::Uniqueness.model_methods({{ model }})
  ::Grant::Validators::Numericality.model_methods({{ model }})

end
