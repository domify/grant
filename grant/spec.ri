module grant/spec

import grant/spec_support/transactional
import grant/errors::{ErrorBase}

pub def transactional(only : Array(String)? = nil) : Nil
  ::Grant::SpecSupport::Transactional.transactional(only)
end

pub def within_transaction(only : Array(String)? = nil, &block : -> T) : T | ErrorBase forall T
  ::Grant::SpecSupport::Transactional.within_transaction(only) { yield }
end

pub def run_example(&block : -> T) : T | ErrorBase forall T
  ::Grant::SpecSupport::Transactional.run_example { yield }
end
