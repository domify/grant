module grant/store_accessor

pub macro store_accessor(store, *keys, **options)
  {% prefix = options[:prefix] %}
  {% suffix = options[:suffix] %}
  {% name_prefix = (prefix == nil || prefix == false) ? "" : (prefix == true ? "#{store.id}_" : "#{prefix.id}_") %}
  {% name_suffix = (suffix == nil || suffix == false) ? "" : (suffix == true ? "_#{store.id}" : "_#{suffix.id}") %}
  {% for key in keys %}
    {% unless key.is_a?(TypeDeclaration) %}
      {% raise "store_accessor keys must be type declarations" %}
    {% end %}
    {% accessor = "#{name_prefix.id}#{key.var.id}#{name_suffix.id}".id %}
    {% default = key.value.is_a?(Nop) ? "nil".id : key.value %}
    {% ivar = "_store_#{store.id}_#{accessor}".id %}
    @{{ ivar }}_was : {{ key.type }}? = nil
    @{{ ivar }}_dirty : Bool = false

    def {{ accessor }} : {{ key.type }}
      if object = self.{{ store.id }}
        object.{{ key.var.id }}
      else
        {{ default }}
      end
    end

    {% if key.type.stringify == "Bool" %}
      def {{ accessor }}? : Bool
        {{ accessor }} == true
      end
    {% end %}

    def {{ accessor }}=(value : {{ key.type }}) : {{ key.type }}
      current = {{ accessor }}
      unless @{{ ivar }}_dirty
        @{{ ivar }}_was = current
        @{{ ivar }}_dirty = true
      end
      object = self.{{ store.id }} || self.__new_{{ store.id }}_store
      object.{{ key.var.id }} = value
      self.{{ store.id }} = object
      @{{ ivar }}_dirty = false if value == @{{ ivar }}_was
      value
    end

    def {{ accessor }}_changed? : Bool
      @{{ ivar }}_dirty
    end

    def {{ accessor }}_was : {{ key.type }}
      if @{{ ivar }}_dirty
        was = @{{ ivar }}_was
        was.nil? ? {{ default }} : was
      else
        {{ accessor }}
      end
    end

    after_save :_reset_{{ ivar }}_tracking
    private def _reset_{{ ivar }}_tracking : Nil
      @{{ ivar }}_dirty = false
      @{{ ivar }}_was = nil
      nil
    end
  {% end %}
end
