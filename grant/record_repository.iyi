module grant/record_repository

import grant/collection_source::{CollectionSource}
import grant/model_context::{ModelContext}
import grant/value::{Value, Row, Attributes}
import grant/errors::{DatabaseError, ValidationError, CallbackAbort}
import grant/database::{Database}
import grant/query::{Query, Table}
import grant/lifecycle::{Pipeline, Event, AroundError, WriteContext}
import grant/unit_of_work::{UnitOfWork, Observer, Action}
import grant/validation::{Context}
import grant/normalization::{Plan}
import grant/dirty::{State}

# Applications explicitly map their sealed record types to a table. The ORM
# never reopens those types or discovers their fields through a global macro.
pub trait Mapping(T)
  abstract def table : Table
  abstract def attributes(record : T) : Attributes
  abstract def from_row(row : Row) : T | DatabaseError
  abstract def validate(record : T) : Nil | ValidationError | DatabaseError

  def bind_context(record : T, context : ModelContext) : T
    record
  end

  def readonly_attributes : Array(String)
    [] of String
  end

  # Existing simple mappings retain their validation implementation. Mappings
  # with database/context rules override this overload to use the authoritative
  # update key even when an application supplies a record with id=nil.
  def validate(record : T, context : Context) : Nil | ValidationError | DatabaseError
    validate(record)
  end

  # The default preserves existing application-owned context validation; model
  # mappings may evaluate SQL rules on this caller-owned connection.
  def validate(record : T, database : Database, context : Context) : Nil | ValidationError | DatabaseError
    validate(record, context)
  end

  def normalization : Plan?
    nil
  end

  # Sealed application records are rebuilt explicitly; hydration is not an
  # assignment API and must never be reused to build an unsaved record.
  def with_attributes(record : T, attributes : Attributes) : T | DatabaseError
    DatabaseError.new(21, "assignment", "mapping must implement with_attributes for normalization or timestamp assignment")
  end

  def normalize(record : T, context : Context) : T | DatabaseError
    if plan = normalization
      with_attributes(record, plan.apply(attributes(record), context))
    else
      record
    end
  end
end

pub class Repository(T)
  @database : Database
  @mapping : Mapping(T)
  @events : Pipeline(T)?
  @unit : UnitOfWork
  @model_context : ModelContext

  def initialize(@database : Database, @mapping : Mapping(T), @events : Pipeline(T)? = nil, unit : UnitOfWork? = nil, context : ModelContext? = nil)
    @unit = unit || UnitOfWork.new(@database)
    @model_context = context || ModelContext.new(@database.identity)
    @model_context.register_source(@mapping.table.name, self) if @model_context.database_identity == @database.identity
  end

  def model_context : ModelContext
    @model_context
  end

  private def contextual(record : T) : T
    @mapping.bind_context(record, @model_context)
  end

  private def hydrate(row : Row) : T | DatabaseError
    return DatabaseError.new(21, "association", "model context belongs to another database") unless @model_context.database_identity == @database.identity
    current = @mapping.from_row(row)!
    contextual(current)
  end

  def query : Query
    Query.new(@database, @mapping.table, normalization: @mapping.normalization)
  end

  def unit_of_work : UnitOfWork
    @unit
  end

  def attributes(record : T) : Attributes
    @mapping.attributes(record)
  end

  def with_attributes(record : T, attributes : Attributes) : T | DatabaseError
    rebuilt = @mapping.with_attributes(record, attributes)!
    contextual(rebuilt)
  end

  def all(scope : Query) : Array(T) | DatabaseError
    valid_scope(scope)!
    rows = scope.all!
    records = [] of T
    rows.each do |row|
      records << hydrate(row)!
    end
    records
  end

  def count(scope : Query) : Int64 | DatabaseError
    valid_scope(scope)!
    scope.count
  end

  def first(scope : Query) : T | Nil | DatabaseError
    valid_scope(scope)!
    row = scope.first!
    row ? hydrate(row) : nil
  end

  private def valid_scope(scope : Query) : Nil | DatabaseError
    return DatabaseError.new(21, "association", "model context belongs to another database") unless @model_context.database_identity == @database.identity
    table = @mapping.table
    return DatabaseError.new(21, "scope", "scope belongs to another table") unless scope.table.name == table.name && scope.table.primary_key == table.primary_key
    return DatabaseError.new(21, "scope", "scope belongs to another database") unless scope.database_identity == @database.identity
    nil
  end

  def find(id : Int64) : T | Nil | DatabaseError
    valid_scope(query)!
    row = query.where(@mapping.table.primary_key, id).first!
    row ? hydrate(row) : nil
  end

  # Standalone validation runs the same normalization and validation callbacks
  # as a save, but never writes the record or observes it for commit callbacks.
  # Callback side effects belong to a savepoint, including inside an outer unit.
  def validate(record : T, context : String | Array(String) | Nil = nil,
               persisted_id : Int64? = nil, skip_normalization : Bool = false) : T | AroundError
    return DatabaseError.new(21, "validation", "model context belongs to another database") unless @model_context.database_identity == @database.identity
    return DatabaseError.new(21, "validation", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    @unit.run(requires_new: true) do
      active = standalone_context(record, context, persisted_id)
      if active.is_a?(DatabaseError)
        active
      else
        validated(record, active, skip_normalization: skip_normalization)
      end
    end
  end

  def valid?(record : T, context : String | Array(String) | Nil = nil,
             persisted_id : Int64? = nil, skip_normalization : Bool = false) : Bool | DatabaseError | CallbackAbort | Panicked | Cancelled
    result = validate(record, context, persisted_id, skip_normalization)
    return false if result.is_a?(ValidationError)
    return result if result.is_a?(Error)
    true
  end

  def invalid?(record : T, context : String | Array(String) | Nil = nil,
               persisted_id : Int64? = nil, skip_normalization : Bool = false) : Bool | DatabaseError | CallbackAbort | Panicked | Cancelled
    result = valid?(record, context, persisted_id, skip_normalization)!
    !result
  end

  private def standalone_context(record : T, context : String | Array(String) | Nil, persisted_id : Int64?) : Context | DatabaseError
    key = persisted_id || @mapping.attributes(record)[@mapping.table.primary_key]?
    unless key.nil? || key.is_a?(Int64)
      return DatabaseError.new(20, "validation", "standalone validation requires an Int64 or nil primary key")
    end
    operation = key.nil? ? "create" : "update"
    if context.is_a?(Array(String))
      Context.new(operation, persisted_id: key, contexts: context)
    else
      Context.new(operation, context, persisted_id: key)
    end
  end

  def insert(record : T, validation_context : Array(String)? = nil) : T | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    return DatabaseError.new(21, "association", "model context belongs to another database") unless @model_context.database_identity == @database.identity
    return DatabaseError.new(21, "insert", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    @unit.run(requires_new: true) { insert_record(record, validation_context) }
  end

  def update(scope : Query, id : Int64, record : T, validation_context : Array(String)? = nil) : T | Nil | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    valid_scope(scope)!
    return DatabaseError.new(21, "update", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    context = write_context(record)!
    @unit.run(requires_new: true) { update_record(scope, id, record, context, validation_context) }
  end

  # The application supplies the loaded snapshot, rather than comparing against
  # a fresh row (which would overwrite changes made by a sibling record).
  def update_changed(scope : Query, id : Int64, record : T, baseline : Attributes,
                     forced : Array(String) = [] of String, skip_timestamps : Bool = false, validation_context : Array(String)? = nil) : T | Nil | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    valid_scope(scope)!
    return DatabaseError.new(21, "update", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    values = @mapping.attributes(record)
    return DatabaseError.new(21, "update", "baseline must expose the same mapped attributes") unless values.size == baseline.size && values.keys.all? { |name| baseline.has_key?(name) }
    return DatabaseError.new(21, "update", "baseline primary key does not match the persisted ID") unless baseline[@mapping.table.primary_key]? == id
    input_id = values[@mapping.table.primary_key]?
    return DatabaseError.new(21, "update", "record primary key does not match the persisted ID") unless input_id.nil? || input_id == id
    forced.each do |name|
      return DatabaseError.new(21, "update", "forced attribute is not mapped: #{name}") unless values.has_key?(name)
      return DatabaseError.new(21, "update", "cannot force a primary key write") if name == @mapping.table.primary_key
    end
    context = write_context(record, baseline, forced, !skip_timestamps)!
    @unit.run(requires_new: true) { update_record(scope, id, record, context, validation_context) }
  end

  def update_changed(scope : Query, id : Int64, record : T, state : State(Value), skip_timestamps : Bool = false, validation_context : Array(String)? = nil) : T | Nil | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    values = @mapping.attributes(record)
    pending = state.attributes
    return DatabaseError.new(21, "update", "record attributes do not match the supplied dirty state") unless values.size == pending.size
    values.each do |name, value|
      return DatabaseError.new(21, "update", "record attributes do not match the supplied dirty state") unless pending.has_key?(name) && pending[name] == value
    end
    update_changed(scope, id, record, state.baseline_attributes, state.forced_changes, skip_timestamps, validation_context)
  end

  def destroy(scope : Query, id : Int64) : T | Nil | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    valid_scope(scope)!
    return DatabaseError.new(21, "destroy", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    @unit.run(requires_new: true) { destroy_record(scope, id) }
  end

  # A touch is a partial stored write: validation, normalization and save/update
  # callbacks do not run. AfterTouch and transaction observers still run.
  def touch(scope : Query, id : Int64, attributes : Attributes) : T | Nil | DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled
    valid_scope(scope)!
    return DatabaseError.new(21, "touch", "unit of work belongs to another database") unless @unit.database_identity == @database.identity
    @unit.run(requires_new: true) { touch_record(scope, id, attributes) }
  end

  private def touch_record(scope : Query, id : Int64, attributes : Attributes) : T | Nil | DatabaseError | ValidationError | CallbackAbort
    return DatabaseError.new(21, "touch", "no timestamp columns are available to touch") if attributes.empty?
    key = @mapping.table.primary_key
    return DatabaseError.new(21, "touch", "touch cannot change the primary key") if attributes.has_key?(key)
    selected = scope.where_stored(key, id)
    row = selected.first!
    return nil unless row
    current = hydrate(row)!
    declared = @mapping.attributes(current)
    attributes.each do |name, value|
      return DatabaseError.new(20, "touch", "mapping does not expose column: #{name}") unless declared.has_key?(name)
    end
    changed = selected.update(attributes)!
    return nil if changed.changes == 0
    row = query.where_stored(key, id).first!
    return DatabaseError.new(20, "touch", "updated row could not be hydrated") unless row
    current = hydrate(row)!
    observe(current, row[key], Action::Update)!
    callback(Event::AfterTouch, current)
  end

  private def validated(record : T, context : Context, write_context : WriteContext = WriteContext.new,
                        skip_normalization : Bool = false) : T | AroundError
    normalized = skip_normalization ? contextual(record) : @mapping.normalize(contextual(record), context)
    return normalized if normalized.is_a?(DatabaseError)
    around_required(Event::AroundValidation, contextual(normalized), context) { |current| validate_prepared(current, context, write_context) }
  end

  private def validate_prepared(record : T, context : Context, write_context : WriteContext) : T | DatabaseError | ValidationError | CallbackAbort
    prepared = callback(Event::BeforeValidation, record, write_context, context)
    return prepared if prepared.is_a?(Error)
    current = prepared
    validation = @mapping.validate(current, @database, context)
    prepared = callback(Event::AfterValidation, current, write_context, context)
    return prepared if prepared.is_a?(Error)
    current = prepared
    return validation if validation.is_a?(Error)
    current
  end

  private def insert_record(record : T, validation_context : Array(String)?) : T | AroundError
    current = validated(record, Context.new("create", contexts: validation_context))!
    around_required(Event::AroundSave, current) { |saving| insert_saved(saving) }
  end

  private def insert_saved(record : T) : T | AroundError
    current = record
    prepared = callback(Event::BeforeSave, current)
    return prepared if prepared.is_a?(Error)
    current = prepared
    current = around_required(Event::AroundCreate, current) { |creating| create_record(creating) }!
    callback(Event::AfterSave, current)
  end

  private def create_record(record : T) : T | DatabaseError | ValidationError | CallbackAbort
    current = record
    prepared = callback(Event::BeforeCreate, current)
    return prepared if prepared.is_a?(Error)
    current = prepared
    row = query.insert(write_attributes(current))!
    current = hydrate(row)!
    observed = observe(current, row[@mapping.table.primary_key], Action::Create)
    return observed if observed.is_a?(DatabaseError)
    prepared = callback(Event::AfterCreate, current)
    return prepared if prepared.is_a?(Error)
    prepared
  end

  private def update_record(scope : Query, id : Int64, record : T, context : WriteContext, validation_context : Array(String)? = nil) : T | Nil | AroundError
    current = validated(record, Context.new("update", persisted_id: id, contexts: validation_context), context)!
    around(Event::AroundSave, current) { |saving| update_saved(scope, id, saving, context) }
  end

  private def update_saved(scope : Query, id : Int64, record : T, context : WriteContext) : T | Nil | AroundError
    current = record
    prepared = callback(Event::BeforeSave, current, context)
    return prepared if prepared.is_a?(Error)
    current = prepared
    current = around(Event::AroundUpdate, current) { |updating| update_prepared(scope, id, updating, context) }!
    return nil unless current
    callback(Event::AfterSave, current, context)
  end

  private def update_prepared(scope : Query, id : Int64, record : T, context : WriteContext) : T | Nil | DatabaseError | ValidationError | CallbackAbort
    current = record
    prepared = callback(Event::BeforeUpdate, current, context)
    return prepared if prepared.is_a?(Error)
    current = prepared
    selected = scope.where(@mapping.table.primary_key, id)
    values = context.changes(@mapping.attributes(current))
    if values.empty?
      row = selected.first!
      return nil unless row
      current = hydrate(row)!
      observe(current, row[@mapping.table.primary_key], Action::Update)!
      return callback(Event::AfterUpdate, current, context)
    end
    changed = selected.update(values)!
    return nil if changed.changes == 0
    # The write already applied the original scope. A changed filter column
    # may no longer match it; hydrate the row actually updated by its fixed key.
    row = query.where(@mapping.table.primary_key, id).first!
    return nil unless row
    current = hydrate(row)!
    observed = observe(current, row[@mapping.table.primary_key], Action::Update)
    return observed if observed.is_a?(DatabaseError)
    prepared = callback(Event::AfterUpdate, current, context)
    return prepared if prepared.is_a?(Error)
    prepared
  end

  private def destroy_record(scope : Query, id : Int64) : T | Nil | AroundError
    selected = scope.where(@mapping.table.primary_key, id)
    row = selected.first!
    return nil unless row
    current = hydrate(row)!
    around(Event::AroundDestroy, current) { |destroying| destroy_prepared(selected, row[@mapping.table.primary_key], destroying) }
  end

  private def destroy_prepared(selected : Query, id : Value, record : T) : T | Nil | DatabaseError | ValidationError | CallbackAbort
    current = record
    prepared = callback(Event::BeforeDestroy, current)
    return prepared if prepared.is_a?(Error)
    current = prepared
    deleted = selected.delete!
    return nil if deleted.changes == 0
    observed = observe(current, id, Action::Destroy)
    return observed if observed.is_a?(DatabaseError)
    callback(Event::AfterDestroy, current)
  end

  private def around(event : Event, record : T, validation_context : Context = Context.new, &operation : T -> T | Nil | AroundError) : T | Nil | AroundError
    result = if events = @events
               events.wrap(event, contextual(record), validation_context, &operation)
             else
               operation.call(contextual(record))
             end
    return result if result.is_a?(Error) || result.nil?
    contextual(result)
  end

  private def around_required(event : Event, record : T, validation_context : Context = Context.new, &operation : T -> T | Nil | AroundError) : T | AroundError
    result = around(event, record, validation_context, &operation)
    result.nil? ? CallbackAbort.new("around callback returned no record for #{event}") : result
  end

  private def callback(event : Event, record : T, context : WriteContext = WriteContext.new, validation_context : Context = Context.new) : T | DatabaseError | ValidationError | CallbackAbort
    if events = @events
      current = events.run(event, contextual(record), context, validation_context)
      return current if current.is_a?(Error)
      contextual(current)
    else
      contextual(record)
    end
  end

  private def observe(record : T, id : Value, action : Action) : Nil | DatabaseError
    if events = @events
      @unit.observe(RecordObserver(T).new("#{@mapping.table.name}:#{id}", events, record, action))!
    end
    nil
  end

  private def write_attributes(record : T) : Attributes
    values = Attributes.new
    @mapping.attributes(record).each do |name, value|
      values[name] = value unless name == @mapping.table.primary_key
    end
    values
  end

  private def write_context(record : T, baseline : Attributes? = nil, forced : Array(String) = [] of String, stamp : Bool = true) : WriteContext | DatabaseError
    readonly = @mapping.readonly_attributes
    if events = @events
      readonly += events.readonly_attributes
    end
    declared = @mapping.attributes(record)
    readonly.each do |name|
      return DatabaseError.new(21, "update", "readonly attribute is not mapped: #{name}") unless declared.has_key?(name)
    end
    WriteContext.new(baseline, forced, readonly, @mapping.table.primary_key, stamp)
  end
end

class RecordObserver(T)
  getter identity : String
  @events : Pipeline(T)
  @record : T
  @action : Action

  def initialize(@identity : String, @events : Pipeline(T), @record : T, @action : Action)
  end
end

impl Observer for RecordObserver(T) forall T
  def action : Action?
    @action
  end

  def merge(other : Observer) : Nil
    if incoming = other.action
      if @action == Action::Destroy || incoming == Action::Destroy
        @action = Action::Destroy
      elsif @action == Action::Create || incoming == Action::Create
        @action = Action::Create
      else
        @action = Action::Update
      end
    end
    nil
  end

  def committed : Nil | DatabaseError | ValidationError | CallbackAbort
    result = @events.run(Event::AfterCommit, @record, action: @action)
    return result if result.is_a?(Error)
    nil
  end

  def rolled_back : Nil | DatabaseError | ValidationError | CallbackAbort
    result = @events.run(Event::AfterRollback, @record, action: @action)
    return result if result.is_a?(Error)
    nil
  end
end

impl CollectionSource(T) for Repository(T) forall T
  def read_query : Query
    self.query
  end

  def read_all(scope : Query) : Array(T) | DatabaseError
    self.all(scope)
  end

  def read_count(scope : Query) : Int64 | DatabaseError
    self.count(scope)
  end

  def read_attributes(record : T) : Attributes | DatabaseError
    self.attributes(record)
  end
end
