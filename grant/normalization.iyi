module grant/normalization

pub annotation Normalizer
end

# Same assignment hook and class lookup as upstream Grant::Normalization.
pub macro normalizes(*attributes, **options, &block)
  {% unless options[:with] || block %}
    {% raise "normalizes requires a `with:` proc or a block" %}
  {% end %}
  {% if attributes.empty? %}
    {% raise "normalizes requires at least one attribute" %}
  {% end %}
  {% for attribute in attributes %}
    @[::Grant::Normalization::Normalizer(attribute: {{ attribute.id.stringify }}, conditional: {{ options[:if] || false }})]
    def __normalizer_{{ attribute.id }} : Nil
      nil
    end

    def self.__normalize_{{ attribute.id }}(value : V) : V | ::Grant::Columns::Type forall V
      {% unless options[:apply_to_nil] %}
        return value if value.nil?
      {% end %}
      {% if options[:with] %}
        {{ options[:with] }}.call(value)
      {% else %}
        {% if block.args.size > 0 && block.args[0].stringify != "value" %}
          {{ block.args[0] }} = value
        {% end %}
        {{ block.body }}
      {% end %}
    end

    {% if options[:if] %}
      before_validation :_normalize_{{ attribute.id }}
      private def _normalize_{{ attribute.id }} : Nil
        return nil if @_skip_normalization
        return nil unless {{ options[:if].id }}
        if current = self.{{ attribute.id }}
          self.{{ attribute.id }} = self.class.__normalize_{{ attribute.id }}(current).as(typeof(current))
        end
        nil
      end
    {% end %}
  {% end %}
end

pub macro model_methods(model)
  @_skip_normalization : Bool = false

  def valid?(*, skip_normalization : Bool) : Bool | ::Grant::Callbacks::Abort | ::Grant::Error::ErrorBase
    previous = @_skip_normalization
    @_skip_normalization = skip_normalization
    result = valid?
    @_skip_normalization = previous
    result
  end

  def self.normalize_value_for(attribute : String | Symbol, value : V) : V | ::Grant::Columns::Type forall V
    \{% for method in @type.methods %}
      \{% if (ann = method.annotation(::Grant::Normalization::Normalizer)) && !ann[:conditional] %}
        \{% column = @type.instance_vars.find { |v| v.name.stringify == ann[:attribute] } %}
        if attribute.to_s == \{{ ann[:attribute] }} && value.is_a?(\{{ column.type }})
          return __normalize_\{{ ann[:attribute].id }}(value)
        end
      \{% end %}
    \{% end %}
    value
  end
end
