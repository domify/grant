module grant/normalization

import std/text
import grant/value::{Value, Attributes}
import grant/validators::{Condition}
import grant/validation::{Context}

pub trait Normalizer
  abstract def normalize(value : Value) : Value
end

pub struct TrimLowercase
end

impl Normalizer for TrimLowercase
  def normalize(value : Value) : Value
    value.is_a?(String) ? value.strip.downcase : value
  end
end

pub struct DefaultIfNil
  @default : Value

  def initialize(@default : Value)
  end
end

impl Normalizer for DefaultIfNil
  def normalize(value : Value) : Value
    value.nil? ? @default : value
  end
end

struct Entry
  getter attribute : String
  getter normalizer : Normalizer
  getter apply_to_nil : Bool
  getter condition : Condition?
  getter invert : Bool

  def initialize(@attribute : String, @normalizer : Normalizer, @apply_to_nil : Bool, @condition : Condition? = nil, @invert : Bool = false)
  end
end

# Explicit shared coercion for assignments and equality query arguments.
# Hydration bypasses this plan, matching Grant/ActiveRecord behavior.
pub class Plan
  @entries : Array(Entry)

  def initialize
    @entries = [] of Entry
  end

  def add(attribute : String, normalizer : Normalizer, apply_to_nil : Bool = false, condition : Condition? = nil, invert : Bool = false) : Plan
    @entries << Entry.new(attribute, normalizer, apply_to_nil, condition, invert)
    self
  end

  def value_for(attribute : String, value : Value) : Value
    normalized = value
    @entries.each do |entry|
      if entry.condition.nil? && entry.attribute == attribute && (!normalized.nil? || entry.apply_to_nil)
        normalized = entry.normalizer.normalize(normalized)
      end
    end
    normalized
  end

  def apply(attributes : Attributes, context : Context = Context.new) : Attributes
    result = Attributes.new
    attributes.each { |attribute, value| result[attribute] = value_for(attribute, value) }
    @entries.each do |entry|
      if condition = entry.condition
        applies = condition.applies?(result, context)
        if (entry.invert ? !applies : applies) && result.has_key?(entry.attribute)
          value = result[entry.attribute]
          result[entry.attribute] = entry.normalizer.normalize(value) unless value.nil? && !entry.apply_to_nil
        end
      end
    end
    result
  end
end
