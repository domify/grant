module grant/validator_info

import grant/error

pub struct ValidatorInfo
  getter kind : Symbol
  getter attribute : String
  getter options : ::Grant::Error::Options
  getter contexts : Array(Symbol)
  def conditional? : Bool
    @conditional
  end

  def initialize(@kind : Symbol, @attribute : String, @options : ::Grant::Error::Options,
                 @contexts : Array(Symbol), @conditional : Bool = false)
  end

  def option(key : Symbol) : ::Grant::Error::Value
    @options[key]?
  end

  def required? : Bool
    @kind == :presence && !@conditional && @options[:allow_nil]? != true &&
      @options[:allow_blank]? != true
  end
end

pub annotation Info
end

pub macro declare(kind, field, **options)
  @[::Grant::ValidatorInfo::Info(kind: {{ kind }}, attribute: {{ field.id.stringify }},
    options: {{ options }})]
  def __validator_info_{{ kind.id }}_{{ field.id }}_{{ @type.methods.size }} : Nil
    nil
  end
end

pub macro model_methods(model)
  @@validator_infos : Array(::Grant::ValidatorInfo::ValidatorInfo)? = nil

  def self.validators : Array(::Grant::ValidatorInfo::ValidatorInfo)
    cached = @@validator_infos
    return cached.dup unless cached.nil?
    infos = [] of ::Grant::ValidatorInfo::ValidatorInfo
    \{% begin %}
    \{% for method in @type.methods %}
      \{% ann = method.annotation(::Grant::ValidatorInfo::Info) %}
      \{% if ann %}
        \{% pairs = [] of String %}
        \{% options = ann[:options] %}
        \{% for key, value in options %}
          \{% unless ["if", "unless", "on", "strict", "kind", "error_options"].includes?(key.stringify) || value.is_a?(ProcLiteral) || value.is_a?(ProcNotation) %}
            \{% plain = value.is_a?(NumberLiteral) || value.is_a?(StringLiteral) || value.is_a?(SymbolLiteral) || value.is_a?(BoolLiteral) || value.is_a?(NilLiteral) || value.is_a?(RegexLiteral) || value.is_a?(Path) %}
            \{% if value.is_a?(RangeLiteral) %}
              \{% plain = value.begin.is_a?(NumberLiteral) && value.end.is_a?(NumberLiteral) %}
            \{% elsif value.is_a?(ArrayLiteral) %}
              \{% plain = value.all? { |item| item.is_a?(NumberLiteral) || item.is_a?(StringLiteral) || item.is_a?(SymbolLiteral) || item.is_a?(BoolLiteral) } %}
            \{% end %}
            \{% pairs << "#{key.id}: #{plain ? value : value.stringify}" %}
          \{% end %}
        \{% end %}
        contexts = \{{ options[:on] || :save }}
        contexts = [contexts] unless contexts.is_a?(Array(Symbol))
        \{% if pairs.empty? %}
          info_options = ::Grant::Error::Options.new
        \{% else %}
          info_options = ::Grant::Error.options_from({ \{{ pairs.join(", ").id }} }).as(::Grant::Error::Options)
        \{% end %}
        infos << ::Grant::ValidatorInfo::ValidatorInfo.new(\{{ ann[:kind] }}, \{{ ann[:attribute] }},
          info_options, contexts, \{{ (options[:if] || options[:unless]) ? true : false }})
      \{% end %}
    \{% end %}
    \{% end %}
    @@validator_infos = infos
    infos.dup
  end

  def self.validators_on(*attributes : Symbol | String) : Array(::Grant::ValidatorInfo::ValidatorInfo)
    names = attributes.map(&.to_s).to_a
    validators.select { |info| names.includes?(info.attribute) }
  end
end
