module grant/connection_management

pub import grant/connection_registry
pub import grant/settings

pub annotation ConnectsTo
end

pub def registry_role(role : Symbol) : Symbol
  role = ::Grant::Settings.settings.writing_role if role == :primary
  ::Grant::ConnectionRegistry::ConnectionRegistry.normalize_role(role)
end

pub import std/time

# Shared model/database lag state, as upstream; no inherited class-variable
# initializer is needed for the registry.
pub class ReplicaLagTracker
  property last_write_time = ::Std::Time::Time.monotonic
  property sticky_until : ::Std::Time::Span? = nil
  property written : Bool = false
  property lag_threshold = ::Std::Time::Span.seconds(2_i64)

  def written? : Bool
    @written
  end

  def mark_write : Nil
    @last_write_time = ::Std::Time::Time.monotonic
    @written = true
    nil
  end

  def stick_to_primary(duration : ::Std::Time::Span) : Nil
    @sticky_until = ::Std::Time::Time.monotonic + duration
    nil
  end

  def can_use_replica?(wait_period : ::Std::Time::Span) : Bool
    now = ::Std::Time::Time.monotonic
    sticky = @sticky_until
    return false if !sticky.nil? && now < sticky
    !@written || now - @last_write_time > wait_period
  end
end

pub class ReplicaLagRegistry
  @@trackers = {} of String => ReplicaLagTracker

  def self.for(model : String, database : String) : ReplicaLagTracker
    key = "#{model}:#{database}"
    @@trackers[key] ||= ReplicaLagTracker.new
  end
end

# Native expansion of the upstream ConnectionManagement::ClassMethods slice.
pub macro model_methods(model)
  def self.connection_config : Hash(Symbol, String)
    @@own_connection_config ||= {} of Symbol => String
  end

  def self.connection_config=(config : Hash(Symbol, String)) : Nil
    @@own_connection_config = config
    nil
  end

  def self.connection_switch_wait_period : Int32
    ::Grant::Connections::Connections.connection_switch_wait_period
  end

  def self.connection_switch_wait_period=(value : Int32) : Nil
    ::Grant::Connections::Connections.connection_switch_wait_period = value
    nil
  end

  def self.mark_write_operation : Nil
    ::Grant::ConnectionManagement::ReplicaLagRegistry.for({{ model.stringify }}, @@connection_name).mark_write
  end

  def self.stick_to_primary(duration : ::Std::Time::Span = ::Std::Time::Span.seconds(5_i64)) : Nil
    ::Grant::ConnectionManagement::ReplicaLagRegistry.for({{ model.stringify }}, @@connection_name).stick_to_primary(duration)
  end

  def self.should_use_reader? : Bool
    return false unless connection_config.has_key?(::Grant::Settings.settings.reading_role)
    return false if ::Grant::Transaction.in_explicit_transaction?
    ::Grant::ConnectionManagement::ReplicaLagRegistry.for({{ model.stringify }}, @@connection_name).can_use_replica?(::Std::Time::Span.milliseconds(connection_switch_wait_period.to_i64))
  end
end
