module grant/error

import std/json
import std/text
import grant/i18n

pub alias Value = Bool | Int32 | Int64 | Float64 | String | Symbol | Array(String) | Range(Int32, Int32) | Range(Int64, Int64) | Nil
pub alias Options = Hash(Symbol, Value)

pub def value(item : T) : Value forall T
  if item.is_a?(Bool) || item.is_a?(Int32) || item.is_a?(Int64) ||
     item.is_a?(Float64) || item.is_a?(String) || item.is_a?(Symbol) ||
     item.is_a?(Nil) || item.is_a?(Array(String)) ||
     item.is_a?(Range(Int32, Int32)) || item.is_a?(Range(Int64, Int64))
    item
  elsif item.is_a?(Array)
    item.map { |entry| entry.to_s }
  else
    item.to_s
  end
end

pub def options_from(tuple : T) : Options? forall T
  return nil if tuple.size == 0
  result = Options.new
  tuple.each { |key, item| result[key] = value(item) }
  result
end

pub class ErrorBase
  getter message : String

  def initialize(@message : String)
  end
end

impl ::Error for ErrorBase
  def message : String
    @message
  end
end

# A model validation failure, distinct from returned runtime errors.
pub class Error
  getter field : String | Symbol
  property type : Symbol?

  @raw_message : String | Symbol
  @message : String? = nil
  @full_message : String? = nil
  @options : Options? = nil

  def initialize(@field : String | Symbol, message : String = "", @type : Symbol? = nil,
                 *, options : Options? = nil)
    @raw_message = message
    @options = options
  end

  def initialize(@field : String | Symbol, type : Symbol, *, message : String | Symbol | Nil = nil,
                 options : Options? = nil)
    @type = type
    @raw_message = message || type
    @options = options
  end

  def attribute : String
    @field.to_s
  end

  def raw_type : Symbol?
    @type
  end

  def options : Options
    stored = @options
    return stored unless stored.nil?
    stored = Options.new
    @options = stored
    stored
  end

  def options? : Bool
    stored = @options
    !stored.nil? && !stored.empty?
  end

  def detail : Options
    result = Options.new
    result[:error] = @type || :invalid
    stored = @options
    stored.each { |key, item| result[key] = item } unless stored.nil?
    result
  end

  def message=(text : String) : String
    @raw_message = text
    @message = nil
    @full_message = nil
    text
  end

  def message : String
    raw = @raw_message
    return raw if raw.is_a?(String)
    cached = @message
    return cached unless cached.nil?
    text = ::Grant::I18n.generate_message("", attribute, raw, @options)
    @message = text
    text
  end

  def full_message : String
    name = @field.to_s
    return message if name == "base"
    name = name[0, name.size - 3] if name.ends_with?("_id")
    name = name.gsub("_", " ")
    "#{name.capitalize} #{message}"
  end

  def to_s : String
    full_message
  end

  def to_json : String
    builder = ::Std::Json::Builder.new
    to_json(builder)
    builder.to_s
  end

  def to_json(builder : ::Std::Json::Builder) : Nil
    fields = {} of String => ::Std::Json::Any
    fields["field"] = ::Std::Json::Any.new(@field.to_s)
    fields["message"] = ::Std::Json::Any.new(message)
    ::Std::Json::Any.new(fields).to_json(builder)
    nil
  end
end


pub class ConversionError < Error
end

# Crystal's ArgumentError, returned where upstream raises it for invalid
# query input (unknown fields, mismatched placeholders, ...).
pub class ArgumentError < ErrorBase
end

impl ::Error for ArgumentError
  def message : String
    @message
  end
end
