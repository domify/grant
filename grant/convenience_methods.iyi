module grant/convenience_methods
pub import grant/timestamps
import grant/query/builder::{Builder}
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase}

pub trait ConvenienceMethods(Model)
  def annotate(comment : String) : self
    copy = chain_copy
    copy.annotation_comment = "/* #{comment.gsub("*/", "")} */"
    copy
  end

  def touch_all(*fields, time : ::Std::Time::Time = ::Grant::Timestamps.current_time) : Int64 | ErrorBase
    return 0_i64 if is_none?
    names = [] of String
    fields.each { |field| names << field.to_s }
    names.concat(Model.update_timestamp_columns)
    assignments = names.uniq.map { |name| {name, ::Grant::Timestamps.stamp(name, time, Model.timestamp_precision).as(Value)} }
    return 0_i64 if assignments.empty?
    update_all(assignments)
  end
end

impl ConvenienceMethods(Model) for Builder(Model) forall Model
end

pub macro model_methods(model)
  def self.pick(*fields) : Array(::Grant::Adapter::Driver::Value)? | ::Grant::Error::ErrorBase
    current_scope.pick(*fields)
  end

  def self.touch_all(*fields, time : ::Std::Time::Time = ::Grant::Timestamps.current_time) : Int64 | ::Grant::Error::ErrorBase
    current_scope.touch_all(*fields, time: time)
  end

  def self.in_batches(of batch_size : Int32 = 1000, start : ::Grant::Adapter::Driver::Value = nil, finish : ::Grant::Adapter::Driver::Value = nil, load : Bool = false, order : Symbol = :asc, &block : ::Grant::Query::Builder::Builder({{ model }}) -> T) : Nil | ::Grant::Error::ErrorBase forall T
    current_scope.in_batches(of: batch_size, start: start, finish: finish, load: load, order: order) { |batch| yield batch }
  end
end
