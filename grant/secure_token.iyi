module grant/secure_token

pub import grant/error
import grant/error::{ErrorBase}
import std/base64::{Base64}

@[Link("crypto")]
lib Crypto
  fun random = RAND_bytes(output : UInt8*, size : Int32) : Int32
end

pub def generate_secure_token(length : Int32 = 24, alphabet : Symbol = :base58) : String | ErrorBase
  case alphabet
  when :base58
    generate_base58_token(length)
  when :hex
    generate_hex_token(length)
  when :base64
    generate_base64_token(length)
  else
    ErrorBase.new("Unsupported alphabet: #{alphabet}")
  end
end

private def random_bytes(size : Int32) : String | ErrorBase
  success = false
  bytes = String.new(size) { |buffer| success = Crypto.random(buffer, size) == 1 }
  return ErrorBase.new("Secure random generation failed") unless success
  bytes
end

private def generate_base58_token(length : Int32) : String | ErrorBase
  alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
  token = ""
  while token.size < length
    bytes = random_bytes(length - token.size)!
    bytes.each_byte do |byte|
      # Rejection sampling preserves the uniform distribution of Secure.rand.
      token += alphabet[(byte % 58).to_i32].to_s if byte < 232
    end
  end
  token
end

private def generate_hex_token(length : Int32) : String | ErrorBase
  alphabet = "0123456789abcdef"
  bytes = random_bytes(length // 2)!
  token = ""
  bytes.each_byte do |byte|
    token += alphabet[(byte >> 4).to_i32].to_s
    token += alphabet[(byte & 15).to_i32].to_s
  end
  token
end

private def generate_base64_token(length : Int32) : String | ErrorBase
  bytes = random_bytes((length * 3 + 3) // 4)!
  Base64.urlsafe_encode(bytes)[0...length]
end

pub macro has_secure_token(name, length = 24, alphabet = :base58, on = :create)
  column {{ name.id }} : String?

  def assign_new_{{ name.id }} : String | ::Grant::Error::ErrorBase
    token = ::Grant::SecureToken.generate_secure_token(length: {{ length }}, alphabet: {{ alphabet }})!
    self.{{ name.id }} = token
    token
  end

  def regenerate_{{ name.id }} : Bool | ::Grant::Errors::RecordDestroyedError
    token = assign_new_{{ name.id }}
    return false if token.is_a?(::Error)
    save(validate: false)
  end

  def regenerate_{{ name.id }}_strict : Bool | ::Grant::Error::ErrorBase
    assign_new_{{ name.id }}!
    save_strict(validate: false)
  end

  {% if on == :initialize %}
    after_initialize :generate_{{ name.id }}_on_initialize
    private def generate_{{ name.id }}_on_initialize : Nil | ::Grant::Callbacks::Abort
      generate_{{ name.id }}_if_needed if new_record?
    end
  {% elsif on == :create %}
    before_create :generate_{{ name.id }}_if_needed
  {% else %}
    {% raise "has_secure_token on: must be :create or :initialize, got #{on}" %}
  {% end %}

  private def generate_{{ name.id }}_if_needed : Nil | ::Grant::Callbacks::Abort
    if self.{{ name.id }}.nil?
      result = assign_new_{{ name.id }}
      return abort_strict(result.message) if result.is_a?(::Error)
    end
    nil
  end
end
