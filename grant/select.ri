module grant/select

pub class Container
  property custom : String?
  getter table_name : String
  getter fields : Array(String)

  def initialize(@custom : String? = nil, @table_name : String = "", @fields : Array(String) = [] of String)
  end
end

pub macro select_statement(text)
  def self.custom_select_statement : String?
    {{ text }}.strip
  end

  def self.select : String?
    custom_select_statement
  end
end
