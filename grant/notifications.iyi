module grant/notifications

import grant/error::{ErrorBase}

pub class Subscription(T)
  getter handler : Proc(T, Nil | ErrorBase)

  def initialize(@handler : Proc(T, Nil | ErrorBase))
  end

  def unsubscribe : Nil
    T.remove_subscription(self)
  end
end

pub macro publishable(event_type)
  @@subscriptions = [] of ::Grant::Notifications::Subscription({{event_type}})

  def self.subscribed? : Bool
    !@@subscriptions.empty?
  end

  def self.add_subscription(subscription : ::Grant::Notifications::Subscription({{event_type}})) : Nil
    @@subscriptions = @@subscriptions + [subscription]
    nil
  end

  def self.remove_subscription(subscription : ::Grant::Notifications::Subscription({{event_type}})) : Nil
    @@subscriptions = @@subscriptions.reject { |entry| entry.object_id == subscription.object_id }
    nil
  end

  def self.publish(event : self) : Nil
    # Iterate the immutable snapshot; returned observer errors cannot fail SQL.
    @@subscriptions.each { |subscription| subscription.handler.call(event) }
    nil
  end
end

pub def subscribe(event_type : T.class, &handler : T -> Nil | ErrorBase) : Subscription(T) forall T
  subscription = Subscription(T).new(handler)
  event_type.add_subscription(subscription)
  subscription
end

pub def subscribed(event_type : T.class, handler : Proc(T, H), &block : -> R) : R forall T, H, R
  subscription = subscribe(event_type) { |event| handler.call(event) }
  result = yield
  subscription.unsubscribe
  result
end

pub def subscribed?(event_type : T.class) : Bool forall T
  event_type.subscribed?
end

pub def instrument(event_type : T.class, &block : -> T) : Nil forall T
  return unless event_type.subscribed?
  event_type.publish(yield)
end
