module grant/encryption

pub import grant/encryption/config
pub import grant/encryption/context
pub import grant/encryption/sealed
pub import grant/encryption/encrypted_attribute
pub import grant/encryption/serializer
pub import grant/encryption/query_extensions

pub def configured? : Bool
  ::Grant::Encryption::Config::Config.configured?
end

pub def configure(&block : ::Grant::Encryption::Config::Config.class -> T) : T forall T
  yield ::Grant::Encryption::Config::Config
end

pub def current_context : ::Grant::Encryption::Context::Context
  ::Grant::Encryption::Context.current_context
end

pub def encryption_enabled? : Bool
  ::Grant::Encryption::Context.encryption_enabled?
end

pub def without_encryption(&block : -> T) : T forall T
  ::Grant::Encryption::Context.without_encryption { yield }
end

pub def protecting_encrypted_data(&block : -> T) : T forall T
  ::Grant::Encryption::Context.protecting_encrypted_data { yield }
end

# Typed declaration slice of Encryption::Model. Converter method bodies are
# deferred just like Base's column introspection. Persistence instantiates the
# encrypted-attribute codec; it must never fall back to ordinary plaintext SQL.
pub def decrypt(encrypted : String?, model_name : String, attribute_name : String) : String? | ::Grant::Error::ErrorBase
  return nil if encrypted.nil? || encrypted.empty?
  ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute.new(model_name, attribute_name, false, attribute_name).open(encrypted)
end

pub macro typed_attribute(model, attribute, deterministic, downcase, ignore_case, compress, compress_threshold, previous, support_unencrypted_data, lazy)
  {% if !attribute.is_a?(TypeDeclaration) %}
    ::Grant::Encryption.legacy_attribute({{model}}, {{attribute}}, {{deterministic}}, {{downcase}}, {{compress}}, {{compress_threshold}}, {{support_unencrypted_data}})
  {% else %}
  {% attr = attribute.var.id %}
  {% attr_name = attr.stringify %}
  {% base = attribute.type %}
  {% if ignore_case && !deterministic %}
    {% raise "encrypts #{attr_name}: ignore_case: true requires deterministic: true" %}
  {% end %}
  {% if (downcase || ignore_case) && base.resolve != String %}
    {% raise "encrypts #{attr_name}: downcase: and ignore_case: apply to String attributes only" %}
  {% end %}
  {% if lazy && base.resolve != String %}
    {% raise "encrypts #{attr_name}: lazy: true applies to String attributes only; other types are decrypted when the row loads" %}
  {% end %}

  {{("ENCRYPTED_ATTRIBUTE_" + attr_name.upcase).id}} = ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute.new({{model.stringify}}, {{attr_name}}, {{deterministic}}, {{attr_name}}, {{downcase}}, {{ignore_case}}, {{compress}}, {{compress_threshold}}, {{support_unencrypted_data}})
  def self.{{attr}}_encrypted_attribute : ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute
    attribute = {{("ENCRYPTED_ATTRIBUTE_" + attr_name.upcase).id}}
    ::Grant::Encryption::EncryptedAttribute::EncryptedAttributeRegistry.register({{model.stringify}}, {{attr_name}}, attribute)
    attribute
  end

  column {{attr}} : {{base}}?, converter: {{attr_name.camelcase.id}}EncryptionConverter, column_type: "TEXT", encrypted: true, guarded: {{lazy == true}}, lazy: {{lazy == true}}, original: {{ignore_case ? "original_" + attr_name : nil}}, downcase: {{downcase}}

  class {{attr_name.camelcase.id}}EncryptionConverter
    def self.to_db(value : {{base}}?)
      return nil if value.nil?
      {% if lazy == true %}
        return ::Grant::Encryption::Sealed.stored(value) if ::Grant::Encryption::Sealed.sealed?(value)
      {% end %}
      \{% begin %}
      {{model}}.{{attr}}_encrypted_attribute.seal(::Grant::Encryption::Serializer.dump(value))
      \{% end %}
    end

    # Native rows carry SQLite values rather than a DB::ResultSet cursor.
    def self.from_db(stored : String?) : {{base}}? | ::Grant::Error::ErrorBase
      return nil if stored.nil?
      {% if base.resolve != String %}
        if ::Grant::Encryption::Context.current_context.encryption_disabled?
          return ::Grant::Encryption::Context::UnsupportedTypeError.new({{model.stringify}} + "." + {{attr_name}} + " is a " + {{base.stringify}} + " and cannot be read raw inside without_encryption")
        end
      {% end %}
      \{% begin %}
      plain = {{model}}.{{attr}}_encrypted_attribute.open(stored)!
      ::Grant::Encryption::Serializer.load(plain, {{base}})
      \{% end %}
    end
  end

  {% if deterministic %}
    def self.where_{{attr}}(value : {{base}}) : ::Grant::Query::Builder::Builder({{model}})
      where({{attr}}: value)
    end
    def self.find_by_{{attr}}(value : {{base}}) : {{model}}? | ::Grant::Error::ErrorBase
      where_{{attr}}(value).first
    end
  {% end %}

  {% if ignore_case %}
    encrypts {{("original_" + attr_name).id}} : String, lazy: {{lazy}}
  {% end %}
  {% end %}
end

pub class LegacyStorage
  def self.to_db(value : String?) : String?
    value
  end
  def self.from_db(value : String?) : String?
    value
  end
end

pub macro legacy_attribute(model, attribute, deterministic, downcase, compress, compress_threshold, support_unencrypted_data)
  {% attr = attribute.id %}
  {% name = attr.stringify %}
  column {{attr}}_encrypted : String?, encrypted: true, converter: ::Grant::Encryption::LegacyStorage
  {{("ENCRYPTED_ATTRIBUTE_" + name.upcase).id}} = ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute.new({{model.stringify}}, {{name}}, {{deterministic}}, {{name + "_encrypted"}}, {{downcase}}, false, {{compress}}, {{compress_threshold}}, {{support_unencrypted_data}})

  def self.{{attr}}_encrypted_attribute : ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute
    attribute = {{("ENCRYPTED_ATTRIBUTE_" + name.upcase).id}}
    ::Grant::Encryption::EncryptedAttribute::EncryptedAttributeRegistry.register({{model.stringify}}, {{name}}, attribute)
    attribute
  end

  def self.{{attr}}_encrypted_encrypted_attribute : ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute
    {{attr}}_encrypted_attribute
  end

  @[::Grant::Attributes::AttributeAlias(name: {{name}}, column: {{name}})]
  def {{attr}} : String? | ::Grant::Error::ErrorBase
    stored = @{{attr}}_encrypted
    stored.nil? ? nil : self.class.{{attr}}_encrypted_attribute.open(stored)
  end

  def {{attr}}=(value : String?) : Nil | ::Grant::Error::ErrorBase
    @{{attr}}_encrypted = value.nil? ? nil : self.class.{{attr}}_encrypted_attribute.seal(value)!
    nil
  end
  {% if deterministic %}
    def self.where_{{attr}}(value : String) : ::Grant::Query::Builder::Builder({{model}})
      where({{attr}}: value)
    end
    def self.find_by_{{attr}}(value : String) : {{model}}? | ::Grant::Error::ErrorBase
      where_{{attr}}(value).first
    end
  {% end %}

end

pub macro model_methods(model)
  ::Grant::Encryption::QueryExtensions.model_methods({{model}})

  def self.encrypted_attributes : Hash(String, ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute)
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:encrypted] } %}
      self.\{{v.name}}_encrypted_attribute
    \{% end %}
    ::Grant::Encryption::EncryptedAttribute::EncryptedAttributeRegistry.for(self.to_s)
  end

  {% if model.resolve.constants.any? { |name| name.stringify.starts_with?("ENCRYPTED_ATTRIBUTE_") } %}
    def inspect : String
      values = [] of String
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
        \{% if v.annotation(::Grant::Base::Column)[:encrypted] %}
          values << \{{v.name.stringify}} + ": [FILTERED]"
        \{% else %}
          values << \{{v.name.stringify}} + ": " + @\{{v.name}}.inspect
        \{% end %}
      \{% end %}
      "#<#{self.class} #{values.join(", ")}>"
    end
  {% end %}

  def self.encrypted_query_attribute(field : String) : ::Grant::Encryption::EncryptedAttribute::EncryptedAttribute?
    encrypted_attributes
    ::Grant::Encryption::EncryptedAttribute::EncryptedAttributeRegistry.lookup(self.to_s, field)
  end
end
