module grant/associations

pub import grant/association_collection
import grant/dependent
import grant/association_options
import grant/autosave
import grant/polymorphic

pub annotation Relationship
end

pub macro has_many(model, scope = nil, **options)
  {% method_name = model.id %}
  {% class_name = options[:class_name] %}
  {% foreign_key = options[:foreign_key] %}
  {% primary_key = options[:primary_key] || "id" %}
  @[::Grant::Associations::Relationship(target: {{ class_name }}, through: {{ options[:through] }}, type: :has_many,
    primary_key: {{ primary_key.id }}, foreign_key: {{ foreign_key.id }},
    owner_primary_key: {{ primary_key.id }}, scope: {{ scope }})]
  def {{ method_name }} : ::Grant::AssociationCollection::AssociationCollection(self, {{ class_name }})
    loaded = get_loaded_association({{ method_name.stringify }})
    records = loaded.nil? ? nil : loaded.map { |record| record.as({{ class_name }}) }
    {% if scope %}
      {% if scope.args.empty? %}
        scope_proc = ->(q : ::Grant::Query::Builder::Builder({{ class_name }})) { q.{{ scope.body }} }
      {% else %}
        scope_proc = {{ scope }}
      {% end %}
    {% else %}
      scope_proc = nil
    {% end %}
    {% if options[:through] %}
      through_condition = ::Grant::Associations.through_condition({{ options[:owner_type] }}, {{ options[:through].id.stringify }}, {{ class_name }})
      through_relation = ->(q : ::Grant::Query::Builder::Builder({{ class_name }})) {
        q.where(through_condition, read_attribute({{ primary_key.id.stringify }}).or_panic)
      }
    {% else %}
      through_relation = nil
      through_condition = nil
    {% end %}
    ::Grant::AssociationCollection::AssociationCollection(self, {{ class_name }}).new(
      self, {{ foreign_key.id.stringify }}, primary_key: {{ options[:primary_key] ? primary_key.id.stringify : nil }},
      inverse_of: {{ options[:inverse_of] ? options[:inverse_of].id.stringify : nil }},
      through_condition: through_condition, relation_scope: through_relation, scope: scope_proc, association_name: {{ method_name.stringify }}, loaded_records: records)
  end
  {% if options[:dependent] == :delete_all %}
    ::Grant::Dependent.setup_dependent_delete_all({{ method_name }}, :has_many, {{ class_name }}, {{ foreign_key.id.stringify }}, {{ primary_key.id.stringify }})
  {% end %}

end

pub macro belongs_to(model, scope = nil, **options)
  {% if options[:polymorphic] %}
    ::Grant::Polymorphic.belongs_to_polymorphic({{ model }}, {% for key, value in options %}{{ key.id }}: {{ value }}, {% end %})
  {% else %}
  {% if model.is_a?(TypeDeclaration) %}
    {% method_name = model.var %}
    {% class_name = model.type %}
  {% else %}
    {% method_name = model.id %}
    {% class_name = options[:class_name] || model.id.camelcase %}
  {% end %}
  {% if options[:foreign_key].is_a?(TypeDeclaration) %}
    {% foreign_key = options[:foreign_key].var %}
    column {{ options[:foreign_key] }}
  {% elsif options[:foreign_key] %}
    {% foreign_key = options[:foreign_key].id %}
  {% else %}
    {% foreign_key = (method_name.stringify + "_id").id %}
    column {{ foreign_key }} : Int64?
  {% end %}
  {% primary_key = options[:primary_key] || "id" %}
  @[::Grant::Associations::Relationship(target: {{ class_name }}, type: :belongs_to,
    primary_key: {{ primary_key.id }}, foreign_key: {{ foreign_key.id }}, scope: {{ scope }})]
  def {{ method_name }} : {{ class_name }} | Nil | ::Grant::Error::ErrorBase
    loaded = get_loaded_association({{ method_name.stringify }})
    return loaded.first?.as({{ class_name }}?) unless loaded.nil?
    {{ class_name }}.where({{ primary_key.id.stringify }}, :eq, {{ foreign_key }}).first
  end

  def {{ method_name }}_strict : {{ class_name }} | ::Grant::Error::ErrorBase
    result = {{ method_name }}!
    return result unless result.nil?
    key = {{ foreign_key }}
    text = key.nil? ? "NULL" : key.to_s
    ::Grant::Querying::NotFound.new("No " + {{ class_name }}.to_s + " found where " + {{ primary_key.id.stringify }} + " is #{text}")
  end

  def {{ method_name }}=(parent : {{ class_name }}?) : Nil
    key = parent.nil? ? nil : parent.{{ primary_key.id }}
    self.{{ foreign_key }} = key
    records = [] of {{ class_name }}
    records << parent unless parent.nil?
    set_loaded_association({{ method_name.stringify }}, records)
  end
  def {{ method_name }}_changed? : Bool
    return true if {{ foreign_key }}_changed?
    loaded = get_loaded_association({{ method_name.stringify }})
    parent = loaded.nil? ? nil : loaded.first?
    !parent.nil? && parent.new_record?
  end

  def {{ method_name }}_previously_changed? : Bool
    saved_change_to_attribute?({{ foreign_key.id.stringify }})
  end

  ::Grant::AssociationOptions.setup_optional_validation({{ method_name }}, {{ foreign_key }}, {{ class_name }}, {{ primary_key }}, {{ options[:optional] }})
  {% if options[:default] %}
    def __association_default_{{ method_name }} : Nil | ::Grant::Error::ErrorBase
      if new_record? && {{ foreign_key }}.nil?
        parent = ({{ options[:default] }}).call(self)!
        self.{{ method_name }} = parent unless parent.nil?
      end
      nil
    end
  {% end %}
  ::Grant::Autosave.setup_belongs_to({{ method_name }}, {{ class_name }}, {{ foreign_key }}, {{ primary_key }}, {{ options[:autosave] }})
  {% end %}

end

pub macro has_one(model, scope = nil, **options)
  {% if model.is_a?(TypeDeclaration) %}
    {% method_name = model.var %}
    {% class_name = model.type %}
  {% else %}
    {% method_name = model.id %}
    {% class_name = options[:class_name] || model.id.camelcase %}
  {% end %}
  {% foreign_key = options[:foreign_key] || @type.stringify.split("::").last.underscore + "_id" %}
  {% primary_key = options[:primary_key] || "id" %}
  {% if options[:through] %}
    ::Grant::Associations.has_one_through({{ method_name }}, {{ class_name }}, {{ foreign_key }}, {{ primary_key }}, {{ options[:through] }}, {{ options[:source] }})
  {% else %}
  @[::Grant::Associations::Relationship(target: {{ class_name }}, type: :has_one,
    primary_key: {{ primary_key.id }}, foreign_key: {{ foreign_key.id }}, scope: {{ scope }})]
  def {{ method_name }} : {{ class_name }} | Nil | ::Grant::Error::ErrorBase
    loaded = get_loaded_association({{ method_name.stringify }})
    return loaded.first?.as({{ class_name }}?) unless loaded.nil?
    key = read_attribute({{ primary_key.id.stringify }})!
    result = {{ class_name }}.where({{ foreign_key.id.stringify }}, :eq, key).first!
    records = [] of {{ class_name }}
    records << result unless result.nil?
    set_loaded_association({{ method_name.stringify }}, records)
    result
  end

  def {{ method_name }}_strict : {{ class_name }} | ::Grant::Error::ErrorBase
    was_loaded = association_loaded?({{ method_name.stringify }})
    result = {{ method_name }}!
    return result unless result.nil?
    return ::Grant::Querying::NotFound.new("No " + {{ class_name }}.to_s + " found") if was_loaded
    key = read_attribute({{ primary_key.id.stringify }})!
    ::Grant::Querying::NotFound.new("No " + {{ class_name }}.to_s + " found where " + {{ foreign_key.id.stringify }} + " = #{key}")
  end

  def {{ method_name }}=(child : {{ class_name }}?) : {{ class_name }} | Nil | ::Grant::Error::ErrorBase
    key = read_attribute({{ primary_key.id.stringify }})!
    if persisted?
      current = {{ method_name }}!
      outcome = self.class.transaction do
        if !current.nil? && (child.nil? || current.__primary_value != child.__primary_value)
          current.assign_attributes({ {{ foreign_key.id.stringify }} => nil })
          current.save_strict!
        end
        unless child.nil?
          child.assign_attributes({ {{ foreign_key.id.stringify }} => key })
          child.save_strict!
        end
        nil
      end
      outcome!
    end
    records = [] of {{ class_name }}
    unless child.nil?
      child.assign_attributes({ {{ foreign_key.id.stringify }} => key })
      records << child
    end
    set_loaded_association({{ method_name.stringify }}, records)
    child
  end
  {% if options[:dependent] == :delete %}
    ::Grant::Dependent.setup_dependent_delete_all({{ method_name }}, :has_one, {{ class_name }}, {{ foreign_key.id.stringify }}, {{ primary_key.id.stringify }})
  {% end %}
  {% end %}

end

pub macro belongs_to(model, scope = nil, **options)
  {% if model.is_a?(TypeDeclaration) %}
    {% method_name = model.var %}
    {% class_name = model.type %}
  {% else %}
    {% method_name = model.id %}
    {% class_name = options[:class_name] || model.id.camelcase %}
  {% end %}
  {% if options[:foreign_key].is_a?(TypeDeclaration) %}
    {% foreign_key = options[:foreign_key].var %}
    column {{ options[:foreign_key] }}
  {% elsif options[:foreign_key] %}
    {% foreign_key = options[:foreign_key].id %}
  {% else %}
    {% foreign_key = (method_name.stringify + "_id").id %}
    column {{ foreign_key }} : Int64?
  {% end %}
  {% primary_key = options[:primary_key] || "id" %}
  @[::Grant::Associations::Relationship(target: {{ class_name }}, type: :belongs_to,
    primary_key: {{ primary_key.id }}, foreign_key: {{ foreign_key.id }}, scope: {{ scope }})]
  def {{ method_name }} : {{ class_name }} | Nil | ::Grant::Error::ErrorBase
    loaded = get_loaded_association({{ method_name.stringify }})
    return loaded.first?.as({{ class_name }}?) unless loaded.nil?
    {{ class_name }}.where({{ primary_key.id.stringify }}, :eq, {{ foreign_key }}).first
  end

  def {{ method_name }}_strict : {{ class_name }} | ::Grant::Error::ErrorBase
    result = {{ method_name }}!
    return result unless result.nil?
    key = {{ foreign_key }}
    text = key.nil? ? "NULL" : key.to_s
    ::Grant::Querying::NotFound.new("No " + {{ class_name }}.to_s + " found where " + {{ primary_key.id.stringify }} + " is #{text}")
  end

  def {{ method_name }}=(parent : {{ class_name }}?) : Nil
    key = parent.nil? ? nil : parent.{{ primary_key.id }}
    self.{{ foreign_key }} = key
    records = [] of {{ class_name }}
    records << parent unless parent.nil?
    set_loaded_association({{ method_name.stringify }}, records)
  end
end

pub macro model_methods(model)
  def __association_defaults : Nil | ::Grant::Error::ErrorBase
    \{% for method in @type.methods.select { |m| m.name.starts_with?("__association_default_") } %}
      \{{ method.name }}!
    \{% end %}
    nil
  end

  def __association_validations : Nil | ::Grant::Error::ErrorBase
    \{% for method in @type.methods.select { |m| m.name.starts_with?("__association_validate_") } %}
      \{{ method.name }}!
    \{% end %}
    nil
  end

  def __association_before_save : Nil | ::Grant::Error::ErrorBase
    \{% for method in @type.methods.select { |m| m.name.starts_with?("_autosave_before_save_") } %}
      \{{ method.name }}!
    \{% end %}
    nil
  end

  @__loaded_associations = {} of String => Array(::Grant::Base::Base)

  def set_loaded_association(name : String, records : Array(T)) : Nil forall T
    @__loaded_associations[name] = records.map { |record| record.as(::Grant::Base::Base) }
    nil
  end

  def get_loaded_association(name : String) : Array(::Grant::Base::Base)?
    @__loaded_associations[name]?
  end

  def association_loaded?(name : String | Symbol) : Bool
    @__loaded_associations.has_key?(name.to_s)
  end
end

pub macro through_condition(owner_type, through_name, target)
  {% through_method = owner_type.resolve.methods.find { |m| m.name.stringify == through_name && m.annotation(::Grant::Associations::Relationship) } %}
  {% metadata = through_method.annotation(::Grant::Associations::Relationship) %}
  {% namespace = owner_type.stringify.split("::")[0...-1].join("::") %}
  {% join_model = parse_type(namespace + "::" + metadata[:target].stringify).resolve %}
  {% source = join_model.methods.find { |m| m.annotation(::Grant::Associations::Relationship) && m.annotation(::Grant::Associations::Relationship)[:target].stringify == target.stringify } %}
  {% source_metadata = source.annotation(::Grant::Associations::Relationship) %}
  %join_table = {{ join_model }}.quote({{ join_model }}.table_name)
  %source_key = {{ join_model }}.quote({{ source_metadata[:foreign_key].id.stringify }})
  %owner_key = {{ join_model }}.quote({{ metadata[:foreign_key].id.stringify }})
  %target_key = {{ target }}.quote({{ source_metadata[:primary_key].id.stringify }})
  "#{%target_key} IN (SELECT #{%source_key} FROM #{%join_table} WHERE #{%owner_key} = ?)"
end

# The legacy table-name has_one :through reader from upstream associations.cr.
pub macro has_one_through(name, target, foreign_key, primary_key, through, source)
  @[::Grant::Associations::Relationship(target: {{ target }}, type: :has_one,
    primary_key: {{ primary_key.id }}, foreign_key: {{ foreign_key.id }},
    through: {{ through.id }}, source: {{ source || name }})]
  def {{ name }} : {{ target }} | Nil | ::Grant::Error::ErrorBase
    loaded = get_loaded_association({{ name.id.stringify }})
    return loaded.first?.as({{ target }}?) unless loaded.nil?
    join_key = {% if source %}
      {{ source.id.stringify }} + "_id"
    {% else %}
      {{ primary_key.id.stringify }} == "id" ? {{ target.stringify.split("::").last.underscore + "_id" }} : {{ primary_key.id.stringify }}
    {% end %}
    table = {{ target }}.quote({{ target }}.table_name)
    join_table = {{ target }}.quote({{ through.id.stringify }})
    source_key = {{ target }}.quote(join_key)
    target_key = {{ target }}.quote({{ target }}.primary_name)
    owner_key = {{ target }}.quote({{ foreign_key.id.stringify }})
    value = read_attribute({{ primary_key.id.stringify }})!
    sql = "SELECT #{table}.* FROM #{table} JOIN #{join_table} ON #{join_table}.#{source_key} = #{table}.#{target_key} WHERE #{join_table}.#{owner_key} = ? LIMIT 1"
    {{ target }}.find_by_sql(sql, [value] of ::Grant::Adapter::Driver::Value)!.first?
  end

  def {{ name }}_strict : {{ target }} | ::Grant::Error::ErrorBase
    record = {{ name }}!
    return record unless record.nil?
    ::Grant::Querying::NotFound.new("No " + {{ target }}.to_s + " found through " + {{ through.id.stringify }} + " for #{self.class}")
  end
end
