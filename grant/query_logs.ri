module grant/query_logs

import std/text

@@enabled : Bool = false
@@contexts = {} of UInt64 => Hash(String, String)

pub def enabled? : Bool
  @@enabled
end

pub def enabled=(value : Bool) : Bool
  @@enabled = value
end

pub def with_context(**values, &block : -> T) : T forall T
  fiber = IyiScheduler.current.object_id
  previous = @@contexts[fiber]?
  merged = {} of String => String
  previous.each { |key, value| merged[key] = value } unless previous.nil?
  values.each { |key, value| merged[key.to_s] = value.to_s }
  @@contexts[fiber] = merged
  defer restore_context(fiber, previous)
  yield
end

private def restore_context(fiber : UInt64, previous : Hash(String, String)?) : Nil
  if previous.nil?
    @@contexts.delete(fiber)
  else
    @@contexts[fiber] = previous
  end
  nil
end

pub def context : Hash(String, String)
  @@contexts[IyiScheduler.current.object_id]? || ({} of String => String)
end

pub def escape(text : String) : String
  text.gsub("*/", "* /").gsub("/*", "/ *").gsub("\0", "")
end

pub def comment : String?
  return nil unless enabled?
  pairs = context
  return nil if pairs.empty?
  parts = [] of String
  pairs.each { |key, value| parts << "#{escape(key)}:#{escape(value)}" }
  body = parts.join(",")
  body += " " if body.ends_with?("/")
  "/*#{body}*/"
end

pub def append(sql : String) : String
  suffix = comment
  return sql if suffix.nil? || sql.ends_with?(suffix)
  "#{sql} #{suffix}"
end
