module grant/association_options

# Required belongs_to validation, including a new parent assigned for autosave.
pub macro setup_optional_validation(name, foreign_key, target, primary_key, optional)
  {% unless optional %}
    def __association_validate_{{ name }} : Nil | ::Grant::Error::ErrorBase
      key = read_attribute({{ foreign_key.id.stringify }})!
      loaded = get_loaded_association({{ name.id.stringify }})
      parent = loaded.nil? ? nil : loaded.first?
      exists = if key.nil?
        !parent.nil? && parent.new_record?
      else
        {{ target }}.where({{ primary_key.id.stringify }}, :eq, key).exists?!
      end
      errors.add(:base, {{ name.id.stringify }} + " must exist") unless exists
      nil
    end
  {% end %}
end
