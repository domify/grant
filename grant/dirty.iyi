module grant/dirty

import std/uuid::{UUID}
import std/slice::{Bytes}
import std/time::{Time}
import grant/columns::{Type}

pub alias DirtyValue = Type | UUID | Bytes | Array(String) | Array(Int16) | Array(Int32) | Array(Int64) | Array(Float32) | Array(Float64) | Array(Bool) | Array(UUID) | Array(Time)

pub def snapshot(value : T) : T forall T
  value.is_a?(Array) ? value.dup : value
end

# Upstream's marker distinguishes an omitted filter from an explicit nil.
pub struct Unfiltered
end
pub UNFILTERED = Unfiltered.new

# Scalar pre-save predicates share the column baselines already captured by
# Base on construction, hydration, successful persistence and rollback.
pub annotation MutationDetection
end

pub macro detect_mutation(*names)
  @[::Grant::Dirty::MutationDetection(names: [{% for name in names %}{{ name.id.stringify }}, {% end %}] of String)]
  def __detect_mutation_{{ @type.methods.size }} : Nil
    nil
  end
end

pub macro model_methods(model)
  def self.mutation_detected_attributes : Array(String)
    \{% begin %}
    names = [] of String
    \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      \{% if column.annotation(::Grant::Base::Column)[:type].includes?("Array(") %}
        names << \{{ column.name.stringify }}
      \{% end %}
    \{% end %}
    \{% declarations = @type.methods.select { |m| m.annotation(::Grant::Dirty::MutationDetection) } %}
    \{% for method in @type.methods %}
      \{% if store = method.annotation(::Grant::SerializedColumn::Storage) %}
        \{% if declarations.any? { |d| d.annotation(::Grant::Dirty::MutationDetection)[:names].empty? || d.annotation(::Grant::Dirty::MutationDetection)[:names].includes?(store[:name]) || d.annotation(::Grant::Dirty::MutationDetection)[:names].includes?("_serialized_#{store[:name].id}") } %}
          names << \{{ "_serialized_#{store[:name].id}" }}
        \{% end %}
      \{% end %}
    \{% end %}
    names
    \{% end %}
  end

  def __refresh_mutation_tracking : Nil
    \{% begin %}
    \{% declarations = @type.methods.select { |m| m.annotation(::Grant::Dirty::MutationDetection) } %}
    \{% for method in @type.methods %}
      \{% if store = method.annotation(::Grant::SerializedColumn::Storage) %}
        \{% if declarations.any? { |d| d.annotation(::Grant::Dirty::MutationDetection)[:names].empty? || d.annotation(::Grant::Dirty::MutationDetection)[:names].includes?(store[:name]) || d.annotation(::Grant::Dirty::MutationDetection)[:names].includes?("_serialized_#{store[:name].id}") } %}
          _serialize_\{{ store[:name].id }}
        \{% end %}
      \{% end %}
    \{% end %}
    nil
    \{% end %}
  end

  @__forced_dirty_columns = [] of String

  def __forced_dirty_attribute?(name : String) : Bool
    @__forced_dirty_columns.includes?(name)
  end

  def attribute_changed?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    will_save_change_to_attribute?(name, from: from, to: to)
  end

  def attribute_will_change_in_place(name : String | Symbol) : Nil
    key = name.to_s
    @__forced_dirty_columns << key unless @__forced_dirty_columns.includes?(key)
    nil
  end

  def restore_attribute_in_place(name : String | Symbol) : Nil
    restore_attributes([name.to_s])
  end

  def clear_attribute_changes(names : Array(String)? = nil) : Nil
    clear_dirty_tracking_for(names || changed)
  end

  def clear_changes_information : Nil
    establish_initial_dirty_baseline
    @__forced_dirty_columns.clear
    clear_previous_changes
  end

  def changes_applied : Nil
    __capture_saved_changes
    establish_initial_dirty_baseline
    @__forced_dirty_columns.clear
    nil
  end

  {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %}
    {% name = method.name[6..-1] %}
    def restore_{{ name.id }}_in_place : Nil
      restore_attribute_in_place({{ name.stringify }})
    end

    def {{ name.id }}_will_change_in_place : Nil
      attribute_will_change_in_place({{ name.stringify }})
    end
  {% end %}

  def clear_dirty_tracking_for(names : Array(String)) : Nil
    \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      if names.includes?(\{{ column.name.stringify }})
        @__persisted_\{{ column.name }} = ::Grant::Dirty.snapshot(@\{{ column.name }})
        @__forced_dirty_columns.delete(\{{ column.name.stringify }})
      end
    \{% end %}
    nil
  end

  alias SavedValue = ::Grant::Dirty::DirtyValue {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %} | {{method.return_type}}{% end %}
  @previous_changes = {} of String => Tuple(SavedValue, SavedValue)

  def changes : Hash(String, Tuple(SavedValue, SavedValue))
    pending = {} of String => Tuple(SavedValue, SavedValue)
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      if \{{ v.name }}_changed?
        pending[\{{ v.name.stringify }}] = {@__persisted_\{{ v.name }}, @\{{ v.name }}}
      end
    \{% end %}
    pending
  end

  def changes_to_save : Hash(String, Tuple(SavedValue, SavedValue))
    changes
  end

  def changed_attribute_names_to_save : Array(String)
    changed
  end

  def attribute_change_to_be_saved(name : String | Symbol) : Tuple(SavedValue, SavedValue)?
    changes[name.to_s]?
  end

  def attributes_in_database : Hash(String, SavedValue)
    result = {} of String => SavedValue
    changes.each { |name, change| result[name] = change[0] }
    result
  end

  def attribute_in_database(name : String | Symbol) : SavedValue
    if change = attribute_change_to_be_saved(name)
      change[0]
    else
      read_attribute(name.to_s).as(SavedValue)
    end
  end

  {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %}
    {% name = method.name[6..-1] %}
    def {{ name.id }}_in_database : {{ method.return_type }}?
      attribute_in_database({{ name.stringify }}).as({{ method.return_type }}?)
    end

    def {{ name.id }}_change_to_be_saved : Tuple({{ method.return_type }}?, {{ method.return_type }}?)?
      if change = attribute_change_to_be_saved({{ name.stringify }})
        {change[0].as({{ method.return_type }}?), change[1].as({{ method.return_type }}?)}
      end
    end
  {% end %}

  def saved_changes : Hash(String, Tuple(SavedValue, SavedValue))
    previous_changes
  end

  def restore_attributes(names : Array(String) = changed) : Nil
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      if names.includes?(\{{ v.name.stringify }})
        @\{{ v.name }} = ::Grant::Dirty.snapshot(@__persisted_\{{ v.name }})
        @__forced_dirty_columns.delete(\{{ v.name.stringify }})
      end
    \{% end %}
    nil
  end

  {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %}
    {% name = method.name[6..-1] %}
    def {{ name.id }}_was : {{ method.return_type }}?
      {{ name.id }}_in_database
    end

    def {{ name.id }}_change : Tuple({{ method.return_type }}?, {{ method.return_type }}?)?
      {{ name.id }}_change_to_be_saved
    end

    def {{ name.id }}_before_last_save : {{ method.return_type }}?
      {{ name.id }}_previously_was
    end
  {% end %}

  def clear_previous_changes : Nil
    @previous_changes = {} of String => Tuple(SavedValue, SavedValue)
    nil
  end

  def previous_changes : Hash(String, Tuple(SavedValue, SavedValue))
    @previous_changes
  end

  def saved_change_to_attribute(name : String | Symbol) : Tuple(SavedValue, SavedValue)?
    @previous_changes[name.to_s]?
  end

  def saved_change_to_attribute?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    change = saved_change_to_attribute(name)
    return false if change.nil?
    (from.is_a?(::Grant::Dirty::Unfiltered) || change[0] == from) &&
      (to.is_a?(::Grant::Dirty::Unfiltered) || change[1] == to)
  end

  def attribute_previously_changed?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    saved_change_to_attribute?(name, from: from, to: to)
  end

  def attribute_previously_was(name : String | Symbol) : SavedValue
    if change = saved_change_to_attribute(name)
      change[0]
    else
      read_attribute(name.to_s).as(SavedValue)
    end
  end

  {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %}
    {% name = method.name[6..-1] %}
    def saved_change_to_{{ name.id }}?(*, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
      saved_change_to_attribute?({{ name.stringify }}, from: from, to: to)
    end

    def saved_change_to_{{ name.id }} : Tuple({{ method.return_type }}?, {{ method.return_type }}?)?
      if change = saved_change_to_attribute({{ name.stringify }})
        {change[0].as({{ method.return_type }}?), change[1].as({{ method.return_type }}?)}
      end
    end

    def {{ name.id }}_previously_changed?(*, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
      saved_change_to_{{ name.id }}?(from: from, to: to)
    end

    def {{ name.id }}_previously_was : {{ method.return_type }}?
      if change = saved_change_to_attribute({{ name.stringify }})
        change[0].as({{ method.return_type }}?)
      else
        @{{ name.id }}
      end
    end
  {% end %}

  def __capture_saved_changes : Nil
    pending = {} of String => Tuple(SavedValue, SavedValue)
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      if \{{ v.name }}_changed?
        pending[\{{ v.name.stringify }}] = {@__persisted_\{{ v.name }}, @\{{ v.name }}}
      end
    \{% end %}
    @previous_changes = pending
    nil
  end

  def will_save_change_to_attribute?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    \{% begin %}
      case name.to_s
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      when \{{ v.name.stringify }}
        will_save_change_to_\{{ v.name }}?(from: from, to: to)
      \{% end %}
      else
        false
      end
    \{% end %}
  end

end
