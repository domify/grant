module grant/dirty

import std/uuid::{UUID}
import std/slice::{Bytes}
import std/time::{Time}
import grant/columns::{Type}

pub alias DirtyValue = Type | UUID | Bytes | Array(String) | Array(Int16) | Array(Int32) | Array(Int64) | Array(Float32) | Array(Float64) | Array(Bool) | Array(UUID) | Array(Time)

# Upstream's marker distinguishes an omitted filter from an explicit nil.
pub struct Unfiltered
end
pub UNFILTERED = Unfiltered.new

# Scalar pre-save predicates share the column baselines already captured by
# Base on construction, hydration, successful persistence and rollback.
pub macro model_methods(model)
  def clear_dirty_tracking_for(names : Array(String)) : Nil
    \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      @__persisted_\{{ column.name }} = @\{{ column.name }} if names.includes?(\{{ column.name.stringify }})
    \{% end %}
    nil
  end

  alias SavedValue = ::Grant::Dirty::DirtyValue {% for method in model.resolve.methods.select { |method| method.name.starts_with?("__raw_") && !method.name.ends_with?("=") } %} | {{method.return_type}}{% end %}
  @previous_changes = {} of String => Tuple(SavedValue, SavedValue)

  def changes : Hash(String, Tuple(SavedValue, SavedValue))
    pending = {} of String => Tuple(SavedValue, SavedValue)
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      if \{{ v.name }}_changed?
        pending[\{{ v.name.stringify }}] = {@__persisted_\{{ v.name }}, @\{{ v.name }}}
      end
    \{% end %}
    pending
  end

  def clear_previous_changes : Nil
    @previous_changes = {} of String => Tuple(SavedValue, SavedValue)
    nil
  end

  def previous_changes : Hash(String, Tuple(SavedValue, SavedValue))
    @previous_changes
  end

  def saved_change_to_attribute(name : String | Symbol) : Tuple(SavedValue, SavedValue)?
    @previous_changes[name.to_s]?
  end

  def saved_change_to_attribute?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    change = saved_change_to_attribute(name)
    return false if change.nil?
    (from.is_a?(::Grant::Dirty::Unfiltered) || change[0] == from) &&
      (to.is_a?(::Grant::Dirty::Unfiltered) || change[1] == to)
  end

  def __capture_saved_changes : Nil
    pending = {} of String => Tuple(SavedValue, SavedValue)
    \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      if \{{ v.name }}_changed?
        pending[\{{ v.name.stringify }}] = {@__persisted_\{{ v.name }}, @\{{ v.name }}}
      end
    \{% end %}
    @previous_changes = pending
    nil
  end

  def will_save_change_to_attribute?(name : String | Symbol, *, from = ::Grant::Dirty::UNFILTERED, to = ::Grant::Dirty::UNFILTERED) : Bool
    \{% begin %}
      case name.to_s
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      when \{{ v.name.stringify }}
        will_save_change_to_\{{ v.name }}?(from: from, to: to)
      \{% end %}
      else
        false
      end
    \{% end %}
  end

end
