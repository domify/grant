module grant/pool_stat

pub struct PoolStat
  getter size : Int32
  getter connections : Int32
  getter busy : Int32
  getter idle : Int32
  getter waiting : Int32
  getter in_flight : Int32

  def initialize(@size : Int32, @connections : Int32, @busy : Int32, @idle : Int32, @waiting : Int32, @in_flight : Int32)
  end

  def exhausted? : Bool
    size > 0 && idle == 0 && connections >= size
  end
end
