module grant/encryption/query_extensions

import grant/encryption/encrypted_attribute::{EncryptedAttribute}
import grant/adapter/driver::{Value}
import grant/query/where_field::{Bind}
import grant/error::{ArgumentError, ErrorBase}

# QueryValue's current-scheme slice: structured values become ciphertext at
# statement assembly, preserving comparison and key errors as returned values.
pub class QueryValue
  def self.rewrite(attribute : EncryptedAttribute, value : Bind) : Bind | ErrorBase
    unless attribute.deterministic
      return ArgumentError.new("Cannot query non-deterministic encrypted field: #{attribute.attribute_name}")
    end
    if value.nil?
      nil
    elsif value.is_a?(Array)
      stored = [] of Value
      value.each do |item|
        return ArgumentError.new("Encrypted field #{attribute.attribute_name.inspect} cannot be matched against nil inside a list") if item.nil?
        attribute.query_values(item.to_s)!.each { |text| stored << text }
      end
      stored
    else
      stored = attribute.query_values(value.to_s)!
      stored.size == 1 ? stored.first : stored.map { |text| text.as(Value) }
    end
  end
end

pub macro model_methods(model)
  def self.where_encrypted(**attrs) : ::Grant::Query::Builder::Builder({{model}})
    where(**attrs)
  end

  def self.find_by_encrypted(**attrs) : {{model}}? | ::Grant::Error::ErrorBase
    where_encrypted(**attrs).first
  end

end
