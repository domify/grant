module grant/encryption/migration_helpers
import grant/base
import grant/encryption
import grant/encryption/encrypted_attribute::{EncryptedAttribute}
import grant/encryption/key_provider::{KeyProvider, KeySet}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/error::{ArgumentError, ErrorBase}
import grant/adapter/driver::{Value}
import grant/query/executor
import std/log::{Log}

LOG = Log.for("grant")

pub alias RawRow = Tuple(Value, String?, String?)
WRITE_CHUNK_SIZE = 300

pub def encrypt_column(model_class : M.class, attribute : Symbol, batch_size : Int32 = 100,
                       progress : Bool = true, source_column : Symbol? = nil) : Int32 | ErrorBase forall M
  encrypted_attr = encrypted_attribute_for(model_class, attribute.to_s)!
  destination = encrypted_attr.column_name
  source = source_column.nil? ? (destination == attribute.to_s ? destination : attribute.to_s) : source_column.to_s
  processed = 0
  each_batch(model_class, source, destination, batch_size, progress, "Encrypting") do |rows|
    changes = [] of Tuple(Value, String)
    error = nil.as(ErrorBase?)
    rows.each do |row|
      key, plain, current = row
      processed += 1
      next if plain.nil?
      next if encrypted_payload?(current) || (source == destination && encrypted_payload?(plain))
      sealed = encrypted_attr.seal(plain)
      if sealed.is_a?(ErrorBase)
        error = sealed
        break
      end
      changes << {key, sealed}
    end
    error || write_batch(model_class, destination, changes)
  end!
  LOG.info("Encryption complete!") if progress
  processed
end

pub def decrypt_column(model_class : M.class, attribute : Symbol, target_column : Symbol? = nil,
                       batch_size : Int32 = 100, progress : Bool = true) : Int32 | ErrorBase forall M
  encrypted_attr = encrypted_attribute_for(model_class, attribute.to_s)!
  source = encrypted_attr.column_name
  target = target_column.nil? ? (source == attribute.to_s ? source : attribute.to_s) : target_column.to_s
  processed = 0
  each_batch(model_class, source, target, batch_size, progress, "Decrypting") do |rows|
    changes = [] of Tuple(Value, String)
    error = nil.as(ErrorBase?)
    rows.each do |row|
      key, stored, current = row
      next if stored.nil? || !encrypted_payload?(stored)
      plain = encrypted_attr.open(stored)
      if plain.is_a?(ErrorBase)
        error = plain
        break
      end
      changes << {key, plain}
      processed += 1
    end
    error || write_batch(model_class, target, changes)
  end!
  LOG.info("Decryption complete!") if progress
  processed
end

pub def rotate_encryption(model_class : M.class, attribute : Symbol, old_keys : K,
                          old_salt : String? = nil, batch_size : Int32 = 100,
                          progress : Bool = true) : Int32 | ErrorBase forall M, K
  encrypted_attr = encrypted_attribute_for(model_class, attribute.to_s)!
  current = KeySet.new(KeyProvider.primary_key, KeyProvider.deterministic_key, KeyProvider.key_derivation_salt)
  old_primary = KeyProvider.decode_key(old_keys[:primary])!
  old_det_text = old_keys[:deterministic]
  old_det = old_det_text.nil? ? nil : KeyProvider.decode_key(old_det_text)!
  previous = KeySet.new(old_primary, old_det, old_salt || current.salt)
  processed = 0
  column = encrypted_attr.column_name
  each_batch(model_class, column, column, batch_size, progress, "Rotating encryption keys for") do |rows|
    changes = [] of Tuple(Value, String)
    error = nil.as(ErrorBase?)
    rows.each do |row|
      key, stored, other = row
      next if stored.nil?
      plain = ::Grant::Encryption.decrypt_with_keys(stored, model_class.to_s, attribute.to_s, previous.primary_key, previous.deterministic_key, previous.salt)
      plain = ::Grant::Encryption.decrypt_with_keys(stored, model_class.to_s, attribute.to_s, current.primary_key, current.deterministic_key, current.salt) if plain.is_a?(DecryptionError)
      if plain.is_a?(ErrorBase)
        error = plain
        break
      end
      sealed = ::Grant::Encryption.encrypt_with_keys(plain, model_class.to_s, attribute.to_s, encrypted_attr.deterministic, current.primary_key, current.deterministic_key, current.salt)
      if sealed.is_a?(ErrorBase)
        error = sealed
        break
      end
      changes << {key, sealed}
      processed += 1
    end
    error || write_batch(model_class, column, changes)
  end!
  LOG.info("Key rotation complete!") if progress
  processed
end

pub def generate_migration(model_class : M.class, attribute : Symbol) : String | ErrorBase forall M
  encrypted_attr = encrypted_attribute_for(model_class, attribute.to_s)!
  column = encrypted_attr.column_name
  transparent = column == attribute.to_s
  change = transparent ? "change_column :#{column}, :text" : "add_column :#{column}, :text"
  index = encrypted_attr.deterministic ? "add_index :#{column}" : "# not deterministic: not queryable, so not indexed"
  drop = transparent ? "# (nothing to drop: the value was encrypted in place)" : "# alter_table :#{model_class.table_name} do\n#   drop_column :#{attribute}\n# end"
  "alter_table :#{model_class.table_name} do\n  #{change}\n  #{index}\nend\n\n# Encrypt existing data\nGrant::Encryption::MigrationHelpers.encrypt_column(\n  #{model_class},\n  :#{attribute}\n)\n\n# Optional: Remove original column after verification\n#{drop}"
end

private def encrypted_attribute_for(model_class : M.class, attribute_name : String) : EncryptedAttribute | ErrorBase forall M
  model_class.encrypted_query_attribute(attribute_name) || ArgumentError.new("#{model_class} does not have encrypted attribute #{attribute_name}")
end

private def encrypted_payload?(text : String?) : Bool
  return false if text.nil? || text.empty?
  bytes = KeyProvider.decode_encoded(text)
  !bytes.is_a?(ErrorBase) && Cipher.encrypted_payload?(bytes)
end

private def each_batch(model_class : M.class, source : String, current : String, batch_size : Int32,
                       progress : Bool, verb : String, &block : Array(RawRow) -> Nil | ErrorBase) : Nil | ErrorBase forall M
  return ArgumentError.new("batch_size must be positive") unless batch_size > 0
  key_column = model_class.primary_name
  total = model_class.count!
  LOG.info("#{verb} #{total} records...") if progress
  seen = 0
  last = nil.as(Value)
  first = true
  names = source == current ? [key_column, source] : [key_column, source, current]
  loop do
    relation = model_class.all.order(key_column).limit(batch_size)
    relation = relation.where(key_column, :gt, last) unless first
    assembler = relation.assembler
    sql = assembler.pluck_sql(names)
    arguments = assembler.numbered_parameters
    data = ::Grant::Query::Executor.open_statement(model_class.adapter, sql, arguments) { |db| db.query(sql, arguments) }!
    rows = data.map do |row|
      plain = row[source].as(String?)
      {row[key_column], plain, names.size == 3 ? row[current].as(String?) : plain}
    end
    break if rows.empty?
    model_class.transaction { yield rows }!
    seen += rows.size
    last = rows.last[0]
    first = false
    if progress
      percent = total > 0 ? ((seen.to_f64 / total.to_f64 * 10000.0 + 0.5).to_i64.to_f64 / 100.0) : 100.0
      LOG.info("Progress: #{seen}/#{total} (#{percent}%)")
    end
    break if rows.size < batch_size
  end
  nil
end

private def write_batch(model_class : M.class, column : String, changes : Array(Tuple(Value, String))) : Nil | ErrorBase forall M
  return nil if changes.empty?
  offset = 0
  while offset < changes.size
    assembler = model_class.all.assembler
    branches = [] of String
    keys = [] of String
    count = changes.size - offset
    count = WRITE_CHUNK_SIZE if count > WRITE_CHUNK_SIZE
    count.times do |index|
      key, value = changes[offset + index]
      branches << "WHEN #{assembler.add_parameter(key)} THEN #{assembler.add_parameter(value)}"
    end
    count.times { |index| keys << assembler.add_parameter(changes[offset + index][0]) }
    sql = "UPDATE #{model_class.quote(model_class.table_name)} SET #{model_class.quote(column)} = CASE #{model_class.quote(model_class.primary_name)} #{branches.join(" ")} END WHERE #{model_class.quote(model_class.primary_name)} IN (#{keys.join(", ")})"
    arguments = assembler.numbered_parameters
    model_class.mark_write_operation
    ::Grant::Query::Executor.open_statement(model_class.adapter, sql, arguments) { |db| db.exec(sql, arguments) }!
    offset += count
  end
  nil
end
