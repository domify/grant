module grant/encryption/encrypted_attribute

pub import grant/encryption/key_provider
import grant/encryption/key_provider::{KeyProvider, KeyError}
import grant/encryption/cipher::{Cipher, DecryptionError, EncryptionError}
import std/base64::{Base64}
import grant/encryption/config::{Config}
import grant/error::{ArgumentError, ErrorBase}
pub import grant/encryption/context

pub class EncryptedAttribute
  getter model_name : String
  getter attribute_name : String
  getter deterministic : Bool
  getter column_name : String

  def initialize(@model_name : String, @attribute_name : String, @deterministic : Bool, @column_name : String, @downcase : Bool = false, @ignore_case : Bool = false)
  end

  def seal(plain : String) : String | KeyError | EncryptionError | DecryptionError
    return plain if ::Grant::Encryption::Context.current_context.encryption_disabled?
    key = KeyProvider.derive_key(@model_name, @attribute_name, @deterministic)!
    text = @downcase || @ignore_case ? plain.downcase : plain
    encrypted = Base64.encode(Cipher.encrypt(text, key, @deterministic)!)
    Config.log_operation("encrypt", @model_name, @attribute_name, plain.bytesize, encrypted.bytesize)
    encrypted
  end

  def query_value(plain : String) : String | ErrorBase
    return ArgumentError.new("Cannot query non-deterministic encrypted field: #{attribute_name}") unless @deterministic
    seal(plain)
  end

  def query_values(plain : String) : Array(String) | ErrorBase
    [query_value(plain)!]
  end

  def open(stored : String) : String | KeyError | EncryptionError | DecryptionError
    return stored if ::Grant::Encryption::Context.current_context.encryption_disabled?
    open_with_index(stored)![0]
  end

  def open_with_index(stored : String) : Tuple(String, Int32) | KeyError | EncryptionError | DecryptionError
    return {"", 0} if stored.empty?
    bytes = KeyProvider.decode_encoded(stored)
    return DecryptionError.new("Failed to decode Base64: #{bytes.message}") if bytes.is_a?(KeyError)
    attempted = false
    2.times do |round|
      deterministic = Cipher.deterministic_payload?(bytes) ? round == 0 : round == 1
      next if (deterministic ? KeyProvider.deterministic_key : KeyProvider.primary_key).nil?
      attempted = true
      key = KeyProvider.derive_key(@model_name, @attribute_name, deterministic)!
      result = Cipher.decrypt?(bytes, key)!
      unless result.nil?
        Config.log_operation("decrypt", @model_name, @attribute_name, bytes.bytesize, result.bytesize)
        return {result, 0}
      end
    end
    return KeyError.new("Primary encryption key not configured. Set Grant::Encryption::KeyProvider.primary_key") unless attempted
    DecryptionError.new("HMAC verification failed - data may have been tampered with")
  end
end

# Declarations are registered before queries run; the native scheduler is
# single-threaded and no registration or lookup operation yields.
pub class EncryptedAttributeRegistry
  @@attributes = {} of String => Hash(String, EncryptedAttribute)

  def self.for(model_name : String) : Hash(String, EncryptedAttribute)
    attributes = @@attributes[model_name]?
    copy = {} of String => EncryptedAttribute
    attributes.each { |name, attribute| copy[name] = attribute } unless attributes.nil?
    copy
  end

  def self.lookup(model_name : String, attribute_name : String) : EncryptedAttribute?
    attributes = @@attributes[model_name]?
    attributes.nil? ? nil : attributes[attribute_name]?
  end

  def self.register(model_name : String, attribute_name : String, attribute : EncryptedAttribute) : Nil
    @@attributes[model_name] ||= {} of String => EncryptedAttribute
    @@attributes[model_name][attribute_name] = attribute
    nil
  end
end
