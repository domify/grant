module grant/encryption/compression
import std/compress::{Zlib}

pub MARKER = "\u0000\u0001grz"

pub def encode(plain : String, compress : Bool, threshold : Int32) : String
  escape = plain.starts_with?(MARKER)
  return plain unless escape || (compress && plain.bytesize >= threshold)
  wrapped = MARKER + Zlib.compress(plain)
  escape || wrapped.bytesize < plain.bytesize ? wrapped : plain
end

pub def decode(stored : String) : String
  return stored unless stored.starts_with?(MARKER)
  Zlib.decompress(String.new(stored.bytesize - MARKER.bytesize) { |buffer| buffer.copy_from(stored.to_unsafe + MARKER.bytesize, stored.bytesize - MARKER.bytesize) })
end
