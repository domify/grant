module grant/encryption/key_provider

pub import std/base64
pub import grant/encryption/cipher
import std/base64::{Base64}
import grant/encryption/cipher::{Cipher}
import grant/error::{ErrorBase}

pub class KeyError < ErrorBase
end
impl ::Error for KeyError
  def message : String
    @message
  end
end

pub struct KeySet
  getter primary_key : String?
  getter deterministic_key : String?
  getter salt : String

  def initialize(@primary_key : String?, @deterministic_key : String?, @salt : String)
  end
end

pub class KeyProvider
  DERIVE_INFO_PREFIX = "grant-encryption"
  KEY_SIZE = 32
  DEFAULT_SALT = "grant-encryption-v1"
  @@primary_key : String? = nil
  @@deterministic_key : String? = nil
  @@key_derivation_salt : String = DEFAULT_SALT
  @@derived_keys = {} of String => String

  def self.generate_key : String | ::Grant::Encryption::Cipher::EncryptionError
    Base64.encode(Cipher.random_bytes(KEY_SIZE)!)
  end

  def self.primary_key : String?
    @@primary_key
  end
  def self.primary_key=(key : String) : Nil | KeyError
    @@primary_key = decode_key(key)!
    @@derived_keys = {} of String => String
    nil
  end
  def self.deterministic_key : String?
    @@deterministic_key
  end
  def self.deterministic_key=(key : String) : Nil | KeyError
    @@deterministic_key = decode_key(key)!
    @@derived_keys = {} of String => String
    nil
  end
  def self.primary_key=(key : Nil) : Nil
    @@primary_key = nil
    @@derived_keys = {} of String => String
    nil
  end
  def self.deterministic_key=(key : Nil) : Nil
    @@deterministic_key = nil
    @@derived_keys = {} of String => String
    nil
  end

  # std/base64 reports malformed input by panicking. Validate its accepted
  # byte grammar first, so the Grant API returns its original error value.
  def self.decode_encoded(encoded : String) : String | KeyError
    data = 0
    pads = 0
    invalid = false
    encoded.bytesize.times do |i|
      byte = encoded.to_unsafe[i]
      if byte == 32 || (byte >= 9 && byte <= 13)
        next
      elsif byte == 61
        pads += 1
      elsif (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 43 || byte == 47 || byte == 45 || byte == 95
        invalid = true if pads > 0
        data += 1
      else
        invalid = true
      end
    end
    invalid = true if data % 4 == 1 || pads > 2
    invalid = true if pads > 0 && (data % 4 < 2 || data % 4 + pads != 4)
    return KeyError.new("Invalid base64-encoded key: malformed Base64") if invalid
    Base64.decode(encoded)
  end

  def self.decode_key(encoded : String) : String | KeyError
    decoded = decode_encoded(encoded)!
    return KeyError.new("Invalid key size: expected #{KEY_SIZE} bytes, got #{decoded.bytesize}") unless decoded.bytesize == KEY_SIZE
    decoded
  end

  def self.key_derivation_salt : String
    @@key_derivation_salt
  end
  def self.key_derivation_salt=(salt : String) : Nil
    @@key_derivation_salt = salt
    @@derived_keys = {} of String => String
    nil
  end

  def self.derive_key_from_set?(model_name : String, attribute_name : String, deterministic : Bool, key_set : KeySet) : String?
    master = deterministic ? key_set.deterministic_key : key_set.primary_key
    return nil if master.nil?
    prk = Cipher.digest(key_set.salt, master)
    Cipher.digest(prk, "#{DERIVE_INFO_PREFIX}.#{model_name}.#{attribute_name}" + "\u0001")
  end

  def self.derive_key(model_name : String, attribute_name : String, deterministic : Bool = false) : String | KeyError
    cache_key = "#{model_name}.#{attribute_name}.#{deterministic}"
    return @@derived_keys[cache_key] if @@derived_keys.has_key?(cache_key)
    master = deterministic ? @@deterministic_key : @@primary_key
    if master.nil?
      return KeyError.new(deterministic ? "Deterministic encryption key not configured. Set Grant::Encryption::KeyProvider.deterministic_key" : "Primary encryption key not configured. Set Grant::Encryption::KeyProvider.primary_key")
    end
    # HKDF-SHA256 extract and the single 32-byte expand block, as upstream.
    prk = Cipher.digest(@@key_derivation_salt, master)
    info = "#{DERIVE_INFO_PREFIX}.#{model_name}.#{attribute_name}"
    @@derived_keys[cache_key] = Cipher.digest(prk, info + "\u0001")
  end
end
