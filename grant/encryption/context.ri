module grant/encryption/context

pub import grant/encryption/key_provider
import grant/encryption/key_provider::{KeySet, KeyProvider, KeyError}
pub import grant/error
import grant/error::{ErrorBase}

# Mode slice of the upstream immutable context. Native scheduler identities
# supply fiber-local storage without reopening the runtime's Fiber class.
pub struct Context
  getter key_set : KeySet?

  def initialize(@encryption_disabled : Bool = false, @data_protected : Bool = false, @key_set : KeySet? = nil)
  end

  def encryption_disabled? : Bool
    @encryption_disabled
  end

  def data_protected? : Bool
    @data_protected
  end

  def replace(encryption_disabled : Bool = @encryption_disabled, data_protected : Bool = @data_protected, key_set : KeySet? = @key_set) : Context
    Context.new(encryption_disabled, data_protected, key_set)
  end
end

pub class UnsupportedTypeError < ErrorBase
end
impl ::Error for UnsupportedTypeError
  def message : String
    @message
  end
end

DEFAULT_CONTEXT = Context.new
@@contexts = {} of UInt64 => Context

pub def current_context : Context
  @@contexts[IyiScheduler.current.object_id]? || DEFAULT_CONTEXT
end

pub def encryption_enabled? : Bool
  !current_context.encryption_disabled?
end

pub def without_encryption(&block : -> T) : T forall T
  context = current_context
  return yield if context.data_protected?
  swap_context(context.replace(encryption_disabled: true)) { yield }
end

pub def protecting_encrypted_data(&block : -> T) : T forall T
  swap_context(current_context.replace(encryption_disabled: false, data_protected: true)) { yield }
end

pub def with_context(primary_key : String? = nil, deterministic_key : String? = nil, key_derivation_salt : String? = nil, &block : -> T) : T | KeyError forall T
  primary = primary_key.nil? ? nil : KeyProvider.decode_key(primary_key)!
  deterministic = deterministic_key.nil? ? nil : KeyProvider.decode_key(deterministic_key)!
  keys = KeySet.new(primary, deterministic, key_derivation_salt || KeyProvider.key_derivation_salt)
  swap_context(current_context.replace(key_set: keys)) { yield }
end

private def swap_context(context : Context, &block : -> T) : T forall T
  fiber = IyiScheduler.current.object_id
  previous = @@contexts[fiber]?
  @@contexts[fiber] = context
  result = yield
  if previous.nil?
    @@contexts.delete(fiber)
  else
    @@contexts[fiber] = previous
  end
  result
end
