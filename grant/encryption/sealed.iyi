module grant/encryption/sealed

pub import std/text
pub import grant/error
import grant/error::{ErrorBase}

# Native returned counterpart of the ArgumentError raised by Sealed.
pub class ArgumentError < ErrorBase
end

impl ::Error for ArgumentError
  def message : String
    @message
  end
end

pub PREFIX = "\u0000grant-sealed:"

pub def wrap(stored : String) : String
  PREFIX + stored
end

pub def sealed?(value : String) : Bool
  value.starts_with?(PREFIX)
end

pub def stored(value : String) : String
  value[PREFIX.bytesize, value.bytesize - PREFIX.bytesize]
end

pub def guard_plaintext_strict(attribute_name : String, value : String?) : Nil | ArgumentError
  return nil if value.nil? || !sealed?(value)
  ArgumentError.new("#{attribute_name} cannot start with the reserved prefix of Grant::Encryption::Sealed")
end
