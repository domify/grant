module grant/encryption/scheme
import grant/encryption/key_provider::{KeyProvider, KeyError}

pub struct Scheme
  getter deterministic : Bool
  getter primary_key : String?
  getter deterministic_key : String?
  getter salt : String?

  def initialize(@deterministic : Bool = false, @primary_key : String? = nil,
                 @deterministic_key : String? = nil, @salt : String? = nil)
  end

  def self.build(deterministic : Bool = false, key : String? = nil, salt : String? = nil) : Scheme | KeyError
    decoded = key.nil? ? nil : KeyProvider.decode_key(key)!
    new(deterministic, deterministic ? nil : decoded, deterministic ? decoded : nil, salt)
  end

  def overrides_keys? : Bool
    !@primary_key.nil? || !@deterministic_key.nil? || !@salt.nil?
  end
end
