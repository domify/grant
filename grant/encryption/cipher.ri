module grant/encryption/cipher

pub import grant/error
import grant/error::{ErrorBase}

@[Link("crypto")]
lib Crypto
  fun sha256 = EVP_sha256 : Void*
  fun hmac = HMAC(digest : Void*, key : UInt8*, key_size : Int32, data : UInt8*, size : UInt64, output : UInt8*, output_size : UInt32*) : UInt8*
  fun random = RAND_bytes(output : UInt8*, size : Int32) : Int32
  fun context_new = EVP_CIPHER_CTX_new : Void*
  fun context_free = EVP_CIPHER_CTX_free(context : Void*) : Void
  fun aes = EVP_aes_256_cbc : Void*
  fun init = EVP_CipherInit_ex(context : Void*, cipher : Void*, engine : Void*, key : UInt8*, iv : UInt8*, encrypt : Int32) : Int32
  fun update = EVP_CipherUpdate(context : Void*, output : UInt8*, output_size : Int32*, data : UInt8*, size : Int32) : Int32
  fun final = EVP_CipherFinal_ex(context : Void*, output : UInt8*, output_size : Int32*) : Int32
end

pub class EncryptionError < ErrorBase
end
impl ::Error for EncryptionError
  def message : String
    @message
  end
end

pub class DecryptionError < ErrorBase
end
impl ::Error for DecryptionError
  def message : String
    @message
  end
end

# Strings here carry binary bytes, never a C string length. The upstream
# payload is version/flags, a stored 16-byte IV, CBC ciphertext, then HMAC.
pub class Cipher
  ALGORITHM = "aes-256-cbc"
  IV_SIZE = 16
  HMAC_SIZE = 32
  VERSION = 1_u8
  MIN_PAYLOAD_SIZE = 65
  DETERMINISTIC = 0x80_u8

  def self.digest(key : String, data : String) : String
    size = 0_u32
    String.new(HMAC_SIZE) do |buffer|
      Crypto.hmac(Crypto.sha256, key.to_unsafe, key.bytesize, data.to_unsafe, data.bytesize.to_u64, buffer, pointerof(size))
    end
  end

  def self.bytes(data : String, offset : Int32, size : Int32) : String
    String.new(size) { |buffer| buffer.copy_from(data.to_unsafe + offset, size) }
  end

  def self.random_bytes(size : Int32) : String | EncryptionError
    success = false
    result = String.new(size) { |buffer| success = Crypto.random(buffer, size) == 1 }
    success ? result : EncryptionError.new("Encryption failed: random IV generation failed")
  end

  private def self.crypt(data : String, key : String, iv : String, encrypt : Bool) : String | EncryptionError | DecryptionError
    context = Crypto.context_new
    if context.address == 0
      return encrypt ? EncryptionError.new("Encryption failed: cannot allocate cipher") : DecryptionError.new("Decryption failed: cannot allocate cipher")
    end
    buffer = Pointer(UInt8).malloc((data.bytesize + 16).to_u64)
    written = 0
    tail = 0
    success = Crypto.init(context, Crypto.aes, Pointer(Void).new(0_u64), key.to_unsafe, iv.to_unsafe, encrypt ? 1 : 0) == 1
    success = success && Crypto.update(context, buffer, pointerof(written), data.to_unsafe, data.bytesize) == 1
    success = success && Crypto.final(context, buffer + written, pointerof(tail)) == 1
    Crypto.context_free(context)
    unless success
      return encrypt ? EncryptionError.new("Encryption failed: AES-256-CBC") : DecryptionError.new("Decryption failed: AES-256-CBC")
    end
    String.new(written + tail) { |output| output.copy_from(buffer, written + tail) }
  end

  def self.encrypt(plaintext : String, key : String, deterministic : Bool = false) : String | EncryptionError | DecryptionError
    return "" if plaintext.empty?
    enc_key = digest(key, "encryption")
    mac_key = digest(key, "authentication")
    iv = deterministic ? bytes(digest(enc_key, plaintext), 0, IV_SIZE) : random_bytes(IV_SIZE)!
    ciphertext = crypt(plaintext, enc_key, iv, true)!
    header = String.new(1) { |buffer| buffer[0] = deterministic ? VERSION | DETERMINISTIC : VERSION }
    payload = header + iv + ciphertext
    payload + digest(mac_key, payload)
  end

  def self.encrypted_payload?(data : String) : Bool
    data.bytesize >= MIN_PAYLOAD_SIZE && (data.to_unsafe[0] & 0x7f_u8) == VERSION
  end

  def self.deterministic_payload?(data : String) : Bool
    !data.empty? && (data.to_unsafe[0] & DETERMINISTIC) != 0
  end

  def self.decrypt(encrypted : String, key : String) : String | DecryptionError | EncryptionError
    result = decrypt?(encrypted, key)!
    result.nil? ? DecryptionError.new("HMAC verification failed - data may have been tampered with") : result
  end

  def self.decrypt?(encrypted : String, key : String) : String | Nil | DecryptionError | EncryptionError
    return "" if encrypted.empty?
    return DecryptionError.new("Encrypted data too short") if encrypted.bytesize < 1 + HMAC_SIZE
    enc_key = digest(key, "encryption")
    mac_key = digest(key, "authentication")
    payload_size = encrypted.bytesize - HMAC_SIZE
    payload = bytes(encrypted, 0, payload_size)
    provided = bytes(encrypted, payload_size, HMAC_SIZE)
    expected = digest(mac_key, payload)
    return nil unless secure_compare(provided, expected)
    return DecryptionError.new("Encrypted data too short for IV") if payload_size < 1 + IV_SIZE
    version = payload.to_unsafe[0] & 0x7f_u8
    return DecryptionError.new("Unsupported encryption version: #{version}") unless version == VERSION
    iv = bytes(payload, 1, IV_SIZE)
    ciphertext = bytes(payload, 1 + IV_SIZE, payload_size - 1 - IV_SIZE)
    crypt(ciphertext, enc_key, iv, false)
  end

  private def self.secure_compare(a : String, b : String) : Bool
    return false unless a.bytesize == b.bytesize
    result = 0_u8
    a.bytesize.times { |i| result |= a.to_unsafe[i] ^ b.to_unsafe[i] }
    result == 0
  end
end
