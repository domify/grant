module grant/encryption/serializer

pub import grant/error
import grant/error::{ErrorBase}
import std/time::{Time}
import std/json::{JSON, Any}
import std/text

# Typed scalar slice of the upstream Serializer. Strings pass through; numbers
# and booleans use their text representation before the shared String cipher.
pub def dump(value : String | Int | Float | Bool) : String
  value.to_s
end

pub def dump(value : Time) : String
  value.to_rfc3339(fraction_digits: 9)
end

pub def dump(value : Any) : String
  value.to_json
end

pub def load(raw : String, type : T.class) : T | ErrorBase forall T
  {% if T == String %}
    raw
  {% elsif T == Int64 %}
    value = raw.to_i64?
    value.nil? ? ErrorBase.new("Invalid encrypted Int64: #{raw}") : value
  {% elsif T == Int32 %}
    value = raw.to_i?
    value.nil? ? ErrorBase.new("Invalid encrypted Int32: #{raw}") : value
  {% elsif T == UInt64 %}
    value = raw.to_u64?
    value.nil? ? ErrorBase.new("Invalid encrypted UInt64: #{raw}") : value
  {% elsif T == Time %}
    Time.parse_rfc3339(raw)
  {% elsif T == Any %}
    value = JSON.parse?(raw)
    value.nil? ? ErrorBase.new("Invalid encrypted JSON: #{raw}") : value
  {% elsif T == Float64 %}
    value = raw.to_f?
    value.nil? ? ErrorBase.new("Invalid encrypted Float64: #{raw}") : value
  {% elsif T == Float32 %}
    value = raw.to_f?
    value.nil? ? ErrorBase.new("Invalid encrypted Float32: #{raw}") : value.to_f32
  {% elsif T == Bool %}
    raw == "true"
  {% else %}
    {% raise "encrypted serializer type has not been ported" %}
  {% end %}
end
