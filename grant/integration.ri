module grant/integration

import std/time::{Time}
import grant/columns

pub annotation ParamAttribute
end

pub def version_stamp(stamp : Time) : String
  digits = ""
  stamp.to_rfc3339(6).each_char do |char|
    digits += char.to_s if char >= '0' && char <= '9'
  end
  digits
end

pub macro to_param(attribute)
  @[::Grant::Integration::ParamAttribute(attribute: {{ attribute.id.stringify }})]
  def __param_attribute : String
    {{ attribute.id.stringify }}
  end
end

pub macro model_methods(model)
  def self.collection_cache_key : String | ::Grant::Error::ErrorBase
    current_scope.collection_cache_key
  end

  def to_key : Array(::Grant::Columns::Type)?
    value = __primary_value
    value.nil? ? nil : [value.as(::Grant::Columns::Type)] of ::Grant::Columns::Type
  end

  def to_param : String?
    return nil unless persisted?
    \{% begin %}
    \{% declaration = @type.methods.find { |method| method.annotation(::Grant::Integration::ParamAttribute) } %}
    \{% if declaration %}
      \{% attribute = declaration.annotation(::Grant::Integration::ParamAttribute)[:attribute] %}
      value = self.\{{ attribute.id }}
      value.nil? ? nil : value.to_s
    \{% else %}
      key = to_key
      key.nil? ? nil : key.join("-")
    \{% end %}
    \{% end %}
  end

  def cache_key : String
    key = to_key
    if new_record? || key.nil?
      "#{self.class.table_name}/new"
    else
      "#{self.class.table_name}/#{key.join("-")}"
    end
  end

  def cache_version : String?
    \{% if @type.instance_vars.any? { |v| v.annotation(::Grant::Base::Column) && v.name.stringify == "updated_at" } %}
      stamp = @updated_at
      stamp.is_a?(::Std::Time::Time) ? ::Grant::Integration.version_stamp(stamp) : nil
    \{% else %}
      nil
    \{% end %}
  end

  def cache_key_with_version : String
    version = cache_version
    version.nil? ? cache_key : "#{cache_key}-#{version}"
  end
end
