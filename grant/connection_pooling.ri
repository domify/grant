module grant/connection_pooling

import grant/connection_registry::{ConnectionRegistry}
import grant/connection_pool::{ConnectionPool}
import grant/adapter/base::{Base}
import grant/error::{ErrorBase}
import grant/settings
import grant/connection_management

# Model-level PoolClassMethods from src/grant/connection_pooling.cr.
pub macro model_methods(model)
  def self.establish_connection(url : String, adapter : T.class,
                                role : Symbol = ::Grant::Settings.settings.writing_role,
                                database : String = default_database_name,
                                shard : Symbol? = nil, **pool_options) : Nil | ::Grant::Error::ErrorBase forall T
    ::Grant::ConnectionRegistry::ConnectionRegistry.establish_connection(
      **pool_options, database: database, adapter: adapter, url: url,
      role: ::Grant::ConnectionManagement.registry_role(role), shard: shard)
  end

  def self.remove_connection(role : Symbol = ::Grant::Settings.settings.writing_role,
                             shard : Symbol? = current_shard) : Bool | ::Grant::Error::ErrorBase
    canonical = ::Grant::ConnectionManagement.registry_role(role)
    name = connection_config[canonical]? || current_database
    ::Grant::ConnectionRegistry::ConnectionRegistry.remove_connection(name, canonical, shard)
  end

  def self.connected? : Bool
    pool = retrieve_connection_pool
    !pool.nil? && pool.active?
  end

  def self.retrieve_connection_pool(role : Symbol = ::Grant::Settings.settings.writing_role,
                                    shard : Symbol? = current_shard) : ::Grant::ConnectionPool::ConnectionPool?
    canonical = ::Grant::ConnectionManagement.registry_role(role)
    name = connection_config[canonical]? || current_database
    ::Grant::ConnectionRegistry::ConnectionRegistry.connection_pool(name, canonical, shard)
  end

  def self.disconnect_strict : Nil | ::Grant::Error::ErrorBase
    ::Grant::ConnectionRegistry::ConnectionRegistry.adapters_for_database(current_database).each do |adapter|
      adapter.disconnect_strict!
    end
    nil
  end
end
