module grant/converters

import grant/columns
import db/db/errors
import pg/pg/numeric

pub import std/enum
pub import std/slice
pub import std/json

pub def text_bytes(value : String) : ::Std::Slice::Bytes
  ::Std::Slice::Bytes.new(value.bytesize) { |i| value.to_unsafe[i] }
end

pub def bytes_text(value : ::Std::Slice::Bytes) : String
  String.new(value.size) { |buffer| value.size.times { |i| buffer[i] = value[i] } }
end

# Structural port of the converter families in src/grant/converters.cr.
pub struct Enum(E, T)
  def self.to_db(value : E?) : Int64 | String | Nil
    return nil if value.nil?
    {% if T == String || T == ::Std::Slice::Bytes %}
      value.to_s
    {% else %}
      value.to_i64
    {% end %}
  end

  def self.from_db(value : V) : E? forall V
    case value
    when String then E.parse?(value)
    when ::Std::Slice::Bytes then E.parse?(String.new(value.size) { |buffer| value.size.times { |i| buffer[i] = value[i] } })
    when Int8, Int16, Int32, Int64, Float32, Float64 then E.from_value?(value.to_i64)
    else nil
    end
  end

  def self.from_rs(result : R) : E? forall R
    value = result.read
    return nil if value.nil?
    {% if T == String %}
      E.parse?(value.as(String))
    {% elsif T == ::Std::Slice::Bytes %}
      E.parse?(bytes_text(value.as(::Std::Slice::Bytes)))
    {% else %}
      E.from_value?(value.as(T).to_i64)
    {% end %}
  end
end


pub struct Json(M, T)
  def self.to_db(value : M?) : String | ::Std::Slice::Bytes | Nil
    return nil if value.nil?
    {% if T == ::Std::Slice::Bytes %}
      text_bytes(value.to_json)
    {% else %}
      value.to_json
    {% end %}
  end

  def self.from_db(value : V) : M? forall V
    case value
    when String then M.from_json(value)
    when ::Std::Slice::Bytes then M.from_json(bytes_text(value))
    else nil
    end
  end

  def self.from_rs(result : R) : M? forall R
    value = result.read
    return nil if value.nil?
    {% if T == ::Std::Json::Any %}
      M.from_json(value.as(::Std::Json::Any).to_json)
    {% elsif T == ::Std::Slice::Bytes %}
      M.from_json(bytes_text(value.as(::Std::Slice::Bytes)))
    {% else %}
      M.from_json(value.as(String))
    {% end %}
  end
end

# PostgreSQL's Numeric wrapper converts to the public Float64 model value.
pub struct PgNumeric
  def self.to_db(value : Float64?) : ::Grant::Columns::Type
    value
  end

  def self.from_db(value : V) : Float64? forall V
    value.as?(Float64)
  end

  def self.from_rs(result : R) : Float64? | ::Db::Errors::DBError forall R
    value = result.read
    return value if value.is_a?(::Db::Errors::DBError)
    return nil if value.nil?
    value.as(::Pg::Numeric::Numeric).to_f
  end
end
