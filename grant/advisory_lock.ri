module grant/advisory_lock

import std/digest::{MD5}
import std/int
import std/text
import std/time::{Span}
import grant/adapter/driver::{Connection, Value}
import grant/adapter/pool_support::{ticks}
import grant/error::{ErrorBase}

pub class AdvisoryLockTimeout < ErrorBase
  getter key : String

  def initialize(@key : String, timeout : Span)
    super("Could not take advisory lock #{@key.inspect} within #{timeout}; another process holds it")
  end
end

pub class AdvisoryLockUnsupported < ErrorBase
end

# Native file IO has no flock yet. Keep the same kernel-owned lock and lifetime.
lib LockLibC
  fun open(path : UInt8*, flags : Int32, mode : UInt32) : Int32
  fun flock(fd : Int32, operation : Int32) : Int32
  fun close(fd : Int32) : Int32
end

pub class LockFile
  getter fd : Int32

  def initialize(path : String)
    @fd = LockLibC.open("#{path}\0".to_unsafe, 1089, 384_u32)
    raise "Cannot open advisory lock file #{path}" if @fd < 0
  end

  def try_exclusive : Bool
    LockLibC.flock(fd, 6) == 0
  end

  def close : Nil
    LockLibC.flock(fd, 8)
    LockLibC.close(fd)
    nil
  end
end

pub class SqliteHold
  getter owner : UInt64
  getter file : LockFile?
  property count : Int32 = 1

  def initialize(@owner : UInt64, @file : LockFile?)
  end
end

@@sqlite_holds = {} of String => SqliteHold

pub def synchronize(adapter : A, key : String, timeout : Span = Span.seconds(5_i64),
                    &block : -> T) : T | ErrorBase | Cancelled forall A, T
  unless adapter.supports_advisory_locks? || adapter.sqlite?
    return AdvisoryLockUnsupported.new("The #{adapter.name} adapter has no advisory locks")
  end
  adapter.with_connection do |connection|
    acquired = acquire(adapter, connection, key, timeout)
    if acquired.is_a?(::Error)
      acquired
    else
      defer adapter.release_advisory_lock(connection, key)
      yield
    end
  end
end

pub def acquire(adapter : A, connection : Connection, key : String, timeout : Span) : Nil | ErrorBase | Cancelled forall A
  deadline = ticks + timeout.total_milliseconds.to_i64
  loop do
    taken = adapter.try_advisory_lock(connection, key)!
    return nil if taken
    return AdvisoryLockTimeout.new(key, timeout) if ticks >= deadline
    sleep(25)!
  end
end

pub def key_to_int64(key : String) : Int64
  bytes = MD5.hash_bytes(key)
  value = 0_i64
  8.times { |index| value = (value << 8) | bytes[index].to_i64 }
  value
end

pub def try_acquire(adapter : A, connection : Connection, key : String) : Bool | ErrorBase forall A
  if adapter.postgres?
    connection.scalar("SELECT pg_try_advisory_lock($1)", [key_to_int64(key).as(Value)])!.as(Bool)
  elsif adapter.sqlite?
    sqlite_try(adapter, key)
  else
    AdvisoryLockUnsupported.new("The #{adapter.name} adapter has no advisory locks")
  end
end

pub def release(adapter : A, connection : Connection, key : String) : Nil | ErrorBase forall A
  if adapter.postgres?
    connection.scalar("SELECT pg_advisory_unlock($1)", [key_to_int64(key).as(Value)])!
  elsif adapter.sqlite?
    sqlite_release(adapter, key)
  end
  nil
end

private def sqlite_try(adapter : A, key : String) : Bool forall A
  id = sqlite_id(adapter, key)
  if hold = @@sqlite_holds[id]?
    return false unless hold.owner == IyiScheduler.current.object_id
    hold.count += 1
    return true
  end
  path = sqlite_lock_path(adapter, key)
  file = nil.as(LockFile?)
  unless path.nil?
    file = LockFile.new(path)
    unless file.try_exclusive
      file.close
      return false
    end
  end
  # No scheduling point occurs between looking up and recording the holder.
  @@sqlite_holds[id] = SqliteHold.new(IyiScheduler.current.object_id, file)
  true
end

private def sqlite_release(adapter : A, key : String) : Nil forall A
  id = sqlite_id(adapter, key)
  hold = @@sqlite_holds[id]?
  return nil if hold.nil?
  hold.count -= 1
  return nil if hold.count > 0
  @@sqlite_holds.delete(id)
  file = hold.file
  file.close unless file.nil?
  nil
end

private def sqlite_id(adapter : A, key : String) : String forall A
  "#{sqlite_database_file(adapter) || adapter.object_id}\0#{key}"
end

private def sqlite_lock_path(adapter : A, key : String) : String? forall A
  file = sqlite_database_file(adapter)
  return nil if file.nil?
  "#{file}.grant-lock-#{MD5.hexdigest(key)[0, 12]}"
end

private def sqlite_database_file(adapter : A) : String? forall A
  database = adapter.current_database
  database == ":memory:" ? nil : database
end
