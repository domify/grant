module grant/model

# A curated model facade. Re-export modules for generated qualified references,
# and explicit type aliases for consumers choosing `import grant/model::*`.
pub import grant/record_repository
pub import grant/query
pub import grant/value
pub import grant/scalars
pub import grant/errors
pub import grant/database
pub import grant/validation
pub import grant/lifecycle
pub import grant/timestamps
pub import grant/unit_of_work

pub alias Mapping = ::Grant::RecordRepository::Mapping
pub alias Repository = ::Grant::RecordRepository::Repository
pub alias Table = ::Grant::Query::Table
pub alias Query = ::Grant::Query::Query
pub alias Value = ::Grant::Value::Value
pub alias Row = ::Grant::Value::Row
pub alias Attributes = ::Grant::Value::Attributes
pub alias Binary = ::Grant::Value::Binary
pub alias Decimal = ::Grant::Scalars::Decimal
pub alias Date = ::Grant::Scalars::Date
pub alias DateTime = ::Grant::Scalars::DateTime
pub alias Database = ::Grant::Database::Database
pub alias DatabaseError = ::Grant::Errors::DatabaseError
pub alias ValidationError = ::Grant::Errors::ValidationError
pub alias CallbackAbort = ::Grant::Errors::CallbackAbort
pub alias Errors = ::Grant::Validation::Errors
pub alias Context = ::Grant::Validation::Context
pub alias Presence = ::Grant::Validation::Presence
pub alias Rules = ::Grant::Validation::Rules
pub alias Pipeline = ::Grant::Lifecycle::Pipeline
pub alias Event = ::Grant::Lifecycle::Event
pub alias WriteContext = ::Grant::Lifecycle::WriteContext
pub alias Clock = ::Grant::Timestamps::Clock
pub alias SystemClock = ::Grant::Timestamps::SystemClock
pub alias Timestamps = ::Grant::Timestamps::Timestamps
pub alias UnitOfWork = ::Grant::UnitOfWork::UnitOfWork

# Strict checked hydration: a missing column is not an implicitly defaulted
# attribute, and an exact decimal can never be reconstructed from a Float64.
pub def record_value(values : Attributes, name : String, target : T.class) : T | DatabaseError forall T
  return DatabaseError.new(20, "mapping", "missing column: #{name}") unless values.has_key?(name)
  value = values[name]
  return value if value.is_a?(T)
  {% if T.union_types.includes?(Bool) && T.union_types.all? { |member| member == Bool || member == Nil } %}
    return false if value == 0_i64
    return true if value == 1_i64
  {% elsif T.union_types.includes?(Float64) && T.union_types.all? { |member| member == Float64 || member == Nil } %}
    return value.to_f64 if value.is_a?(Int64)
  {% elsif T.union_types.includes?(Decimal) && T.union_types.all? { |member| member == Decimal || member == Nil } %}
    decoded = ::Grant::Value.decode_decimal(value)
    return decoded if decoded.is_a?(DatabaseError)
    return decoded
  {% elsif T.union_types.includes?(Date) && T.union_types.all? { |member| member == Date || member == Nil } %}
    decoded = ::Grant::Value.decode_date(value)
    return decoded if decoded.is_a?(DatabaseError)
    return decoded
  {% elsif T.union_types.includes?(DateTime) && T.union_types.all? { |member| member == DateTime || member == Nil } %}
    decoded = ::Grant::Value.decode_datetime(value)
    return decoded if decoded.is_a?(DatabaseError)
    return decoded
  {% end %}
  DatabaseError.new(20, "mapping", "invalid column type: #{name}")
end

# Application-local table configuration, read only by its own model derive.
pub macro table(name, primary_key = "id")
  {% unless name.is_a?(StringLiteral) && !name.empty? && primary_key.is_a?(StringLiteral) && !primary_key.empty? %}
    {% raise "table requires nonempty literal table and primary-key names" %}
  {% end %}
  GRANT_MODEL_TABLE_NAME = {{name}}
  GRANT_MODEL_PRIMARY_KEY = {{primary_key}}
end

# Stateless adapter shared by models; the connection stays in Repository.
pub struct ModelMapping(T)
end

impl Mapping(T) for ModelMapping(T) forall T
  def table : Table
    T.__grant_model_table
  end

  def attributes(record : T) : Attributes
    record.to_attributes
  end

  def from_row(row : Row) : T | DatabaseError
    T.from_attributes(row.attributes)
  end

  def with_attributes(record : T, values : Attributes) : T | DatabaseError
    T.from_attributes(values)
  end

  def validate(record : T) : Nil | ValidationError | DatabaseError
    T.__grant_model_validate(record)
  end
end

# Reads configuration declared on this model, never a global model registry.
pub macro model(declaration)
  {% unless @type.has_constant?("GRANT_MODEL_TABLE_NAME") %}
    {% raise "derive model requires table \"table_name\" above the derive" %}
  {% end %}
  {% presence_names = @type.has_constant?("GRANT_MODEL_PRESENCE_FIELDS") ? @type.constant("GRANT_MODEL_PRESENCE_FIELDS") : [] of ASTNode %}
  {% for name in presence_names %}
    {% unless declaration[:fields].any? { |field| field[:name][1..] == name } %}
      {% raise "validates_presence references unknown model field #{name}" %}
    {% end %}
  {% end %}

  derive field_constructor, mapped_record

  def self.mapping : ::Grant::Model::ModelMapping({{declaration[:name].id}})
    ::Grant::Model::ModelMapping({{declaration[:name].id}}).new
  end

  def self.__grant_model_table : ::Grant::Model::Table
    ::Grant::Model::Table.new(GRANT_MODEL_TABLE_NAME, GRANT_MODEL_PRIMARY_KEY)
  end

  def self.__grant_model_validate(record : self) : Nil | ::Grant::Model::ValidationError | ::Grant::Model::DatabaseError
    errors = ::Grant::Model::Errors.new
    values = record.to_attributes
    {% for name in presence_names %}
      ::Grant::Model::Presence.new({{name}}).validate(values, errors, ::Grant::Model::Context.new)
    {% end %}
    errors.result
  end
end

# Declare a read-only typed field and a per-construction default factory.
# Keep defaults as expressions so mutable values are not shared across records.
pub macro field(declaration)
  {% unless declaration.is_a?(TypeDeclaration) %}
    {% raise "field requires a typed declaration, for example field name : String = \"\"" %}
  {% end %}
  getter {{declaration.var}} : {{declaration.type}}

  def self.__grant_field_default_{{declaration.var.id}} : {{declaration.type}}
    {% if declaration.value.is_a?(Nop) %}
      {% if declaration.type.resolve.nilable? %}
        nil
      {% else %}
        {% raise "field #{declaration.var} requires a default; use an explicit constructor for required arguments" %}
      {% end %}
    {% else %}
      {{declaration.value}}
    {% end %}
  end
end

# Opt-in constructor generation; place after all field declarations.
pub macro field_constructor(declaration)
  def initialize(
    {% for field in declaration[:fields] %}
      {{field[:name].id}} : {{field[:type]}} = {{declaration[:name].id}}.__grant_field_default_{{field[:name][1..].id}},
    {% end %}
  )
  end
end

# Runs in the sealed record's declaring module, using only its declared fields.
# The application supplies a typed keyword constructor matching those fields.
pub macro mapped_record(declaration)
  {% for field in declaration[:fields] %}
    {% unless field[:type] && field[:type] <= ::Grant::Model::Value %}
      {% raise "mapped_record field #{field[:name]} must have a declared Grant Value type; use an explicit mapping for association caches or custom converters" %}
    {% end %}
  {% end %}
  def to_attributes : ::Grant::Model::Attributes
    {
      {% for field in declaration[:fields] %}
        {{ field[:name][1..] }} => {{ field[:name].id }},
      {% end %}
    } of String => ::Grant::Model::Value
  end

  def self.from_attributes(values : ::Grant::Model::Attributes) : self | ::Grant::Model::DatabaseError
    {% for field in declaration[:fields] %}
      field_{{ field[:name][1..].id }} = ::Grant::Model.record_value(values, {{ field[:name][1..] }}, {{ field[:type] }})!
    {% end %}
    new(
      {% for field in declaration[:fields] %}
        {{ field[:name][1..].id }}: field_{{ field[:name][1..].id }},
      {% end %}
    )
  end
end

# Place inside the application's own `impl Mapping(Record) for RecordMapping`.
# Business validation, normalization, readonly fields and callbacks stay local.
pub macro mapped(record_type, table_name, primary_key = "id", rebuild = true)
  def table : ::Grant::Model::Table
    ::Grant::Model::Table.new({{table_name}}, {{primary_key}})
  end

  def attributes(record : {{record_type}}) : ::Grant::Model::Attributes
    record.to_attributes
  end

  def from_row(row : ::Grant::Model::Row) : {{record_type}} | ::Grant::Model::DatabaseError
    {{record_type}}.from_attributes(row.attributes)
  end

  {% if rebuild %}
    def with_attributes(record : {{record_type}}, values : ::Grant::Model::Attributes) : {{record_type}} | ::Grant::Model::DatabaseError
      {{record_type}}.from_attributes(values)
    end
  {% end %}
end

# Model form: validates_presence "name", "other".
# Explicit mapping form remains validates_presence Record, "name".
pub macro validates_presence(record_type, *names)
  {% if record_type.is_a?(StringLiteral) %}
    {% for name in names %}
      {% unless name.is_a?(StringLiteral) %}
        {% raise "model validates_presence takes literal field names" %}
      {% end %}
    {% end %}
    GRANT_MODEL_PRESENCE_FIELDS = [{{record_type}}, {% for name in names %} {{name}}, {% end %}]
  {% else %}
    def validate(record : {{record_type}}) : Nil | ::Grant::Model::ValidationError | ::Grant::Model::DatabaseError
      errors = ::Grant::Model::Errors.new
      values = attributes(record)
      {% for name in names %}
        ::Grant::Model::Presence.new({{name}}).validate(values, errors, ::Grant::Model::Context.new)
      {% end %}
      errors.result
    end
  {% end %}
end
