module grant/transaction

import std/indexable
import std/text
import std/enumerable
pub import grant/callbacks
import grant/callbacks::{CommitCallback}

import grant/adapter/sqlite::{Connection, Mutation}
import grant/adapter/base::{Base}
import grant/errors::{DatabaseError, Rollback, ErrorBase, TransactionIsolationError, NotOpenError, InvalidSavepointNameError}
pub import grant/errors

pub enum IsolationLevel
  ReadUncommitted
  ReadCommitted
  RepeatableRead
  Serializable

  def to_sql : String | ErrorBase
    case self
    when ReadUncommitted then "READ UNCOMMITTED"
    when ReadCommitted then "READ COMMITTED"
    when RepeatableRead then "REPEATABLE READ"
    when Serializable then "SERIALIZABLE"
    else ErrorBase.new("Unknown isolation level: #{self}")
    end
  end
end

pub struct Options
  getter isolation : IsolationLevel?
  getter readonly : Bool
  getter requires_new : Bool
  getter joinable : Bool
  getter independent : Bool
  getter lazy_begin : Bool

  def initialize(@isolation : IsolationLevel? = nil, @readonly : Bool = false, @requires_new : Bool = false, @joinable : Bool = true, @independent : Bool = false, @lazy_begin : Bool = false)
  end
end

# Connection state shared by every model, without an import cycle with Base.
pub class TransactionState
  getter adapter : Connection
  getter connection : Connection
  getter options : Options
  getter list_of_record_rollback_actions = [] of Proc(Nil)
  getter savepoint_counter : Int32 = 0
  getter enclosing : TransactionState?
  getter pending_callbacks = [] of NamedTuple(on_commit: Proc(Nil | ::Grant::Error::ErrorBase), on_rollback: Proc(Nil))
  getter record_callbacks = {} of UInt64 => CommitCallback
  property open : Bool = true
  property manual : Bool = false
  getter manual_savepoints = [] of Handle
  @handle : Handle? = nil

  def handle : Handle
    @handle ||= Handle.new(self)
  end
  getter after_all_commit_callbacks = [] of Proc(Nil)
  # Native iyi schedules fibers on one thread; each runtime fiber owns its stack.
  @@transaction_stacks = {} of UInt64 => Array(TransactionState)

  def self.fiber_stack : Array(TransactionState)
    key = IyiScheduler.current.object_id
    stack = @@transaction_stacks[key]?
    if stack.nil?
      stack = [] of TransactionState
      @@transaction_stacks[key] = stack
    end
    stack
  end
  @@statement_observer : Proc(String, Nil)? = nil

  def initialize(@adapter : Connection, @connection : Connection, @options : Options, @enclosing : TransactionState? = nil)
  end

  def next_savepoint_name : String
    parent = @enclosing
    return parent.next_savepoint_name unless parent.nil?
    @savepoint_counter += 1
    "sp_#{@savepoint_counter}"
  end

  def self.statement_observer : Proc(String, Nil)?
    @@statement_observer
  end

  def self.statement_observer=(observer : Proc(String, Nil)?) : Nil
    @@statement_observer = observer
  end

  def self.log_statement(sql : String) : Nil
    observer = @@statement_observer
    observer.call(sql) unless observer.nil?
  end

  def self.push(state : TransactionState) : Nil
    fiber_stack << state
  end

  def self.pop : Nil
    stack = fiber_stack
    stack.pop
    @@transaction_stacks.delete(IyiScheduler.current.object_id) if stack.empty?
    nil
  end

  def self.current_state_for?(adapter : Connection) : TransactionState?
    index = fiber_stack.size - 1
    while index >= 0
      state = fiber_stack[index]
      return state if state.adapter.object_id == adapter.object_id
      index -= 1
    end
    nil
  end

  def self.current_state? : TransactionState?
    fiber_stack.last?
  end

  def self.current_state_for_connection?(connection : Connection) : TransactionState?
    index = fiber_stack.size - 1
    while index >= 0
      state = fiber_stack[index]
      return state if state.connection.object_id == connection.object_id
      index -= 1
    end
    nil
  end

  def self.in_explicit_transaction? : Bool
    !fiber_stack.empty?
  end
end

pub struct SavepointMarker
  getter name : String
  getter marks : NamedTuple(callbacks: Int32, records: Int32, after_all: Int32)

  def initialize(@name : String, @marks : NamedTuple(callbacks: Int32, records: Int32, after_all: Int32))
  end
end

pub class Handle
  getter state : TransactionState?

  @savepoint : SavepointMarker? = nil
  @settled : Bool = false

  def initialize(@state : TransactionState?)
  end

  def initialize(@state : TransactionState, @savepoint : SavepointMarker)
  end

  def savepoint? : SavepointMarker?
    @savepoint
  end

  def settle : Nil
    @settled = true
  end

  def commit : Nil | ::Grant::Error::ErrorBase | DatabaseError | NotOpenError
    ::Grant::Transaction.commit_manual(self)
  end

  def rollback : Nil | DatabaseError | NotOpenError
    ::Grant::Transaction.rollback_manual(self)
  end

  def open? : Bool
    state = @state
    !state.nil? && state.open && !@settled
  end

  def closed? : Bool
    !open?
  end

  def isolation : IsolationLevel?
    state = @state
    state.nil? ? nil : state.options.isolation
  end

  def readonly? : Bool
    state = @state
    !state.nil? && state.options.readonly
  end

  def after_commit(&block : -> Nil) : Nil
    state = @state
    if !state.nil? && open?
      state.pending_callbacks << {on_commit: -> { block.call.as(Nil | ErrorBase) }, on_rollback: -> { nil }}
    else
      block.call
    end
    nil
  end

  def after_rollback(&block : -> Nil) : Nil
    state = @state
    if !state.nil? && open?
      state.pending_callbacks << {on_commit: -> { nil.as(Nil | ErrorBase) }, on_rollback: block}
    end
    nil
  end
end

pub def current_transaction(adapter : Connection) : Handle
  state = TransactionState.current_state_for?(adapter)
  state.nil? ? Handle.new(nil) : state.handle
end

pub def in_explicit_transaction? : Bool
  TransactionState.in_explicit_transaction?
end

pub def current_connection?(adapter : Connection) : Connection?
  state = TransactionState.current_state_for?(adapter)
  state.nil? ? nil : state.connection
end

pub def enlist_record_rollback_action(connection : Connection, &block : -> Nil) : Nil
  state = TransactionState.current_state_for_connection?(connection)
  state.list_of_record_rollback_actions << block unless state.nil?
end

pub def queue_record_callbacks(connection : Connection, record_id : UInt64, operation : Symbol, on_commit : Proc(Symbol, Nil | ::Grant::Error::ErrorBase), on_rollback : Proc(Symbol, Nil)) : Nil | ::Grant::Error::ErrorBase
  state = TransactionState.current_state_for_connection?(connection)
  if state.nil?
    return on_commit.call(operation)
  end
  existing = state.record_callbacks[record_id]?
  unless existing.nil?
    existing.merge(operation)
    return nil
  end
  callback = CommitCallback.new(operation, on_commit, on_rollback)
  state.record_callbacks[record_id] = callback
  state.pending_callbacks << {on_commit: -> { callback.commit }, on_rollback: -> { callback.rollback }}
  nil
end

pub def run(adapter : Base, options : Options, savepoint_name : String? = nil, &block : -> T) : T | Nil | ErrorBase forall T
  connection = adapter.pinned_connection? || adapter.database!.checkout!
  run(connection, options, savepoint_name) { yield }
end

pub def run(adapter : Connection, options : Options, savepoint_name : String? = nil, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase forall T
  enclosing = TransactionState.current_state_for?(adapter)
  return TransactionIsolationError.new if enclosing && options.isolation && !options.independent
  if enclosing && !options.requires_new && !options.independent && enclosing.options.joinable
    # Joined blocks swallow Rollback without undoing the enclosing writes.
    TransactionState.push(enclosing)
    result = yield
    TransactionState.pop
    return nil if result.is_a?(Rollback)
    return result
  end

  connection = options.independent ? adapter.open_independent! : (enclosing.nil? ? adapter : enclosing.connection)
  outer = !connection.in_transaction?
  savepoint = outer || enclosing.nil? ? "" : (savepoint_name || enclosing.next_savepoint_name)
  begun = execute_control(connection, outer ? begin_statements(adapter, options)[0] : "SAVEPOINT #{savepoint}")
  if begun.is_a?(DatabaseError)
    connection.close if options.independent
    return begun
  end
  state = TransactionState.new(adapter, connection, options, outer ? nil : enclosing)
  TransactionState.push(state)
  result = yield
  TransactionState.pop
  state.open = false
  if result.is_a?(::Error)
    execute_control(connection, outer ? "ROLLBACK" : "ROLLBACK TO SAVEPOINT #{savepoint}")!
    execute_control(connection, "RELEASE SAVEPOINT #{savepoint}")! unless outer
    restore_records(state)
    state.pending_callbacks.each { |callback| callback[:on_rollback].call }
    connection.close! if options.independent
    return nil if result.is_a?(Rollback)
    return result
  end

  committed = execute_control(connection, outer ? "COMMIT" : "RELEASE SAVEPOINT #{savepoint}")
  if committed.is_a?(DatabaseError)
    execute_control(connection, outer ? "ROLLBACK" : "ROLLBACK TO SAVEPOINT #{savepoint}")
    execute_control(connection, "RELEASE SAVEPOINT #{savepoint}") unless outer
    restore_records(state)
    state.pending_callbacks.each { |callback| callback[:on_rollback].call }
    connection.close if options.independent
    return committed
  end
  unless outer || enclosing.nil?
    state.record_callbacks.each do |record_id, callback|
      existing = enclosing.record_callbacks[record_id]?
      if existing.nil?
        enclosing.record_callbacks[record_id] = callback
      else
        existing.merge(callback.operation)
        callback.active = false
      end
    end
    state.list_of_record_rollback_actions.each do |action|
      enclosing.list_of_record_rollback_actions << action
    end
    state.pending_callbacks.each { |callback| enclosing.pending_callbacks << callback }
    state.after_all_commit_callbacks.each { |callback| enclosing.after_all_commit_callbacks << callback }
  end
  connection.close! if options.independent
  if outer
    state.pending_callbacks.each { |callback| callback[:on_commit].call! }
    finalize_after_all_commit(state)
  end
  result
end

private def restore_records(state : TransactionState) : Nil
  index = state.list_of_record_rollback_actions.size - 1
  while index >= 0
    state.list_of_record_rollback_actions[index].call
    index -= 1
  end
end

# Native iyi cannot reopen Connection; a trait defined here preserves
# the connection-level public transaction API.
pub trait ConnectionTransactions
  abstract def begin_transaction(options : ::Grant::Transaction::Options = ::Grant::Transaction::Options.new) : ::Grant::Transaction::Handle | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError
  abstract def commit : Nil | ::Grant::Error::ErrorBase | ::Grant::Errors::DatabaseError | ::Grant::Errors::NotOpenError
  abstract def rollback : Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::NotOpenError
  abstract def savepoint(name : String? = nil, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Errors::NotOpenError | ::Grant::Errors::InvalidSavepointNameError | ::Grant::Error::ErrorBase forall T
  abstract def transaction(options : ::Grant::Transaction::Options = ::Grant::Transaction::Options.new, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase forall T
end

impl ConnectionTransactions for Connection
  def begin_transaction(options : ::Grant::Transaction::Options = ::Grant::Transaction::Options.new) : ::Grant::Transaction::Handle | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError
    ::Grant::Transaction.begin_manual(self, options)
  end

  def commit : Nil | ::Grant::Error::ErrorBase | ::Grant::Errors::DatabaseError | ::Grant::Errors::NotOpenError
    ::Grant::Transaction.commit_manual(::Grant::Transaction.innermost_manual_handle(self)!)
  end

  def rollback : Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::NotOpenError
    ::Grant::Transaction.rollback_manual(::Grant::Transaction.innermost_manual_handle(self)!)
  end

  def savepoint(name : String? = nil, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Errors::NotOpenError | ::Grant::Errors::InvalidSavepointNameError | ::Grant::Error::ErrorBase forall T
    ::Grant::Transaction.with_savepoint(self, name) { yield }
  end

  def transaction(options : ::Grant::Transaction::Options = ::Grant::Transaction::Options.new, &block : -> T) : T | Nil | ::Grant::Errors::DatabaseError | ::Grant::Errors::TransactionIsolationError | ::Grant::Error::ErrorBase forall T
    ::Grant::Transaction.run(self, options) { yield }
  end
end

# SQLite branch of the upstream adapter-specific control statement builder.
pub def begin_statements(adapter : Connection, options : Options) : Array(String)
  case options.isolation
  when nil then ["BEGIN"]
  when IsolationLevel::Serializable then ["BEGIN EXCLUSIVE"]
  when IsolationLevel::ReadUncommitted then ["BEGIN DEFERRED"]
  else ["BEGIN IMMEDIATE"]
  end
end

private def execute_control(connection : Connection, sql : String) : Mutation | DatabaseError
  TransactionState.log_statement(sql)
  connection.execute(sql)
end

# Manual transactions retain the state until their handle is settled.
pub def begin_manual(adapter : Connection, options : Options) : Handle | DatabaseError | TransactionIsolationError
  state = TransactionState.current_state_for?(adapter)
  unless state.nil?
    return TransactionIsolationError.new if options.isolation
    name = state.next_savepoint_name
    marks = {callbacks: state.pending_callbacks.size, records: state.list_of_record_rollback_actions.size, after_all: state.after_all_commit_callbacks.size}
    execute_control(state.connection, "SAVEPOINT #{name}")!
    handle = Handle.new(state, SavepointMarker.new(name, marks))
    state.manual_savepoints << handle
    return handle
  end

  execute_control(adapter, begin_statements(adapter, options)[0])!
  state = TransactionState.new(adapter, adapter, options)
  state.manual = true
  TransactionState.push(state)
  state.handle
end

pub def commit_manual(handle : Handle) : Nil | ::Grant::Error::ErrorBase | DatabaseError | NotOpenError
  state = handle.state
  return NotOpenError.new unless !state.nil? && handle.open?
  marker = handle.savepoint?
  unless marker.nil?
    execute_control(state.connection, "RELEASE SAVEPOINT #{marker.name}")!
    handle.settle
    state.manual_savepoints.delete(handle)
    return nil
  end
  return NotOpenError.new("Transaction was not opened with begin_transaction") unless state.manual
  result = execute_control(state.connection, "COMMIT")
  if result.is_a?(DatabaseError)
    rollback_manual(handle)
    return result
  end
  TransactionState.pop
  state.open = false
  release_manual(state)
  state.pending_callbacks.each { |callback| callback[:on_commit].call! }
  finalize_after_all_commit(state)
  nil
end

pub def rollback_manual(handle : Handle) : Nil | DatabaseError | NotOpenError
  state = handle.state
  return NotOpenError.new unless !state.nil? && handle.open?
  marker = handle.savepoint?
  unless marker.nil?
    execute_control(state.connection, "ROLLBACK TO SAVEPOINT #{marker.name}")!
    while state.list_of_record_rollback_actions.size > marker.marks[:records]
      state.list_of_record_rollback_actions.pop.call
    end
    callbacks = [] of NamedTuple(on_commit: Proc(Nil | ::Grant::Error::ErrorBase), on_rollback: Proc(Nil))
    index = marker.marks[:callbacks]
    while index < state.pending_callbacks.size
      callbacks << state.pending_callbacks[index]
      index += 1
    end
    while state.pending_callbacks.size > marker.marks[:callbacks]
      state.pending_callbacks.pop
    end
    handle.settle
    state.manual_savepoints.delete(handle)
    while state.after_all_commit_callbacks.size > marker.marks[:after_all]
      state.after_all_commit_callbacks.pop
    end
    callbacks.each { |callback| callback[:on_rollback].call }
    return nil
  end
  return NotOpenError.new("Transaction was not opened with begin_transaction") unless state.manual
  execute_control(state.connection, "ROLLBACK")!
  TransactionState.pop
  state.open = false
  restore_records(state)
  release_manual(state)
  state.pending_callbacks.each { |callback| callback[:on_rollback].call }
  nil
end

private def release_manual(state : TransactionState) : Nil
  state.manual_savepoints.each { |handle| handle.settle }
  state.manual_savepoints.clear
end

pub def with_savepoint(adapter : Connection, name : String?, &block : -> T) : T | Nil | DatabaseError | TransactionIsolationError | NotOpenError | InvalidSavepointNameError | ErrorBase forall T
  state = TransactionState.current_state_for?(adapter)
  return NotOpenError.new("Savepoints require an open transaction") if state.nil?
  unless name.nil?
    return InvalidSavepointNameError.new("Invalid savepoint name: #{name.inspect}") unless valid_savepoint_name?(name)
  end
  run(adapter, Options.new(requires_new: true), name) { yield }
end

private def valid_savepoint_name?(name : String) : Bool
  return false if name.empty?
  index = 0
  name.each_byte do |byte|
    letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    digit = byte >= 48 && byte <= 57
    return false unless letter || (index > 0 && digit)
    index += 1
  end
  true
end


pub def innermost_manual_handle(adapter : Connection) : Handle | NotOpenError
  state = TransactionState.current_state_for?(adapter)
  return NotOpenError.new if state.nil?
  nested = state.manual_savepoints.last?
  return nested unless nested.nil?
  return NotOpenError.new("The open transaction was not started with begin_transaction") unless state.manual
  state.handle
end


pub def after_all_transactions_commit(&block : -> Nil) : Nil
  state = TransactionState.current_state?
  if state.nil?
    block.call
  else
    state.after_all_commit_callbacks << block
  end
  nil
end

pub def enqueue_pending_callback(on_commit : Proc(Nil), on_rollback : Proc(Nil)) : Nil
  state = TransactionState.current_state?
  if state.nil?
    on_commit.call
  else
    state.pending_callbacks << {on_commit: -> { on_commit.call.as(Nil | ErrorBase) }, on_rollback: on_rollback}
  end
  nil
end

private def finalize_after_all_commit(state : TransactionState) : Nil
  parent = TransactionState.current_state?
  if parent.nil?
    state.after_all_commit_callbacks.each { |callback| callback.call }
  else
    state.after_all_commit_callbacks.each { |callback| parent.after_all_commit_callbacks << callback }
  end
  nil
end
