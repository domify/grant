module grant/transaction

import grant/database::{Database}
import grant/errors::{DatabaseError}
import grant/value::{Value}

# Joined nested blocks share the outer transaction. requires_new uses a
# savepoint. Explicit error values propagate to the owning transaction.
pub def transaction(database : Database, requires_new : Bool = false, &block : -> T) : T | DatabaseError | Panicked | Cancelled forall T
  inside = database.in_transaction?
  if inside && !requires_new
    return group { |tasks| tasks.spawn { block.call }.value }
  end
  name = inside ? database.savepoint_name : nil
  begin_sql = name ? "SAVEPOINT #{name}" : "BEGIN"
  commit_sql = name ? "RELEASE SAVEPOINT #{name}" : "COMMIT"
  rollback_sql = name ? "ROLLBACK TO SAVEPOINT #{name}" : "ROLLBACK"
  release_sql = name ? "RELEASE SAVEPOINT #{name}" : nil
  database.execute(begin_sql, [] of Value)!
  outcome = group { |tasks| tasks.spawn { block.call }.value }
  if outcome.is_a?(Error)
    cleanup = rollback(database, rollback_sql, release_sql)
    if cleanup.is_a?(DatabaseError)
      return DatabaseError.new(cleanup.code, "rollback", "#{cleanup.detail}; original error: #{outcome.message}")
    end
    outcome
  else
    committed = database.execute(commit_sql, [] of Value)
    if committed.is_a?(DatabaseError)
      cleanup = rollback(database, rollback_sql, release_sql)
      if cleanup.is_a?(DatabaseError)
        return DatabaseError.new(cleanup.code, "rollback", "#{cleanup.detail}; commit error: #{committed.detail}")
      end
      committed
    else
      outcome
    end
  end
end

def rollback(database : Database, command : String, release : String?) : Nil | DatabaseError
  database.execute(command, [] of Value)!
  database.execute(release, [] of Value)! if release
  nil
end
