module grant/scoping

import grant/query/builder::{Builder}

# Native scheduler identities replace the upstream Fiber-local slots.
@@unscoped_fibers = {} of Tuple(UInt64, String) => Bool
@@scoping_stacks = {} of Tuple(UInt64, String) => Array(ScopeEntry)

pub abstract class ScopeEntry
end

pub class RelationEntry(Model) < ScopeEntry
  getter relation : Builder(Model)

  def initialize(@relation : Builder(Model))
  end
end

pub class UnscopedEntry < ScopeEntry
end

pub def unscoped?(model_name : String) : Bool
  @@unscoped_fibers[{IyiScheduler.current.object_id, model_name}]? == true
end

pub def set_unscoped(model_name : String, value : Bool) : Nil
  key = {IyiScheduler.current.object_id, model_name}
  if value
    @@unscoped_fibers[key] = true
  else
    @@unscoped_fibers.delete(key)
  end
  nil
end

pub def current_relation(model : Model.class) : Builder(Model)? forall Model
  stack = @@scoping_stacks[{IyiScheduler.current.object_id, model.to_s}]?
  return nil if stack.nil? || stack.empty?
  entry = stack.last
  entry.is_a?(RelationEntry(Model)) ? entry.relation.chain_copy : nil
end

pub def with_relation(model : Model.class, relation : Builder(Model), &block : -> T) : T forall Model, T
  push_entry(model.to_s, RelationEntry(Model).new(relation)) { yield }
end

pub def without_relation(model_name : String, &block : -> T) : T forall T
  push_entry(model_name, UnscopedEntry.new) { yield }
end

private def push_entry(model_name : String, entry : ScopeEntry, &block : -> T) : T forall T
  key = {IyiScheduler.current.object_id, model_name}
  stack = @@scoping_stacks[key]? || [] of ScopeEntry
  @@scoping_stacks[key] = stack
  stack << entry
  result = yield
  stack.pop
  @@scoping_stacks.delete(key) if stack.empty?
  result
end
