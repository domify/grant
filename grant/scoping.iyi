module grant/scoping

import grant/query/builder::{Builder}

# Native scheduler identities replace the upstream Fiber-local slots.
@@unscoped_fibers = {} of Tuple(UInt64, String) => Bool
@@scoping_stacks = {} of Tuple(UInt64, String) => Array(ScopeEntry)

pub abstract class ScopeEntry
end

pub class RelationEntry(Model) < ScopeEntry
  getter relation : Builder(Model)

  def initialize(@relation : Builder(Model))
  end
end

pub class UnscopedEntry < ScopeEntry
end

pub def unscoped?(model_name : String) : Bool
  @@unscoped_fibers[{IyiScheduler.current.object_id, model_name}]? == true
end

pub def set_unscoped(model_name : String, value : Bool) : Nil
  key = {IyiScheduler.current.object_id, model_name}
  if value
    @@unscoped_fibers[key] = true
  else
    @@unscoped_fibers.delete(key)
  end
  nil
end

pub def current_relation(model : Model.class) : Builder(Model)? forall Model
  stack = @@scoping_stacks[{IyiScheduler.current.object_id, model.to_s}]?
  return nil if stack.nil? || stack.empty?
  entry = stack.last
  entry.is_a?(RelationEntry(Model)) ? entry.relation.chain_copy : nil
end

pub def with_relation(model : Model.class, relation : Builder(Model), &block : -> T) : T forall Model, T
  push_entry(model.to_s, RelationEntry(Model).new(relation)) { yield }
end

pub def without_relation(model_name : String, &block : -> T) : T forall T
  push_entry(model_name, UnscopedEntry.new) { yield }
end

private def push_entry(model_name : String, entry : ScopeEntry, &block : -> T) : T forall T
  key = {IyiScheduler.current.object_id, model_name}
  stack = @@scoping_stacks[key]? || [] of ScopeEntry
  @@scoping_stacks[key] = stack
  stack << entry
  result = yield
  stack.pop
  @@scoping_stacks.delete(key) if stack.empty?
  result
end

pub annotation NamedScope
end

pub macro scope(name, body)
  @[::Grant::Scoping::NamedScope(name: {{ name }}, body: {{ body }})]
  def __named_scope_{{ name.id }} : Nil
    nil
  end
end

# Class finder and delete delegations from upstream Grant::Scoping.
pub macro model_methods(model)
  {% scopes = model.resolve.methods.select { |method| method.annotation(::Grant::Scoping::NamedScope) } %}
  {% unless scopes.empty? %}
    pub class BuildNamedScopeRelation < ::Grant::Query::Builder::Builder({{ model }})
      def self.adopt(result : ::Grant::Query::Builder::Builder({{ model }})) : BuildNamedScopeRelation
        relation = new(result.db_type, result.boolean_operator)
        relation.copy_state_from(result)
        relation
      end

      def chain_copy : self
        copy = BuildNamedScopeRelation.new(db_type, boolean_operator)
        copy.copy_state_from(self)
        copy
      end

      {% for method in scopes %}
        {% ann = method.annotation(::Grant::Scoping::NamedScope) %}
        {% body = ann[:body] %}
        def {{ ann[:name].id }}(*args) : BuildNamedScopeRelation
          {% if body.args.size > 0 && body.args.first.restriction.stringify.includes?("Builder") %}
            BuildNamedScopeRelation.adopt(({{ body }}).call(self, *args))
          {% else %}
            BuildNamedScopeRelation.adopt(chain_copy.merge_builder(({{ body }}).call(*args)))
          {% end %}
        end
      {% end %}
    end
    {% for method in scopes %}
      {% ann = method.annotation(::Grant::Scoping::NamedScope) %}
      def self.{{ ann[:name].id }}(*args) : BuildNamedScopeRelation
        BuildNamedScopeRelation.adopt(current_scope).{{ ann[:name].id }}(*args)
      end
    {% end %}
  {% end %}

  def self.merge(other_scope : ::Grant::Query::Builder::Builder({{ model }})) : ::Grant::Query::Builder::Builder({{ model }})
    current = current_scope
    current.own_where_fields.concat(other_scope.where_fields)
    current.own_order_fields.concat(other_scope.order_fields)
    current.own_group_fields.concat(other_scope.group_fields)
    if incoming = other_scope.limit
      existing = current.limit
      current.limit_in_place(existing.nil? || incoming < existing ? incoming : existing)
    end
    if incoming = other_scope.offset
      existing = current.offset
      current.offset_in_place(existing.nil? || incoming > existing ? incoming : existing)
    end
    current
  end

  def self.delete(id : T) : Int64 | ::Grant::Error::ErrorBase forall T
    delete([id])
  end

  def self.delete(ids : Array(T)) : Int64 | ::Grant::Error::ErrorBase forall T
    return 0_i64 if ids.empty?
    current_scope.where({primary_name => ids}).delete_all
  end

  def self.find(ids : Array(T)) : Array({{ model }}) | ::Grant::Error::ErrorBase forall T
    current_scope.find(ids)
  end

  def self.find(first : A, second : B, *rest) : Array({{ model }}) | ::Grant::Error::ErrorBase forall A, B
    current_scope.find(first, second, *rest)
  end

  def self.find_strict(ids : Array(T)) : Array({{ model }}) | ::Grant::Error::ErrorBase forall T
    current_scope.find_strict(ids)
  end

  def self.find_strict(first : A, second : B, *rest) : Array({{ model }}) | ::Grant::Error::ErrorBase forall A, B
    current_scope.find_strict(first, second, *rest)
  end

  # Returns the last *count* records of the current scope in ascending order.
  def self.last(count : Int32) : Array({{ model }}) | ::Grant::Error::ErrorBase
    current_scope.last(count)
  end

  {% for name in %w(second third fourth fifth forty_two second_to_last third_to_last) %}
    # Returns the {{name.id.gsub(/_/, " ")}} record of the current scope, or `nil`.
    def self.{{name.id}} : {{ model }} | Nil | ::Grant::Error::ErrorBase
      current_scope.{{name.id}}
    end

    # Like `{{name.id}}`, but returns `RecordNotFound` when missing.
    def self.{{name.id}}_strict : {{ model }} | ::Grant::Error::ErrorBase
      current_scope.{{name.id}}_strict
    end
  {% end %}
end

pub annotation NamedScope
end

# Record declarations until the finished hook can emit the single relation subtype.
pub macro named_scope(name, body, model)
  @[::Grant::Scoping::NamedScope(name: {{ name }}, body: {{ body }})]
  def __named_scope_{{ name.id }} : Nil
    nil
  end
end
