module grant/scale/schema_tenant

import grant/adapter/base::{Base}
import grant/adapter/driver::{Connection}
import grant/error::{ErrorBase}

pub class SchemaTenantResetError < ErrorBase
  getter block_exception : ErrorBase?

  def initialize(message : String, cause : ErrorBase, @block_exception : ErrorBase? = nil)
    super(message, cause: cause)
  end
end

# Structural context slice from src/grant/scale/schema_tenant.cr.
pub class SchemaTenant
  pub class Context
    getter adapter : Base
    getter connection : Connection
    property schema : String
    property usable : Bool = true
    property reset_error : SchemaTenantResetError? = nil

    def initialize(@adapter : Base, @connection : Connection, @schema : String)
    end

    def usable? : Bool
      @usable
    end
  end
end
