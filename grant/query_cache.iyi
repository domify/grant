module grant/query_cache

import db/db/value::{DBValue}
import grant/adapter/pool_support
import grant/settings

# Keep bind arrays in a generic holder: iyi currently expands recursive DBValue
# aliases differently in tuple and instance-variable annotations.
pub abstract class BindKey
  abstract def ==(other : BindKey) : Bool
end

pub class TypedBindKey(B) < BindKey
  getter values : B

  def initialize(@values : B)
  end

  def ==(other : BindKey) : Bool
    other.is_a?(TypedBindKey(B)) && values == other.values
  end
end

pub alias Key = Tuple(UInt64, UInt64, String?, String, BindKey)

pub abstract class Slot
end

pub class ValueSlot(T) < Slot
  getter value : T
  def initialize(@value : T)
  end
end

pub class State
  getter entries = {} of Key => Slot
  property enabled : Bool = true
  property generation : UInt64
  getter hits : Int64 = 0_i64
  getter misses : Int64 = 0_i64

  def initialize(@generation : UInt64)
  end

  def enabled? : Bool
    @enabled
  end

  def clear : Nil
    @entries = {} of Key => Slot
    nil
  end

  def size : Int32
    @entries.size
  end

  def record_hit : Nil
    @hits += 1
    nil
  end

  def record_miss : Nil
    @misses += 1
    nil
  end
end

@@generation : UInt64 = 0_u64
@@states = {} of UInt64 => State

pub def invalidate_in_place : Nil
  @@generation += 1_u64
  nil
end

pub def generation : UInt64
  @@generation
end

pub def current? : State?
  @@states[IyiScheduler.current.object_id]?
end

pub def enabled? : Bool
  state = current?
  !state.nil? && state.enabled?
end

pub def cache(&block : -> T) : T forall T
  fiber = IyiScheduler.current.object_id
  existing = current?
  state = existing || State.new(generation)
  @@states[fiber] = state
  was_enabled = state.enabled?
  state.enabled = true
  defer restore(fiber, state, existing, was_enabled)
  yield
end

private def restore(fiber : UInt64, state : State, existing : State?, enabled : Bool) : Nil
  state.enabled = enabled
  if existing.nil?
    @@states.delete(fiber)
    state.clear
  end
  nil
end

pub def uncached(&block : -> T) : T forall T
  state = current?
  return yield if state.nil?
  was_enabled = state.enabled?
  state.enabled = false
  defer state.enabled = was_enabled
  yield
end

# The driver passes its physical connection identity: transaction and pinned
# connections therefore never share cached rows with another connection.
pub def fetch(adapter_id : UInt64, connection_id : UInt64, sql : String,
              binds : Array(DBValue), copy : Proc(T, T), &block : -> T) : T forall T
  state = current?
  return yield if state.nil? || !state.enabled?
  return yield unless ::Grant::Adapter::PoolSupport.idempotent_read?(sql)
  lowered = sql.downcase
  return yield if lowered.includes?("for update") || lowered.includes?("for share") || lowered.includes?("for no key update") || lowered.includes?("for key share")
  started = generation
  if state.generation != started
    state.clear
    state.generation = started
  end
  key = {adapter_id, connection_id, nil.as(String?), sql, TypedBindKey.new(binds.dup).as(BindKey)}
  if slot = state.entries.delete(key)
    if slot.is_a?(ValueSlot(T))
      state.entries[key] = slot
      state.record_hit
      return copy.call(slot.value)
    end
  end
  state.record_miss
  result = yield
  if generation == started && state.enabled? && !result.is_a?(::Error)
    max = ::Grant::Settings.settings.query_cache_max_entries
    if max > 0
      while state.entries.size >= max
        state.entries.delete(state.entries.keys.first)
      end
      state.entries[key] = ValueSlot(T).new(copy.call(result))
    end
  end
  result
end
