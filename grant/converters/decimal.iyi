module grant/converters/decimal

import std/big::{BigDecimal}
import std/regex::{Regex}
import std/text
import grant/error::{ArgumentError, ErrorBase}

pub def to_db(value : BigDecimal?) : String?
  value.nil? ? nil : value.to_s
end

pub def parse(text : String) : BigDecimal | ArgumentError
  value = text.strip
  return ArgumentError.new("Invalid decimal: #{text.inspect}") unless /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.match?(value)
  BigDecimal.new(value)
end

pub def from_db(value : V) : BigDecimal | Nil | ArgumentError forall V
  case value
  when BigDecimal then value
  when String then parse(value)
  when Int, Float then BigDecimal.new(value.to_s)
  else nil
  end
end

pub def from_rs(result : R) : BigDecimal | Nil | ErrorBase forall R
  value = result.read
  return value if value.is_a?(ErrorBase)
  value.nil? ? nil : parse(value.to_s)
end

