module grant/readonly

pub import grant/error

pub class ReadOnlyRecordError < ::Grant::Error::ErrorBase
end

impl ::Error for ReadOnlyRecordError
  def message : String
    @message
  end
end

pub annotation ReadonlyAttributes
end

# Metadata used by upstream Transactions#update_columns before assignment.
pub macro attr_readonly(*fields, **options)
  @[::Grant::Readonly::ReadonlyAttributes(fields: [{% for field in fields %}{{ field.id.stringify }},{% end %}])]
  def __readonly_declaration_{{ @type.methods.size }} : Nil
    nil
  end
end

pub macro model_methods(model)
  def self.readonly_attributes : Array(String)
    columns = [] of String
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::Readonly::ReadonlyAttributes) %}
        \{% for field in ann[:fields] %}
          columns << \{{ field }} unless columns.includes?(\{{ field }})
        \{% end %}
      \{% end %}
    \{% end %}
    columns
  end

  def self.readonly_attribute?(name : String) : Bool
    readonly_attributes.includes?(name)
  end
end
