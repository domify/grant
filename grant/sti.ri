module grant/sti

import grant/error::{ErrorBase}

pub annotation Root
end

pub class SubclassNotFound < ErrorBase
end

pub class ImmutableTypeError < ErrorBase
end

pub class TypeCastingError < ErrorBase
end


pub macro enable
  @[::Grant::Sti::Root]
  def __sti_root_marker : Nil
    nil
  end
  before_save :__sti_ensure_type_column
end

# The discriminator, table inheritance, query filter and row dispatch slice of STI.
pub macro model_methods(model)
  {% own_root = model.resolve.methods.any? { |m| m.annotation(::Grant::Sti::Root) } %}
  {% root = own_root ? model.resolve : model.resolve.ancestors.find { |a| a.methods.any? { |m| m.annotation(::Grant::Sti::Root) } } %}
  def self.__sti_table_name : String?
    {% if root && !own_root %}
      {{ root }}.table_name
    {% else %}
      nil
    {% end %}
  end

  def self.apply_sti_scope(query : ::Grant::Query::Builder::Builder(M)) : ::Grant::Query::Builder::Builder(M) forall M
    {% if root && !own_root %}
      query.where(inheritance_column, :in, sti_names_for_query)
    {% else %}
      query
    {% end %}
  end

  def self.__sti_rehome_row(row : ::Grant::Adapter::Driver::Row) : {{ model }} | Nil | ::Grant::Error::ErrorBase
    {% if root %}
      discriminator = row[inheritance_column]?
      {% for child in model.resolve.all_subclasses %}
        return {{ child }}.from_row(row) if discriminator == {{ child.stringify }}
      {% end %}
      if discriminator.is_a?(String) && !discriminator.empty? && discriminator != sti_name
        return ::Grant::Sti::SubclassNotFound.new("Invalid single-table inheritance type: #{discriminator}")
      end
    {% end %}
    nil
  end

  {% if root %}
    def self.inheritance_column : String
      "type"
    end

    def self.sti_name : String
      {{ model.stringify }}
    end

    def self.sti_root_class? : Bool
      {{ own_root }}
    end

    def self.sti_subclass? : Bool
      {{ !own_root }}
    end

    def self.sti_names_for_query : Array(String)
      \{% begin %}
      [{{ model.stringify }}, \{% for child in @type.all_subclasses %}\{{ child.stringify }}, \{% end %}] of String
      \{% end %}
    end

    {% unless own_root %}
      before_save :__sti_ensure_type_column
    {% end %}

    def __sti_ensure_type_column : Nil
      self.type = self.class.sti_name if self.type.nil? || self.type == ""
      nil
    end
  {% end %}
end
