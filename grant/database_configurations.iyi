module grant/database_configurations
import std/yaml::{YAML, Any}
import std/text
import std/env::{ENV}
import std/file::{File}
import grant/error::{ErrorBase}
import grant/adapter/registry::{Registry, UnknownAdapterError}

pub class DatabaseConfigurationError < ErrorBase
end
impl ::Error for DatabaseConfigurationError
  def message : String
    @message
  end
end

pub struct DatabaseConfig
  getter name : String
  getter env : String
  getter adapter_name : String
  getter url : String
  getter pool_size : Int32
  getter replica : Bool
  getter database_tasks : Bool
  getter database : String

  def initialize(@name : String, @env : String, @adapter_name : String, @url : String,
                 @pool_size : Int32 = 25, @replica : Bool = false,
                 @database_tasks : Bool = true, database : String? = nil)
    @database = database || @name
  end

  def adapter : Registry::AdapterClass | UnknownAdapterError
    Registry.for_scheme(adapter_name)
  end

  def adapter? : Registry::AdapterClass?
    Registry.for_scheme?(adapter_name)
  end

  def replica? : Bool
    replica
  end

  def database_tasks? : Bool
    database_tasks
  end

  def role : Symbol
    replica? ? :reading : :writing
  end

  def scheme : String?
    Registry.scheme_of(url)
  end

  def redacted_url : String
    Registry.redact(url)
  end
end

pub class DatabaseConfigurations
  pub struct Entry
    property url : String?
    getter adapter : String?
    getter pool : Int32
    getter replica : Bool
    getter database_tasks : Bool
    getter replica_of : String?
    getter database : String?

    def initialize(@url : String? = nil, @adapter : String? = nil, @pool : Int32 = 25,
                   @replica : Bool = false, @database_tasks : Bool = true,
                   @replica_of : String? = nil, @database : String? = nil)
    end

    def self.from_value(value : Any) : Entry | DatabaseConfigurationError
      mapping = value.as_h?
      return DatabaseConfigurationError.new("Invalid database configuration: entry must be a mapping") if mapping.nil?
      new((value["url"]? || Any.new(nil)).as_s?, (value["adapter"]? || Any.new(nil)).as_s?,
        ((value["pool"]? || Any.new(nil)).as_i? || 25_i64).to_i32,
        (value["replica"]? || Any.new(nil)).as_bool? || false,
        (value["database_tasks"]? || Any.new(nil)).as_bool? != false,
        (value["replica_of"]? || Any.new(nil)).as_s?, (value["database"]? || Any.new(nil)).as_s?)
    end
  end

  pub alias Source = Hash(String, Hash(String, Entry))
  PRIMARY_NAME = "primary"
  PROCESS_ENV = ->(key : String) { ENV[key]? }
  getter env : String
  getter configs : Array(DatabaseConfig)

  def initialize(@env : String, @configs : Array(DatabaseConfig))
  end

  def self.load(path : String, env : String,
                env_lookup : Proc(String, String?) = PROCESS_ENV) : DatabaseConfigurations | ErrorBase
    parse(File.read(path), env, env_lookup)
  end

  def self.parse(yaml : String, env : String,
                 env_lookup : Proc(String, String?) = PROCESS_ENV) : DatabaseConfigurations | ErrorBase
    document = YAML.parse?(yaml)
    return DatabaseConfigurationError.new("Invalid database configuration: invalid YAML") if document.nil?
    mapping = document.as_h?
    return DatabaseConfigurationError.new("Invalid database configuration: the file must map environments to databases") if mapping.nil?
    source = Source.new
    mapping.each do |env_name, body|
      entries = body.as_h?
      return DatabaseConfigurationError.new("Invalid database configuration: environment must be a mapping") if entries.nil?
      named = {} of String => Entry
      if entries.values.any? { |value| !value.as_h?.nil? }
        entries.each { |name, value| named[name.as_s] = Entry.from_value(value)! }
      else
        named[PRIMARY_NAME] = Entry.from_value(body)!
      end
      source[env_name.as_s] = named
    end
    load(source, env, env_lookup)
  end

  def self.load(source : Source, env : String,
                env_lookup : Proc(String, String?) = PROCESS_ENV) : DatabaseConfigurations | ErrorBase
    configs = [] of DatabaseConfig
    source.each do |env_name, entries|
      entries = with_url_overrides(entries, env_lookup) if env_name == env
      entries.each { |name, entry| configs << build(env_name, name, entry, env)! }
    end
    unless source.has_key?(env)
      with_url_overrides({} of String => Entry, env_lookup).each do |name, entry|
        configs << build(env, name, entry, env)!
      end
    end
    new(env, configs)
  end

  def configs_for(env : String? = nil, name : String? = nil,
                  include_replicas : Bool = true) : Array(DatabaseConfig)
    configs.select do |config|
      (env.nil? || config.env == env) && (name.nil? || config.name == name) &&
        (include_replicas || !config.replica?)
    end
  end

  def task_configs(env : String = @env) : Array(DatabaseConfig)
    configs_for(env: env, include_replicas: false).select(&.database_tasks?)
  end

  def find_db_config(name : String, env : String = @env) : DatabaseConfig?
    configs_for(env: env, name: name).first?
  end

  def db_config(name : String, env : String = @env) : DatabaseConfig | DatabaseConfigurationError
    find_db_config(name, env) || DatabaseConfigurationError.new(
      "No database configuration named #{name.inspect} for #{env.inspect}")
  end

  def config_for_database(database : String, replica : Bool = false) : DatabaseConfig?
    configs.find { |config| config.env == @env && config.database == database && config.replica? == replica }
  end

  private def self.with_url_overrides(entries : Hash(String, Entry),
                                     env_lookup : Proc(String, String?)) : Hash(String, Entry)
    merged = {} of String => Entry
    entries.each { |name, entry| merged[name] = entry }
    primary = PRIMARY_NAME
    unless merged.has_key?(PRIMARY_NAME)
      merged.each do |name, entry|
        unless entry.replica
          primary = name
          break
        end
      end
    end
    names = merged.keys
    names << primary unless names.includes?(primary)
    names.each do |name|
      url = env_lookup.call("#{name.upcase}_DATABASE_URL")
      url ||= env_lookup.call("DATABASE_URL") if name == primary
      next if url.nil? || url.empty?
      existing = merged[name]?
      adapter_name = Registry.scheme_of(url).nil? && !existing.nil? ? existing.adapter : nil
      merged[name] = existing.nil? ? Entry.new(url: url) :
        Entry.new(url, adapter_name, existing.pool, existing.replica, existing.database_tasks,
          existing.replica_of, existing.database)
    end
    merged
  end

  private def self.build(env_name : String, name : String, entry : Entry,
                         current_env : String) : DatabaseConfig | ErrorBase
    url = entry.url
    file = entry.database
    adapter = entry.adapter
    if url.nil? && !file.nil? && !adapter.nil? && adapter.downcase.starts_with?("sqlite")
      url = "sqlite3:#{file}"
    end
    return DatabaseConfigurationError.new("Database #{name.inspect} in #{env_name.inspect} has no url") if url.nil?
    adapter_name = entry.adapter || Registry.scheme_of(url)
    return UnknownAdapterError.new("Database #{name.inspect} has no adapter key and #{Registry.redact(url).inspect} has no URL scheme") if adapter_name.nil?
    Registry.for_scheme(adapter_name)! if env_name == current_env
    database = entry.replica ? (entry.replica_of || name.chomp("_replica")) : name
    DatabaseConfig.new(name, env_name, adapter_name.downcase, url, entry.pool,
      entry.replica, entry.database_tasks, database)
  end
end
