module grant/lifecycle

import grant/errors::{DatabaseError, ValidationError, CallbackAbort}
import grant/value::{Attributes}
import grant/validation::{Context}
import grant/unit_of_work::{Action}

# Per-operation metadata is explicit and immutable. A nil baseline denotes an
# ordinary full update; a supplied baseline enables changed-column writes.
pub struct WriteContext
  @baseline : Attributes?
  @forced : Array(String)
  @readonly : Array(String)
  @primary_key : String
  getter stamp : Bool

  def initialize(baseline : Attributes? = nil, forced : Array(String) = [] of String,
                 readonly : Array(String) = [] of String, @primary_key : String = "id", @stamp : Bool = true)
    if values = baseline
      copy = Attributes.new
      values.each { |name, value| copy[name] = value }
      @baseline = copy
    else
      @baseline = nil
    end
    @forced = forced.map { |name| name }
    @readonly = readonly.map { |name| name }
  end

  def partial : Bool
    !@baseline.nil?
  end

  def changes(values : Attributes) : Attributes
    result = Attributes.new
    baseline = @baseline
    values.each do |name, value|
      next if name == @primary_key || @readonly.includes?(name)
      if baseline.nil? || !baseline.has_key?(name) || baseline[name] != value || @forced.includes?(name)
        result[name] = value
      end
    end
    result
  end
end

pub enum Event
  BeforeValidation
  AfterValidation
  BeforeSave
  BeforeCreate
  AfterCreate
  BeforeUpdate
  AfterUpdate
  AfterSave
  AfterTouch
  AroundValidation
  AroundSave
  AroundCreate
  AroundUpdate
  AroundDestroy
  BeforeDestroy
  AfterDestroy
  AfterCommit
  AfterRollback
end

pub trait Callback(T)
  abstract def call(event : Event, record : T) : T | DatabaseError | ValidationError | CallbackAbort

  def call(event : Event, record : T, context : WriteContext) : T | DatabaseError | ValidationError | CallbackAbort
    call(event, record)
  end

  def readonly_attributes : Array(String)
    [] of String
  end
end

# Application policies replace dynamic method/proc lookup. All positive terms
# must hold, and every negative term must be false, in declaration order.
pub trait CallbackCondition(T)
  abstract def applies?(event : Event, record : T) : Bool
end

pub class CallbackConditions(T)
  @if_all : Array(CallbackCondition(T))
  @unless_any : Array(CallbackCondition(T))

  def initialize(if_all : Array(CallbackCondition(T)) = [] of CallbackCondition(T),
                 unless_any : Array(CallbackCondition(T)) = [] of CallbackCondition(T))
    @if_all = if_all.map { |condition| condition }
    @unless_any = unless_any.map { |condition| condition }
  end

  def applies?(event : Event, record : T) : Bool
    @if_all.each { |condition| return false unless condition.applies?(event, record) }
    @unless_any.each { |condition| return false if condition.applies?(event, record) }
    true
  end
end

pub alias AroundError = DatabaseError | ValidationError | CallbackAbort | Panicked | Cancelled

# Continuations have an operation lifetime and may be invoked once. A wrapper
# cannot turn a skipped, missing or failed write into a successful record.
pub class Continuation(T)
  @operation : Proc(T, T | Nil | AroundError)
  @called : Bool
  @closed : Bool
  @violation : Bool
  @outcome : T | Nil | AroundError

  def initialize(@operation : Proc(T, T | Nil | AroundError))
    @called = false
    @closed = false
    @violation = false
    @outcome = nil
  end

  def call(record : T) : T | Nil | AroundError
    if @closed || @called
      @violation = true
      return CallbackAbort.new("around callback continuation is closed or already called")
    end
    @called = true
    @outcome = @operation.call(record)
  end

  def complete(result : T | Nil | AroundError) : T | Nil | AroundError
    @closed = true
    return CallbackAbort.new("around callback called its continuation more than once") if @violation
    return result if result.is_a?(Error)
    return CallbackAbort.new("around callback did not call its continuation") unless @called
    return @outcome if @outcome.is_a?(Error) || @outcome.nil?
    return CallbackAbort.new("around callback returned no record after its operation") if result.nil?
    result
  end
end

pub trait Around(T)
  abstract def call(event : Event, record : T, continuation : Continuation(T)) : T | Nil | AroundError
end

struct AroundEntry(T)
  getter callback : Around(T)
  getter events : Array(Event)
  getter conditions : CallbackConditions(T)?
  getter on : Array(String)?

  def initialize(@callback : Around(T), events : Array(Event), @conditions : CallbackConditions(T)? = nil, on : Array(String)? = nil)
    @on = on ? on.map { |name| name } : nil
    @events = events.map { |event| event }
  end
end

struct Entry(T)
  getter callback : Callback(T)
  getter events : Array(Event)
  getter conditions : CallbackConditions(T)?
  getter on : Array(String)?
  getter actions : Array(Action)?

  def initialize(@callback : Callback(T), events : Array(Event), @conditions : CallbackConditions(T)? = nil,
                 on : Array(String)? = nil, actions : Array(Action)? = nil)
    @on = on ? on.map { |name| name } : nil
    @actions = actions ? actions.map { |action| action } : nil
    @events = events.map { |event| event }
  end
end

# Conditions and transformations are typed callback implementations, not macro
# strings or inherited methods. Ordering is explicit, including prepended hooks.
pub class Pipeline(T)
  @entries : Array(Entry(T))
  @around : Array(AroundEntry(T))

  def initialize
    @entries = [] of Entry(T)
    @around = [] of AroundEntry(T)
  end

  def add_around(callback : Around(T), events : Array(Event), prepend : Bool = false,
                 conditions : CallbackConditions(T)? = nil) : Pipeline(T)
    entry = AroundEntry(T).new(callback, events, conditions)
    @around = prepend ? [entry] + @around : @around + [entry]
    self
  end

  def wrap(event : Event, record : T, validation_context : Context = Context.new, &operation : T -> T | Nil | AroundError) : T | Nil | AroundError
    selected = @around.select { |entry| entry.events.includes?(event) && matches_context?(entry.on, validation_context) }
    invoke_around(selected, 0, event, record, operation)
  end

  private def invoke_around(entries : Array(AroundEntry(T)), index : Int32, event : Event, record : T,
                            operation : Proc(T, T | Nil | AroundError)) : T | Nil | AroundError
    return operation.call(record) if index == entries.size
    next_operation = ->(current : T) { invoke_around(entries, index + 1, event, current, operation) }
    continuation = Continuation(T).new(next_operation)
    # Containing panics here lets us close escaped continuations even if the
    # wrapper panics. The owning repository still rolls its savepoint back.
    result = group do |tasks|
      tasks.spawn do
        entry = entries[index]
        conditions = entry.conditions
        if conditions.nil? || conditions.applies?(event, record)
          entry.callback.call(event, record, continuation).as(T | Nil | AroundError)
        else
          continuation.call(record)
        end
      end.value
    end
    continuation.complete(result)
  end

  def add(callback : Callback(T), events : Array(Event), prepend : Bool = false,
          conditions : CallbackConditions(T)? = nil) : Pipeline(T)
    entry = Entry(T).new(callback, events, conditions)
    @entries = prepend ? [entry] + @entries : @entries + [entry]
    self
  end

  # Context filters belong only to validation events; invalid registrations do
  # not mutate the pipeline. Transaction action filters use a separate policy.
  def add_validation(callback : Callback(T), events : Array(Event), on : Array(String),
                     prepend : Bool = false, conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    unless events.all? { |event| event == Event::BeforeValidation || event == Event::AfterValidation }
      return DatabaseError.new(21, "callback", "validation contexts require validation events")
    end
    entry = Entry(T).new(callback, events, conditions, on)
    @entries = prepend ? [entry] + @entries : @entries + [entry]
    self
  end

  def add_around_validation(callback : Around(T), on : Array(String), prepend : Bool = false,
                            conditions : CallbackConditions(T)? = nil) : Pipeline(T)
    entry = AroundEntry(T).new(callback, [Event::AroundValidation], conditions, on)
    @around = prepend ? [entry] + @around : @around + [entry]
    self
  end

  def add_transaction(callback : Callback(T), events : Array(Event), on : Array(Action),
                      prepend : Bool = false, conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    unless events.all? { |event| event == Event::AfterCommit || event == Event::AfterRollback }
      return DatabaseError.new(21, "callback", "transaction actions require commit or rollback events")
    end
    entry = Entry(T).new(callback, events, conditions, actions: on)
    @entries = prepend ? [entry] + @entries : @entries + [entry]
    self
  end

  def after_commit(callback : Callback(T), on : Action | Array(Action) | Nil = nil,
                   prepend : Bool = false, conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    register_observer(callback, Event::AfterCommit, on, prepend, conditions)
  end

  def after_rollback(callback : Callback(T), on : Action | Array(Action) | Nil = nil,
                     prepend : Bool = false, conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    register_observer(callback, Event::AfterRollback, on, prepend, conditions)
  end

  def after_create_commit(callback : Callback(T), prepend : Bool = false,
                          conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    after_commit(callback, Action::Create, prepend, conditions)
  end

  def after_update_commit(callback : Callback(T), prepend : Bool = false,
                          conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    after_commit(callback, Action::Update, prepend, conditions)
  end

  def after_destroy_commit(callback : Callback(T), prepend : Bool = false,
                           conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    after_commit(callback, Action::Destroy, prepend, conditions)
  end

  def after_save_commit(callback : Callback(T), prepend : Bool = false,
                        conditions : CallbackConditions(T)? = nil) : Pipeline(T) | DatabaseError
    after_commit(callback, [Action::Create, Action::Update], prepend, conditions)
  end

  private def register_observer(callback : Callback(T), event : Event, on : Action | Array(Action) | Nil,
                                prepend : Bool, conditions : CallbackConditions(T)?) : Pipeline(T) | DatabaseError
    if on.nil?
      add(callback, [event], prepend, conditions)
    elsif on.is_a?(Action)
      add_transaction(callback, [event], [on], prepend, conditions)
    else
      add_transaction(callback, [event], on, prepend, conditions)
    end
  end

  private def matches_context?(on : Array(String)?, context : Context) : Bool
    on.nil? || on.any? { |name| context.includes?(name) }
  end

  private def matches_action?(on : Array(Action)?, action : Action?) : Bool
    return true if on.nil?
    return false if action.nil?
    on.includes?(action)
  end

  def readonly_attributes : Array(String)
    result = [] of String
    @entries.each do |entry|
      entry.callback.readonly_attributes.each { |name| result << name unless result.includes?(name) }
    end
    result
  end

  def run(event : Event, record : T, context : WriteContext = WriteContext.new,
          validation_context : Context = Context.new, action : Action? = nil) : T | DatabaseError | ValidationError | CallbackAbort
    current = record
    @entries.each do |entry|
      conditions = entry.conditions
      if entry.events.includes?(event) && matches_context?(entry.on, validation_context) && matches_action?(entry.actions, action) && (conditions.nil? || conditions.applies?(event, current))
        result = entry.callback.call(event, current, context)
        return result if result.is_a?(Error)
        current = result
      end
    end
    current
  end
end
