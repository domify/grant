module grant/counters

import grant/adapter/driver::{Value}
import grant/error::{ErrorBase, ArgumentError}
pub import grant/query/executor
import grant/timestamps

pub MAX_IDS_PER_STATEMENT = 10_000

# Upstream Counters::ClassMethods, expanded onto each model.
pub macro model_methods(model)
  def self.update_counters(id : I, counters : Hash(K, T), touch : Bool | Symbol | Array(Symbol) = false) : Int64 | ::Grant::Error::ErrorBase forall I, K, T
    __apply_counter_update(all.where(primary_name, :eq, id), counters, touch)
  end

  def self.update_counters(ids : Array(I), counters : Hash(K, T), touch : Bool | Symbol | Array(Symbol) = false) : Int64 | ::Grant::Error::ErrorBase forall I, K, T
    return 0_i64 if ids.empty?
    affected = 0_i64
    offset = 0
    while offset < ids.size
      size = ids.size - offset
      size = ::Grant::Counters::MAX_IDS_PER_STATEMENT if size > ::Grant::Counters::MAX_IDS_PER_STATEMENT
      affected += __apply_counter_update(all.where(primary_name, :in, ids[offset, size]), counters, touch)!
      offset += size
    end
    affected
  end

  def self.__apply_counter_update(query : Q, counters : Hash(K, T), touch : Bool | Symbol | Array(Symbol) = false, time : ::Std::Time::Time = ::Grant::Timestamps.current_time) : Int64 | ::Grant::Error::ErrorBase forall Q, K, T
    return 0_i64 if counters.empty?
    assembler = query.assembler
    where_clause = assembler.where
    return ::Grant::Error::ArgumentError.new("Counter update has no WHERE clause") if where_clause.nil?
    error = assembler.error
    return error unless error.nil?
    where_parameters = assembler.numbered_parameters
    assignments = [] of String
    values = [] of ::Grant::Adapter::Driver::Value
    index = where_parameters.size
    counters.each do |column, delta|
      name = quote(column.to_s)
      index += 1
      placeholder = adapter.postgres? ? "$#{index}" : "?"
      operator = delta < 0 ? "-" : "+"
      assignments << "#{name} = COALESCE(#{name}, 0) #{operator} #{placeholder}"
      values << ::Grant::Base.sqlite_value(delta.abs)
    end
    __counter_touch_columns(touch)!.each do |column|
      index += 1
      placeholder = adapter.postgres? ? "$#{index}" : "?"
      assignments << "#{quote(column)} = #{placeholder}"
      values << ::Grant::Base.sqlite_value(::Grant::Timestamps.stamp(column, time, timestamp_precision))
    end
    sql = "UPDATE #{quote(table_name)} SET #{assignments.join(", ")} #{where_clause}"
    params = adapter.postgres? ? where_parameters + values : values + where_parameters
    mark_write_operation
    ::Grant::Query::Executor.open_statement(adapter, sql, params) { |db| db.exec(sql, params) }!.changes
  end

  def self.__counter_touch_columns(touch : Bool | Symbol | Array(Symbol)) : Array(String) | ::Grant::Error::ErrorBase
    columns = [] of String
    case touch
    when false then return columns
    when Symbol then columns << touch.to_s
    when Array then touch.each { |column| columns << column.to_s }
    end
    columns.each do |column|
      return ::Grant::Error::ArgumentError.new("#{self} has no column named #{column}") unless fields.includes?(column)
    end
    update_timestamp_columns.each { |column| columns << column unless columns.includes?(column) }
    columns
  end
end
