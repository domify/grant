module grant/cstring

# Copy C-owned bytes into an iyi string before SQLite invalidates its buffer.
pub def cstring(pointer : UInt8*, length : Int32 = -1) : String
  size = length
  if size < 0
    size = 0
    while pointer[size] != 0_u8
      size += 1
    end
  end
  String.new(size) do |buffer|
    buffer.copy_from(pointer, size)
    nil
  end
end
