module grant/eager_loading

pub import grant/error

pub class StrictLoadingViolationError < ::Grant::Error::ErrorBase
end

impl ::Error for StrictLoadingViolationError
  def message : String
    @message
  end
end

# Initial direct-association preload surface; all entry points retain current_scope.
pub macro model_methods(model)
  {% for operation in [:includes, :preload, :eager_load] %}
    def self.{{ operation.id }}(*names : Symbol) : ::Grant::Query::Builder::Builder({{ model }})
      current_scope.{{ operation.id }}(*names)
    end
  {% end %}

  def self.preload_associations(records : Array({{ model }}), names : Array(String)) : Nil | ::Grant::Error::ErrorBase
    names.each do |name|
      found = false
      {% for method in model.resolve.methods %}
        {% ann = method.annotation(::Grant::Associations::Relationship) %}
        {% if ann && ann[:type] == :has_many && ann[:composite] == true %}
          if name == {{ method.name.stringify }}
            found = true
            foreign_keys = {{ ann[:foreign_key] }}.split(',')
            primary_keys = {% if ann[:primary_key] != "" %}{{ ann[:primary_key] }}.split(','){% else %}{{ model }}.composite_primary_key_columns.map(&.to_s){% end %}
            tuples = [] of Array(::Grant::Adapter::Driver::Value)
            records.each do |record|
              tuple = primary_keys.map { |column| ::Grant::Base.sqlite_value(record.read_attribute(column)!) }
              tuples << tuple unless tuple.any?(&.nil?)
            end
            tuples = tuples.uniq
            targets = [] of {{ ann[:target] }}
            unless tuples.empty?
              params = [] of ::Grant::Adapter::Driver::Value
              alternatives = tuples.map do |tuple|
                foreign_keys.map_with_index do |column, index|
                  params << tuple[index]
                  "#{::Grant::Base.quote_identifier(column)} = ?"
                end.join(" AND ")
              end
              statement = alternatives.map { |part| "(#{part})" }.join(" OR ")
              targets = {{ ann[:target] }}.where(statement, params).select!
            end
            records.each do |record|
              values = primary_keys.map { |column| ::Grant::Base.sqlite_value(record.read_attribute(column)!) }
              matches = targets.select do |target|
                foreign_keys.map { |column| ::Grant::Base.sqlite_value(target.read_attribute(column).or_panic) } == values
              end
              record.set_loaded_association(name, matches)
            end
          end
        {% elsif ann && ann[:type] == :has_many && ann[:through] == nil %}
          if name == {{ method.name.stringify }}
            found = true
            keys = records.map { |record| record.read_attribute({{ ann[:primary_key].id.stringify }})! }
            targets = {{ ann[:target] }}.where({{ ann[:foreign_key].id.stringify }}, :in, keys).select!
            records.each do |record|
              key = record.read_attribute({{ ann[:primary_key].id.stringify }})!
              matches = targets.select { |target| target.read_attribute({{ ann[:foreign_key].id.stringify }}).or_panic == key }
              record.set_loaded_association(name, matches)
            end
          end
        {% elsif ann && ann[:type] == :belongs_to && ann[:polymorphic] != true %}
          if name == {{ method.name.stringify }}
            found = true
            keys = records.map { |record| record.read_attribute({{ ann[:foreign_key].id.stringify }})! }.reject { |key| key.nil? }.uniq
            targets = {{ ann[:target] }}.where({{ ann[:primary_key].id.stringify }}, :in, keys).select!
            records.each do |record|
              key = record.read_attribute({{ ann[:foreign_key].id.stringify }})!
              matches = targets.select { |target| target.read_attribute({{ ann[:primary_key].id.stringify }}).or_panic == key }
              record.set_loaded_association(name, matches)
            end
          end
        {% end %}
      {% end %}
      return ::Grant::Error::ArgumentError.new("Unknown association: #{name}") unless found
    end
    nil
  end
end

pub trait QueryMethods(Model)
  {% for operation in [:includes, :preload, :eager_load] %}
    def {{ operation.id }}(*names : Symbol) : self
      copy = chain_copy
      copy.{{ operation == :includes ? "includes_associations".id : (operation == :preload ? "preload_associations".id : "eager_load_associations".id) }}.concat(names.to_a)
      copy.refresh_preload_names
      copy
    end
  {% end %}
end
