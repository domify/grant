module grant/columns_helpers

pub import grant/columns
import std/time::{Time}
import std/text
import std/regex

# The upstream String overload reads the attribute's own value; the Symbol
# overload in Columns converts to its database representation.
pub macro model_methods(model)
  def read_attribute(name : String) : ::Grant::Columns::Type | ::Grant::Error::ErrorBase
    \{% begin %}
      case name
      \{% for v in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) || v.annotation(::Grant::AttributeApi::VirtualAttribute) } %}
      when \{{ v.name.stringify }}
        \{% if v.annotation(::Grant::Base::Column) && v.annotation(::Grant::Base::Column)[:lazy] %}
          self.\{{ v.name }}!
        \{% elsif v.annotation(::Grant::Base::Column) && (conv = v.annotation(::Grant::Base::Column)[:converter]) && !v.type.union_types.all? { |t| [Nil, Bool, Int32, Int64, Float32, Float64, String, ::Std::Time::Time, ::Std::Big::BigDecimal].includes?(t.resolve) } %}
          # A converted value outside Columns::Type (an enum) reads as its database form.
          (value = @\{{ v.name }}).nil? ? nil : \{{ conv }}.to_db(value)
        \{% else %}
          @\{{ v.name }}
        \{% end %}
      \{% end %}
      else
        ::Grant::Error::ErrorBase.new("Unknown attribute: #{name}")
      end
    \{% end %}
  end
end

# SQLite CURRENT_TIMESTAMP and datetime() return UTC without a zone suffix.
pub def time_from_db(value : String) : Time
  if value.size >= 19 && value[10] == ' '
    suffix = value[19...value.size]
    if !suffix.includes?("+") && !suffix.includes?("-") && !suffix.ends_with?("Z")
      return Time.parse_rfc3339("#{value}Z")
    end
  end
  Time.parse_rfc3339(value)
end

# Validate before entering the standard parser, whose invalid-input path is a native panic.
pub def time_from_db_strict(value : String) : Time | ::Grant::Error::ArgumentError
  text = value
  if value.size >= 19 && value[10] == ' '
    suffix = value[19...value.size]
    if !suffix.includes?("+") && !suffix.includes?("-") && !suffix.ends_with?("Z") && !suffix.ends_with?("z")
      text = "#{value}Z"
    end
  end
  pattern = /^-?[0-9]{4,10}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([Zz]|[+-][0-9]{2}(:?[0-9]{2})?)$/
  error = ::Grant::Error::ArgumentError.new("Invalid timestamp: #{value.inspect}")
  return error if pattern.find(text).nil?
  start = text.starts_with?("-") ? 1 : 0
  divider = text.index('-', start).as(Int32)
  year_value = text[0, divider].to_i64
  return error if year_value < -2147483648_i64 || year_value > 2147483647_i64
  year = year_value.to_i32
  month = text[divider + 1, 2].to_i
  day = text[divider + 4, 2].to_i
  hour = text[divider + 7, 2].to_i
  minute = text[divider + 10, 2].to_i
  second = text[divider + 13, 2].to_i
  return error if month < 1 || month > 12
  return error if day < 1 || day > Time.days_in_month(year, month)
  return error if hour > 23 || minute > 59 || second > 60
  unless text.ends_with?("Z") || text.ends_with?("z")
    plus = text.rindex('+')
    minus = text.rindex('-')
    offset = plus || minus.as(Int32)
    zone = text[offset + 1...text.size].gsub(":", "")
    return error if zone[0, 2].to_i > 23
    return error if zone.size == 4 && zone[2, 2].to_i > 59
  end
  Time.parse_rfc3339(text)
end


pub def string_array_from_db(values : Array(T)) : Array(String) | ::Grant::Error::ArgumentError forall T
  result = [] of String
  values.each do |value|
    return ::Grant::Error::ArgumentError.new("Array element does not fit String") unless value.is_a?(String)
    result << value
  end
  result
end
