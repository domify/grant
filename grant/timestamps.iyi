module grant/timestamps

pub import std/time
import std/time::{Time, Span}

pub def current_time : Time
  to_microseconds(Time.utc)
end

pub def to_microseconds(time : Time) : Time
  excess = time.nanosecond % 1_000
  excess == 0 ? time : time - Span.nanoseconds(excess.to_i64)
end

pub def truncate(time : Time, precision : Int32) : Time
  return time if precision >= 9
  digits = precision < 0 ? 0 : precision
  unit = 1_i64
  (9 - digits).times { unit *= 10 }
  time - Span.nanoseconds(time.nanosecond.to_i64 % unit)
end

pub def stamp(column_name : String, time : Time, precision : Int32? = nil) : Time
  if column_name.ends_with?("_on")
    Time.utc(time.year, time.month, time.day)
  elsif precision
    truncate(time, precision)
  else
    time
  end
end

@@overrides = {} of String => Bool

pub def overrides : Hash(String, Bool)
  @@overrides
end

pub def override(model_name : String, value : Bool) : Nil
  updated = {} of String => Bool
  @@overrides.each { |key, current| updated[key] = current }
  updated[model_name] = value
  @@overrides = updated
  nil
end

# The native scheduler identity supplies the upstream fiber-local slot.
pub class BlockScopes
  getter no_touching = {} of String => Int32
  getter suppressed = {} of String => Int32
  @@states = {} of UInt64 => BlockScopes

  def self.current? : BlockScopes?
    @@states[IyiScheduler.current.object_id]?
  end

  def self.current : BlockScopes
    @@states[IyiScheduler.current.object_id] ||= new
  end

  def self.release_if_empty : Nil
    scopes = current?
    if scopes && scopes.no_touching.empty? && scopes.suppressed.empty?
      @@states.delete(IyiScheduler.current.object_id)
    end
    nil
  end
end

pub def within(counts : Hash(String, Int32), name : String, &block : -> T) : T forall T
  counts[name] = (counts[name]? || 0) + 1
  result = yield
  remaining = counts[name] - 1
  if remaining > 0
    counts[name] = remaining
  else
    counts.delete(name)
  end
  BlockScopes.release_if_empty
  result
end

pub annotation RecordTimestamps
end

pub macro model_methods(model)
  def self.record_timestamps? : Bool
    overrides = ::Grant::Timestamps.overrides
    \{% for owner in [@type] + @type.ancestors %}
      return overrides[\{{ owner.stringify }}] if overrides.has_key?(\{{ owner.stringify }})
    \{% end %}
    __record_timestamps_default
  end

  def self.record_timestamps=(value : Bool) : Bool
    ::Grant::Timestamps.override(self.to_s, value)
    value
  end

  def self.__record_timestamps_default : Bool
    \{% begin %}
    \{% declaration = @type.methods.find { |method| method.annotation(::Grant::Timestamps::RecordTimestamps) } %}
    \{% if declaration %}
      \{{ declaration.annotation(::Grant::Timestamps::RecordTimestamps)[:value] }}
    \{% else %}
      true
    \{% end %}
    \{% end %}
  end

  def self.no_touching(&block : -> T) : T forall T
    ::Grant::Timestamps.within(::Grant::Timestamps::BlockScopes.current.no_touching, self.to_s) { yield }
  end

  def self.suppress(&block : -> T) : T forall T
    ::Grant::Timestamps.within(::Grant::Timestamps::BlockScopes.current.suppressed, self.to_s) { yield }
  end

  def self.no_touching? : Bool
    scopes = ::Grant::Timestamps::BlockScopes.current?
    return false if scopes.nil? || scopes.no_touching.empty?
    \{% for owner in [@type] + @type.ancestors %}
      return true if scopes.no_touching.has_key?(\{{ owner.stringify }})
    \{% end %}
    false
  end

  def self.suppressed? : Bool
    scopes = ::Grant::Timestamps::BlockScopes.current?
    return false if scopes.nil? || scopes.suppressed.empty?
    \{% for owner in [@type] + @type.ancestors %}
      return true if scopes.suppressed.has_key?(\{{ owner.stringify }})
    \{% end %}
    false
  end

  def no_touching? : Bool
    self.class.no_touching?
  end

  def self.timestamped_attributes : Array(String)
    fields.select { |field| ["created_at", "created_on", "updated_at", "updated_on"].includes?(field) }
  end

  def self.update_timestamp_columns : Array(String)
    timestamped_attributes.select { |field| field == "updated_at" || field == "updated_on" }
  end
end
