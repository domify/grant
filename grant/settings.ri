module grant/settings

pub class Settings
  property reading_role : Symbol = :reading
  property writing_role : Symbol = :writing
  property query_cache_max_entries : Int32 = 100
  property capture_statement_bind_values : Bool = false

  def capture_statement_bind_values? : Bool
    @capture_statement_bind_values
  end

  property default_timezone : String = "UTC"

  # When true, relations with no ORDER BY order by the primary key; finders
  # and `find_each` order by `implicit_order_columns` either way.
  property implicit_order : Bool = false
end

SETTINGS = Settings.new

pub def settings : Settings
  SETTINGS
end
