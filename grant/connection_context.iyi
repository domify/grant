module grant/connection_context

pub struct ConnectionContext
  property database : String?
  property role : Symbol
  property shard : Symbol?
  property prevent_writes : Bool
  property owner : String?

  def initialize(@database : String?, @role : Symbol = :primary, @shard : Symbol? = nil,
                 @prevent_writes : Bool = false, @owner : String? = nil)
  end
end

# The native scheduler identity supplies the upstream fiber-local state slot.
pub class ConnectionState
  getter contexts = [] of ConnectionContext
  property block_floor : Int32 = 0
  @@states = {} of UInt64 => ConnectionState

  def self.current? : ConnectionState?
    @@states[IyiScheduler.current.object_id]?
  end

  def self.current : ConnectionState
    @@states[IyiScheduler.current.object_id] ||= new
  end

  def self.release_if_empty : Nil
    state = current?
    @@states.delete(IyiScheduler.current.object_id) if !state.nil? && state.contexts.empty?
    nil
  end
end

pub macro model_methods(model)
  def self.guard_writes_strict : Nil | ::Grant::ErrorTaxonomy::ReadOnlyError
    return nil unless preventing_writes?
    ::Grant::ErrorTaxonomy::ReadOnlyError.new("Write query attempted while in readonly mode")
  end

  def __guard_context_writes : Nil | ::Grant::ErrorTaxonomy::ReadOnlyError
    {{ model }}.guard_writes_strict
  end

  def self.connection_context_owner?(owner : String?) : Bool
    return true if owner == {{ model.stringify }}
    {% for ancestor in model.resolve.ancestors %}
      return true if owner == {{ ancestor.stringify }}
    {% end %}
    false
  end

  def self.connected_to?(role : Symbol? = nil, shard : Symbol? = nil) : Bool | ::Grant::Error::ArgumentError
    if role.nil? && shard.nil?
      return ::Grant::Error::ArgumentError.new("connected_to? needs a role or a shard")
    end
    unless role.nil?
      return false unless ::Grant::ConnectionManagement.registry_role(current_role) ==
                          ::Grant::ConnectionManagement.registry_role(role)
    end
    return false if !shard.nil? && (current_shard || default_shard) != shard
    true
  end

  def self.connecting_to(database : String? = nil, role : Symbol? = nil,
                         shard : Symbol? = nil, prevent_writes : Bool = false) : Nil
    previous = connection_context
    inherited = !previous.nil? && previous.prevent_writes
    if inherited && !role.nil? && !previous.nil? &&
       ::Grant::ConnectionManagement.registry_role(role) == :writing &&
       ::Grant::ConnectionManagement.registry_role(previous.role) == :reading
      inherited = false
    end
    implied = !role.nil? && ::Grant::ConnectionManagement.registry_role(role) == :reading
    ::Grant::ConnectionContext::ConnectionState.current.contexts <<
      ::Grant::ConnectionContext::ConnectionContext.new(database, role || current_role,
        shard || current_shard, prevent_writes || implied || inherited, {{ model.stringify }})
    nil
  end

  def self.reset_connecting_to : Nil
    state = ::Grant::ConnectionContext::ConnectionState.current?
    return nil if state.nil?
    index = state.contexts.size - 1
    while index >= state.block_floor
      state.contexts.delete_at(index) if state.contexts[index].owner == {{ model.stringify }}
      index -= 1
    end
    ::Grant::ConnectionContext::ConnectionState.release_if_empty
    nil
  end

  def self.default_database_name : String
    own = @@own_default_database_name
    return own unless own.nil?
    {% if model.resolve.superclass.stringify != "Grant::Base::Base" %}
      {{ model.resolve.superclass }}.default_database_name
    {% else %}
      "primary"
    {% end %}
  end

  def self.default_database_name=(database : String) : String
    @@connection_name = database
    @@own_default_database_name = database
  end

  def self.connection_context : ::Grant::ConnectionContext::ConnectionContext?
    state = ::Grant::ConnectionContext::ConnectionState.current?
    return nil if state.nil?
    state.contexts.reverse_each do |context|
      return context if context.owner.nil? || self.connection_context_owner?(context.owner)
    end
    nil
  end

  def self.connection_context_database : String?
    state = ::Grant::ConnectionContext::ConnectionState.current?
    return nil if state.nil?
    state.contexts.reverse_each do |context|
      if context.owner.nil? || self.connection_context_owner?(context.owner)
        return context.database unless context.database.nil?
      end
    end
    nil
  end

  def self.database_name : String
    connection_context_database || default_database_name
  end

  def self.database_name=(database : String) : String
    self.default_database_name = database
  end

  def self.current_database : String
    database_name
  end

  def self.current_role : Symbol
    context = connection_context
    return context.role unless context.nil?
    should_use_reader? ? ::Grant::Settings.settings.reading_role : :primary
  end

  def self.current_shard : Symbol?
    context = connection_context
    context.nil? ? nil : context.shard
  end

  def self.preventing_writes? : Bool
    context = connection_context
    !context.nil? && context.prevent_writes
  end

  def self.connected_to(database : String? = nil, role : Symbol? = nil,
                        shard : Symbol? = nil, prevent_writes : Bool = false,
                        &block : -> T) : T forall T
    previous = connection_context
    inherited_prevention = !previous.nil? && previous.prevent_writes
    if inherited_prevention && !role.nil? && !previous.nil? &&
       ::Grant::ConnectionManagement.registry_role(role) == :writing &&
       ::Grant::ConnectionManagement.registry_role(previous.role) == :reading
      inherited_prevention = false
    end
    implied = !role.nil? && ::Grant::ConnectionManagement.registry_role(role) == :reading
    context = ::Grant::ConnectionContext::ConnectionContext.new(
      database, role || current_role, shard || current_shard,
      prevent_writes || implied || inherited_prevention, {{ model.stringify }})
    state = ::Grant::ConnectionContext::ConnectionState.current
    depth = state.contexts.size
    state.contexts << context
    outer_floor = state.block_floor
    state.block_floor = depth + 1
    result = yield
    while state.contexts.size > depth
      state.contexts.pop
    end
    state.block_floor = outer_floor
    ::Grant::ConnectionContext::ConnectionState.release_if_empty
    result
  end

  def self.while_preventing_writes(&block : -> T) : T forall T
    connected_to(prevent_writes: true) { yield }
  end
end
