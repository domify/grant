module grant/serialized_column

pub annotation Storage
end

pub macro serialized_column(name, klass, format = :json)
  column _serialized_{{ name.id }} : String?
  @_{{ name.id }}_cache : {{ klass }}? = nil
  @_{{ name.id }}_modified : Bool = false

  def {{ name.id }} : {{ klass }}?
    cached = @_{{ name.id }}_cache
    return cached unless cached.nil?
    raw_value = @_serialized_{{ name.id }}
    return nil if raw_value.nil?
    object = {% if format == :yaml %}{{ klass }}.from_yaml(raw_value){% else %}{{ klass }}.from_json(raw_value){% end %}
    if object.responds_to?(:_set_parent)
      object._set_parent(self, {{ name.id.stringify }})
    end
    @_{{ name.id }}_cache = object
    object
  end

  def __new_{{ name.id }}_store : {{ klass }}
    {{ klass }}.new
  end

  def {{ name.id }}=(value : {{ klass }}?) : {{ klass }}?
    @_{{ name.id }}_cache = value
    if value
      if value.responds_to?(:_set_parent)
        value._set_parent(self, {{ name.id.stringify }})
      end
      @_serialized_{{ name.id }} = {% if format == :yaml %}value.to_yaml{% else %}value.to_json{% end %}
    else
      @_serialized_{{ name.id }} = nil
    end
    @_{{ name.id }}_modified = true
    value
  end

  def {{ name.id }}=(value : String) : String
    @_{{ name.id }}_cache = nil
    @_serialized_{{ name.id }} = value
    @_{{ name.id }}_modified = true
    value
  end

  def {{ name.id }}_changed? : Bool
    return true if @_{{ name.id }}_modified
    return true if !new_record? && _serialized_{{ name.id }}_changed?
    if cached = @_{{ name.id }}_cache
      return cached.changed? if cached.responds_to?(:changed?)
    end
    false
  end

  before_save :_serialize_{{ name.id }}
  private def _serialize_{{ name.id }} : Nil
    if cached = @_{{ name.id }}_cache
      @_serialized_{{ name.id }} = {% if format == :yaml %}cached.to_yaml{% else %}cached.to_json{% end %}
    end
    nil
  end

  after_save :_reset_{{ name.id }}_tracking
  private def _reset_{{ name.id }}_tracking : Nil
    @_{{ name.id }}_modified = false
    if cached = @_{{ name.id }}_cache
      cached.reset_changes_in_place if cached.responds_to?(:reset_changes_in_place)
    end
    nil
  end

  @[::Grant::SerializedColumn::Storage(name: {{ name.id.stringify }})]
  def __mark_{{ name.id }}_serialized_changed : Nil
    @_{{ name.id }}_modified = true
    nil
  end
end

pub macro model_methods(model)
  def _mark_serialized_column_changed(attribute_name : String) : Nil
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::SerializedColumn::Storage) %}
        self.\{{ method.name }} if attribute_name == \{{ ann[:name] }}
      \{% end %}
    \{% end %}
    nil
  end
end
