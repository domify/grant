module grant/connections

import grant/adapter/driver::{Connection}
import grant/adapter/base::{Base}
import grant/errors::{DatabaseError}

# Grant::Connections: named adapters registered once, looked up by models.
pub class Connections
  @@connection_switch_wait_period : Int32 = 2000

  def self.connection_switch_wait_period : Int32
    @@connection_switch_wait_period
  end

  def self.connection_switch_wait_period=(value : Int32) : Nil
    @@connection_switch_wait_period = value
    nil
  end

  @@adapters = {} of String => Base
  @@registry = {} of String => Connection

  def self.register(name : String, connection : Connection) : Nil
    @@adapters.delete(name)
    connection.name = name
    @@registry[name] = connection
  end

  def self.register(name : String, adapter : Base) : Nil
    @@registry.delete(name)
    @@adapters[name] = adapter
  end

  def self.unregister(name : String) : Nil
    @@registry.delete(name)
    @@adapters.delete(name)
    nil
  end

  def self.[](name : String) : Connection
    adapter = @@adapters[name]?
    return adapter.checkout.or_panic unless adapter.nil?
    @@registry[name]
  end

  def self.[]?(name : String) : Connection?
    adapter = @@adapters[name]?
    return adapter.checkout.or_panic unless adapter.nil?
    @@registry[name]?
  end
end
