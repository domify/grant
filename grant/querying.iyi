module grant/querying

import std/regex::{Regex}
pub import grant/adapter/placeholder_scanner

import grant/errors::{RecordNotFound, ErrorBase}

pub class NotFound < RecordNotFound
end

impl ::Error for NotFound
  def message : String
    @message
  end
end

pub def invalid_batch_clause?(filter : String) : Bool
  !/\b(ORDER\s+BY|LIMIT|OFFSET|GROUP\s+BY)\b/.find(filter.upcase).nil?
end

# ClassMethods raw-clause overloads and raw SQL passthroughs from upstream querying.cr.
pub macro model_methods(model)
  def self.extract_associated(association : Symbol) : Array(::Grant::Base::Base) | ::Grant::Error::ErrorBase
    current_scope.extract_associated(association)
  end

  def self.extract_associated(association : Symbol, as type : T.class) : Array(T) | ::Grant::Error::ErrorBase forall T
    current_scope.extract_associated(association, as: type)
  end
  def self.order(field : Symbol | String, direction : Symbol, *, nulls : Symbol) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.order(field, direction, nulls: nulls)
  end

  def self.order(field : Symbol | String, direction : Symbol) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.order(field, direction)
  end

  def self.raw_all(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value) : Array({{ model }}) | ::Grant::Error::ErrorBase
    scope = current_scope
    built = scope.assembler
    statement = built.select
    values = built.numbered_parameters.dup
    sql = statement.raw_sql
    unless clause.strip.empty?
      alias_name = quote(table_name)
      selected = (scope.select_columns || fields).map { |field| "#{alias_name}.#{quote(field)}" }.join(", ")
      clean_clause = adapter.postgres? ? ::Grant::Adapter::PlaceholderScanner::PlaceholderScanner.rewrite(clause.strip, values.size) : clause.strip
      sql = "SELECT #{selected} FROM (#{sql}) AS #{alias_name} #{clean_clause}"
      values.concat(params)
    end
    ::Grant::Query::Executor::List({{ model }}).new(sql, values).run
  end

  def self.select(*columns : Symbol | String) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.select(*columns)
  end

  {% for method in [:last, :take] %}
    def self.{{ method.id }} : {{ model }} | Nil | ::Grant::Error::ErrorBase
      current_scope.{{ method.id }}
    end
  {% end %}

  def self.last_strict : {{ model }} | ::Grant::Error::ErrorBase
    current_scope.last_strict
  end

  def self.take(n : Int32) : Array({{ model }}) | ::Grant::Error::ErrorBase
    current_scope.take(n)
  end

  def self.find_sole_by(**criteria) : {{ model }} | ::Grant::Error::ErrorBase
    current_scope.where(criteria.to_h).sole
  end

  {% for pair in [[:average, :avg], [:minimum, :min], [:maximum, :max]] %}
    def self.{{ pair[0].id }}(column : Symbol | String) : ::Grant::Adapter::Driver::Value | Hash(::Grant::Adapter::Driver::Value, ::Grant::Adapter::Driver::Value) | Hash(Array(::Grant::Adapter::Driver::Value), ::Grant::Adapter::Driver::Value) | ::Grant::Error::ErrorBase
      current_scope.{{ pair[1].id }}(column)
    end
  {% end %}

  def self.in_batches(of batch_size : Int32 = 1000, &block : ::Grant::Query::Builder::Builder({{ model }}) -> T) : Nil | T | ::Grant::Error::ErrorBase forall T
    current_scope.in_batches(of: batch_size) { |batch| yield batch }
  end

  def self.each_streamed(&block : {{ model }} -> T) : Nil | ::Grant::Error::ErrorBase forall T
    current_scope.each_streamed { |record| yield record }
  end

  def self.update_all(**changes) : Int64 | ::Grant::Error::ErrorBase
    current_scope.update_all(**changes)
  end

  def self.delete_all : Int64 | ::Grant::Error::ErrorBase
    current_scope.delete_all
  end

  def self.delete_by(**criteria) : Int64 | ::Grant::Error::ErrorBase
    current_scope.where(criteria.to_h).delete_all
  end

  def self.destroy_by(**criteria) : Int32 | ::Grant::Error::ErrorBase
    current_scope.where(criteria.to_h).destroy_all
  end

  def self.touch_all(*fields : Symbol, time : ::Std::Time::Time = ::Std::Time::Time.utc) : Int64 | ::Grant::Error::ErrorBase
    current_scope.touch_all(*fields, time: time)
  end

  private def self.ensure_raw_sql_unscoped_strict : Nil | ::Grant::Error::ErrorBase
    if _has_default_scope? && !_unscoped?
      return ::Grant::Querying::ScopedRawSqlError.new("Raw SQL cannot apply the default scope for #{self}. Wrap deliberate raw access in #{self}.unscoped { ... }.")
    end
    nil
  end

  def self.count(column : Symbol | String, distinct : Bool = false) : Int64 | ::Grant::Error::ErrorBase
    result = current_scope.count(column, distinct)!
    result.is_a?(Int64) ? result : result.values.sum
  end

  {% for operation in [:sum, :avg, :min, :max] %}
    def self.{{ operation.id }}(column : Symbol | String) : ::Grant::Adapter::Driver::Value | Hash(::Grant::Adapter::Driver::Value, ::Grant::Adapter::Driver::Value) | Hash(Array(::Grant::Adapter::Driver::Value), ::Grant::Adapter::Driver::Value) | ::Grant::Error::ErrorBase
      current_scope.{{ operation.id }}(column)
    end
  {% end %}

  def self.sole : {{ model }} | ::Grant::Error::ErrorBase
    records = current_scope.select!
    return ::Grant::Querying::NotFound.new("No #{self} found") if records.empty?
    return ::Grant::Querying::NotUnique.new("Multiple #{self} records found (expected exactly one)") if records.size > 1
    records.first
  end

  def self.destroy_by(**criteria) : Int32 | ::Grant::Error::ErrorBase
    destroy_by(criteria.to_h)
  end

  def self.destroy_by(criteria : Hash(K, V)) : Int32 | ::Grant::Error::ErrorBase forall K, V
    query = current_scope
    query = query.where(criteria) unless criteria.empty?
    query.destroy_all
  end

  def self.delete_by(**criteria) : Int64 | ::Grant::Error::ErrorBase
    delete_by(criteria.to_h)
  end

  def self.delete_by(criteria : Hash(K, V)) : Int64 | ::Grant::Error::ErrorBase forall K, V
    query = current_scope
    query = query.where(criteria) unless criteria.empty?
    query.delete_all
  end

  def self.find_sole_by(**criteria) : {{ model }} | ::Grant::Error::ErrorBase
    current_scope.find_sole_by(**criteria)
  end

  def self.find_sole_by(criteria : Hash(K, V)) : {{ model }} | ::Grant::Error::ErrorBase forall K, V
    current_scope.find_sole_by(criteria)
  end

  def self.exists?(id : T) : Bool | ::Grant::Error::ErrorBase forall T
    return false if id.nil?
    current_scope.where(primary_name, :eq, id).exists?
  end

  def self.exists?(**criteria) : Bool | ::Grant::Error::ErrorBase
    current_scope.where(criteria.to_h).exists?
  end

  def self.exists?(criteria : Hash(K, V)) : Bool | ::Grant::Error::ErrorBase forall K, V
    current_scope.where(criteria).exists?
  end

  def self.find_each(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, &block : {{ model }} -> T) : Nil | T | ::Grant::Error::ErrorBase forall T
    batch_scope(clause, params, offset)!.find_each(batch_size) { |record| yield record }
  end

  def self.find_in_batches(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, &block : Array({{ model }}) -> T) : Nil | T | ::Grant::Error::ErrorBase forall T
    return ::Grant::Error::ArgumentError.new("batch_size must be positive") if batch_size < 1
    batch_scope(clause, params, offset)!.find_in_batches(batch_size) { |batch| yield batch }
  end

  def self.find_each(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, **options, &block : {{ model }} -> T) : Nil | T | ::Grant::Error::ErrorBase forall T
    batch_scope(clause, params, offset)!.find_each(batch_size, **options) { |item| yield item }
  end

  def self.find_each(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, **options) : ::Grant::Query::Batches::RecordIterator({{ model }}, ::Grant::Query::Builder::Builder({{ model }})) | ::Grant::Error::ErrorBase
    batch_scope(clause, params, offset)!.find_each(batch_size, **options)
  end

  def self.find_in_batches(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, **options, &block : Array({{ model }}) -> T) : Nil | T | ::Grant::Error::ErrorBase forall T
    batch_scope(clause, params, offset)!.find_in_batches(batch_size, **options) { |item| yield item }
  end

  def self.find_in_batches(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, *, batch_size : Int32 = 1000, offset : Int32 = 0, **options) : ::Grant::Query::Batches::RecordBatchIterator({{ model }}, ::Grant::Query::Builder::Builder({{ model }})) | ::Grant::Error::ErrorBase
    batch_scope(clause, params, offset)!.find_in_batches(batch_size, **options)
  end

  private def self.batch_scope(clause : String, params : Array(::Grant::Adapter::Driver::Value), offset : Int32) : ::Grant::Query::Builder::Builder({{ model }}) | ::Grant::Error::ErrorBase
    scope = current_scope
    filter = clause.strip
    unless filter.empty?
      if ::Grant::Querying.invalid_batch_clause?(filter)
        return ::Grant::Error::ArgumentError.new("find_each/find_in_batches accept only a WHERE clause; use order, limit and offset on the relation instead")
      end
      filter = filter[6, filter.size - 6] if filter.upcase.starts_with?("WHERE ")
      scope = scope.where(filter, params)
    end
    scope = scope.offset(offset) if offset > 0
    scope
  end

  def self.from_rs(result : R) : {{ model }} | ::Grant::Error::ErrorBase forall R
    row = {} of String => ::Grant::Adapter::Driver::Value
    result.column_count.times do |index|
      value = result.read
      return value if value.is_a?(::Grant::Error::ErrorBase)
      row[result.column_name(index)] = ::Grant::Base.sqlite_value(value)
    end
    from_row(row)
  end

  def __reload_from_database : self | ::Grant::Error::ErrorBase
    fresh = self.class.where("#{::Grant::Base.quote_identifier(self.class.primary_name)} = ?", __primary_value).first!
    if fresh.nil?
      return ::Grant::Querying::NotFound.new("No #{self.class} found where #{self.class.primary_name} = #{__primary_value}")
    end
    \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      @\{{ column.name }} = fresh.__raw_\{{ column.name }}
    \{% end %}
    __mark_persisted
    clear_previous_changes
    clear_before_type_cast
    self
  end

  def self.all(clause : String) : Array({{ model }}) | ::Grant::Error::ErrorBase
    all(clause, [] of ::Grant::Adapter::Driver::Value)
  end

  def self.raw_all(clause : String = "", params : Array(V) = [] of ::Grant::Adapter::Driver::Value) : Array({{ model }}) | ::Grant::Error::ErrorBase forall V
    scope = current_scope
    built = scope.assembler
    source = built.select.raw_sql
    values = built.numbered_parameters.dup
    params.each { |value| values << ::Grant::Base.sqlite_value(value) }
    sql = "SELECT * FROM (#{source}) AS #{quote(table_name)} #{clause}"
    __connection.query(sql, values)!.map { |row| from_row(row)! }
  end

  def self.first(clause : String) : {{ model }} | Nil | ::Grant::Errors::DatabaseError | ::Grant::Error::ErrorBase
    first(clause, [] of ::Grant::Adapter::Driver::Value)
  end

  def self.first_strict(clause : String) : {{ model }} | ::Grant::Error::ErrorBase
    record = first(clause)!
    return ::Grant::Querying::NotFound.new("No " + {{ model.stringify }} + " found with first(#{clause})") if record.nil?
    record
  end

  def self.find_by(criteria : Hash(K, V)) : {{ model }} | Nil | ::Grant::Error::ErrorBase forall K, V
    current_scope.where(criteria).first
  end

  def self.find_by_strict(**criteria) : {{ model }} | ::Grant::Error::ErrorBase
    find_by_strict(criteria.to_h)
  end

  def self.find_by_strict(criteria : Hash(K, V)) : {{ model }} | ::Grant::Error::ErrorBase forall K, V
    record = find_by(criteria)!
    if record.nil?
      parts = [] of String
      criteria.each do |key, value|
        parts << (value.nil? ? "#{key} is NULL" : "#{key} = #{value}")
      end
      description = parts.join(" and ")
      return ::Grant::Querying::NotFound.new("No " + {{ model.stringify }} + " found where #{description}")
    end
    record
  end

  def self.query(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, &block : ::Grant::Adapter::Driver::ResultSet -> T) : T | ::Grant::Error::ErrorBase | Cancelled forall T
    ensure_raw_sql_unscoped_strict!
    connection.with_result_set(clause, params) { |rs| yield rs }
  end

  def self.scalar(clause : String = "", binds : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value) : ::Grant::Adapter::Driver::Value | ::Grant::Error::ErrorBase | Cancelled
    connection.select_value(clause, binds)
  end

  def self.scalar(clause : String, &block : ::Grant::Adapter::Driver::Value -> T) : T | ::Grant::Error::ErrorBase | Cancelled forall T
    yield scalar(clause)!
  end
end

# Uniqueness error from upstream Grant::Querying.
pub class NotUnique < ErrorBase
end

impl ::Error for NotUnique
  def message : String
    @message
  end
end

# Native macro expansion of upstream Querying::ClassMethods for non-Base probes.
pub macro class_methods
  def self.count : Int64 | ::Grant::Error::ErrorBase | Cancelled
    current_scope.count
  end
end

pub class ScopedRawSqlError < ErrorBase
end

impl ::Error for ScopedRawSqlError
  def message : String
    @message
  end
end
