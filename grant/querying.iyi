module grant/querying

import grant/errors::{RecordNotFound, ErrorBase}

pub class NotFound < RecordNotFound
end

impl ::Error for NotFound
  def message : String
    @message
  end
end

# ClassMethods raw-clause overloads and raw SQL passthroughs from upstream querying.cr.
pub macro model_methods(model)
  def self.first(clause : String) : {{ model }} | Nil | ::Grant::Errors::DatabaseError | ::Grant::Error::ErrorBase
    first(clause, [] of ::Grant::Adapter::Driver::Value)
  end

  def self.first_strict(clause : String) : {{ model }} | ::Grant::Error::ErrorBase
    record = first(clause)!
    return ::Grant::Querying::NotFound.new("No " + {{ model.stringify }} + " found with first(#{clause})") if record.nil?
    record
  end

  def self.find_by(criteria : Hash(K, V)) : {{ model }} | Nil | ::Grant::Error::ErrorBase forall K, V
    current_scope.where(criteria).first
  end

  def self.find_by_strict(**criteria) : {{ model }} | ::Grant::Error::ErrorBase
    find_by_strict(criteria.to_h)
  end

  def self.find_by_strict(criteria : Hash(K, V)) : {{ model }} | ::Grant::Error::ErrorBase forall K, V
    record = find_by(criteria)!
    if record.nil?
      parts = [] of String
      criteria.each do |key, value|
        parts << (value.nil? ? "#{key} is NULL" : "#{key} = #{value}")
      end
      description = parts.join(" and ")
      return ::Grant::Querying::NotFound.new("No " + {{ model.stringify }} + " found where #{description}")
    end
    record
  end

  def self.query(clause : String = "", params : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value, &block : ::Grant::Adapter::Driver::ResultSet -> T) : T | ::Grant::Error::ErrorBase | Cancelled forall T
    connection.with_result_set(clause, params) { |rs| yield rs }
  end

  def self.scalar(clause : String = "", binds : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value) : ::Grant::Adapter::Driver::Value | ::Grant::Error::ErrorBase | Cancelled
    connection.select_value(clause, binds)
  end

  def self.scalar(clause : String, &block : ::Grant::Adapter::Driver::Value -> T) : T | ::Grant::Error::ErrorBase | Cancelled forall T
    yield scalar(clause)!
  end
end

# Uniqueness error from upstream Grant::Querying.
pub class NotUnique < ErrorBase
end

impl ::Error for NotUnique
  def message : String
    @message
  end
end
