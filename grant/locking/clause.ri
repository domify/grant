module grant/locking/clause
import grant/error::{ArgumentError}

pub struct Clause
  getter sql : String

  private def initialize(@sql : String)
  end

  def self.__from_literal(sql : String) : Clause | ArgumentError
    valid = !sql.empty?
    index = 0
    while index < sql.bytesize
      byte = sql.to_unsafe[index]
      letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
      allowed = letter || (index > 0 && ((byte >= 48 && byte <= 57) || byte == 95 || byte == 46 || byte == 44 || byte == 32))
      valid = false unless allowed
      index += 1
    end
    return ArgumentError.new("Invalid lock clause #{sql.inspect}: only letters, digits, spaces, underscores, dots and commas are allowed") unless valid
    new(sql)
  end

  def to_s : String
    @sql
  end
end

pub macro clause(sql)
  {% unless sql.is_a?(StringLiteral) || sql.is_a?(Path) %}
    {% raise "Grant::Locking.clause takes a string literal or a constant" %}
  {% end %}
  ::Grant::Locking::Clause::Clause.__from_literal({{ sql }}).or_panic
end
