module grant/locking/optimistic

import grant/base::{Base}
import grant/error::{ErrorBase}

pub class StaleObjectError < ErrorBase
  getter record_class : String
  getter record_id : String?

  def initialize(record : Base, operation : String = "update")
    @record_class = record.class.to_s
    @record_id = record.__primary_value.to_s
    id = @record_id
    super(id.nil? ? "Attempted to #{operation} a stale #{@record_class}" :
      "Attempted to #{operation} a stale #{@record_class} (id: #{id})")
  end
end
