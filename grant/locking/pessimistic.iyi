module grant/locking/pessimistic

pub import grant/locking
pub import grant/error
import grant/error::{ErrorBase}

pub class UnsavedChangesLockError < ErrorBase
  def initialize(message = "Locking a record with unsaved changes is not supported; save them first or pass force: true to discard them")
    super(message)
  end
end

pub class TransactionRequiredError < ErrorBase
  def initialize(message = "Row locks need an open transaction; wrap the call in Model.transaction or use with_lock")
    super(message)
  end
end

# Imported classes cannot be reopened; expand the upstream Pessimistic
# instance and ClassMethods API into each model through Base's finished hook.
pub macro model_methods(model)
  def self.lock(mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update)
    ::Grant::Query::Builder::Builder({{ model }}).new.lock(mode)
  end

  def self.with_lock(id : ::Grant::Adapter::Driver::Value, mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update, requires_new : Bool = false, isolation : ::Grant::Transaction::IsolationLevel? = nil, &block : {{ model }} -> U) : U | ::Grant::Error::ErrorBase | ::Grant::Errors::RecordNotFound forall U
    outcomes = [] of U
    result = transaction(requires_new: requires_new, isolation: isolation) do
      record = where("#{::Grant::Base.quote_identifier(primary_name)} = ?", id).lock(mode).first_strict
      if record.is_a?(::Error)
        record
      else
        value = block.call(record)
        outcomes << value
        value
      end
    end
    return result if result.is_a?(::Error)
    outcomes.first
  end

  def self.with_lock(mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update, requires_new : Bool = false, isolation : ::Grant::Transaction::IsolationLevel? = nil, &block : {{ model }} -> U) : U | ::Grant::Error::ErrorBase | ::Grant::Errors::RecordNotFound forall U
    outcomes = [] of U
    result = transaction(requires_new: requires_new, isolation: isolation) do
      record = lock(mode).first_strict
      if record.is_a?(::Error)
        record
      else
        value = block.call(record)
        outcomes << value
        value
      end
    end
    return result if result.is_a?(::Error)
    outcomes.first
  end

  def with_lock(mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update, requires_new : Bool = false, isolation : ::Grant::Transaction::IsolationLevel? = nil, force : Bool = false, &block : {{ model }} -> U) : U | ::Grant::Error::ErrorBase | ::Grant::Errors::RecordNotFound forall U
    outcomes = [] of U
    result = self.class.transaction(requires_new: requires_new, isolation: isolation) do
      loaded = reload_with_lock(mode, force: force)
      if loaded.is_a?(::Error)
        loaded
      else
        value = block.call(self)
        outcomes << value
        value
      end
    end
    return result if result.is_a?(::Error)
    outcomes.first
  end

  def guard_row_lock_strict(mode : ::Grant::Locking::LockMode, force : Bool)
    return ::Grant::Locking::Pessimistic::UnsavedChangesLockError.new if !force && changed?
    if self.class.adapter.supports_lock_mode?(mode) && !::Grant::Transaction.in_explicit_transaction?
      return ::Grant::Locking::Pessimistic::TransactionRequiredError.new
    end
    nil
  end

  def reload_with_lock(mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update, force : Bool = false)
    guard_row_lock_strict(mode, force)!
    replace_with_locked_row(self.class.where("#{::Grant::Base.quote_identifier(self.class.primary_name)} = ?", __primary_value).lock(mode))
  end

  def lock_strict(mode : ::Grant::Locking::LockMode = ::Grant::Locking::LockMode::Update, force : Bool = false)
    reload_with_lock(mode, force: force)
  end

  def reload
    replace_with_locked_row(self.class.where("#{::Grant::Base.quote_identifier(self.class.primary_name)} = ?", __primary_value))
  end

  private def replace_with_locked_row(locked_relation)
    fresh = locked_relation.first_strict!
    \{% for column in @type.instance_vars.select { |v| v.annotation(::Grant::Base::Column) } %}
      @\{{ column.name }} = fresh.__raw_\{{ column.name }}
    \{% end %}
    __mark_persisted
    self
  end
end
