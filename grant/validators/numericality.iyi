module grant/validators/numericality

import std/text

pub def numeric_value(value : T) : Int64 | Float64 | Nil forall T
  if value.is_a?(Int32) || value.is_a?(Int64)
    value.to_i64
  elsif value.is_a?(Float32) || value.is_a?(Float64)
    value.finite? ? value.to_f64 : nil
  elsif value.is_a?(String)
    integer = value.strip.to_i64?
    return integer unless integer.nil?
    number = value.strip.to_f64?
    number && number.finite? ? number : nil
  else
    nil
  end
end

pub def integer_value?(raw : T, number : Int64 | Float64) : Bool forall T
  number.is_a?(Int64) || raw.is_a?(Int32) || raw.is_a?(Int64)
end

pub macro model_methods(model)
  macro validates_numericality_of(*fields, **options)
    \{% for field in fields %}
      def __validate_numericality_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
        value = self.\{{ field.id }}
        __validation_rule_options(\{{ field }}, value, \{{ options.double_splat }})
        number = ::Grant::Validators::Numericality.numeric_value(value)
        if number.nil?
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "is not a number" }}, :not_a_number)
          return nil
        end
        \{% if options[:only_integer] %}
          unless ::Grant::Validators::Numericality.integer_value?(value, number)
            errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
              \{{ options[:message] || "must be an integer" }}, :not_an_integer)
            return nil
          end
        \{% end %}
        \{% for comparison in [
          {key: :greater_than, op: ">", text: "greater than"},
          {key: :greater_than_or_equal_to, op: ">=", text: "greater than or equal to"},
          {key: :equal_to, op: "==", text: "equal to"},
          {key: :less_than, op: "<", text: "less than"},
          {key: :less_than_or_equal_to, op: "<=", text: "less than or equal to"},
          {key: :other_than, op: "!=", text: "other than"},
        ] %}
          \{% operand = options[comparison[:key]] %}
          \{% if operand != nil && operand != false %}
            \{% if operand.is_a?(SymbolLiteral) %}
              bound = ::Grant::Validators::Numericality.numeric_value(self.\{{ operand.id }})
            \{% elsif operand.is_a?(ProcLiteral) || operand.is_a?(ProcNotation) %}
              bound = ::Grant::Validators::Numericality.numeric_value((\{{ operand }}).call(self))
            \{% else %}
              bound = ::Grant::Validators::Numericality.numeric_value(\{{ operand }})
            \{% end %}
            return ::Grant::Error::ArgumentError.new(\{{ "#{comparison[:key]} must be a number" }}) if bound.nil?
            unless number \{{ comparison[:op].id }} bound
              errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
                \{% if options[:message] %}\{{ options[:message] }}\{% else %}"must be \{{ comparison[:text].id }} #{bound}"\{% end %},
                \{{ comparison[:key] }})
            end
          \{% end %}
        \{% end %}
        \{% if options[:odd] %}
          unless number.to_i64 % 2 != 0
            errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
              \{{ options[:message] || "must be odd" }}, :odd)
          end
        \{% end %}
        \{% if options[:even] %}
          unless number.to_i64 % 2 == 0
            errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
              \{{ options[:message] || "must be even" }}, :even)
          end
        \{% end %}
        nil
      end
    \{% end %}
  end
end
