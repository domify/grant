module grant/validators/uniqueness

pub macro model_methods(model)
  macro validates_uniqueness_of(*fields, **options)
    \{% for field in fields %}
      def __validate_uniqueness_of_\{{ field.id }} : Nil | ::Grant::Error::ErrorBase
        \{% if options[:if] %}
          return nil unless self.\{{ options[:if].id }}
        \{% end %}
        \{% if options[:unless] %}
          return nil if self.\{{ options[:unless].id }}
        \{% end %}
        \{% if options[:on] %}
          contexts = \{{ options[:on] }}
          contexts = [contexts] unless contexts.is_a?(Array(Symbol))
          active = __active_validation_contexts
          return nil unless active.includes?(:save) || contexts.includes?(:save) || contexts.any? { |item| active.includes?(item) }
        \{% end %}
        value = \{{ field.id }}
        return nil if value.nil?
        \{% if options[:allow_blank] %}
          return nil if ::Grant::Validators.blank?(value)
        \{% end %}
        \{% if options[:case_sensitive] == false %}
          query = self.class.where("LOWER(#{self.class.quote(\{{ field.id.stringify }})}) = LOWER(?)", value)
        \{% else %}
          query = self.class.where(\{{ field.id }}: value)
        \{% end %}
        \{% if options[:scope] %}
          \{% scopes = options[:scope].is_a?(ArrayLiteral) ? options[:scope] : [options[:scope]] %}
          \{% for scope_field in scopes %}
            scope_value = self.\{{ scope_field.id }}
            if scope_value.nil?
              query = query.where("#{self.class.quote(\{{ scope_field.id.stringify }})} IS NULL")
            else
              query = query.where("#{self.class.quote(\{{ scope_field.id.stringify }})} = ?", scope_value)
            end
          \{% end %}
        \{% end %}
        \{% if options[:conditions] %}
          \{% if options[:conditions].is_a?(ProcLiteral) && options[:conditions].args.size == 2 %}
            query = (\{{ options[:conditions] }}).call(query, self)
          \{% else %}
            query = (\{{ options[:conditions] }}).call(query)
          \{% end %}
        \{% end %}
        if persisted?
          query = query.where("#{self.class.quote(self.class.primary_name)} != ?", id)
        end
        if query.exists?!
          errors << ::Grant::Error::Error.new(\{{ field.id.stringify }},
            \{{ options[:message] || "has already been taken" }}, :taken)
        end
        nil
      end
    \{% end %}
  end

end
