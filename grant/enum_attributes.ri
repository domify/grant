module grant/enum_attributes

pub import grant/converters
import grant/converters::{Enum}
import grant/error::{ErrorBase}
import std/text

pub class UnknownEnumValueError < ErrorBase
end

pub annotation EnumAttribute
end

pub def underscore(text : String) : String
  result = ""
  text.chars.each_with_index do |char, index|
    uppercase = char >= 'A' && char <= 'Z'
    if uppercase && index > 0
      previous = text[index - 1]
      following = index + 1 < text.size ? text[index + 1] : ' '
      if (previous >= 'a' && previous <= 'z') || (previous >= '0' && previous <= '9') || (previous >= 'A' && previous <= 'Z' && following >= 'a' && following <= 'z')
        result += "_"
      end
    end
    result += char == '-' ? "_" : char.to_s.downcase
  end
  result
end

pub macro enum_attribute(model, decl, **options)
  {% name = decl.var %}
  {% type = decl.type %}
  {% default = decl.value || options[:default] %}
  {% column_type = options[:column_type] || String %}
  {% enum_type = type.resolve.nilable? ? type.resolve.union_types.find { |t| t != Nil } : type.resolve %}
  {% converter = options[:converter] || "::Grant::Converters::Enum(#{enum_type}, #{column_type})".id %}
  column {{ name }} : {{ type }}, converter: {{ converter }}, column_type: {{ column_type }}, enum_attribute: true

  @[::Grant::EnumAttributes::EnumAttribute(attribute: {{ name.stringify }})]
  def __enum_attribute_{{ name }} : Nil
    nil
  end

  @_invalid_enum_{{ name }} : String? = nil

  def __after_assign_{{ name }}(value : V) : Nil forall V
    @_invalid_enum_{{ name }} = nil
    nil
  end

  def __invalid_enum_{{ name }}? : Bool
    !@_invalid_enum_{{ name }}.nil?
  end

  def self.__enum_lookup_{{ name }}(value : String | Symbol) : {{ enum_type }}?
    text = value.to_s
    {{ enum_type }}.values.find { |member| ::Grant::EnumAttributes.underscore(member.to_s) == ::Grant::EnumAttributes.underscore(text) }
  end

  def self.__coerce_where_{{ name }}(value : V) : V | ::Grant::Columns::Type forall V
    if value.is_a?({{ enum_type }})
      {{ converter }}.to_db(value)
    elsif value.is_a?(String) || value.is_a?(Symbol)
      member = __enum_lookup_{{ name }}(value)
      member.nil? ? value : {{ converter }}.to_db(member)
    else
      value
    end
  end

  def {{ name }}=(value : String | Symbol) : {{ enum_type }} | Nil | ::Grant::EnumAttributes::UnknownEnumValueError
    member = self.class.__enum_lookup_{{ name }}(value)
    unless member.nil?
      self.{{ name }} = member
      return member
    end
    {% if options[:validate] %}
      @_invalid_enum_{{ name }} = value.to_s
      nil
    {% else %}
      ::Grant::EnumAttributes::UnknownEnumValueError.new("'#{value}' is not a valid {{ name }}")
    {% end %}
  end

  {% prefix = options[:prefix] %}
  {% suffix = options[:suffix] %}
  {% name_prefix = (prefix == nil || prefix == false) ? "" : (prefix == true ? "#{name.id}_" : "#{prefix.id}_") %}
  {% name_suffix = (suffix == nil || suffix == false) ? "" : (suffix == true ? "_#{name.id}" : "_#{suffix.id}") %}
  {% for member in enum_type.constants %}
    {% helper = "#{name_prefix.id}#{member.underscore}#{name_suffix.id}" %}
    def {{ helper.id }}? : Bool
      {{ name }} == {{ enum_type }}::{{ member }}
    end

    def assign_{{ helper.id }} : {{ enum_type }}
      self.{{ name }} = {{ enum_type }}::{{ member }}
      {{ enum_type }}::{{ member }}
    end

    def {{ helper.id }}_strict : {{ enum_type }} | ::Grant::Error::ErrorBase
      self.{{ name }} = {{ enum_type }}::{{ member }}
      save_strict!
      {{ enum_type }}::{{ member }}
    end

    {% if options[:scopes] != false %}
      def self.{{ helper.id }} : ::Grant::Query::Builder::Builder({{ model }})
        where({{ name }}: {{ enum_type }}::{{ member }})
      end
      def self.not_{{ helper.id }} : ::Grant::Query::Builder::Builder({{ model }})
        where.not({{ name }}: {{ enum_type }}::{{ member }})
      end
    {% end %}
  {% end %}

  {% plural = name.stringify.ends_with?("s") ? name.stringify + "es" : name.stringify + "s" %}
  def self.{{ plural.id }} : Hash(String, {{ enum_type }})
    {{ name }}_mapping
  end

  def self.{{ name }}_mapping : Hash(String, {{ enum_type }})
    {
      {% for member in enum_type.constants %}
        {{ member.underscore.stringify }} => {{ enum_type }}::{{ member }},
      {% end %}
    } of String => {{ enum_type }}
  end

  {% if options[:validate] %}
    {% allow_nil = type.resolve.nilable? && options[:validate].is_a?(NamedTupleLiteral) && options[:validate][:allow_nil] %}
    validate "{{ name }} is not included in the list" do |model|
      !model.__invalid_enum_{{ name }}? && {% if allow_nil %}true{% else %}!model.{{ name }}.nil?{% end %}
    end
  {% end %}

  {% if default %}
    after_initialize do
      if @{{ name }}.nil? && new_record?
        @{{ name }} = {% if default.is_a?(SymbolLiteral) %}{{ enum_type }}::{{ default.id.camelcase }}{% else %}{{ default }}{% end %}
      end
      nil
    end
  {% end %}
end

pub macro enum_attributes(model, **mappings)
  {% for name, config in mappings %}
    {% if config.is_a?(HashLiteral) %}
      ::Grant::EnumAttributes.enum_attribute({{ model }}, {{ name }} : {{ config[:type] }}, {{ config.double_splat }})
    {% else %}
      ::Grant::EnumAttributes.enum_attribute({{ model }}, {{ name }} : {{ config }})
    {% end %}
  {% end %}
end

pub macro model_methods(model)
  def self.coerce_enum_where(field : String, value : V) : V | ::Grant::Columns::Type forall V
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::EnumAttributes::EnumAttribute) %}
        return __coerce_where_\{{ ann[:attribute].id }}(value) if field == \{{ ann[:attribute] }}
      \{% end %}
    \{% end %}
    value
  end
end
