module grant/migrator
import std/text
import grant/adapter/driver::{Connection}
import grant/errors::{DatabaseError, ErrorBase}
import grant/schema/index_definition::{IndexDefinition}
import grant/adapter/schema::{Dialect}
import grant/adapter/base::{Base}
import grant/schema/internal_metadata::{InternalMetadata, ProtectedEnvironmentError}

# Literal defaults follow src/grant/migrator.cr; expressions are not inferred.
pub def default_clause_for(value : T) : String forall T
  case value
  when String then " DEFAULT '#{value.gsub("'", "''")}'"
  when Bool then " DEFAULT #{value ? "TRUE" : "FALSE"}"
  when Int32, Int64, Float32, Float64 then " DEFAULT #{value}"
  when Nil then " DEFAULT NULL"
  else ""
  end
end

pub def quote_identifier(name : String) : String
  name.split('.').map { |part| "\"#{part.gsub("\"", "\"\"")}\"" }.join(".")
end

# One column of a model as the migrator sees it: the Crystal type name and
# the column annotation's options.
pub struct MigratorColumn
  getter name : String
  getter type_name : String
  getter column_type : String?
  getter primary : Bool
  getter auto : Bool

  getter default_sql : String?
  getter literal_default : String
  getter limit : Int32?
  getter precision : Int32?
  getter scale : Int32?
  getter null : Bool?
  getter collation : String?
  getter comment : String?

  def initialize(@name : String, @type_name : String, @column_type : String?, @primary : Bool, @auto : Bool, @literal_default : String = "", @limit : Int32? = nil, @precision : Int32? = nil, @scale : Int32? = nil, @null : Bool? = nil, @collation : String? = nil, @comment : String? = nil, @default_sql : String? = nil)
  end

  def nilable? : Bool
    @type_name.includes?("?") || @type_name.includes?("Nil")
  end

  def base_type : String
    @type_name.gsub("::", "").gsub(" | Nil", "").gsub("Nil | ", "").gsub("?", "").strip
  end
end

pub class Migrator
  # Grant::Adapter::Pg::Schema::TYPES over Grant::Adapter::Base::Schema::TYPES.
  PG_TYPES = {
    "Bool"       => "BOOL",
    "Float32"    => "REAL",
    "Float64"    => "DOUBLE PRECISION",
    "Int32"      => "INT",
    "Int64"      => "BIGINT",
    "String"     => "TEXT",
    "Time"       => "TIMESTAMP",
    "StdTimeTime" => "TIMESTAMP",
    "AUTO_Int32" => "SERIAL",
    "AUTO_Int64" => "BIGSERIAL",
    "UUID"       => "UUID",
    "created_at" => "TIMESTAMP",
    "updated_at" => "TIMESTAMP",
  }

  getter index_definitions = [] of Proc(String, IndexDefinition | ErrorBase)

  getter table : String
  getter connection : Connection
  property schema_adapter : Base? = nil
  @specs : Array(MigratorColumn)

  def initialize(@connection : Connection, @table : String, @specs : Array(MigratorColumn))
  end

  def columns : Array(String)
    @specs.map { |spec| column_sql(spec) }
  end

  def native_type(spec : MigratorColumn) : String
    explicit = spec.column_type
    return explicit unless explicit.nil?
    key = spec.base_type
    key = "UUID" if key == "StdUuidUUID"
    if @connection.postgres?
      arrays = {"Array(String)" => "TEXT[]", "Array(Int16)" => "SMALLINT[]", "Array(Int32)" => "INT[]", "Array(Int64)" => "BIGINT[]", "Array(Float32)" => "REAL[]", "Array(Float64)" => "DOUBLE PRECISION[]", "Array(Bool)" => "BOOLEAN[]"}
      if array_type = arrays[key]?
        return array_type
      end
      return PG_TYPES["AUTO_#{key}"]? || "BIGSERIAL" if spec.primary && spec.auto && key.starts_with?("Int")
      return PG_TYPES[spec.name]? || "TIMESTAMP" if spec.name == "created_at" || spec.name == "updated_at"
      return PG_TYPES[key]? || "TEXT"
    end
    case key
    when "String" then "VARCHAR(255)"
    when "Time", "StdTimeTime" then spec.name == "created_at" || spec.name == "updated_at" ? "VARCHAR" : "TIMESTAMP"
    when "Bool" then "BOOL"
    when "Float32" then "FLOAT"
    when "Float64" then "REAL"
    when "UUID", "StdUuidUUID" then "CHAR(36)"
    else "INTEGER"
    end
  end

  private def default_clause(spec : MigratorColumn) : String
    expression = spec.default_sql
    return spec.literal_default if expression.nil?
    dialect = @connection.postgres? ? Dialect::Pg : Dialect::Sqlite
    " DEFAULT #{dialect.default_expression(expression)}"
  end

  private def column_sql(spec : MigratorColumn) : String
    name = quote_identifier(spec.name)
    if spec.primary && @specs.count { |column| column.primary } == 1
      type = native_type(spec)
      # Upstream AUTO_Int maps to INTEGER NOT NULL on SQLite; AUTO_UUID stays CHAR(36).
      type += " NOT NULL" unless @connection.postgres? || !spec.auto || type != "INTEGER"
      "#{name} #{type} PRIMARY KEY#{default_clause(spec)}"
    else
      type = native_type(spec)
      unless spec.column_type
        type = "VARCHAR(#{spec.limit})" if spec.base_type == "String" && spec.limit
        type = "TIMESTAMP(#{spec.precision})" if @connection.postgres? && spec.precision && (spec.base_type == "Time" || spec.base_type == "StdTimeTime")
        if collation = spec.collation
          type += " COLLATE #{@connection.postgres? ? quote_identifier(collation) : collation}"
        end
      end
      not_null = spec.null == false || (spec.null != true && !spec.nilable? && !spec.column_type && spec.name != "created_at" && spec.name != "updated_at")
      "#{name} #{type}#{not_null ? " NOT NULL" : ""}#{default_clause(spec)}"
    end
  end

  def create_sql(if_not_exists : Bool = false, temporary : Bool = false, comment : String? = nil) : String
    primary = @specs.select { |spec| spec.primary }.map { |spec| column_sql(spec) }
    content = @specs.reject { |spec| spec.primary }.map { |spec| column_sql(spec) }
    if primary.size > 1
      content << "PRIMARY KEY (#{@specs.select { |spec| spec.primary }.map { |spec| quote_identifier(spec.name) }.join(", ")})"
    end
    body = primary.join(",\n")
    content.each { |line| body += ",\n#{line}\n" }
    "CREATE #{temporary ? "TEMPORARY " : ""}TABLE #{if_not_exists ? "IF NOT EXISTS " : ""}#{quote_identifier(@table)}(\n#{body}) ;\n"
  end

  def create_statements(if_not_exists : Bool = false, temporary : Bool = false, comment : String? = nil) : Array(String) | ErrorBase
    statements = [create_sql(if_not_exists, temporary, comment)]
    if @connection.postgres?
      if text = comment
        statements << "COMMENT ON TABLE #{quote_identifier(@table)} IS '#{text.gsub("'", "''")}'"
      end
      @specs.each do |spec|
        if text = spec.comment
          statements << "COMMENT ON COLUMN #{quote_identifier(@table)}.#{quote_identifier(spec.name)} IS '#{text.gsub("'", "''")}'"
        end
      end
    end
    dialect = @connection.postgres? ? Dialect::Pg : Dialect::Sqlite
    index_definitions.each { |factory| statements.concat(factory.call(table)!.statements(dialect)!) }
    statements
  end

  def drop_sql(if_exists : Bool = true, cascade : Bool = false) : String
    "DROP TABLE #{if_exists ? "IF EXISTS " : ""}#{quote_identifier(@table)}#{cascade && @connection.postgres? ? " CASCADE" : ""};"
  end

  def drop(if_exists : Bool = true, cascade : Bool = false) : Nil | DatabaseError
    @connection.execute(drop_sql(if_exists, cascade))!
    nil
  end

  def create(if_not_exists : Bool = false, temporary : Bool = false, comment : String? = nil) : Nil | DatabaseError | ErrorBase
    create_statements(if_not_exists, temporary, comment)!.each { |sql| @connection.execute(sql)! }
    nil
  end

  private def check_protected_environment_strict(force : Bool, environment : String?, protected_environments : Array(String)) : Nil | ErrorBase | Cancelled
    return nil if force
    target = schema_adapter
    return nil if target.nil?
    metadata = InternalMetadata.new(target)
    if environment
      metadata.check_protected_environments_strict(environment, protected_environments, false)!
    elsif stored = metadata.environment!
      return ProtectedEnvironmentError.new(stored) if protected_environments.includes?(stored)
    end
    nil
  end

  def drop_and_create(force : Bool = false, environment : String? = nil, protected_environments : Array(String) = InternalMetadata::DEFAULT_PROTECTED) : Nil | DatabaseError | ErrorBase | Cancelled
    check_protected_environment_strict(force, environment, protected_environments)!
    drop(cascade: @connection.postgres?)!
    create!
  end
end
