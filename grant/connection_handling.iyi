module grant/connection_handling
import grant/error::{ErrorBase}
import grant/connection_registry::{ConnectionRegistry}

pub class UnestablishedConnectionError < ErrorBase
end
impl ::Error for UnestablishedConnectionError
  def message : String
    @message
  end
end

pub class ConnectionHandling
  pub alias ConnectionNames = Array(Tuple(String, Symbol, Symbol?))
  @@declared = {} of String => Proc(ConnectionNames)
  @@primary_abstract_class_name : String? = nil

  def self.primary_abstract_class_name : String?
    @@primary_abstract_class_name
  end

  def self.primary_abstract_class_name=(name : String) : String
    @@primary_abstract_class_name = name
  end

  def self.declare(model_name : String, names : Proc(ConnectionNames)) : Nil
    @@declared[model_name] = names
    ConnectionRegistry.register_declared_connection_verifier { verify_all_strict }
    nil
  end

  def self.declared_models : Array(String)
    @@declared.keys
  end

  def self.verify_strict(model_name : String, names : ConnectionNames) : Nil | UnestablishedConnectionError
    message = missing_connections_message(model_name, names)
    return nil if message.nil?
    UnestablishedConnectionError.new("#{message}. Establish them with Grant::ConnectionRegistry.establish_connection before verifying.")
  end

  def self.verify_all_strict : Nil | UnestablishedConnectionError
    messages = [] of String
    @@declared.each do |model_name, names|
      message = missing_connections_message(model_name, names.call)
      messages << message unless message.nil?
    end
    return nil if messages.empty?
    UnestablishedConnectionError.new("#{messages.join("; ")}. Establish them with Grant::ConnectionRegistry.establish_connection before verifying.")
  end

  private def self.missing_connections_message(model_name : String, names : ConnectionNames) : String?
    missing = [] of String
    names.each do |entry|
      database, role, shard = entry
      found = false
      [shard, nil].each do |registered_shard|
        [ConnectionRegistry.normalize_role(role), :writing, :primary].each do |registered_role|
          found = true if ConnectionRegistry.connection_exists?(database, registered_role, registered_shard)
        end
      end
      unless found
        missing << (shard.nil? ? "#{database} (role: #{role})" : "#{database} (role: #{role}, shard: #{shard})")
      end
    end
    return nil if missing.empty?
    "#{model_name} declares connections that are not established: #{missing.join(", ")}"
  end
end

pub macro model_methods(model)
  def self.shard_config : Hash(Symbol, Hash(Symbol, String))
    own = @@own_shard_config
    return own unless own.nil?
    {% if model.resolve.superclass.stringify != "Grant::Base::Base" %}
      {{ model.resolve.superclass }}.shard_config
    {% else %}
      @@own_shard_config ||= {} of Symbol => Hash(Symbol, String)
    {% end %}
  end

  def self.abstract_class? : Bool
    @@abstract_class
  end

  def self.abstract_class=(value : Bool) : Bool
    @@abstract_class = value
  end

  def self.shard_config=(config : Hash(Symbol, Hash(Symbol, String))) : Nil
    @@own_shard_config = config
    nil
  end

  def self.shard_keys : Array(Symbol)
    shard_config.keys
  end

  def self.default_shard : Symbol
    return :default if shard_config.has_key?(:default)
    shard_config.keys.first? || :default
  end

  def self.sharded? : Bool
    !shard_config.empty?
  end

  def self.connection_names : Array(Tuple(String, Symbol, Symbol?))
    names = [] of Tuple(String, Symbol, Symbol?)
    names << {default_database_name, :writing, nil} if connection_config.empty? && shard_config.empty?
    connection_config.each { |role, name| names << {name, role, nil} }
    shard_config.each do |shard, roles|
      roles.each { |role, name| names << {name, role, shard} }
    end
    names.uniq
  end

  def self.verify_connections_strict : Nil | ::Grant::ConnectionHandling::UnestablishedConnectionError
    ::Grant::ConnectionHandling::ConnectionHandling.verify_strict({{ model.stringify }}, connection_names)
  end
end
