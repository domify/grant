module grant/value

pub struct Binary
  getter data : String

  def initialize(@data : String)
  end

  def ==(other : Binary) : Bool
    @data == other.data
  end

  def hash : Int32
    @data.hash
  end

  def self.from_bytes(bytes : Array(UInt8)) : Binary
    data = String.new(bytes.size) do |buffer|
      bytes.each_with_index { |byte, index| buffer[index] = byte }
      nil
    end
    new(data)
  end

  def bytes : Array(UInt8)
    result = [] of UInt8
    data.bytesize.times { |index| result << data.to_unsafe[index] }
    result
  end

  def hex : String
    digits = "0123456789abcdef"
    String.new(data.bytesize * 2) do |buffer|
      data.bytesize.times do |index|
        byte = data.to_unsafe[index].to_i32
        buffer[index * 2] = digits.to_unsafe[byte // 16]
        buffer[index * 2 + 1] = digits.to_unsafe[byte % 16]
      end
      nil
    end
  end
end

pub alias Value = Nil | Bool | Int64 | Float64 | String | Binary
pub alias Attributes = Hash(String, Value)

# The row is data; mapping it into an application record is an explicit API.
pub struct Row
  getter attributes : Attributes

  def initialize(@attributes : Attributes)
  end

  def [](name : String) : Value
    @attributes[name]
  end

  def []?(name : String) : Value
    @attributes[name]?
  end
end
