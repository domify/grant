module grant/sanitization

import std/text
import std/time::{Time}
import std/slice::{Bytes}
import grant/adapter/base::{Base}
import grant/error::{ArgumentError}
import grant/adapter/driver::{Value}
import grant/query/bind_value::{to_value}

pub class WrongNumberOfArguments < ArgumentError
end

impl ::Error for WrongNumberOfArguments
  def message : String
    @message
  end
end

pub def quote(value : T, adapter : Base? = nil) : String | ArgumentError forall T
  case value
  when Nil
    "NULL"
  when Bool
    adapter.nil? ? (value ? "1" : "0") : adapter.quote_boolean(value)
  when Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, Float32, Float64
    value.to_s
  when String, Char, Symbol
    quote_string(value.to_s)
  when Time
    quote_string(value.to_rfc3339.gsub("T", " ").gsub("Z", ""))
  when Bytes
    quote_bytes(value)
  else
    ArgumentError.new("Grant::Sanitization cannot quote value of type #{T}")
  end
end

pub def quote_string(value : String) : String
  escaped = value.gsub("\0", "").gsub("'", "''")
  "'#{escaped}'"
end

pub def quote_identifier(name : T, adapter : Base? = nil) : String forall T
  return adapter.quote(name.to_s) unless adapter.nil?
  escaped = name.to_s.gsub("\"", "\"\"")
  "\"#{escaped}\""
end

pub def sanitize_sql_array(ary : Array(T), adapter : Base? = nil) : String | ArgumentError forall T
  return ArgumentError.new("sanitize_sql_array requires a non-empty array") if ary.empty?
  sql = ary.first.to_s
  if ary.size == 2
    named = ary[1]
    if named.is_a?(NamedTuple) || named.is_a?(Hash)
      statement, bound = rewrite_named_binds(sql, named)!
      return substitute_placeholders(statement, bound, adapter)
    end
  end
  values = [] of T
  ary.each_with_index { |value, index| values << value if index > 0 }
  placeholder_count = count_placeholders(sql)
  if placeholder_count != values.size
    return WrongNumberOfArguments.new("wrong number of bind variables (#{values.size} for #{placeholder_count}) in: #{sql}")
  end
  return sql if placeholder_count == 0
  substitute_placeholders(sql, values, adapter)
end

pub def sanitize_sql_array(*args : *T, adapter : Base? = nil) : String | ArgumentError forall T
  sanitize_sql_array(args.to_a, adapter)
end

private def count_placeholders(sql : String) : Int32
  count = 0
  in_string = false
  chars = sql.chars
  i = 0
  while i < chars.size
    c = chars[i]
    if c == '\''
      if in_string && i + 1 < chars.size && chars[i + 1] == '\''
        i += 2
        next
      end
      in_string = !in_string
    elsif c == '?' && !in_string
      count += 1
    end
    i += 1
  end
  count
end

private def substitute_placeholders(sql : String, values : Array(T), adapter : Base?) : String | ArgumentError forall T
  result = String::Builder.new
  in_string = false
  value_index = 0
  chars = sql.chars
  i = 0
  while i < chars.size
    c = chars[i]
    if c == '\''
      if in_string && i + 1 < chars.size && chars[i + 1] == '\''
        result << '\'' << '\''
        i += 2
        next
      end
      in_string = !in_string
      result << c
    elsif c == '?' && !in_string
      result << quote(values[value_index], adapter)!
      value_index += 1
    else
      result << c
    end
    i += 1
  end
  result.to_s
end

private def quote_bytes(value : Bytes) : String
  "x'#{value.hexstring}'"
end

pub def rewrite_named_binds(statement : String, binds : T) : Tuple(String, Array(Value)) | ArgumentError forall T
  named = {} of String => Tuple(Array(Value), Bool)
  binds.each do |name, value|
    if value.is_a?(Array)
      list = [] of Value
      value.each { |item| list << to_value(item) }
      named[name.to_s] = {list, true}
    else
      named[name.to_s] = {[to_value(value)] of Value, false}
    end
  end

  output = String::Builder.new
  values = [] of Value
  chars = statement.chars
  quote : Char? = nil
  index = 0

  while index < chars.size
    char = chars[index]

    if current_quote = quote
      output << char
      quote = nil if char == current_quote
    elsif char == '\'' || char == '"' || char == '`'
      quote = char
      output << char
    elsif char == '-' && chars[index + 1]? == '-'
      while index < chars.size && chars[index] != '\n'
        output << chars[index]
        index += 1
      end
      next
    elsif char == '/' && chars[index + 1]? == '*'
      output << char << chars[index + 1]
      index += 2
      while index < chars.size
        output << chars[index]
        index += 1
        break if chars[index - 1] == '/' && chars[index - 2] == '*'
      end
      next
    elsif char == ':' && chars[index + 1]? == ':'
      output << "::"
      index += 2
      next
    elsif char == ':' && (following = chars[index + 1]?) && (named_bind_letter?(following) || following == '_')
      name_end = index + 1
      while name_end < chars.size && ((named_bind_letter?(chars[name_end]) || (chars[name_end] >= '0' && chars[name_end] <= '9')) || chars[name_end] == '_')
        name_end += 1
      end
      name_buffer = String::Builder.new
      name_index = index + 1
      while name_index < name_end
        name_buffer << chars[name_index]
        name_index += 1
      end
      name = name_buffer.to_s
      bind = named[name]?
      return ArgumentError.new("Missing value for named bind :#{name} in: #{statement}") if bind.nil?
      if bind[1]
        output << (bind[0].empty? ? "NULL" : Array.new(bind[0].size, "?").join(", "))
      else
        output << '?'
      end
      values.concat(bind[0])
      index = name_end
      next
    else
      output << char
    end

    index += 1
  end

  {output.to_s, values}
end

private def named_bind_letter?(char : Char) : Bool
  (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
end
