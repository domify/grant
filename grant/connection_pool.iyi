module grant/connection_pool

import grant/adapter/base::{Base}
import grant/adapter/sqlite_connection::{Connection}
import grant/pool_stat::{PoolStat}
import grant/error::{ErrorBase}

pub class ConnectionPool
  getter adapter : Base

  def initialize(@adapter : Base)
  end

  def stat : PoolStat
    @adapter.pool_stat
  end

  def size : Int32
    stat.size
  end

  def connections : Int32
    stat.connections
  end

  def busy : Int32
    stat.busy
  end

  def idle : Int32
    stat.idle
  end

  def waiting : Int32
    stat.waiting
  end

  def connected? : Bool
    @adapter.connected?
  end

  def active? : Bool
    @adapter.active?
  end

  def verify_strict : Nil | ErrorBase
    @adapter.verify_strict
  end

  def disconnect_strict : Nil | ErrorBase
    @adapter.disconnect_strict
  end

  def reconnect_strict : Nil | ErrorBase
    @adapter.reconnect_strict
  end

  def with_connection(&block : Connection -> T) : T | ErrorBase | Cancelled forall T
    @adapter.with_connection { |connection| yield connection }
  end
end
