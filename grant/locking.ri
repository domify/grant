module grant/locking

pub import grant/locking/clause
import grant/error_taxonomy

pub alias DeadlockError = ::Grant::ErrorTaxonomy::Deadlocked

pub alias LockWaitTimeoutError = ::Grant::ErrorTaxonomy::LockWaitTimeout

# The adapter owns SQL rendering so a SQLite-only application never imports
# an adapter it does not use.
pub enum LockMode
  Update
  Share
  UpdateNoWait
  UpdateSkipLocked
  ShareNoWait
  ShareSkipLocked

  def to_sql(adapter) : String
    adapter.lock_clause(self)
  end
end
