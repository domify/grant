module grant/spec_support/transactional

import grant/adapter/base::{Base}
import grant/connections::{Connections}
import grant/transaction::{Handle, Options, begin_manual}
import grant/errors::{ErrorBase}

# Native assertion scripts call run_example at their example boundary; there is
# no Crystal Spec.around_each in the native test runner.
@@transactional : Bool = false
@@only : Array(String)? = nil

pub def transactional(only : Array(String)? = nil) : Nil
  @@transactional = true
  @@only = only
  nil
end

pub def run_example(&block : -> T) : T | ErrorBase forall T
  return within_transaction(@@only) { yield } if @@transactional
  yield
end

pub def within_transaction(only : Array(String)? = nil, &block : -> T) : T | ErrorBase forall T
  adapters = test_adapters(only)
  handles = [] of Handle
  pinned = [] of Base
  failure = nil.as(ErrorBase?)
  adapters.each do |adapter|
    connection = adapter.checkout
    if connection.is_a?(Cancelled)
      failure = ErrorBase.new("Test transaction checkout was cancelled")
      break
    elsif connection.is_a?(ErrorBase)
      failure = connection
      break
    end
    was_pinned = !adapter.pinned_connection?.nil?
    handle = begin_manual(connection, Options.new(joinable: false))
    if handle.is_a?(ErrorBase)
      failure = handle
      break
    end
    unless was_pinned
      adapter.database.or_panic.pool.reserve(connection)
      adapter.pin_connection(connection)
      pinned << adapter
    end
    handles << handle
  end
  unless failure.nil?
    rollback_test_transactions(handles)
    release_test_connections(pinned)
    return failure
  end
  result = yield
  cleanup = rollback_test_transactions(handles)
  release_test_connections(pinned)
  return cleanup unless cleanup.nil?
  result
end

private def rollback_test_transactions(handles : Array(Handle)) : Nil | ErrorBase
  failure = nil.as(ErrorBase?)
  handles.reverse_each do |handle|
    next unless handle.open?
    result = handle.rollback
    failure ||= result if result.is_a?(ErrorBase)
  end
  failure
end

private def release_test_connections(adapters : Array(Base)) : Nil
  adapters.reverse_each do |adapter|
    connection = adapter.pinned_connection?
    adapter.unpin_connection
    adapter.database.or_panic.pool.release(connection) unless connection.nil?
  end
  nil
end

private def test_adapters(only : Array(String)?) : Array(Base)
  adapters = [] of Base
  Connections.registered_connections.each do |pair|
    writer = pair[:writer]
    next if !only.nil? && !only.includes?(writer.name)
    adapters << writer unless adapters.any? { |adapter| adapter.object_id == writer.object_id }
  end
  adapters
end
