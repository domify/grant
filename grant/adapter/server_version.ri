module grant/adapter/server_version

import std/traits
import std/text
import grant/error::{ArgumentError}

pub struct ServerVersion
  getter major : Int32
  getter minor : Int32
  getter patch : Int32

  def initialize(@major : Int32, @minor : Int32 = 0, @patch : Int32 = 0)
  end

  def self.parse(text : String) : ServerVersion | ArgumentError
    parts = [] of Int32
    text.split('.').each do |part|
      break if parts.size == 3
      digits = ""
      part.each_char do |char|
        break unless char >= '0' && char <= '9'
        digits += char.to_s
      end
      break if digits.empty?
      parts << digits.to_i
      break if digits.bytesize != part.bytesize
    end
    return ArgumentError.new("Unrecognized server version: #{text.inspect}") if parts.empty?
    new(parts[0], parts[1]? || 0, parts[2]? || 0)
  end

  def <=>(other : ServerVersion) : Int32
    result = major <=> other.major
    result = minor <=> other.minor if result == 0
    result = patch <=> other.patch if result == 0
    result
  end

  def at_least?(major : Int32, minor : Int32 = 0, patch : Int32 = 0) : Bool
    (self <=> ServerVersion.new(major, minor, patch)) >= 0
  end

  def ==(other : ServerVersion) : Bool
    (self <=> other) == 0
  end

  def to_s : String
    "#{major}.#{minor}.#{patch}"
  end
end
