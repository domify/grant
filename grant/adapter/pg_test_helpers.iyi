module grant/adapter/pg_test_helpers

import grant/adapter/driver::{Connection, Value}
import grant/errors::{DatabaseError}

# Grant::Adapter::Pg's test helper reopening, as a trait on the driver connection.
pub trait PgTestHelpers
  abstract def pg_truncate_statement(names : Array(String)) : String
  abstract def pg_reset_pk_sequence_strict(table_name : String, primary_key : String = "id") : Nil | ::Grant::Errors::DatabaseError
  abstract def pg_referential_integrity_off_sql : String
  abstract def pg_referential_integrity_on_sql : String?
end

impl PgTestHelpers for Connection
  def pg_truncate_statement(names : Array(String)) : String
    "TRUNCATE TABLE #{names.map { |name| "\"#{name.gsub("\"", "\"\"")}\"" }.join(", ")} RESTART IDENTITY CASCADE"
  end

  def pg_reset_pk_sequence_strict(table_name : String, primary_key : String = "id") : Nil | ::Grant::Errors::DatabaseError
    quoted_table = "\"#{table_name.gsub("\"", "\"\"")}\""
    sequence = scalar("SELECT pg_get_serial_sequence(?, ?)", [quoted_table, primary_key] of Value)!
    return nil unless sequence.is_a?(String)
    statement = "SELECT setval(?::regclass, COALESCE(MAX(\"#{primary_key.gsub("\"", "\"\"")}\"), 0) + 1, false) FROM #{quoted_table}"
    scalar(statement, [sequence] of Value)!
    nil
  end

  # `SET LOCAL` ends with the transaction that `disable_referential_integrity`
  # opened, so only a joined outer transaction needs the explicit restore.
  def pg_referential_integrity_off_sql : String
    "SET LOCAL session_replication_role = replica"
  end

  def pg_referential_integrity_on_sql : String?
    "SET LOCAL session_replication_role = origin"
  end
end
