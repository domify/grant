module grant/adapter/error_translator

import std/text
import grant/error::{ErrorBase}
import grant/error_taxonomy::{StatementInvalid, RecordNotUnique, InvalidForeignKey, NotNullViolation, ValueTooLong, Deadlocked, SerializationFailure, LockWaitTimeout, StatementTimeout, QueryCanceled, NoDatabaseError, ReadOnlyError}

# Shared vocabulary from Grant::Adapter::ErrorTranslator. Adapter-specific
# classifiers return nil for failures outside the translated taxonomy.
pub enum Kind
  Unique
  ForeignKey
  NotNull
  ValueTooLong
  Deadlock
  SerializationFailure
  LockWaitTimeout
  StatementTimeout
  QueryCanceled
  ReadOnly
  NoDatabase
end

# Classifies a PostgreSQL SQLSTATE, or returns nil for codes Grant does not
# translate. See https://www.postgresql.org/docs/current/errcodes-appendix.html
pub def kind_for_sqlstate(state : String) : Kind?
  case state
  when "23505" then Kind::Unique
  when "23503" then Kind::ForeignKey
  when "23502" then Kind::NotNull
  when "22001" then Kind::ValueTooLong
  when "40P01" then Kind::Deadlock
  when "40001" then Kind::SerializationFailure
  when "55P03" then Kind::LockWaitTimeout
  when "57014" then Kind::QueryCanceled
  when "25006" then Kind::ReadOnly
  when "3D000" then Kind::NoDatabase
  end
end

# Upstream Grant::Adapter::Pg.error_kind. `57014` covers both a user cancel and
# `statement_timeout`; the server's message is the only thing that tells them
# apart, so it is consulted for that one code. It lives here so the libpq
# driver can classify without importing the adapter.
pub def pg_error_kind(sqlstate : String?, message : String? = nil) : Kind?
  return nil if sqlstate.nil?
  kind = kind_for_sqlstate(sqlstate)
  if kind == Kind::QueryCanceled && !message.nil? && message.includes?("statement timeout")
    return Kind::StatementTimeout
  end
  kind
end

# Upstream Grant::Adapter::Sqlite.error_kind, here so the native driver can
# classify its own failures.
pub def sqlite_error_kind(code : Int32?, message : String? = nil) : Kind?
  return nil unless code

  case code
  when 2067, 1555 then return Kind::Unique
  when 787        then return Kind::ForeignKey
  when 1299       then return Kind::NotNull
  end

  case code & 0xFF
  when 5, 6 then Kind::LockWaitTimeout
  when 8    then Kind::ReadOnly
  when 9    then Kind::QueryCanceled
  when 14   then Kind::NoDatabase
  when 18   then Kind::ValueTooLong
  when 19
    if message.nil?
      nil
    elsif message.starts_with?("UNIQUE constraint failed") || message.starts_with?("PRIMARY KEY must be unique")
      Kind::Unique
    elsif message.starts_with?("FOREIGN KEY constraint failed")
      Kind::ForeignKey
    elsif message.starts_with?("NOT NULL constraint failed")
      Kind::NotNull
    end
  end
end

# Builds the taxonomy error for *kind*. The driver error stays reachable as
# `#cause`; *code* and *operation* are the native driver's extra fields.
pub def build(kind : Kind, message : String, sql : String?, binds : Array(String), cause : ErrorBase?, code : Int32 = 0, operation : String = "execute") : ErrorBase
  error = case kind
          when Kind::Unique               then RecordNotUnique.new(code, operation, message, sql, cause)
          when Kind::ForeignKey           then InvalidForeignKey.new(code, operation, message, sql, cause)
          when Kind::NotNull              then NotNullViolation.new(code, operation, message, sql, cause)
          when Kind::ValueTooLong         then ValueTooLong.new(code, operation, message, sql, cause)
          when Kind::Deadlock             then Deadlocked.new(code, operation, message, sql, cause)
          when Kind::SerializationFailure then SerializationFailure.new(code, operation, message, sql, cause)
          when Kind::LockWaitTimeout      then LockWaitTimeout.new(code, operation, message, sql, cause)
          when Kind::StatementTimeout     then StatementTimeout.new(code, operation, message, sql, cause)
          when Kind::QueryCanceled        then QueryCanceled.new(code, operation, message, sql, cause)
          when Kind::NoDatabase           then NoDatabaseError.new(code, operation, message, sql, cause)
          else                                 nil
          end
  return ReadOnlyError.new(message, cause) if error.nil?
  error.binds = binds
  error
end
