module grant/adapter/sqlite_test_helpers

import grant/adapter/driver::{Connection, Value}
import grant/errors::{DatabaseError}

# Native traits preserve the adapter helper API without reopening an imported class.
pub trait SqliteTestHelpers
  abstract def truncate_statements(names : Array(String)) : Array(String) | ::Grant::Errors::DatabaseError
  abstract def reset_pk_sequence_strict(table_name : String, primary_key : String = "id") : Nil | ::Grant::Errors::DatabaseError
end

impl SqliteTestHelpers for Connection
  def truncate_statements(names : Array(String)) : Array(String) | ::Grant::Errors::DatabaseError
    statements = names.map { |name| "DELETE FROM \"#{name.gsub("\"", "\"\"")}\"" }
    if autoincrement_counters?()!
      names.each { |name| statements << "DELETE FROM sqlite_sequence WHERE name = '#{name.gsub("'", "''")}'" }
    end
    statements
  end

  def reset_pk_sequence_strict(table_name : String, primary_key : String = "id") : Nil | ::Grant::Errors::DatabaseError
    return nil unless autoincrement_counters?()!
    highest_query = "SELECT COALESCE(MAX(\"#{primary_key.gsub("\"", "\"\"")}\"), 0) AS highest FROM \"#{table_name.gsub("\"", "\"\"")}\""
    highest = query(highest_query)![0]["highest"].as(Int64)
    execute("UPDATE sqlite_sequence SET seq = ? WHERE name = ?", [highest, table_name] of Value)!
    nil
  end

  private def autoincrement_counters? : Bool | ::Grant::Errors::DatabaseError
    !query("SELECT 1 FROM sqlite_master WHERE name = 'sqlite_sequence'")!.empty?
  end
end
