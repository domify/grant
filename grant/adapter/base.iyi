module grant/adapter/base

import grant/adapter/placeholder_scanner

import std/time::{Span}
import grant/locking::{LockMode}
import grant/database::{Database, PoolResourceRefused, ConnectionRefused, ConnectionLost, PoolTimeout}
import grant/pool_stat::{PoolStat}
import grant/adapter/pool_support::{backoff, idempotent_read?, ticks}
import grant/adapter/driver::{Connection, Value, Mutation}
import grant/errors::{DatabaseError, ErrorBase}
import grant/error_taxonomy::{ConnectionFailed, NoDatabaseError, ConnectionTimeoutError, StatementInvalid, ReadOnlyError}

pub abstract class Base
  abstract def insert(table_name : String, fields : Array(String), params : Array(Value), lastval : String?) : Int64 | ErrorBase | Cancelled
  abstract def delete(table_name : String, primary_name : String, value : Value) : Mutation | ErrorBase | Cancelled

  abstract def lock_clause(mode : LockMode) : String
  abstract def supports_lock_mode?(mode : LockMode) : Bool
  abstract def quote(name : String) : String

  def quote_boolean(value : Bool) : String
    value ? "1" : "0"
  end

  def sqlite? : Bool
    false
  end

  def postgres? : Bool
    false
  end

  def mysql? : Bool
    false
  end

  def ensure_clause_template(clause : String) : String
    ::Grant::Adapter::PlaceholderScanner::PlaceholderScanner.rewrite(clause, numbered: false)
  end

  getter name : String
  getter url : String
  @_database : Database? = nil
  property retry_attempts : Int32 = 1
  property retry_delay : Span = Span.milliseconds(200_i64)
  property verify_idle_after : Span? = Span.seconds(30_i64)
  property pool_size : Int32 = 25
  property busy_timeout_ms : Int32 = 5000
  property checkout_timeout : Span = Span.seconds(5_i64)
  @waiting_checkouts : Int32 = 0

  def self.single_connection_url?(url : String) : Bool
    false
  end

  def initialize(@name : String, @url : String)
  end

  def database : Database | DatabaseError | ConnectionRefused
    opened = @_database
    return opened unless opened.nil?
    opened = Database.open(database_path, @pool_size, @busy_timeout_ms)!
    @_database = opened
    opened
  end

  protected def database_path : String
    @url
  end

  def connected? : Bool
    !@_database.nil?
  end

  def close : Nil | DatabaseError
    disconnect_strict
  end

  def disconnect_strict : Nil | DatabaseError
    closing = @_database
    @_database = nil
    closing.nil? ? nil : closing.close
  end

  def reconnect_strict : Nil | DatabaseError | ConnectionFailed
    disconnect_strict!
    verify_strict
  end

  def ping : Nil | ErrorBase
    opened = database!
    stats = opened.pool.stats
    return nil if stats.max_connections > 0 && stats.idle_connections == 0 && stats.open_connections >= stats.max_connections
    opened.checkout!.scalar("SELECT 1")!
    nil
  end

  # Maps a driver failure to the matching taxonomy error and returns it. An
  # error Grant does not recognize is returned unchanged; adapters override
  # this to classify their driver's errors and call `super` for the rest.
  def translate_exception(error : E, sql : String? = nil, binds : Array(Value)? = nil) : E | ErrorBase forall E
    if error.is_a?(ConnectionRefused)
      ConnectionFailed.new("Could not connect to #{name}: #{error.message}", error)
    elsif error.is_a?(PoolTimeout)
      ConnectionTimeoutError.new(error.message, error)
    elsif error.is_a?(PoolResourceRefused)
      ConnectionFailed.new("Could not connect to #{name}: #{error.message}", error)
    elsif error.is_a?(StatementInvalid) && error.read_only
      ReadOnlyError.new(error.message, error)
    else
      error
    end
  end

  def verify_strict : Nil | ErrorBase
    result = ping
    if result.is_a?(ConnectionRefused)
      ConnectionFailed.new("Could not reach #{name}: #{result.message}", result)
    elsif result.is_a?(DatabaseError)
      translated = translate_exception(result.as(DatabaseError))
      return translated if translated.is_a?(NoDatabaseError)
      ConnectionFailed.new("Could not reach #{name}: #{result.message}", result)
    elsif result.is_a?(ErrorBase)
      result
    else
      nil
    end
  end

  def active? : Bool
    !verify_strict.is_a?(::Error)
  end

  def pool_stat : PoolStat
    opened = @_database
    if opened.nil?
      PoolStat.new(0, 0, 0, 0, @waiting_checkouts, 0)
    else
      stats = opened.pool.stats
      PoolStat.new(stats.max_connections, stats.open_connections, stats.open_connections - stats.idle_connections, stats.idle_connections, @waiting_checkouts, 0)
    end
  end

  protected def verify_idle_connection(connection : Connection) : Nil | ErrorBase
    connection.scalar("SELECT 1")!
    nil
  end

  private def usable_after_idle?(connection : Connection) : Bool | ErrorBase
    threshold = @verify_idle_after
    return true if threshold.nil? || connection.in_transaction? || @in_use > 0
    now = ticks
    return true if now - connection.grant_last_used_ticks < threshold.total_milliseconds
    result = verify_idle_connection(connection)
    if result.is_a?(::Error)
      database!.pool.discard(connection, database_path)!
      false
    else
      connection.grant_last_used_ticks = now
      true
    end
  end

  @in_use : Int32 = 0
  # Fiber-owned pins, as in upstream grant_pinned_connections. Keeping the
  # map on the adapter avoids adding fields to the native scheduler's fibers.
  @pinned_connections = {} of UInt64 => Connection

  def pinned_connection? : Connection?
    @pinned_connections[IyiScheduler.current.object_id]?
  end

  def pin_connection(connection : Connection) : Nil
    @pinned_connections[IyiScheduler.current.object_id] = connection
    nil
  end

  def unpin_connection : Nil
    @pinned_connections.delete(IyiScheduler.current.object_id)
    nil
  end

  def with_connection(&block : Connection -> T) : T | ErrorBase | Cancelled forall T
    owned = pinned_connection?
    return yield owned unless owned.nil?
    open do |connection|
      fiber_id = IyiScheduler.current.object_id
      pool = database!.pool
      pool.reserve(connection)
      @pinned_connections[fiber_id] = connection
      result = yield connection
      # Native errors are values: clean up before returning either outcome.
      @pinned_connections.delete(fiber_id)
      pool.release(connection)
      result
    end
  end

  def checkout : Connection | ErrorBase | Cancelled
    pinned = pinned_connection?
    return pinned unless pinned.nil?
    checkout_connection
  end

  private def checkout_connection : Connection | ErrorBase | Cancelled
    attempt = 0
    started = ticks
    @waiting_checkouts += 1
    loop do
      opened = database
      if opened.is_a?(PoolResourceRefused)
        if attempt >= @retry_attempts
          @waiting_checkouts -= 1
          return ConnectionFailed.new("Could not reach #{name}: #{opened.message}", opened)
        end
        paused = sleep(backoff(@retry_delay, attempt).total_milliseconds.to_i32)
        if paused.is_a?(Cancelled)
          @waiting_checkouts -= 1
          return paused
        end
        attempt += 1
      elsif opened.is_a?(DatabaseError)
        @waiting_checkouts -= 1
        return translate_exception(opened)
      else
        connection = opened!.checkout
        if connection.is_a?(ConnectionTimeoutError)
          if ticks - started >= @checkout_timeout.total_milliseconds
            @waiting_checkouts -= 1
            return connection
          end
          paused = sleep(1)
          if paused.is_a?(Cancelled)
            @waiting_checkouts -= 1
            return paused
          end
          next
        elsif connection.is_a?(ErrorBase)
          @waiting_checkouts -= 1
          return connection
        end
        usable = usable_after_idle?(connection)
        if usable.is_a?(ErrorBase)
          @waiting_checkouts -= 1
          return usable
        end
        if usable
          connection.name = name
          @waiting_checkouts -= 1
          return connection
        end
      end
    end
  end

  def open(sql : String? = nil, binds : Array(Value)? = nil, &block : Connection -> T) : T | ErrorBase | Cancelled forall T
    open_connection(sql, binds, false) { |connection| yield connection }
  end

  private def open_connection(sql : String?, binds : Array(Value)?, pool_only : Bool, &block : Connection -> T) : T | ErrorBase | Cancelled forall T
    lost_retries = idempotent_read?(sql) && @retry_attempts > 0 ? 1 : 0
    attempt = 0
    loop do
      connection = (pool_only ? checkout_connection : checkout)!
      pinned = pinned_connection?
      # The upstream transaction route never enters its replaying pool route.
      lost_retries = 0 if connection.in_transaction? || !pinned.nil?
      # A pooled checkout is exclusive while the block runs, as crystal-db's
      # pool hands a connection to one fiber at a time.
      owned = pinned.nil? || pinned.object_id != connection.object_id
      pool = owned ? @_database : nil
      pool.pool.reserve(connection) unless pool.nil?
      @in_use += 1
      result = yield connection
      @in_use -= 1
      pool.pool.release(connection) unless pool.nil?
      connection.grant_last_used_ticks = ticks
      # A driver that found its server gone reports the statement error with
      # `connection_lost`; the pool drops that connection as crystal-db does.
      if result.is_a?(DatabaseError) && result.connection_lost
        @_database.as(Database).pool.discard(connection, database_path)!
        result = ConnectionLost.new(connection)
      end
      if result.is_a?(ConnectionLost)
        if lost_retries == 0
          return ConnectionFailed.new("Connection to #{name} was lost: #{result.message}", result)
        end
        lost_retries -= 1
        sleep(backoff(@retry_delay, attempt).total_milliseconds.to_i32)!
        attempt += 1
      elsif result.is_a?(DatabaseError)
        # An explicit caller statement wins over driver-recorded SQL. Helpers
        # without one retain the last statement executed on this connection.
        result.sql = sql || result.sql || connection.last_statement
        result.binds = DatabaseError.describe_binds(binds) unless binds.nil?
        return translate_exception(result)
      else
        return result
      end
    end
  end

  def open_pool_connection(sql : String? = nil, binds : Array(Value)? = nil, &block : Connection -> T) : T | ErrorBase | Cancelled forall T
    open_connection(sql, binds, true) { |connection| yield connection }
  end
end
