module grant/adapter/registry
import std/text
import std/regex
import grant/adapter/base::{Base}
import grant/error::{ErrorBase}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}

pub class UnknownAdapterError < ErrorBase
end
impl ::Error for UnknownAdapterError
  def message : String
    @message
  end
end

pub class Registry
  pub alias AdapterClass = Base.class
  @@adapters = {"sqlite" => Sqlite, "sqlite3" => Sqlite,
    "postgres" => Pg, "postgresql" => Pg, "pg" => Pg} of String => AdapterClass

  def self.register(adapter : AdapterClass, *names : String) : Nil
    names.each { |name| @@adapters[name.downcase] = adapter }
    nil
  end

  def self.for_scheme?(name : String) : AdapterClass?
    @@adapters[name.downcase]?
  end

  def self.for_scheme(name : String) : AdapterClass | UnknownAdapterError
    for_scheme?(name) || UnknownAdapterError.new(
      "No adapter is registered for #{name.inspect} (registered: #{names.join(", ")}). " +
      "Require the adapter, e.g. require \"grant/adapter/pg\".")
  end

  def self.scheme_of(url : String) : String?
    colon = url.index(':')
    return nil if colon.nil? || colon == 0
    scheme = url[0, colon]
    return nil unless scheme.matches?(/^[A-Za-z][A-Za-z0-9+.\-]*$/)
    scheme.downcase
  end

  def self.for_url(url : String) : AdapterClass | UnknownAdapterError
    scheme = scheme_of(url)
    return UnknownAdapterError.new("Cannot infer an adapter: #{redact(url).inspect} has no URL scheme") if scheme.nil?
    for_scheme(scheme)
  end

  def self.names : Array(String)
    @@adapters.keys.sorted
  end

  def self.redact(url : String) : String
    start = url.index("://")
    return url if start.nil?
    credentials_start = start + 3
    finish = url.bytesize
    ['?', '#'].each do |separator|
      index = url.index(separator, credentials_start)
      finish = index if !index.nil? && index < finish
    end
    at = url[0, finish].rindex('@')
    return url if at.nil? || at < credentials_start
    "#{url[0, credentials_start]}***#{url[at, url.bytesize - at]}"
  end
end
