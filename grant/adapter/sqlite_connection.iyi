module grant/adapter/sqlite_connection

import sqlite/sqlite/core::{SQLite3Connection}
import sqlite/sqlite/errors::{SQLite3Error}
import db/db/core::{TransactionState}
import db/db/errors::{DBError}
import grant/adapter/driver::{NativeConnection}

import grant/locking::{LockMode}
import grant/adapter/pool_support::{ticks}
import grant/errors::{DatabaseError}
import grant/adapter/error_translator
import grant/error::{ErrorBase}
pub import grant/adapter/driver

# Retain Grant's public error type while the SQLite library owns the native
# connection, statements, bindings, decoding and actual transaction state.
pub class SQLiteError < ErrorBase
  getter code : Int32

  def initialize(@code : Int32, detail : String)
    super(detail)
  end
end

impl ::Error for SQLiteError
  def message : String
    @message
  end
end

pub alias Value = ::Grant::Adapter::Driver::Value
pub alias Row = ::Grant::Adapter::Driver::Row
pub alias Mutation = ::Grant::Adapter::Driver::Mutation

pub class Connection < ::Grant::Adapter::Driver::LibraryConnection
  getter native_connection : SQLite3Connection
  getter path : String

  def initialize(@native_connection : SQLite3Connection, @path : String = ":memory:")
  end

  def sqlite? : Bool
    true
  end

  def statement_sql(sql : String) : String
    sql
  end

  def insert(sql : String, parameters : Array(Value), primary_name : String?) : Mutation | DatabaseError
    execute(sql, parameters)
  end

  def supports_lock_mode?(mode : LockMode) : Bool
    false
  end

  def lock_clause(mode : LockMode) : String
    ""
  end

  # Native alias for the upstream SQLite bulk insert API.
  def import_records(table_name : String, primary_name : String, fields : Array(String), rows : Array(Array(Value)), update_on_duplicate : Bool = false, columns : Array(String) = [] of String, ignore_on_duplicate : Bool = false) : Nil | DatabaseError
    return nil if rows.empty?
    quoted_fields = fields.map { |field| "\"#{field}\"" }.join(", ")
    placeholders = "(" + fields.map { "?" }.join(",") + ")"
    statement = "INSERT #{ignore_on_duplicate && !update_on_duplicate ? "OR IGNORE " : ""}INTO \"#{table_name}\" (#{quoted_fields}) VALUES "
    statement += rows.map { placeholders }.join(",")
    params = [] of Value
    rows.each { |row| row.each { |value| params << value } }
    if update_on_duplicate && !columns.empty?
      statement += " ON CONFLICT (\"#{primary_name}\") DO UPDATE SET "
      statement += columns.map { |key| "\"#{key}\" = excluded.\"#{key}\"" }.join(", ")
    end
    execute(statement, params)!
    nil
  end

  def self.open(path : String, busy_timeout_ms : Int32 = 5000) : Connection | DatabaseError
    return DatabaseError.new(21, "open", "NUL byte in database path") if path.includes?("\0")
    parts = path.split('?')
    options = {} of String => String
    query = parts[1]?
    unless query.nil?
      query.split('&').each do |part|
        pair = part.split('=')
        options[pair.first] = pair[1]? || ""
      end
    end
    native = SQLite3Connection.open(::Db::Core::Connection::Options.new,
      SQLite3Connection::Options.new(filename: parts.first,
        busy_timeout: options["busy_timeout"]? || busy_timeout_ms.to_s,
        foreign_keys: options["foreign_keys"]? || "ON",
        journal_mode: options["journal_mode"]?, synchronous: options["synchronous"]?,
        cache_size: options["cache_size"]?))
    if native.is_a?(DBError)
      cause = native.cause
      code = cause.is_a?(SQLite3Error) ? cause.code : 14
      return DatabaseError.new(code, "open", native.message, nil,
        SQLiteError.new(code, native.message))
    end
    new(native, path)
  end

  def open_independent : ::Grant::Adapter::Driver::Connection | DatabaseError
    Connection.open(@path)
  end

  def translate(error : DBError, operation : String, sql : String? = nil) : DatabaseError
    code = error.is_a?(SQLite3Error) ? error.code : 21
    detail = error.message
    cause = SQLiteError.new(code, detail)
    kind = ::Grant::Adapter::ErrorTranslator.sqlite_error_kind(code, detail)
    unless kind.nil? || kind == ::Grant::Adapter::ErrorTranslator::Kind::NoDatabase
      translated = ::Grant::Adapter::ErrorTranslator.build(kind, detail, sql, [] of String,
        cause, code, operation)
      return translated if translated.is_a?(DatabaseError)
      result = DatabaseError.new(code, operation, detail, sql, cause)
      result.read_only = true
      return result
    end
    DatabaseError.new(code, operation, detail, sql, cause)
  end
end
