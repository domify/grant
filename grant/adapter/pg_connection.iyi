module grant/adapter/pg_connection

import std/text
import std/time::{Time}

import pg/pg/core::{PGConnection}
import pg/pg/numeric::{Numeric}
import pg/pg/decoder::{UUIDValue}
import pg/pg/pq/errors
import pg/pg/pq/conninfo::{ConnInfo}
import db/db/errors::{DBError}
import db/db/core::{ConnectionLost}
import db/db/value::{DBValue}

import grant/locking::{LockMode}
import grant/adapter/pool_support::{ticks}
import grant/adapter/placeholder_scanner::{PlaceholderScanner}
import grant/errors::{DatabaseError}
import grant/error_taxonomy::{StatementInvalid, NoDatabaseError}
import grant/adapter/error_translator
import grant/error::{ErrorBase}
pub import grant/adapter/driver

# Retain Grant's public driver error and SQLSTATE while iyilang/pg owns the
# protocol, connection, statements, decoding and ReadyForQuery state.
pub class PQError < ErrorBase
  getter sqlstate : String?

  def initialize(@sqlstate : String?, detail : String)
    super(detail)
  end

  def field_message(field : Symbol) : String?
    field == :code ? @sqlstate : nil
  end
end

impl ::Error for PQError
  def message : String
    @message
  end
end

alias Value = ::Grant::Adapter::Driver::Value
alias Row = ::Grant::Adapter::Driver::Row
alias Mutation = ::Grant::Adapter::Driver::Mutation

pub class Connection < ::Grant::Adapter::Driver::LibraryConnection
  # Grant's pool options are not database connection parameters.
  GRANT_URL_OPTIONS = ["max_pool_size", "initial_pool_size", "max_idle_pool_size", "checkout_timeout", "retry_attempts", "retry_delay", "prepared_statements", "busy_timeout"]

  getter native_connection : PGConnection
  getter path : String

  def initialize(@native_connection : PGConnection, @path : String)
    @name = "pg"
  end

  def postgres? : Bool
    true
  end

  def supports_lock_mode?(mode : LockMode) : Bool
    true
  end

  def lock_clause(mode : LockMode) : String
    case mode
    when LockMode::Update           then "FOR UPDATE"
    when LockMode::Share            then "FOR SHARE"
    when LockMode::UpdateNoWait     then "FOR UPDATE NOWAIT"
    when LockMode::UpdateSkipLocked then "FOR UPDATE SKIP LOCKED"
    when LockMode::ShareNoWait      then "FOR SHARE NOWAIT"
    else                                 "FOR SHARE SKIP LOCKED"
    end
  end

  def self.conninfo(url : String) : String
    parts = url.split('?', 2)
    query = parts[1]?
    return url if query.nil?
    kept = query.split('&').reject { |pair| GRANT_URL_OPTIONS.includes?(pair.split('=').first) }
    kept.empty? ? parts[0] : "#{parts[0]}?#{kept.join("&")}"
  end

  def statement_sql(sql : String) : String
    PlaceholderScanner.numbered_parameters?(sql) ? sql : PlaceholderScanner.rewrite(sql, 0, true)
  end

  def self.open(url : String, busy_timeout_ms : Int32 = 5000) : Connection | DatabaseError
    return DatabaseError.new(0, "open", "NUL byte in database URL") if url.includes?("\0")
    info = ConnInfo.from_conninfo_string(conninfo(url))
    return DatabaseError.new(0, "open", info.message) if info.is_a?(DBError)
    native = PGConnection.open(::Db::Core::Connection::Options.new, info)
    if native.is_a?(DBError)
      detail = native.message
      state = detail.includes?("does not exist") && detail.includes?("database") ? "3D000" : "08001"
      cause = PQError.new(state, detail)
      return NoDatabaseError.new(0, "open", detail, nil, cause) if state == "3D000"
      return DatabaseError.new(0, "open", detail, nil, cause)
    end
    connection = new(native, url)
    configured = connection.execute("SET client_min_messages TO WARNING")
    if configured.is_a?(DatabaseError)
      connection.close
      return configured
    end
    connection
  end

  def open_independent : ::Grant::Adapter::Driver::Connection | DatabaseError
    Connection.open(@path)
  end

  def import_records(table_name : String, primary_name : String, fields : Array(String), rows : Array(Array(Value)), update_on_duplicate : Bool = false, columns : Array(String) = [] of String, ignore_on_duplicate : Bool = false) : Nil | DatabaseError
    return nil if rows.empty?
    quoted_fields = fields.map { |field| "\"#{field}\"" }.join(", ")
    placeholders = "(" + fields.map { "?" }.join(",") + ")"
    statement = "INSERT INTO \"#{table_name}\" (#{quoted_fields}) VALUES "
    statement += rows.map { placeholders }.join(",")
    params = [] of Value
    rows.each { |row| row.each { |value| params << value } }
    if update_on_duplicate && !columns.empty?
      updated = columns.dup
      updated << "updated_at" if fields.includes?("updated_at") && !updated.includes?("updated_at")
      statement += " ON CONFLICT (\"#{primary_name}\") DO UPDATE SET "
      statement += updated.map { |key| "\"#{key}\" = excluded.\"#{key}\"" }.join(", ")
    elsif ignore_on_duplicate
      statement += " ON CONFLICT DO NOTHING"
    end
    execute(statement, params)!
    nil
  end

  # PostgreSQL has no connection-level last inserted key; INSERT uses RETURNING.
  def execute(sql : String, parameters : Array(Value) = [] of Value) : Mutation | DatabaseError
    result = super(sql, parameters)
    return result if result.is_a?(DatabaseError)
    Mutation.new(result.changes, -1_i64)
  end

  def insert(sql : String, parameters : Array(Value), primary_name : String?) : Mutation | DatabaseError
    return execute(sql, parameters) if primary_name.nil?
    rows = query("#{sql} RETURNING \"#{primary_name.gsub("\"", "\"\"")}\"", parameters)!
    id = -1_i64
    unless rows.empty?
      value = rows.first.values.first
      id = value.is_a?(Int64) ? value : (value.to_s.to_i64? || -1_i64)
    end
    Mutation.new(rows.size.to_i64, id)
  end

  def normalize(value : DBValue) : Value | DatabaseError
    return value.uuid.to_s if value.is_a?(UUIDValue)
    if value.is_a?(Numeric)
      text = value.to_s
      return text.includes?(".") ? value.to_f : (text.to_i64? || value.to_f)
    end
    if value.is_a?(Time)
      return value.to_rfc3339 if value.nanosecond == 0
      text = value.to_rfc3339(6)
      return text[0, text.bytesize - 1].rstrip('0') + "Z"
    end
    super(value)
  end

  def translate(error : DBError, operation : String, sql : String? = nil) : DatabaseError
    state = error.is_a?(::Pg::Pq::Errors::PQError) ? error.field_message(:code) : nil
    detail = error.message
    cause = PQError.new(state, detail)
    gone = error.is_a?(ConnectionLost) || (!state.nil? && (state.starts_with?("57P") || state.starts_with?("08")))
    if gone
      @lost = true
      native_connection.close
      result = DatabaseError.new(0, operation, detail, sql, cause)
      result.connection_lost = true
      return result
    end
    kind = ::Grant::Adapter::ErrorTranslator.pg_error_kind(state, detail)
    return DatabaseError.new(0, operation, detail, sql, cause) if kind.nil?
    translated = ::Grant::Adapter::ErrorTranslator.build(kind, detail, sql, [] of String, cause, 0, operation)
    return translated if translated.is_a?(StatementInvalid)
    result = DatabaseError.new(0, operation, detail, sql, cause)
    result.read_only = true
    result
  end
end
