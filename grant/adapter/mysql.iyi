module grant/adapter/mysql
import grant/adapter/base::{Base}

# Configuration files can describe MySQL even in a SQLite/PostgreSQL build.
# The abstract adapter retains its identity without compiling a MySQL driver.
pub abstract class Mysql < Base
  QUOTING_CHAR = '`'

  def mysql? : Bool
    true
  end

  def self.supports_unprepared_statements? : Bool
    false
  end
end
