module grant/adapter/sqlite

pub import grant/adapter/sqlite_connection
pub alias Connection = ::Grant::Adapter::SqliteConnection::Connection
pub alias Value = ::Grant::Adapter::SqliteConnection::Value
pub alias Row = ::Grant::Adapter::SqliteConnection::Row
pub alias Mutation = ::Grant::Adapter::SqliteConnection::Mutation
import std/dir::{Dir}
import std/text
import std/file::{File}
import std/time::{Span}
import grant/adapter/base::{Base}
import grant/locking::{LockMode}
import grant/errors::{DatabaseError, ErrorBase}
import grant/error_taxonomy::{NoDatabaseError}
import grant/adapter/error_translator::{Kind}
import grant/adapter/error_translator

pub class Sqlite < Base
  DEFAULT_PRAGMAS = {
    "foreign_keys" => "1",
    "journal_mode" => "wal",
    "busy_timeout" => "5000",
    "synchronous" => "normal",
  }

  def self.url_with_pragmas(url : String, overrides : Hash(String, String) = {} of String => String) : String
    parts = url.split('?')
    base = parts.first
    query = parts[1]? || ""
    present = query.split('&').map { |pair| pair.split('=').first }
    memory = memory_url?(url)
    additions = [] of String
    DEFAULT_PRAGMAS.each do |key, default|
      next if present.includes?(key)
      value = overrides[key]? || ((memory && key != "foreign_keys") ? nil : default)
      additions << "#{key}=#{value}" if value
    end
    overrides.each do |key, value|
      next if present.includes?(key) || DEFAULT_PRAGMAS.has_key?(key)
      additions << "#{key}=#{value}"
    end
    return url if additions.empty?
    query.empty? ? "#{base}?#{additions.join('&')}" : "#{base}?#{query}&#{additions.join('&')}"
  end

  def initialize(name : String, url : String, *, pragmas : T) forall T
    overrides = {} of String => String
    pragmas.each { |key, value| overrides[key.to_s] = value.to_s }
    initialize(name, Sqlite.url_with_pragmas(url, overrides))
  end

  def current_database : String
    url.split('?').first.sub("sqlite3:", "").sub("sqlite:", "")
  end

  def self.memory_url?(url : String) : Bool
    url.includes?(":memory:") || url.includes?("mode=memory")
  end

  def self.single_connection_url?(url : String) : Bool
    memory_url?(url)
  end

  def self.error_kind(code : Int32?, message : String? = nil) : Kind?
    ::Grant::Adapter::ErrorTranslator.sqlite_error_kind(code, message)
  end

  def initialize(name : String, url : String)
    super(name, Sqlite.url_with_pragmas(url))
    query = url.split('?')[1]?
    unless query.nil?
      query.split('&').each do |part|
        pair = part.split('=')
        value = pair[1]?
        next if value.nil?
        case pair.first
        when "max_pool_size" then @pool_size = value.to_i
        when "checkout_timeout" then @checkout_timeout = Span.milliseconds((value.to_f * 1000).to_i64)
        when "busy_timeout" then @busy_timeout_ms = value.to_i
        end
      end
    end
  end

  def insert(table_name : String, fields : Array(String), params : Array(Value), lastval : String?) : Int64 | ErrorBase | Cancelled
    quoted_fields = fields.map { |name| quote(name) }.join(", ")
    placeholders = fields.map { "?" }.join(", ")
    statement = "INSERT INTO #{quote(table_name)} (#{quoted_fields}) VALUES (#{placeholders})"
    open(statement, params) do |db|
      result = db.exec(statement, params)!
      lastval.nil? ? -1_i64 : result.last_insert_id
    end
  end

  def delete(table_name : String, primary_name : String, value : Value) : Mutation | ErrorBase | Cancelled
    statement = "DELETE FROM #{quote(table_name)} WHERE #{quote(primary_name)}=?"
    open(statement) { |db| db.exec(statement, [value] of Value) }
  end

  def quote_boolean(value : Bool) : String
    value ? "TRUE" : "FALSE"
  end

  def quote(name : String) : String
    "\"#{name.gsub("\"", "\"\"")}\""
  end

  protected def database_path : String
    path = url
    if path.starts_with?("sqlite3:")
      path = path[8, path.bytesize - 8]
    elsif path.starts_with?("sqlite:")
      path = path[7, path.bytesize - 7]
    end
    path = path[2, path.bytesize - 2] if path.starts_with?("//")
    path
  end

  def translate_exception(error : E, sql : String? = nil, binds : Array(Value)? = nil) : E | ErrorBase forall E
    # SQLITE_CANTOPEN: SQLite creates files, so an inaccessible database path
    # is its native equivalent of the upstream missing-directory translation.
    if error.is_a?(DatabaseError) && error.code == 14 && !Dir.exists?(File.dirname(database_path))
      NoDatabaseError.new(error.code, error.operation, "Could not connect to #{name}: #{error.detail}", error.sql, error.cause || error)
    else
      super(error, sql, binds)
    end
  end

  def supports_lock_mode?(mode : LockMode) : Bool
    false
  end

  def lock_clause(mode : LockMode) : String
    ""
  end

  def sqlite? : Bool
    true
  end

  def adapter_name : String
    "SQLite"
  end
end
