module grant/adapter/schema
import std/text
import grant/errors::{ErrorBase}
import grant/adapter/base::{Base}
pub class UnsupportedOperation < ErrorBase
end
impl ::Error for UnsupportedOperation
  def message : String
    @message
  end
end
pub class InvalidDefinition < ErrorBase
end
impl ::Error for InvalidDefinition
  def message : String
    @message
  end
end
pub enum Dialect
  Sqlite
  Pg
  Mysql
  def self.for(adapter : Base) : Dialect
    adapter.postgres? ? Pg : (adapter.mysql? ? Mysql : Sqlite)
  end
  def quote(name : String | Symbol) : String
    char = self == Mysql ? "`" : "\""
    name.to_s.split('.').map { |part| "#{char}#{part.gsub(char, char + char)}#{char}" }.join(".")
  end
  def default_expression(expression : String) : String
    return expression if self == Pg || expression.starts_with?("(") || expression.upcase.starts_with?("CURRENT_TIMESTAMP")
    "(#{expression})"
  end
  def quote_literal(value : T) : String forall T
    case value
    when Nil then "NULL"
    when Bool then value ? "TRUE" : "FALSE"
    when String then "'#{value.gsub("'", "''")}'"
    else value.to_s
    end
  end
end

pub class TypeCatalog
    PG = {
      "Int8"       => "SMALLINT",
      "Int16"      => "SMALLINT",
      "Bytes"      => "BYTEA",
      "Date"       => "DATE",
      "JSON::Any"  => "JSONB",
      "BigDecimal" => "NUMERIC",
    }

    SQLITE = {
      "Int8"       => "INTEGER",
      "Int16"      => "INTEGER",
      "Bytes"      => "BLOB",
      "Date"       => "DATE",
      "JSON::Any"  => "TEXT",
      "BigDecimal" => "NUMERIC",
    }

    MYSQL = {
      "Int8"       => "TINYINT",
      "Int16"      => "SMALLINT",
      "Bytes"      => "BLOB",
      "Date"       => "DATE",
      "JSON::Any"  => "JSON",
      "BigDecimal" => "DECIMAL",
    }

    def self.refine(dialect : Dialect, key : String, base : String, limit : Int32? = nil, precision : Int32? = nil, scale : Int32? = nil) : String | ErrorBase
      case key
      when "String"
        limit ? "VARCHAR(#{limit})" : base
      when "BigDecimal"
        if precision
          "#{dialect == Dialect::Mysql ? "DECIMAL" : "NUMERIC"}(#{precision}, #{scale || 0})"
        elsif scale
          return InvalidDefinition.new("scale: #{scale} needs a precision:")
        else
          base
        end
      when "Time"
        precision && dialect != Dialect::Sqlite ? "#{base.split('(').first}(#{precision})" : base
      when "Int8", "Int16", "Int32", "Int64"
        limit ? integer_type(dialect, limit)! : base
      when "Bytes"
        dialect == Dialect::Mysql ? sized(base, {255 => "TINYBLOB", 65_535 => "BLOB", 16_777_215 => "MEDIUMBLOB"}, "LONGBLOB", limit) : base
      else
        base
      end
    end

    def self.integer_type(dialect : Dialect, limit : Int32) : String | ErrorBase
      case dialect
      when Dialect::Pg
        return InvalidDefinition.new("No integer type has limit: #{limit}") unless limit >= 1 && limit <= 8
        limit <= 2 ? "SMALLINT" : (limit <= 4 ? "INTEGER" : "BIGINT")
      when Dialect::Mysql
        case limit
        when 1    then "TINYINT"
        when 2    then "SMALLINT"
        when 3    then "MEDIUMINT"
        when 4    then "INT"
        when 5..8 then "BIGINT"
        else           return InvalidDefinition.new("No integer type has limit: #{limit}")
        end
      when Dialect::Sqlite
        case limit
        when 1    then "TINYINT"
        when 2    then "SMALLINT"
        when 3, 4 then "INTEGER"
        when 5..8 then "BIGINT"
        else           return InvalidDefinition.new("No integer type has limit: #{limit}")
        end
      else
        InvalidDefinition.new("Unknown schema dialect")
      end
    end

    # The first of MySQL's size *steps* that holds *limit*, else *largest*;
    # *default* without a limit.
    def self.sized(default : String, steps : Hash(Int32, String), largest : String, limit : Int32?) : String
      return default unless limit
      steps.each { |max, type| return type if limit <= max }
      largest
    end
end
