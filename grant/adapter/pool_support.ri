module grant/adapter/pool_support

import std/indexable
import std/time::{Span, Time}
import grant/cstring::{cstring}

# Grant::Adapter::PoolSupport: the upstream conservative replay policy.
pub MAX_BACKOFF = Span.seconds(5_i64)
START = Time.monotonic

pub def ticks : Int64
  (Time.monotonic - START).total_milliseconds.to_i64
end

pub def idempotent_read?(sql : String?) : Bool
  return false if sql.nil?
  start = 0
  while start < sql.bytesize
    byte = sql.to_unsafe[start]
    break unless byte == 32 || (byte >= 9 && byte <= 13)
    start += 1
  end
  return false if start >= sql.bytesize
  size = sql.bytesize - start
  head = cstring(sql.to_unsafe + start, size < 16 ? size : 16).downcase
  if head.starts_with?("select") || head.starts_with?("show") || head.starts_with?("values")
    true
  elsif head.starts_with?("explain")
    !cstring(sql.to_unsafe + start, size < 40 ? size : 40).downcase.includes?("analyze")
  else
    false
  end
end

pub def backoff(base : Span, attempt : Int32) : Span
  # Native Span has no multiplication operator; double with its exact,
  # normalized addition operation, retaining the upstream exponent bound.
  delay = base
  exponent = 0
  while exponent < (attempt < 16 ? attempt : 16)
    delay = delay + delay
    exponent += 1
  end
  delay > MAX_BACKOFF ? MAX_BACKOFF : delay
end

import db/db/core::{Statement}
import db/db/errors::{DBError}

# Native counterpart of the DB extensions in src/adapter/pool_support.cr.
pub class StringKeyCache(T) < ::Db::Core::StringKeyCache(T)
  property limit : Int32 = 0
  @recency = [] of String

  def size : Int32
    @cache.size
  end

  def clear : Nil
    super
    @recency.clear
    nil
  end

  def fetch(key : String, & : -> T | DBError) : T | DBError
    if value = @cache[key]?
      if @limit > 0
        @recency.delete(key)
        @recency << key
      end
      return value
    end
    value = yield
    return value if value.is_a?(DBError)
    if @limit > 0
      while @cache.size >= @limit
        oldest = @recency.shift
        evicted = @cache.delete(oldest)
        evicted.close if evicted.responds_to?(:close)
      end
    end
    @cache[key] = value
    @recency << key
    value
  end
end

pub trait CacheControl
  def configure_statement_cache(limit : Int32, prepared : Bool) : Nil
    @statements_cache.each_value { |statement| statement.close; nil }
    @options = ::Db::Core::Connection::Options.new(prepared_statements: prepared,
      prepared_statements_cache: limit != 0)
    cache = StringKeyCache(Statement).new
    cache.limit = limit
    @statements_cache = cache
    nil
  end

  def statement_cache_size : Int32
    count = 0
    @statements_cache.each_value { |_| count += 1; nil }
    count
  end
end
impl CacheControl for ::Db::Core::Connection
end
