module grant/schema

import std/text
import grant/database::{Database, Dialect, Mutation}
import grant/query::{Table, identifier}
import grant/value::{Value, Row, Binary}
import grant/scalars::{Decimal, Date, DateTime}
import grant/errors::{DatabaseError}
import grant/schema_constraints::{Constraint, constraint_sql, validate_columns, quoted_columns}

pub enum ColumnType
  Integer
  Float
  Text
  Boolean
  Decimal
  Date
  DateTime
  Binary
  Json
end

pub struct Unset
end

pub struct Column
  getter name : String
  getter type : ColumnType
  getter nullable : Bool
  getter primary_key : Bool
  getter auto : Bool
  getter default : Value | Unset

  def initialize(@name : String, @type : ColumnType, @nullable : Bool = true,
                 @primary_key : Bool = false, @auto : Bool = false, @default : Value | Unset = Unset.new)
  end
end

pub enum DeleteAction
  Restrict
  Cascade
  SetNull
  NoAction
end

pub struct ForeignKey
  getter column : String
  getter target_table : String
  getter target_column : String
  getter on_delete : DeleteAction

  def initialize(@column : String, @target_table : String, @target_column : String = "id", @on_delete : DeleteAction = DeleteAction::Restrict)
  end
end

pub struct Definition
  getter name : String
  @columns : Array(Column)
  @foreign_keys : Array(ForeignKey)
  @primary_key : Array(String)
  @constraints : Array(Constraint)
  getter without_rowid : Bool

  def initialize(@name : String, columns : Array(Column), foreign_keys : Array(ForeignKey) = [] of ForeignKey,
                 primary_key : Array(String) = [] of String, constraints : Array(Constraint) = [] of Constraint,
                 @without_rowid : Bool = false)
    @columns = columns.map { |column| column }
    @foreign_keys = foreign_keys.map { |key| key }
    @primary_key = primary_key.map { |column| column }
    @constraints = constraints.map { |constraint| constraint }
  end

  def columns : Array(Column)
    @columns.map { |column| column }
  end

  def foreign_keys : Array(ForeignKey)
    @foreign_keys.map { |key| key }
  end

  def primary_key : Array(String)
    @primary_key.map { |column| column }
  end

  def constraints : Array(Constraint)
    @constraints.map { |constraint| constraint }
  end
end

pub struct ColumnInfo
  getter name : String
  getter sql_type : String
  getter nullable : Bool
  getter default_sql : String?
  getter generated : Bool
  getter hidden : Bool
  getter primary_position : Int32

  def initialize(@name : String, @sql_type : String, @nullable : Bool, @default_sql : String?, @generated : Bool = false, @hidden : Bool = false, @primary_position : Int32 = 0)
  end
end

pub class Schema
  @database : Database

  def initialize(@database : Database)
  end

  def column_definition(column : Column) : String | DatabaseError
    return DatabaseError.new(21, "schema", "auto requires an integer primary key") if column.auto && (!column.primary_key || column.type != ColumnType::Integer)
    field = identifier(column.name)!
    sql_type = type_sql(column.type)
    if column.auto && @database.dialect == Dialect::PostgreSQL
      sql_type += " GENERATED BY DEFAULT AS IDENTITY"
    end
    part = "#{field} #{sql_type}"
    part += " PRIMARY KEY" if column.primary_key
    part += " AUTOINCREMENT" if column.auto && @database.dialect == Dialect::SQLite
    part += " NOT NULL" if !column.nullable || column.primary_key
    unless column.default.is_a?(Unset)
      value = column.default
      if value.is_a?(Binary) && @database.dialect != Dialect::SQLite
        return DatabaseError.new(21, "schema", "binary defaults are implemented only for SQLite")
      end
      if (value.is_a?(Decimal) || value.is_a?(Date) || value.is_a?(DateTime)) && @database.dialect != Dialect::SQLite
        return DatabaseError.new(21, "schema", "typed scalar defaults are implemented only for SQLite")
      end
      part += " DEFAULT #{literal(value)}" unless value.is_a?(Unset)
    end
    part
  end

  def create_table(definition : Definition, if_not_exists : Bool = false) : Mutation | DatabaseError
    name = identifier(definition.name)!
    return DatabaseError.new(21, "schema", "table needs at least one column") if definition.columns.empty?
    parts = [] of String
    names = [] of String
    flagged = definition.columns.select { |column| column.primary_key }.map { |column| column.name }
    explicit = definition.primary_key
    return DatabaseError.new(21, "schema", "use either explicit or flagged primary columns") if !explicit.empty? && !flagged.empty?
    keys = explicit.empty? ? flagged : explicit
    table_key = !explicit.empty? || keys.size > 1
    if table_key || definition.without_rowid || !definition.constraints.empty?
      return DatabaseError.new(21, "schema", "extended table definitions are implemented only for SQLite") unless @database.dialect == Dialect::SQLite
    end
    return DatabaseError.new(21, "schema", "WITHOUT ROWID needs a primary key") if definition.without_rowid && keys.empty?
    return DatabaseError.new(21, "schema", "AUTOINCREMENT is incompatible with composite keys or WITHOUT ROWID") if (table_key || definition.without_rowid) && definition.columns.any? { |column| column.auto }
    definition.columns.each do |column|
      return DatabaseError.new(21, "schema", "duplicate column #{column.name}") if names.any? { |name| name.downcase == column.name.downcase }
      names << column.name
      if table_key && keys.any? { |key| key.downcase == column.name.downcase }
        normalized = Column.new(column.name, column.type, nullable: false, default: column.default)
        parts << column_definition(normalized)!
      else
        parts << column_definition(column)!
      end
    end
    if table_key
      key_sql = Grant::SchemaConstraints.quoted_columns(keys)!
      keys.each do |key|
        return DatabaseError.new(21, "schema", "primary key column is missing: #{key}") unless names.any? { |name| name.downcase == key.downcase }
      end
      parts << "PRIMARY KEY (#{key_sql})"
    end
    definition.foreign_keys.each do |key|
      return DatabaseError.new(21, "schema", "foreign key column is missing") unless names.includes?(key.column)
      column = identifier(key.column)!
      target_table = identifier(key.target_table)!
      target_column = identifier(key.target_column)!
      action = case key.on_delete
               when DeleteAction::Restrict then "RESTRICT"
               when DeleteAction::Cascade  then "CASCADE"
               when DeleteAction::SetNull  then "SET NULL"
               else                             "NO ACTION"
               end
      parts << "FOREIGN KEY (#{column}) REFERENCES #{target_table} (#{target_column}) ON DELETE #{action}"
    end
    constraint_names = [] of String
    definition.constraints.each do |constraint|
      return DatabaseError.new(21, "schema", "duplicate constraint: #{constraint.name}") if constraint_names.includes?(constraint.name.downcase)
      constraint_names << constraint.name.downcase
      Grant::SchemaConstraints.validate_columns(constraint, names)!
      parts << Grant::SchemaConstraints.constraint_sql(constraint)!
    end
    clause = if_not_exists ? " IF NOT EXISTS" : ""
    suffix = definition.without_rowid ? " WITHOUT ROWID" : ""
    @database.execute("CREATE TABLE#{clause} #{name} (#{parts.join(", ")})#{suffix}", [] of Value)
  end

  def drop_table(name : String, if_exists : Bool = false) : Mutation | DatabaseError
    quoted = identifier(name)!
    @database.execute("DROP TABLE#{if_exists ? " IF EXISTS" : ""} #{quoted}", [] of Value)
  end

  def rename_table(from : String, to : String) : Mutation | DatabaseError
    source = identifier(from)!
    target = identifier(to)!
    @database.execute("ALTER TABLE #{source} RENAME TO #{target}", [] of Value)
  end

  def rename_column(table : String, from : String, to : String) : Mutation | DatabaseError
    return DatabaseError.new(21, "schema", "native column renaming is implemented only for SQLite") unless @database.dialect == Dialect::SQLite
    quoted_table = identifier(table)!
    source = identifier(from)!
    target = identifier(to)!
    @database.execute("ALTER TABLE #{quoted_table} RENAME COLUMN #{source} TO #{target}", [] of Value)
  end

  def add_index(table : String, columns : Array(String), name : String, unique : Bool = false) : Mutation | DatabaseError
    return DatabaseError.new(21, "schema", "index needs columns") if columns.empty?
    quoted_table = identifier(table)!
    quoted_name = identifier(name)!
    quoted_columns = [] of String
    columns.each { |column| quoted_columns << identifier(column)! }
    @database.execute("CREATE#{unique ? " UNIQUE" : ""} INDEX #{quoted_name} ON #{quoted_table} (#{quoted_columns.join(", ")})", [] of Value)
  end

  def drop_index(name : String) : Mutation | DatabaseError
    quoted = identifier(name)!
    @database.execute("DROP INDEX #{quoted}", [] of Value)
  end

  def columns(table : String) : Array(ColumnInfo) | DatabaseError
    rows = if @database.dialect == Dialect::SQLite
             quoted = identifier(table)!
             @database.query("PRAGMA table_xinfo(#{quoted})", [] of Value)!
           else
             @database.query("SELECT column_name AS name, data_type AS type, is_nullable AS nullable, column_default AS default_sql FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = ? ORDER BY ordinal_position", [table] of Value)!
           end
    return DatabaseError.new(21, "schema", "table or view does not exist: #{table}") if rows.empty? && @database.dialect == Dialect::SQLite
    columns = [] of ColumnInfo
    rows.each do |row|
      name = row["name"]
      type = row["type"]
      return DatabaseError.new(20, "schema", "invalid column metadata") unless name.is_a?(String) && type.is_a?(String)
      nullable = if @database.dialect == Dialect::SQLite
                   row["notnull"] == 0_i64 && row["pk"] == 0_i64
                 else
                   row["nullable"] == "YES"
                 end
      default = @database.dialect == Dialect::SQLite ? row["dflt_value"] : row["default_sql"]
      hidden = @database.dialect == Dialect::SQLite ? row["hidden"] : 0_i64
      position = 0
      if @database.dialect == Dialect::SQLite
        primary = row["pk"]
        return DatabaseError.new(20, "schema", "invalid primary key metadata") unless primary.is_a?(Int64) && primary >= 0_i64 && primary <= 2147483647_i64
        position = primary.to_i32
      end
      columns << ColumnInfo.new(name, type, nullable, default.is_a?(String) ? default : nil, hidden == 2_i64 || hidden == 3_i64, hidden == 1_i64, position)
    end
    columns
  end

  private def type_sql(type : ColumnType) : String
    case type
    when ColumnType::Integer  then @database.dialect == Dialect::SQLite ? "INTEGER" : "BIGINT"
    when ColumnType::Float    then @database.dialect == Dialect::SQLite ? "REAL" : "DOUBLE PRECISION"
    when ColumnType::Boolean  then "BOOLEAN"
    when ColumnType::Decimal  then @database.dialect == Dialect::SQLite ? "TEXT" : "NUMERIC"
    when ColumnType::Date     then "DATE"
    when ColumnType::DateTime then @database.dialect == Dialect::SQLite ? "TEXT" : "TIMESTAMPTZ"
    when ColumnType::Binary   then @database.dialect == Dialect::SQLite ? "BLOB" : "BYTEA"
    when ColumnType::Json     then @database.dialect == Dialect::SQLite ? "TEXT" : "JSONB"
    else                           "TEXT"
    end
  end
end

pub def literal(value : Value) : String
  case value
  when Nil                     then "NULL"
  when Bool                    then value ? "TRUE" : "FALSE"
  when String                  then "'#{value.gsub("'", "''")}'"
  when Binary                  then "X'#{value.hex}'"
  when Decimal, Date, DateTime then "'#{value.to_s}'"
  else                              value.to_s
  end
end
