module migrations_test

import grant/migrations::{Runner, Migration, SQLMigration}
import grant/adapters/sqlite::{Connection}
import grant/errors::{DatabaseError}

connection = Connection.open(":memory:").or_panic
first = SQLMigration.new(1_i64, ["CREATE TABLE items(id INTEGER PRIMARY KEY)"], ["DROP TABLE items"])
second = SQLMigration.new(2_i64, ["INSERT INTO items VALUES(1)"], ["DELETE FROM items WHERE id=1"])
runner = Runner.new(connection, [second, first] of Migration)
assert runner.migrate(target: 1_i64).or_panic == 1
assert runner.migrate.or_panic == 1
assert runner.migrate.or_panic == 0
assert runner.versions.or_panic.size == 2
assert runner.rollback.or_panic == 1
assert connection.query("SELECT * FROM items").or_panic.empty?
assert runner.migrate.or_panic == 1
changed = SQLMigration.new(1_i64, ["CREATE TABLE items(id INTEGER PRIMARY KEY, name TEXT)"], ["DROP TABLE items"])
assert Runner.new(connection, [changed, second] of Migration).migrate.is_a?(DatabaseError)
assert Runner.new(connection, [first] of Migration).rollback.is_a?(DatabaseError)
assert Runner.new(connection, [first, first] of Migration).migrate.is_a?(DatabaseError)
# The successful first statement is rolled back when a later statement fails.
bad = SQLMigration.new(3_i64, ["INSERT INTO items VALUES(2)", "INSERT INTO missing_table VALUES(3)"], ["DELETE FROM items WHERE id=2"])
assert Runner.new(connection, [first, second, bad] of Migration).migrate.is_a?(DatabaseError)
assert connection.query("SELECT * FROM items").or_panic.size == 1
assert runner.versions.or_panic.size == 2
assert runner.rollback(2).or_panic == 2
assert runner.versions.or_panic.empty?
connection.close.or_panic
