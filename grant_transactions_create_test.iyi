import transaction_crud_models::{Parent, School, ReservedWord}
import nation
import grant/errors::{RecordInvalid}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic
School.migrator.drop_and_create.or_panic
Nation::County.migrator.drop_and_create.or_panic
ReservedWord.migrator.drop_and_create.or_panic

# it: creates a new object
parent = Parent.create(name: "Test Parent")
assert parent.persisted?
assert parent.name == "Test Parent"

# it: does not create an invalid object
parent = Parent.create(name: "")
assert !parent.persisted?

# it: creates a new object
school = School.create(name: "Test School")
assert school.persisted?
assert school.name == "Test School"

# it: creates a new object
county = Nation::County.create(name: "Test School")
assert county.persisted?
assert county.name == "Test School"

# it: creates a new object
reserved_word = ReservedWord.create(all: "foo")
assert reserved_word.errors.empty?
assert reserved_word.all == "foo"

# it: does not update the created_at & updated_at fields
parent = Parent.create({name: "new parent"}, skip_timestamps: true)
assert Parent.find_strict(parent.id).or_panic.created_at.nil?
assert Parent.find_strict(parent.id).or_panic.updated_at.nil?

# it: creates a new object
parent = Parent.create_strict(name: "Test Parent").or_panic
assert parent.persisted?
assert parent.name == "Test Parent"

# it: does not save but raise an exception
error = Parent.create_strict(name: "")
assert error.is_a?(RecordInvalid)
assert error.as(RecordInvalid).message.includes?("Validation failed")

# it: does not update the created_at & updated_at fields
parent = Parent.create_strict({name: "new parent"}, skip_timestamps: true).or_panic
assert Parent.find_strict(parent.id).or_panic.created_at.nil?
assert Parent.find_strict(parent.id).or_panic.updated_at.nil?

Parent.adapter.close.or_panic
