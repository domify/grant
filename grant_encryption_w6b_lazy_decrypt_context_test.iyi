import grant/base::{Base}
import grant/errors::{Rollback}
import grant/encryption/cipher::{Cipher, DecryptionError}
import grant/encryption/key_provider::{KeyProvider}
import grant/encryption/config::{Config}
import grant/encryption
import grant/encryption/context::{UnsupportedTypeError}
import grant/error::{ErrorBase}
import grant/adapter/sqlite::{Connection, Value}
import std/base64::{Base64}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class W6bLazyUser < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6b_lazy_users

  column id : Int64, primary: true
  column name : String?
  encrypts email : String, deterministic: true, lazy: true
  encrypts nickname : String, ignore_case: true, deterministic: true, lazy: true
  encrypts secret : String, lazy: true
  encrypts eager_note : String
  encrypts balance : Int64
end

# Capture the same decrypt log messages at the actual codec boundary. Returned
# errors let the scoped backend and verbosity restore before the result returns.
private def w6b_decrypts(&block : -> T) : Array(String) forall T
  messages = [] of String
  observer = ->(message : String) { messages << message; nil }
  previous = Config.verbose_logging
  Config.verbose_logging = true
  Config.with_operation_observer(observer) { yield }
  Config.verbose_logging = previous
  messages.select { |message| message.starts_with?("decrypt ") }
end

(KeyProvider.primary_key = Base64.encode("test_primary_key_32_bytes_long!!")).or_panic
(KeyProvider.deterministic_key = Base64.encode("test_determ_key_32_bytes_long!!!")).or_panic
KeyProvider.key_derivation_salt = "lazy-salt"
register_spec_connections
W6bLazyUser.migrator.drop_and_create.or_panic

# it: reads like an eagerly decrypted attribute around without_encryption
W6bLazyUser.clear.or_panic
user = W6bLazyUser.create_strict(secret: "hush").or_panic

# Loaded outside the block, the value is plaintext inside it.
outside = W6bLazyUser.find_strict(user.id).or_panic
assert Grant::Encryption.without_encryption { outside.secret }.or_panic == "hush"
assert outside.secret.or_panic == "hush"

# Loaded inside the block, the raw ciphertext is the value, and stays so.
inside = Grant::Encryption.without_encryption { W6bLazyUser.find_strict(user.id) }.or_panic
stored = W6bLazyUser.__connection.query("SELECT secret FROM w6b_lazy_users WHERE id = #{user.id}").or_panic.first["secret"]
assert inside.secret.or_panic == stored

# Native regressions: nested mode blocks and returned errors restore context.
assert Grant::Encryption.encryption_enabled?
error = Grant::Encryption.without_encryption do
  assert !Grant::Encryption.encryption_enabled?
  Grant::Encryption.without_encryption { assert !Grant::Encryption.encryption_enabled? }
  assert !Grant::Encryption.encryption_enabled?
  Grant::Encryption.protecting_encrypted_data do
    assert Grant::Encryption.encryption_enabled?
    Grant::Encryption.without_encryption { assert Grant::Encryption.encryption_enabled? }
  end
  assert !Grant::Encryption.encryption_enabled?
  ErrorBase.new("context error")
end
assert error.is_a?(ErrorBase)
assert Grant::Encryption.encryption_enabled?

# A child fiber starts with the default context and cannot change its parent.
done = Channel(Nil).new
Grant::Encryption.without_encryption do
  group do |tasks|
    tasks.spawn do
      assert Grant::Encryption.encryption_enabled?
      Grant::Encryption.without_encryption { assert !Grant::Encryption.encryption_enabled? }
      assert Grant::Encryption.encryption_enabled?
      done.send(nil).or_panic
    end
    done.receive.or_panic
    assert !Grant::Encryption.encryption_enabled?
  end
end
assert Grant::Encryption.encryption_enabled?

# Disabled writes and eager String hydration pass through the raw text.
raw = Grant::Encryption.without_encryption do
  W6bLazyUser.create_strict(secret: "raw secret", eager_note: "raw note")
end.or_panic
raw_loaded = Grant::Encryption.without_encryption { W6bLazyUser.find_strict(raw.id) }.or_panic
assert raw_loaded.secret.or_panic == "raw secret"
assert raw_loaded.eager_note == "raw note"
assert Grant::Encryption.encryption_enabled?

# Non-String attributes preserve the upstream error when asked to load raw.
typed = W6bLazyUser.create_strict(balance: 7_i64).or_panic
error = Grant::Encryption.without_encryption { W6bLazyUser.find_strict(typed.id) }
assert error.is_a?(UnsupportedTypeError)
assert error.as(UnsupportedTypeError).message.includes?("balance is a Int64")
assert Grant::Encryption.encryption_enabled?

KeyProvider.primary_key = nil
KeyProvider.deterministic_key = nil
KeyProvider.key_derivation_salt = KeyProvider::DEFAULT_SALT
W6bLazyUser.__connection.close.or_panic
