import grant/base::{Base}
import grant/errors::{Rollback, ErrorBase}
import grant/transaction::{IsolationLevel}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
end

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: executes a basic transaction
Parent.clear.or_panic
Parent.transaction do
  parent = Parent.create_strict(name: "Test Parent").or_panic
  assert parent.persisted?
end.or_panic
assert Parent.count.or_panic == 1

# it: rolls back on exception
Parent.clear.or_panic
error = Parent.transaction do
  Parent.create_strict(name: "Should be rolled back").or_panic
  ErrorBase.new("Test error")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "Test error"
assert Parent.count.or_panic == 0

# it: rolls back on Grant::Transaction::Rollback
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Should be rolled back").or_panic
  Rollback.new
end.or_panic
assert Parent.count.or_panic == 0

# it: joins the parent for a plain nested block (Rollback swallowed without undo)
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Parent 1").or_panic
  Parent.transaction do
    Parent.create_strict(name: "Parent 2").or_panic
    Rollback.new
  end.or_panic
  assert Parent.count.or_panic == 2
end.or_panic
assert Parent.count.or_panic == 2

# it: supports nested savepoints with requires_new
Parent.clear.or_panic
Parent.transaction do
  Parent.create_strict(name: "Parent 1").or_panic
  Parent.transaction(requires_new: true) do
    Parent.create_strict(name: "Parent 2").or_panic
    Rollback.new
  end.or_panic
  assert Parent.count.or_panic == 1
end.or_panic
assert Parent.count.or_panic == 1
assert Parent.first_strict.or_panic.name == "Parent 1"

# it: rolls a requires_new savepoint back with the outer transaction
Parent.clear.or_panic
error = Parent.transaction do
  Parent.transaction(requires_new: true) do
    Parent.create_strict(name: "Inner").or_panic
  end.or_panic
  Parent.create_strict(name: "Outer").or_panic
  ErrorBase.new("Outer transaction error")
end
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message == "Outer transaction error"
assert Parent.count.or_panic == 0

# it: detects if transaction is open
assert !Parent.transaction_open?
Parent.transaction do
  assert Parent.transaction_open?
end.or_panic
assert !Parent.transaction_open?

# it: "accepts
# Original macro description: accepts {{level.id}} isolation level
# The upstream macro instantiates the same example for all four levels.
[IsolationLevel::ReadUncommitted, IsolationLevel::ReadCommitted, IsolationLevel::RepeatableRead, IsolationLevel::Serializable].each do |level|
  Parent.transaction(isolation: level) do
    Parent.create_strict(name: "Test with #{level}").or_panic
  end.or_panic
end

# it: accepts readonly option
Parent.clear.or_panic
Parent.create_strict(name: "Existing").or_panic
Parent.transaction(readonly: true) do
  assert Parent.count.or_panic == 1
end.or_panic
Parent.adapter.close.or_panic
