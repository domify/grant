import grant/base::{Base}
import std/time::{Time}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import std/enumerable

class Parent < Base
  connection sqlite
  table parents
  column id : Int64, primary: true
  column name : String?
end

class School < Base
  connection sqlite
  table schools
  column custom_id : Int64, primary: true
  column name : String?
end

class Review < Base
  connection sqlite
  table reviews
  column id : Int64, primary: true
  column name : String?
  column downvotes : Int32?
  column upvotes : Int64?
  column sentiment : Float32?
  column interest : Float64?
  column published : Bool?
  column created_at : Time?
end

class NonAutoDefaultPK < Base
  connection sqlite
  table non_auto_default_pk
  column id : Int64, primary: true, auto: false
  column name : String?
end

class NonAutoCustomPK < Base
  connection sqlite
  table non_auto_custom_pk
  column custom_id : Int64, primary: true, auto: false
  column name : String?
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
Parent.migrator.drop_and_create.or_panic
School.migrator.drop_and_create.or_panic
Review.migrator.drop_and_create.or_panic
NonAutoDefaultPK.migrator.drop_and_create.or_panic
NonAutoCustomPK.migrator.drop_and_create.or_panic


# it: should import 3 new objects
Parent.clear.or_panic
to_import = [
  Parent.new(name: "ImportParent1"),
  Parent.new(name: "ImportParent2"),
  Parent.new(name: "ImportParent3"),
]
Parent.import_records(to_import).or_panic
assert Parent.all("WHERE name LIKE ?", ["ImportParent%"]).or_panic.size == 3

# it: should work with batch_size
to_import = [
  Parent.new(name: "ImportBatchParent1"),
  Parent.new(name: "ImportBatchParent2"),
  Parent.new(name: "ImportBatchParent3"),
  Parent.new(name: "ImportBatchParent4"),
]

Parent.import_records(to_import, batch_size: 2).or_panic
assert Parent.all("WHERE name LIKE ?", ["ImportBatchParent%"]).or_panic.size == 4

# it: should be able to update existing records
to_import = [
  Review.new(name: "ImportReview1", published: false, upvotes: 0.to_i64),
  Review.new(name: "ImportReview2", published: false, upvotes: 0.to_i64),
  Review.new(name: "ImportReview3", published: false, upvotes: 0.to_i64),
  Review.new(name: "ImportReview4", published: false, upvotes: 0.to_i64),
]

Review.import_records(to_import).or_panic

reviews = Review.all("WHERE name LIKE ?", ["ImportReview%"]).or_panic
assert reviews.size == 4
assert reviews.none? { |r| r.published == true }
assert reviews.all? { |r| r.upvotes == 0 }

reviews.each { |r| r.published = true; r.upvotes = 1.to_i64 }

Review.import_records(reviews, update_on_duplicate: true, columns: ["published", "upvotes"]).or_panic

reviews = Review.all("WHERE name LIKE ?", ["ImportReview%"]).or_panic

assert reviews.size == 4
assert reviews.all? { |r| r.published == true }
assert reviews.all? { |r| r.upvotes == 1 }

# it: should work with on_duplicate_key_update
to_import = [
  NonAutoDefaultPK.new(id: 1.to_i64, name: "NonAutoDefaultPK1"),
  NonAutoDefaultPK.new(id: 2.to_i64, name: "NonAutoDefaultPK2"),
  NonAutoDefaultPK.new(id: 3.to_i64, name: "NonAutoDefaultPK3"),
]

NonAutoDefaultPK.import_records(to_import).or_panic

to_import = [
  NonAutoDefaultPK.new(id: 3.to_i64, name: "NonAutoDefaultPK3"),
]

NonAutoDefaultPK.import_records(to_import, update_on_duplicate: true, columns: ["name"]).or_panic

record = NonAutoDefaultPK.find_strict(3.to_i64).or_panic
assert record.name == "NonAutoDefaultPK3"
assert record.id == 3.to_i64

# it: should work with on_duplicate_key_ignore
to_import = [
  NonAutoDefaultPK.new(id: 4.to_i64, name: "NonAutoDefaultPK4"),
  NonAutoDefaultPK.new(id: 5.to_i64, name: "NonAutoDefaultPK5"),
  NonAutoDefaultPK.new(id: 6.to_i64, name: "NonAutoDefaultPK6"),
]

NonAutoDefaultPK.import_records(to_import).or_panic

to_import = [
  NonAutoDefaultPK.new(id: 6.to_i64, name: "NonAutoDefaultPK6"),
]

NonAutoDefaultPK.import_records(to_import, ignore_on_duplicate: true).or_panic

record = NonAutoDefaultPK.find_strict(6.to_i64).or_panic
assert record.name == "NonAutoDefaultPK6"
assert record.id == 6.to_i64

# it: should import 3 new objects
to_import = [
  School.new(name: "ImportBasicSchool1"),
  School.new(name: "ImportBasicSchool2"),
  School.new(name: "ImportBasicSchool3"),
]
School.import_records(to_import).or_panic
assert School.all("WHERE name LIKE ?", ["ImportBasicSchool%"]).or_panic.size == 3

# it: should work with batch_size
to_import = [
  School.new(name: "ImportBatchSchool1"),
  School.new(name: "ImportBatchSchool2"),
  School.new(name: "ImportBatchSchool3"),
  School.new(name: "ImportBatchSchool4"),
]

School.import_records(to_import, batch_size: 2).or_panic
assert School.all("WHERE name LIKE ?", ["ImportBatchSchool%"]).or_panic.size == 4

# it: should be able to update existing records
to_import = [
  School.new(name: "ImportExistingSchool"),
  School.new(name: "ImportExistingSchool"),
  School.new(name: "ImportExistingSchool"),
  School.new(name: "ImportExistingSchool"),
]

School.import_records(to_import).or_panic

schools = School.all("WHERE name = ?", ["ImportExistingSchool"]).or_panic
assert schools.size == 4
assert schools.all? { |s| s.name == "ImportExistingSchool" }

schools.each { |s| s.name = "ImportExistingSchoolEdited" }

School.import_records(schools, update_on_duplicate: true, columns: ["name"]).or_panic

schools = School.all("WHERE name LIKE ?", ["ImportExistingSchool%"]).or_panic
assert schools.size == 4
assert schools.all? { |s| s.name == "ImportExistingSchoolEdited" }

# it: should work with on_duplicate_key_update
to_import = [
  NonAutoCustomPK.new(custom_id: 1.to_i64, name: "NonAutoCustomPK1"),
  NonAutoCustomPK.new(custom_id: 2.to_i64, name: "NonAutoCustomPK2"),
  NonAutoCustomPK.new(custom_id: 3.to_i64, name: "NonAutoCustomPK3"),
]

NonAutoCustomPK.import_records(to_import).or_panic

to_import = [
  NonAutoCustomPK.new(custom_id: 3.to_i64, name: "NonAutoCustomPK3"),
]

NonAutoCustomPK.import_records(to_import, update_on_duplicate: true, columns: ["name"]).or_panic

record = NonAutoCustomPK.find_strict(3.to_i64).or_panic
assert record.name == "NonAutoCustomPK3"
assert record.custom_id == 3.to_i64

# it: should work with on_duplicate_key_ignore
to_import = [
  NonAutoCustomPK.new(custom_id: 4.to_i64, name: "NonAutoCustomPK4"),
  NonAutoCustomPK.new(custom_id: 5.to_i64, name: "NonAutoCustomPK5"),
  NonAutoCustomPK.new(custom_id: 6.to_i64, name: "NonAutoCustomPK6"),
]

NonAutoCustomPK.import_records(to_import).or_panic

to_import = [
  NonAutoCustomPK.new(custom_id: 6.to_i64, name: "NonAutoCustomPK6"),
]

NonAutoCustomPK.import_records(to_import, ignore_on_duplicate: true).or_panic

record = NonAutoCustomPK.find_strict(6.to_i64).or_panic
assert record.name == "NonAutoCustomPK6"
assert record.custom_id == 6.to_i64
Parent.adapter.close.or_panic
