module pool_spec_support

# Native counterpart of crystal-upstream/spec/grant/connection/pool_spec_support.cr.
# Helpers shared by the connection pool specs. They run against whichever
# adapter CURRENT_ADAPTER selects, so the same example proves the behavior on
# SQLite and on PostgreSQL.
import std/dir::{Dir}
import std/file::{File}
import std/time::{Span}
import grant/adapter/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/adapter/pg::{Pg}
import grant/adapter/pool_support::{ticks}
import grant/connection_registry::{ConnectionRegistry}
import spec_helper::{CURRENT_ADAPTER, ADAPTER_URL}

# The process id names the upstream directory; a start tick does here.
C02_DIR = File.join(Dir.tempdir, "c02_pool_#{ticks}")

pub class C02Support
  # A new adapter of the class under test.
  def self.new_adapter(name : String, url : String) : Base
    CURRENT_ADAPTER == "pg" ? Pg.new(name, url).as(Base) : Sqlite.new(name, url).as(Base)
  end

  # A URL for the adapter under test. SQLite gets its own file per *name* so
  # pool teardown in one example never touches another's database.
  def self.url(name : String) : String
    CURRENT_ADAPTER == "sqlite" ? "sqlite3:#{File.join(dir, "#{name}.sqlite3")}" : ADAPTER_URL
  end

  # A URL nothing listens on, for the adapter under test.
  def self.unreachable_url : String
    case CURRENT_ADAPTER
    when "pg" then "postgres://localhost:1/c02_unreachable"
    else           "sqlite3:/c02_no_such_directory/unreachable.sqlite3"
    end
  end

  def self.dir : String
    Dir.mkdir_p(C02_DIR)
    C02_DIR
  end

  def self.cleanup : Nil
    return nil unless Dir.exists?(C02_DIR)
    Dir.each_child(C02_DIR) { |child| File.delete(File.join(C02_DIR, child)) }
    Dir.delete(C02_DIR)
    nil
  end

  def self.establish(database : String, role : Symbol = :writing, pool_size : Int32 = 25, initial_pool_size : Int32 = 2, max_idle_pool_size : Int32 = 25, checkout_timeout : Span = Span.seconds(5_i64), verify_idle_after : Span? = Span.seconds(30_i64), retry_attempts : Int32 = 1, retry_delay : Span = Span.milliseconds(200_i64)) : Base
    if CURRENT_ADAPTER == "pg"
      ConnectionRegistry.establish_connection(database: database, adapter: Pg, url: url(database), role: role, pool_size: pool_size, initial_pool_size: initial_pool_size, max_idle_pool_size: max_idle_pool_size, checkout_timeout: checkout_timeout, verify_idle_after: verify_idle_after).or_panic
    else
      ConnectionRegistry.establish_connection(database: database, adapter: Sqlite, url: url(database), role: role, pool_size: pool_size, initial_pool_size: initial_pool_size, max_idle_pool_size: max_idle_pool_size, checkout_timeout: checkout_timeout, verify_idle_after: verify_idle_after).or_panic
    end
    adapter = ConnectionRegistry.get_adapter(database, role)
    adapter.retry_attempts = retry_attempts
    adapter.retry_delay = retry_delay
    adapter
  end
end
