import grant/adapter/sqlite::{Sqlite}
import grant/scale/schema_tenant::{SchemaTenant}
import grant/connection_management::{ReplicaLagTracker}

# it: uses question predicates for connection and schema state
adapter = Sqlite.new("boolean_predicate", "sqlite3::memory:")
adapter.open do |connection|
  context = SchemaTenant::Context.new(adapter, connection, "acme")
  assert context.usable?
end.or_panic
assert !ReplicaLagTracker.new.written?
adapter.close.or_panic
