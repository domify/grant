import grant/base::{Base}
import grant/adapter/base
import std/time
import spec_helper::{register_spec_connections}
register_spec_connections

# Model for testing connection management
class ConnectionTestModel < Base
  table connection_test

  column id : Int64, primary: true
  column name : String

  # Configure multiple connections
  connects_to config: {writing: "primary", reading: "replica"}
end

# Model for testing sharded connections
class ConnectionManagementShardedModel < Base
  table sharded_models

  column id : Int64, primary: true
  column name : String

  connects_to shards: {
    shard_one: {writing: "shard1_primary", reading: "shard1_replica"},
    shard_two: {writing: "shard2_primary", reading: "shard2_replica"},
  }
end

# Model without connection configuration for testing fallback
class UnConfiguredModel < Base
  table unconfigured
  column id : Int64, primary: true
end

# it: delegates to Grant::Connections
# Save original value
original_value = ::Grant::Connections::Connections.connection_switch_wait_period

# Test getter
assert ConnectionTestModel.connection_switch_wait_period == original_value

# Test setter
ConnectionTestModel.connection_switch_wait_period = 5000
assert ::Grant::Connections::Connections.connection_switch_wait_period == 5000
assert ConnectionTestModel.connection_switch_wait_period == 5000

# Restore original value
::Grant::Connections::Connections.connection_switch_wait_period = original_value

# it: tracks write operations
# Initial state - no recent writes
assert ConnectionTestModel.last_write_time.is_a?(::Std::Time::Span)

# Mark write operation
ConnectionTestModel.mark_write_operation
after_write = ConnectionTestModel.last_write_time

# Time should be updated
assert after_write >= ::Std::Time::Time.monotonic - ::Std::Time::Span.seconds(1_i64)

# it: determines current role based on write timing
# Configure connections
ConnectionTestModel.connection_config = {:writing => "primary", :reading => "replica"}

# Right after write, should use primary
ConnectionTestModel.mark_write_operation
assert ConnectionTestModel.current_role == :primary

# Set wait period to 50ms for testing
original_wait = ConnectionTestModel.connection_switch_wait_period
ConnectionTestModel.connection_switch_wait_period = 50

# Wait for switch period
sleep(100).or_panic

# Should now use reading role
assert ConnectionTestModel.current_role == :reading

# Restore original wait period
ConnectionTestModel.connection_switch_wait_period = original_wait

# it: switches database context within a block
original_db = ConnectionTestModel.current_database

ConnectionTestModel.connected_to(database: "other_db") do
  assert ConnectionTestModel.current_database == "other_db"
end

# Should restore after block
assert ConnectionTestModel.current_database == original_db

# it: switches role within a block
ConnectionTestModel.connected_to(role: :reading) do
  assert ConnectionTestModel.current_role == :reading
end

# Role selection should be based on timing again
ConnectionTestModel.mark_write_operation
assert ConnectionTestModel.current_role == :primary

# it: prevents writes when specified
assert !ConnectionTestModel.preventing_writes?

ConnectionTestModel.connected_to(prevent_writes: true) do
  assert ConnectionTestModel.preventing_writes?
end

assert !ConnectionTestModel.preventing_writes?

# it: supports sharded connections
assert ConnectionManagementShardedModel.current_shard.nil?

ConnectionManagementShardedModel.connected_to(shard: :shard_one) do
  assert ConnectionManagementShardedModel.current_shard == :shard_one
end

assert ConnectionManagementShardedModel.current_shard.nil?

# it: blocks write operations within the block
assert !ConnectionTestModel.preventing_writes?

ConnectionTestModel.while_preventing_writes do
  assert ConnectionTestModel.preventing_writes?
end

assert !ConnectionTestModel.preventing_writes?

# it: selects adapter based on current context
# This test verifies the adapter method logic
# In a real scenario, it would return different adapters
assert ConnectionTestModel.adapter.is_a?(::Grant::Adapter::Base::Base)

# it: falls back to registered connections when not configured
# Models without connection configuration should still work
# Should not raise error
assert UnConfiguredModel.adapter.is_a?(::Grant::Adapter::Base::Base)
