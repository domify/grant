import transaction_crud_models::{Parent}
import grant/connections::{Connections}
import grant/adapter/sqlite::{Connection}
import grant/adapter/base::{AdapterTestHelpers}
import grant/adapter/sqlite_test_helpers::{SqliteTestHelpers}
import grant/errors::{ErrorBase, Rollback}
import grant/error_taxonomy::{InvalidForeignKey}

def adapter : Connection
  Parent.adapter
end

def run(statement : String)
  adapter.execute(statement)
end

def count(table : String) : Int64
  adapter.query("SELECT COUNT(*) AS count FROM #{table}").or_panic[0]["count"].as(Int64)
end

def insert_author(name : String) : Int64
  run("INSERT INTO o01_authors (name) VALUES ('#{name}')").or_panic
  adapter.query("SELECT MAX(id) AS id FROM o01_authors").or_panic[0]["id"].as(Int64)
end

Connections.register("sqlite", Connection.open(":memory:").or_panic)
run("DROP TABLE IF EXISTS o01_books").or_panic
run("DROP TABLE IF EXISTS o01_authors").or_panic
run("CREATE TABLE o01_authors (id INTEGER PRIMARY KEY AUTOINCREMENT, name VARCHAR(50))").or_panic
run("CREATE TABLE o01_books (id INTEGER PRIMARY KEY AUTOINCREMENT, author_id BIGINT NOT NULL, title VARCHAR(50), FOREIGN KEY (author_id) REFERENCES o01_authors (id))").or_panic

# it: empties several tables in one call and restarts their ids
adapter.truncate_tables("o01_books", "o01_authors").or_panic
3.times { |index| insert_author("a#{index}") }
run("INSERT INTO o01_books (author_id, title) VALUES (1, 'b')").or_panic
adapter.truncate_tables("o01_books", "o01_authors").or_panic
assert count("o01_books") == 0
assert count("o01_authors") == 0
assert insert_author("fresh") == 1

# SQLite branch of the upstream PostgreSQL-named example (excluded by existing metadata).
adapter.truncate_tables("o01_books", "o01_authors").or_panic
statements = [] of String
adapter.query_observer = ->(sql : String) { statements << sql; nil }
adapter.truncate_tables("o01_books", "o01_authors").or_panic
adapter.query_observer = nil
# Preserve the SQLite branch of the original adapter-specific assertions.
assert statements.size >= 2

# it: does nothing for an empty list
adapter.truncate_tables("o01_books", "o01_authors").or_panic
insert_author("kept")
adapter.truncate_tables([] of String).or_panic
assert count("o01_authors") == 1

# it: moves the counter back to one past the highest id
adapter.truncate_tables("o01_books", "o01_authors").or_panic
3.times { |index| insert_author("a#{index}") }
run("DELETE FROM o01_authors WHERE id > 1").or_panic
adapter.reset_pk_sequence_strict("o01_authors").or_panic
assert insert_author("next") == 2

# it: moves the counter past rows loaded with explicit ids
adapter.truncate_tables("o01_books", "o01_authors").or_panic
run("INSERT INTO o01_authors (id, name) VALUES (50, 'explicit')").or_panic
adapter.reset_pk_sequence_strict("o01_authors").or_panic
assert insert_author("after") == 51

# it: restarts at 1 for an empty table
adapter.truncate_tables("o01_books", "o01_authors").or_panic
2.times { |index| insert_author("a#{index}") }
run("DELETE FROM o01_authors").or_panic
adapter.reset_pk_sequence_strict("o01_authors").or_panic
assert insert_author("first") == 1

# it: allows a child row before its parent exists
adapter.truncate_tables("o01_books", "o01_authors").or_panic
adapter.disable_referential_integrity do
  run("INSERT INTO o01_books (author_id, title) VALUES (77, 'early')").or_panic
  run("INSERT INTO o01_authors (id, name) VALUES (77, 'late')").or_panic
end.or_panic
assert count("o01_books") == 1
assert count("o01_authors") == 1

# it: returns the block's value
adapter.truncate_tables("o01_books", "o01_authors").or_panic
assert adapter.disable_referential_integrity { 42 }.or_panic == 42

# it: enforces foreign keys again after the block
adapter.truncate_tables("o01_books", "o01_authors").or_panic
adapter.disable_referential_integrity { }.or_panic
error = run("INSERT INTO o01_books (author_id, title) VALUES (999, 'orphan')")
assert error.is_a?(InvalidForeignKey)

# it: enforces foreign keys again after the block raised
adapter.truncate_tables("o01_books", "o01_authors").or_panic
error = adapter.disable_referential_integrity { ErrorBase.new("in block") }
assert error.is_a?(ErrorBase)
assert error.as(ErrorBase).message.includes?("in block")
error = run("INSERT INTO o01_books (author_id, title) VALUES (999, 'orphan')")
assert error.is_a?(InvalidForeignKey)

# it: joins an open transaction and undoes its work with it
adapter.truncate_tables("o01_books", "o01_authors").or_panic
Parent.transaction do
  adapter.disable_referential_integrity do
    run("INSERT INTO o01_books (author_id, title) VALUES (5, 'joined')").or_panic
    run("INSERT INTO o01_authors (id, name) VALUES (5, 'joined')").or_panic
  end.or_panic
  Rollback.new
end
assert count("o01_books") == 0

run("DROP TABLE IF EXISTS o01_books").or_panic
run("DROP TABLE IF EXISTS o01_authors").or_panic
adapter.close.or_panic
