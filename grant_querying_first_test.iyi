import std/regex::{Regex}
import transaction_crud_models::{Parent}
import grant/querying::{NotFound}
import spec_helper::{register_spec_connections}

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: finds the first object
Parent.clear.or_panic
first = Parent.new
first.name = "Test 1"
first.save
second = Parent.new
second.name = "Test 2"
second.save
found = Parent.first.or_panic
if pa = found
  assert pa.id == first.id
else
  assert !pa.nil?
end
found = Parent.first_strict.or_panic
assert found.id == first.id

# it: supports a SQL clause
Parent.clear.or_panic
first = Parent.new
first.name = "Test 1"
first.save
second = Parent.new
second.name = "Test 2"
second.save
found = Parent.first("ORDER BY id DESC").or_panic
if pa = found
  assert pa.id == second.id
else
  assert !pa.nil?
end
found = Parent.first_strict("ORDER BY id DESC").or_panic
assert found.id == second.id

# it: returns nil or raises if no result
Parent.clear.or_panic
first = Parent.new
first.name = "Test 1"
first.save
found = Parent.first("WHERE name = 'Test 2'").or_panic
assert found.nil?
error = Parent.first_strict("WHERE name = 'Test 2'")
assert error.is_a?(NotFound)
assert error.as(NotFound).message.matches?(/No .*Parent.* found with first\(WHERE name = 'Test 2'\)/)

Parent.adapter.close.or_panic
