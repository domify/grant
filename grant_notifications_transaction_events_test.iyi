import std/time::{Span}
import grant/base::{Base}
import grant/connection_registry::{ConnectionRegistry}
import grant/events::{Transaction, TransactionStart, TransactionOutcome}
import grant/notifications
import grant/errors::{Rollback}
import grant/error::{ErrorBase}
import spec_helper::{CURRENT_ADAPTER, restore_default_spec_connections, establish_spec_connection}

class Parent < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table parents
  column id : Int64, primary: true
  column name : String?
  timestamps
end

private def transaction_events(&block : -> T) : Array(Transaction) forall T
  events = [] of Transaction
  handler = ->(event : Transaction) { events << event; nil }
  ::Grant::Notifications.subscribed(Transaction, handler) { yield }
  events
end

restore_default_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: publishes start and commit with a duration
Parent.clear.or_panic
starts = [] of TransactionStart
start_handler = ->(event : TransactionStart) { starts << event; nil }
events = transaction_events do
  ::Grant::Notifications.subscribed(TransactionStart, start_handler) do
    Parent.transaction { Parent.create_strict(name: "committed").or_panic }.or_panic
  end
end
starts = starts.reject { |event| event.savepoint? }
events = events.reject { |event| event.savepoint? }
assert starts.size == 1
assert starts.first.connection == Parent.adapter.name
assert events.size == 1
assert events.first.outcome.commit?
assert events.first.committed?
assert events.first.duration >= Span.zero
assert events.first.connection == Parent.adapter.name

# it: publishes a rollback for Rollback and for an exception
Parent.clear.or_panic
events = transaction_events do
  Parent.transaction { Rollback.new }
  error = Parent.transaction { ErrorBase.new("boom") }
  assert error.is_a?(ErrorBase)
  assert error.as(ErrorBase).message == "boom"
end
assert events.map { |event| event.outcome } == [TransactionOutcome::Rollback, TransactionOutcome::Rollback]
assert events.all? { |event| event.rolled_back? }

# it: publishes nothing for a joined nested block and a savepoint event for requires_new
Parent.clear.or_panic
starts = [] of TransactionStart
start_handler = ->(event : TransactionStart) { starts << event; nil }
events = transaction_events do
  ::Grant::Notifications.subscribed(TransactionStart, start_handler) do
    Parent.transaction do
      Parent.transaction { nil }.or_panic
      Parent.transaction(requires_new: true) { nil }.or_panic
      Parent.transaction(requires_new: true) { Rollback.new }.or_panic
    end.or_panic
  end
end
assert starts.map { |event| event.savepoint? } == [false, true, true]
assert events.map { |event| {event.savepoint?, event.outcome} } == [
  {true, TransactionOutcome::Commit},
  {true, TransactionOutcome::Rollback},
  {false, TransactionOutcome::Commit},
]
assert !events.first.savepoint_name.nil?

# it: publishes the outcome of a manual savepoint
Parent.clear.or_panic
events = transaction_events do
  Parent.transaction do
    Parent.connection.begin_transaction.or_panic.commit.or_panic
    Parent.connection.begin_transaction.or_panic.rollback.or_panic
  end.or_panic
end
assert events.map { |event| {event.savepoint?, event.outcome} } == [
  {true, TransactionOutcome::Commit},
  {true, TransactionOutcome::Rollback},
  {false, TransactionOutcome::Commit},
]

# it: publishes the outcome of a manual transaction
Parent.clear.or_panic
events = transaction_events do
  handle = Parent.connection.begin_transaction.or_panic
  handle.rollback.or_panic
  handle = Parent.connection.begin_transaction.or_panic
  handle.commit.or_panic
end
assert events.map { |event| event.outcome } == [TransactionOutcome::Rollback, TransactionOutcome::Commit]

# it: publishes nothing when no one subscribes
Parent.clear.or_panic
assert ::Grant::Notifications.subscribed?(Transaction) == false
Parent.transaction { Parent.create_strict(name: "quiet").or_panic }.or_panic
assert Parent.count.or_panic == 1

# Native checks: scoped subscriptions release after returned errors, handler
# failures cannot alter the transaction, and publication uses a snapshot.
returned = ::Grant::Notifications.subscribed(Transaction, ->(event : Transaction) { nil }) do
  ErrorBase.new("scope error")
end
assert returned.message == "scope error"
assert !::Grant::Notifications.subscribed?(Transaction)
observed = [] of Transaction
subscription = ::Grant::Notifications.subscribe(Transaction) do |event|
  observed << event
  ErrorBase.new("observer error")
end
Parent.transaction { Parent.create_strict(name: "observed").or_panic }.or_panic
assert observed.last.committed?
assert Parent.count.or_panic == 2
subscription.unsubscribe
assert !::Grant::Notifications.subscribed?(Transaction)

calls = [] of String
subscriptions = [] of ::Grant::Notifications::Subscription(Transaction)
first_subscription = ::Grant::Notifications.subscribe(Transaction) do |event|
  calls << "first"
  subscriptions.first.unsubscribe
  nil
end
second_subscription = ::Grant::Notifications.subscribe(Transaction) do |event|
  calls << "second"
  nil
end
subscriptions << second_subscription
payload = Transaction.new("snapshot", TransactionOutcome::Commit, Span.zero, ::Grant::Transaction::Options.new)
Transaction.publish(payload)
Transaction.publish(payload)
assert calls == ["first", "second", "first"]
first_subscription.unsubscribe
assert !::Grant::Notifications.subscribed?(Transaction)

built = false
::Grant::Notifications.instrument(Transaction) do
  built = true
  Transaction.new("unused", TransactionOutcome::Commit, Span.zero, ::Grant::Transaction::Options.new)
end
assert !built

# Configured adapter names survive the native physical connection boundary.
establish_spec_connection("named")
named = ::Grant::ConnectionRegistry::ConnectionRegistry.get_adapter("named", :primary)
events = transaction_events { ::Grant::Transaction.run(named, ::Grant::Transaction::Options.new) { nil }.or_panic }
assert events.first.connection == named.name
ConnectionRegistry.remove_connection("named", :primary).or_panic
ConnectionRegistry.remove_connection(CURRENT_ADAPTER, :primary).or_panic
