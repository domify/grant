import grant/base::{Base}
import grant/errors::{Rollback}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class T6PersistenceRecord < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table t6_persistence_records

  column id : Int64, primary: true
  column name : String?
  column note : String?
  column counter : Int32?
  timestamps
end

register_spec_connections
T6PersistenceRecord.migrator.drop_and_create.or_panic

# it: restores a created record to new state when its transaction rolls back
T6PersistenceRecord.clear.or_panic
record = T6PersistenceRecord.new(name: "rolled back")

T6PersistenceRecord.transaction do
  assert record.save_strict.or_panic
  Rollback.new
end.or_panic

assert record.new_record?
assert !record.persisted?
assert T6PersistenceRecord.count.or_panic == 0

assert record.save_strict.or_panic
assert record.persisted?
assert T6PersistenceRecord.count.or_panic == 1

# it: restores updated record state after transaction rollback
T6PersistenceRecord.clear.or_panic
record = T6PersistenceRecord.create_strict(name: "before").or_panic

T6PersistenceRecord.transaction do
  record.update_strict(name: "inside").or_panic
  Rollback.new
end.or_panic

assert record.name == "before"
assert !record.name_changed?
assert T6PersistenceRecord.find_strict(record.id).or_panic.name == "before"

# it: restores only savepoint changes and keeps earlier outer writes
T6PersistenceRecord.clear.or_panic
record = T6PersistenceRecord.create_strict(name: "before").or_panic

T6PersistenceRecord.transaction do
  record.update_strict(name: "outer").or_panic

  T6PersistenceRecord.transaction(requires_new: true) do
    record.update_strict(name: "inner").or_panic
    Rollback.new
  end.or_panic

  assert record.name == "outer"
  assert !record.name_changed?
end.or_panic

assert T6PersistenceRecord.find_strict(record.id).or_panic.name == "outer"

T6PersistenceRecord.adapter.close.or_panic
