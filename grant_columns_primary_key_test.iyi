import grant/base::{Base}
import transaction_crud_models::{Parent}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

class Kvs < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table kvs
  column k : String, primary: true, auto: false
  column v : String?
end

register_spec_connections

# it: works when the primary is defined as `auto: true`
Parent.new

# it: works when the primary is defined as `auto: false`
Kvs.new

# it: preserves an explicitly assigned auto primary key
assert Parent.new(id: 1_i64).id == 1_i64

# it: sets the value when the primary is defined as `auto: false`
assert Kvs.new(k: "foo").k == "foo"
assert Kvs.new(k: "foo", v: "v").k == "foo"

Parent.adapter.close.or_panic
