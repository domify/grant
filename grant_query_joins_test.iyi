import query_spec_helper::{Model, builder, with_legacy_implicit_order}
import grant/query/builder::{Builder}

with_legacy_implicit_order do

  # it: adds an inner join clause
  query = builder.joins("posts", on: "posts.user_id = table.id")
  assert query.join_clauses.size == 1
  assert query.join_clauses.first[:type] == :inner
  assert query.join_clauses.first[:table] == "posts"
  assert query.join_clauses.first[:on] == "posts.user_id = table.id"

  # it: chains joins with where conditions
  query = builder
    .joins("posts", on: "posts.user_id = table.id")
    .where(name: "bob")
  assert query.join_clauses.size == 1
  assert query.where_fields.size == 1

  # it: supports multiple joins
  query = builder
    .joins("posts", on: "posts.user_id = table.id")
    .joins("comments", on: "comments.post_id = posts.id")
  assert query.join_clauses.size == 2
  assert query.join_clauses[0][:table] == "posts"
  assert query.join_clauses[1][:table] == "comments"

  # it: returns self for chaining
  query = builder.joins("posts", on: "posts.user_id = table.id")
  assert query.is_a?(Builder(Model))

  # it: adds a left join clause
  query = builder.left_joins("posts", on: "posts.user_id = table.id")
  assert query.join_clauses.size == 1
  assert query.join_clauses.first[:type] == :left
  assert query.join_clauses.first[:table] == "posts"

  # it: can be combined with inner joins
  query = builder
    .joins("posts", on: "posts.user_id = table.id")
    .left_joins("comments", on: "comments.post_id = posts.id")
  assert query.join_clauses.size == 2
  assert query.join_clauses[0][:type] == :inner
  assert query.join_clauses[1][:type] == :left

  # it: copies join clauses on dup
  original = builder.joins("posts", on: "posts.user_id = table.id")
  copy = original.dup
  assert copy.join_clauses.size == 1
  assert copy.join_clauses.first[:table] == "posts"

  # it: dup creates independent copy
  original = builder.joins("posts", on: "posts.user_id = table.id")
  copy = original.dup
  copy = copy.joins("comments", on: "comments.post_id = posts.id")
  assert original.join_clauses.size == 1
  assert copy.join_clauses.size == 2

  # it: merges join clauses from another builder
  b1 = builder.joins("posts", on: "posts.user_id = table.id")
  b2 = builder.joins("comments", on: "comments.user_id = table.id")
  b1 = b1.merge(b2)
  assert b1.join_clauses.size == 2

  # it: does not duplicate join clauses on merge
  b1 = builder.joins("posts", on: "posts.user_id = table.id")
  b2 = builder.joins("posts", on: "posts.user_id = table.id")
  b1 = b1.merge(b2)
  assert b1.join_clauses.size == 1
end
