import grant/base::{Base}
import grant/errors::{Rollback}
import spec_helper::{CURRENT_ADAPTER, register_spec_connections}

# Native counterpart of the upstream db log backend: observe statements at
# the driver's actual prepare boundary, including transaction control.
class W6PerfStatementLog
  getter list_of_statements = [] of String
end
W6_PERF_STATEMENT_LOG = W6PerfStatementLog.new
W6_PERF_BEGIN = "BEGIN"

private def w6_perf_statements(&block : -> T) : Array(String) forall T
  W6_PERF_STATEMENT_LOG.list_of_statements.clear
  connection = W6PerfPerson.__connection
  previous = connection.query_observer
  connection.query_observer = ->(sql : String) { W6_PERF_STATEMENT_LOG.list_of_statements << sql; nil }
  yield
  connection.query_observer = previous
  W6_PERF_STATEMENT_LOG.list_of_statements.dup
end

class W6PerfPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_people
  column id : Int64, primary: true
  column name : String
  column score : Int32?
  timestamps
end

class W6PerfAuditedPerson < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table w6_perf_audited_people
  column id : Int64, primary: true
  column name : String
  column touches : Int32 = 0
  before_save :write_audit_row

  private def write_audit_row
    W6PerfPerson.create_strict(name: "audit of #{name}").or_panic
  end
end

private def reset
  W6PerfPerson.clear.or_panic
  W6PerfAuditedPerson.clear.or_panic
end

register_spec_connections
W6PerfPerson.migrator.drop_and_create.or_panic
W6PerfAuditedPerson.migrator.drop_and_create.or_panic

# it: runs BEGIN, UPDATE and COMMIT for a change
reset
loaded = W6PerfPerson.find_strict(W6PerfPerson.create_strict(name: "Before").or_panic.id).or_panic
loaded.name = "After"
statements = w6_perf_statements { assert loaded.save }
assert statements.size == 3
assert statements[0].starts_with?(W6_PERF_BEGIN)
assert statements[1].starts_with?("UPDATE")
assert statements[2] == "COMMIT"
assert W6PerfPerson.find_strict(loaded.id).or_panic.name == "After"

# it: sends BEGIN when a callback of a clean record writes
reset
audited = W6PerfAuditedPerson.create_strict(name: "audited").or_panic
W6PerfPerson.clear.or_panic
loaded_audited = W6PerfAuditedPerson.find_strict(audited.id).or_panic
statements = w6_perf_statements { assert loaded_audited.save }
assert statements.first.starts_with?(W6_PERF_BEGIN)
assert statements.last == "COMMIT"
assert statements.count { |sql| sql.starts_with?("INSERT INTO") } == 1
assert W6PerfPerson.count.or_panic == 1

# it: rolls the callback's write back when the transaction does
reset
audited = W6PerfAuditedPerson.create_strict(name: "audited").or_panic
W6PerfPerson.clear.or_panic
loaded_audited = W6PerfAuditedPerson.find_strict(audited.id).or_panic
W6PerfAuditedPerson.transaction do
  assert loaded_audited.save
  Rollback.new
end.or_panic
assert W6PerfPerson.count.or_panic == 0

# it: still restores a record's state when its transaction rolls back
reset
person = W6PerfPerson.create_strict(name: "Original").or_panic
loaded = W6PerfPerson.find_strict(person.id).or_panic
W6PerfPerson.transaction do
  loaded.name = "Changed"
  loaded.save_strict.or_panic
  Rollback.new
end.or_panic
assert W6PerfPerson.find_strict(person.id).or_panic.name == "Original"

# it: still send BEGIN and COMMIT, and run after_commit work
reset
committed = false
statements = w6_perf_statements do
  W6PerfPerson.transaction do
    W6PerfPerson.current_transaction.after_commit { committed = true; nil }
  end.or_panic
end
assert committed
assert statements.size == 2
assert statements[0].starts_with?(W6_PERF_BEGIN)
assert statements[1] == "COMMIT"

# it: send one BEGIN and one COMMIT around several saves
reset
statements = w6_perf_statements do
  W6PerfPerson.transaction do
    W6PerfPerson.create_strict(name: "a").or_panic
    W6PerfPerson.create_strict(name: "b").or_panic
  end.or_panic
end
assert statements.count { |sql| sql.starts_with?(W6_PERF_BEGIN) } == 1
assert statements.count { |sql| sql == "COMMIT" } == 1
assert statements.count { |sql| sql.starts_with?("INSERT INTO") } == 2

W6PerfPerson.__connection.close.or_panic
