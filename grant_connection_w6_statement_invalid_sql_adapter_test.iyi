import grant/base::{Base}
import w6_c04_support::{W6C04}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

W6C04.provision("w6_sql", ["CREATE TABLE w6_sql_things (#{W6C04.id_column}, label TEXT, amount BIGINT)"])
W6C04.establish("w6_sql", "w6_sql", :primary)
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
W6C04.exec("w6_sql", "INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)")
sql = "SELECT missing_col FROM w6_sql_things"

# it: still names the statement that failed
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
w6_failure("missing_col") { adapter.open { |db| db.scalar(sql) } }

# it: names the statement of the last failing call, not an earlier one
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
adapter.open { |db| db.scalar("SELECT 1") }.or_panic
error = w6_failure("w6_sql_things") { adapter.open { |db| db.exec("UPDATE w6_sql_things SET missing_col = 1") } }
assert error.sql.to_s.includes?("UPDATE")

# it: keeps an explicit statement over the last one built
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
error = w6_failure("explicit label") { adapter.open("explicit label") { |db| db.scalar(sql) } }
assert error.sql == "explicit label"

W6C04.remove("w6_sql", :primary)
W6C04.cleanup
