import grant/schema/schema_statements::{RecordingStatements, AdapterStatements}
import grant/schema/introspection
import grant/schema/column_info::{ColumnInfo}
import grant/adapter/schema::{Dialect, UnsupportedOperation}
import grant/connections::{Connections}
import spec_helper
import std/text
SpecHelper.register_spec_connections
# it: comments a table on PostgreSQL and MySQL and skips SQLite
assert RecordingStatements.new(Dialect::Pg).change_table_comment_statements(:users, "Accounts") == ["COMMENT ON TABLE \"users\" IS 'Accounts'"]
assert RecordingStatements.new(Dialect::Pg).change_table_comment_statements(:users, nil) == ["COMMENT ON TABLE \"users\" IS NULL"]
assert RecordingStatements.new(Dialect::Mysql).change_table_comment_statements(:users, "Accounts") == ["ALTER TABLE `users` COMMENT = 'Accounts'"]
assert RecordingStatements.new(Dialect::Sqlite).change_table_comment_statements(:users, "Accounts").empty?
# Supplemental upstream column-comment SQL checks
assert RecordingStatements.new(Dialect::Pg).change_column_comment_statements(:users, :age, "Years").or_panic == ["COMMENT ON COLUMN \"users\".\"age\" IS 'Years'"]
my = RecordingStatements.new(Dialect::Mysql)
my.known_columns["users"] = [ColumnInfo.new("users", "age", "int", false, "0")]
assert my.change_column_comment_statements(:users, :age, "Years").or_panic == ["ALTER TABLE `users` MODIFY COLUMN `age` int NOT NULL DEFAULT 0 COMMENT 'Years'"]
assert RecordingStatements.new(Dialect::Mysql).change_column_comment_statements(:users, :age, "Years").is_a?(UnsupportedOperation)
assert RecordingStatements.new(Dialect::Sqlite).change_column_comment_statements(:users, :age, "Years").or_panic.empty?
# it: escapes quotes in comments
assert RecordingStatements.new(Dialect::Pg).change_table_comment_statements(:users, "Bob's table") == ["COMMENT ON TABLE \"users\" IS 'Bob''s table'"]
adapter = Connections[SpecHelper::CURRENT_ADAPTER]
statements = AdapterStatements.new(adapter)
schema = adapter.schema
statements.drop_table(:m02b_cm, if_exists: true).or_panic
statements.create_table(:m02b_cm) { |t| t.integer(:age) }.or_panic
# it: sets, reads and clears comments where the database has them
statements.change_table_comment(:m02b_cm, "Accounts").or_panic
statements.change_column_comment(:m02b_cm, :age, "Years").or_panic
if SpecHelper::CURRENT_ADAPTER == "sqlite"
  assert schema.table_comment(:m02b_cm).or_panic.nil?
  assert schema.columns(:m02b_cm).or_panic.find { |c| c.name == "age" }.as(ColumnInfo).comment.nil?
else
  assert schema.table_comment(:m02b_cm).or_panic == "Accounts"
  assert schema.columns(:m02b_cm).or_panic.find { |c| c.name == "age" }.as(ColumnInfo).comment == "Years"
  statements.change_table_comment(:m02b_cm, nil).or_panic
  statements.change_column_comment(:m02b_cm, :age, nil).or_panic
  assert schema.table_comment(:m02b_cm).or_panic.nil?
  assert schema.columns(:m02b_cm).or_panic.find { |c| c.name == "age" }.as(ColumnInfo).comment.to_s == ""
end
statements.drop_table(:m02b_cm, if_exists: true).or_panic
statements.create_table(:m02b_cm) { |t| t.integer(:age) }.or_panic
# it: sets comments from create_table, add_column and change_table
statements.create_table(:m02b_cm, force: true, comment: "Made") { |t| t.string(:name, comment: "Label") }.or_panic
statements.add_column(:m02b_cm, :score, :integer, comment: "Points").or_panic
statements.change_table(:m02b_cm) { |t| t.comment("Changed") }.or_panic
if SpecHelper::CURRENT_ADAPTER != "sqlite"
  assert schema.table_comment(:m02b_cm).or_panic == "Changed"
  assert schema.columns(:m02b_cm).or_panic.map { |c| {c.name, c.comment} }.reject { |pair| pair[0] == "id" } == [{"name", "Label"}, {"score", "Points"}]
end
statements.drop_table(:m02b_cm, if_exists: true).or_panic
