module transaction_sql_recorder

import grant/transaction::{TransactionState}

# Native counterpart of the upstream grant.transaction memory log backend.
pub def record(&block : -> T) : Array(String) forall T
  statements = [] of String
  previous = TransactionState.statement_observer
  TransactionState.statement_observer = ->(sql : String) { statements << sql; nil }
  yield
  TransactionState.statement_observer = previous
  statements
end

pub def begins(statements : Array(String)) : Array(String)
  statements.select { |sql| sql.starts_with?("BEGIN") || sql.starts_with?("START TRANSACTION") }
end
