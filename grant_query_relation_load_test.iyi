import transaction_crud_models::{Parent}
import spec_helper::{register_spec_connections}
import query_relation_sql_capture::{capture_sql, seed_parents}
import std/text

register_spec_connections
Parent.migrator.drop_and_create.or_panic

# it: starts unloaded and loads once
begin
  seed_parents(["a", "b"])
  relation = Parent.where("name != ?", "zzz")

  assert !relation.loaded?

  statements = capture_sql { relation.load.or_panic }
  assert statements.size == 1
  assert relation.loaded?
  assert relation.records.or_panic.size == 2
end

# it: runs one query for repeated each, to_a and records calls
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")
  seen = [] of String

  statements = capture_sql do
    relation.each { |parent| seen << parent.name.to_s }.or_panic
    relation.each { |parent| seen << parent.name.to_s }.or_panic
    relation.to_a.or_panic
    relation.records.or_panic
    relation.map(&.name).or_panic
  end

  assert statements.size == 1
  assert seen.size == 6
end

# it: answers empty? with a LIMIT 1 probe, then each runs exactly one more query
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  probe = capture_sql { assert !relation.empty?.or_panic }
  assert probe.size == 1
  assert probe.first.includes?("LIMIT 1")
  assert !relation.loaded?

  load_statements = capture_sql { relation.each { |_| }.or_panic }
  assert load_statements.size == 1
  assert !load_statements.first.includes?("LIMIT")

  assert capture_sql { relation.each { |_| }.or_panic }.empty?
end

# it: reads a loaded relation without SQL
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz").order(:name).load.or_panic

  statements = capture_sql do
    assert !relation.empty?.or_panic
    assert relation.any?.or_panic
    assert relation.many?.or_panic
    assert !relation.one?.or_panic
    assert !relation.none?.or_panic
    assert relation.size.or_panic == 3
    assert relation.first.or_panic.as(Parent).name == "a"
    assert relation.last.or_panic.as(Parent).name == "c"
    assert relation.first(2).or_panic.size == 2
    assert relation.last(2).or_panic.size == 2
    assert relation.second.or_panic.as(Parent).name == "b"
  end

  assert statements.empty?
end

# it: uses COUNT for size when the relation is not loaded
begin
  seed_parents(["a", "b", "c"])
  relation = Parent.where("name != ?", "zzz")

  statements = capture_sql { assert relation.size.or_panic == 3 }

  assert statements.size == 1
  assert statements.first.upcase.includes?("COUNT(*)")
  assert !relation.loaded?
end

# it: counts the rows a limited or offset relation returns
begin
  seed_parents(["a", "b", "c", "d", "e"])
  relation = Parent.where("name != ?", "zzz")

  assert relation.limit(2).size.or_panic == 2
  assert relation.limit(2).offset(1).size.or_panic == 2
  assert relation.limit(10).offset(3).size.or_panic == 2
  assert relation.offset(4).size.or_panic == 1
  assert relation.offset(9).size.or_panic == 0
  assert relation.limit(2).count.or_panic == 2
  assert relation.order(:name).limit(3).size.or_panic == 3
end

# it: resets and reloads to see new rows
begin
  seed_parents(["a"])
  relation = Parent.where("name != ?", "zzz").load.or_panic
  assert relation.size.or_panic == 1

  Parent.create(name: "b")
  assert relation.size.or_panic == 1
  assert relation.records.or_panic.size == 1

  assert relation.reset.object_id == relation.object_id
  assert !relation.loaded?
  assert relation.size.or_panic == 2
  assert relation.records.or_panic.size == 2

  Parent.create(name: "c")
  statements = capture_sql { assert relation.reload.or_panic.object_id == relation.object_id }
  assert statements.size == 1
  assert relation.loaded?
  assert relation.records.or_panic.size == 3
end

# it: hands back an unloaded relation from every chain method
begin
  seed_parents(["a", "b"])
  loaded = Parent.where("name != ?", "zzz").load.or_panic

  assert !loaded.order(:name).loaded?
  assert !loaded.where(name: "a").loaded?
  assert !loaded.all.loaded?
  assert !loaded.limit(1).loaded?
  assert loaded.loaded?
end

# it: drops the memoized records when a bang method changes the relation
begin
  seed_parents(["a", "b"])
  relation = Parent.where("name != ?", "zzz").load.or_panic
  assert relation.records.or_panic.size == 2

  relation.where_in_place(name: "a")

  assert !relation.loaded?
  assert relation.records.or_panic.size == 1
end

# it: returns the same records array until reset
begin
  seed_parents(["a"])
  relation = Parent.where("name != ?", "zzz")

  assert relation.records.or_panic.object_id == relation.records.or_panic.object_id
end

# it: treats none relations as loaded-empty without SQL
begin
  seed_parents(["a"])
  relation = Parent.where("name != ?", "zzz").none

  statements = capture_sql do
    assert relation.empty?.or_panic
    assert !relation.any?.or_panic
    assert !relation.many?.or_panic
    assert relation.records.or_panic.empty?
  end
  assert statements.empty?
end

Parent.adapter.close.or_panic
