import grant/base::{Base}
import spec_helper::{register_spec_connections}

class CollectionMetricOwner < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table collection_metric_owners

  column id : Int64, primary: true
  column label : String

  has_many :posts, class_name: CollectionMetricPost, foreign_key: :collection_metric_owner_id
end

class CollectionMetricPost < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table collection_metric_posts

  column id : Int64, primary: true
  column collection_metric_owner_id : Int64?
  column is_visible : Bool

  default_scope { where(is_visible: true) }
end


register_spec_connections
CollectionMetricOwner.migrator.drop_and_create.or_panic
CollectionMetricPost.migrator.drop_and_create.or_panic

CollectionMetricPost.clear.or_panic
CollectionMetricOwner.clear.or_panic

# it: counts database rows with owner and default scopes
owner = CollectionMetricOwner.create_strict(label: "with posts").or_panic
2.times do
  CollectionMetricPost.create_strict(collection_metric_owner_id: owner.id, is_visible: true).or_panic
end
CollectionMetricPost.create_strict(collection_metric_owner_id: owner.id, is_visible: false).or_panic

assert owner.posts.count.or_panic == 2_i64
assert owner.posts.size.or_panic == 2
assert owner.posts.size.or_panic.is_a?(Int64)
assert owner.posts.length.or_panic == 2
assert !owner.posts.empty?.or_panic
assert owner.posts.any?.or_panic
assert !owner.posts.none?.or_panic

CollectionMetricPost.clear.or_panic
CollectionMetricOwner.clear.or_panic

# it: uses a loaded target for size and enumerable predicates
owner = CollectionMetricOwner.create_strict(label: "loaded posts").or_panic
first_post = CollectionMetricPost.create_strict(collection_metric_owner_id: owner.id, is_visible: true).or_panic
CollectionMetricPost.create_strict(collection_metric_owner_id: owner.id, is_visible: true).or_panic
owner.set_loaded_association("posts", [first_post])

assert owner.posts.size.or_panic == 1
assert owner.posts.size.or_panic.is_a?(Int64)
assert owner.posts.length.or_panic == 1
assert owner.posts.count.or_panic == 2_i64
assert !owner.posts.empty?.or_panic
assert owner.posts.any?.or_panic
assert !owner.posts.none?.or_panic

CollectionMetricPost.clear.or_panic
CollectionMetricOwner.clear.or_panic

# it: reports empty loaded and unloaded associations
owner = CollectionMetricOwner.create_strict(label: "no posts").or_panic

assert owner.posts.count.or_panic == 0_i64
assert owner.posts.size.or_panic == 0
assert owner.posts.length.or_panic == 0
assert owner.posts.empty?.or_panic
assert !owner.posts.any?.or_panic
assert owner.posts.none?.or_panic

owner.set_loaded_association("posts", [] of CollectionMetricPost)
assert owner.posts.size.or_panic == 0
assert owner.posts.empty?.or_panic
assert !owner.posts.any?.or_panic
assert owner.posts.none?.or_panic

CollectionMetricOwner.adapter.close.or_panic
