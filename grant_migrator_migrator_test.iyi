import grant/base
import spec_helper
import std/time::{Time}
import std/uuid::{UUID}

class Review < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table reviews

  column id : Int64, primary: true
  column name : String?
  column downvotes : Int32?
  column upvotes : Int64?
  column sentiment : Float32?
  column interest : Float64?
  column published : Bool?
  column created_at : Time?
end

class Kvs < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table kvs

  column k : String, primary: true, auto: false
  column v : String?
end

class UUIDModel < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table uuids

  column uuid : UUID?, primary: true
end

class Character < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table characters

  column character_id : Int32, primary: true
  column name : String
end

class ArrayModel < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}

  table array_model
  column id : Int32, primary: true
  column str_array : Array(String)?
  column i16_array : Array(Int16)?
  column i32_array : Array(Int32)?
  column i64_array : Array(Int64)?
  column f32_array : Array(Float32)?
  column f64_array : Array(Float64)? = [] of Float64
  column bool_array : Array(Bool)?
end

class ManualColumnType < ::Grant::Base::Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table manual_column_types

  column id : Int64, primary: true
  column foo : UUID?, column_type: "DECIMAL(12, 10)"
end

SpecHelper.register_spec_connections

# Original description: generates correct SQL with #{{{ (env("CURRENT_ADAPTER") || "sqlite") }}} adapter
# it: "generates correct SQL with #
assert Review.migrator.drop_sql == "DROP TABLE IF EXISTS \"reviews\";"

# Original description: generates correct SQL with #{{{ (env("CURRENT_ADAPTER") || "sqlite") }}} adapter
# it: "generates correct SQL with #
if SpecHelper::CURRENT_ADAPTER == "pg"
  assert Review.migrator.create_sql == "CREATE TABLE \"reviews\"(\n\"id\" BIGSERIAL PRIMARY KEY,\n\"name\" TEXT\n,\n\"downvotes\" INT\n,\n\"upvotes\" BIGINT\n,\n\"sentiment\" REAL\n,\n\"interest\" DOUBLE PRECISION\n,\n\"published\" BOOL\n,\n\"created_at\" TIMESTAMP\n) ;\n"
  assert Kvs.migrator.create_sql == "CREATE TABLE \"kvs\"(\n\"k\" TEXT PRIMARY KEY,\n\"v\" TEXT\n) ;\n"
  assert UUIDModel.migrator.create_sql == "CREATE TABLE \"uuids\"(\n\"uuid\" UUID PRIMARY KEY) ;\n"
  assert Character.migrator.create_sql == "CREATE TABLE \"characters\"(\n\"character_id\" SERIAL PRIMARY KEY,\n\"name\" TEXT NOT NULL\n) ;\n"
  assert ArrayModel.migrator.create_sql == "CREATE TABLE \"array_model\"(\n\"id\" SERIAL PRIMARY KEY,\n\"str_array\" TEXT[]\n,\n\"i16_array\" SMALLINT[]\n,\n\"i32_array\" INT[]\n,\n\"i64_array\" BIGINT[]\n,\n\"f32_array\" REAL[]\n,\n\"f64_array\" DOUBLE PRECISION[]\n,\n\"bool_array\" BOOLEAN[]\n) ;\n"
else
  assert Review.migrator.create_sql == "CREATE TABLE \"reviews\"(\n\"id\" INTEGER NOT NULL PRIMARY KEY,\n\"name\" VARCHAR(255)\n,\n\"downvotes\" INTEGER\n,\n\"upvotes\" INTEGER\n,\n\"sentiment\" FLOAT\n,\n\"interest\" REAL\n,\n\"published\" BOOL\n,\n\"created_at\" VARCHAR\n) ;\n"
  assert Kvs.migrator.create_sql == "CREATE TABLE \"kvs\"(\n\"k\" VARCHAR(255) PRIMARY KEY,\n\"v\" VARCHAR(255)\n) ;\n"
  assert Character.migrator.create_sql == "CREATE TABLE \"characters\"(\n\"character_id\" INTEGER NOT NULL PRIMARY KEY,\n\"name\" VARCHAR(255) NOT NULL\n) ;\n"
  assert UUIDModel.migrator.create_sql == "CREATE TABLE \"uuids\"(\n\"uuid\" CHAR(36) PRIMARY KEY) ;\n"
end

# it: supports a manually supplied column type
if SpecHelper::CURRENT_ADAPTER == "pg"
  assert ManualColumnType.migrator.create_sql == "CREATE TABLE \"manual_column_types\"(\n\"id\" BIGSERIAL PRIMARY KEY,\n\"foo\" DECIMAL(12, 10)\n) ;\n"
else
  assert ManualColumnType.migrator.create_sql == "CREATE TABLE \"manual_column_types\"(\n\"id\" INTEGER NOT NULL PRIMARY KEY,\n\"foo\" DECIMAL(12, 10)\n) ;\n"
end

