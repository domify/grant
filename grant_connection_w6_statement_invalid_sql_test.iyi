import grant
import std/file::{File}
import grant/base::{Base}
import grant/adapter/sqlite::{Sqlite}
import grant/connection_registry::{ConnectionRegistry}
import grant/error_taxonomy::{StatementInvalid}
import grant/errors::{RecordNotSaved}

class W6SqlThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column amount : Int64?
end

class W6SqlGhostThing < Base
  connection "w6_sql"
  table w6_sql_things
  column id : Int64, primary: true
  column label : String?
  column ghost : String?
end

private def w6_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(StatementInvalid)
  error = result.as(StatementInvalid)
  assert !error.sql.nil?
  assert error.sql.to_s.includes?(fragment)
  assert !error.cause.nil?
  error
end

private def w6_wrapped_failure(fragment : String, &block : -> T) : StatementInvalid forall T
  result = yield
  assert result.is_a?(RecordNotSaved)
  error = result.as(RecordNotSaved)
  cause = error.cause
  assert cause.is_a?(StatementInvalid)
  statement = cause.as(StatementInvalid)
  assert statement.sql.to_s.includes?(fragment)
  statement
end

path = File.tempfile("w6_sql", ".sqlite3")
ConnectionRegistry.establish_connection(database: "w6_sql", adapter: Sqlite, url: "sqlite3:#{path}", role: :primary).or_panic
adapter = ConnectionRegistry.get_adapter("w6_sql", :primary)
adapter.open { |db| db.exec("CREATE TABLE w6_sql_things (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT, amount BIGINT)") }.or_panic
adapter.open { |db| db.exec("INSERT INTO w6_sql_things (label, amount) VALUES ('a', 1)") }.or_panic
sql = "SELECT missing_col FROM w6_sql_things"

# it: reports the statement of a select naming a column the table lacks
w6_failure("ghost") { W6SqlGhostThing.first }
w6_failure("ghost") { W6SqlGhostThing.all }
w6_failure("ghost") { W6SqlGhostThing.find(1_i64) }

# it: reports the statement of an insert, an update and a delete
w6_wrapped_failure("INSERT") { W6SqlGhostThing.new(label: "x", ghost: "y").save_strict }
w6_wrapped_failure("ghost") { W6SqlGhostThing.create_strict(label: "x", ghost: "y") }
w6_failure("ghost") { W6SqlGhostThing.where(label: "a").update_all(ghost: "z") }

# it: reports the statement of the raw SQL entry points of a model
w6_failure("missing_col") { W6SqlThing.all("WHERE missing_col = ?", [1_i64]) }
w6_failure("missing_col") { W6SqlThing.first("WHERE missing_col = ?", [1_i64]) }
w6_failure("missing_col") { W6SqlThing.find_by_sql("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { W6SqlThing.connection.select_all("SELECT missing_col FROM w6_sql_things") }
w6_failure("missing_col") { W6SqlThing.connection.execute("UPDATE w6_sql_things SET missing_col = 1") }

# Native success checks exercise hydration, parameter binding and error recovery.
assert W6SqlThing.first("WHERE amount = ?", [1_i64]).or_panic.as(W6SqlThing).label == "a"
assert W6SqlThing.first("WHERE amount = ?", [2_i64]).or_panic.nil?
assert W6SqlThing.find_by_sql("SELECT id, label, amount FROM w6_sql_things WHERE amount = ?", [1_i64] of ::Grant::Adapter::Sqlite::Value).or_panic.first.label == "a"
assert W6SqlThing.find(1_i64).or_panic.as(W6SqlThing).amount == 1_i64
assert W6SqlThing.find_strict(1_i64).or_panic.label == "a"
assert W6SqlGhostThing.find_strict(1_i64).is_a?(StatementInvalid)
assert W6SqlThing.where(label: "a").select.or_panic.size == 1
assert W6SqlThing.where(label: "a").update_all(amount: 2_i64).or_panic == 1_i64
assert W6SqlThing.find(1_i64).or_panic.as(W6SqlThing).amount == 2_i64
assert W6SqlThing.count.or_panic == 1_i64

ConnectionRegistry.remove_connection("w6_sql", :primary).or_panic
File.delete(path)
